# receive.ludic - what arrived, unwrapped from the relay, checked, acknowledged and put in order
# on the inbox. A reliable message is taken strictly in order; one that arrives early is dropped
# and comes again.
function net__pump(net_st: mut NetState) -> void {
  if net_st.net__sock <= 0 { return }
  for guard in 0 .. 200 {
    let n = NetSocket.recv(net_st.net__sock, net_st.net__in, NET_MTU + 64)
    if n <= 0 { return }
    let n2 = net__unwrap(net_st, n, NetSocket.from_ip(net_st.net__sock), NetSocket.from_port(net_st.net__sock))
    if n2 > 0 { net__packet(net_st, n2, net_st.net__from_ip, net_st.net__from_port) }
  }
}

function net__packet(net_st: mut NetState, n0: int, ip: int, port: int) -> void {
  @alloc_ok("only while tracing every packet")
  if NetWorld.trace() { net__log(`in {n0} bytes from {Udp.ip_text(ip)}:{port}`) }
  if n0 < 20 { return }
  if net__challenge_packet(net_st, n0, ip, port) { return }   # a host's challenge to this joining machine
  if net__stun_packet(net_st, n0) { return }                # what the router looks like from outside
  if net__status_packet(net_st, n0, ip, port) { return }    # a server browser asking how this host is (status.ludic)
  if nb_get8(net_st.net__in, 0) != 'M' or nb_get8(net_st.net__in, 1) != 'L' { return }   # a punch ("MP") or noise
  if nb_get8(net_st.net__in, 2) != net__conf(net_st).proto { return }
  let slot = net__slot_for(net_st, n0, ip, port)
  if slot < 0 { return }
  let p = net_st.net__peers[slot]
  var n = n0
  if nb_get8(net_st.net__in, 3) == 2 {
    # A sealed packet says who sent it (bytes 8 .. 12), and only the pid this slot holds may: both directions are sealed under one key, so the
    # host's own packet, sent back to it from the guest's address, would open as the guest's and its messages be taken as the guest's
    if nb_get32(net_st.net__in, 8) != p.pid { return }
    n = net__sec_open(net_st, slot, n0)                          # a sealed packet: its tag, its counter, its messages decrypted (secure.ludic)
    if n < 0 { return }
  } else if p.sec_in {
    return                                                   # a plain packet from a peer that seals its own: not from it
  }
  p.heard = net_st.net__time
  # only what this connection has sent can be acknowledged: a packet from the one before it
  # (a re-join) carries the old numbers and would drop the new hello as already taken
  let ack = nb_get32(net_st.net__in, 12)
  if ack > p.acked and ack < p.next_id {
    net__rtt_sample(net_st, p, ack)
    p.acked = ack
    p.dup = 0
  } else if ack == p.acked and p.acked < p.next_id - 1 and nb_get8(net_st.net__in, 17) > 0 {
    # A reliable message of ours is out, the packet acknowledges nothing new, and it says the peer has had a reliable message past the one
    # it waits for (byte 17): the receiver takes them strictly in order and drops what comes after a lost one, so one was lost. Three such
    # packets in a row (TCP's three duplicate acknowledgements, RFC 5681 3.2: one or two may be packets that came out of order) send every
    # message it has not taken again at once, and no sooner again than a round trip later, when the resent ones can have been taken (Unreal's
    # NetConnection resends on a negative acknowledgement from the packet history in the same way). A packet that only acknowledges nothing
    # new is no evidence: on a line slower than the packets are frequent, every packet the peer sends before ours arrives does that
    p.dup += 1
    var wait = p.srtt
    if not p.rtt_any { wait = p.rto }
    if p.dup >= 3 and net_st.net__time - p.fast_t >= wait {
      p.dup = 0
      p.fast_t = net_st.net__time
      net__resend_now(net_st, p)
    }
  }
  net__messages(net_st, slot, n)
}

# the known peer at that address, a stranger's new slot (a host, and only with a hello), or -1
function net__slot_for(net_st: mut NetState, n: int, ip: int, port: int) -> int {
  let token = nb_get32(net_st.net__in, 4)
  var slot = net__find(net_st, ip, port)
  if slot >= 0 {
    if token != net_st.net__token and net_st.net__state != NET_JOINING and net_st.net__peers[slot].pid != 0 { return -1 }
    return slot
  }
  if net_st.net__state != NET_HOSTING { return -1 }
  if n < 28 or nb_get8(net_st.net__in, 3) != 1 or nb_get8(net_st.net__in, 20) != NET_HELLO { return -1 }       # (a stranger's hello is plain)
  # A hardened host (net_harden) takes a stranger only when it answers a challenge: its address is then its own. A guest the relay brings
  # (a packet unwrapped from the relay's own address and port; the relay's address and a made-up port) cannot be sent a challenge it would
  # answer, and is the matchmaker's to vouch for: but no more than NET_WAIT_RELAYED of those wait at once (a source address of the relay's,
  # made up, gets that far and no further)
  let relayed = net_st.net__from_relay
  if net_st.net__hardened and not relayed {
    let c = net__cookie_for(net_st, ip, port, false)
    if token != c and token != net__cookie_for(net_st, ip, port, true) {
      net__challenge(net_st, ip, port, c)
      return -1
    }
  }
  var held = 0
  var waiting = 0
  for i in 1 .. NET_PEERS {
    let q = net_st.net__peers[i]
    if q.on and q.ip == ip {
      held += 1
      if q.pid < 2 { waiting += 1 }
    }
  }
  if relayed {
    if waiting >= NET_WAIT_RELAYED { return -1 }
  } else if held >= NET_PER_IP or waiting >= NET_WAIT_PER_IP {
    return -1
  }
  for i in 1 .. NET_PEERS {
    if not net_st.net__peers[i].on {
      net__open(net_st, i, ip, port, 0)
      return i
    }
  }
  return -1
}

function net__messages(net_st: mut NetState, slot: int, n: int) -> void {
  let p = net_st.net__peers[slot]
  let from = nb_get32(net_st.net__in, 8)
  let count = nb_get8(net_st.net__in, 16)                       # (at most 250; byte 17 is the peer's word on a loss: net__packet)
  var o = 20
  for c in 0 .. count {
    if o + 4 > n { return }
    let kind = nb_get8(net_st.net__in, o)
    let rel = nb_get8(net_st.net__in, o + 1) == 1
    o += 2
    var id = 0
    if rel {
      if o + 4 > n { return }
      id = nb_get32(net_st.net__in, o)
      o += 4
    }
    let ml = nb_get8(net_st.net__in, o) | (nb_get8(net_st.net__in, o + 1) << 8)
    o += 2
    if ml < 0 or o + ml > n { return }
    var take = true
    if rel {
      p.ack_due = true
      if id != p.recv_id + 1 { take = false } else { p.recv_id = id }
      if id > p.seen_id and id < p.recv_id + 1000000 { p.seen_id = id }   # (what the next packet to it says: send.ludic byte 17)
    }
    if take { net__deliver(net_st, slot, from, kind, o, ml) }
    o += ml
  }
}

# onto the inbox - except a heartbeat, and on a host anything but a hello before its welcome
function net__deliver(net_st: mut NetState, slot: int, from: int, kind: int, o: int, ml: int) -> void {
  if kind == NET_BEAT { return }
  if net_st.net__state == NET_HOSTING and net_st.net__peers[slot].pid < 2 and kind != NET_HELLO { return }
  let m = net__in_take(net_st)
  m.slot = slot
  m.from = from
  m.kind = kind
  m.len = ml
  nb_copy(m.data, 0, net_st.net__in, o, ml)
  q_push(net_inbox(net_st), m)
}

# The number a stranger's address is asked to answer with: the first four bytes of HMAC-SHA256 under the host's secret of the address, the
# port and the secret's epoch, never 0 (Unreal's StatelessConnectHandlerComponent::GenerateCookie: Cookie = HMAC(HandshakeSecret, Timestamp +
# Client IP + Client Port)). Only the host knows the secret, so an address that never receives the challenge cannot know its number, and one
# address's number says nothing about another's. `old`: under the secret before this one
function net__cookie_for(net_st: mut NetState, ip: int, port: int, old: bool) -> int {
  let m = net_st.net__ckb
  nb_put32(m, 0, ip)
  nb_put32(m, 4, port)
  var key = net_st.net__key_now
  var gen = net_st.net__key_gen
  if old {
    key = net_st.net__key_old
    gen -= 1
  }
  nb_put32(m, 8, gen)
  net__hmac(net_st, key, m, 12)
  let c = nb_get32(net_st.net__sd, 0)
  if c == 0 { return 1 }
  return c
}

# A new secret for the challenge, from the system's CSPRNG, and the one it replaces still taken for one more epoch: every 15 s and up to 5 s
# more at random, so a number lives 15 to 40 s (Unreal's StatelessConnectHandlerComponent::UpdateSecret: two secrets, SECRET_UPDATE_TIME 15 +
# rand(SECRET_UPDATE_TIME_VARIANCE 5) s). A number caught on the wire is no good for long, and none is good after the host restarts
function net__key_roll(net_st: mut NetState) -> void {
  nb_copy(net_st.net__key_old, 0, net_st.net__key_now, 0, 32)
  for i in 0 .. 8 { nb_put32(net_st.net__key_now, i * 4, Crypto.random_u32()) }
  net_st.net__key_gen += 1
  net_st.net__key_t = net_st.net__time + 15.0 + float((Crypto.random_u32() >> 1) % 5000) / 1000.0
}

# the challenge to a stranger: "MC", the protocol, a zero, the number, zeros to 20 bytes (the size of the smallest packet taken)
function net__challenge(net_st: mut NetState, ip: int, port: int, cookie: int) -> void {
  let b = net_st.net__out
  for i in 0 .. 20 { nb_put8(b, i, 0) }
  nb_put8(b, 0, 'M')
  nb_put8(b, 1, 'C')
  nb_put8(b, 2, net__conf(net_st).proto)
  nb_put32(b, 4, cookie)
  NetSocket.send(net_st.net__sock, ip, port, b, 20)
}

# a host's challenge, to a machine that is joining: the number kept and the hello sent again at once with it
function net__challenge_packet(net_st: mut NetState, n: int, ip: int, port: int) -> bool {
  if nb_get8(net_st.net__in, 0) != 'M' or nb_get8(net_st.net__in, 1) != 'C' { return false }
  if net_st.net__state != NET_JOINING or net_st.net__via_relay { return true }
  if ip != net_st.net__join_ip or port != net_st.net__join_port { return true }
  if nb_get8(net_st.net__in, 2) != net__conf(net_st).proto { return true }
  let c = nb_get32(net_st.net__in, 4)
  if c == 0 or c == net_st.net__cookie { return true }
  net_st.net__cookie = c
  let p = net_st.net__peers[0]
  if p.on {
    for i in 0 .. len(p.queue) {
      let m = p.queue[i]
      m.sent = -1.0
    }
  }
  return true
}

# every reliable message of ours the peer has not taken goes again in the next flush: the receiver drops every one after the lost one, so the
# ones sent since it are lost too (they are a round trip's worth at most: this runs once a round trip)
function net__resend_now(net_st: mut NetState, p: NetPeer) -> void {
  for i in 0 .. len(p.queue) {
    let m = p.queue[i]
    if m.rel and m.id > p.acked and m.sent >= 0.0 { m.sent = -1.0 }
  }
}

# The round trip measured by the acknowledgement of `ack`, and the retransmission timeout made of it (RFC 6298 2: SRTT and RTTVAR, RTO =
# SRTT + 4 RTTVAR; ENet's protocol.c: roundTripTimeout = roundTripTime + 4 roundTripTimeVariance). Only a message that went once is measured
# (Karn's rule): the acknowledgement of one sent again may be the first send's
function net__rtt_sample(net_st: mut NetState, p: NetPeer, ack: int) -> void {
  for i in 0 .. len(p.queue) {
    let m = p.queue[i]
    if not m.rel or m.id != ack { continue }
    if m.tries != 1 or m.sent < 0.0 { return }
    let r = net_st.net__time - m.sent
    if r < 0.0 { return }
    if not p.rtt_any {
      p.rtt_any = true
      p.srtt = r
      p.rttvar = r / 2.0
    } else {
      var d = p.srtt - r
      if d < 0.0 { d = 0.0 - d }
      p.rttvar = 0.75 * p.rttvar + 0.25 * d
      p.srtt = 0.875 * p.srtt + 0.125 * r
    }
    var t = p.srtt + 4.0 * p.rttvar
    if t < NET_RTO_MIN { t = NET_RTO_MIN }
    if t > NET_RTO_MAX { t = NET_RTO_MAX }
    p.rto = t
    return
  }
}
