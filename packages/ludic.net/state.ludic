# state.ludic - the wire's numbers, a peer, a queued message, what came in, and the session
export const NET_MTU: int = 1200
export const NET_PEERS: int = 128      # a host: slot 0 unused, a guest each after (a dedicated server: 127 players); a guest: 0 is the host
export const NET_TIMEOUT: int = 10     # seconds of silence before a peer is gone
export const NET_PER_IP: int = 64      # slots one address may hold on a host (a household behind one router is a few; a flood from one machine is stopped)
export const NET_WAIT_PER_IP: int = 4  # ... and of those, slots not yet let in (net_accept): a hello's slot is taken before the game has read it
export const NET_WAIT_RELAYED: int = 8  # slots not yet let in that the relay holds for its guests (they all have its address, and prove no address)
export const NET_RTO_FIRST: float = 0.25   # seconds before a reliable message goes again, until a round trip has been measured
export const NET_RTO_MIN: float = 0.1      # ... and the least and most it is given once one has (each try doubles it, up to the most)
export const NET_RTO_MAX: float = 2.0
export const NET_HELLO: int = 1        # the one kind a stranger may send a host; every other is the game's
const NET_BEAT: int = 0                # a heartbeat, never delivered

export const NET_IDLE: int = 0
export const NET_HOSTING: int = 1
export const NET_JOINING: int = 2
export const NET_JOINED: int = 3
export const NET_LOST: int = 4

# a message on its way out, kept until acknowledged when it is reliable
property NetMsg {
  kind: int = 0,
  rel: bool = false,
  id: int = 0,
  sent: float = 0.0,           # net seconds it was last sent; -1 never
  tries: int = 0,              # how many times it has gone (a round trip is measured only from one that went once: Karn's rule)
  len: int = 0,
  made: float = 0.0,           # net seconds it was queued
  data: []byte
}

property NetPeer {
  on: bool = false,
  ip: int = 0,
  port: int = 0,
  pid: int = 0,
  heard: float = 0.0,          # net seconds of the last packet from it
  next_id: int = 1,            # the next reliable id to send it
  recv_id: int = 0,            # the highest reliable id taken from it, in order
  acked: int = 0,              # the highest id it has taken from us
  ack_due: bool = false,
  key_set: bool = false,       # secure.ludic: its keys are set
  sec_in: bool = false,        # a sealed packet has come from it: a plain one is dropped from now on
  sec_out: bool = false,       # what is sent to it is sealed
  rx_any: bool = false,
  ck: []byte,                  # the cipher key and the MAC key it is sealed for (32 bytes each; kx.ludic: one pair a direction)
  mk: []byte,
  rk: []byte,                  # ... and the pair its own sealed packets are opened with
  rm: []byte,
  tx_ctr: int = 0,             # the counter of the next sealed packet to it
  rx_max: int = 0,             # the newest counter taken from it, and which of the 32 before it have come (bit 0 is rx_max)
  rx_bits: int = 0,
  dup: int = 0,                # packets in a row that acknowledged nothing new and said the peer dropped a later message of ours (a loss)
  seen_id: int = 0,            # the highest reliable id that came from it, taken or dropped as early: past recv_id, one of its was lost
  rtt_any: bool = false,       # a round trip to it has been measured: srtt and rttvar hold (RFC 6298)
  srtt: float = 0.0,
  rttvar: float = 0.0,
  rto: float = 0.25,           # seconds before a reliable message to it goes again (doubled on each try)
  fast_t: float = 0.0,         # net seconds of the last resend on its word that a message was lost
  queue: []NetMsg,
  back: []NetMsg,              # the queue's other list, filled by a flush and swapped in
  closing: bool = false,       # let go once it has taken close_id
  close_id: int = 0,
  close_t: float = 0.0         # ... or at this net time, whichever comes first
}

# a message that came in, in order: read it with net_read(m) and nr_*
export property NetMessage {
  slot: int = 0,               # the peer slot it came from
  from: int = 0,               # the sender's pid, as its header says
  kind: int = 0,
  len: int = 0,
  sealed: bool = false,        # it came in a sealed packet (secure.ludic): a game takes a secret only from one
  data: []byte
}

export state NetState {
  net__cfg: NetConfig = new NetConfig
  net__facts: Queue<NetFact> = net__facts__new()
  @max(64) net__fpool: []NetFact = net__fpool__new()   # the facts' records, taken in turn (pool.ludic)
  net__fat: int = 0
  net__watch_url: string = ""           # the room's address, made once per room
  net__seen: []string = new []string     # guests already punched for
  net__free: []NetMsg = new []NetMsg      # sent and taken (or stale): made again, never new (pool.ludic)
  net__ina: []NetMessage = new []NetMessage   # the inbox's records, two halves
  net__inb: []NetMessage = new []NetMessage
  net__inn: int = 0
  net__in_on_b: bool = false
  net__sb: []byte = buffer(32)          # a relay hello's or a STUN request's bytes
  net__wr: NetMessage = null            # net_written's, kept
  net__tsb: StrBuf = sb_new(NET_MTU)    # a text read out of a message, interned (a name comes every frame)
  net__ttb: StrTable = strs_new(4096)
  net__punch_ip: words = null
  net__punch_port: words = null
  net__punch_left: words = null
  net__punch_t: float = 0.0
  net__punch_b: []byte = null    # the punch itself, "MP" and two zeros, made once
  net__status: []byte = null     # a host's answer to a browser's query (status.ludic): "MR", the protocol, the nonce, the game's bytes
  net__status_n: int = 0         # ... its length; 0 = no status set, a query goes unanswered
  net__relay_ip: int = 0
  net__relay_port: int = 0
  net__via_relay: bool = false  # a guest talking to its host through the relay
  net__from_ip: int = 0
  net__from_port: int = 0
  net__r_state: int = 0
  net__r_role: int = 0          # 1 host, 2 guest
  net__r_t: float = 0.0
  net__r_tries: int = 0
  net__pub_ip: int = 0
  net__pub_port: int = 0
  net__room: string = ""        # the host's room code, or the one a guest asked for
  net__http: int = 0
  net__poll_t: float = 0.0
  net__relay_t: float = 0.0
  net__dial_heard: float = 0.0
  net__why: int = 0
  net__state: int = 0
  net__sock: int = 0
  net__time: float = 0.0
  net__token: int = 0
  net__status_sec: int = 0        # the second (net time) the status answers are counted in, and how many it has given (status.ludic)
  net__status_cnt: int = 0
  net__cw: words = words(16)      # secure.ludic's scratch: the ChaCha20 block's working state and its input, SHA-256's words and state
  net__cs: words = words(16)
  net__sw: words = words(64)
  net__sh: words = words(8)
  net__skb: []byte = buffer(64)
  net__spad: []byte = buffer(64)
  net__stl: []byte = buffer(128)
  net__sd: []byte = buffer(32)
  net__slb: []byte = buffer(16)
  net__hardened: bool = false     # net_harden: a stranger's hello is answered with a challenge and counted only with its answer
  net__key_now: []byte = buffer(32)   # the challenge's secrets (32 bytes from the system's CSPRNG): this epoch's, and the one before
  net__key_old: []byte = buffer(32)
  net__key_gen: int = 0           # the epoch of key_now (key_old's is one less)
  net__key_t: float = 0.0         # net seconds when key_now is replaced
  net__ckb: []byte = buffer(16)   # the address, port and epoch a cookie is made of
  net__from_relay: bool = false   # the packet being read came wrapped from the relay's own address and port (relay.ludic net__unwrap)
  net__sq_n: words = words(64)    # status answers this second, by a hash of the asker's address (status.ludic)
  net__in_sealed: bool = false    # the packet being read was sealed (its messages are marked so)
  net__fe: []long = net__fe_new()  # kx.ludic's scratch: the field's elements, the clamped scalar, the base point
  net__kz: []byte = buffer(32)
  net__kbase: []byte = buffer(32)
  net__ke_sk: []byte = buffer(32)  # this machine's ephemeral key pair, for the handshake under way (the secret wiped once used)
  net__ke_pk: []byte = buffer(32)
  net__ki_sk: []byte = buffer(32)  # a host's static identity (net_identity_set)
  net__ki_pk: []byte = buffer(32)
  net__ki_set: bool = false
  net__kp_e: []byte = buffer(32)  # the other side's ephemeral public key, and a guest's host's static one, as read
  net__kp_s: []byte = buffer(32)
  net__kdh: []byte = buffer(32)   # a shared secret, the two of them, the salt, the info, HKDF's key, output and message
  net__kikm: []byte = buffer(64)
  net__ksalt: []byte = buffer(64)
  net__kinfo: []byte = buffer(96)
  net__kprk: []byte = buffer(32)
  net__kokm: []byte = buffer(128)
  net__kxm: []byte = buffer(160)
  net__cookie: int = 0            # a joining machine's answer to that challenge, sent in its packets' token until the welcome
  net__my_pid: int = 0
  net__next_pid: int = 2
  net__peers: []NetPeer = net__peers_new()
  net__in: []byte = buffer(NET_MTU + 64)
  net__out: []byte = buffer(NET_MTU + 64)
  net__wb: []byte = buffer(NET_MTU)          # the message being written
  net__wl: int = 0
  net__aw: []int = new []int                 # an action message's words (actions.ludic)
  net__rb: []byte = buffer(NET_MTU)          # the message being read
  net__rl: int = 0
  net__rp: int = 0
  net__rbad: bool = false
  net__hello_b: []byte = buffer(NET_MTU)     # the game's hello, sent again on every dial
  net__hello_l: int = 0
  net__hello_t: float = 0.0       # seconds since it went; -1 not yet
  net__wait_more: int = 0         # extra seconds a slow host is given (a map switch, a matchmaker)
  net__beat_t: float = 0.0
  net__join_ip: int = 0
  net__join_port: int = 0
  net__code_ip: int = 0
  net__code_port: int = 0
  net__bytes_out: int = 0
  net__kind_out: words = null
  net__inbox: Queue<NetMessage> = net__inbox__new()
  net__stun_ip: int = 0
  net__stun_port: int = 0
  net__txn: words = words(3)
  net__dice: Rng = null
}

export function net_inbox(net_st: NetState) -> Queue<NetMessage> {
  return net_st.net__inbox
}

function net__facts__new() -> Queue<NetFact> { return queue_new("net.facts") }
function net__inbox__new() -> Queue<NetMessage> { return queue_new("net.inbox") }
# every peer slot, each with its own queue
function net__peers_new() -> []NetPeer {
  let out = new []NetPeer
  for i in 0 .. NET_PEERS {
    let p = new NetPeer
    p.queue = new []NetMsg
    p.back = new []NetMsg
    p.ck = buffer(32)
    p.mk = buffer(32)
    p.rk = buffer(32)
    p.rm = buffer(32)
    push(out, p)
  }
  return out
}
