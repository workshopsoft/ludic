# state.ludic - what is running, how many may, and the facts the package reports
export property Effect {
  kind: int = 0
  mag: float = 0.0
  left: float = 0.0
  delay: float = 0.0
  bonus: bool = false
  label: string = ""
}

# why an effect ended: it ran out, a newer bonus pushed it past the cap, or the ring was full
export const EFFECT_RAN_OUT: int = 0
export const EFFECT_PUSHED_OUT: int = 1
export const EFFECT_CROWDED_OUT: int = 2

export property EffectEnded {
  kind: int = 0
  label: string = ""
  why: int = 0
  bonus: bool = false
}

var ef_list: []Effect = null
var ef_max: int = 8
var ef_bonus_max: int = 3
var ef_ended: Queue<EffectEnded> = null

function ef_all() -> []Effect {
  if ef_list == null { ef_list = new []Effect }
  return ef_list
}

# the facts: what ended and why, oldest first; the game drains it
export function effects_ended() -> Queue<EffectEnded> {
  if ef_ended == null { ef_ended = queue_new("effects.ended") }
  return ef_ended
}

# how many may run at once, and how many of those may be bonuses
export function effects_config(max: int, bonus_max: int) -> void {
  ef_max = max
  ef_bonus_max = bonus_max
}

export function effects_capacity() -> int { return ef_max }
export function effects_bonus_capacity() -> int { return ef_bonus_max }
