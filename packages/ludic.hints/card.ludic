# card.ludic - a card read off the rail: the key opens the picked chip and puts it down, the arrows
# walk the rail with the card up, and "I know this" mutes the card being read
export function hints_card(hints_st: HintsState) -> int { return hints_st.hn_card }

# whether the player opened the card with the key (then Enter and the arrows are the card's), or it
# showed on its own (then they are the game's)
export function hints_own(hints_st: HintsState) -> bool { return hints_st.hn_own }

# the key: the picked card opened, or the open one put down
export function hints_key(hints_st: mut HintsState) -> void {
  if hints_st.hn_card >= 0 {
    hints_close(hints_st)
    return
  }
  hints_open(hints_st, hints_st.hn_pick)
  hints_st.hn_own = hints_st.hn_card >= 0
}

# the k-th chip on the rail opened as a card
export function hints_open(hints_st: mut HintsState, k: int) -> void {
  if k < 0 or k >= hints_st.hn_n { return }
  hints_st.hn_pick = k
  hints_st.hn_card = hints_st.hn_top[k]
  hn_fact(hints_st, HINTS_F_OPENED, hints_st.hn_card)
}

export function hints_close(hints_st: mut HintsState) -> void {
  if hints_st.hn_card < 0 { return }
  let c = hints_st.hn_card
  hints_st.hn_card = -1
  hints_st.hn_own = false
  hn_fact(hints_st, HINTS_F_CLOSED, c)
}

# the arrows, with a card up: the next chip along (d = 1) or the one before, round the ends
export function hints_move(hints_st: mut HintsState, d: int) -> void {
  if hints_st.hn_card < 0 or hints_st.hn_n <= 1 { return }
  hints_open(hints_st, (hints_st.hn_pick + hints_st.hn_n + d) % hints_st.hn_n)
}

# "I know this - do not show it again": the card off the rail until the mutes are given back
export function hints_mute_card(hints_st: mut HintsState) -> void {
  if hints_st.hn_card < 0 { return }
  let c = hints_st.hn_card
  hints_mute(hints_st, c, true)
  hints_st.hn_card = -1
  hints_st.hn_own = false
  hints_st.hn_t = 0.0
  hn_fact(hints_st, HINTS_F_MUTED, c)
}

# what the arrows and Enter mean this frame: the game's own unless the player opened the card with the
# key. HINTS_KEY_NONE says they pass through; the others are the card's walk and its mute
export const HINTS_KEY_NONE: int = 0
export const HINTS_KEY_PREV: int = 1
export const HINTS_KEY_NEXT: int = 2
export const HINTS_KEY_MUTE: int = 3

export function hints_keys_act(hints_st: HintsState, left: bool, right: bool, enter: bool) -> int {
  if not hints_st.hn_own or hints_st.hn_card < 0 { return HINTS_KEY_NONE }
  if left { return HINTS_KEY_PREV }
  if right { return HINTS_KEY_NEXT }
  if enter { return HINTS_KEY_MUTE }
  return HINTS_KEY_NONE
}

# a step's words and its picture (n 1..3): the glyph's name, or the item (-1 when it is a glyph)
export function hints_step_text(id: int, n: int) -> string {
  var k = Hints[id].s3
  if n == 1 { k = Hints[id].s1 }
  if n == 2 { k = Hints[id].s2 }
  if k == null { return "" }
  @alloc_ok("a cast: a key's marked text, nothing is made")
  return string(k)
}

export function hints_step_icon(id: int, n: int) -> string {
  if n == 1 { return Hints[id].pic1 }
  if n == 2 { return Hints[id].pic2 }
  return Hints[id].pic3
}

export function hints_step_item(id: int, n: int) -> int {
  if n == 1 { return Hints[id].item1 }
  if n == 2 { return Hints[id].item2 }
  return Hints[id].item3
}
