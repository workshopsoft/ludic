# set_tick.ludic - a frame of a player: each machine steps (fades, transitions, choices), advances its
# instances, and lays out the clips it plays with their shares; the clips are mixed into the pose per
# layer and folded into the skin. Nothing here allocates: every array was made when the player was bound.

function alpha_of(m: AnimMachine, k: int) -> float {
  if k == 0 or m.i_prog[k] >= 1.0 { return 1.0 }
  let t = tr_of(m, m.i_tr[k])
  if t == null { return m.i_prog[k] }
  return anim_curve(t.curve, t.curve_points, m.i_prog[k])
}

# the machine's frame: what it plays, weighted by `wt`, goes onto the player's clip list. A sub graph
# reached twice in a frame (two instances of the state holding it) steps once.
function run_machine(anim_st: mut AnimState, pl: AnimPlayer, mi: int, dt: float, wt: float) -> void {
  let m = pl.mach[mi]
  var first = false
  if m.stamp != pl.frame {
    m.stamp = pl.frame
    first = true
    step_machine(anim_st, pl, m, mi, dt)
  }
  var above = 1.0
  var k = m.n_i - 1
  while k >= 0 {
    let a = alpha_of(m, k)
    let w = a * above
    above = above * (1.0 - a)
    emit_inst(anim_st, pl, m, mi, k, wt * w, first, dt)
    k -= 1
  }
}

function step_machine(anim_st: mut AnimState, pl: AnimPlayer, m: AnimMachine, mi: int, dt: float) -> void {
  let s = AnimSets[m.set]
  if m.n_i == 0 {
    let e = as_entry(s)
    push_inst(anim_st, pl, m, mi, e, -1, 0.0, 0.0, -1)
  }
  for k in 1 .. m.n_i {
    if m.i_prog[k] < 1.0 {
      if m.i_fdur[k] > 0.0 { m.i_prog[k] = Math.min(1.0, m.i_prog[k] + dt / m.i_fdur[k]) } else { m.i_prog[k] = 1.0 }
    }
  }
  var hi = 0
  for k in 1 .. m.n_i { if m.i_prog[k] >= 1.0 { hi = k } }
  if hi > 0 { drop_to(anim_st, pl, m, hi) }
  resolve_picks(pl, m)
  decide(anim_st, pl, m, mi)
  resolve_picks(pl, m)
  switch_choice(anim_st, pl, m, mi)
  for k in 0 .. m.n_i { advance_inst(anim_st, pl, m, k, dt) }
}

# an instance that has not chosen yet takes the choice that holds now
function resolve_picks(pl: AnimPlayer, m: AnimMachine) -> void {
  for k in 0 .. m.n_i {
    if m.i_pick[k] >= 0 { continue }
    let st = m.i_st[k]
    if AnimSets[m.set].states[st].kind != "clips" { continue }
    m.i_pick[k] = as_pick(pl, m, st)
  }
}

# a `clips` state whose choice changed fades into the new one (keeping the cycle's phase, if it says so)
function switch_choice(anim_st: mut AnimState, pl: AnimPlayer, m: AnimMachine, mi: int) -> void {
  let top = m.n_i - 1
  let st = m.i_st[top]
  let d = AnimSets[m.set].states[st]
  if d.kind != "clips" { return }
  let p = as_pick(pl, m, st)
  if p < 0 { return }
  if m.i_pick[top] < 0 {
    m.i_pick[top] = p
    return
  }
  if p == m.i_pick[top] { return }
  var ph = 0.0
  if d.keep_phase { ph = m.i_ph[top] }
  push_inst(anim_st, pl, m, mi, st, p, ph, d.blend, -1)
}

# a blend state's weights into its instance: the space's at the parameters' values, the samples whose
# clip the rig lacks taken out and the rest made to sum to one. Its cycle takes the weighted durations.
function blend_weights(anim_st: AnimState, pl: AnimPlayer, m: AnimMachine, k: int, st: int) -> float {
  let sp = m.space[st]
  m.i_sn[k] = 0
  if sp < 0 { return 0.0 }
  var x = 0.0
  var y = 0.0
  if m.px[st] >= 0 { x = pl.vals[m.px[st]] }
  if m.py[st] >= 0 { y = pl.vals[m.py[st]] }
  let n = anim_space_weights(anim_st, sp, x, y, pl.bi, pl.bwt)
  var sum = 0.0
  var dur = 0.0
  var got = 0
  for j in 0 .. n {
    let c = m.clips[m.base[st] + pl.bi[j]]
    if c == null { continue }
    m.i_si[k * 3 + got] = pl.bi[j]
    m.i_sw[k * 3 + got] = pl.bwt[j]
    sum += pl.bwt[j]
    dur += pl.bwt[j] * c.dur
    got += 1
  }
  m.i_sn[k] = got
  if got == 0 or sum <= 0.0 { return 0.0 }
  for j in 0 .. got { m.i_sw[k * 3 + j] = m.i_sw[k * 3 + j] / sum }
  return dur / sum
}

function advance_inst(anim_st: mut AnimState, pl: AnimPlayer, m: AnimMachine, k: int, dt: float) -> void {
  let st = m.i_st[k]
  let d = AnimSets[m.set].states[st]
  m.i_wr[k] = 0
  m.i_p0[k] = m.i_ph[k]
  if d.kind == "sub" { return }
  var dur = 0.0
  var rate = 1.0
  if d.kind == "clips" {
    if m.i_pick[k] < 0 { return }
    let slot = m.base[st] + m.i_pick[k]
    dur = m.clips[slot].dur
    rate = as_rate(pl, m, st, slot, d.choices[m.i_pick[k]]) * as_fit(pl, m, st, dur)
  } else {
    anim_space_ready(anim_st, m.space[st])
    dur = blend_weights(anim_st, pl, m, k, st)
    rate = as_speed(pl, m, st) * as_fit(pl, m, st, dur)
  }
  m.i_rate[k] = rate
  m.i_dur[k] = dur
  if not (dur > 0.0) or dt <= 0.0 { return }
  var ph = m.i_ph[k] + dt * rate / dur
  if d.loop {
    if ph >= 1.0 {
      let laps = int(Math.floor(ph))
      ph = ph - float(laps)
      m.i_wr[k] = laps
      m.i_loops[k] = m.i_loops[k] + laps
    }
  } else if ph > 1.0 { ph = 1.0 }
  m.i_ph[k] = ph
  if not d.loop and ph >= 1.0 and k == m.n_i - 1 and d.next != "" {
    let i = as_state(AnimSets[m.set], d.next)
    if i >= 0 { m.want = i }
  }
}

function emit_inst(anim_st: mut AnimState, pl: AnimPlayer, m: AnimMachine, mi: int, k: int, w: float, first: bool, dt: float) -> void {
  let st = m.i_st[k]
  let d = AnimSets[m.set].states[st]
  if d.kind == "sub" {
    if m.sub[st] >= 0 { run_machine(anim_st, pl, m.sub[st], dt, w) }
  } else if d.kind == "clips" {
    if m.i_pick[k] >= 0 { add_item(anim_st, pl, m, mi, m.base[st] + m.i_pick[k], k, w, first, d.loop) }
  } else {
    for j in 0 .. m.i_sn[k] { add_item(anim_st, pl, m, mi, m.base[st] + m.i_si[k * 3 + j], k, w * m.i_sw[k * 3 + j], first, d.loop) }
  }
  if first { m.i_new[k] = 0 }
}

# one clip at a share of the pose: onto the list the layer mixes, its events fired, its root motion taken
function add_item(anim_st: mut AnimState, pl: AnimPlayer, m: AnimMachine, mi: int, slot: int, k: int, w: float, first: bool, loop: bool) -> void {
  let c = m.clips[slot]
  if c == null { return }
  let ii = m.infos[slot]
  var info: AnimClipInfo = null
  if ii >= 0 { info = AnimClips[ii] }
  if w > 0.0 and pl.n_it < AM_ITEMS {
    let n = pl.n_it
    pl.it_clip[n] = c
    pl.it_w[n] = w
    pl.it_t[n] = anim_clip_time(info, c.dur, m.i_ph[k], loop)
    pl.it_ref[n] = 0.0
    pl.it_ex[n] = 0
    pl.it_rp[n] = m.rmp[slot]
    pl.it_rr[n] = m.rmr[slot]
    if info != null {
      pl.it_ref[n] = info.ref_time
      if info.root_motion == "extract" {
        var ex = 0
        if m.rmp[slot] >= 0 { ex = 1 }
        if m.rmp[slot] >= 0 and info.root_axes == "xyz" { ex = ex | 2 }
        if m.rmr[slot] >= 0 and info.root_turn { ex = ex | 4 }
        pl.it_ex[n] = ex
      }
    }
    pl.n_it = n + 1
  }
  if not first or not (w > 0.0) or info == null { return }
  if pl.l_events and info.events != null and len(info.events) > 0 {
    events_fire(anim_st, pl, m, mi, slot, m.i_uid[k], info, c, m.i_p0[k], m.i_ph[k], m.i_wr[k], loop, m.i_new[k] == 1, w)
  }
  if info.root_motion == "extract" and (m.rmp[slot] >= 0 or m.rmr[slot] >= 0) {
    let u0 = anim_unwrapped_time(info, c.dur, m.i_p0[k], loop)
    let u1 = anim_unwrapped_time(info, c.dur, m.i_ph[k] + float(m.i_wr[k]), loop)
    anim_root_delta(anim_st, c, m.rmp[slot], m.rmr[slot], u0, u1, loop, info.root_turn, info.root_axes == "xyz", pl.rm_t)
    for e in 0 .. 4 { pl.rm[e] = pl.rm[e] + w * pl.rm_t[e] }
  }
}

# the list's clips mixed into one pose buffer by their shares; false when there was nothing to mix
function mix_items(anim_st: mut AnimState, pl: AnimPlayer, sk: Skin, rot: floats, pos: floats, hit: words, add: bool) -> bool {
  var cum = 0.0
  var any = false
  for i in 0 .. pl.n_it {
    let w = pl.it_w[i]
    if not (w > 0.0) { continue }
    cum += w
    anim_st.oz_live = oz_sample_item(anim_st, pl, sk, pl.it_clip[i], pl.it_t[i])
    mix_clip(anim_st, pl.it_clip[i], sk, pl.it_t[i], w / cum, rot, pos, hit, add, pl.it_ref[i], pl.it_ex[i], pl.it_rp[i], pl.it_rr[i])
    anim_st.oz_live = false
    any = true
  }
  return any
}

# the skeleton's level of detail for the distance the game last said; its row (0 the nearest, -1 none)
function lod_pick(pl: AnimPlayer) -> int {
  pl.l_every = 1
  pl.l_layers = AM_LAYERS
  pl.l_events = true
  if pl.skel < 0 or pl.skel >= len(AnimSkeletons) { return -1 }
  let rows = AnimSkeletons[pl.skel].lod
  if rows == null or len(rows) == 0 { return -1 }
  var at = len(rows) - 1
  for i in 0 .. len(rows) { if pl.dist <= rows[i].dist { at = i;  break } }
  pl.l_every = rows[at].every
  pl.l_layers = rows[at].layers
  pl.l_events = rows[at].events
  return at
}

# ---- the skipped ticks' pose and the budget ---------------------------------------------------------------------------------------
#
# Interpolation (R3D_ANIM_INTERP, on; =0 off: a skipped tick keeps the last pose, as before). Unreal's update rate optimisation in its
# trail mode: an evaluation is not shown at once but kept as the target (SkeletalMeshComponent.cpp RefreshBoneTransforms:
# CachedBoneSpaceTransforms), and every tick, the evaluating one too, the pose shown moves toward it by
# FAnimUpdateRateParameters::GetInterpolationAlpha (SkinnedMeshComponent.cpp): 1 / (EvaluationRate - SkippedEvalFrames), so it reaches
# the target the tick before the next evaluation (FAnimationRuntime::LerpBoneTransforms). Unreal interpolates only below
# MaxEvalRateForInterpolation (4, SkinnedMeshComponent.cpp ~6076): a rate of 4 or more still holds its pose. Here the pose is the
# skin's per node rotation and offset (model frame), the rotations nlerped on the shorter arc.
#
# The budget (R3D_ANIM_BUDGET, on; =0 off; R3D_ANIM_BUDGET_MS, 1.0): Unreal's AnimationBudgetAllocator (AnimationBudgetAllocator.cpp
# Update: BudgetInMs 1.0, MaxTickRate 10). Each evaluation's time is measured and smoothed into the time a work unit takes
# (AverageWorkUnitTimeMs, FInterpTo); the budget is that many units a frame. The players within their skeleton's first lod row are
# always ticked at their row's rate (Unreal's NumComponentsToNotSkip: the significant ones); when the rest ask for more units than the
# budget leaves (its pressure, smoothed like SmoothedBudgetPressure), their rates are multiplied by it, at most MaxTickRate frames a
# tick (Unreal spreads 2 .. MaxThrottleRate over the throttled by significance; here the lod rows already order them by distance, and
# one factor keeps that order). The game calls anim_budget_frame once a frame; without it the budget never throttles.
const AM_INTERP_MAX: int = 4        # MaxEvalRateForInterpolation
const AM_BUD_MAX_RATE: int = 10     # FAnimationBudgetAllocatorParameters::MaxTickRate
const AM_BUD_SMOOTH: float = 5.0    # the smoothing's speed (FInterpTo's), per second

@alloc_ok("the flags, read once")
function am_flags(anim_st: mut AnimState) -> void {
  if anim_st.ip_flag < 0 {
    anim_st.ip_flag = 1
    if Os.has_env("R3D_ANIM_INTERP") and Os.env("R3D_ANIM_INTERP") == "0" { anim_st.ip_flag = 0 }
  }
  if anim_st.bud_flag < 0 {
    anim_st.bud_flag = 1
    if Os.has_env("R3D_ANIM_BUDGET") and Os.env("R3D_ANIM_BUDGET") == "0" { anim_st.bud_flag = 0 }
    if Os.has_env("R3D_ANIM_BUDGET_MS") {
      let v = Text.to_float(Os.env("R3D_ANIM_BUDGET_MS"))
      if v > 0.0 { anim_st.bud_ms = v }
    }
  }
}

# once a frame, before the players tick: last frame's evaluations into the unit's time and the pressure, and the throttled rates'
# factor for this frame
export function anim_budget_frame(anim_st: mut AnimState, dt: float) -> void {
  if anim_st.bud_flag < 0 { am_flags(anim_st) }
  if anim_st.bud_flag == 1 and dt > 0.0 {
    let k = 1.0 - Math.exp(-dt * AM_BUD_SMOOTH)
    if anim_st.bud_n > 0 {
      let unit = float(anim_st.bud_us) / 1000.0 / float(anim_st.bud_n)
      anim_st.bud_unit += (unit - anim_st.bud_unit) * k
    }
    let units = anim_st.bud_ms / Math.max(anim_st.bud_unit, 0.001)
    let left = Math.max(units - anim_st.bud_fixed, 1.0)
    let press = anim_st.bud_ideal / left
    anim_st.bud_press += (press - anim_st.bud_press) * k
    anim_st.bud_scale = Math.clamp(anim_st.bud_press, 1.0, float(AM_BUD_MAX_RATE))
  } else { anim_st.bud_scale = 1.0 }
  anim_st.bud_us = 0
  anim_st.bud_n = 0
  anim_st.bud_ideal = 0.0
  anim_st.bud_fixed = 0.0
}

# the throttled rate (a player beyond its first lod row): its row's times the budget's factor, at most AM_BUD_MAX_RATE (never less
# than its row's)
function bud_every(anim_st: AnimState, every: int) -> int {
  if anim_st.bud_flag != 1 or anim_st.bud_scale <= 1.0 { return every }
  let e = int(Math.ceil(float(every) * anim_st.bud_scale))
  return Math.max(every, Math.min(e, AM_BUD_MAX_RATE))
}

@alloc_ok("made once a player's skin, kept after")
function ip_grow(pl: AnimPlayer, n: int) -> void {
  if pl.ip_n >= n { return }
  pl.ip_r = floats(n * 4)
  pl.ip_t = floats(n * 3)
  pl.ip_cr = floats(n * 4)
  pl.ip_ct = floats(n * 3)
  pl.ip_n = n
  pl.ip_on = false
}

function ip_save(sk: Skin, r: floats, t: floats) -> void {
  for i in 0 .. sk.n_nodes * 4 { r[i] = sk.pose_r[i] }
  for i in 0 .. sk.n_nodes * 3 { t[i] = sk.pose_t[i] }
}

function ip_load(sk: Skin, r: floats, t: floats) -> void {
  for i in 0 .. sk.n_nodes * 4 { sk.pose_r[i] = r[i] }
  for i in 0 .. sk.n_nodes * 3 { sk.pose_t[i] = t[i] }
}

# the pose shown moved toward the target by `a` (LerpBoneTransforms), folded into the joint matrices
function ip_toward(pl: AnimPlayer, sk: Skin, a: float) -> void {
  let n = sk.n_nodes
  if a >= 1.0 {
    ip_load(sk, pl.ip_r, pl.ip_t)
  } else {
    for i in 0 .. n {
      let o = i * 4
      let ax = sk.pose_r[o]
      let ay = sk.pose_r[o + 1]
      let az = sk.pose_r[o + 2]
      let aw = sk.pose_r[o + 3]
      var bx = pl.ip_r[o]
      var by = pl.ip_r[o + 1]
      var bz = pl.ip_r[o + 2]
      var bw = pl.ip_r[o + 3]
      if ax * bx + ay * by + az * bz + aw * bw < 0.0 {
        bx = -bx
        by = -by
        bz = -bz
        bw = -bw
      }
      let x = ax + (bx - ax) * a
      let y = ay + (by - ay) * a
      let z = az + (bz - az) * a
      let w = aw + (bw - aw) * a
      let l = Math.sqrt(x * x + y * y + z * z + w * w)
      if l > 0.000001 {
        sk.pose_r[o] = x / l
        sk.pose_r[o + 1] = y / l
        sk.pose_r[o + 2] = z / l
        sk.pose_r[o + 3] = w / l
      }
      let p = i * 3
      for c in 0 .. 3 { sk.pose_t[p + c] = sk.pose_t[p + c] + (pl.ip_t[p + c] - sk.pose_t[p + c]) * a }
    }
  }
  skin_pose(sk)
}

# A tick of a player into its skin. A far actor (its skeleton's lod rows, slowed by the budget) is evaluated one tick in `every`, by
# the time the skipped ones left, and plays fewer layers; below AM_INTERP_MAX its skipped ticks move toward the last evaluation's pose
# (above). False when there is nothing to play.
export function animset_tick(anim_st: mut AnimState, pl: AnimPlayer, sk: Skin, dt: float) -> bool {
  if not pl.ready or sk == null { return false }
  if anim_st.ip_flag < 0 or anim_st.bud_flag < 0 { am_flags(anim_st) }
  if pl.sk != sk {
    animset_bind_skin(pl, sk)
    pl.ip_on = false
  }
  let row = lod_pick(pl)
  var every = pl.l_every
  if row > 0 { every = bud_every(anim_st, every) }
  # the units this player asks for: the throttled ones' (beyond the first row) and the others' (within it, or no rows: the player)
  if row > 0 { anim_st.bud_ideal += 1.0 / float(Math.max(pl.l_every, 1)) } else { anim_st.bud_fixed += 1.0 / float(Math.max(pl.l_every, 1)) }
  pl.t_every = every
  let interp = anim_st.ip_flag == 1 and every > 1 and every < AM_INTERP_MAX
  pl.acc += dt
  if pl.posed and every > 1 {
    var ph = (pl.ticks + pl.seed) % every
    if ph < 0 { ph += every }
    if ph != 0 {
      pl.ticks += 1
      # GetInterpolationAlpha in trail mode: 1 / (frames to the next evaluation)
      if interp and pl.ip_on and pl.ip_n >= sk.n_nodes { ip_toward(pl, sk, 1.0 / float(every - ph)) }
      return true
    }
  }
  let t0 = Time.now_us()
  pl.ticks += 1
  let step = pl.acc
  pl.acc = 0.0
  pl.frame += 1
  pl.n_it = 0
  let n = sk.n_nodes
  # the pose shown before this evaluation: where the interpolation goes on from
  let keep = interp and pl.posed
  if keep {
    ip_grow(pl, n)
    ip_save(sk, pl.ip_cr, pl.ip_ct)
  }
  run_machine(anim_st, pl, pl.lm[0], step, 1.0)
  scratch(anim_st, n)
  for i in 0 .. n { anim_st.hit_s[i] = 0 }
  skin_reset(sk)
  if not mix_items(anim_st, pl, sk, anim_st.rot_s, anim_st.pos_s, anim_st.hit_s, false) {
    pl.ip_on = false
    return false
  }
  for li in 1 .. pl.nl {
    if li >= pl.l_layers { break }
    var w = pl.lw[li]
    if pl.lwp[li] >= 0 { w = w * Math.clamp(pl.vals[pl.lwp[li]], 0.0, 1.0) }
    if w <= 0.0005 { continue }
    pl.n_it = 0
    run_machine(anim_st, pl, pl.lm[li], step, 1.0)
    layer_scratch(anim_st, n)
    for i in 0 .. n { anim_st.lhit[i] = 0 }
    let add = pl.lmode[li] == 1
    if mix_items(anim_st, pl, sk, anim_st.lrot, anim_st.lpos, anim_st.lhit, add) { layer_apply(anim_st, sk, pl.lmask[li], w, add) }
  }
  anim_to_pose(anim_st, sk, anim_st.rot_s, anim_st.pos_s, anim_st.hit_s)
  skin_pose(sk)
  foot_ik_apply(anim_st, pl, sk, step)
  if keep {
    # the evaluation is the target; the pose shown takes its first step toward it (SkippedEvalFrames 0: 1 / every)
    ip_save(sk, pl.ip_r, pl.ip_t)
    ip_load(sk, pl.ip_cr, pl.ip_ct)
    pl.ip_on = true
    ip_toward(pl, sk, 1.0 / float(every))
  } else { pl.ip_on = false }
  pl.posed = true
  if anim_st.root_port and pl.actor >= 0 {
    if pl.rm[0] != 0.0 or pl.rm[1] != 0.0 or pl.rm[2] != 0.0 or pl.rm[3] != 0.0 {
      AnimRoot.apply(pl.actor, pl.rm[0], pl.rm[1], pl.rm[2], Math.rad_to_deg(pl.rm[3]))
      for e in 0 .. 4 { pl.rm[e] = 0.0 }
    }
  }
  anim_st.bud_us += Time.now_us() - t0
  anim_st.bud_n += 1
  return true
}

# the root motion goes to the AnimRoot port each tick, instead of waiting for anim_root_take
export function anim_root_port(anim_st: mut AnimState, on: bool) -> void { anim_st.root_port = on }
