# clip.ludic - a clip: its channels flattened into one run of key times and one of values, and the
# table of every clip read so far, found by name
export const AC_ROT: int = 0
export const AC_POS: int = 1

export property Clip {
  name:  string = "",
  dur:   float = 0.0,              # seconds: the last key of any channel
  n:     int = 0,                  # channels
  cnode: words,                    # target node per channel (the FILE's node index)
  cpath: words,                    # AC_ROT or AC_POS
  ckeys: words,                    # keys per channel
  coff:  words,                    # where this channel starts in `times`
  cvoff: words,                    # where it starts in `vals`
  times: floats,
  vals:  floats,
  oz:    pointer = null,           # the clip built in ozz for a skeleton of oz_n joints (ozz_play.ludic), made the first time it is sampled
  oz_n:  int = 0,
  oz_p:  int = 0            # 1 when it was built with its translations
}

export state AnimState {
  clips: []Clip = new []Clip
  positions: bool = false
  root_port: bool = false
  q_a: floats = floats(4)
  q_b: floats = floats(4)
  q_cur: floats = floats(4)
  q_k0: floats = floats(4)
  q_k1: floats = floats(4)
  q_r: floats = floats(4)
  v_a: floats = floats(3)
  v_b: floats = floats(3)
  v_k: floats = floats(3)
  space_tris: [][]int = new [][]int
  space_done: words = null
  facts: []AnimFact = anim_facts_new()
  n_facts: int = 0
  facts_lost: int = 0
  actor_ids: words = null
  actor_pl: []AnimPlayer = null
  n_actors: int = 0
  actor_ids_b: words = null   # the spare actor tables a rebuild swaps with (graph_actors.ludic)
  actor_pl_b: []AnimPlayer = null
  actor_reserved: int = 0
  pool_pl: []AnimPlayer = null   # the pooled players and their skins (actor_pool.ludic)
  pool_sk: []Skin = null
  pool_model: []Model = null
  pool_set: words = null
  pool_skel: words = null
  pool_busy: words = null
  pool_n: int = 0
  pool_misses: int = 0
  lrot: floats = null
  lpos: floats = null
  lhit: words = null
  parts: []floats = pose_parts_new()
  fk: []floats = fik_scratch_new()
  rot_s: floats = null
  pos_s: floats = null
  hit_s: words = null
  cap: int = 0
  # the signal bindings (link.ludic): each row's source, resolved once
  oz_use: bool = true        # sample through ozz when the native layer built the skeleton and the clip (ozz_play.ludic)
  oz_live: bool = false      # the item being mixed was sampled into oz_rot / oz_pos
  oz_rot: floats = null
  oz_pos: floats = null
  oz_cap: int = 0
  lk_n: int = -1
  lk_src: words = null
  lk_seen: words = null      # per source: 1 when a row listens to it as a fact source, else -1
  lk_sf: SigFact = sig_fact_new()
}
# Keyed translations are off unless asked for: baking keys location on every bone, and a skeleton
# does not translate its joints, so applying them turns rounding into a pose.

function clips_init() -> void {
}

# the clip of that name, or null; names are per file (per body, per species), never shared
export function anim_find(anim_st: AnimState, name: string) -> Clip {
  clips_init()
  for i in 0 .. len(anim_st.clips) { if anim_st.clips[i].name == name { return anim_st.clips[i] } }
  return null
}

export function anim_count(anim_st: AnimState) -> int {
  clips_init()
  return len(anim_st.clips)
}

# a clip made outside a glTF (a test, a generated clip); a name already held is refused
export function anim_add(anim_st: mut AnimState, c: Clip) -> bool {
  if c == null or anim_find(anim_st, c.name) != null { return false }
  push(anim_st.clips, c)
  return true
}

export function anim_clear(anim_st: mut AnimState) -> void { anim_st.clips = new []Clip }
export function anim_set_positions(anim_st: mut AnimState, on: bool) -> void { anim_st.positions = on }
export function anim_positions(anim_st: AnimState) -> bool { return anim_st.positions }

# Which key pair straddles time t, by halving rather than walking: a grazing clip is three
# hundred keys long and a valley can have dozens of animals posed in a frame.
export function anim_key_at(c: Clip, ch: int, t: float) -> int {
  let n = c.ckeys[ch]
  let o = c.coff[ch]
  if n <= 1 { return 0 }
  if t < c.times[o] { return 0 }
  if t > c.times[o + n - 1] { return n - 2 }
  var lo = 0
  var hi = n - 1
  while hi - lo > 1 {
    let mid = (lo + hi) / 2
    if c.times[o + mid] > t { hi = mid } else { lo = mid }
  }
  return lo
}
