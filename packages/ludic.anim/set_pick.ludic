# set_pick.ludic - the code's side of a graph: a parameter set, a trigger pulled, a state asked for; and
# the choice a state makes from them. Nothing here makes anything: it runs every frame.

# Write a parameter (by its place, from `anim_param_index`). An int rounds, a bool or a trigger is on
# above one half.
export function animset_param_at(pl: AnimPlayer, i: int, v: float) -> void {
  if i < 0 or pl.vals == null or i >= len(pl.vals) { return }
  let k = pl.pkind[i]
  if k == 1 { pl.vals[i] = Math.floor(v + 0.5) } else if k >= 2 {
    if v > 0.5 { pl.vals[i] = 1.0 } else { pl.vals[i] = 0.0 }
  } else { pl.vals[i] = v }
}

# a parameter's place in the player's table (-1: no graph of it declares the name); ask once, keep it
export function anim_param_index(pl: AnimPlayer, name: string) -> int { return as_param_idx(pl, name) }

export function animset_param(pl: AnimPlayer, name: string, v: float) -> void { animset_param_at(pl, as_param_idx(pl, name), v) }
export function animset_int(pl: AnimPlayer, name: string, v: int) -> void { animset_param_at(pl, as_param_idx(pl, name), float(v)) }
export function animset_bool(pl: AnimPlayer, name: string, on: bool) -> void {
  if on { animset_param_at(pl, as_param_idx(pl, name), 1.0) } else { animset_param_at(pl, as_param_idx(pl, name), 0.0) }
}
# a trigger: on until a transition that tests it is taken
export function animset_trigger(pl: AnimPlayer, name: string) -> void { animset_param_at(pl, as_param_idx(pl, name), 1.0) }
export function animset_reset_trigger(pl: AnimPlayer, name: string) -> void { animset_param_at(pl, as_param_idx(pl, name), 0.0) }
export function animset_get(pl: AnimPlayer, name: string) -> float {
  let i = as_param_idx(pl, name)
  if i < 0 { return 0.0 }
  return pl.vals[i]
}

# A state by name, taken once: the code may ask every frame, and a transition that moved the player on
# since is not undone by the same request again. WHERE the name is looked for (the addressing rule):
#   "state"            the base graph's own states first, then the first graph that has it, in machine order:
#                      the sub graphs (depth first, as they appear in the base graph), then each layer's graph
#                      (declaration order) with its own sub graphs
#   "layer/state"      a layer by its `key` (a layer's key is the AnimLayer row's), then a state of its graph
#   "sub/state"        a `sub` state by its key, then a state of the graph it runs; segments chain
#                      ("armed/aim/raise": a layer, a sub state in it, a state there)
# A request to a sub graph's state also asks the graph above it to be in the sub state that holds it (up to the
# base), or the sub graph would never run; a layer's graph runs all the time, so it needs nothing above it.
# A name nothing answers to is ignored, as it always was.
export function animset_request(pl: AnimPlayer, key: string) -> void {
  if pl.set < 0 or pl.mach == null or len(pl.mach) == 0 { return }
  let mi = as_resolve(pl, key)
  if mi < 0 { return }
  let m = pl.mach[mi]
  if key == m.asked { return }
  let leaf = as_last_slash(key) + 1
  let i = as_state_at(AnimSets[m.set], key, leaf, len(key))
  if i < 0 { return }
  m.asked = key
  m.want = i
  if mi == 0 {
    let v = as_via(pl, m, key)
    if v >= 0 { m.want = v }
  } else {
    m.hold = -1
    if m.n_i == 0 { m.hold = i }
    as_raise(pl, mi, 0)
  }
}

# the place of the last `/` in a key, -1 for none
function as_last_slash(key: string) -> int {
  var at = -1
  for k in 0 .. len(key) { if key[k] == 47 { at = k } }
  return at
}

# a state of the graph by the bytes key[a..b], without making a string
function as_state_at(s: AnimSet, key: string, a: int, b: int) -> int {
  if s.states == null or b <= a { return -1 }
  for i in 0 .. len(s.states) {
    let k = s.states[i].key
    if len(k) != b - a { continue }
    var same = true
    for j in 0 .. len(k) { if k[j] != key[a + j] { same = false } }
    if same { return i }
  }
  return -1
}

function as_same_at(name: string, key: string, a: int, b: int) -> bool {
  if len(name) != b - a or b <= a { return false }
  for j in 0 .. len(name) { if name[j] != key[a + j] { return false } }
  return true
}

# one step of a qualified name from machine mi: a layer of the base graph by its key, else a sub state of this
# machine's graph by its key; the machine it leads to, or -1
function as_enter(pl: AnimPlayer, mi: int, key: string, a: int, b: int) -> int {
  let m = pl.mach[mi]
  let s = AnimSets[m.set]
  if mi == 0 and s.layers != null {
    var n = 1
    for i in 0 .. len(s.layers) {
      let l = s.layers[i]
      if n >= len(pl.lm) or l.graph < 0 or l.graph >= len(AnimSets) { continue }
      if as_same_at(l.key, key, a, b) { return pl.lm[n] }
      n += 1
    }
  }
  let st = as_state_at(s, key, a, b)
  if st >= 0 and s.states[st].kind == "sub" { return m.sub[st] }
  return -1
}

# the machine a request's name addresses (see animset_request), -1 when no graph of the player has that state
function as_resolve(pl: AnimPlayer, key: string) -> int {
  let cut = as_last_slash(key)
  if cut < 0 {
    for mi in 0 .. len(pl.mach) {
      if as_state_at(AnimSets[pl.mach[mi].set], key, 0, len(key)) >= 0 { return mi }
    }
    return -1
  }
  var mi = 0
  var p = 0
  while p < cut {
    var e = p
    while e < cut and key[e] != 47 { e += 1 }
    mi = as_enter(pl, mi, key, p, e)
    if mi < 0 { return -1 }
    p = e + 1
  }
  if as_state_at(AnimSets[pl.mach[mi].set], key, cut + 1, len(key)) < 0 { return -1 }
  return mi
}

# a request reached a sub graph's machine: every graph above it goes to the sub state that runs it
function as_raise(pl: AnimPlayer, mi: int, depth: int) -> void {
  if depth > AM_DEPTH { return }
  for pi in 0 .. len(pl.mach) {
    let pm = pl.mach[pi]
    for st in 0 .. pm.ns {
      if pm.sub[st] == mi {
        pm.want = st
        if pi != 0 { as_raise(pl, pi, depth + 1) }
        return
      }
    }
  }
}

# the one-shot a request goes by: a `via` edge from where the code last asked (or "*") to this state,
# whose clip the rig carries; -1 for none
function as_via(pl: AnimPlayer, m: AnimMachine, key: string) -> int {
  let s = AnimSets[pl.set]
  if s.transitions == null { return -1 }
  for i in 0 .. len(s.transitions) {
    let tr = s.transitions[i]
    if tr.via != "" and tr.to == key and (tr.from == "*" or tr.from == m.asked) and animset_can(pl, tr.via) { return as_state(s, tr.via) }
  }
  return -1
}

# the state is in the set and the rig carries one of its clips: a one-shot with none is not asked for
export function animset_can(pl: AnimPlayer, key: string) -> bool {
  if pl.set < 0 or pl.mach == null { return false }
  let m = pl.mach[0]
  let i = as_state(AnimSets[pl.set], key)
  if i < 0 { return false }
  if AnimSets[pl.set].states[i].kind == "sub" { return m.sub[i] >= 0 }
  for c in 0 .. m.ncl[i] { if m.clips[m.base[i] + c] != null { return true } }
  return false
}

function as_holds(pl: AnimPlayer, m: AnimMachine, slot: int, c: AnimChoice) -> bool {
  if c.need == null { return true }
  let nb = m.nbase[slot]
  for k in 0 .. len(c.need) {
    let pi = m.nparam[nb + k]
    var v = 0.0
    if pi >= 0 { v = pl.vals[pi] }
    if not (v > c.need[k].over and v < c.need[k].under) { return false }
  }
  return true
}

# the state's first choice that holds and whose clip the rig has; -1 none
function as_pick(pl: AnimPlayer, m: AnimMachine, st: int) -> int {
  let d = AnimSets[m.set].states[st]
  if d.choices == null { return -1 }
  let b = m.base[st]
  for c in 0 .. len(d.choices) {
    if m.clips[b + c] != null and as_holds(pl, m, b + c, d.choices[c]) { return c }
  }
  return -1
}

# a state's playing rate: the choice's (or its rate by a parameter over the ground a cycle covers), held
# to the state's range, times the state's own speed and its speed parameter
function as_rate(pl: AnimPlayer, m: AnimMachine, st: int, slot: int, c: AnimChoice) -> float {
  let d = AnimSets[m.set].states[st]
  var r = c.rate
  if m.rby[slot] >= 0 and c.ground > 0.0 { r = pl.vals[m.rby[slot]] / c.ground }
  r = Math.clamp(r, d.rate_min, d.rate_max)
  return r * as_speed(pl, m, st)
}

# `duration_by`: the state's clip (a blend's weighted cycle) played over that parameter's seconds, so a reload
# clip ends with the magazine whatever the weapon's reload time. Nothing while the parameter is 0 or less.
function as_fit(pl: AnimPlayer, m: AnimMachine, st: int, dur: float) -> float {
  if m.dby[st] < 0 { return 1.0 }
  let t = pl.vals[m.dby[st]]
  if t > 0.01 and dur > 0.0 { return dur / t }
  return 1.0
}

function as_speed(pl: AnimPlayer, m: AnimMachine, st: int) -> float {
  var r = AnimSets[m.set].states[st].speed
  if m.spd[st] >= 0 { r = r * pl.vals[m.spd[st]] }
  return r
}
