# studio.lres - how Ludic Studio draws this package's own data. The studio's file: the compiler never
# reads it, and it counts only in a game that uses ludic.anim (the game has the AnimSets registry).
# A game that wants clips played from its own rig table writes an entry of the same key in its
# studio.lres (rig_table, rig_graph, rig_file, rig_node and clip_pattern name the game's fields: a rig
# is the game's, not this package's); its entry replaces this one.

# the animation sets: states are nodes, transitions edges, and inside a state an ordered list of
# choices (the first whose need bands all hold plays) with a rate, or a rate by a parameter over ground
anims {
  title: "Animation"
  table: "AnimSets"
  nodes: "states"
  node_key: "key"
  edges: "transitions"
  edge_from: "from"
  edge_to: "to"
  any: "*"
  entry: "entry"
  links: ["next"]
  params: "params"
  choices: "choices"
  choice_clip: "clip"
  choice_need: "need"
  need_param: "param"
  need_over: "over"
  need_under: "under"
  choice_rate: "rate"
  choice_rate_by: "rate_by"
  choice_ground: "ground"
  node_blend: "blend"
}
