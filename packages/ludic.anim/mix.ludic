# mix.ludic - sample one clip at a time into per-node buffers, mixed in at a weight. `rot` is 4 per
# node, `pos` 3 per node, and `hit` says which nodes have received a value (bit 0 a rotation, bit 1
# a translation), so a node the clips never mention stays at rest

export function anim_mix(anim_st: mut AnimState, c: Clip, sk: Skin, t: float, w: float, rot: floats, pos: floats, hit: words) -> void {
  if c == null or sk == null { return }
  var tt = t
  if c.dur > 0.0 { tt = t % c.dur }
  mix_clip(anim_st, c, sk, tt, w, rot, pos, hit, false, 0.0, 0, -1, -1)
}

# `tt` is already on the clip (no wrapping: a one-shot holds its last frame at its duration).
# `add`: the sampled motion is taken as a change away from the clip's own pose at `ref`
# (rotation L * Lref^-1, translation L - Lref), to be added over a base pose.
# `ex` (root motion extracted): bit 0 holds the root's x and z at where the clip starts, bit 1 its y,
# bit 2 takes the root's yaw out; `rp` and `rr` are the root's translation and rotation channels.
export function mix_clip(anim_st: mut AnimState, c: Clip, sk: Skin, tt: float, w: float, rot: floats, pos: floats, hit: words, add: bool, ref: float, ex: int, rp: int, rr: int) -> void {
  for ch in 0 .. c.n {
    let node = c.cnode[ch]
    if node < 0 or node >= sk.n_nodes { continue }
    if c.cpath[ch] == AC_ROT {
      if anim_st.oz_live { q_load(anim_st.q_a, anim_st.oz_rot, node) } else { sample_rot(anim_st, c, ch, tt, anim_st.q_a) }
      if add {
        sample_rot(anim_st, c, ch, ref, anim_st.q_r)
        q_conj(anim_st.q_r, anim_st.q_r)
        q_mul(anim_st.q_a, anim_st.q_a, anim_st.q_r)
      } else if ch == rr and (ex & 4) != 0 {
        sample_rot(anim_st, c, ch, 0.0, anim_st.q_r)
        let dy = q_yaw(anim_st.q_a) - q_yaw(anim_st.q_r)
        q_axis_angle(anim_st.q_r, 0.0, 1.0, 0.0, -dy)
        q_mul(anim_st.q_a, anim_st.q_r, anim_st.q_a)
      }
      mix_rot(anim_st, node, w, rot, hit)
    } else {
      if anim_st.oz_live {
        for e in 0 .. 3 { anim_st.v_a[e] = anim_st.oz_pos[node * 3 + e] }
      } else { sample_pos(c, ch, tt, anim_st.v_a) }
      if add {
        sample_pos(c, ch, ref, anim_st.v_b)
        for e in 0 .. 3 { anim_st.v_a[e] = anim_st.v_a[e] - anim_st.v_b[e] }
      } else if ch == rp and (ex & 3) != 0 {
        sample_pos(c, ch, 0.0, anim_st.v_b)
        if (ex & 1) != 0 {
          anim_st.v_a[0] = anim_st.v_b[0]
          anim_st.v_a[2] = anim_st.v_b[2]
        }
        if (ex & 2) != 0 { anim_st.v_a[1] = anim_st.v_b[1] }
      }
      pos_onto_skin(anim_st, c, ch, sk, node, add)
      mix_pos(anim_st, node, w, pos, hit)
    }
  }
}

# A translation key (in anim_st.v_a) put on the skin's own bone. The clip was keyed on its file's rig, whose bones
# may be longer or shorter than this skin's (one clip library, several bodies): the key is taken as a move away
# from the clip rig's rest, scaled by how much longer the skin's bone is, and put on the skin's rest. A constant
# channel (a bone's length, not a motion) so becomes the skin's own bone, and the hips' bob grows with the legs.
# The skin of the clip's own rig gets the key unchanged, and so does every skin for a clip made in code (no `crest`:
# keyed for the skin it plays on). An additive key (a change already) is only scaled.
function pos_onto_skin(anim_st: mut AnimState, c: Clip, ch: int, sk: Skin, node: int, add: bool) -> void {
  if c.crest == null { return }
  let rx = c.crest[ch * 3];  let ry = c.crest[ch * 3 + 1];  let rz = c.crest[ch * 3 + 2]
  let sx = sk.rest_t[node * 3];  let sy = sk.rest_t[node * 3 + 1];  let sz = sk.rest_t[node * 3 + 2]
  let lc = Math.sqrt(rx * rx + ry * ry + rz * rz)
  var k = 1.0
  if lc > 0.00001 { k = Math.sqrt(sx * sx + sy * sy + sz * sz) / lc }
  if add {
    for e in 0 .. 3 { anim_st.v_a[e] = anim_st.v_a[e] * k }
    return
  }
  anim_st.v_a[0] = sx + (anim_st.v_a[0] - rx) * k
  anim_st.v_a[1] = sy + (anim_st.v_a[1] - ry) * k
  anim_st.v_a[2] = sz + (anim_st.v_a[2] - rz) * k
}

# the key pair round t and how far between them
function key_pair(c: Clip, ch: int, t: float, out: floats) -> void {
  let n = c.ckeys[ch]
  let o = c.coff[ch]
  let i0 = anim_key_at(c, ch, t)
  var i1 = i0 + 1
  if i1 > n - 1 { i1 = n - 1 }
  var f = 0.0
  if i1 > i0 {
    let span = c.times[o + i1] - c.times[o + i0]
    if span > 0.000001 { f = Math.clamp((t - c.times[o + i0]) / span, 0.0, 1.0) }
  }
  out[0] = float(i0)
  out[1] = float(i1)
  out[2] = f
}

# a channel's rotation at t, into q (nlerp between its two keys)
export function sample_rot(anim_st: mut AnimState, c: Clip, ch: int, t: float, q: floats) -> void {
  key_pair(c, ch, t, anim_st.v_k)
  let i0 = int(anim_st.v_k[0])
  let i1 = int(anim_st.v_k[1])
  let vo = c.cvoff[ch]
  for e in 0 .. 4 {
    anim_st.q_k0[e] = c.vals[vo + i0 * 4 + e]
    anim_st.q_k1[e] = c.vals[vo + i1 * 4 + e]
  }
  q_nlerp(q, anim_st.q_k0, anim_st.q_k1, anim_st.v_k[2])
}

# a channel's translation at t, into v
export function sample_pos(c: Clip, ch: int, t: float, v: floats) -> void {
  let n = c.ckeys[ch]
  let o = c.coff[ch]
  let i0 = anim_key_at(c, ch, t)
  var i1 = i0 + 1
  if i1 > n - 1 { i1 = n - 1 }
  var f = 0.0
  if i1 > i0 {
    let span = c.times[o + i1] - c.times[o + i0]
    if span > 0.000001 { f = Math.clamp((t - c.times[o + i0]) / span, 0.0, 1.0) }
  }
  let vo = c.cvoff[ch]
  for e in 0 .. 3 { v[e] = Math.lerp(c.vals[vo + i0 * 3 + e], c.vals[vo + i1 * 3 + e], f) }
}

# the rotation's turn about the vertical axis, radians
export function q_yaw(q: floats) -> float {
  return Math.atan2(2.0 * (q[3] * q[1] + q[0] * q[2]), 1.0 - 2.0 * (q[0] * q[0] + q[1] * q[1]))
}

# Across clips the first contributor lands and the rest are nlerped onto it by their share, which
# is what makes a cross-fade rather than a jump. Test the ROTATION bit, not the whole word: glTF
# writes a node's translation before its rotation, and `hit == 0` then skipped every rotation.
function mix_rot(anim_st: mut AnimState, node: int, w: float, rot: floats, hit: words) -> void {
  if (hit[node] & 1) == 0 {
    q_store(rot, node, anim_st.q_a)
    hit[node] = hit[node] | 1
  } else {
    q_load(anim_st.q_cur, rot, node)
    q_nlerp(anim_st.q_cur, anim_st.q_cur, anim_st.q_a, w)
    q_store(rot, node, anim_st.q_cur)
  }
}

function mix_pos(anim_st: AnimState, node: int, w: float, pos: floats, hit: words) -> void {
  if (hit[node] & 2) == 0 {
    for e in 0 .. 3 { pos[node * 3 + e] = anim_st.v_a[e] }
    hit[node] = hit[node] | 2
  } else {
    for e in 0 .. 3 { pos[node * 3 + e] = Math.lerp(pos[node * 3 + e], anim_st.v_a[e], w) }
  }
}
