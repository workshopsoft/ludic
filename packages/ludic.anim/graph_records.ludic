# graph_records.ludic - what a graph points at: blend spaces, the rigs' skeletons (bone maps and
# the update rate by distance), bone masks, and what a clip says about itself (events, sync markers,
# root motion). All of it rows a game fills (`def AnimBlendSpaces from "..."`), none of it code.

# one sample of a blend space: a clip (the rig's prefix goes before it) at a point of the parameters' plane
export property AnimBlendSample {
  clip: string = ""
  x: float = 0.0
  y: float = 0.0
}

# a 1D space (`x_param`: speed, steer) or a 2D one (`x_param` and `y_param`: speed by direction, aim yaw
# by pitch). The weights are exact: 1D lerps the two samples round the value, 2D the barycentre of the
# triangle of samples it is in (a triangulation made once), and a value outside is held at the edge.
export property AnimBlendSpace {
  key: string = ""
  @Range(1, 2) dims: int = 1
  x_param: string = ""
  y_param: string = ""
  samples: []AnimBlendSample = null
  sync: bool = true           # the samples share one phase (locomotion); false: each plays its own time
}

# a canonical bone name a mask or an event may use, and the node it is on this rig ("hand_r" is
# Mixamo's "mixamorig:RightHand"); a name the list does not hold is taken as the node's own name
export property AnimBone {
  name: string = ""
  node: string = ""
}

# how often a rig far from the camera is updated: the first level whose `dist` is at least the distance
# applies; past the last, the last
export property AnimLod {
  @Unit("m") dist: float = 0.0
  @Range(1, 64) every: int = 1      # update one frame in this many (a longer step then)
  @Range(0, 8) layers: int = 8      # layers played at all, the base one first
  events: bool = true               # clip events fire (off: a far actor makes no sound)
}

# a rig: its file, the prefix its clips carry, its bone names and its level of detail
export property AnimSkeleton {
  key: string = ""
  @Asset("gltf") model: string = ""
  @Node(model) root: string = ""    # the bone whose motion a clip's root motion is
  prefix: string = ""               # its clips are "<prefix>_<name>"
  bones: []AnimBone = null
  lod: []AnimLod = null
}

# one row of a mask: a bone (and, with `below`, every bone under it) at a weight
export property AnimMaskRow {
  bone: string = ""
  @Range(0, 1) weight: float = 1.0
  below: bool = true
}

# which bones a layer reaches and how much: the upper body, the head, an arm. A bone no row names
# has `default`, or its parent's weight when that row said `below`
export property AnimMask {
  key: string = ""
  @Ref(AnimSkeletons) skeleton: int = -1
  @Range(0, 1) default: float = 0.0
  rows: []AnimMaskRow = null
}

# a keyed time on a clip. A plain event is one fact when the clip passes `at`; with `until` later than
# `at` it is a window: a `begin` fact at `at` and an `end` at `until` (or a `cancel` if the clip is
# left while it is open). Times are seconds, or 0..1 of the clip with `normalized`.
export property AnimEvent {
  name: string = ""
  @Unit("s") at: float = 0.0
  @Unit("s") until: float = -1.0
  normalized: bool = false
  arg: string = ""
  value: float = 0.0
  @Range(0, 1) min_weight: float = 0.01   # fires only while the clip has more than this share of the pose
}

# a named point of a cycle (a foot down): clips of a sync group line their markers up
export property AnimMarker {
  name: string = ""
  @Unit("s") at: float = 0.0
}

# what a clip says about itself, by its name without the rig's prefix ("walk"). One row serves every rig
# that has the clip. `model` and `clip` are for the editor's timeline: the file and the clip's own name.
export property AnimClipInfo {
  key: string = ""
  @Asset("gltf") model: string = ""
  @Clip(model) clip: string = ""
  events: []AnimEvent = null
  markers: []AnimMarker = null
  @OneOf("none", "extract") root_motion: string = "none"   # extract: the root's motion is reported and the body kept in place
  @OneOf("xz", "xyz") root_axes: string = "xz"
  root_turn: bool = false     # the root's yaw is extracted too
  root_bone: string = ""      # canonical name; the skeleton's root when empty
  @Unit("s") ref_time: float = 0.0    # an additive layer's reference frame
  @Unit("s") duration: float = 0.0    # the length the clip is PLANNED to have, before it is authored (0: unknown); a studio reads it, the runtime never does
}

@ByKey
export open registry AnimBlendSpaces of AnimBlendSpace as ABS
@ByKey
export open registry AnimSkeletons of AnimSkeleton as ASK
@ByKey
export open registry AnimMasks of AnimMask as AMASK
@ByKey
export open registry AnimClips of AnimClipInfo as ACLIP

# what happened on a clip, for gameplay and audio to drain (anim_fact_count / anim_fact_at)
export const AF_NOTIFY: int = 0
export const AF_BEGIN: int = 1
export const AF_END: int = 2
export const AF_CANCEL: int = 3

export property AnimFact {
  actor: int = 0
  kind: int = 0             # AF_NOTIFY, AF_BEGIN, AF_END or AF_CANCEL
  name: string = ""
  clip: string = ""         # the playing clip's full name
  arg: string = ""
  value: float = 0.0
  weight: float = 0.0       # the clip's share of the pose when it fired
  time: float = 0.0         # seconds on the clip
}
