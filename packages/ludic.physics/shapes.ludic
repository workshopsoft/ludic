# shapes.ludic - shapes: made in C, kept here, named by an int. A shape may be used by any number of
# bodies; phys_close (world.ludic) frees them all.

# a crate: half extents in metres
@creates(PhysShape)
export function phys_box(physics_st: mut PhysicsState, hx: float, hy: float, hz: float) -> int { return ph_keep(physics_st, jph_shape_box(hx, hy, hz)) }
@creates(PhysShape)
export function phys_sphere(physics_st: mut PhysicsState, r: float) -> int { return ph_keep(physics_st, jph_shape_sphere(r)) }
# a trunk or a body: upright, its straight part 2 * half_h tall, centred on its origin
@creates(PhysShape)
export function phys_capsule(physics_st: mut PhysicsState, half_h: float, r: float) -> int { return ph_keep(physics_st, jph_shape_capsule(half_h, r)) }
# a post: upright, 2 * half_h tall, centred on its origin
@creates(PhysShape)
export function phys_cylinder(physics_st: mut PhysicsState, half_h: float, r: float) -> int { return ph_keep(physics_st, jph_shape_cylinder(half_h, r)) }
# a boulder: a dome r across and h tall, standing on its origin
export function phys_dome(physics_st: mut PhysicsState, r: float, h: float) -> int { return ph_keep(physics_st, jph_shape_dome(r, h)) }

# a rock: the convex hull of n points (x, y, z) about its origin, its edges rounded by 2 cm
@creates(PhysShape)
export function phys_convex(physics_st: mut PhysicsState, v: []float, n: int) -> int {
  if n < 4 or len(v) < n * 3 { return -1 }
  return ph_keep(physics_st, jph_shape_convex(v, n, 0.02))
}
# a building's piece: the convex polygon of n points (x, z pairs, in world metres), stood up from y0 to y1 about the world's origin
# (put the body at 0, 0, 0). The points go through a scratch the state keeps (grown only for a polygon larger than it has held), so a
# chunk of buildings loading makes no record a piece. ludic.city's colliders hand pieces in this form (CityPiece).
@creates(PhysShape)
export function phys_prism(physics_st: mut PhysicsState, pts: []float, n: int, y0: float, y1: float) -> int {
  if n < 3 or len(pts) < n * 2 or not (y1 > y0) { return -1 }
  if len(physics_st.ph_prism) < n * 6 {
    @alloc_ok("a polygon larger than any before: the scratch grows once")
    physics_st.ph_prism = floats(n * 6)
  }
  let v = physics_st.ph_prism
  for i in 0 .. n {
    v[i * 3] = pts[i * 2];  v[i * 3 + 1] = y0;  v[i * 3 + 2] = pts[i * 2 + 1]
    v[(n + i) * 3] = pts[i * 2];  v[(n + i) * 3 + 1] = y1;  v[(n + i) * 3 + 2] = pts[i * 2 + 1]
  }
  return ph_keep(physics_st, jph_shape_convex(v, n * 2, 0.02))
}
# another shape k times its size, so one hull serves every boulder of its shape
@creates(PhysShape)
export function phys_scaled(physics_st: mut PhysicsState, shape: int, k: float) -> int {
  let s = ph_shape(physics_st, shape)
  if s == null { return -1 }
  return ph_keep(physics_st, jph_shape_scaled(s, k))
}

# another shape moved and turned about y inside its body (a post whose foot is its origin)
@creates(PhysShape)
export function phys_offset(physics_st: mut PhysicsState, shape: int, x: float, y: float, z: float, yaw: float) -> int {
  let s = ph_shape(physics_st, shape)
  if s == null { return -1 }
  return ph_keep(physics_st, jph_shape_offset(s, x, y, z, yaw))
}

# n x n heights, row by row along z, the first at (ox, oz), cell metres apart; PHYS_HOLE is none
export const PHYS_HOLE: float = 340282346638528859811704183484516925440.0
@creates(PhysShape)
export function phys_heightfield(physics_st: mut PhysicsState, h: []float, n: int, ox: float, oz: float, cell: float) -> int {
  if len(h) < n * n { return -1 }
  return ph_keep(physics_st, jph_shape_heightfield(h, n, ox, oz, cell))
}

# The same ground as phys_heightfield, cut into triangles the way ludic.render3d's terrain mesh cuts it. A heightfield's cell is two
# triangles, and Jolt splits it from (i, j) to (i + 1, j + 1); the renderer's level 0 splits it from (i + 1, j) to (i, j + 1) (tilemap_lwt.ludic).
# Over four samples that are not in one plane (a bluff, a crest, a quay's edge) the two surfaces differ by up to a quarter of the twist
# (24 cm on a 2 m bluff over 1 m cells), so a body would stand off the ground that is drawn. This one is the same field turned a quarter
# round (the samples are re-laid, the shape turned back by 90 degrees about y inside its body), so Jolt's diagonal is the renderer's:
# the surface a ray finds is the mesh's. Same arguments, same holes (PHYS_HOLE), the same bytes a call: a scratch the state keeps.
@creates(PhysShape)
export function phys_heightfield_tiles(physics_st: mut PhysicsState, h: []float, n: int, ox: float, oz: float, cell: float) -> int {
  if len(h) < n * n { return -1 }
  if len(physics_st.ph_hf) < n * n {
    @alloc_ok("a field larger than any before: the scratch grows once")
    physics_st.ph_hf = floats(n * n)
  }
  let r = physics_st.ph_hf
  # local x = -(world z - oz) + (n - 1) cell, local z = world x - ox: column a = n - 1 - j, row b = i
  for j in 0 .. n { for i in 0 .. n { r[i * n + (n - 1 - j)] = h[j * n + i] } }
  let base = jph_shape_heightfield(r, n, 0.0, 0.0, cell)
  if base == null { return -1 }
  let id = ph_keep(physics_st, jph_shape_offset(base, ox, 0.0, oz + float(n - 1) * cell, 1.5707964))
  # the turned shape holds the field: the first handle is not needed
  jph_shape_free(base)
  return id
}

# the ground as a renderer draws a cubic B-spline height map: tex is n x n texels, the first
# texel's centre at (ox, oz), cell metres apart; the smoothing is done in C
@creates(PhysShape)
export function phys_heightfield_smooth(physics_st: mut PhysicsState, tex: []float, n: int, ox: float, oz: float, cell: float) -> int {
  if len(tex) < n * n { return -1 }
  return ph_keep(physics_st, jph_shape_heightfield_bspline(tex, n, ox, oz, cell))
}

# a dock or a cabin: v holds nv points (x, y, z), tri holds nt triangles (i, j, k)
@creates(PhysShape)
export function phys_mesh(physics_st: mut PhysicsState, v: []float, nv: int, tri: []int, nt: int) -> int {
  if len(v) < nv * 3 or len(tri) < nt * 3 { return -1 }
  return ph_keep(physics_st, jph_shape_mesh(v, nv, tri, nt))
}
