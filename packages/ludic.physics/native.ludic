extern function jph_char_free(k: pointer) -> void = "jph_char_free"
extern function jph_char_limits(k: pointer, step_up: float, stick: float) -> void = "jph_char_limits"
extern function jph_char_step(w: pointer, k: pointer, dt: float, vx: float, vz: float, jump: float) -> int = "jph_char_step"
extern function jph_char_read(k: pointer, out: pointer) -> void = "jph_char_read"
extern function jph_char_place(w: pointer, k: pointer, x: float, y: float, z: float) -> void = "jph_char_place"
