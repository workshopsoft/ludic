# what Jolt holds now, the most it has held, and the blocks it has asked for (counted in the shim)
export function phys_heap_bytes() -> long { return jph_heap_bytes() }
export function phys_heap_peak() -> long { return jph_heap_peak() }
export function phys_heap_allocs() -> long { return jph_heap_allocs() }
