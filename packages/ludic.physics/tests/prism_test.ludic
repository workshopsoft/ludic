# prism_test.ludic - a building's piece: a convex polygon stood up between two heights (phys_prism), the form ludic.city's baked colliders
# reach physics in. A ray finds its roof and its walls where the polygon says, and a polygon that is no shape is refused.
import "ludic.physics"
import "ludic.base"
program PrismTest {
  numbers float
  function ray(physics_st: mut PhysicsState, ox: float, oy: float, oz: float, dx: float, dy: float, dz: float) -> PhysHit {
    let h = new PhysHit
    phys_ray(physics_st, ox, oy, oz, dx, dy, dz, PHYS_M_ALL, h)
    return h
  }

  # a hexagon-ish slab 10 m wide along x, 6 deep, standing from 2 to 12 m, 100 m east of the origin
  function slab() -> floats {
    let p = floats(12)
    p[0] = 95.0;  p[1] = -3.0;  p[2] = 105.0;  p[3] = -3.0;  p[4] = 107.0;  p[5] = 0.0
    p[6] = 105.0;  p[7] = 3.0;  p[8] = 95.0;  p[9] = 3.0;  p[10] = 93.0;  p[11] = 0.0
    return p
  }

  test "a prism has a roof at y1 and walls where the polygon's edges are" (physics_st: mut PhysicsState) {
    expect(phys_open(physics_st, 16, 1))
    let s = phys_prism(physics_st, slab(), 6, 2.0, 12.0)
    expect(s >= 0)
    phys_static_add(physics_st, s, 0.0, 0.0, 0.0, 0.0)
    phys_settle(physics_st)
    let roof = ray(physics_st, 100.0, 30.0, 0.0, 0.0, -40.0, 0.0)
    expect(roof.body >= 0)
    expect(Math.abs(roof.y - 12.0) < 0.05)
    expect(ray(physics_st, 100.0, 30.0, 4.0, 0.0, -40.0, 0.0).body < 0)              # past the +z wall: nothing
    let wall = ray(physics_st, 80.0, 6.0, 0.0, 40.0, 0.0, 0.0)                       # along +x at 6 m: the west point (93, 0)
    expect(wall.body >= 0)
    expect(Math.abs(wall.x - 93.0) < 0.1)
    expect(ray(physics_st, 80.0, 1.0, 0.0, 40.0, 0.0, 0.0).body < 0)                 # under its foot (2 m): it passes
    expect(ray(physics_st, 80.0, 13.0, 0.0, 40.0, 0.0, 0.0).body < 0)                # over its roof
    phys_close(physics_st)
  }

  test "a polygon that is no shape is refused" (physics_st: mut PhysicsState) {
    expect(phys_open(physics_st, 16, 1))
    expect_eq(phys_prism(physics_st, slab(), 2, 2.0, 12.0), -1)
    expect_eq(phys_prism(physics_st, slab(), 6, 12.0, 2.0), -1)
    expect_eq(phys_prism(physics_st, floats(4), 6, 2.0, 12.0), -1)
    phys_close(physics_st)
  }

  test "a polygon larger than the scratch grows it, and the next is made as before" (physics_st: mut PhysicsState) {
    expect(phys_open(physics_st, 16, 1))
    let n = 200
    let p = floats(n * 2)
    for i in 0 .. n {
      let a = float(i) * 6.2831853 / float(n)
      p[i * 2] = 50.0 + 5.0 * Math.cos(a);  p[i * 2 + 1] = 5.0 * Math.sin(a)
    }
    expect(phys_prism(physics_st, p, n, 0.0, 4.0) >= 0)
    expect(phys_prism(physics_st, slab(), 6, 2.0, 12.0) >= 0)
    phys_close(physics_st)
  }
}
