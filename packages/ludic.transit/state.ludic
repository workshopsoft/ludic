# state.ludic - the network a map was built into, the planner's scratch and answer, who is riding, and the
# vehicles handed to the game. Every list is sized when the map is built or the first ride is made and kept.

export const TR_INF: int = 1000000000
export const TR_PK_NONE: int = 0         # a stop not reached
export const TR_PK_ORIGIN: int = 1       # reached by the walk from where the journey starts
export const TR_PK_RIDE: int = 2
export const TR_PK_WALK: int = 3         # reached by a walk from another stop
export const TR_LD_SLOTS: int = 4096     # runs with riders at once (a power of two)
export const TR_TICKETS_MAX: int = 100000

export state TransitState {
  tr_err: string = ""
  tr_built: bool = false
  # the numbers
  tr_walk_speed: float = 1.3
  tr_max_walk: float = 600.0
  tr_walk_only: float = 1500.0
  tr_transfer_radius: float = 120.0
  tr_min_transfer: int = 45
  tr_horizon: int = 14400
  tr_dflt_headway: int = 600
  # stops
  tr_skey: []string = new []string
  tr_sname: []string = new []string
  tr_sx: []float = new []float
  tr_sz: []float = new []float
  tr_szone: []int = new []int
  tr_hslot: []int = new []int                 # the stops' keys hashed (open addressing): a stop's index, -1 empty
  tr_bay_start: []int = new []int            # stop s's bays: tr_bay_*[tr_bay_start[s] .. tr_bay_start[s + 1])
  tr_bay_line: []int = new []int
  tr_bay_x: []float = new []float
  tr_bay_z: []float = new []float
  tr_sr_start: []int = new []int             # the (route, index on it) pairs that serve stop s
  tr_sr_route: []int = new []int
  tr_sr_k: []int = new []int
  tr_tl_start: []int = new []int             # the walks from stop s to other stops
  tr_tl_to: []int = new []int
  tr_tl_secs: []int = new []int
  tr_g_minx: float = 0.0
  tr_g_minz: float = 0.0
  tr_g_cell: float = 600.0
  tr_g_w: int = 1
  tr_g_h: int = 1
  tr_g_start: []int = new []int              # the stops in grid cell c
  tr_g_stop: []int = new []int
  # lines, each with a polyline (arc lengths already scaled to road distance)
  tr_lkey: []string = new []string
  tr_lname: []string = new []string
  tr_lmode: []int = new []int
  tr_lok: []int = new []int
  tr_lscale: []float = new []float            # arc length per metre of straight path
  tr_llen: []float = new []float
  tr_lpt_start: []int = new []int
  tr_lpx: []float = new []float
  tr_lpz: []float = new []float
  tr_lps: []float = new []float
  tr_lseg_start: []int = new []int
  tr_lseg: []string = new []string
  # routes: line * 2 + direction. Stop k of route r is tr_rstop[tr_rstart[r] + k]
  tr_rok: []int = new []int
  tr_rstart: []int = new []int
  tr_rn: []int = new []int
  tr_rstop: []int = new []int
  tr_rarr: []int = new []int                  # seconds after the run's departure that it arrives at stop k
  tr_rdep: []int = new []int                  # ... and leaves it
  tr_rs: []float = new []float                # arc length along the route's direction at stop k
  tr_rtotal: []int = new []int
  tr_tt_start: []int = new []int              # the departures from the first stop, seconds after midnight, ascending
  tr_tt_n: []int = new []int
  tr_tt: []int = new []int
  # planner scratch: stamped so a query clears nothing
  tr_gen: int = 0
  tr_stamp: []int = new []int
  tr_arr: []int = new []int
  tr_pkind: []int = new []int
  tr_pstop: []int = new []int
  tr_proute: []int = new []int
  tr_prun: []int = new []int
  tr_pk0: []int = new []int
  tr_pk1: []int = new []int
  tr_rt_stamp: []int = new []int
  tr_rt_run: []int = new []int
  tr_rt_k: []int = new []int
  tr_hk: []int = new []int
  tr_hv: []int = new []int
  tr_tmp: []int = new []int
  tr_near: []int = new []int
  # the journey last planned
  tr_pl_n: int = 0
  tr_pl_arrival: int = 0
  tr_pl_fare_total: int = 0
  tr_pl_rides: int = 0
  tr_pl_kind: []int = new []int
  tr_pl_t0: []int = new []int
  tr_pl_t1: []int = new []int
  tr_pl_line: []int = new []int
  tr_pl_run: []int = new []int
  tr_pl_stop0: []int = new []int
  tr_pl_stop1: []int = new []int
  tr_pl_fare: []int = new []int
  tr_pl_x0: []float = new []float
  tr_pl_z0: []float = new []float
  tr_pl_x1: []float = new []float
  tr_pl_z1: []float = new []float
  # one vehicle asked about
  tr_pose_x: float = 0.0
  tr_pose_z: float = 0.0
  tr_pose_hx: float = 0.0
  tr_pose_hz: float = 1.0
  tr_pose_speed: float = 0.0
  tr_pose_stop: int = -1
  tr_pose_next: int = -1
  # the clock
  tr_clock: int = 0
  tr_clock_frac: float = 0.0
  tr_scan_t: float = 0.0
  # riders: runs with riders (open addressing on route and origin), a block of loads per run
  tr_ld_route: []int = new []int
  tr_ld_origin: []int = new []int
  tr_ld_block: []int = new []int
  tr_ld_count: int = 0
  tr_ld_pool: []int = new []int
  tr_ld_free: []int = new []int
  tr_tk_rider: []int = new []int
  tr_tk_route: []int = new []int
  tr_tk_run: []int = new []int
  tr_tk_k0: []int = new []int
  tr_tk_k1: []int = new []int
  tr_tk_live: []int = new []int
  tr_tk_free: []int = new []int
  tr_tk_count: int = 0
  # vehicles handed to the game
  tr_eb_route: []int = new []int
  tr_eb_run: []int = new []int
  tr_eb_live: []int = new []int
  tr_eb_max: int = 64
  tr_out_a: []int = new []int
  tr_out_b: []int = new []int
  tr_facts: Queue<TransitFact> = tr_facts__new()
}
function tr_facts__new() -> Queue<TransitFact> { return queue_new("transit.facts") }

export function transit_facts(tr: TransitState) -> Queue<TransitFact> { return tr.tr_facts }
export function transit_error(tr: TransitState) -> string { return tr.tr_err }

function tr_say(tr: mut TransitState, what: int, rider: int, line: int, stop: int, run: int, slot: int, fare: int) -> void {
  var f = q_rec(tr.tr_facts)
  if f == null {
    @alloc_ok("past the ring: more of these in a frame than its records, then kept in it")
    f = new TransitFact
    q_ring_add(tr.tr_facts, f)
  }
  f.what = what
  f.rider = rider
  f.line = line
  f.stop = stop
  f.run = run
  f.slot = slot
  f.fare = fare
  q_push(tr.tr_facts, f)
}
