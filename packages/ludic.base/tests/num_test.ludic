# num_test.ludic - is_finite: real numbers pass, NaN and the infinities do not
import "ludic.base"
program NumTest {
  numbers float
  test "is_finite tells a number from NaN and an infinity" {
    let zero = 0.0
    expect(is_finite(0.0))
    expect(is_finite(-123456.75))
    expect(is_finite(1000000.0 * 1000000.0 * 1000000.0))
    expect(not is_finite(zero / zero))
    expect(not is_finite(1.0 / zero))
    expect(not is_finite(-1.0 / zero))
  }
}
