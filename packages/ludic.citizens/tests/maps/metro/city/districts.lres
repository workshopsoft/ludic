  crowd: 100
  traffic: -1
  pts: [{ x: -256.0, z: 0.0 }, { x: 0.0, z: 0.0 }, { x: 0.0, z: 256.0 }, { x: -256.0, z: 256.0 }]
}
south {
  zoning: ZR_RESIDENTIAL_HIGH
  density: 700
