  crowd: -1
  traffic: 250
  pts: [{ x: 0.0, z: 256.0 }, { x: 512.0, z: 256.0 }, { x: 512.0, z: 512.0 }, { x: 0.0, z: 512.0 }]
}
green {
  zoning: ZR_PARK
  density: 0
  tags: []
  generator: ""
  crowd: -1
  traffic: -1
  pts: [{ x: -256.0, z: 256.0 }, { x: 0.0, z: 256.0 }, { x: 0.0, z: 512.0 }, { x: -128.0, z: 512.0 }, { x: -256.0, z: 384.0 }]
