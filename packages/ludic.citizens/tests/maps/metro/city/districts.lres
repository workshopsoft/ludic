# districts.lres - polygons of land with a zoning each; where two overlap the first row wins
core {
  zoning: ZR_DOWNTOWN
  density: 900
  tags: ["urban", "brick"]
  generator: "midrise_block"
  crowd: -1
  traffic: -1
  pts: [{ x: 0.0, z: 0.0 }, { x: 512.0, z: 0.0 }, { x: 512.0, z: 256.0 }, { x: 0.0, z: 256.0 }]
}
mall {
  zoning: ZR_DOWNTOWN
  density: 600
  tags: ["urban"]
  generator: "midrise_block"
  crowd: -1
  traffic: -1
  pts: [{ x: 256.0, z: 0.0 }, { x: 768.0, z: 0.0 }, { x: 768.0, z: 256.0 }, { x: 256.0, z: 256.0 }]
}
west {
  zoning: ZR_RESIDENTIAL_LOW
  density: 300
  tags: ["suburb"]
