  cz_bsum: []int = new []int                 # what they were when the population was made: a save keeps only those that differ
  # the wheel and the lists
  wh_head: []int = new []int
  wh_next: []int = new []int
  wh_prev: []int = new []int
  wh_in: []int = new []int
  cz_onext: []int = new []int
  cz_oprev: []int = new []int
  cz_inocc: []int = new []int
  tr_head: int = -1                          # the citizens travelling
  tr_next: []int = new []int
  tr_prev: []int = new []int
  tr_in: []int = new []int
  # citizens simulated closely
  md_n: int = 0
  md_id: []int = new []int
  md_ep: []int = new []int                   # the episode the legs belong to
  md_miss: []int = new []int                 # scans since they were last near a player
  md_lod: []int = new []int
  md_nleg: []int = new []int
  md_body: []int = new []int                 # the body kind last asked for, -1 none
  md_bep: []int = new []int
  ml_kind: []int = new []int
  ml_t0: []int = new []int
  ml_t1: []int = new []int
  ml_line: []int = new []int
  ml_run: []int = new []int
  ml_x0: []float = new []float
  ml_z0: []float = new []float
  ml_x1: []float = new []float
  ml_z1: []float = new []float
  cz_px: []float = new []float               # where a closely simulated citizen is, as of the last tick
  cz_pz: []float = new []float
  pose_x: float = 0.0
  pose_z: float = 0.0
  pose_gx: float = 0.0
  pose_gz: float = 0.0
  pose_leg: int = -1
  pose_t_end: int = 0
  # the trip cache
  tc_a: []int = new []int
  tc_b: []int = new []int
  tc_c: []int = new []int
  tc_secs: []int = new []int
  tc_cost: []int = new []int
  # the shift asked about
  sw0: int = 0
  sw1: int = 0
  # the last activity weighed
  ev_place: int = -1
  ev_dur: int = 0
  ev_ts: int = 0
  ev_cost: int = 0
  # the last trip weighed
  trip_secs: int = 0
  trip_cost: int = 0
  trip_mode: int = 0
  trip_wait: int = 0
  # what happened, counted
  st_act: []int = new []int                  # per activity: begun
  st_mode: []int = new []int                 # per mode: trips begun
  st_wages: int = 0
  st_spent: int = 0
  st_upkeep: int = 0
  st_steps: int = 0                          # episodes ended
  st_plans: int = 0                          # transit plans asked for (cache misses)
  st_hired: int = 0
  st_fired: int = 0
  st_moved: int = 0
  st_leak: int = 0                           # what left the workplaces' tills as owners' profit
  # corrections a host sends
  lg_seq: int = 0
  lg_buf: []int = new []int                  # a ring of CZ_LOG_INTS ints an entry
  lg_cap: int = 4096
  lg_n: int = 0
  lg_late: int = 0
  lg_applying: bool = false
  lg_pending: []int = new []int              # a client's corrections not yet due
  cz_warmup: int = 14400                     # seconds simulated from the made population before a loaded save's moment
  cz_save_money: bool = true
  # the last save's verdict
  sv_status: int = 0
  cz_facts: Queue<CitizenFact> = cz_facts__new()
  scratch: []int = new []int
  scratch2: []int = new []int
}
function cz_facts__new() -> Queue<CitizenFact> { return queue_new("citizens.facts") }

export const CZ_MAXFRIENDS: int = 4

export function citizens_facts(cz: CitizensState) -> Queue<CitizenFact> { return cz.cz_facts }

function cz_say(cz: mut CitizensState, what: int, id: int, a: int, b: int, c: int, t: int) -> void {
  var f = q_rec(cz.cz_facts)
  if f == null {
    @alloc_ok("past the ring: more of these in a frame than its records, then kept in it")
    f = new CitizenFact
    q_ring_add(cz.cz_facts, f)
  }
  f.what = what
  f.id = id
  f.a = a
  f.b = b
  f.c = c
  f.t = t
  q_push(cz.cz_facts, f)
}

function cz_ints(n: int, v: int) -> []int {
  let out = new []int
  for i in 0 .. n { push(out, v) }
  return out
}
