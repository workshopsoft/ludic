# travel.ludic - how a citizen gets from a place to another: walk, public transport, their own car, a taxi,
# or a mix (a transit trip is walk, ride, walk: the planner's legs). Each mode has a time and a cost; the
# choice is the cheapest in money and in the citizen's own value of time, divided by how much they like the
# mode, worse for walking and waiting in bad weather, with the same small nature-shaped variation every day
# for a commute (a person of routine takes the same way) and more for someone spontaneous. A transit trip
# leaves on the next multiple of the bucket, so the planner's answer is shared between everyone who asks the
# same thing, in a cache that is only a cache: the answer is a pure function and is recomputed if lost.

function cz_cache_init(cz: mut CitizensState) -> void {
  if len(cz.tc_a) == CZ_CACHE { return }
  List.clear(cz.tc_a)
  List.clear(cz.tc_b)
  List.clear(cz.tc_c)
  List.clear(cz.tc_secs)
  List.clear(cz.tc_cost)
  for s in 0 .. CZ_CACHE {
    push(cz.tc_a, -1)
    push(cz.tc_b, -1)
    push(cz.tc_c, -1)
    push(cz.tc_secs, 0)
    push(cz.tc_cost, 0)
  }
}

# the planner's seconds (-1 none) and fare for a trip leaving at `depart` (a multiple of the bucket when the bucket is set)
function cz_transit_eta(cz: mut CitizensState, from: int, to: int, depart: int) -> int {
  cz.st_asks += 1
  let key = cz_fdiv(depart, Math.max(cz.cz_bucket, 1))
  let slot = cz_mix3(from, to, key) & (CZ_CACHE - 1)
  if cz.cz_bucket > 0 and cz.tc_a[slot] == from and cz.tc_b[slot] == to and cz.tc_c[slot] == key {
    cz.trip_cost = cz.tc_cost[slot]
    return cz.tc_secs[slot]
  }
  cz.st_plans += 1
  let s = CitizensTransit.eta(cz.pl_x[from], cz.pl_z[from], cz.pl_x[to], cz.pl_z[to], depart)
  var cost = 0
  if s >= 0 { cost = CitizensTransit.fare() }
  cz.trip_cost = cost
  if cz.cz_bucket > 0 {
    cz.tc_a[slot] = from
    cz.tc_b[slot] = to
    cz.tc_c[slot] = key
    cz.tc_secs[slot] = s
    cz.tc_cost[slot] = cost
  }
  return s
}

# the next multiple of the bucket at or after T (T itself with no bucket)
function cz_depart_at(cz: CitizensState, T: int) -> int {
  if cz.cz_bucket <= 0 { return T }
  let r = T % cz.cz_bucket
  if r == 0 { return T }
  return T + cz.cz_bucket - r
}

function cz_noise(cz: CitizensState, i: int, from: int, to: int, mode: int) -> float {
  let ro = float(cz_trait_of(cz, i, 0)) / 100.0
  let route = cz_unit(cz_mix3(cz.cz_seed[i], from * 4099 + to, mode))
  let day = cz_unit(cz_mix3(cz.cz_seed[i], cz.cz_ep[i], 500 + mode))
  return 0.94 + 0.12 * (ro * route + (1.0 - ro) * day)
}

# weigh every way citizen i could go from place `from` to place `to` leaving at T; the best one is left in
# trip_mode / trip_secs / trip_cost / trip_wait
function cz_plan_trip(cz: mut CitizensState, i: int, from: int, to: int, T: int) -> void {
  let r = CitizenArchetypes[cz.cz_arch[i]]
  let x0 = cz.pl_x[from]
  let z0 = cz.pl_z[from]
  let x1 = cz.pl_x[to]
  let z1 = cz.pl_z[to]
  let d = cz_dist(x0, z0, x1, z1)
  let weather = float(CitizensWeather.bad()) / 100.0
  var best = 1000000000.0
  var best_mode = CZ_MODE_WALK
  var best_secs = 0
  var best_cost = 0
  var best_wait = 0
  let money = cz.cz_money[i]
  # walking is always possible
  let wd = d * cz.cz_walk_detour
  let ws = Math.max(int(wd / cz.cz_walk_speed + 0.5), 30)
  if r.pref_walk > 0.0 {
    var gc = float(ws) / 3600.0 * r.value_of_time * (1.0 + 1.5 * weather) / r.pref_walk
    if wd > r.walk_max { gc += (wd - r.walk_max) / 1000.0 * r.value_of_time * 2.0 }
    gc = gc * cz_noise(cz, i, from, to, CZ_MODE_WALK)
    best = gc
    best_secs = ws
  }
  # public transport: leaves on the bucket; the wait for it is part of the trip
  if r.pref_transit > 0.0 and d > 250.0 {
    let dep = cz_depart_at(cz, T)
    let ts = cz_transit_eta(cz, from, to, dep)
    let cost = cz.trip_cost
    if ts >= 0 and (cost <= money or cost == 0) {
      let secs = ts + (dep - T)
      let gc = (float(cost) + float(secs) / 3600.0 * r.value_of_time * (1.0 + 0.6 * weather)) / r.pref_transit * cz_noise(cz, i, from, to, CZ_MODE_TRANSIT)
      if gc < best or best_mode == -1 {
        best = gc
        best_mode = CZ_MODE_TRANSIT
        best_secs = secs
        best_cost = cost
        best_wait = dep - T
      }
    }
  }
  # their own car, if it is here
  if (cz.cz_flags[i] & CZ_FL_CAR) != 0 and cz.cz_car_at[i] == from and r.pref_car > 0.0 {
    var cs = CitizensCars.eta(x0, z0, x1, z1, T)
    if cs < 0 { cs = int(d * 1.3 / (cz.cz_est_speed * 1.8)) + 30 }
    let secs = cs + CitizensCars.park_secs()
    let cost = cz.cz_car_km * (int(d / 1000.0) + 1)
    if cost <= money {
      let gc = (float(cost) + float(secs) / 3600.0 * r.value_of_time) / r.pref_car * cz_noise(cz, i, from, to, CZ_MODE_CAR)
      if gc < best {
        best = gc
        best_mode = CZ_MODE_CAR
        best_secs = secs
        best_cost = cost
        best_wait = 0
      }
    }
  }
  # a taxi
  if r.pref_taxi > 0.0 {
    let ts = CitizensTransit.taxi_eta(x0, z0, x1, z1, T)
    if ts >= 0 {
      let cost = CitizensTransit.taxi_fare(x0, z0, x1, z1)
      if cost <= money {
        let gc = (float(cost) + float(ts) / 3600.0 * r.value_of_time * (1.0 + 0.2 * weather)) / r.pref_taxi * cz_noise(cz, i, from, to, CZ_MODE_TAXI)
        if gc < best {
          best = gc
          best_mode = CZ_MODE_TAXI
          best_secs = ts
          best_cost = cost
          best_wait = 0
        }
      }
    }
  }
  cz.trip_mode = best_mode
  cz.trip_secs = Math.max(best_secs, 30)
  cz.trip_cost = best_cost
  cz.trip_wait = best_wait
}

# a rough trip time between two places, to weigh an activity before any trip is planned: on foot up to a short
# distance, else at the estimate's speed with a wait at each end
function cz_est_secs(cz: CitizensState, p: int, q: int) -> int {
  if p == q { return 0 }
  let d = cz_dist(cz.pl_x[p], cz.pl_z[p], cz.pl_x[q], cz.pl_z[q])
  if d < 600.0 { return int(d * cz.cz_walk_detour / cz.cz_walk_speed) + 20 }
  return int(d * 1.3 / cz.cz_est_speed) + 300
}
