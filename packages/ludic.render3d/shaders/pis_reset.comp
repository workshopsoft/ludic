// pis_reset.comp - a persistent instance set's per-model counters to zero, before each frame's count pass (pis.ludic).
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform Params {
  uvec4 n;              // x models
} pr;
layout(set = 0, binding = 1) buffer Counts { uint counts[]; };
layout(set = 0, binding = 2) buffer Cursors { uint cursors[]; };
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pr.n.x) { return; }
  counts[i] = 0u;
  cursors[i] = 0u;
}
