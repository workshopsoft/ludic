# variants.list - every program render3d builds: vertex|fragment|defines (one line; newlines
# in the defines are written as ";"). A backend that cannot compile shaders at run time
# (Vulkan: SPIR-V is built ahead) must cover all of them. Regenerate by running the game and
# its self-tests with R3D_PROGRAMS_LOG=<file> and sorting the result.
fullscreen.vert|adapt.frag|
fullscreen.vert|bloom_down.frag|
fullscreen.vert|bloom_up.frag|
fullscreen.vert|heightgen.frag|#define DEM;
fullscreen.vert|ibl_brdf.frag|
fullscreen.vert|ibl_irradiance.frag|
fullscreen.vert|ibl_prefilter.frag|
fullscreen.vert|sharpen.frag|
fullscreen.vert|sky.frag|
fullscreen.vert|ssao_blur.frag|
fullscreen.vert|ssgi.frag|
fullscreen.vert|ternormal.frag|
fullscreen.vert|tershadow.frag|#define NOISE_ONLY;
fullscreen.vert|tonemap.frag|
fullscreen.vert|tonemap.frag|#define HDR10;
grass.mesh|model.frag|#define FOLIAGE;#define BLADE;#define MESH;
grass.vert|model.frag|#define FOLIAGE;#define BLADE;
grass.vert|model.frag|#define FOLIAGE;#define BLADE;#define TILES;
