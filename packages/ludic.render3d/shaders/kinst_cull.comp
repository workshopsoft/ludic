// kinst_cull.comp - frustum and distance culling of every instance of the resident cells, and LOD binning, in
// parallel: one invocation an instance (kinst.ludic is the CPU reference, test for test). Two passes over the same
// list, told apart by pr.info.z:
//   pass 0 (count)   each survivor adds one to its bin's counter;
//   pass 1 (scatter) after kinst_args.comp turned the counts into offsets, each survivor takes the next place in its
//                    bin (an atomic cursor) and is written there in render space.
// Bins are kit * 2 + level: level 0 the full mesh inside the kit's near distance, level 1 the impostor card out to
// its far distance. The order within a bin is not fixed from frame to frame (atomics), which opaque instances do not show.
//
// The main view's occlusion (pr.hview.w = 1, occlusion.ludic occ_inst_*): Unreal 5.8's r.InstanceCulling.OcclusionCull, the
// HZB test of BuildInstanceDrawCommands.usf (OCCLUSION_CULL_INSTANCES) against the previous frame's furthest HZB. Every survivor
// of the frustum still lands in its bin (the sun's live cascade and the local lights draw this list too, and Unreal never culls a
// shadow view by the camera's HZB), but the ones the HZB shows visible come first: counts[bins + bin] counts them, they take places
// from the bin's start, the occluded ones after them, and kinst_args.comp gives the main view's draw records the visible part only.
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform Params {
  vec4 planes[6];       // left right bottom top near far: inside when dot(xyz, p) + w >= 0
  vec4 cam;             // xyz the camera (render space), w the distance scale
  uvec4 info;           // x instances, y bins, z pass, w output capacity (instances)
  // the previous frame's HZB (occlusion.ludic occ_inst_params): the view-projection it was built under; its frame's width, height,
  // its mips and whether to test at all (w); each mip's width, height and first float in Hzb
  mat4 hvp;
  ivec4 hview;
  ivec4 hlv[16];
} pr;

layout(set = 0, binding = 1) readonly buffer Src { vec4 src[]; };         // 5 vec4 an instance: pos+scale, sin cos seed flags, tint+variation, (kit, cell), box (w d h radius)
layout(set = 0, binding = 2) readonly buffer Kits { vec4 kits[]; };       // 2 vec4 a kit: (near, far, radius, has card), (prims, 0, 0, 0)
layout(set = 0, binding = 3) readonly buffer Cells { vec4 cells[]; };     // a vec4 a cell slot: render-space offset xyz, hidden (w > 0.5)
layout(set = 0, binding = 4) buffer Counts { uint counts[]; };            // a bin's survivors (clamped to what fits by kinst_args.comp); with the test, then each bin's visible ones
layout(set = 0, binding = 5) readonly buffer Offsets { uint offs[]; };    // a bin's first place in Dst
layout(set = 0, binding = 6) buffer Cursors { uint cursors[]; };          // with the test, the visible ones' cursors then the occluded ones'
layout(set = 0, binding = 7) buffer Dst { vec4 dst[]; };                  // 4 vec4 an instance: pos+scale, sin cos seed flags, tint+variation, box
layout(set = 0, binding = 8) readonly buffer Hzb { float hzb[]; };        // the previous frame's furthest HZB, mip after mip (hzb_build.comp)
// a box kit's drawn bounds per unit of its instance's w, d, h (kitbox.ludic's envelope, kgpu_upload_tables), 3 vec4 a kit:
// (max |sx|, max |ox|, max |sz|, max |oz|), (min sh, min sd, min oy, 1 when known), (max sh, max sd, max oy, 0)
layout(set = 0, binding = 9) readonly buffer KBox { vec4 kbox[]; };

// ---- the previous frame's HZB test; kept in step with scatter_occl.comp and grass_cull.comp (hzb_test.comp is the actors') ----
// BuildInstanceDrawCommands.usf: PrevCull = BoxCullFrustum(bounds, PrevLocalToTranslatedWorld, PrevTranslatedWorldToClip, ...); a box
// that crosses the near plane is visible; PrevRect = GetScreenRect(HZBTestViewRect, PrevCull, 4); bIsVisible = IsVisibleHZB(PrevRect, true)
// (Nanite/NaniteHZBCull.ush: MipLevelForRect, GetMinDepthFromHZB 4 x 4, visible when Rect.Depth >= MinDepth with reversed depth).
// Unreal rounds PrevRect.Depth up to a half (RoundUpF16) for its 16-bit HZB; this HZB keeps the depth's 32-bit floats, so none is needed.
// One rule more conservative than Unreal's: a box that reaches past the previous frame's view is visible (Unreal clamps its rect to
// the view and tests only what was on screen), so turning never hides what the last frame could not see.
float hzbAt(int lvl, int x, int y) {
  ivec4 l = pr.hlv[lvl];
  return hzb[l.z + min(y, l.y - 1) * l.x + min(x, l.x - 1)];
}
int hzbMip(ivec4 r) {                   // MipLevelForRect, DesiredFootprintPixels = 4 (MaxPixelOffset 3, MipOffset 1)
  ivec2 mxy = findMSB(r.zw - r.xy);
  int lvl = max(max(mxy.x, mxy.y) - 1, 0);
  ivec2 span = (r.zw >> lvl) - (r.xy >> lvl);
  if (span.x > 3 || span.y > 3) lvl += 1;
  return lvl;
}
bool hzbVisible(vec3 c, vec3 e) {
  if (pr.hview.w == 0) return true;
  vec4 dx = (2.0 * e.x) * pr.hvp[0];
  vec4 dy = (2.0 * e.y) * pr.hvp[1];
  vec4 dz = (2.0 * e.z) * pr.hvp[2];
  vec4 p0 = pr.hvp * vec4(c - e, 1.0);
  vec2 rmin = vec2(1e30);
  vec2 rmax = vec2(-1e30);
  float maxZ = -1e30;
  for (int k = 0; k < 8; k++) {
    vec4 p = p0;
    if ((k & 1) != 0) p += dx;
    if ((k & 2) != 0) p += dy;
    if ((k & 4) != 0) p += dz;
    if (p.w <= 0.0 || p.z >= p.w) return true;        // bCrossesNearPlane (reversed depth: the near plane is z = w)
    vec2 s = p.xy / p.w;
    rmin = min(rmin, s);
    rmax = max(rmax, s);
    maxZ = max(maxZ, p.z / p.w);                      // the nearest corner's depth (Unreal's RectMax.z)
  }
  if (any(lessThan(rmin, vec2(-1.0))) || any(greaterThan(rmax, vec2(1.0)))) return true;
  // GetScreenRect: the pixels whose centres the rect covers (rows as the depth's: no flip, as hzb_test.comp)
  ivec2 vs = pr.hview.xy;
  vec4 uv = clamp(vec4(rmin, rmax) * 0.5 + 0.5, 0.0, 1.0);
  ivec4 px = ivec4(uv * vec4(vs, vs) + vec4(0.5, 0.5, -0.5, -0.5));
  px.xy = max(px.xy, ivec2(0));
  px.zw = min(px.zw, vs - 1);
  ivec4 t = ivec4(px.xy, max(px.xy, px.zw)) >> 1;    // HZB mip 0 is half resolution
  int lvl = min(hzbMip(t), pr.hview.z - 1);
  t >>= lvl;
  float d = 1.0;                                      // GetMinDepthFromHZB, 4 x 4
  for (int y = 0; y < 4; y++) {
    int yy = min(t.y + y, t.w);
    for (int x = 0; x < 4; x++) d = min(d, hzbAt(lvl, min(t.x + x, t.z), yy));
  }
  return maxZ >= d;
}

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pr.info.x) { return; }
  vec4 a = src[i * 5u];
  vec4 meta = src[i * 5u + 3u];
  vec4 box = src[i * 5u + 4u];
  if (meta.x < 0.0) { return; }                 // a record of a cell that has gone (kgpu_remove_cell marks them)
  uint kit = uint(meta.x + 0.5);
  vec4 cell = cells[uint(meta.y + 0.5)];
  if (cell.w > 0.5) { return; }
  vec4 kn = kits[kit * 2u];
  float sc = pr.cam.w;
  vec3 p = a.xyz + cell.xyz;
  vec3 d = p - pr.cam.xyz;
  float far = kn.y * sc;
  float d2 = dot(d, d);
  if (d2 > far * far) { return; }
  float r = (box.w > 0.0) ? box.w : kn.z * a.w;      // a box kit's instance: the sphere that holds its own drawn bounds
  for (int k = 0; k < 6; k++) {
    if (dot(pr.planes[k].xyz, p) + pr.planes[k].w < -r) { return; }
  }
  uint level = 0u;
  float near = kn.x * sc;
  if (d2 > near * near) {
    if (kn.w < 0.5) { return; }
    level = 1u;
  }
  uint bin = kit * 2u + level;
  uint nb = pr.info.y;
  bool occ = pr.hview.w != 0;
  bool vis = true;
  if (occ) {
    // the instance's bounds as a world box (Unreal's LocalBoundsCenter / Extent through its LocalToWorld): a box kit's from the kit's
    // envelope at this instance's w, d, h, turned by its yaw (kit.vert: x' = c x + s z, z' = -s x + c z); any other the sphere's cube
    vec3 bc = p;
    vec3 be = vec3(r);
    vec4 k1 = kbox[kit * 3u + 1u];
    if (box.w > 0.0 && k1.w > 0.5) {
      vec4 k0 = kbox[kit * 3u];
      vec4 k2 = kbox[kit * 3u + 2u];
      float hx = k0.x * box.x + k0.y;                 // |x| <= S w + O (kitbox.ludic kb_add2's envelope)
      float hz = k0.z * box.y + k0.w;
      float y0 = k1.x * box.z + k1.y * box.y + k1.z;  // sh h + sd d + oy, h and d >= 0
      float y1 = k2.x * box.z + k2.y * box.y + k2.z;
      vec2 sc2 = abs(src[i * 5u + 1u].xy);            // |sin|, |cos| of the yaw
      bc = p + vec3(0.0, 0.5 * (y0 + y1), 0.0);
      be = vec3(sc2.y * hx + sc2.x * hz, 0.5 * (y1 - y0), sc2.x * hx + sc2.y * hz);
    }
    vis = hzbVisible(bc, be);
  }
  if (pr.info.z == 0u) {
    atomicAdd(counts[bin], 1u);
    if (occ && vis) atomicAdd(counts[nb + bin], 1u);
    return;
  }
  uint at;
  if (!occ) {
    at = atomicAdd(cursors[bin], 1u);
    if (at >= counts[bin]) { return; }          // the bin was clamped to what fits
  } else if (vis) {
    at = atomicAdd(cursors[bin], 1u);
    if (at >= counts[nb + bin]) { return; }     // (kinst_args.comp clamped the visible ones to the bin)
  } else {
    at = counts[nb + bin] + atomicAdd(cursors[nb + bin], 1u);
    if (at >= counts[bin]) { return; }
  }
  uint o = (offs[bin] + at) * 4u;
  dst[o] = vec4(p, a.w);
  dst[o + 1u] = src[i * 5u + 1u];
  dst[o + 2u] = src[i * 5u + 2u];
  dst[o + 3u] = box;
}
