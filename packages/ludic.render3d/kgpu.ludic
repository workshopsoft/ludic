# ============================================================================
# kgpu.ludic - instancing at scale on the GPU: every resident cell's instances in one buffer, culled and binned in
# parallel by compute, drawn by indirect calls. No CPU work is proportional to the number of instances.
#
#   cells load   kgpu_add_cell writes the cell's 20-float records into a range of the SRC arena (karena.ludic)
#   each frame   kgpu_frame:  reset counters -> kinst_cull.comp (count) -> kinst_args.comp (scan, draw records) -> kinst_cull.comp (scatter)
#                  a thread an instance: frustum + distance test against the cell's render-space offset, LOD level by
#                  distance, survivors packed per (kit, level) in render space into DST
#   draws        kgpu_draw: per kit, one indirect draw a material of its mesh (lit pass, INTERIOR_MAP if the kit has
#                  windows) and one for its impostor card; kgpu_draw_casters into a shadow cascade
#
# `kgpu_frame` dispatches compute and so must run before the frame's first pass: register it with r3d_on_prepare.
# Drawing goes in the game's r3d_on_draw (and r3d_on_casters). The floating origin (forg.ludic) enters only through the cell
# table: a rebase changes `origin.serial`, kgpu_frame rewrites the table's offsets (a few kilobytes), and no instance
# is touched.
#
# A kit's Model is its own: it is given instance attributes of this file's layout (four vec4s), so it must not also be
# a scatter Layer's model. Load it again for that. A BOX kit (kitbox.ludic: anchors on its vertices) is declared with
# kgpu_kit_box; its instances carry their own w, d, h (the fourth vec4) and its card is sized from them.
#
# Compile-checked here; the culling it does is tested on the CPU twin (kinst_test.ludic), record for record.
# ============================================================================

export const KG_SRC_FLOATS: int = 20       # a source record: 5 vec4s (the instance's 4 and its kit and cell)
export const KG_DST_FLOATS: int = 16       # an output record: 4 vec4s (kinst.ludic's KI_FLOATS)
const KG_PRIMS: int = 8                    # material primitives a kit's mesh may have
const KG_REC: int = 9                      # indirect records a kit: 8 prims + its card
const KG_PRM: int = 116                    # kinst_cull.comp's Params in words: 32 of its own, 84 of the previous frame's HZB (occ_inst_params)

property KGpuKit {
  model: Model,
  prims: int = 0,
  near: float = 300.0,
  far: float = 2000.0,
  radius: float = 10.0,
  card: bool = false,
  atlas: OImp,              # its impostor frames, when it has a card
  rooms: int = 0,           # the texture of its interior atlas, 0 for plain glass
  ia: InteriorAtlas,        # the atlas row
  win_w: float = 3.0,
  win_h: float = 3.2,
  storey_h: float = 0.0,     # a line across the walls every storey_h metres, from a box instance's top (its eave) down and from another's base up, 0 for none (kit.frag's u_storey)
  storey_line: float = 0.12,
  casts: bool = true,
  fac: floats,              # a box kit's FACADE uniforms (kgpu_kit_facade: 20 floats, kit.frag's u_fac_a .. u_fac_e), null for none
  box: KitBox,              # a box kit's anchor tuples (kitbox.ludic), null for an ordinary kit
  box_ref: floats,          # the instance its card was baked at: drawn width, depth, top (oimp_bake's w, d, h)
  alt: floats               # its card's alternative (oimp.frag u_imp_alt): the colour a share of the instances wear (brick for render), r g b share
}

export property KGpu {
  kits: []KGpuKit,
  n_kits: int = 0,
  src_cap: int = 0,         # instances the arena holds
  dst_cap: int = 0,         # instances a frame may show
  max_cells: int = 0,
  arena: KArena,
  c_reset: int = 0,
  c_cull: int = 0,
  c_args: int = 0,
  c_cull_l: int = 0,        # kinst_cull_lights.comp: the shadowed local lights' casters (ue_lightshadows.ludic)
  p_mesh: int = 0,
  p_int: int = 0,
  p_fac: int = 0,           # kit.frag FACADE (and INTERIOR_MAP): a box kit's fitted window grid
  p_shadow: int = 0,
  p_card: int = 0,
  p_bake: int = 0,
  p_bake_fac: int = 0,      # kit.frag FACADE BAKE: a box kit's card baked with its window grid
  p_depth: int = 0,         # kit.frag DEPTH_ONLY: the kits' depth prepass (R3D_KIT_PREPASS, kgpu_draw_depth)
  p_depth_fac: int = 0,     # kit.frag FACADE DEPTH_ONLY: a box kit's, with its party walls' discard
  pre_on: bool = true,      # R3D_KIT_PREPASS (on unless 0)
  opt_mesh: float = 1.0,    # kit.frag u_kit_opt (kgpu_bind_opt): R3D_KIT_SKIP_MESHMAPS, R3D_KIT_GLASS_SKIP, R3D_KIT_FAR_SIMPLE (1 on unless 0)
  opt_glass: float = 1.0,
  opt_far: float = 1.0,
  b_src: int = 0,
  b_kits: int = 0,
  b_cells: int = 0,
  b_counts: int = 0,        # 2 a bin: the survivors, then the ones the main view's occlusion shows visible (kinst_cull.comp)
  b_offs: int = 0,
  b_cursors: int = 0,       # 2 a bin, as b_counts
  b_dst: int = 0,
  b_cmds: int = 0,          # the camera's list whole: the sun's live cascade and a local light without its own list draw it
  b_vcmds: int = 0,         # the same records for the main view with the occluded instances left out (R3D_KINST_OCCLUSION)
  b_kbox: int = 0,          # a box kit's drawn bounds envelope, 3 vec4 a kit (kinst_cull.comp's KBox)
  occ: bool = false,        # this frame's main view draws b_vcmds (occlusion.ludic occ_inst_live)
  b_l_counts: int = 0,     # the local lights' casters: their own counters and draw records, their instances after the main
  b_l_offs: int = 0,        # list in b_dst (from dst_cap - l_cap)
  b_l_cursors: int = 0,
  b_l_cmds: int = 0,
  b_lights: int = 0,        # the shadow-casting lights' spheres
  l_cap: int = 0,
  l_ready: bool = false,    # this frame's local light casters are in b_l_cmds
  prm_l: words,
  dbg_n: int = 0,
  b_s_counts: int = 0,      # the sun's cached cascades' casters (shadow_cache.ludic): culled to the window being drawn, not the view,
  b_s_offs: int = 0,        # their instances after everything else in b_dst (from dst_cap, s_cap of them)
  b_s_cursors: int = 0,
  b_s_cmds: int = 0,
  s_cap: int = 0,
  s_ready: bool = false,    # this frame's cached cascades' casters are in b_s_cmds
  s_planes: floats,
  b_ident: int = 0,
  b_ident_box: int = 0,     # an identity instance with a box kit's reference w, d, h, for its impostor bake
  kt_u: floats,             # a box kit's tuples as the card shader takes them (kitbox_uniforms)
  kt_n: words,
  card_mesh: Mesh,
  cell_tab: floats,         # a vec4 a resident cell: render-space offset xyz, hidden
  cell_cx: words,
  cell_cz: words,
  cell_size: floats,
  cell_first: words,        # the cell's range in the arena
  cell_n: words,
  cell_used: words,
  cell_slot: words,         # the caller's slot for the cell
  free_cells: []int,
  n_cells: int = 0,
  serial: int = -1,
  tab_dirty: bool = true,
  scale: float = 1.0,       # the distance scale (kinst_adapt's, for the GPU path)
  prm: words,               # the cull's parameter block, reused
  pa: words,                # the scan's
  pr: words,                # the reset's
  bufs: words,              # the buffer handles of a dispatch, reused
  instances: int = 0,       # resident instances
  ready: bool = false,
  cpu_only: bool = false,    # the compute passes and their buffers are not made: lists from kinst.ludic are drawn (kgpu_draw_lists)
  list_bufs: words          # the CPU path's upload buffer for each (kit, level)
}

# ---- set-up ------------------------------------------------------------------------------------------

# The instancer for up to `n_kits` kits, `src_cap` resident instances, `dst_cap` visible ones a frame and `max_cells`
# resident cells. False (and an unusable result) when a program or buffer could not be made: the caller falls back to
# kinst.ludic's CPU path.
@alloc_ok("start-up: the instancer's programs, buffers and tables are made once")
export function kgpu_new(render3d_st: mut Render3dState, n_kits: int, src_cap: int, dst_cap: int, max_cells: int, cpu_only: bool) -> KGpu {
  let was = render3d_st.gvk_tag
  render3d_st.gvk_tag = VKM_SCATTER
  let g = kgpu_new__t(render3d_st, n_kits, src_cap, dst_cap, max_cells, cpu_only)
  render3d_st.gvk_tag = was
  return g
}

@alloc_ok("start-up: the instancer's programs, buffers and tables are made once")
function kgpu_new__t(render3d_st: mut Render3dState, n_kits: int, src_cap: int, dst_cap: int, max_cells: int, cpu_only: bool) -> KGpu {
  let g = new KGpu
  g.cpu_only = cpu_only
  g.list_bufs = words(n_kits * 2)
  g.n_kits = n_kits
  g.src_cap = src_cap
  g.dst_cap = dst_cap
  g.max_cells = max_cells
  g.kits = new []KGpuKit
  for i in 0 .. n_kits { push(g.kits, new KGpuKit) }
  g.arena = kar_new(src_cap, 3)
  kar_reserve(g.arena, max_cells)                    # one range a resident cell: the arena's lists never grow in play
  g.cell_tab = floats(max_cells * 4)
  g.cell_cx = words(max_cells)
  g.cell_cz = words(max_cells)
  g.cell_size = floats(max_cells)
  g.cell_first = words(max_cells)
  g.cell_n = words(max_cells)
  g.cell_used = words(max_cells)
  g.cell_slot = words(max_cells)
  g.free_cells = new []int
  for i in 0 .. max_cells {
    push(g.free_cells, max_cells - 1 - i)
    g.cell_tab[i * 4 + 3] = 1.0                 # hidden until a cell takes the place
  }
  g.prm = words(KG_PRM)
  g.kt_u = floats(KB_TUPLES * 12)
  g.kt_n = words(3)
  g.pa = words(8)
  g.pr = words(4)
  g.bufs = words(9)
  if not cpu_only {
    if not gpu_has_compute(render3d_st) { return g }
    g.c_reset = gpu_compute(render3d_st, "kinst_reset", 2)
    g.c_cull = gpu_compute(render3d_st, "kinst_cull", 9)
    g.c_args = gpu_compute(render3d_st, "kinst_args", 5)
    g.c_cull_l = gpu_compute(render3d_st, "kinst_cull_lights", 8)
  }
  g.p_mesh = r3d_program(render3d_st, "kit.vert", "kit.frag", "")
  g.p_int = r3d_program(render3d_st, "kit.vert", "kit.frag", "#define INTERIOR_MAP\n")
  g.p_fac = r3d_program(render3d_st, "kit.vert", "kit.frag", "#define INTERIOR_MAP\n#define FACADE\n")
  g.p_shadow = r3d_program(render3d_st, "kit.vert", "shadow.frag", "#define SHADOW_PASS\n")
  g.p_card = r3d_program(render3d_st, "oimp.vert", "oimp.frag", "")
  g.p_bake = r3d_program(render3d_st, "kit.vert", "bake.frag", "")
  g.p_bake_fac = r3d_program(render3d_st, "kit.vert", "kit.frag", "#define INTERIOR_MAP\n#define FACADE\n#define BAKE\n")
  kgpu_read_opts(render3d_st, g)
  if g.pre_on {
    # (the same kit.vert as the lit programs: the defines change no position arithmetic)
    g.p_depth = r3d_program(render3d_st, "kit.vert", "kit.frag", "#define DEPTH_ONLY\n")
    g.p_depth_fac = r3d_program(render3d_st, "kit.vert", "kit.frag", "#define INTERIOR_MAP\n#define FACADE\n#define DEPTH_ONLY\n")
    if g.p_depth == 0 or g.p_depth_fac == 0 { g.pre_on = false }
  }
  if (not cpu_only and (g.c_reset == 0 or g.c_cull == 0 or g.c_args == 0)) or g.p_mesh == 0 or g.p_int == 0 or g.p_fac == 0 or g.p_shadow == 0 or g.p_card == 0 or g.p_bake == 0 or g.p_bake_fac == 0 { return g }
  if cpu_only {
    g.b_ident = gpu_buffer_new(render3d_st)
    kgpu_ident(render3d_st, g)
    g.card_mesh = mesh_card(render3d_st)
    g.ready = true
    print("r3d: big world: instances are culled on the CPU")
    return g
  }
  # the buffers: the arena and the output are the big ones, and the compute passes own them
  g.b_src = gpu_buffer_new(render3d_st)
  gpu_buffer_upload(render3d_st, g.b_src, src_cap * KG_SRC_FLOATS * 4, null, GPU_DYNAMIC)
  gpu_buffer_gpu_owned(render3d_st, g.b_src)
  kgpu_fill_dead(render3d_st, g, 0, src_cap)
  # the shadow cache's casters (R3D_UE_SHADOW_CACHE) take a list of their own after the rest
  if shadow_cache_mode(render3d_st) == 1 { g.s_cap = max(dst_cap / 2, 1) }
  g.b_dst = gpu_buffer_new(render3d_st)
  gpu_buffer_upload(render3d_st, g.b_dst, (dst_cap + g.s_cap) * KG_DST_FLOATS * 4, null, GPU_DYNAMIC)
  gpu_buffer_gpu_owned(render3d_st, g.b_dst)
  g.b_kits = gpu_buffer_new(render3d_st)
  gpu_buffer_upload(render3d_st, g.b_kits, n_kits * 32, null, GPU_DYNAMIC)
  gpu_buffer_gpu_owned(render3d_st, g.b_kits)
  g.b_cells = gpu_buffer_new(render3d_st)
  gpu_buffer_upload(render3d_st, g.b_cells, max_cells * 16, null, GPU_DYNAMIC)
  gpu_buffer_gpu_owned(render3d_st, g.b_cells)
  # the main list's counters and cursors: 2 a bin, the second half for the main view's occlusion (kinst_cull.comp)
  g.b_counts = gpu_buffer_new(render3d_st)
  gpu_buffer_upload(render3d_st, g.b_counts, n_kits * 4 * 4, null, GPU_DYNAMIC)
  gpu_buffer_gpu_owned(render3d_st, g.b_counts)
  g.b_offs = gpu_buffer_new(render3d_st)
  gpu_buffer_upload(render3d_st, g.b_offs, n_kits * 2 * 4, null, GPU_DYNAMIC)
  gpu_buffer_gpu_owned(render3d_st, g.b_offs)
  g.b_cursors = gpu_buffer_new(render3d_st)
  gpu_buffer_upload(render3d_st, g.b_cursors, n_kits * 4 * 4, null, GPU_DYNAMIC)
  gpu_buffer_gpu_owned(render3d_st, g.b_cursors)
  g.b_kbox = gpu_buffer_new(render3d_st)
  gpu_buffer_upload(render3d_st, g.b_kbox, n_kits * 48, null, GPU_DYNAMIC)
  gpu_buffer_gpu_owned(render3d_st, g.b_kbox)
  # the indirect records: indexCount, instanceCount, firstIndex, vertexOffset, firstInstance - the compute passes write the
  # second and the last; kgpu_kit fills the rest
  let rec = words(n_kits * KG_REC * 5)
  for i in 0 .. n_kits * KG_REC * 5 { rec[i] = 0 }
  g.b_cmds = gpu_buffer_new(render3d_st)
  gpu_buffer_upload(render3d_st, g.b_cmds, n_kits * KG_REC * 20, data_of(rec), GPU_DYNAMIC)
  gpu_buffer_gpu_owned(render3d_st, g.b_cmds)
  g.b_vcmds = gpu_buffer_new(render3d_st)
  gpu_buffer_upload(render3d_st, g.b_vcmds, n_kits * KG_REC * 20, data_of(rec), GPU_DYNAMIC)
  gpu_buffer_gpu_owned(render3d_st, g.b_vcmds)
  # the local lights' casters: a quarter of the output, used only in a frame where a light casts
  g.l_cap = max(dst_cap / 4, 1)
  g.prm_l = words(36)
  g.b_l_counts = gpu_buffer_new(render3d_st)
  gpu_buffer_upload(render3d_st, g.b_l_counts, n_kits * 2 * 4, null, GPU_DYNAMIC)
  gpu_buffer_gpu_owned(render3d_st, g.b_l_counts)
  g.b_l_offs = gpu_buffer_new(render3d_st)
  gpu_buffer_upload(render3d_st, g.b_l_offs, n_kits * 2 * 4, null, GPU_DYNAMIC)
  gpu_buffer_gpu_owned(render3d_st, g.b_l_offs)
  g.b_l_cursors = gpu_buffer_new(render3d_st)
  gpu_buffer_upload(render3d_st, g.b_l_cursors, n_kits * 2 * 4, null, GPU_DYNAMIC)
  gpu_buffer_gpu_owned(render3d_st, g.b_l_cursors)
  g.b_l_cmds = gpu_buffer_new(render3d_st)
  gpu_buffer_upload(render3d_st, g.b_l_cmds, n_kits * KG_REC * 20, data_of(rec), GPU_DYNAMIC)
  gpu_buffer_gpu_owned(render3d_st, g.b_l_cmds)
  g.b_lights = gpu_buffer_new(render3d_st)
  if g.s_cap > 0 {
    g.s_planes = floats(24)
    g.b_s_counts = gpu_buffer_new(render3d_st)
    gpu_buffer_upload(render3d_st, g.b_s_counts, n_kits * 2 * 4, null, GPU_DYNAMIC)
    gpu_buffer_gpu_owned(render3d_st, g.b_s_counts)
    g.b_s_offs = gpu_buffer_new(render3d_st)
    gpu_buffer_upload(render3d_st, g.b_s_offs, n_kits * 2 * 4, null, GPU_DYNAMIC)
    gpu_buffer_gpu_owned(render3d_st, g.b_s_offs)
    g.b_s_cursors = gpu_buffer_new(render3d_st)
    gpu_buffer_upload(render3d_st, g.b_s_cursors, n_kits * 2 * 4, null, GPU_DYNAMIC)
    gpu_buffer_gpu_owned(render3d_st, g.b_s_cursors)
    g.b_s_cmds = gpu_buffer_new(render3d_st)
    gpu_buffer_upload(render3d_st, g.b_s_cmds, n_kits * KG_REC * 20, data_of(rec), GPU_DYNAMIC)
    gpu_buffer_gpu_owned(render3d_st, g.b_s_cmds)
  }
  g.b_ident = gpu_buffer_new(render3d_st)
  kgpu_ident(render3d_st, g)
  g.card_mesh = mesh_card(render3d_st)
  kgpu_attach(render3d_st, g.card_mesh, g.b_dst)
  g.ready = true
  print("r3d: big world: instances are culled and binned on the GPU")
  return g
}

# the kits' shading-cost switches, each on unless its variable is 0, read once (start-up)
function kgpu_read_opts(render3d_st: mut Render3dState, g: KGpu) -> void {
  g.pre_on = not kgpu_env_off(render3d_st, "R3D_KIT_PREPASS")
  g.opt_mesh = 1.0
  g.opt_glass = 1.0
  g.opt_far = 1.0
  if kgpu_env_off(render3d_st, "R3D_KIT_SKIP_MESHMAPS") { g.opt_mesh = 0.0 }
  if kgpu_env_off(render3d_st, "R3D_KIT_GLASS_SKIP") { g.opt_glass = 0.0 }
  if kgpu_env_off(render3d_st, "R3D_KIT_FAR_SIMPLE") { g.opt_far = 0.0 }
}
function kgpu_env_off(render3d_st: mut Render3dState, name: string) -> bool {
  return r3d_env_has(render3d_st, name) and r3d_env(render3d_st, name) == "0"
}

# kit.frag's u_kit_opt on a lit program: x R3D_KIT_SKIP_MESHMAPS (a surface's kit reads none of its mesh's own maps: they are replaced
# whole), y R3D_KIT_GLASS_SKIP (a FACADE's fully drawn glass reads nothing of the wall behind it), z R3D_KIT_FAR_SIMPLE (no normal map
# past 120 m, where the shader lays the geometric normal anyway; the streaks' sub-pixel noise at its mean there). The first two and the
# normal map's skip change no pixel; the noise's mean is the one documented far-distance change. The card bake never sets it (all off).
function kgpu_bind_opt(render3d_st: mut Render3dState, g: KGpu, p: int) -> void {
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_kit_opt"), g.opt_mesh, g.opt_glass, g.opt_far, 0.0)
}

# an identity instance for the impostor bake, in this file's layout
function kgpu_ident(render3d_st: mut Render3dState, g: KGpu) -> void {
  let one = floats(KG_DST_FLOATS)
  one[0] = 0.0;  one[1] = 0.0;  one[2] = 0.0;  one[3] = 1.0
  one[4] = 0.0;  one[5] = 1.0;  one[6] = 0.0;  one[7] = 0.0
  one[8] = 1.0;  one[9] = 1.0;  one[10] = 1.0;  one[11] = 0.0
  for i in 12 .. KG_DST_FLOATS { one[i] = 0.0 }
  gpu_buffer_upload(render3d_st, g.b_ident, KG_DST_FLOATS * 4, data_of(one), GPU_STATIC)
}

# every record in [first, first + n) marked dead (kit -1): the shader skips it
function kgpu_fill_dead(render3d_st: mut Render3dState, g: KGpu, first: int, n: int) -> void {
  let map = gpu_buffer_map(render3d_st, g.b_src)
  if map == null { return }
  let dead = floats(KG_SRC_FLOATS * 256)
  for i in 0 .. 256 * KG_SRC_FLOATS { dead[i] = 0.0 }
  for i in 0 .. 256 { dead[i * KG_SRC_FLOATS + 12] = -1.0 }
  var done = 0
  while done < n {
    let k = min(256, n - done)
    mem_copy(mem_off(map, (first + done) * KG_SRC_FLOATS * 4), data_of(dead), k * KG_SRC_FLOATS * 4)
    done += k
  }
  free(dead)
}

# feed a mesh its instances from `buf` in this file's layout: attribute 3 = position + scale, 4 = sin, cos, seed, flags, 5 = tint +
# variation, 6 = a box instance's w, d, h and radius (0 for an ordinary one)
export function kgpu_attach(render3d_st: Render3dState, m: Mesh, buf: int) -> void {
  gpu_mesh_bind_instances(render3d_st, m, buf)
  gpu_mesh_attr_inst(render3d_st, m, 3, 4, GPU_F32, KG_DST_FLOATS * 4, 0)
  gpu_mesh_attr_inst(render3d_st, m, 4, 4, GPU_F32, KG_DST_FLOATS * 4, 16)
  gpu_mesh_attr_inst(render3d_st, m, 5, 4, GPU_F32, KG_DST_FLOATS * 4, 32)
  gpu_mesh_attr_inst(render3d_st, m, 6, 4, GPU_F32, KG_DST_FLOATS * 4, 48)
  gpu_mesh_done(render3d_st, m)
}

# Declare kit `id`: its model (loaded for this kit alone), distances, bounding radius, and whether it has an impostor
# card (call kgpu_bake_kit to make the frames) and windows (kgpu_kit_interior). The kit's draw records are written.
export function kgpu_kit(render3d_st: mut Render3dState, g: KGpu, id: int, model: Model, near: float, far: float, radius: float, casts: bool) -> void {
  let k = g.kits[id]
  k.model = model
  k.prims = min(len(model.prims), KG_PRIMS)
  if len(model.prims) > KG_PRIMS { print(`r3d: kit {id} has {len(model.prims)} material primitives: only the first {KG_PRIMS} are drawn`) }
  k.near = near
  k.far = far
  k.radius = radius
  k.casts = casts
  if not g.ready { return }
  if g.cpu_only {
    for p in 0 .. k.prims { kgpu_attach(render3d_st, model.prims[p].mesh, g.b_ident) }
    return
  }
  let rec = words(KG_PRIMS * 5)
  for p in 0 .. KG_PRIMS {
    rec[p * 5] = 0;  rec[p * 5 + 1] = 0;  rec[p * 5 + 2] = 0;  rec[p * 5 + 3] = 0;  rec[p * 5 + 4] = 0
    if p < k.prims { rec[p * 5] = model.prims[p].mesh.count }
  }
  # the records are written through the buffers' mappings, at this kit's place
  kgpu_rec_write(render3d_st, g, id * KG_REC * 20, data_of(rec), KG_PRIMS * 20)
  if g.card_mesh != null and k.card {
    let c = words(5)
    c[0] = g.card_mesh.count;  c[1] = 0;  c[2] = 0;  c[3] = 0;  c[4] = 0
    kgpu_rec_write(render3d_st, g, (id * KG_REC + KG_PRIMS) * 20, data_of(c), 20)
  }
  for p in 0 .. k.prims { kgpu_attach(render3d_st, model.prims[p].mesh, g.b_dst) }
  g.tab_dirty = true
}

# draw records into both lists' buffers (the main and the local lights' casters), through their mappings
function kgpu_rec_write(render3d_st: mut Render3dState, g: KGpu, at: int, data: pointer, n: int) -> void {
  let map = gpu_buffer_map(render3d_st, g.b_cmds)
  if map != null { mem_copy(mem_off(map, at), data, n) }
  # the main view's occlusion-culled copy (kinst_args.comp writes only its counts and places)
  if g.b_vcmds != 0 {
    let vm = gpu_buffer_map(render3d_st, g.b_vcmds)
    if vm != null { mem_copy(mem_off(vm, at), data, n) }
  }
  if g.b_l_cmds != 0 {
    let lm = gpu_buffer_map(render3d_st, g.b_l_cmds)
    if lm != null { mem_copy(mem_off(lm, at), data, n) }
  }
  # the shadow cache's list draws the same meshes: without these its records drew no index at all (no building cast into it)
  if g.b_s_cmds != 0 {
    let sm = gpu_buffer_map(render3d_st, g.b_s_cmds)
    if sm != null { mem_copy(mem_off(sm, at), data, n) }
  }
}

# kit `id` is a box kit (kitbox.ludic): its instances carry their own w, d, h, and its card is sized from them by `box`
export function kgpu_kit_box(g: KGpu, id: int, box: KitBox) -> void {
  g.tab_dirty = true                                  # its bounds envelope for the occlusion test (kgpu_upload_tables)
  if box == null or not box.on { g.kits[id].box = null;  return }
  g.kits[id].box = box
}

# the kit's windows show rooms from `ia`'s atlas (a texture made from its image), window cells of win_w x win_h metres
export function kgpu_kit_interior(g: KGpu, id: int, ia: InteriorAtlas, rooms_tex: int, win_w: float, win_h: float) -> void {
  let k = g.kits[id]
  k.ia = ia
  k.rooms = rooms_tex
  k.win_w = win_w
  k.win_h = win_h
}

# the kit draws a FACADE (kit.frag): a window grid fitted to each wall of each box instance, from the row's fac_* numbers (cellfile.ludic
# RenderKit; fac.ludic is the grid's reference) and its storey height. Its windows show rooms when it also has an interior atlas
@alloc_ok("a world being set up: once a kit")
export function kgpu_kit_facade(g: KGpu, id: int, r: RenderKit) -> void {
  let k = g.kits[id]
  if r == null or r.fac_bay <= 0.0 { k.fac = null;  return }
  let f = floats(20)
  f[0] = r.fac_bay;  f[1] = r.fac_glass;  f[2] = r.fac_sill;  f[3] = r.fac_head
  f[4] = r.fac_pier;  f[5] = float(r.fac_mull);  f[6] = float(r.fac_tran);  f[7] = r.fac_reveal
  f[8] = float(r.fac_ground);  f[9] = r.fac_spandrel;  f[10] = r.storey_h;  f[11] = 0.0
  f[12] = r.fac_shop_b;  f[13] = r.fac_shop_t;  f[14] = r.fac_near;  f[15] = r.fac_frame
  f[16] = r.fac_frame_r;  f[17] = r.fac_frame_g;  f[18] = r.fac_frame_b;  f[19] = 0.0
  k.fac = f
}

# the FACADE uniforms of kit `k` on program `p` (rooms on when it has an atlas; else its first material's colour map stands in for the
# atlas the program declares, and the glass is flat)
function kgpu_bind_facade(render3d_st: mut Render3dState, p: int, k: KGpuKit) -> void {
  let f = k.fac
  var rooms = 0.0
  if k.rooms != 0 { rooms = 1.0 }
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_fac_a"), f[0], f[1], f[2], f[3])
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_fac_b"), f[4], f[5], f[6], f[7])
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_fac_c"), f[8], f[9], f[10], rooms)
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_fac_d"), f[12], f[13], f[14], f[15])
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_fac_e"), f[16], f[17], f[18], 0.0)
  if k.rooms != 0 { imi_bind(render3d_st, p, k.ia, k.rooms, k.win_w, k.win_h) } else if k.prims > 0 {
    r3d_bind_2d(render3d_st, p, "u_rooms", 3, k.model.prims[0].diff)
    u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_im_cell"), k.win_w, k.win_h, 0.08, 4.0)
    u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_im_atlas"), 1.0, 1.0, 1.0, 0.4)
    u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_im_gain"), 2.2, 0.05, 0.0, 0.01)
    u_f3(render3d_st, gpu_uniform(render3d_st, p, "u_im_lit"), 1.0, 0.78, 0.52)
  }
}

# the kit's walls carry a line every `h` metres, `line` metres thick (0: none): from the top of a box instance (its eave) down, so a plinth shifts
# nothing, and from the base of an ordinary one up; the doors and props of
# a game have none, a building's body has its storeys
export function kgpu_kit_storey(g: KGpu, id: int, h: float, line: float) -> void {
  let k = g.kits[id]
  k.storey_h = Math.max(h, 0.0)
  k.storey_line = line
}

# Bake the kit's impostor frames (n x n of frame_px texels) from its model and give it a card. A person's click: it renders
# n * n views of the model into one atlas.
# A box kit is baked as its instance of (w, d, h): the frames hold its drawn bounds, and a card stretches them to each
# instance's own (oimp.vert).
export function kgpu_bake_kit(render3d_st: mut Render3dState, g: KGpu, id: int, w: float, d: float, h: float, n: int, frame_px: int) -> void {
  if not g.ready { return }
  let k = g.kits[id]
  let was = render3d_st.gvk_tag
  render3d_st.gvk_tag = VKM_IMPOSTOR
  if k.box != null {
    let b = floats(6)
    kitbox_bounds(k.box, w, d, h, b)
    let one = floats(KG_DST_FLOATS)
    for i in 0 .. KG_DST_FLOATS { one[i] = 0.0 }
    one[3] = 1.0;  one[5] = 1.0;  one[8] = 1.0;  one[9] = 1.0;  one[10] = 1.0
    one[12] = w;  one[13] = d;  one[14] = h;  one[15] = kitbox_radius_of(b)
    if g.b_ident_box == 0 { g.b_ident_box = gpu_buffer_new(render3d_st) }
    gpu_buffer_upload(render3d_st, g.b_ident_box, KG_DST_FLOATS * 4, data_of(one), GPU_STATIC)
    k.box_ref = floats(3)
    k.box_ref[0] = 2.0 * Math.max(Math.abs(b[0]), Math.abs(b[1]))
    k.box_ref[1] = 2.0 * Math.max(Math.abs(b[4]), Math.abs(b[5]))
    k.box_ref[2] = b[3]
    # a kit with a window grid is baked through its facade (kit.frag BAKE), so its card shows the grid, not a blank wall
    var bp = g.p_bake
    if k.fac != null {
      bp = g.p_bake_fac
      gpu_use_program(render3d_st, bp)
      let f = k.fac
      u_f4(render3d_st, gpu_uniform(render3d_st, bp, "u_fac_a"), f[0], f[1], f[2], f[3])
      u_f4(render3d_st, gpu_uniform(render3d_st, bp, "u_fac_b"), f[4], f[5], f[6], f[7])
      u_f4(render3d_st, gpu_uniform(render3d_st, bp, "u_fac_c"), f[8], f[9], f[10], 0.0)
      u_f4(render3d_st, gpu_uniform(render3d_st, bp, "u_fac_d"), f[12], f[13], f[14], f[15])
      u_f4(render3d_st, gpu_uniform(render3d_st, bp, "u_fac_e"), f[16], f[17], f[18], 0.0)
      u_f2(render3d_st, gpu_uniform(render3d_st, bp, "u_storey"), k.storey_h, k.storey_line)
    }
    k.atlas = oimp_bake(render3d_st, bp, g.b_ident_box, k.model, k.box_ref[0], k.box_ref[1], k.box_ref[2], n, frame_px)
    free(one);  free(b)
  } else {
    k.atlas = oimp_bake(render3d_st, g.p_bake, g.b_ident, k.model, w, d, h, n, frame_px)
  }
  render3d_st.gvk_tag = was
  k.alt = kgpu_card_alt(k.model)
  k.card = true
  # the card record, now that there is a card
  let c = words(5)
  c[0] = g.card_mesh.count;  c[1] = 0;  c[2] = 0;  c[3] = 0;  c[4] = 0
  kgpu_rec_write(render3d_st, g, (id * KG_REC + KG_PRIMS) * 20, data_of(c), 20)
  g.tab_dirty = true
  # the model's meshes were attached to the bake's instance: back to the arena's output
  for p in 0 .. k.prims { kgpu_attach(render3d_st, k.model.prims[p].mesh, g.b_dst) }
}

# ---- cells ------------------------------------------------------------------------------------------

# Put a cell's instances in the arena and its offset in the cell table. `slot` is the caller's own number for the cell
# (the scheduler's), used to find it again. Returns false when the arena or the table is full.
export function kgpu_add_cell(render3d_st: mut Render3dState, g: KGpu, slot: int, c: CellContent, o: ForgOrigin) -> bool {
  if not g.ready or g.cpu_only or len(g.free_cells) == 0 or c.n == 0 { return false }
  let first = kar_alloc(g.arena, c.n)
  if first < 0 { return false }
  let ix = g.free_cells[len(g.free_cells) - 1]
  List.pop(g.free_cells)
  g.cell_cx[ix] = c.cx
  g.cell_cz[ix] = c.cz
  g.cell_size[ix] = c.size
  g.cell_first[ix] = first
  g.cell_n[ix] = c.n
  g.cell_used[ix] = 1
  g.cell_slot[ix] = slot
  kgpu_cell_offset(g, ix, o)
  g.cell_tab[ix * 4 + 3] = 0.0
  g.tab_dirty = true
  # the records: 20 floats each, straight into the buffer's mapping
  let rec = floats(KG_SRC_FLOATS * 256)
  let map = gpu_buffer_map(render3d_st, g.b_src)
  var at = 0
  while at < c.n {
    let k = min(256, c.n - at)
    for j in 0 .. k {
      let i = at + j
      let r = j * KG_SRC_FLOATS
      rec[r] = c.xf[i * CELL_XF]
      rec[r + 1] = c.xf[i * CELL_XF + 1]
      rec[r + 2] = c.xf[i * CELL_XF + 2]
      rec[r + 3] = c.xf[i * CELL_XF + 4]
      rec[r + 4] = Math.sin(c.xf[i * CELL_XF + 3])
      rec[r + 5] = Math.cos(c.xf[i * CELL_XF + 3])
      rec[r + 6] = float(c.vari[i] & 0xffff) / 65536.0
      rec[r + 7] = float(c.flags[i])
      rec[r + 8] = cell_rgba_r(c.tint[i])
      rec[r + 9] = cell_rgba_g(c.tint[i])
      rec[r + 10] = cell_rgba_b(c.tint[i])
      rec[r + 11] = float(c.vari[i])
      rec[r + 12] = float(c.kit[i])
      rec[r + 13] = float(ix)
      rec[r + 14] = 0.0
      rec[r + 15] = 0.0
      rec[r + 16] = 0.0;  rec[r + 17] = 0.0;  rec[r + 18] = 0.0;  rec[r + 19] = 0.0
      if cell_is_box(c, i) {
        rec[r + 16] = c.box[i * CELL_BOX];  rec[r + 17] = c.box[i * CELL_BOX + 1];  rec[r + 18] = c.box[i * CELL_BOX + 2]
        rec[r + 19] = kinst_box_radius(c, i)
      }
    }
    if map != null { mem_copy(mem_off(map, (first + at) * KG_SRC_FLOATS * 4), data_of(rec), k * KG_SRC_FLOATS * 4) }
    at += k
  }
  free(rec)
  g.instances += c.n
  g.n_cells += 1
  return true
}

# the render-space offset of table entry ix: the cell's corner in double minus the origin, rounded once
function kgpu_cell_offset(g: KGpu, ix: int, o: ForgOrigin) -> void {
  g.cell_tab[ix * 4] = cell_render_x(o, g.cell_cx[ix], g.cell_size[ix])
  g.cell_tab[ix * 4 + 1] = float(0.0 - o.oy)
  g.cell_tab[ix * 4 + 2] = cell_render_z(o, g.cell_cz[ix], g.cell_size[ix])
}

# Take a cell out: its records are marked dead now and its range is given back (held a few frames, karena.ludic).
export function kgpu_remove_cell(render3d_st: mut Render3dState, g: KGpu, slot: int) -> bool {
  for ix in 0 .. g.max_cells {
    if g.cell_used[ix] == 1 and g.cell_slot[ix] == slot {
      kgpu_fill_dead(render3d_st, g, g.cell_first[ix], g.cell_n[ix])
      kar_free(g.arena, g.cell_first[ix], g.cell_n[ix])
      g.instances -= g.cell_n[ix]
      g.cell_used[ix] = 0
      g.cell_n[ix] = 0
      g.cell_tab[ix * 4 + 3] = 1.0
      push(g.free_cells, ix)
      g.n_cells -= 1
      g.tab_dirty = true
      return true
    }
  }
  return false
}

# the portals' verdict (portal.ludic, vis[room]) for the cells of an interior's rooms: room r's cell is slot base + r
export function pg_apply_gpu(g: PGraph, vis: words, kg: KGpu, base: int) -> int {
  var shown = 0
  for i in 0 .. len(g.rooms) {
    kgpu_hide_cell(kg, base + i, vis[i] == 0)
    if vis[i] != 0 { shown += 1 }
  }
  return shown
}

# hide or show a cell (a room the portals cannot see)
export function kgpu_hide_cell(g: KGpu, slot: int, hidden: bool) -> void {
  for ix in 0 .. g.max_cells {
    if g.cell_used[ix] == 1 and g.cell_slot[ix] == slot {
      var h = 0.0
      if hidden { h = 1.0 }
      if g.cell_tab[ix * 4 + 3] != h { g.cell_tab[ix * 4 + 3] = h;  g.tab_dirty = true }
      return
    }
  }
}

# ---- the frame ----------------------------------------------------------------------------------------

# The kits' numbers (two vec4s each) to their buffer; the cell table to its; both only when something changed.
function kgpu_upload_tables(render3d_st: mut Render3dState, g: KGpu, o: ForgOrigin) -> void {
  if o.serial != g.serial {
    g.serial = o.serial
    for ix in 0 .. g.max_cells { if g.cell_used[ix] == 1 { kgpu_cell_offset(g, ix, o) } }
    g.tab_dirty = true
  }
  if not g.tab_dirty { return }
  g.tab_dirty = false
  let mc = gpu_buffer_map(render3d_st, g.b_cells)
  if mc != null { mem_copy(mc, data_of(g.cell_tab), g.max_cells * 16) }
  let kt = floats(g.n_kits * 8)
  for i in 0 .. g.n_kits {
    let k = g.kits[i]
    kt[i * 8] = k.near
    kt[i * 8 + 1] = k.far
    kt[i * 8 + 2] = k.radius
    if k.card { kt[i * 8 + 3] = 1.0 } else { kt[i * 8 + 3] = 0.0 }
    kt[i * 8 + 4] = float(k.prims)
    kt[i * 8 + 5] = 0.0;  kt[i * 8 + 6] = 0.0;  kt[i * 8 + 7] = 0.0
  }
  let mk = gpu_buffer_map(render3d_st, g.b_kits)
  if mk != null { mem_copy(mk, data_of(kt), g.n_kits * 32) }
  free(kt)
  # a box kit's drawn bounds per unit of an instance's w, d, h (kitbox.ludic's envelope: |x| <= S w + O, sh h + sd d + oy), for the occlusion
  # test's box (kinst_cull.comp KBox); w = 0 in the second vec4: none known, the instance's sphere is tested instead
  let kb = floats(g.n_kits * 12)
  for i in 0 .. g.n_kits * 12 { kb[i] = 0.0 }
  for i in 0 .. g.n_kits {
    let b = g.kits[i].box
    if b == null or not b.on or b.env == null { continue }
    let e = b.env
    kb[i * 12] = e[0];  kb[i * 12 + 1] = e[1];  kb[i * 12 + 2] = e[2];  kb[i * 12 + 3] = e[3]
    kb[i * 12 + 4] = e[4];  kb[i * 12 + 5] = e[5];  kb[i * 12 + 6] = e[6];  kb[i * 12 + 7] = 1.0
    kb[i * 12 + 8] = e[7];  kb[i * 12 + 9] = e[8];  kb[i * 12 + 10] = e[9];  kb[i * 12 + 11] = 0.0
  }
  let mb = gpu_buffer_map(render3d_st, g.b_kbox)
  if mb != null { mem_copy(mb, data_of(kb), g.n_kits * 48) }
  free(kb)
}

# Before the frame's first pass (r3d_on_prepare): the origin's offsets, then reset, count, scan, scatter.
export function kgpu_frame(render3d_st: mut Render3dState, g: KGpu, o: ForgOrigin) -> void {
  if not g.ready or g.cpu_only { return }
  kar_tick(g.arena)
  kgpu_upload_tables(render3d_st, g, o)
  g.l_ready = false
  g.occ = false
  if g.arena.high == 0 { return }
  let bins = g.n_kits * 2
  # a local light casts this frame: the main list leaves the last l_cap places to its casters
  let lights = g.c_cull_l != 0 and render3d_st.ue_ll_nsph > 0
  var main_cap = g.dst_cap
  if lights { main_cap = g.dst_cap - g.l_cap }
  # the main view's occlusion against last frame's HZB (occlusion.ludic, R3D_KINST_OCCLUSION): the visible part of each bin into b_vcmds
  let occ = occ_inst_live(render3d_st, OCC_INST_KINST)
  # 1. counters to zero (both halves: the survivors and the visible ones)
  g.pr[0] = bins * 2;  g.pr[1] = 0;  g.pr[2] = 0;  g.pr[3] = 0
  g.bufs[0] = g.b_counts;  g.bufs[1] = g.b_cursors
  gpu_dispatch(render3d_st, g.c_reset, data_of(g.pr), 16, g.bufs, (bins * 2 + 63) / 64)
  # 2. count the survivors of each bin
  kgpu_cull_params(render3d_st, g, 0, occ)
  g.prm[31] = main_cap
  kgpu_bind_cull(render3d_st, g)
  gpu_dispatch(render3d_st, g.c_cull, data_of(g.prm), KG_PRM * 4, g.bufs, (g.arena.high + 63) / 64)
  # 3. counts to places, and the draw records
  g.pa[0] = bins;  g.pa[1] = g.n_kits;  g.pa[2] = main_cap;  g.pa[3] = 0
  g.pa[4] = 0;  g.pa[5] = 0;  g.pa[6] = 0;  g.pa[7] = 0
  if occ { g.pa[4] = 1 }
  g.bufs[0] = g.b_counts;  g.bufs[1] = g.b_offs;  g.bufs[2] = g.b_kits;  g.bufs[3] = g.b_cmds;  g.bufs[4] = g.b_vcmds
  gpu_dispatch(render3d_st, g.c_args, data_of(g.pa), 32, g.bufs, 1)
  # 4. write the survivors where they belong
  kgpu_cull_params(render3d_st, g, 1, occ)
  g.prm[31] = main_cap
  kgpu_bind_cull(render3d_st, g)
  gpu_dispatch(render3d_st, g.c_cull, data_of(g.prm), KG_PRM * 4, g.bufs, (g.arena.high + 63) / 64)
  g.occ = occ
  if lights { kgpu_frame_lights(render3d_st, g, main_cap) }
  g.s_ready = false
  if render3d_st.sc_cull and g.s_cap > 0 { kgpu_frame_cache(render3d_st, g) }
  if r3d_env_has(render3d_st, "R3D_UE_LS_DEBUG") { kgpu_lights_debug(render3d_st, g) }
}

# R3D_UE_LS_DEBUG=1: every 120 frames, the main list's and the local light casters' instance counts, read back (waits for the GPU)
@alloc_ok("debug output, only under R3D_UE_LS_DEBUG")
function kgpu_lights_debug(render3d_st: mut Render3dState, g: KGpu) -> void {
  g.dbg_n += 1
  if g.dbg_n % 120 != 1 { return }
  gpu_finish(render3d_st)
  var main_n = 0
  var light_n = 0
  let m = gpu_buffer_map(render3d_st, g.b_counts)
  let l = gpu_buffer_map(render3d_st, g.b_l_counts)
  if m == null or l == null { return }
  let t = words(g.n_kits * 2)
  mem_copy(data_of(t), m, g.n_kits * 8)
  for i in 0 .. g.n_kits { main_n += t[i * 2] }
  mem_copy(data_of(t), l, g.n_kits * 8)
  for i in 0 .. g.n_kits { light_n += t[i * 2] }
  free(t)
  print(`kgpu casters: {main_n} instances in the camera's list, {light_n} gathered for {render3d_st.ue_ll_nsph} shadowed lights`)
}

# the shadowed local lights' casters (Unreal gathers a whole-scene local light shadow's casters from the light's bounds, not the
# view): the same four steps over kinst_cull_lights.comp, into their own counters and records, after the main list in b_dst
function kgpu_frame_lights(render3d_st: mut Render3dState, g: KGpu, start: int) -> void {
  let bins = g.n_kits * 2
  let n = render3d_st.ue_ll_nsph
  gpu_buffer_upload(render3d_st, g.b_lights, n * 16, data_of(render3d_st.ue_ll_sph), GPU_DYNAMIC)
  g.pr[0] = bins;  g.pr[1] = 0;  g.pr[2] = 0;  g.pr[3] = 0
  g.bufs[0] = g.b_l_counts;  g.bufs[1] = g.b_l_cursors
  gpu_dispatch(render3d_st, g.c_reset, data_of(g.pr), 16, g.bufs, (bins + 63) / 64)
  for pass in 0 .. 2 {
    kgpu_cull_params(render3d_st, g, pass, false)
    for i in 0 .. 32 { g.prm_l[i] = g.prm[i] }
    g.prm_l[31] = g.dst_cap
    g.prm_l[32] = n;  g.prm_l[33] = 0;  g.prm_l[34] = 0;  g.prm_l[35] = 0
    g.bufs[0] = g.b_src;  g.bufs[1] = g.b_kits;  g.bufs[2] = g.b_cells;  g.bufs[3] = g.b_l_counts
    g.bufs[4] = g.b_l_offs;  g.bufs[5] = g.b_l_cursors;  g.bufs[6] = g.b_dst;  g.bufs[7] = g.b_lights
    gpu_dispatch(render3d_st, g.c_cull_l, data_of(g.prm_l), 144, g.bufs, (g.arena.high + 63) / 64)
    if pass == 0 {
      g.pa[0] = bins;  g.pa[1] = g.n_kits;  g.pa[2] = g.dst_cap;  g.pa[3] = start
      g.pa[4] = 0;  g.pa[5] = 0;  g.pa[6] = 0;  g.pa[7] = 0              # no occlusion: VCmds bound, never written
      g.bufs[0] = g.b_l_counts;  g.bufs[1] = g.b_l_offs;  g.bufs[2] = g.b_kits;  g.bufs[3] = g.b_l_cmds;  g.bufs[4] = g.b_l_cmds
      gpu_dispatch(render3d_st, g.c_args, data_of(g.pa), 32, g.bufs, 1)
    }
  }
  g.l_ready = true
}

# The sun's cached cascades' casters (shadow_cache.ludic): Unreal culls a whole-scene shadow's casters to the light's own volume, so a
# cached window holds the buildings beside and behind the camera too, whichever way it turns. The main cull's four steps with the
# window's planes (sc_cull_vp; the level by the camera's distance as ever), into their own counters and records after everything in b_dst.
function kgpu_frame_cache(render3d_st: mut Render3dState, g: KGpu) -> void {
  let bins = g.n_kits * 2
  kinst_planes(render3d_st.sc_cull_vp, g.s_planes)
  g.pr[0] = bins;  g.pr[1] = 0;  g.pr[2] = 0;  g.pr[3] = 0
  g.bufs[0] = g.b_s_counts;  g.bufs[1] = g.b_s_cursors
  gpu_dispatch(render3d_st, g.c_reset, data_of(g.pr), 16, g.bufs, (bins + 63) / 64)
  for pass in 0 .. 2 {
    kgpu_cull_params(render3d_st, g, pass, false)          # a shadow's list: never the camera's occlusion
    for i in 0 .. 24 { g.prm[i] = float_bits(g.s_planes[i]) }
    g.bufs[0] = g.b_src;  g.bufs[1] = g.b_kits;  g.bufs[2] = g.b_cells;  g.bufs[3] = g.b_s_counts
    g.bufs[4] = g.b_s_offs;  g.bufs[5] = g.b_s_cursors;  g.bufs[6] = g.b_dst
    g.bufs[7] = occ_inst_buf(render3d_st, g.b_src);  g.bufs[8] = g.b_kbox
    gpu_dispatch(render3d_st, g.c_cull, data_of(g.prm), KG_PRM * 4, g.bufs, (g.arena.high + 63) / 64)
    if pass == 0 {
      g.pa[0] = bins;  g.pa[1] = g.n_kits;  g.pa[2] = g.dst_cap + g.s_cap;  g.pa[3] = g.dst_cap
      g.pa[4] = 0;  g.pa[5] = 0;  g.pa[6] = 0;  g.pa[7] = 0
      g.bufs[0] = g.b_s_counts;  g.bufs[1] = g.b_s_offs;  g.bufs[2] = g.b_kits;  g.bufs[3] = g.b_s_cmds;  g.bufs[4] = g.b_s_cmds
      gpu_dispatch(render3d_st, g.c_args, data_of(g.pa), 32, g.bufs, 1)
    }
  }
  g.s_ready = true
}

# the cull's Params (kinst_cull.comp): six planes, the camera and scale, then instances, bins, pass, capacity; then the previous frame's
# HZB (occ_inst_params), tested only when `occ` (the main view's list, occ_inst_live)
function kgpu_cull_params(render3d_st: mut Render3dState, g: KGpu, pass: int, occ: bool) -> void {
  let planes = floats(24)
  kinst_planes(render3d_st.cam_vp_clean, planes)
  for i in 0 .. 24 { g.prm[i] = float_bits(planes[i]) }
  free(planes)
  g.prm[24] = float_bits(render3d_st.cam_pos[0])
  g.prm[25] = float_bits(render3d_st.cam_pos[1])
  g.prm[26] = float_bits(render3d_st.cam_pos[2])
  g.prm[27] = float_bits(g.scale)
  g.prm[28] = g.arena.high
  g.prm[29] = g.n_kits * 2
  g.prm[30] = pass
  g.prm[31] = g.dst_cap
  occ_inst_params(render3d_st, g.prm, 32, occ)
}
function kgpu_bind_cull(render3d_st: Render3dState, g: KGpu) -> void {
  g.bufs[0] = g.b_src;  g.bufs[1] = g.b_kits;  g.bufs[2] = g.b_cells;  g.bufs[3] = g.b_counts
  g.bufs[4] = g.b_offs;  g.bufs[5] = g.b_cursors;  g.bufs[6] = g.b_dst
  g.bufs[7] = occ_inst_buf(render3d_st, g.b_src);  g.bufs[8] = g.b_kbox
}

# the kits' meshes, lit: one indirect draw a material, then each kit's impostor card. Call from the scene draw callback.
export function kgpu_draw(render3d_st: mut Render3dState, g: KGpu) -> void {
  if not g.ready or g.cpu_only or g.arena.high == 0 { return }
  let cmds = kgpu_view_cmds(render3d_st, g)
  gpu_cull(render3d_st, false)
  for id in 0 .. g.n_kits {
    let k = g.kits[id]
    if k.model == null { continue }
    var p = g.p_mesh
    if k.rooms != 0 { p = g.p_int }
    if k.fac != null { p = g.p_fac }
    gpu_use_program(render3d_st, p)
    u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_view"), render3d_st.cam_view)
    u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_proj"), render3d_st.cam_proj)
    u_v3(render3d_st, gpu_uniform(render3d_st, p, "u_cam_pos"), render3d_st.cam_pos)
    u_f(render3d_st, gpu_uniform(render3d_st, p, "u_rough_scale"), 1.0)
    sky_bind_lighting(render3d_st, p)
    shadow_bind(render3d_st, p)
    fog_bind(render3d_st, p)
    kgpu_bind_opt(render3d_st, g, p)
    u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_storey"), k.storey_h, k.storey_line)
    if k.fac != null { kgpu_bind_facade(render3d_st, p, k) } else if k.rooms != 0 { imi_bind(render3d_st, p, k.ia, k.rooms, k.win_w, k.win_h) }
    for i in 0 .. k.prims {
      let pr = k.model.prims[i]
      r3d_bind_2d(render3d_st, p, "u_diff", 0, pr.diff)
      r3d_bind_2d(render3d_st, p, "u_nrm", 1, pr.nrm)
      r3d_bind_2d(render3d_st, p, "u_arm", 2, pr.arm)
      prim_factors(render3d_st, p, pr)
      gpu_draw_mesh_indirect(render3d_st, pr.mesh, cmds, (id * KG_REC + i) * 20, 1, 0, 0)
    }
  }
  kgpu_draw_cards(render3d_st, g, cmds)
  gpu_cull(render3d_st, true)
}

# ---- the depth prepass (R3D_KIT_PREPASS) -----------------------------------------------------------------------------------------------

# Unreal draws every opaque mesh's depth before the base pass (r.EarlyZPass, DDM_AllOpaque for the deferred renderer: DepthRendering.cpp
# FDepthPassMeshProcessor::AddMeshBatch / TryAddMeshBatch, the depth state TStaticDepthStencilState<true, CF_DepthNearOrEqual>; a masked
# material keeps its clip in that pass), so the base pass shades each pixel once: a facade behind a nearer building, drawn in any order, is
# rejected by depth before kit.frag's whole wall-and-window shading runs. Here the kits' meshes lay their depth first, from the same
# indirect records the lit pass draws (the main view's, occlusion-culled: kgpu_view_cmds), with no colour and only kit.frag's own discards
# (DEPTH_ONLY: the clip plane, a box kit's party-wall sides, the fog wall's dissolve), both faces as the lit pass draws them.
# Unreal's base pass then tests CF_Equal with depth writes off (BasePassRendering.cpp SetDepthStencilStateForBasePass), which needs the two
# passes' positions bit for bit equal (its vertex factories' INVARIANT positions). This engine's static prepass instead biases the prepass's
# depth a little away from the camera (static_chunks.ludic STC_PRE_BIAS_*) and leaves the lit pass's own test and depth writes as they
# were: every pixel the prepass lays is laid again, nearer, by the same surface's lit fragment, so whatever won the pixel before wins it now
# and the depth buffer ends exactly as it did; only fragments that lose anyway (behind a kit by more than the bias) are cut before shading.
# The same is done here (nothing that can z-fight, no invariance needed between the depth and the lit programs). Main view only: a water
# reflection (its clip plane and mirror) draws as before. R3D_KIT_PREPASS=0 turns it off.
const KG_PRE_BIAS_F: fixed = -1.0     # slope factor, reversed depth: toward 0 (away from the camera), as static_chunks.ludic's
const KG_PRE_BIAS_U: fixed = -2.0

# the kits' depth before anything of the scene is shaded (the scene callback, first: the game's ot_draw_scene); the plain kits, then the
# FACADE ones, each under one program
export function kgpu_draw_depth(render3d_st: mut Render3dState, g: KGpu) -> void {
  if not g.ready or g.cpu_only or g.arena.high == 0 or not g.pre_on or render3d_st.ter_reflect { return }
  let cmds = kgpu_view_cmds(render3d_st, g)
  gpu_color_write(render3d_st, false)
  gpu_depth_bias(render3d_st, KG_PRE_BIAS_F, KG_PRE_BIAS_U)
  gpu_cull(render3d_st, false)              # both faces, as kgpu_draw
  for pass in 0 .. 2 {
    var p = g.p_depth
    if pass == 1 { p = g.p_depth_fac }
    var bound = false
    for id in 0 .. g.n_kits {
      let k = g.kits[id]
      if k.model == null { continue }
      if (k.fac != null) != (pass == 1) { continue }
      if not bound {
        bound = true
        gpu_use_program(render3d_st, p)
        u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_view"), render3d_st.cam_view)
        u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_proj"), render3d_st.cam_proj)
        u_v3(render3d_st, gpu_uniform(render3d_st, p, "u_cam_pos"), render3d_st.cam_pos)
        fog_bind(render3d_st, p)            # u_clip_y and the dissolve's u_fog_cut
      }
      for i in 0 .. k.prims {
        gpu_draw_mesh_indirect(render3d_st, k.model.prims[i].mesh, cmds, (id * KG_REC + i) * 20, 1, 0, 0)
      }
    }
  }
  gpu_cull(render3d_st, true)
  gpu_depth_bias(render3d_st, 0.0, 0.0)
  gpu_color_write(render3d_st, true)
}

# the records the view being drawn takes: the main view's occlusion-culled ones when this frame's cull made them, else the whole list
# (a water reflection sees what the camera's HZB cannot vouch for)
function kgpu_view_cmds(render3d_st: Render3dState, g: KGpu) -> int {
  if g.occ and not render3d_st.ter_reflect { return g.b_vcmds }
  return g.b_cmds
}

# the far kits as octahedral impostor cards
function kgpu_draw_cards(render3d_st: mut Render3dState, g: KGpu, cmds: int) -> void {
  let p = g.p_card
  gpu_use_program(render3d_st, p)
  u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_view"), render3d_st.cam_view)
  u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_proj"), render3d_st.cam_proj)
  u_v3(render3d_st, gpu_uniform(render3d_st, p, "u_cam_pos"), render3d_st.cam_pos)
  sky_bind_lighting(render3d_st, p)
  shadow_bind(render3d_st, p)
  fog_bind(render3d_st, p)
  gpu_cull(render3d_st, false)
  for id in 0 .. g.n_kits {
    let k = g.kits[id]
    if not k.card or k.atlas == null or k.atlas.albedo == 0 { continue }
    let a = k.atlas
    u_f(render3d_st, gpu_uniform(render3d_st, p, "u_radius"), a.radius)
    kgpu_card_box(render3d_st, g, p, k)
    kgpu_card_alt_bind(render3d_st, p, k)
    u_f(render3d_st, gpu_uniform(render3d_st, p, "u_centre_y"), a.centre_y)
    u_f(render3d_st, gpu_uniform(render3d_st, p, "u_frames"), float(a.n))
    u_f(render3d_st, gpu_uniform(render3d_st, p, "u_frame_px"), float(a.px))
    r3d_bind_2d(render3d_st, p, "u_atlas_albedo", 0, a.albedo)
    r3d_bind_2d(render3d_st, p, "u_atlas_normal", 1, a.normal)
    gpu_draw_mesh_indirect(render3d_st, g.card_mesh, cmds, (id * KG_REC + KG_PRIMS) * 20, 1, 0, 0)
  }
}

# the alternative a kit's surfaced material has (surface.ludic surf_apply: kit.frag lays it over the instances whose seed falls under
# its share), as its card draws it: the alternative's mean colour graded as surfaceAtP grades a scan's own colour, and the share
@alloc_ok("a kit's card being baked: its alternative's colour, once")
function kgpu_card_alt(m: Model) -> floats {
  let a = floats(4)
  a[0] = 0.0;  a[1] = 0.0;  a[2] = 0.0;  a[3] = 0.0
  if m == null { return a }
  for i in 0 .. len(m.prims) {
    let pr = m.prims[i]
    if pr == null or pr.surf == null or pr.surf2 == null or pr.surf2[17] <= 0.0 or pr.surf2[19] > 0.5 { continue }   # (a flat roof's gravel is not the card's)
    let s = pr.surf2
    let l = 0.2126 * s[8] + 0.7152 * s[9] + 0.0722 * s[10]
    for c in 0 .. 3 { a[c] = Math.max((l + (s[8 + c] - l) * s[13]) * s[12], 0.0) }
    a[3] = s[17]
    return a
  }
  return a
}
function kgpu_card_alt_bind(render3d_st: mut Render3dState, p: int, k: KGpuKit) -> void {
  if k.alt == null { u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_imp_alt"), 0.0, 0.0, 0.0, 0.0);  return }
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_imp_alt"), k.alt[0], k.alt[1], k.alt[2], k.alt[3])
}

# a card's box uniforms: the kit's anchor tuples and the instance its frames were baked at (u_box_ref.w 0: an ordinary kit)
function kgpu_card_box(render3d_st: mut Render3dState, g: KGpu, p: int, k: KGpuKit) -> void {
  if k.box == null or k.box_ref == null {
    u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_box_ref"), 0.0, 0.0, 0.0, 0.0)
    return
  }
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_box_ref"), k.box_ref[0], k.box_ref[1], k.box_ref[2], 1.0)
  kitbox_uniforms(k.box, g.kt_u, g.kt_n)
  var loc = gpu_uniform(render3d_st, p, "u_kt[0]")
  if loc < 0 { loc = gpu_uniform(render3d_st, p, "u_kt") }
  u_f4v(render3d_st, loc, KB_TUPLES * 3, g.kt_u)
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "u_kn"), float(g.kt_n[0]), float(g.kt_n[1]), float(g.kt_n[2]))
}

# the kits' meshes into a shadow cascade (their cards cast nothing: a far building's shadow is the cascades' terrain-scale
# business, and is left out here)
export function kgpu_draw_casters(render3d_st: mut Render3dState, g: KGpu, light_vp: floats) -> void {
  if not g.ready or g.cpu_only or g.arena.high == 0 { return }
  let p = g.p_shadow
  # a local light's map draws the casters gathered from the lights' bounds (kgpu_frame_lights), the sun's the camera's list
  var cmds = g.b_cmds
  if render3d_st.sh_local and g.l_ready { cmds = g.b_l_cmds }
  if render3d_st.sh_phase == SH_PHASE_STATIC and g.s_ready { cmds = g.b_s_cmds }   # a cached cascade's (shadow_cache.ludic)
  if render3d_st.sh_phase == SH_PHASE_DYN { return }                                  # buildings never move
  gpu_use_program(render3d_st, p)
  u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_light_vp"), light_vp)
  gpu_cull(render3d_st, false)
  for id in 0 .. g.n_kits {
    let k = g.kits[id]
    if k.model == null or not k.casts { continue }
    for i in 0 .. k.prims {
      gpu_draw_mesh_indirect(render3d_st, k.model.prims[i].mesh, cmds, (id * KG_REC + i) * 20, 1, 0, 0)
    }
  }
}

# How many instances survived the last frame's cull, read back: for a benchmark or a debug overlay, never for a frame
# (it waits for the GPU). Sum of the bins' clamped counts.
export function kgpu_visible(render3d_st: mut Render3dState, g: KGpu) -> int {
  if not g.ready { return 0 }
  gpu_finish(render3d_st)
  let m = gpu_buffer_map(render3d_st, g.b_counts)
  if m == null { return 0 }
  let t = words(g.n_kits * 2)
  mem_copy(data_of(t), m, g.n_kits * 2 * 4)
  var sum = 0
  for i in 0 .. g.n_kits * 2 { sum += t[i] }
  free(t)
  return sum
}

export function kgpu_instances(g: KGpu) -> int { return g.instances }

# The last frame's survivors of every bin, read back into out[0 .. 2 * n_kits): out[2 id] the instances of kit `id` drawn as its mesh,
# out[2 id + 1] as its card. Like kgpu_visible it waits for the GPU: a benchmark's or a proof's number, never a frame's.
export function kgpu_bin_counts(render3d_st: mut Render3dState, g: KGpu, out: []int) -> int {
  if not g.ready or g.cpu_only { return 0 }
  gpu_finish(render3d_st)
  let m = gpu_buffer_map(render3d_st, g.b_counts)
  if m == null { return 0 }
  let n = min(len(out), g.n_kits * 2)
  let t = words(g.n_kits * 2)
  mem_copy(data_of(t), m, g.n_kits * 2 * 4)
  for i in 0 .. n { out[i] = t[i] }
  free(t)
  return n
}

# ---- the CPU path's draw ----------------------------------------------------------------------------

# The lists kinst_cull made (kinst.ludic, the same 16-float records) drawn the way the GPU path draws its output: each
# (kit, level) list uploaded to a buffer of its own, one instanced draw a material and one for the card.
export function kgpu_draw_lists(render3d_st: mut Render3dState, g: KGpu, k: KCull) -> void {
  if not g.ready { return }
  gpu_cull(render3d_st, false)
  for id in 0 .. g.n_kits {
    let kit = g.kits[id]
    let n = kinst_bin_count(k, id, KI_MESH)
    if kit.model == null or n == 0 { continue }
    if g.list_bufs[id * 2] == 0 { g.list_bufs[id * 2] = gpu_buffer_new(render3d_st) }
    let buf = g.list_bufs[id * 2]
    gpu_buffer_upload(render3d_st, buf, n * KG_DST_FLOATS * 4, data_of(kinst_bin(k, id, KI_MESH)), GPU_DYNAMIC)
    var p = g.p_mesh
    if kit.rooms != 0 { p = g.p_int }
    if kit.fac != null { p = g.p_fac }
    gpu_use_program(render3d_st, p)
    u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_view"), render3d_st.cam_view)
    u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_proj"), render3d_st.cam_proj)
    u_v3(render3d_st, gpu_uniform(render3d_st, p, "u_cam_pos"), render3d_st.cam_pos)
    u_f(render3d_st, gpu_uniform(render3d_st, p, "u_rough_scale"), 1.0)
    sky_bind_lighting(render3d_st, p)
    shadow_bind(render3d_st, p)
    fog_bind(render3d_st, p)
    kgpu_bind_opt(render3d_st, g, p)
    u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_storey"), kit.storey_h, kit.storey_line)
    if kit.fac != null { kgpu_bind_facade(render3d_st, p, kit) } else if kit.rooms != 0 { imi_bind(render3d_st, p, kit.ia, kit.rooms, kit.win_w, kit.win_h) }
    for i in 0 .. kit.prims {
      let pr = kit.model.prims[i]
      r3d_bind_2d(render3d_st, p, "u_diff", 0, pr.diff)
      r3d_bind_2d(render3d_st, p, "u_nrm", 1, pr.nrm)
      r3d_bind_2d(render3d_st, p, "u_arm", 2, pr.arm)
      prim_factors(render3d_st, p, pr)
      kgpu_attach(render3d_st, pr.mesh, buf)
      mesh_draw_instanced(render3d_st, pr.mesh, n)
    }
  }
  let p = g.p_card
  gpu_use_program(render3d_st, p)
  u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_view"), render3d_st.cam_view)
  u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_proj"), render3d_st.cam_proj)
  u_v3(render3d_st, gpu_uniform(render3d_st, p, "u_cam_pos"), render3d_st.cam_pos)
  sky_bind_lighting(render3d_st, p)
  shadow_bind(render3d_st, p)
  fog_bind(render3d_st, p)
  for id in 0 .. g.n_kits {
    let kit = g.kits[id]
    let n = kinst_bin_count(k, id, KI_CARD)
    if not kit.card or kit.atlas == null or kit.atlas.albedo == 0 or n == 0 { continue }
    if g.list_bufs[id * 2 + 1] == 0 { g.list_bufs[id * 2 + 1] = gpu_buffer_new(render3d_st) }
    let buf = g.list_bufs[id * 2 + 1]
    gpu_buffer_upload(render3d_st, buf, n * KG_DST_FLOATS * 4, data_of(kinst_bin(k, id, KI_CARD)), GPU_DYNAMIC)
    let a = kit.atlas
    u_f(render3d_st, gpu_uniform(render3d_st, p, "u_radius"), a.radius)
    kgpu_card_box(render3d_st, g, p, kit)
    kgpu_card_alt_bind(render3d_st, p, kit)
    u_f(render3d_st, gpu_uniform(render3d_st, p, "u_centre_y"), a.centre_y)
    u_f(render3d_st, gpu_uniform(render3d_st, p, "u_frames"), float(a.n))
    u_f(render3d_st, gpu_uniform(render3d_st, p, "u_frame_px"), float(a.px))
    r3d_bind_2d(render3d_st, p, "u_atlas_albedo", 0, a.albedo)
    r3d_bind_2d(render3d_st, p, "u_atlas_normal", 1, a.normal)
    kgpu_attach(render3d_st, g.card_mesh, buf)
    mesh_draw_instanced(render3d_st, g.card_mesh, n)
  }
  gpu_cull(render3d_st, true)
}
