# ============================================================================
# hlod.ludic - the hierarchical-LOD proxy of a cell: the far look of a city block as a handful of coloured
# boxes instead of thousands of buildings. Pure logic (no device): `hlod_bake` turns a cell's content
# (cellfile.ludic) and the map's kits into a merged, simplified mesh; `hlod_encode` / `hlod_save` write it as the
# cell's .lwh file; the renderer (hlod_gpu.ludic) uploads one mesh a cell and draws it with the cell's offset.
#
# The bake is a task for a person, not a frame: `tools/hlod_bake.ludic` runs it over a map's cells (README,
# "World partition and streaming"). The code lives here so it is tested on a tiny input.
#
# Simplification. Each building is a box (kit footprint x height, rotated by yaw, scaled; a box kit's instance its own
# drawn bounds, cellfile.ludic's box columns: footprint x0 .. x1 by z0 .. z1, from y0 to y1, the roof's rise included). Buildings are then
# clustered by a ground grid of `cluster_m` metres and a height band of `height_band` metres, and each cluster of
# two or more is replaced by ONE axis-aligned box over all of them - provided the merged box is not more than
# `max_growth` times the volume of the buildings it replaces, which keeps a skyscraper from swallowing the
# houses beside it (the height band keeps them apart in the first place). The bottom face is never made: nobody
# sees it. A box is five faces, twenty vertices, thirty indices.
#
# Vertices are 7 floats: position (cell frame, metres), normal, and the colour as RGBA8 in the float's bits.
# ============================================================================
numbers float

export const HLOD_V: int = 7           # floats a vertex

export property HlodMesh {
  cx: int = 0,
  cz: int = 0,
  size: float = 256.0,
  nv: int = 0,
  ni: int = 0,
  vtx: floats,          # HLOD_V floats a vertex
  idx: words,
  boxes: int = 0,       # boxes emitted
  source: int = 0       # buildings they stand for
}

@alloc_ok("a bake or a cell loading: the mesh's arrays are made once")
export function hlod_new(cx: int, cz: int, size: float, cap_boxes: int) -> HlodMesh {
  let m = new HlodMesh
  m.cx = cx
  m.cz = cz
  m.size = size
  let cap = max(cap_boxes, 1)
  m.vtx = floats(cap * 20 * HLOD_V)
  m.idx = words(cap * 30)
  return m
}

@alloc_ok("a bake: the arrays grow while boxes are added")
function hlod_grow(m: HlodMesh) -> void {
  let nv = floats(len(m.vtx) * 2)
  let ni = words(len(m.idx) * 2)
  for i in 0 .. m.nv * HLOD_V { nv[i] = m.vtx[i] }
  for i in 0 .. m.ni { ni[i] = m.idx[i] }
  m.vtx = nv
  m.idx = ni
}

function hlod_vertex(m: HlodMesh, x: float, y: float, z: float, nx: float, ny: float, nz: float, rgba: int) -> void {
  let o = m.nv * HLOD_V
  m.vtx[o] = x
  m.vtx[o + 1] = y
  m.vtx[o + 2] = z
  m.vtx[o + 3] = nx
  m.vtx[o + 4] = ny
  m.vtx[o + 5] = nz
  m.vtx[o + 6] = float_from_bits(rgba)
  m.nv += 1
}

# one quad a, b, c, d (as laid out round its edge) facing `n`: wound so its front is the side the normal is on
function hlod_quad(m: HlodMesh, ax: float, ay: float, az: float, bx: float, by: float, bz: float, cx: float, cy: float, cz: float, dx: float, dy: float, dz: float, nx: float, ny: float, nz: float, rgba: int) -> void {
  let base = m.nv
  hlod_vertex(m, ax, ay, az, nx, ny, nz, rgba)
  hlod_vertex(m, bx, by, bz, nx, ny, nz, rgba)
  hlod_vertex(m, cx, cy, cz, nx, ny, nz, rgba)
  hlod_vertex(m, dx, dy, dz, nx, ny, nz, rgba)
  # the geometric normal of (a, b, c)
  let ux = bx - ax
  let uy = by - ay
  let uz = bz - az
  let vx = cx - ax
  let vy = cy - ay
  let vz = cz - az
  let gx = uy * vz - uz * vy
  let gy = uz * vx - ux * vz
  let gz = ux * vy - uy * vx
  let flip = gx * nx + gy * ny + gz * nz < 0.0
  if flip {
    m.idx[m.ni] = base;  m.idx[m.ni + 1] = base + 2;  m.idx[m.ni + 2] = base + 1
    m.idx[m.ni + 3] = base;  m.idx[m.ni + 4] = base + 3;  m.idx[m.ni + 5] = base + 2
  } else {
    m.idx[m.ni] = base;  m.idx[m.ni + 1] = base + 1;  m.idx[m.ni + 2] = base + 2
    m.idx[m.ni + 3] = base;  m.idx[m.ni + 4] = base + 2;  m.idx[m.ni + 5] = base + 3
  }
  m.ni += 6
}

# A box from a footprint of four corners (x, z pairs, in order round it) between heights y0 and y1: four walls and a
# roof, all one colour. The walls' normals point away from the footprint's middle.
export function hlod_prism(m: HlodMesh, px: floats, pz: floats, y0: float, y1: float, rgba: int) -> void {
  hlod_prism_roof(m, px, pz, y0, y1, rgba, rgba)
}

# the same box with its walls `wall` and its roof `roof` (RGBA8 each)
export function hlod_prism_roof(m: HlodMesh, px: floats, pz: floats, y0: float, y1: float, wall: int, roof: int) -> void {
  let rgba = wall
  if (m.nv + 20) * HLOD_V > len(m.vtx) or m.ni + 30 > len(m.idx) { hlod_grow(m) }
  let mx = (px[0] + px[1] + px[2] + px[3]) * 0.25
  let mz = (pz[0] + pz[1] + pz[2] + pz[3]) * 0.25
  for k in 0 .. 4 {
    let j = (k + 1) % 4
    let ex = px[j] - px[k]
    let ez = pz[j] - pz[k]
    var nx = ez
    var nz = -ex
    let l = Math.sqrt(nx * nx + nz * nz)
    if l < 0.00001 { continue }
    nx = nx / l
    nz = nz / l
    if nx * ((px[k] + px[j]) * 0.5 - mx) + nz * ((pz[k] + pz[j]) * 0.5 - mz) < 0.0 { nx = -nx;  nz = -nz }
    hlod_quad(m, px[k], y0, pz[k], px[j], y0, pz[j], px[j], y1, pz[j], px[k], y1, pz[k], nx, 0.0, nz, rgba)
  }
  hlod_quad(m, px[0], y1, pz[0], px[1], y1, pz[1], px[2], y1, pz[2], px[3], y1, pz[3], 0.0, 1.0, 0.0, roof)
  m.boxes += 1
}

# a box instance's drawn footprint corners (x0 .. x1 by z0 .. z1 in the kit's frame), turned and moved as the renderer
# turns an instance
export function hlod_box_corners(x: float, z: float, x0: float, x1: float, z0: float, z1: float, yaw: float, px: floats, pz: floats) -> void {
  let s = Math.sin(yaw)
  let c = Math.cos(yaw)
  for k in 0 .. 4 {
    var lx = x0
    var lz = z0
    if k == 1 or k == 2 { lx = x1 }
    if k == 2 or k == 3 { lz = z1 }
    px[k] = x + c * lx + s * lz
    pz[k] = z - s * lx + c * lz
  }
}

# thing i's drawn box: its footprint corners into px, pz and its bottom and top into yy (2 floats); its volume
function hlod_thing(c: CellContent, i: int, k: RenderKit, px: floats, pz: floats, yy: floats) -> float {
  let o = i * CELL_XF
  if cell_is_box(c, i) {
    let b = i * CELL_BOX + 3
    hlod_box_corners(c.xf[o], c.xf[o + 2], c.box[b], c.box[b + 1], c.box[b + 4], c.box[b + 5], c.xf[o + 3], px, pz)
    yy[0] = c.xf[o + 1] + c.box[b + 2]
    yy[1] = c.xf[o + 1] + c.box[b + 3]
    return (c.box[b + 1] - c.box[b]) * (c.box[b + 5] - c.box[b + 4]) * (c.box[b + 3] - c.box[b + 2])
  }
  let sc = c.xf[o + 4]
  hlod_corners(c.xf[o], c.xf[o + 2], k.w * sc * 0.5, k.d * sc * 0.5, c.xf[o + 3], px, pz)
  yy[0] = c.xf[o + 1]
  yy[1] = c.xf[o + 1] + k.h * sc
  return k.w * k.d * sc * sc * k.h * sc
}

# a building's footprint corners, rotated as the renderer rotates an instance (x' = c x + s z, z' = -s x + c z)
export function hlod_corners(x: float, z: float, hw: float, hd: float, yaw: float, px: floats, pz: floats) -> void {
  let s = Math.sin(yaw)
  let c = Math.cos(yaw)
  for k in 0 .. 4 {
    var lx = -hw
    var lz = -hd
    if k == 1 or k == 2 { lx = hw }
    if k == 2 or k == 3 { lz = hd }
    px[k] = x + c * lx + s * lz
    pz[k] = z - s * lx + c * lz
  }
}

function hlod_rgba(r: float, g: float, b: float) -> int {
  return cell_rgba(int(Math.clamp(r, 0.0, 1.0) * 255.0 + 0.5), int(Math.clamp(g, 0.0, 1.0) * 255.0 + 0.5), int(Math.clamp(b, 0.0, 1.0) * 255.0 + 0.5), 255)
}

# the key buildings are grouped by: ground cell and height band, packed (gx and gz below 64, the band below 256)
function hlod_key(c: CellContent, i: int, k: RenderKit, cluster_m: float, band: float) -> int {
  let o = i * CELL_XF
  let sc = c.xf[o + 4]
  var gx = int(Math.floor(c.xf[o] / cluster_m))
  var gz = int(Math.floor(c.xf[o + 2] / cluster_m))
  gx = min(max(gx, 0), 63)
  gz = min(max(gz, 0), 63)
  var tall = k.h * sc
  if cell_is_box(c, i) { tall = c.box[i * CELL_BOX + 6] }
  let hb = min(max(int(Math.floor(tall / band)), 0), 255)
  return (gz * 64 + gx) * 256 + hb
}

# Bake a cell's proxy into `out` (made with hlod_new; its cx, cz and size should be the content's).
#   kits         the map's RenderKits rows, by kit id
#   cluster_m    the ground grid buildings are merged on (0: no merging, one box a building)
#   height_band  buildings are only merged with others in the same band of this many metres of height
#   max_growth   a merged box may be at most this many times the volume of what it replaces
# A thing whose kit id is not a row is skipped (counted in neither boxes nor source).
export function hlod_bake(c: CellContent, kits: []RenderKit, cluster_m: float, height_band: float, max_growth: float, out: HlodMesh) -> void {
  hlod_bake_parts(c, kits, null, cluster_m, height_band, max_growth, out)
}

# The same, with a coarse shape for some kits: parts[kit id] is a few boxes in the kit's own frame (HLOD_PART floats each: x0, y0, z0, x1,
# y1, z1, before the instance's yaw and scale; hlod_parts makes them from the kit's mesh), or null. A thing of such a kit (not a box kit) is
# drawn as its parts, in the kit's proxy colours, and never merged with its neighbours: a crane is a tower and a jib from far away, not
# the box round both (a landmark's one box stood for everything under its jib, centred on its place where the mesh is not).
@alloc_ok("a bake: its sort keys and the mesh are made once per cell")
export function hlod_bake_parts(c: CellContent, kits: []RenderKit, parts: []floats, cluster_m: float, height_band: float, max_growth: float, out: HlodMesh) -> void {
  out.cx = c.cx
  out.cz = c.cz
  out.size = c.size
  let n = c.n
  var cl = cluster_m
  if cl > 0.0 and cl < c.size / 64.0 { cl = c.size / 64.0 }
  let px = floats(4)
  let pz = floats(4)
  if cl <= 0.0 {
    for i in 0 .. n {
      if c.kit[i] < 0 or c.kit[i] >= len(kits) { continue }
      if hlod_has_parts(c, i, parts) { hlod_parted(c, i, kits[c.kit[i]], parts[c.kit[i]], px, pz, out) } else { hlod_single(c, i, kits[c.kit[i]], px, pz, out) }
    }
    return
  }
  # order the buildings by group (a thing drawn as its parts stands alone)
  let order = words(n)
  let key = words(n)
  var m = 0
  for i in 0 .. n {
    if c.kit[i] < 0 or c.kit[i] >= len(kits) { continue }
    if hlod_has_parts(c, i, parts) {
      hlod_parted(c, i, kits[c.kit[i]], parts[c.kit[i]], px, pz, out)
      continue
    }
    order[m] = i
    key[m] = hlod_key(c, i, kits[c.kit[i]], cl, height_band)
    m += 1
  }
  var gap = m / 2
  while gap > 0 {
    for a in gap .. m {
      let oi = order[a]
      let ki = key[a]
      var j = a
      while j >= gap and (key[j - gap] > ki or (key[j - gap] == ki and order[j - gap] > oi)) {
        order[j] = order[j - gap]
        key[j] = key[j - gap]
        j -= gap
      }
      order[j] = oi
      key[j] = ki
    }
    gap = gap / 2
  }
  var at = 0
  while at < m {
    var end = at + 1
    while end < m and key[end] == key[at] { end += 1 }
    hlod_group(c, kits, order, at, end, max_growth, px, pz, out)
    at = end
  }
}

# thing i's kit has parts (and it is not a box kit, whose instances each have a size of their own)
function hlod_has_parts(c: CellContent, i: int, parts: []floats) -> bool {
  if parts == null or c.kit[i] >= len(parts) or cell_is_box(c, i) { return false }
  let p = parts[c.kit[i]]
  return p != null and len(p) >= HLOD_PART
}

# thing i as its kit's parts: each a box turned and moved as the renderer turns an instance, scaled with it
function hlod_parted(c: CellContent, i: int, k: RenderKit, p: floats, px: floats, pz: floats, out: HlodMesh) -> void {
  let o = i * CELL_XF
  let sc = c.xf[o + 4]
  let wall = hlod_tinted(k, c.tint[i], false)
  let roof = hlod_tinted(k, c.tint[i], true)
  var q = 0
  while q + HLOD_PART <= len(p) {
    hlod_box_corners(c.xf[o], c.xf[o + 2], p[q] * sc, p[q + 3] * sc, p[q + 2] * sc, p[q + 5] * sc, c.xf[o + 3], px, pz)
    hlod_prism_roof(out, px, pz, c.xf[o + 1] + p[q + 1] * sc, c.xf[o + 1] + p[q + 4] * sc, wall, roof)
    q += HLOD_PART
  }
  out.source += 1
}

# one building as its own box
@alloc_ok("a bake: two floats a building")
function hlod_single(c: CellContent, i: int, k: RenderKit, px: floats, pz: floats, out: HlodMesh) -> void {
  let yy = floats(2)
  hlod_thing(c, i, k, px, pz, yy)
  hlod_prism_roof(out, px, pz, yy[0], yy[1], hlod_tinted(k, c.tint[i], false), hlod_tinted(k, c.tint[i], true))
  free(yy)
  out.source += 1
}

# the kit's proxy colour times the instance's tint: its walls', or its roof's (the walls' when the row gives the roof none)
function hlod_tinted(k: RenderKit, tint: int, roof: bool) -> int {
  return hlod_rgba(hlod_kit_r(k, roof) * cell_rgba_r(tint), hlod_kit_g(k, roof) * cell_rgba_g(tint), hlod_kit_b(k, roof) * cell_rgba_b(tint))
}
function hlod_kit_r(k: RenderKit, roof: bool) -> float {
  if roof and k.proxy_roof { return k.proxy_roof_r }
  return k.proxy_r
}
function hlod_kit_g(k: RenderKit, roof: bool) -> float {
  if roof and k.proxy_roof { return k.proxy_roof_g }
  return k.proxy_g
}
function hlod_kit_b(k: RenderKit, roof: bool) -> float {
  if roof and k.proxy_roof { return k.proxy_roof_b }
  return k.proxy_b
}

# the buildings order[at .. end) share a group: one merged box if it is not too much bigger than they are, else each alone
@alloc_ok("a bake: two floats a group")
function hlod_group(c: CellContent, kits: []RenderKit, order: words, at: int, end: int, max_growth: float, px: floats, pz: floats, out: HlodMesh) -> void {
  if end - at < 2 {
    hlod_single(c, order[at], kits[c.kit[order[at]]], px, pz, out)
    return
  }
  var minx = 1000000000.0
  var maxx = -1000000000.0
  var minz = 1000000000.0
  var maxz = -1000000000.0
  var y0 = 1000000000.0
  var y1 = -1000000000.0
  var vol = 0.0
  var sr = 0.0
  var sg = 0.0
  var sb = 0.0
  var tr = 0.0
  var tg = 0.0
  var tb = 0.0
  var sw = 0.0
  var tw = 0.0
  let yy = floats(2)
  for a in at .. end {
    let i = order[a]
    let k = kits[c.kit[i]]
    vol = vol + hlod_thing(c, i, k, px, pz, yy)
    for q in 0 .. 4 {
      minx = Math.min(minx, px[q]);  maxx = Math.max(maxx, px[q])
      minz = Math.min(minz, pz[q]);  maxz = Math.max(maxz, pz[q])
    }
    y0 = Math.min(y0, yy[0])
    y1 = Math.max(y1, yy[1])
    # each one's colour counts by how much of it is seen: its walls by their area, its roof by its plan (a door counts for next to nothing)
    var plan = 0.0
    var perim = 0.0
    for q in 0 .. 4 {
      let j = (q + 1) % 4
      plan = plan + px[q] * pz[j] - px[j] * pz[q]
      perim = perim + Math.sqrt((px[j] - px[q]) * (px[j] - px[q]) + (pz[j] - pz[q]) * (pz[j] - pz[q]))
    }
    plan = Math.abs(plan) * 0.5
    let wall = perim * Math.max(yy[1] - yy[0], 0.0)
    sw = sw + wall
    tw = tw + plan
    sr = sr + wall * k.proxy_r * cell_rgba_r(c.tint[i])
    sg = sg + wall * k.proxy_g * cell_rgba_g(c.tint[i])
    sb = sb + wall * k.proxy_b * cell_rgba_b(c.tint[i])
    tr = tr + plan * hlod_kit_r(k, true) * cell_rgba_r(c.tint[i])
    tg = tg + plan * hlod_kit_g(k, true) * cell_rgba_g(c.tint[i])
    tb = tb + plan * hlod_kit_b(k, true) * cell_rgba_b(c.tint[i])
  }
  free(yy)
  let merged = (maxx - minx) * (maxz - minz) * (y1 - y0)
  if merged > max_growth * vol {
    for a in at .. end { hlod_single(c, order[a], kits[c.kit[order[a]]], px, pz, out) }
    return
  }
  px[0] = minx;  pz[0] = minz
  px[1] = maxx;  pz[1] = minz
  px[2] = maxx;  pz[2] = maxz
  px[3] = minx;  pz[3] = maxz
  sw = Math.max(sw, 0.000001)
  tw = Math.max(tw, 0.000001)
  hlod_prism_roof(out, px, pz, y0, y1, hlod_rgba(sr / sw, sg / sw, sb / sw), hlod_rgba(tr / tw, tg / tw, tb / tw))
  out.source += end - at
}

export function hlod_tris(m: HlodMesh) -> int { return m.ni / 3 }

# ---- a kit's coarse shape, from its own mesh ----------------------------------------------------
# A landmark (a crane, a port, an airport, a stadium) past the full radius is a few boxes that follow its shape, not the one box round it.
# hlod_parts takes the kit's triangles (9 floats each, in its own frame), marks the cells of a grid of HLOD_PART_GRID cells along each axis
# of their bounds that the triangles pass through (points over each triangle no farther apart than half a cell), then splits: from the box
# round every marked cell, it cuts the box, along the axis and at the plane, that takes the most empty volume away (each half shrunk to its
# own marked cells), until there are max_parts boxes or no cut takes away HLOD_PART_GAIN of the first box. Each box is then fitted to the
# points in its marked cells. The result: HLOD_PART floats a box (x0, y0, z0, x1, y1, z1), or null for no triangle.
export const HLOD_PART: int = 6
export const HLOD_PART_GRID: int = 20
const HLOD_PART_GAIN: float = 0.02
const HLOD_BIG: float = 1000000000.0

function hlod_pcell(v: float, v0: float, cs: float, g: int) -> int {
  return min(max(int(Math.floor((v - v0) / cs)), 0), g - 1)
}

@alloc_ok("a bake: the grid and its boxes are made once per kit")
export function hlod_parts(tri: floats, ntri: int, max_parts: int) -> floats {
  if ntri <= 0 or max_parts <= 0 or len(tri) < ntri * 9 { return null }
  var x0 = HLOD_BIG
  var y0 = HLOD_BIG
  var z0 = HLOD_BIG
  var x1 = -HLOD_BIG
  var y1 = -HLOD_BIG
  var z1 = -HLOD_BIG
  for v in 0 .. ntri * 3 {
    x0 = Math.min(x0, tri[v * 3]);  x1 = Math.max(x1, tri[v * 3])
    y0 = Math.min(y0, tri[v * 3 + 1]);  y1 = Math.max(y1, tri[v * 3 + 1])
    z0 = Math.min(z0, tri[v * 3 + 2]);  z1 = Math.max(z1, tri[v * 3 + 2])
  }
  let g = HLOD_PART_GRID
  let csx = Math.max(x1 - x0, 0.001) / float(g)
  let csy = Math.max(y1 - y0, 0.001) / float(g)
  let csz = Math.max(z1 - z0, 0.001) / float(g)
  let nc = g * g * g
  let occ = words(nc)
  let lo = floats(nc * 3)
  let hi = floats(nc * 3)
  for i in 0 .. nc {
    occ[i] = 0
    lo[i * 3] = HLOD_BIG;  lo[i * 3 + 1] = HLOD_BIG;  lo[i * 3 + 2] = HLOD_BIG
    hi[i * 3] = -HLOD_BIG;  hi[i * 3 + 1] = -HLOD_BIG;  hi[i * 3 + 2] = -HLOD_BIG
  }
  # the cells each triangle passes through, and the points of it in each
  for t in 0 .. ntri {
    let o = t * 9
    var m = 0.0
    for e in 0 .. 3 {
      let a = o + e * 3
      let b = o + ((e + 1) % 3) * 3
      m = Math.max(m, Math.abs(tri[b] - tri[a]) / csx)
      m = Math.max(m, Math.abs(tri[b + 1] - tri[a + 1]) / csy)
      m = Math.max(m, Math.abs(tri[b + 2] - tri[a + 2]) / csz)
    }
    let n = min(int(Math.floor(m * 2.0)) + 1, 96)
    for i in 0 .. n + 1 {
      for j in 0 .. n + 1 - i {
        let u = float(i) / float(n)
        let w = float(j) / float(n)
        let r = 1.0 - u - w
        let px = tri[o] * r + tri[o + 3] * u + tri[o + 6] * w
        let py = tri[o + 1] * r + tri[o + 4] * u + tri[o + 7] * w
        let pz = tri[o + 2] * r + tri[o + 5] * u + tri[o + 8] * w
        let c = (hlod_pcell(py, y0, csy, g) * g + hlod_pcell(pz, z0, csz, g)) * g + hlod_pcell(px, x0, csx, g)
        occ[c] = 1
        lo[c * 3] = Math.min(lo[c * 3], px);  hi[c * 3] = Math.max(hi[c * 3], px)
        lo[c * 3 + 1] = Math.min(lo[c * 3 + 1], py);  hi[c * 3 + 1] = Math.max(hi[c * 3 + 1], py)
        lo[c * 3 + 2] = Math.min(lo[c * 3 + 2], pz);  hi[c * 3 + 2] = Math.max(hi[c * 3 + 2], pz)
      }
    }
  }
  # boxes of cells: 6 ints each (first cell along x, y, z; one past the last)
  let bx = words(max_parts * 6)
  let cs = floats(3)
  cs[0] = csx;  cs[1] = csy;  cs[2] = csz
  bx[0] = 0;  bx[1] = 0;  bx[2] = 0;  bx[3] = g;  bx[4] = g;  bx[5] = g
  hlod_pshrink(occ, g, bx, 0)
  var nb = 1
  let v0 = hlod_pvol(bx, 0, cs)
  # per slab along the axis cut: its marked cells' bounds on the other two axes, then those bounds summed from either end
  let sl = words(g * 4)
  let pre = words((g + 1) * 6)
  let suf = words((g + 1) * 6)
  let cut = words(8)
  while nb < max_parts {
    var best = HLOD_PART_GAIN * v0
    var bb = -1
    for b in 0 .. nb {
      for a in 0 .. 3 {
        let n = bx[b * 6 + 3 + a] - bx[b * 6 + a]
        if n < 2 { continue }
        hlod_pslabs(occ, g, bx, b, a, sl)
        hlod_psums(sl, n, pre, suf)
        for p in 1 .. n {
          # the halves [0, p) and [p, n): each its first and last marked slab, and its bounds across
          if pre[p * 6] < 0 or suf[p * 6] < 0 { continue }
          let va = hlod_phalf(a, cs, pre, p)
          let vb = hlod_phalf(a, cs, suf, p)
          let gain = hlod_pvol(bx, b, cs) - va - vb
          if gain > best {
            best = gain
            bb = b
            cut[0] = a
            cut[1] = p
          }
        }
      }
    }
    if bb < 0 { break }
    # box bb becomes the half before the cut, a new box the half after it, each shrunk to its own cells
    let a = cut[0]
    let p = cut[1]
    for q in 0 .. 6 { bx[nb * 6 + q] = bx[bb * 6 + q] }
    let at = bx[bb * 6 + a]
    bx[bb * 6 + 3 + a] = at + p
    bx[nb * 6 + a] = at + p
    hlod_pshrink(occ, g, bx, bb)
    hlod_pshrink(occ, g, bx, nb)
    nb += 1
  }
  free(sl);  free(pre);  free(suf);  free(cut);  free(cs)
  # each box fitted to the points of its marked cells
  let out = floats(nb * HLOD_PART)
  for b in 0 .. nb {
    var ax0 = HLOD_BIG
    var ay0 = HLOD_BIG
    var az0 = HLOD_BIG
    var ax1 = -HLOD_BIG
    var ay1 = -HLOD_BIG
    var az1 = -HLOD_BIG
    for iy in bx[b * 6 + 1] .. bx[b * 6 + 4] {
      for iz in bx[b * 6 + 2] .. bx[b * 6 + 5] {
        for ix in bx[b * 6] .. bx[b * 6 + 3] {
          let c = (iy * g + iz) * g + ix
          if occ[c] == 0 { continue }
          ax0 = Math.min(ax0, lo[c * 3]);  ax1 = Math.max(ax1, hi[c * 3])
          ay0 = Math.min(ay0, lo[c * 3 + 1]);  ay1 = Math.max(ay1, hi[c * 3 + 1])
          az0 = Math.min(az0, lo[c * 3 + 2]);  az1 = Math.max(az1, hi[c * 3 + 2])
        }
      }
    }
    let q = b * HLOD_PART
    out[q] = ax0;  out[q + 1] = ay0;  out[q + 2] = az0;  out[q + 3] = ax1;  out[q + 4] = ay1;  out[q + 5] = az1
  }
  free(occ);  free(lo);  free(hi);  free(bx)
  return out
}

# box b's volume in metres
function hlod_pvol(bx: words, b: int, cs: floats) -> float {
  let o = b * 6
  return float(bx[o + 3] - bx[o]) * cs[0] * float(bx[o + 4] - bx[o + 1]) * cs[1] * float(bx[o + 5] - bx[o + 2]) * cs[2]
}

# box b shrunk to its marked cells (a box with none is left with no extent)
function hlod_pshrink(occ: words, g: int, bx: words, b: int) -> void {
  let o = b * 6
  var i0 = g
  var j0 = g
  var k0 = g
  var i1 = -1
  var j1 = -1
  var k1 = -1
  for iy in bx[o + 1] .. bx[o + 4] {
    for iz in bx[o + 2] .. bx[o + 5] {
      for ix in bx[o] .. bx[o + 3] {
        if occ[(iy * g + iz) * g + ix] == 0 { continue }
        i0 = min(i0, ix);  i1 = max(i1, ix)
        j0 = min(j0, iy);  j1 = max(j1, iy)
        k0 = min(k0, iz);  k1 = max(k1, iz)
      }
    }
  }
  if i1 < 0 {
    bx[o + 3] = bx[o];  bx[o + 4] = bx[o + 1];  bx[o + 5] = bx[o + 2]
    return
  }
  bx[o] = i0;  bx[o + 1] = j0;  bx[o + 2] = k0;  bx[o + 3] = i1 + 1;  bx[o + 4] = j1 + 1;  bx[o + 5] = k1 + 1
}

# the cell (along x, y, z) of box b's slab s across axis a, at (u, v) on the other two axes (u the first of them in x, y, z order)
function hlod_pidx(g: int, bx: words, b: int, a: int, s: int, u: int, v: int) -> int {
  let o = b * 6
  var ix = 0
  var iy = 0
  var iz = 0
  if a == 0 { ix = bx[o] + s;  iy = u;  iz = v }
  else if a == 1 { iy = bx[o + 1] + s;  ix = u;  iz = v }
  else { iz = bx[o + 2] + s;  ix = u;  iy = v }
  return (iy * g + iz) * g + ix
}

# each slab of box b across axis a: the marked cells' first and last on the other two axes (4 ints a slab; -1 for a slab with none)
function hlod_pslabs(occ: words, g: int, bx: words, b: int, a: int, sl: words) -> void {
  let o = b * 6
  var ua = 1
  var va = 2
  if a == 1 { ua = 0 }
  if a == 2 { ua = 0;  va = 1 }
  let n = bx[o + 3 + a] - bx[o + a]
  for s in 0 .. n {
    var u0 = g
    var u1 = -1
    var w0 = g
    var w1 = -1
    for u in bx[o + ua] .. bx[o + 3 + ua] {
      for v in bx[o + va] .. bx[o + 3 + va] {
        if occ[hlod_pidx(g, bx, b, a, s, u, v)] == 0 { continue }
        u0 = min(u0, u);  u1 = max(u1, u)
        w0 = min(w0, v);  w1 = max(w1, v)
      }
    }
    sl[s * 4] = u0;  sl[s * 4 + 1] = u1;  sl[s * 4 + 2] = w0;  sl[s * 4 + 3] = w1
    if u1 < 0 { sl[s * 4] = -1 }
  }
}

# the slabs summed from the start (pre[p]: slabs [0, p)) and from the end (suf[p]: slabs [p, n)): 6 ints each, the first and last marked
# slab (-1: none) and the bounds across
function hlod_psums(sl: words, n: int, pre: words, suf: words) -> void {
  pre[0] = -1
  for p in 1 .. n + 1 {
    let s = p - 1
    for q in 0 .. 6 { pre[p * 6 + q] = pre[s * 6 + q] }
    if sl[s * 4] < 0 { continue }
    if pre[p * 6] < 0 {
      pre[p * 6] = s;  pre[p * 6 + 2] = sl[s * 4];  pre[p * 6 + 3] = sl[s * 4 + 1];  pre[p * 6 + 4] = sl[s * 4 + 2];  pre[p * 6 + 5] = sl[s * 4 + 3]
    } else {
      pre[p * 6 + 2] = min(pre[p * 6 + 2], sl[s * 4]);  pre[p * 6 + 3] = max(pre[p * 6 + 3], sl[s * 4 + 1])
      pre[p * 6 + 4] = min(pre[p * 6 + 4], sl[s * 4 + 2]);  pre[p * 6 + 5] = max(pre[p * 6 + 5], sl[s * 4 + 3])
    }
    pre[p * 6 + 1] = s
  }
  suf[n * 6] = -1
  var p = n - 1
  while p >= 0 {
    for q in 0 .. 6 { suf[p * 6 + q] = suf[(p + 1) * 6 + q] }
    if sl[p * 4] >= 0 {
      if suf[p * 6] < 0 {
        suf[p * 6 + 1] = p;  suf[p * 6 + 2] = sl[p * 4];  suf[p * 6 + 3] = sl[p * 4 + 1];  suf[p * 6 + 4] = sl[p * 4 + 2];  suf[p * 6 + 5] = sl[p * 4 + 3]
      } else {
        suf[p * 6 + 2] = min(suf[p * 6 + 2], sl[p * 4]);  suf[p * 6 + 3] = max(suf[p * 6 + 3], sl[p * 4 + 1])
        suf[p * 6 + 4] = min(suf[p * 6 + 4], sl[p * 4 + 2]);  suf[p * 6 + 5] = max(suf[p * 6 + 5], sl[p * 4 + 3])
      }
      suf[p * 6] = p
    }
    p -= 1
  }
}

# the volume (metres) of a half of a box cut across axis a, from its sums row `at` (pre or suf at the cut): its marked slabs by its cells across
function hlod_phalf(a: int, cs: floats, sums: words, at: int) -> float {
  let r = at * 6
  let n_a = float(sums[r + 1] - sums[r] + 1)
  let n_u = float(sums[r + 3] - sums[r + 2] + 1)
  let n_v = float(sums[r + 5] - sums[r + 4] + 1)
  var ca = cs[0]
  var cu = cs[1]
  var cv = cs[2]
  if a == 1 { ca = cs[1];  cu = cs[0];  cv = cs[2] }
  if a == 2 { ca = cs[2];  cu = cs[0];  cv = cs[1] }
  return n_a * ca * n_u * cu * n_v * cv
}

# ---- the proxy's colours, from the kit's own mesh ------------------------------------------------
# A far block must be the colour its buildings are near, so a kit's proxy colours are what its mesh shows (kit_proxy_read feeds
# every triangle of the kit's node here with its material's base colour, linear as the kit shader multiplies it): the walls the
# albedo a view from the side sees, each triangle weighted by its area times the horizontal part of its normal; the roof the albedo
# a view from above sees, weighted by its area times the upward part. A pitched roof counts for both, a wall for the walls only.
# The sums: HLOD_COL_ACC floats (walls r, g, b, weight; roof r, g, b, weight), zero to start.
export const HLOD_COL_ACC: int = 8

# triangle (ia, ib, ic) of `pos` (3 floats a vertex) drawn in (r, g, b) into the sums. `nrm` (3 floats a vertex, or null) only says
# which side is out: the face's normal is its geometric one, turned to agree with its vertices' (a two-sided mesh is wound either way)
export function hlod_colour_tri(acc: floats, pos: floats, nrm: floats, ia: int, ib: int, ic: int, r: float, g: float, b: float) -> void {
  let ux = pos[ib * 3] - pos[ia * 3]
  let uy = pos[ib * 3 + 1] - pos[ia * 3 + 1]
  let uz = pos[ib * 3 + 2] - pos[ia * 3 + 2]
  let vx = pos[ic * 3] - pos[ia * 3]
  let vy = pos[ic * 3 + 1] - pos[ia * 3 + 1]
  let vz = pos[ic * 3 + 2] - pos[ia * 3 + 2]
  var gx = uy * vz - uz * vy
  var gy = uz * vx - ux * vz
  var gz = ux * vy - uy * vx
  let l = Math.sqrt(gx * gx + gy * gy + gz * gz)
  if l < 0.000001 { return }
  if nrm != null {
    let sx = nrm[ia * 3] + nrm[ib * 3] + nrm[ic * 3]
    let sy = nrm[ia * 3 + 1] + nrm[ib * 3 + 1] + nrm[ic * 3 + 1]
    let sz = nrm[ia * 3 + 2] + nrm[ib * 3 + 2] + nrm[ic * 3 + 2]
    if sx * gx + sy * gy + sz * gz < 0.0 { gx = -gx;  gy = -gy;  gz = -gz }
  }
  let area = 0.5 * l
  let ny = gy / l
  let side = area * Math.sqrt(Math.max(1.0 - ny * ny, 0.0))
  let top = area * Math.max(ny, 0.0)
  acc[0] = acc[0] + r * side;  acc[1] = acc[1] + g * side;  acc[2] = acc[2] + b * side;  acc[3] = acc[3] + side
  acc[4] = acc[4] + r * top;  acc[5] = acc[5] + g * top;  acc[6] = acc[6] + b * top;  acc[7] = acc[7] + top
}

# a colour component held to [0, 1] and the thousandth (the row writes it so: what the bake drew and the row says are one colour)
function hlod_c3(v: float) -> float { return Math.floor(Math.clamp(v, 0.0, 1.0) * 1000.0 + 0.5) / 1000.0 }

# the sums into kit `k`'s proxy colours, the walls' and the roof's (a roof no triangle faces up to is the walls' colour); false,
# and the row left as it was, when no triangle counted
export function hlod_colour_apply(acc: floats, k: RenderKit) -> bool {
  let w = acc[3]
  let t = acc[7]
  if w <= 0.000001 and t <= 0.000001 { return false }
  if w > 0.000001 {
    k.proxy_r = hlod_c3(acc[0] / w);  k.proxy_g = hlod_c3(acc[1] / w);  k.proxy_b = hlod_c3(acc[2] / w)
  } else {
    k.proxy_r = hlod_c3(acc[4] / t);  k.proxy_g = hlod_c3(acc[5] / t);  k.proxy_b = hlod_c3(acc[6] / t)
  }
  k.proxy_roof = true
  if t > 0.000001 {
    k.proxy_roof_r = hlod_c3(acc[4] / t);  k.proxy_roof_g = hlod_c3(acc[5] / t);  k.proxy_roof_b = hlod_c3(acc[6] / t)
  } else {
    k.proxy_roof_r = k.proxy_r;  k.proxy_roof_g = k.proxy_g;  k.proxy_roof_b = k.proxy_b
  }
  return true
}

# the bytes the mesh takes on disk, and in the scheduler's accounts (its HLOD layer)
export function hlod_bytes(m: HlodMesh) -> int { return 32 + m.nv * HLOD_V * 4 + m.ni * 4 }

# ---- files -------------------------------------------------------------------------------------

const LWH_MAGIC: int = 0x3148574C     # "LWH1"

@alloc_ok("a bake: the file's bytes are made once")
export function hlod_encode(m: HlodMesh) -> []byte {
  let b = buffer(hlod_bytes(m))
  lw_put32(b, 0, LWH_MAGIC)
  lw_put32(b, 4, 1)
  lw_put32(b, 8, m.cx)
  lw_put32(b, 12, m.cz)
  lw_putf(b, 16, m.size)
  lw_put32(b, 20, m.nv)
  lw_put32(b, 24, m.ni)
  lw_put32(b, 28, m.boxes)
  var at = 32
  for i in 0 .. m.nv * HLOD_V { lw_putf(b, at, m.vtx[i]);  at += 4 }
  for i in 0 .. m.ni { lw_put32(b, at, m.idx[i]);  at += 4 }
  return b
}

# a mesh from bytes; null when they are not a proxy, or are cut short, or name a vertex that is not there
@alloc_ok("a cell loading: its arrays are made once")
export function hlod_decode(b: []byte) -> HlodMesh {
  if b == null or len(b) < 32 or lw_get32(b, 0) != LWH_MAGIC or lw_get32(b, 4) != 1 { return null }
  let nv = lw_get32(b, 20)
  let ni = lw_get32(b, 24)
  if nv < 0 or ni < 0 or len(b) < 32 + nv * HLOD_V * 4 + ni * 4 { return null }
  let m = new HlodMesh
  m.cx = lw_get32(b, 8)
  m.cz = lw_get32(b, 12)
  m.size = lw_getf(b, 16)
  m.boxes = lw_get32(b, 28)
  m.nv = nv
  m.ni = ni
  m.vtx = floats(max(nv, 1) * HLOD_V)
  m.idx = words(max(ni, 1))
  var at = 32
  for i in 0 .. nv * HLOD_V { m.vtx[i] = lw_getf(b, at);  at += 4 }
  for i in 0 .. ni {
    let v = lw_get32(b, at)
    if v < 0 or v >= nv { return null }
    m.idx[i] = v
    at += 4
  }
  return m
}

export function hlod_save(dir: string, m: HlodMesh) -> bool {
  Fs.mkdir(dir)
  let b = hlod_encode(m)
  return Fs.write_bytes(cell_path(dir, m.cx, m.cz, "lwh"), b, len(b))
}

# (the path and the file's bytes are given back here: a streamed world reads proxies for as long as it runs)
export function hlod_load(dir: string, cx: int, cz: int) -> HlodMesh {
  let path = cell_path(dir, cx, cz, "lwh")
  if not Fs.exists(path) {
    free(path)
    return null
  }
  let b = Fs.read_bytes(path)
  free(path)
  let m = hlod_decode(b)
  if b != null { free(b) }
  return m
}

# a proxy mesh given back once it is uploaded: its arrays and itself
export function hlod_mesh_free(m: HlodMesh) -> void {
  if m == null { return }
  if m.vtx != null { free(m.vtx) }
  if m.idx != null { free(m.idx) }
  free(m)
}

# Bake every cell a content directory holds into `out_dir`, and write the index beside it: what the dev tool does
# (tools/hlod_bake.ludic). Returns how many cells it baked. `dir_in` holds cell_<cx>_<cz>.lwc files.
@alloc_ok("a bake: one mesh a cell")
export function hlod_bake_dir(dir_in: string, out_dir: string, kits: []RenderKit, size: float, cluster_m: float, height_band: float, max_growth: float) -> int {
  return hlod_bake_dir_parts(dir_in, out_dir, kits, null, size, cluster_m, height_band, max_growth)
}

# the same with some kits drawn as their parts (hlod_bake_parts)
export function hlod_bake_dir_parts(dir_in: string, out_dir: string, kits: []RenderKit, parts: []floats, size: float, cluster_m: float, height_band: float, max_growth: float) -> int {
  let names = Fs.list(dir_in)
  if names == null { return 0 }
  let ix = cell_index_new(size)
  var baked = 0
  for i in 0 .. len(names) {
    let f = names[i]
    if not Text.ends_with(f, ".lwc") { continue }
    let b = Fs.read_bytes(`{dir_in}/{f}`)
    let c = cell_decode(b)
    if c == null { continue }
    let m = hlod_new(c.cx, c.cz, c.size, max(c.n, 1))
    hlod_bake_parts(c, kits, parts, cluster_m, height_band, max_growth, m)
    if m.boxes > 0 { hlod_save(out_dir, m) }
    var hb = 0
    if m.boxes > 0 { hb = hlod_bytes(m) }
    cell_index_set(ix, c.cx, c.cz, c.n, len(b), hb)
    baked += 1
  }
  if baked > 0 { cell_index_save(out_dir, ix) }
  return baked
}
