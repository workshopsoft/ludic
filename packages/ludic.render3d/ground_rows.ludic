# ground_rows.ludic — what a designer says over the painted ground, as a map's own rows beside its ground_layers.lres:
# clearings (areas and strips the trampled layers thin inside), edits to grown solid things by their id, and hero
# things placed by hand. Paint stays the forest; a row exists only where someone said something. The editor reads them.

# a point of an outline, world metres
export property GroundPt {
  @Unit("m") x: float = 0.0
  @Unit("m") z: float = 0.0
}

# an area kept clear: inside the polygon a trampled layer's chance is `floor`, back to full `feather` past its edge
export property GroundClearing {
  key: string = ""
  points: []GroundPt = null                        # a closed polygon, 3 or more points
  @Unit("m") @Range(0, 100) feather: float = 2.0   # how far past the edge the chance is back to full
  @Range(0, 1) floor: float = 0.0                  # the chance left inside (0: nothing grows)
  layers: []string = null                          # which layers it thins: "scatter" (not solid), "solid" (trees, rocks, ...), "blades" (the GPU grass); none named: all
}

@PerMap @ByKey
export registry GroundClearings of GroundClearing from "ground_clearings.lres"

# a strip kept clear along a centre line (a trail): `floor` within width / 2 of it, back to full `feather` farther
export property GroundStrip {
  key: string = ""
  points: []GroundPt = null                        # the centre line, 2 or more points in order
  @Unit("m") @Range(0, 100) width: float = 2.0     # the cleared width
  @Unit("m") @Range(0, 100) feather: float = 1.5
  @Range(0, 1) floor: float = 0.0
}

@PerMap @ByKey
export registry GroundStrips of GroundStrip from "ground_strips.lres"

# one grown solid thing changed: named by the id the generator grows it under (ground_solid_id: its layer, chunk and
# cell), and said as how it differs from what grew. An edit whose thing no longer grows is said once at the map's load
export property GroundEdit {
  key: string = ""
  id: int = -1                                     # the thing's id
  remove: bool = false                             # gone from the map
  @Unit("m") @Range(-64, 64) dx: float = 0.0       # moved this far
  @Unit("m") @Range(-64, 64) dz: float = 0.0
  @Unit("deg") @Range(-360, 360) turn: float = 0.0 # turned this far from its own yaw
  @Range(0.05, 10) resize: float = 1.0             # its own size times this
  @Ref(GroundKinds) kind: int = -1                 # grown as this kind instead (-1: its layer's own)
}

@PerMap @ByKey
export registry GroundEdits of GroundEdit from "ground_edits.lres"

# a solid thing placed by hand: drawn, stood and listed with the layer that grows its kind, in the chunk it is in
export property GroundHero {
  key: string = ""
  @Ref(GroundKinds) kind: int = 0
  @Unit("m") x: float = 0.0
  @Unit("m") z: float = 0.0
  @Unit("deg") yaw: float = 0.0
  @Range(0.05, 10) scale: float = 1.0
}

@PerMap @ByKey
export registry GroundHeroes of GroundHero from "ground_heroes.lres"

# the map's clearings and strips handed over in place of what was held (areas in their rows' order, then strips);
# how many were taken - a row past GD_CLEAR_MAX, or with too few points, is said and left out
export function ground_clearings_use(render3d_st: mut Render3dState, areas: GroundClearings, strips: GroundStrips) -> int {
  r3d_ground_clearings_reset(render3d_st)
  var n = 0
  for i in 0 .. len(areas.rows) {
    let r = areas.rows[i]
    if r3d_ground_clearing_area(render3d_st, r.points, r.feather, r.floor) {
      r3d_ground_clearing_only(render3d_st, gr_mask(r.layers))
      n += 1
    } else { gr_say(r.key) }
  }
  for i in 0 .. len(strips.rows) {
    let r = strips.rows[i]
    if r3d_ground_clearing_strip(render3d_st, r.points, r.width * 0.5, r.feather, r.floor) { n += 1 } else { gr_say(r.key) }
  }
  return n
}

# the classes a row's `layers` name, added up (none named, or none known: all)
export function gr_mask(layers: []string) -> int {
  if layers == null { return GC_ALL }
  var m = 0
  for i in 0 .. len(layers) {
    if layers[i] == "scatter" { m = m | GC_SCATTER }
    if layers[i] == "solid" { m = m | GC_SOLID }
    if layers[i] == "blades" { m = m | GC_BLADES }
  }
  if m == 0 { return GC_ALL }
  return m
}

function gr_say(key: string) -> void { print(`ground: clearing {key} left out (too few points, or past {GD_CLEAR_MAX} clearings)`) }
