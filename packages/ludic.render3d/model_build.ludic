# model_build.ludic - a model made in code: the vertices, their colours and the triangles of a shape a game works out itself (a muzzle's star, a
# decal laid on the triangles of a wall, a streak) become a Model the actor pass draws like one read from a glTF. One primitive, in the plain
# white material (rough, not metal), so an actor's tint is its colour and the vertex colour shapes it (and, for a blended actor, its alpha).
# A game reaches the GPU only through this: it holds no pointers. model_release gives the mesh and the model back.

# v: 8 numbers a vertex (position, normal, uv); c: 4 a vertex (r, g, b, a: multiplied into the base colour and the alpha), or null for white;
# ix: the triangles' corners; radius: how far the shape reaches from its origin (culling reads it)
@alloc_ok("a model made by the program that asks for it: a load, not a frame")
@creates(Model)
function model_from_arrays(render3d_st: mut Render3dState, v: floats, c: floats, nv: int, ix: words, ni: int, radius: float) -> Model {
  if render3d_st.gltf_white == 0 {
    render3d_st.gltf_white = tex_solid(render3d_st, 200, 200, 200, 255)
    render3d_st.gltf_flat = tex_solid(render3d_st, 128, 128, 255, 255)
  }
  if render3d_st.gltf_pure == 0 { render3d_st.gltf_pure = tex_solid(render3d_st, 255, 255, 255, 255) }
  let m = gpu_mesh_new(render3d_st)
  gpu_mesh_vertices(render3d_st, m, data_of(v), nv * 32, GPU_STATIC)
  gpu_mesh_attr(render3d_st, m, 0, 3, GPU_F32, 32, 0, false)
  gpu_mesh_attr(render3d_st, m, 1, 3, GPU_F32, 32, 12, false)
  gpu_mesh_attr(render3d_st, m, 2, 2, GPU_F32, 32, 24, false)
  if c != null {
    gpu_mesh_vertices(render3d_st, m, data_of(c), nv * 16, GPU_STATIC)
    gpu_mesh_attr(render3d_st, m, 7, 4, GPU_F32, 16, 0, false)
  }
  gpu_mesh_indices(render3d_st, m, data_of(ix), ni * 4, 4)
  m.count = ni
  gpu_mesh_done(render3d_st, m)
  let pr = new Prim
  pr.mesh = m
  pr.verts = nv
  pr.skin4 = true
  pr.diff = render3d_st.gltf_pure
  pr.nrm = render3d_st.gltf_flat
  pr.arm = render3d_st.gltf_pure
  pr.fac = floats(9)
  for k in 0 .. 6 { pr.fac[k] = 1.0 }
  pr.fac[5] = 0.0
  for k in 6 .. 9 { pr.fac[k] = 0.0 }
  let model = new Model
  model.prims = new []Prim
  push(model.prims, pr)
  model.tris = ni / 3
  model.radius = radius
  model.height = radius
  model_box_of(model, v, nv)
  return model
}

# the buffers handed to model_from_arrays, given back: the model copied them to the GPU and keeps none (c may be null)
export function model_arrays_free(v: floats, c: floats, ix: words) -> void {
  unsafe {
    free(v)
    if c != null { free(c) }
    free(ix)
  }
}

# ---- a model's box (Model.has_box, bx0 .. bz1: static_chunks.ludic culls by it) -----------------------------------------------------------
# empty: the next grow sets it
function model_box_reset(m: Model) -> void {
  m.has_box = false
  m.bx0 = 0.0;  m.by0 = 0.0;  m.bz0 = 0.0;  m.bx1 = 0.0;  m.by1 = 0.0;  m.bz1 = 0.0
}
# grown to hold the box (x0, y0, z0) .. (x1, y1, z1)
function model_box_grow(m: Model, x0: float, y0: float, z0: float, x1: float, y1: float, z1: float) -> void {
  if not m.has_box {
    m.has_box = true
    m.bx0 = x0;  m.by0 = y0;  m.bz0 = z0;  m.bx1 = x1;  m.by1 = y1;  m.bz1 = z1
    return
  }
  m.bx0 = Math.min(m.bx0, x0);  m.by0 = Math.min(m.by0, y0);  m.bz0 = Math.min(m.bz0, z0)
  m.bx1 = Math.max(m.bx1, x1);  m.by1 = Math.max(m.by1, y1);  m.bz1 = Math.max(m.bz1, z1)
}
# from model_from_arrays' vertices (8 numbers a vertex, its position first)
function model_box_of(m: Model, v: floats, nv: int) -> void {
  model_box_reset(m)
  for i in 0 .. nv {
    let o = i * 8
    model_box_grow(m, v[o], v[o + 1], v[o + 2], v[o], v[o + 1], v[o + 2])
  }
}
# a game that merges models' primitives into one (a chunk's parts) grows the one's box by each other's: false when either has none
export function model_box_union(dst: Model, src: Model) -> bool {
  if dst == null or src == null or not src.has_box { return false }
  if not dst.has_box { return false }
  model_box_grow(dst, src.bx0, src.by0, src.bz0, src.bx1, src.by1, src.bz1)
  return true
}

# Fill a model made by model_from_arrays again, in the same buffers and with no new memory: a decal's shape changes with the wall it lands on, and a
# game that must not grow in play (the alloc fence) makes its models once, at their largest, and refills one for each new shape. The new shape may be
# smaller than the one the model was made with (the vertex and index counts), never larger. A buffer a frame still on the GPU reads is not written
# under it (gvk_buf_upload gives the busy buffer its second one). False when the model is not one of these or the shape does not fit.
function model_set_arrays(render3d_st: mut Render3dState, m: Model, v: floats, c: floats, nv: int, ix: words, ni: int) -> bool {
  if m == null or m.prims == null or len(m.prims) != 1 { return false }
  let pr = m.prims[0]
  if pr.packed { return false }
  let me = pr.mesh
  if me == null or me.n_vbufs < 1 or me.ebo == 0 { return false }
  if nv * 32 > render3d_st.gvk_buf_size[me.vbufs[0]] or ni * 4 > render3d_st.gvk_buf_size[me.ebo] { return false }
  if c != null and (me.n_vbufs < 2 or nv * 16 > render3d_st.gvk_buf_size[me.vbufs[1]]) { return false }
  gvk_buf_upload(render3d_st, me.vbufs[0], nv * 32, data_of(v))
  if c != null { gvk_buf_upload(render3d_st, me.vbufs[1], nv * 16, data_of(c)) }
  gvk_buf_upload(render3d_st, me.ebo, ni * 4, data_of(ix))
  me.count = ni
  pr.verts = nv
  m.tris = ni / 3
  model_box_of(m, v, nv)
  return true
}

# A model of several primitives made in code, each its own material (a building chunk's walls, trims, glass and roofs: textured):
# model_new_empty, then model_add_prim a material, then model_finish with its bounds. A primitive's v: 8 numbers a vertex (position,
# normal, uv), c: 4 (multiplied into its base colour) or null; diff / nrm / arm: its textures (0: plain white, flat normal, plain ARM);
# fac: base r g b a, roughness, metallic, emissive r g b (9), or null for all 1 and no emission. The arrays are copied to the GPU.
@alloc_ok("a model made by the program that asks for it: a load, not a frame")
export function model_new_empty(radius: float, height: float) -> Model {
  let model = new Model
  model.prims = new []Prim
  model.tris = 0
  model.radius = radius
  model.height = height
  return model
}

# A primitive's vertices as the GPU keeps them, packed as Unreal's static meshes are (FPackedNormal: a normal in 8 bits a component):
# position and uv as floats, the normal four signed bytes: 24 bytes a vertex, not 32. Its colour, when every channel is inside 0 .. 1,
# four bytes (not 16); one outside (an emissive tint) keeps its floats. Its triangles 16-bit when it has under 65 536 vertices. A building
# chunk's merge held 818 MB of the island's 3.3 GB of video memory in the 8-float layout (2026-11-07).
@alloc_ok("a model made by the program that asks for it: a load, not a frame")
function mb_upload_packed(render3d_st: mut Render3dState, m: Mesh, v: floats, c: floats, nv: int, ix: words, ni: int) -> void {
  let pk = words(nv * 6)
  for i in 0 .. nv {
    let o = i * 8
    let w = i * 6
    pk[w] = float_bits(v[o]);  pk[w + 1] = float_bits(v[o + 1]);  pk[w + 2] = float_bits(v[o + 2])
    pk[w + 3] = mb_snorm8(v[o + 3]) | (mb_snorm8(v[o + 4]) << 8) | (mb_snorm8(v[o + 5]) << 16)
    pk[w + 4] = float_bits(v[o + 6]);  pk[w + 5] = float_bits(v[o + 7])
  }
  gpu_mesh_vertices(render3d_st, m, data_of(pk), nv * 24, GPU_STATIC)
  free(pk)
  gpu_mesh_attr(render3d_st, m, 0, 3, GPU_F32, 24, 0, false)
  gpu_mesh_attr(render3d_st, m, 1, 4, GPU_I8, 24, 12, true)
  gpu_mesh_attr(render3d_st, m, 2, 2, GPU_F32, 24, 16, false)
  if c != null {
    var unit = true
    for k in 0 .. nv * 4 { if c[k] < 0.0 or c[k] > 1.0 { unit = false } }
    if unit {
      let pc = words(nv)
      for i in 0 .. nv { pc[i] = mb_unorm8(c[i * 4]) | (mb_unorm8(c[i * 4 + 1]) << 8) | (mb_unorm8(c[i * 4 + 2]) << 16) | (mb_unorm8(c[i * 4 + 3]) << 24) }
      gpu_mesh_vertices(render3d_st, m, data_of(pc), nv * 4, GPU_STATIC)
      free(pc)
      gpu_mesh_attr(render3d_st, m, 7, 4, GPU_U8, 4, 0, true)
    } else {
      gpu_mesh_vertices(render3d_st, m, data_of(c), nv * 16, GPU_STATIC)
      gpu_mesh_attr(render3d_st, m, 7, 4, GPU_F32, 16, 0, false)
    }
  }
  if nv <= 65536 {
    let ps = words((ni + 1) / 2)
    for k in 0 .. (ni + 1) / 2 {
      var hi = 0
      if k * 2 + 1 < ni { hi = ix[k * 2 + 1] }
      ps[k] = (ix[k * 2] & 0xFFFF) | (hi << 16)
    }
    gpu_mesh_indices(render3d_st, m, data_of(ps), ni * 2, 2)
    free(ps)
  } else {
    gpu_mesh_indices(render3d_st, m, data_of(ix), ni * 4, 4)
  }
}
# -1 .. 1 as a signed byte's bits (two's complement, 0 .. 255), rounded to the nearest of -127 .. 127
function mb_snorm8(x: float) -> int {
  let q = int(Math.floor(Math.clamp(x, -1.0, 1.0) * 127.0 + 0.5))
  return q & 0xFF
}
# 0 .. 1 as an unsigned byte, rounded
function mb_unorm8(x: float) -> int { return int(Math.floor(Math.clamp(x, 0.0, 1.0) * 255.0 + 0.5)) }

@alloc_ok("a model made by the program that asks for it: a load, not a frame")
export function model_add_prim(render3d_st: mut Render3dState, model: Model, v: floats, c: floats, nv: int, ix: words, ni: int, name: string, diff: int, nrm: int, arm: int, fac: floats) -> void {
  if nv <= 0 or ni <= 0 { return }
  if render3d_st.gltf_white == 0 {
    render3d_st.gltf_white = tex_solid(render3d_st, 200, 200, 200, 255)
    render3d_st.gltf_flat = tex_solid(render3d_st, 128, 128, 255, 255)
  }
  if render3d_st.gltf_pure == 0 { render3d_st.gltf_pure = tex_solid(render3d_st, 255, 255, 255, 255) }
  let m = gpu_mesh_new(render3d_st)
  mb_upload_packed(render3d_st, m, v, c, nv, ix, ni)
  m.count = ni
  gpu_mesh_done(render3d_st, m)
  let pr = new Prim
  pr.mesh = m
  pr.verts = nv
  pr.packed = true
  pr.skin4 = true
  # (`name` is not kept: model_release frees a primitive's name as its own copy, and a caller's string is not one)
  pr.diff = render3d_st.gltf_pure
  pr.nrm = render3d_st.gltf_flat
  pr.arm = render3d_st.gltf_pure
  if diff != 0 { pr.diff = diff }
  if nrm != 0 { pr.nrm = nrm }
  if arm != 0 { pr.arm = arm }
  pr.fac = floats(9)
  for k in 0 .. 9 { pr.fac[k] = 1.0 }
  for k in 5 .. 9 { pr.fac[k] = 0.0 }
  if fac != null { for k in 0 .. 9 { pr.fac[k] = fac[k] } }
  push(model.prims, pr)
  model.tris += ni / 3
}

# the last primitive added lit by a material parameter collection scalar (mpc.ludic), its emission its base colour times its factor's
# emissive r g b times that scalar - the glTF extras "emissive_param" + "emissive_from_base" for a primitive made in code (a building's lit
# windows on "night_lamps")
# (from_base false: its emission is the factor's colour alone, masked by its ARM alpha - a lamp's light in a far window, not the glass)
export function model_prim_lit_by(render3d_st: mut Render3dState, model: Model, param: string, from_base: bool) -> void {
  let n = len(model.prims)
  if n == 0 { return }
  let pr = model.prims[n - 1]
  pr.emis_param = r3d_mpc_scalar(render3d_st, param)
  pr.emis_base = from_base
}

# its bounds from two corners (8 numbers a corner, as a vertex: only the positions are read)
export function model_finish(model: Model, corners: floats) -> void { model_box_of(model, corners, 2) }

# a texture from a PNG file, for a model made in code (srgb for colour, not for normals or ARM); 0 when it will not load
export function model_texture(render3d_st: mut Render3dState, path: string, srgb: bool) -> int { return tex_load(render3d_st, path, srgb) }
# whether model_texture(path) has something to load: the PNG, or what a shipped build carries in its place - the .dds beside it
# (texture_dds.ludic) or a cut-out padded at build time (baked_tex.ludic). A pack may hold only those, so a "is this map there"
# question about a texture is asked here, not of Fs.exists
@alloc_ok("a load: the names asked after, made and let go")
export function model_texture_exists(path: string) -> bool {
  if Fs.exists(path) { return true }
  var ok = false
  let d = dds_path_of(path)
  if len(d) > 0 {
    ok = Fs.exists(d)
    free(d)
  }
  if not ok {
    let b = baked_tex_path(path, "cutouts", ".bc7")
    if b != "" {
      ok = Fs.exists(b)
      free(b)
    }
  }
  return ok
}

# a game's own buffers given back (a merge's arrays once their model holds them on the GPU, a file's bytes once read): a game reaches
# no raw memory, so these are its way to free what floats(), words(), Fs.read_bytes and its lists of them made
export function model_floats_free(f: floats) -> void { if f != null { free(f) } }
export function model_words_free(w: words) -> void { if w != null { free(w) } }
export function model_bytes_free(b: []byte) -> void { if b != null { free(b) } }
export function model_floats_list_free(l: []floats) -> void {
  if l == null { return }
  for i in 0 .. len(l) { if l[i] != null { free(l[i]) } }
  free(l)
}
export function model_words_list_free(l: []words) -> void {
  if l == null { return }
  for i in 0 .. len(l) { if l[i] != null { free(l[i]) } }
  free(l)
}
