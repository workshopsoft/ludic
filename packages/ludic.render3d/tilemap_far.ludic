# ============================================================================
# tilemap_far.ludic - the far ground: past the patches a TileDraw draws (tilemap_draw.ludic, a radius of full detail), each tile
# within a far radius is merged at its patches' coarsest baked level, and the tiles of a TMF_GROUP x TMF_GROUP block (a group) are
# ONE actor and one draw, so the ground reaches as far as a game draws its far proxies without an actor a patch (a 4 km radius of
# 128 m patches is three thousand) or a tile (a whole island's ~400 tiles walked, culled and drawn every frame, shadows too). A
# tile's merged mesh is kept on the CPU (its slot's buffers); a group whose tiles changed is put together again from them the same
# frame (copies, no reading of tables), so a tile made again costs one group's upload. A tile's far mesh
# holds exactly the patches the near draw does not hold now (a patch the near draw has not built yet included), so the two never
# overlap and nothing is missing at the seam; it is made again when that set changes, nearest first: a tile whose mesh lacks a patch
# the near draw no longer holds (a hole: the near draw let it go) on the same frame, up to `hole_budget` tiles, the others (the near
# draw took a patch the far mesh still has: drawn twice, never missing) `budget` tiles a frame. Its land use is the near draw's (the
# same masks, tones, steep tone and tint).
#
# The far tiles' tables (src.ms) are a pool as big as the reach: the tiles within reach are marked wanted each frame, so a tile that
# left gives its table to one that came in. A tile whose table cannot be read YET (tmm_load -1: the pool full of wanted tiles, or its
# levels still being made) is asked again a few frames on; only a tile with no file at all (-2) is never asked again. (Before
# 2026-11-08 the pool's clock never moved: once as many tiles as it holds had been seen, every new tile in reach was taken for one
# with no file and the ground past the near disc went missing for good wherever the player went next.)
#
#   let far = tmf_new(render3d_st, td, 4000.0)       # after tmd_new and the tones
#   each frame, after tmd_frame:  tmf_frame(render3d_st, far, cam_x, cam_z)
#   at the end, before tmd_free:  tmf_free(render3d_st, far)
#
# A frame allocates nothing once the buffers have grown to the largest tile and group: every group's mesh, model and primitive are made
# once (tmf_new); a rebuild refills them.
# ============================================================================
numbers float

export property TmFar {
  tile: int = -1                     # the tile it draws (tz * cols + tx), -1 none
  vb: floats = null                  # its merged mesh (about the tile's middle, heights over `lift`): vertices, colours, indices
  cb: floats = null
  ib: words = null
  nv: int = 0
  ni: int = 0
  y0: float = 0.0                    # its height range
  y1: float = 0.0
  built: bool = false                # made for the near draw's holdings in `near` (else made again)
  none: bool = false                 # the tile has no baked file: never asked again
  wait: int = 0                      # its table could not be read yet (tmm_load -1): not asked again before this frame (f.clock)
  nheld: int = 0                     # how many of its patches the near draw held when it was built
  used: int = 0                      # the frame it was last wanted
  cx: float = 0.0                    # its middle (world) and the height its vertices are given from
  cz: float = 0.0
  lift: float = 0.0
}

# a block of TMF_GROUP x TMF_GROUP tiles: one actor, its tiles' meshes put together
export property TmFarGroup {
  actor: Actor = null
  model: Model = null
  mesh: Mesh = null
  held: bool = false                 # the mesh holds buffers
  dirty: bool = false                # a tile of it changed: put together again this frame
  cx: float = 0.0                    # where its actor stands (world), and its cull radius
  cz: float = 0.0
  lift: float = 0.0
  radius: float = 0.0
}

export property TileFar {
  td: TileDraw = null                # the near draw
  src: TileDraw = null               # the far tiles' tables, masks and expansion (a draw that is never framed and holds no patch)
  radius: float = 0.0
  slots: []TmFar = null
  groups: []TmFarGroup = null        # per block of tiles (gz * gcols + gx)
  gcols: int = 0
  grows: int = 0
  slot_of: words = null              # per tile: the slot drawing it, -1 none
  near: words = null                 # per slot and patch: 1 where the near draw held the patch when the slot was built
  vb: floats = null                  # a group's mesh being put together: vertices (TM_VERT floats), colours (4), indices
  cb: floats = null
  ib: words = null
  budget: int = 2                    # tiles made again a frame (the near draw took patches: the far mesh draws them twice meanwhile)
  hole_budget: int = 8               # tiles with a hole (the near draw let a patch go the far mesh lacks, or never built) made again a frame, first
  clock: int = 0
  ox: float = 0.0
  oz: float = 0.0
  shown: int = 0                     # far groups on the stage now (actors)
  builds: int = 0
  waits: int = 0                     # builds put off: the tile's table not readable yet
  build_us: long = 0                 # the time the builds took, all time
}

const TMF_GROUP: int = 4             # tiles a group's side
const TMF_WAIT_FRAMES: int = 8         # a tile whose table cannot be read yet is asked again this many frames on
const TMF_BUILT: int = 1
const TMF_WAIT: int = 0
const TMF_NONE: int = -1

# the far ground over near draw `td`'s map out to `radius` metres from the camera
@alloc_ok("a map being opened: the far tiles' records, made once")
export function tmf_new(render3d_st: mut Render3dState, td: TileDraw, radius: float) -> TileFar {
  let f = new TileFar
  f.td = td
  f.radius = radius
  let tm = td.tm
  let a = Math.max(radius, 0.0) / tm.tile_size + 1.5
  let n = min(int(3.15 * a * a) + 4, tm.cols * tm.rows)
  let src = new TileDraw
  src.tm = tm
  src.ms = tmm_new(tm, n)
  src.color = td.color
  src.fac = td.fac
  tmk_init(src)
  src.mask_pattern = td.mask_pattern
  src.tones = td.tones
  src.tone_on = td.tone_on
  f.src = src
  f.slots = new []TmFar
  for s in 0 .. src.ms.mslots {
    let q = new TmFar
    q.vb = floats(0)
    q.cb = floats(0)
    q.ib = words(0)
    push(f.slots, q)
  }
  f.gcols = (tm.cols + TMF_GROUP - 1) / TMF_GROUP
  f.grows = (tm.rows + TMF_GROUP - 1) / TMF_GROUP
  f.groups = new []TmFarGroup
  for g in 0 .. f.gcols * f.grows {
    let e = new TmFarGroup
    e.mesh = gpu_mesh_new(render3d_st)
    e.model = tmd_model_of(render3d_st, td, e.mesh, 0, 0)
    push(f.groups, e)
  }
  f.near = words(src.ms.mslots * tm.patches * tm.patches)
  f.slot_of = words(tm.cols * tm.rows)
  for t in 0 .. tm.cols * tm.rows { f.slot_of[t] = -1 }
  f.vb = floats(0)
  f.cb = floats(0)
  f.ib = words(0)
  return f
}

# the group tile t is in
function tmf_group_of(f: TileFar, t: int) -> int {
  let cols = f.td.tm.cols
  return ((t / cols) / TMF_GROUP) * f.gcols + (t % cols) / TMF_GROUP
}

# a slot's tile let go: its mesh out of its group (put together again this frame)
function tmf_release(render3d_st: mut Render3dState, f: TileFar, q: TmFar) -> void {
  if q.ni > 0 and q.tile >= 0 { f.groups[tmf_group_of(f, q.tile)].dirty = true }
  q.nv = 0
  q.ni = 0
  q.built = false
}

# a group's actor off the stage, its buffers given back
function tmf_group_release(render3d_st: mut Render3dState, f: TileFar, e: TmFarGroup) -> void {
  if e.actor != null { actor_release(render3d_st, e.actor);  e.actor = null;  f.shown -= 1 }
  if e.held { gpu_mesh_free(render3d_st, e.mesh);  e.held = false }
}

export function tmf_free(render3d_st: mut Render3dState, f: TileFar) -> void {
  for s in 0 .. len(f.slots) {
    let q = f.slots[s]
    tmf_release(render3d_st, f, q)
    if q.tile >= 0 { f.slot_of[q.tile] = -1 }
    q.tile = -1
  }
  for g in 0 .. len(f.groups) {
    let e = f.groups[g]
    tmf_group_release(render3d_st, f, e)
    if e.model != null { model_release(render3d_st, e.model) }
    e.model = null
    e.mesh = null
    e.dirty = false
  }
}

# does the near draw hold patch k of tile t now?
function tmf_near_holds(f: TileFar, t: int, k: int) -> bool {
  let ms = f.td.ms
  let s = ms.slot_of[t]
  if s < 0 { return false }
  if ms.slot_tile[s] != t { return false }
  let p = f.td.patches[s * f.td.tm.patches * f.td.tm.patches + k]
  return p.tile == t and p.actor != null
}

# is slot s's mesh still what the near draw's holdings ask for?
function tmf_current(f: TileFar, s: int) -> bool {
  let q = f.slots[s]
  if not q.built { return false }
  # a tile the near draw has no table of holds none of its patches
  if f.td.ms.slot_of[q.tile] < 0 { return q.nheld == 0 }
  let pp = f.td.tm.patches * f.td.tm.patches
  for k in 0 .. pp {
    var h = 0
    if tmf_near_holds(f, q.tile, k) { h = 1 }
    if f.near[s * pp + k] != h { return false }
  }
  return true
}

# does slot s's mesh lack ground nothing else draws: never built, or a patch the near draw held when it was built and holds no more?
function tmf_holed(f: TileFar, s: int) -> bool {
  let q = f.slots[s]
  if not q.built { return true }
  if q.nheld == 0 { return false }
  let pp = f.td.tm.patches * f.td.tm.patches
  for k in 0 .. pp {
    if f.near[s * pp + k] == 1 and not tmf_near_holds(f, q.tile, k) { return true }
  }
  return false
}

# room for `nv` more vertices and `ni` more indices past (v, i) in the merged buffers, grown by doubling (and kept)
@alloc_ok("the far ground's merged buffers growing to the largest tile, once")
function tmf_room(f: TileFar, v: int, nv: int, i: int, ni: int) -> void {
  if (v + nv) * TM_VERT > len(f.vb) {
    let n = max((v + nv) * 2, 1024)
    let vb = floats(n * TM_VERT)
    let cb = floats(n * 4)
    for k in 0 .. v * TM_VERT { vb[k] = f.vb[k] }
    for k in 0 .. v * 4 { cb[k] = f.cb[k] }
    free(f.vb);  free(f.cb)
    f.vb = vb
    f.cb = cb
  }
  if i + ni > len(f.ib) {
    let ib = words(max((i + ni) * 2, 4096))
    for k in 0 .. i { ib[k] = f.ib[k] }
    free(f.ib)
    f.ib = ib
  }
}

# room for `nv` more vertices and `ni` more indices past (v, i) in slot q's buffers, grown by doubling (and kept)
@alloc_ok("a far tile's buffers growing to its mesh, once")
function tmf_slot_room(q: TmFar, v: int, nv: int, i: int, ni: int) -> void {
  if (v + nv) * TM_VERT > len(q.vb) {
    let n = max((v + nv) * 2, 256)
    let vb = floats(n * TM_VERT)
    let cb = floats(n * 4)
    for k in 0 .. v * TM_VERT { vb[k] = q.vb[k] }
    for k in 0 .. v * 4 { cb[k] = q.cb[k] }
    free(q.vb);  free(q.cb)
    q.vb = vb
    q.cb = cb
  }
  if i + ni > len(q.ib) {
    let ib = words(max((i + ni) * 2, 1024))
    for k in 0 .. i { ib[k] = q.ib[k] }
    free(q.ib)
    q.ib = ib
  }
}

# slot s's tile made again: every patch the near draw does not hold, at its coarsest level, into one mesh on one actor. TMF_BUILT;
# TMF_WAIT when its table cannot be read yet (asked again); TMF_NONE when the tile has no file (never asked again). Into the slot's
# own buffers, its group marked to be put together again
@alloc_ok("a far tile made again: the mask reader's buffers made the first time")
function tmf_build(render3d_st: mut Render3dState, f: TileFar, s: int) -> int {
  let td = f.td
  let src = f.src
  let tm = td.tm
  let q = f.slots[s]
  let t = q.tile
  let tx = t % tm.cols
  let tz = t / tm.cols
  let pp = tm.patches * tm.patches
  let lod = tm.lod_max
  src.steep_ny = td.steep_ny
  for c in 0 .. 3 { src.steep_color[c] = td.steep_color[c] }
  src.slope_class = td.slope_class            # tmd_slope_blend_set: the rock class drawn plain, the shader laying the rock by slope
  let ts = tmm_load(src.ms, tm, tx, tz)
  if ts == -1 { return TMF_WAIT }
  if ts < 0 { return TMF_NONE }
  # the tile's height range at that level: its actor's cull sphere and the height its vertices are given from
  var y0 = 1000000000.0
  var y1 = -1000000000.0
  let cell = tmap_patch_size(tm) / float(tm.patch_texels >> lod)
  for k in 0 .. pp {
    y0 = Math.min(y0, tmm_ymin(src.ms, tm, ts, k % tm.patches, k / tm.patches, lod) - (2.0 * cell + tm.skirt))
    y1 = Math.max(y1, tmm_ymax(src.ms, tm, ts, k % tm.patches, k / tm.patches, lod))
  }
  let lift = (y0 + y1) * 0.5
  let cx = tm.origin_x + (float(tx) + 0.5) * tm.tile_size
  let cz = tm.origin_z + (float(tz) + 0.5) * tm.tile_size
  var nv = 0
  var ni = 0
  q.nheld = 0
  for k in 0 .. pp {
    var h = 0
    if tmf_near_holds(f, t, k) { h = 1 }
    f.near[s * pp + k] = h
    q.nheld += h
    if h == 1 { continue }
    let px = k % tm.patches
    let pz = k / tm.patches
    if not tmm_patch(src.ms, tm, ts, tx, tz, px, pz, lod, lift) { continue }
    let coloured = tmk_colours(render3d_st, src, ts, tx, tz, px, pz, lod)
    let ms = src.ms
    tmf_slot_room(q, nv, ms.nv, ni, ms.ni)
    # the patch's vertices are about its own middle: moved to the tile's
    let dx = tmap_patch_cx(tm, tx, px) - cx
    let dz = tmap_patch_cz(tm, tz, pz) - cz
    for v in 0 .. ms.nv {
      let o = (nv + v) * TM_VERT
      for c in 0 .. TM_VERT { q.vb[o + c] = ms.vbuf[v * TM_VERT + c] }
      q.vb[o] = q.vb[o] + dx
      q.vb[o + 2] = q.vb[o + 2] + dz
      if coloured { for c in 0 .. 4 { q.cb[(nv + v) * 4 + c] = src.cbuf[v * 4 + c] } }
      else { q.cb[(nv + v) * 4] = td.color[0];  q.cb[(nv + v) * 4 + 1] = td.color[1];  q.cb[(nv + v) * 4 + 2] = td.color[2];  q.cb[(nv + v) * 4 + 3] = 1.0 }
    }
    for i in 0 .. ms.ni { q.ib[ni + i] = ms.ibuf[i] + nv }
    nv += ms.nv
    ni += ms.ni
  }
  q.built = true
  if ni > 0 or q.ni > 0 { f.groups[tmf_group_of(f, t)].dirty = true }
  q.nv = nv
  q.ni = ni
  q.y0 = y0;  q.y1 = y1
  q.cx = cx;  q.cz = cz;  q.lift = lift
  f.builds += 1
  return TMF_BUILT
}

# group g put together again from its tiles' meshes: one mesh about the middle of the tiles that have ground, on one actor (none
# when the near draw holds all of them)
function tmf_assemble(render3d_st: mut Render3dState, f: TileFar, g: int) -> void {
  let tm = f.td.tm
  let e = f.groups[g]
  e.dirty = false
  let gx = g % f.gcols
  let gz = g / f.gcols
  let half = tm.tile_size * 0.5
  var bx0 = 1000000000.0
  var bx1 = -1000000000.0
  var bz0 = 1000000000.0
  var bz1 = -1000000000.0
  var y0 = 1000000000.0
  var y1 = -1000000000.0
  var any = false
  for tz in gz * TMF_GROUP .. min(gz * TMF_GROUP + TMF_GROUP, tm.rows) {
    for tx in gx * TMF_GROUP .. min(gx * TMF_GROUP + TMF_GROUP, tm.cols) {
      let s = f.slot_of[tz * tm.cols + tx]
      if s < 0 { continue }
      let q = f.slots[s]
      if not q.built or q.ni == 0 { continue }
      any = true
      bx0 = Math.min(bx0, q.cx - half);  bx1 = Math.max(bx1, q.cx + half)
      bz0 = Math.min(bz0, q.cz - half);  bz1 = Math.max(bz1, q.cz + half)
      y0 = Math.min(y0, q.y0);  y1 = Math.max(y1, q.y1)
    }
  }
  if not any { tmf_group_release(render3d_st, f, e);  return }
  let cx = (bx0 + bx1) * 0.5
  let cz = (bz0 + bz1) * 0.5
  let hx = Math.max(bx1 - bx0, bz1 - bz0) * 0.5
  let r = Math.sqrt(2.0 * hx * hx + (y1 - y0) * (y1 - y0) * 0.25) + 1.0
  let lift = (y0 + y1) * 0.5 - r
  var nv = 0
  var ni = 0
  for tz in gz * TMF_GROUP .. min(gz * TMF_GROUP + TMF_GROUP, tm.rows) {
    for tx in gx * TMF_GROUP .. min(gx * TMF_GROUP + TMF_GROUP, tm.cols) {
      let s = f.slot_of[tz * tm.cols + tx]
      if s < 0 { continue }
      let q = f.slots[s]
      if not q.built or q.ni == 0 { continue }
      tmf_room(f, nv, q.nv, ni, q.ni)
      let dx = q.cx - cx
      let dy = q.lift - lift
      let dz = q.cz - cz
      for v in 0 .. q.nv {
        let o = (nv + v) * TM_VERT
        let i0 = v * TM_VERT
        for c in 0 .. TM_VERT { f.vb[o + c] = q.vb[i0 + c] }
        f.vb[o] = f.vb[o] + dx
        f.vb[o + 1] = f.vb[o + 1] + dy
        f.vb[o + 2] = f.vb[o + 2] + dz
        for c in 0 .. 4 { f.cb[(nv + v) * 4 + c] = q.cb[v * 4 + c] }
      }
      for i in 0 .. q.ni { f.ib[ni + i] = q.ib[i] + nv }
      nv += q.nv
      ni += q.ni
    }
  }
  tmf_fill(render3d_st, f, e, nv, ni)
  if e.actor == null {
    e.actor = actor_new_terrain(render3d_st, e.model, "terrain/far")     # the terrain pass's (terrain_pass.ludic)
    f.shown += 1
  } else { e.actor.model = e.model;  terrain_patch_changed(e.actor) }
  e.actor.tint[0] = 1.0;  e.actor.tint[1] = 1.0;  e.actor.tint[2] = 1.0
  e.actor.radius = r
  e.actor.occ_hx = hx + 0.5;  e.actor.occ_hy = (y1 - y0) * 0.5 + 0.5     # its occlusion test's box (occlusion.ludic)
  e.cx = cx;  e.cz = cz;  e.lift = lift;  e.radius = r
  actor_place(e.actor, cx - f.ox, lift, cz - f.oz, 0.0)
}

# the merged buffers into group q's mesh (the near draw's layout: position, normal, uv, and the land use's colour)
function tmf_fill(render3d_st: mut Render3dState, f: TileFar, q: TmFarGroup, nv: int, ni: int) -> void {
  tmd_textures(render3d_st)
  let m = q.mesh
  if q.held { gpu_mesh_free(render3d_st, m) }
  if not q.held {
    for i in 0 .. len(m.attrs) { m.attrs[i] = 0 }
    m.n_attrs = 0
    m.vk_layout = 0
  }
  m.cur_buf = 0
  let was = render3d_st.gvk_tag
  render3d_st.gvk_tag = VKM_TERRAIN
  gpu_mesh_vertices(render3d_st, m, data_of(f.vb), nv * TM_VERT * 4, GPU_STATIC)
  gpu_mesh_attr(render3d_st, m, 0, 3, GPU_F32, TM_VERT * 4, 0, false)
  gpu_mesh_attr(render3d_st, m, 1, 3, GPU_F32, TM_VERT * 4, 12, false)
  gpu_mesh_attr(render3d_st, m, 2, 2, GPU_F32, TM_VERT * 4, 24, false)
  gpu_mesh_vertices(render3d_st, m, data_of(f.cb), nv * 16, GPU_STATIC)
  gpu_mesh_attr(render3d_st, m, 7, 4, GPU_F32, 16, 0, false)
  gpu_mesh_indices(render3d_st, m, data_of(f.ib), ni * 4, 4)
  m.count = ni
  gpu_mesh_done(render3d_st, m)
  render3d_st.gvk_tag = was
  let pr = q.model.prims[0]
  pr.verts = nv
  pr.diff = render3d_st.gltf_pure;  pr.nrm = render3d_st.gltf_flat;  pr.arm = render3d_st.gltf_pure
  # the ground's surfaces again, as the near draw does (tmd_fill): the plain maps above took the grass's off while the primitive still
  # said it had surfaces, so lighting.glsl surfaceGround read the grass from a white texture and every far lawn drew as snow
  let td = f.td
  if td.surf_green != "" { surf_apply_ground(render3d_st.surf_lib, pr, td.surf_green, td.surf_paved);  surf_apply_sand(render3d_st.surf_lib, pr, td.surf_sand) }
  pr.gslope = td.gslope
  q.model.tris = ni / 3
  q.held = true
}

# One frame of the far ground, after the near draw's (tmd_frame, whose floating origin it follows): the tiles within the radius
# kept, the others let go, and the nearest `budget` whose mesh is not what the near draw's holdings ask for made again.
export function tmf_frame(render3d_st: mut Render3dState, f: TileFar, cam_x: float, cam_z: float) -> void {
  let td = f.td
  let tm = td.tm
  let sms = f.src.ms
  f.clock += 1
  sms.clock += 1                       # the tables' pool: the tiles within reach marked wanted below, the others free to go
  let dox = td.ox - f.ox
  let doz = td.oz - f.oz
  f.ox = td.ox;  f.oz = td.oz
  if dox != 0.0 or doz != 0.0 {
    for g in 0 .. len(f.groups) {
      let e = f.groups[g]
      if e.actor != null { actor_place(e.actor, e.cx - f.ox, e.lift, e.cz - f.oz, 0.0) }
    }
  }
  # the tiles within reach: the ones held kept, the others given a slot (a free one, else the one wanted longest ago)
  let tx0 = tmap_tile_x(tm, cam_x - f.radius)
  let tx1 = tmap_tile_x(tm, cam_x + f.radius)
  let tz0 = tmap_tile_z(tm, cam_z - f.radius)
  let tz1 = tmap_tile_z(tm, cam_z + f.radius)
  for tz in tz0 .. tz1 + 1 {
    for tx in tx0 .. tx1 + 1 {
      if tmap_tile_dist(tm, tx, tz, cam_x, cam_z) > f.radius { continue }
      let t = tz * tm.cols + tx
      var held = f.slot_of[t]
      if held < 0 {
        var take = -1
        for s in 0 .. len(f.slots) {
          let q = f.slots[s]
          if q.used != f.clock and (take < 0 or f.slots[take].tile >= 0 and (q.tile < 0 or q.used < f.slots[take].used)) { take = s }
        }
        if take < 0 { continue }
        let q = f.slots[take]
        tmf_release(render3d_st, f, q)
        if q.tile >= 0 { f.slot_of[q.tile] = -1 }
        q.tile = t
        q.none = false
        q.wait = 0
        f.slot_of[t] = take
        held = take
      }
      f.slots[held].used = f.clock
      if sms.slot_of[t] >= 0 { sms.slot_used[sms.slot_of[t]] = sms.clock }
    }
  }
  # the slots no tile within reach wants let go
  for s in 0 .. len(f.slots) {
    let q = f.slots[s]
    if q.tile >= 0 and q.used != f.clock {
      tmf_release(render3d_st, f, q)
      f.slot_of[q.tile] = -1
      q.tile = -1
    }
  }
  # the nearest stale ones made again: those with a hole first (this frame, so the near draw's let-go patches never leave the sea
  # showing), then the others
  let t0 = Time.now_us()
  var holes = 0
  var others = 0
  var tries = 0
  while holes < f.hole_budget or others < f.budget {
    var bi = -1
    var bd = 1000000000.0
    var bh = false
    for s in 0 .. len(f.slots) {
      let q = f.slots[s]
      if q.tile < 0 or q.none or q.wait > f.clock { continue }
      let d = tmap_tile_dist(tm, q.tile % tm.cols, q.tile / tm.cols, cam_x, cam_z)
      # (a hole outranks any other; among the same kind the nearest)
      if bh and d >= bd { continue }
      if tmf_current(f, s) { continue }
      let h = holes < f.hole_budget and tmf_holed(f, s)
      if not h and others >= f.budget { continue }
      if not h and (bh or d >= bd) { continue }
      bi = s;  bd = d;  bh = h
    }
    if bi < 0 { break }
    if bh { holes += 1 } else { others += 1 }
    tries += 1
    if tries > f.hole_budget + f.budget { break }
    let r = tmf_build(render3d_st, f, bi)
    let q = f.slots[bi]
    if r == TMF_WAIT { q.wait = f.clock + TMF_WAIT_FRAMES;  f.waits += 1 }
    if r == TMF_NONE {
      tmf_release(render3d_st, f, q)
      q.none = true
    }
  }
  # the groups whose tiles changed put together again (the same frame: a hole filled above never waits on its group)
  for g in 0 .. len(f.groups) { if f.groups[g].dirty { tmf_assemble(render3d_st, f, g) } }
  f.build_us += Time.now_us() - t0
}

# the far ground's books for a dev probe: slots holding a tile whose mesh is not what the near draw's holdings ask for, and of those
# the ones with a hole (ground nothing draws), the ones waiting for their table, and the tiles with no file
export function tmf_stale(f: TileFar) -> int {
  var n = 0
  for s in 0 .. len(f.slots) { if f.slots[s].tile >= 0 and not f.slots[s].none and not tmf_current(f, s) { n += 1 } }
  return n
}
export function tmf_holes(f: TileFar) -> int {
  var n = 0
  for s in 0 .. len(f.slots) { if f.slots[s].tile >= 0 and not f.slots[s].none and not tmf_current(f, s) and tmf_holed(f, s) { n += 1 } }
  return n
}
export function tmf_nones(f: TileFar) -> int {
  var n = 0
  for s in 0 .. len(f.slots) { if f.slots[s].tile >= 0 and f.slots[s].none { n += 1 } }
  return n
}
export function tmf_held(f: TileFar) -> int {
  var n = 0
  for s in 0 .. len(f.slots) { if f.slots[s].tile >= 0 { n += 1 } }
  return n
}
