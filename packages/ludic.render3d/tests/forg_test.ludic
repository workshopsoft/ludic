# forg_test.ludic - the floating origin's math, with no device: a rebase leaves every render-space number
# exactly its old value minus the shift, a camera pacing a boundary never rebases twice, render space keeps
# millimetres at 40 km where raw floats lose centimetres, and CellPos adds across cells without loss
import "ludic.render3d/forg.ludic"
program ForgTest {
  numbers float

  function noop_hook(dx: float, dy: float, dz: float) -> void { }

  test "the origin is a grid multiple, and the grid and threshold are fixed up" {
    let o = forg_new(300.0, 100.0)
    expect(o.grid == 512.0)                 # 300 -> the next power of two
    expect(o.threshold >= o.grid * 2.0)     # the band cannot be empty
    let o2 = forg_new(256.0, 4096.0)
    expect(o2.grid == 256.0 and o2.threshold == 4096.0)
  }

  test "render space is world minus origin, rounded once" {
    let o = forg_new(256.0, 1024.0)
    forg_reset(o, 12345.678, 0.0, -9876.5)
    expect(o.ox == 12288.0 and o.oz == -9984.0)
    let r = floats(3)
    forg_to_render(o, 12345.678, 10.25, -9876.5, r)
    expect_near(r[0], 57.678, 0.001)
    expect_near(r[2], 107.5, 0.001)
    expect(r[1] == 10.25)
    expect_near(float(forg_wx(o, r[0]) - 12345.678), 0.0, 0.001)
  }

  test "at 40 km render space keeps a millimetre; the raw float does not" {
    let o = forg_new(256.0, 1024.0)
    let wx: double = double(40000123) / 1000.0     # a literal under `numbers float` is a float: built from an int
    forg_reset(o, wx, 0.0, 0.0)
    let render = forg_rx(o, wx)             # 0.123 + (40000 - 39936 = 64) -> tiny
    let back = forg_wx(o, render)
    expect(Math.abs(back - wx) < 0.00001)
    let raw = float(wx)                     # what a float-only world holds
    expect(Math.abs(double(raw) - wx) > 0.0005)    # ~2 mm of rounding at this distance
  }

  test "a rebase moves every render number by exactly the shift" {
    let o = forg_new(256.0, 1024.0)
    forg_reset(o, 0.0, 0.0, 0.0)
    let p = floats(6)                        # two points' worth of x y z in render space
    let wx: double = 700.3125
    let wz: double = -200.0625
    p[0] = forg_rx(o, wx);  p[1] = 3.0;  p[2] = forg_rz(o, wz)
    p[3] = forg_rx(o, wx + 50.5);  p[4] = 4.0;  p[5] = forg_rz(o, wz - 12.25)
    expect(not forg_update(o, 800.0, 2.0, 0.0))            # within the threshold
    expect(forg_update(o, 1300.0, 2.0, 0.0))               # past it
    expect_eq(o.rebases, 1)
    expect(o.shift_x == 1280.0 and o.shift_z == 0.0)
    forg_shift_floats(p, 2, 3, o.shift_x, o.shift_y, o.shift_z)
    # the shifted numbers are what a fresh conversion gives, to the last bit
    expect(p[0] == forg_rx(o, wx) and p[2] == forg_rz(o, wz))
    expect(p[3] == forg_rx(o, wx + 50.5) and p[5] == forg_rz(o, wz - 12.25))
    expect(p[1] == 3.0 and p[4] == 4.0)
  }

  test "a camera pacing a boundary does not rebase back and forth" {
    let o = forg_new(256.0, 1024.0)
    forg_reset(o, 0.0, 0.0, 0.0)
    var x: double = 1000.0
    var dir: double = 1.0
    for step in 0 .. 4000 {
      forg_update(o, x, 0.0, 0.0)
      x = x + dir * 3.0
      if x > 1100.0 { dir = -1.0 }
      if x < 950.0 { dir = 1.0 }
    }
    expect(o.rebases <= 1)
    # and walking a long way rebases once per grid-worth, not every step
    let q = forg_new(256.0, 1024.0)
    forg_reset(q, 0.0, 0.0, 0.0)
    var moved = 0
    var wx: double = 0.0
    for i in 0 .. 20000 {
      wx = wx + 2.0                          # 40 km
      if forg_update(q, wx, 0.0, 0.0) { moved += 1 }
    }
    expect(moved > 20 and moved < 60)
    expect(Math.abs(wx - q.ox) <= q.threshold)
  }

  test "the camera is inside the band after a rebase, in every direction" {
    let o = forg_new(256.0, 1024.0)
    forg_reset(o, 0.0, 0.0, 0.0)
    expect(forg_update(o, -1500.0, 0.0, 2200.0))
    expect(Math.abs(-1500.0 - o.ox) <= o.grid * 0.5 and Math.abs(2200.0 - o.oz) <= o.grid * 0.5)
    expect(not forg_wants_rebase(o, -1500.0, 0.0, 2200.0))
    # height is left alone until it is far
    expect(o.oy == 0.0)
    expect(forg_update(o, -1500.0, 6000.0, 2200.0))
    expect(o.oy == 5888.0)
  }

  test "the hook hears the shift" {
    let o = forg_new(256.0, 1024.0)
    forg_on(o, fn noop_hook)
    forg_reset(o, 0.0, 0.0, 0.0)
    expect(forg_update(o, 5000.0, 0.0, 0.0))
    expect(o.serial == 2)                    # the reset and the rebase
  }

  test "CellPos: from world, and back, exactly for power-of-two cells" {
    let p = new CellPos
    cellpos_from_world(p, 40000.5, 12.0, -130.25, 128.0)
    expect_eq(p.cx, 312)
    expect(p.x == 64.5)
    expect_eq(p.cz, -2)
    expect(p.z == 125.75 and p.y == 12.0)
    let q = new CellPos
    cellpos_from_world(q, 40100.5, 14.0, -100.25, 128.0)
    let d = floats(3)
    cellpos_sub(q, p, 128.0, d)
    expect(d[0] == 100.0 and d[2] == 30.0 and d[1] == 2.0)
  }

  test "cellpos_add carries whole cells and keeps the offset inside" {
    let p = new CellPos
    cellpos_from_world(p, 10.0, 0.0, 10.0, 64.0)
    cellpos_add(p, -20.0, 0.0, 130.0, 64.0)
    expect_eq(p.cx, -1)
    expect(p.x == 54.0)
    expect_eq(p.cz, 2)
    expect(p.z == 12.0)
    expect(p.x >= 0.0 and p.x < 64.0 and p.z >= 0.0 and p.z < 64.0)
    let o = forg_new(256.0, 1024.0)
    forg_reset(o, 0.0, 0.0, 0.0)
    expect(cell_render_x(o, 4, 64.0) == 256.0)
  }
}
