# shadow_splits_test.ludic - the sun's cascades without a device: Unreal's GetSplitDistance for its default four and for the five the
# renderer draws (DynamicShadowCascades 5, exponent 3, 400 m), and the shadow cache's split into live and cached cascades.
import "ludic.render3d/r3d.ludic"
program ShadowSplitsTest {
  numbers float
  function links_runtime() -> bool { return Input.key_pressed(0) }

  test "five cascades split the 400 m by 1, 3, 9, 27 and 81 parts of 121: 3.3, 13, 43, 133 and 400 m" (render3d_st: mut Render3dState) {
    render3d_st.sh_split = floats(SHADOW_CASCADES)
    render3d_st.sh_ue = -1
    shadow_ue_splits(render3d_st, 0.0)
    expect_near(render3d_st.sh_split[0], 400.0 / 121.0, 0.001)
    expect_near(render3d_st.sh_split[1], 400.0 * 4.0 / 121.0, 0.001)
    expect_near(render3d_st.sh_split[2], 400.0 * 13.0 / 121.0, 0.001)
    expect_near(render3d_st.sh_split[3], 400.0 * 40.0 / 121.0, 0.001)
    expect_near(render3d_st.sh_split[4], 400.0, 0.001)
    expect(render3d_st.sh_split[5] > 100000.0)
    expect(shadow_ue_count(render3d_st) == 5)
  }

  test "R3D_UE_CSM_CASCADES=4 is Unreal's default: about 10, 40, 130 and 400 m" (render3d_st: mut Render3dState) {
    render3d_st.sh_split = floats(SHADOW_CASCADES)
    render3d_st.sh_ue = 1
    render3d_st.sh_ue_n = 4
    shadow_ue_splits(render3d_st, 0.0)
    expect_near(render3d_st.sh_split[0], 10.0, 0.001)
    expect_near(render3d_st.sh_split[1], 40.0, 0.001)
    expect_near(render3d_st.sh_split[2], 130.0, 0.001)
    expect_near(render3d_st.sh_split[3], 400.0, 0.001)
    expect(render3d_st.sh_split[4] > 100000.0)
  }

  test "the near plane moves every split by its share of what is left" (render3d_st: mut Render3dState) {
    render3d_st.sh_split = floats(SHADOW_CASCADES)
    render3d_st.sh_ue = 1
    render3d_st.sh_ue_n = 4
    shadow_ue_splits(render3d_st, 0.1)
    expect_near(render3d_st.sh_split[0], 0.1 + 0.025 * 399.9, 0.001)
    expect_near(render3d_st.sh_split[3], 400.0, 0.001)
  }
}
