# oimp_test.ludic - octahedral impostor math: encode and decode are inverses, every frame's own capture direction picks
# that frame with weight one, blends are barycentric and continuous, frame rects tile the atlas, the capture basis is
# orthonormal and continuous through the pole, yaw is taken out of the view direction as the renderer puts it in
import "ludic.render3d/bigworld.ludic"
program OImpTest {
  numbers float

  test "encode and decode are inverses over the hemisphere" {
    let uv = floats(2)
    let d = floats(3)
    var worst = 0.0
    for a in 0 .. 36 {
      for e in 1 .. 10 {
        let az = float(a) * 10.0 * PI / 180.0
        let el = float(e) * 9.0 * PI / 180.0
        let x = Math.cos(el) * Math.sin(az)
        let y = Math.sin(el)
        let z = Math.cos(el) * Math.cos(az)
        oimp_encode(x, y, z, uv)
        expect(uv[0] >= 0.0 and uv[0] <= 1.0 and uv[1] >= 0.0 and uv[1] <= 1.0)
        oimp_decode(uv[0], uv[1], d)
        worst = Math.max(worst, Math.abs(d[0] - x) + Math.abs(d[1] - y) + Math.abs(d[2] - z))
      }
    }
    expect(worst < 0.0001)
    # the pole is the middle, the horizon the diamond's edge
    oimp_encode(0.0, 1.0, 0.0, uv)
    expect_near(uv[0], 0.5, 0.0001)
    expect_near(uv[1], 0.5, 0.0001)
    oimp_encode(1.0, 0.0, 0.0, uv)
    expect_near(Math.abs(uv[0] - 0.5) + Math.abs(uv[1] - 0.5), 1.0, 0.0001)
    # a direction below the ground is clamped to the horizon, not wrapped
    oimp_encode(0.6, -0.8, 0.0, uv)
    expect(uv[0] >= 0.0 and uv[0] <= 1.0)
  }

  test "a frame's capture direction picks that frame with weight one" {
    let n = 8
    let d = floats(3)
    let w = floats(3)
    let ij = words(3)
    for j in 0 .. n {
      for i in 0 .. n {
        oimp_capture_dir(n, i, j, d)
        oimp_pick(n, d[0], d[1], d[2], ij, w)
        var got = 0.0
        for t in 0 .. 3 { if ij[t] == j * n + i { got = got + w[t] } }
        expect_near(got, 1.0, 0.001)
      }
    }
  }

  test "weights sum to one, are never negative, and the three frames surround the direction" {
    let n = 6
    let w = floats(3)
    let ij = words(3)
    let uv = floats(2)
    var bad = 0
    for a in 0 .. 72 {
      for e in 0 .. 12 {
        let az = float(a) * 5.0 * PI / 180.0
        let el = (float(e) * 7.0 + 1.0) * PI / 180.0
        let x = Math.cos(el) * Math.sin(az)
        let y = Math.sin(el)
        let z = Math.cos(el) * Math.cos(az)
        oimp_pick(n, x, y, z, ij, w)
        if Math.abs(w[0] + w[1] + w[2] - 1.0) > 0.001 { bad += 1 }
        if w[0] < -0.001 or w[1] < -0.001 or w[2] < -0.001 { bad += 1 }
        # the weighted grid position is the direction's own
        oimp_encode(x, y, z, uv)
        var gx = 0.0
        var gy = 0.0
        for t in 0 .. 3 {
          gx = gx + w[t] * float(ij[t] % n)
          gy = gy + w[t] * float(ij[t] / n)
        }
        if Math.abs(gx - uv[0] * float(n - 1)) > 0.001 or Math.abs(gy - uv[1] * float(n - 1)) > 0.001 { bad += 1 }
      }
    }
    expect_eq(bad, 0)
  }

  test "the blend is continuous: a small turn changes the weights a little, even across a triangle's edge" {
    let n = 8
    let w0 = floats(3)
    let w1 = floats(3)
    let i0 = words(3)
    let i1 = words(3)
    var worst = 0.0
    for a in 0 .. 360 {
      let az = float(a) * PI / 180.0
      let az2 = az + 0.002
      let el = 0.6
      oimp_pick(n, Math.cos(el) * Math.sin(az), Math.sin(el), Math.cos(el) * Math.cos(az), i0, w0)
      oimp_pick(n, Math.cos(el) * Math.sin(az2), Math.sin(el), Math.cos(el) * Math.cos(az2), i1, w1)
      # the weight each frame carries, by frame, before and after
      for t in 0 .. 3 {
        var after = 0.0
        for s in 0 .. 3 { if i1[s] == i0[t] { after = w1[s] } }
        worst = Math.max(worst, Math.abs(after - w0[t]))
      }
    }
    expect(worst < 0.05)
  }

  test "frame rects tile the atlas exactly, and the atlas uv stays half a texel inside" {
    let n = 4
    let r = floats(4)
    var area = 0.0
    for f in 0 .. n * n {
      oimp_frame_rect(n, f, r)
      area = area + (r[2] - r[0]) * (r[3] - r[1])
    }
    expect_near(area, 1.0, 0.0001)
    oimp_frame_rect(n, 6, r)                     # frame (2, 1)
    expect_near(r[0], 0.5, 0.0001)
    expect_near(r[1], 0.25, 0.0001)
    let uv = floats(2)
    oimp_atlas_uv(n, 6, 0.0, 0.0, 128, uv)
    expect(uv[0] > r[0] and uv[1] > r[1])
    expect_near(uv[0] - r[0], 0.5 / 512.0, 0.00001)
    oimp_atlas_uv(n, 6, 1.0, 1.0, 128, uv)
    expect(uv[0] < r[2] and uv[1] < r[3])
    expect_near(r[2] - uv[0], 0.5 / 512.0, 0.00001)
    oimp_atlas_uv(n, 6, 2.0, -1.0, 128, uv)       # clamped
    expect(uv[0] < r[2] and uv[1] > r[1])
  }

  test "the capture basis is orthonormal, and continuous through the pole" {
    let r = floats(3)
    let u = floats(3)
    let d = floats(3)
    for a in 0 .. 12 {
      for e in 1 .. 10 {
        let az = float(a) * 30.0 * PI / 180.0
        let el = float(e) * 9.0 * PI / 180.0
        d[0] = Math.cos(el) * Math.sin(az)
        d[1] = Math.sin(el)
        d[2] = Math.cos(el) * Math.cos(az)
        oimp_basis(d[0], d[1], d[2], r, u)
        expect_near(r[0] * r[0] + r[1] * r[1] + r[2] * r[2], 1.0, 0.001)
        expect_near(u[0] * u[0] + u[1] * u[1] + u[2] * u[2], 1.0, 0.001)
        expect_near(r[0] * u[0] + r[1] * u[1] + r[2] * u[2], 0.0, 0.001)
        expect_near(r[0] * d[0] + r[1] * d[1] + r[2] * d[2], 0.0, 0.001)
        expect_near(u[0] * d[0] + u[1] * d[1] + u[2] * d[2], 0.0, 0.001)
        expect(u[1] >= -0.001)                      # up stays up (or along the axis)
      }
    }
    # straight down the axis: defined, orthonormal
    oimp_basis(0.0, 1.0, 0.0, r, u)
    expect_near(Math.abs(u[2]), 1.0, 0.001)
  }

  test "projecting into a frame's basis: the card's centre is the image's centre and the sphere stays inside" {
    let r = floats(3)
    let u = floats(3)
    let out = floats(2)
    let d = floats(3)
    oimp_decode(0.7, 0.3, d)
    oimp_basis(d[0], d[1], d[2], r, u)
    oimp_project(0.0, 0.0, 0.0, r, u, 25.0, out)
    expect_near(out[0], 0.5, 0.0001)
    expect_near(out[1], 0.5, 0.0001)
    # a point on the sphere (radius 25): inside the square
    for k in 0 .. 50 {
      let a = float(k) * 0.37
      let px = 25.0 * Math.sin(a) * Math.cos(a * 0.3)
      let py = 25.0 * Math.cos(a)
      let pz = 25.0 * Math.sin(a) * Math.sin(a * 0.3)
      oimp_project(px, py, pz, r, u, 25.0, out)
      expect(out[0] >= -0.0001 and out[0] <= 1.0001 and out[1] >= -0.0001 and out[1] <= 1.0001)
    }
  }

  test "yaw is turned out of the view direction the way the renderer turned it in" {
    # an instance turned by yaw a: a local point p is drawn at (c x + s z, y, -s x + c z). The direction to the camera
    # in the world, put through oimp_local_dir, is the direction to the camera in the instance's own frame.
    let yaw = 0.8
    let s = Math.sin(yaw)
    let c = Math.cos(yaw)
    let local = floats(3)
    local[0] = 0.3;  local[1] = 0.5;  local[2] = 0.81240384
    let wx = c * local[0] + s * local[2]
    let wz = -s * local[0] + c * local[2]
    let back = floats(3)
    oimp_local_dir(wx, local[1], wz, s, c, back)
    expect_near(back[0], local[0], 0.001)
    expect_near(back[1], local[1], 0.001)
    expect_near(back[2], local[2], 0.001)
  }

  test "sizes and the fade ramp" {
    let b = floats(2)
    oimp_bounds(24.0, 18.0, 30.0, b)
    expect_near(b[0], 0.5 * Math.sqrt(576.0 + 324.0 + 900.0), 0.001)
    expect_near(b[1], 15.0, 0.001)
    expect_eq(oimp_atlas_px(8, 128), 1024)
    expect_eq(oimp_bytes(8, 128), 2 * 64 * 128 * 128 * 4)
    expect(oimp_fade(100.0, 300.0, 50.0) == 0.0)
    expect(oimp_fade(400.0, 300.0, 50.0) == 1.0)
    expect_near(oimp_fade(325.0, 300.0, 50.0), 0.5, 0.0001)
    expect(oimp_fade(299.0, 300.0, 0.0) == 0.0 and oimp_fade(301.0, 300.0, 0.0) == 1.0)
  }
}
