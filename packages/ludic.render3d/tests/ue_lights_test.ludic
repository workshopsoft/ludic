# ue_lights_test.ludic - Unreal's local lights (ue_lights.ludic) without a device: the shader brightness of each IntensityUnits
# (ComputeLightBrightness in metres), the cone clamps (GetClampedConeAngles), and the nearest lights within MaxDrawDistance sent.
import "ludic.render3d/r3d.ludic"
program UeLightsTest {
  numbers float
  function links_runtime() -> bool { return Input.key_pressed(0) }

  test "brightness in each unit" (render3d_st: mut Render3dState) {
    let l = ue_light_add(render3d_st, false, 0.0, 0.0, 0.0)
    expect_near(ue_light_candela(l), 8.0, 0.00001)                     # Unitless 5000 x 16 / 100^2
    l.intensity_units = UE_LIGHT_CANDELAS;  l.intensity = 100.0
    expect_near(ue_light_candela(l), 100.0, 0.00001)
    l.intensity_units = UE_LIGHT_LUMENS;  l.intensity = 4.0 * PI
    expect_near(ue_light_candela(l), 1.0, 0.00001)                     # a point: lumens / 4 PI
    l.spot = true;  l.inner_cone_angle = 0.0;  l.outer_cone_angle = 60.0
    expect_near(ue_light_candela(l), 4.0 * PI / (2.0 * PI * (1.0 - Math.cos(PI / 3.0))), 0.0001)
    l.intensity_units = UE_LIGHT_EV;  l.intensity = 3.0
    expect_near(ue_light_candela(l), 8.0, 0.00001)
  }

  test "cone angles clamped as Unreal's" (render3d_st: mut Render3dState) {
    let l = ue_light_add(render3d_st, true, 0.0, 0.0, 0.0)
    l.inner_cone_angle = 50.0;  l.outer_cone_angle = 30.0
    let o = floats(2)
    ue_light_cone(l, o)
    expect_near(o[0], 50.0 * PI / 180.0, 0.00001)
    expect_near(o[1], 50.0 * PI / 180.0 + 0.001, 0.00001)              # outer held just past inner
    l.inner_cone_angle = 95.0;  l.outer_cone_angle = 120.0
    ue_light_cone(l, o)
    expect_near(o[0], 88.9 * PI / 180.0, 0.00001)
  }

  test "visible lights are sent nearest first; behind the camera or past MaxDrawDistance they are not" (render3d_st: mut Render3dState) {
    render3d_st.cam_pos = v3_new(0.0, 0.0, 0.0)
    render3d_st.cam_fwd = v3_new(1.0, 0.0, 0.0)
    for i in 0 .. 40 { ue_light_add(render3d_st, false, float(40 - i), 0.0, 0.0) }   # 40 m down to 1 m ahead
    let behind = ue_light_add(render3d_st, false, -30.0, 0.0, 0.0)                  # 30 m behind, 10 m reach
    ue_lights_frame(render3d_st)
    expect_eq(render3d_st.ue_ll_n, 40)
    expect_near(render3d_st.ue_ll_data[0], 1.0, 0.00001)
    expect_near(render3d_st.ue_ll_data[39 * 20], 40.0, 0.00001)
    expect_near(render3d_st.ue_ll_data[16], -1.0, 0.00001)                # no shadow map named yet
    behind.attenuation_radius = 40.0                                       # now it reaches past the camera
    ue_lights_frame(render3d_st)
    expect_eq(render3d_st.ue_ll_n, 41)
    render3d_st.ue_lls[39].max_draw_distance = 0.5                       # the 1 m light: past its MaxDrawDistance
    ue_lights_frame(render3d_st)
    expect_near(render3d_st.ue_ll_data[0], 2.0, 0.00001)
    r3d_ue_lights(render3d_st, false)
    ue_lights_frame(render3d_st)
    expect_eq(render3d_st.ue_ll_n, 0)
  }

  test "light grid slices: 0 just past the near offset, the last at the far plane" {
    let zp = floats(3)
    ue_lg_zparams(zp, 0.1, 500.0, 4.05, 31)
    # ComputeZSliceFromDepth: log2(z B + O) S
    expect_near(Math.log(0.195 * zp[0] + zp[1]) / Math.log(2.0) * zp[2], 0.0, 0.0001)
    expect_near(Math.log(500.0 * zp[0] + zp[1]) / Math.log(2.0) * zp[2], 31.0, 0.001)
    expect_near(zp[2], 4.05, 0.00001)
  }
}
