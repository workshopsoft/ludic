# hlod_test.ludic - the HLOD bake on tiny inputs: a box is five faces wound to face outward, yaw rotates as the
# renderer does, buildings are merged by ground cell and height band but never into something much bigger than
# they are, the bake is deterministic, and the files round-trip and refuse damage
import "ludic.render3d/bigworld.ludic"
program HlodTest {
  numbers float
  def InteriorAtlases from "interior_atlases.lres"

  function kits() -> []RenderKit {
    let k = new RenderKits
    render_kits_load(k, "city")
    return k.rows
  }

  # every triangle's geometric normal agrees with its vertices' normals; none face down
  function faces_out(m: HlodMesh) -> bool {
    var t = 0
    while t < m.ni {
      let a = m.idx[t] * HLOD_V
      let b = m.idx[t + 1] * HLOD_V
      let c = m.idx[t + 2] * HLOD_V
      let ux = m.vtx[b] - m.vtx[a]
      let uy = m.vtx[b + 1] - m.vtx[a + 1]
      let uz = m.vtx[b + 2] - m.vtx[a + 2]
      let vx = m.vtx[c] - m.vtx[a]
      let vy = m.vtx[c + 1] - m.vtx[a + 1]
      let vz = m.vtx[c + 2] - m.vtx[a + 2]
      let gx = uy * vz - uz * vy
      let gy = uz * vx - ux * vz
      let gz = ux * vy - uy * vx
      if gx * m.vtx[a + 3] + gy * m.vtx[a + 4] + gz * m.vtx[a + 5] <= 0.0 { return false }
      if m.vtx[a + 4] < -0.5 { return false }
      t += 3
    }
    return true
  }

  function extent(m: HlodMesh, axis: int, hi: bool) -> float {
    var r = 1000000000.0
    if hi { r = -1000000000.0 }
    for i in 0 .. m.nv {
      let v = m.vtx[i * HLOD_V + axis]
      if hi { r = Math.max(r, v) } else { r = Math.min(r, v) }
    }
    return r
  }

  test "one building is one box: twenty vertices, thirty indices, every face outward" {
    let c = cell_content_new(0, 0, 128.0, 4)
    cell_add(c, 0, 50.0, 0.0, 60.0, 0.0, 1.0, cell_rgba(255, 255, 255, 255), 0, 0)
    let m = hlod_new(0, 0, 128.0, 1)
    hlod_bake(c, kits(), 0.0, 6.0, 3.0, m)
    expect_eq(m.boxes, 1)
    expect_eq(m.nv, 20)
    expect_eq(m.ni, 30)
    expect_eq(hlod_tris(m), 10)
    expect(faces_out(m))
    expect_near(extent(m, 0, false), 45.0, 0.001)      # house 10 x 8 x 7 centred at (50, 60)
    expect_near(extent(m, 0, true), 55.0, 0.001)
    expect_near(extent(m, 2, false), 56.0, 0.001)
    expect_near(extent(m, 2, true), 64.0, 0.001)
    expect_near(extent(m, 1, true), 7.0, 0.001)
    expect_near(extent(m, 1, false), 0.0, 0.001)
  }

  test "yaw turns the box the way the renderer turns an instance, scale grows it about its middle" {
    let c = cell_content_new(0, 0, 128.0, 4)
    cell_add(c, 0, 50.0, 0.0, 60.0, 1.5707964, 2.0, cell_rgba(255, 255, 255, 255), 0, 0)   # a quarter turn, twice the size
    let m = hlod_new(0, 0, 128.0, 1)
    hlod_bake(c, kits(), 0.0, 6.0, 3.0, m)
    # 10 x 8 doubled = 20 x 16; a quarter turn swaps the extents: 16 along x, 20 along z
    expect_near(extent(m, 0, true) - extent(m, 0, false), 16.0, 0.01)
    expect_near(extent(m, 2, true) - extent(m, 2, false), 20.0, 0.01)
    expect_near(extent(m, 1, true), 14.0, 0.001)
    expect(faces_out(m))
    # a real rotation (30 degrees): still five faces out, and wider than either side
    let d = cell_content_new(0, 0, 128.0, 4)
    cell_add(d, 0, 50.0, 0.0, 60.0, 0.5235988, 1.0, cell_rgba(255, 255, 255, 255), 0, 0)
    let n = hlod_new(0, 0, 128.0, 1)
    hlod_bake(d, kits(), 0.0, 6.0, 3.0, n)
    expect(faces_out(n))
    expect(extent(n, 0, true) - extent(n, 0, false) > 10.0)
  }

  test "neighbours in one ground cell and height band become one box, and a far pair is not merged into a field" {
    let c = cell_content_new(0, 0, 128.0, 8)
    # four houses in a row inside one 16 m cluster cell
    for i in 0 .. 4 { cell_add(c, 0, 2.0 + float(i) * 3.5, 0.0, 4.0, 0.0, 1.0, cell_rgba(255, 255, 255, 255), 0, 0) }
    let m = hlod_new(0, 0, 128.0, 1)
    hlod_bake(c, kits(), 16.0, 6.0, 3.0, m)
    expect_eq(m.boxes, 1)
    expect_eq(m.source, 4)
    expect(faces_out(m))
    let alone = hlod_new(0, 0, 128.0, 1)
    hlod_bake(c, kits(), 0.0, 6.0, 3.0, alone)
    expect_eq(alone.boxes, 4)
    expect_eq(alone.source, 4)
    # two houses in the same cluster cell but 28 m apart: the merged box would be nine times their volume
    let d = cell_content_new(0, 0, 128.0, 8)
    cell_add(d, 0, 2.0, 0.0, 2.0, 0.0, 1.0, cell_rgba(255, 255, 255, 255), 0, 0)
    cell_add(d, 0, 30.0, 0.0, 30.0, 0.0, 1.0, cell_rgba(255, 255, 255, 255), 0, 0)
    let e = hlod_new(0, 0, 128.0, 1)
    hlod_bake(d, kits(), 32.0, 6.0, 3.0, e)
    expect_eq(e.boxes, 2)
  }

  test "a tower among houses is its own box: the height band keeps them apart" {
    let c = cell_content_new(0, 0, 128.0, 8)
    cell_add(c, 0, 4.0, 0.0, 4.0, 0.0, 1.0, cell_rgba(255, 255, 255, 255), 0, 0)
    cell_add(c, 0, 9.0, 0.0, 14.0, 0.0, 1.0, cell_rgba(255, 255, 255, 255), 0, 0)
    cell_add(c, 2, 14.0, 0.0, 6.0, 0.0, 1.0, cell_rgba(255, 255, 255, 255), 0, 0)
    let m = hlod_new(0, 0, 128.0, 1)
    hlod_bake(c, kits(), 32.0, 6.0, 3.0, m)
    expect_eq(m.boxes, 2)
    expect_eq(m.source, 3)
    expect_near(extent(m, 1, true), 120.0, 0.001)
  }

  test "a merged box contains every building it stands for" {
    let c = cell_content_new(0, 0, 128.0, 8)
    for i in 0 .. 5 { cell_add(c, 1, 10.0 + float(i) * 6.0, 0.0, 20.0 + float(i % 2) * 5.0, float(i) * 0.3, 1.0, cell_rgba(255, 255, 255, 255), 0, 0) }
    let m = hlod_new(0, 0, 128.0, 1)
    hlod_bake(c, kits(), 64.0, 10.0, 6.0, m)
    expect_eq(m.boxes, 1)
    let px = floats(4)
    let pz = floats(4)
    for i in 0 .. 5 {
      let o = i * CELL_XF
      hlod_corners(c.xf[o], c.xf[o + 2], 12.0, 9.0, c.xf[o + 3], px, pz)
      for q in 0 .. 4 {
        expect(px[q] >= extent(m, 0, false) - 0.001 and px[q] <= extent(m, 0, true) + 0.001)
        expect(pz[q] >= extent(m, 2, false) - 0.001 and pz[q] <= extent(m, 2, true) + 0.001)
      }
    }
    expect(extent(m, 1, true) >= 30.0)
  }

  test "a dense block of two thousand buildings collapses to a few boxes, and the bake is deterministic" {
    let c = cell_content_new(5, 5, 256.0, 16)
    var seed = 12345
    for j in 0 .. 40 {
      for i in 0 .. 50 {
        seed = (seed * 1103515245 + 12345) & 0x7fffffff
        let jit = float(seed % 100) * 0.01
        cell_add(c, seed % 2, 2.0 + float(i) * 5.0 + jit, 0.0, 2.0 + float(j) * 6.0 + jit, 0.0, 1.0, cell_rgba(200, 200, 200, 255), i, 0)
      }
    }
    expect_eq(c.n, 2000)
    let a = hlod_new(5, 5, 256.0, 1)
    hlod_bake(c, kits(), 32.0, 12.0, 4.0, a)
    let none = hlod_new(5, 5, 256.0, 1)
    hlod_bake(c, kits(), 0.0, 12.0, 4.0, none)
    expect_eq(none.boxes, 2000)
    expect(a.boxes < 700)
    expect(a.source == 2000)
    expect(faces_out(a))
    let b = hlod_new(5, 5, 256.0, 1)
    hlod_bake(c, kits(), 32.0, 12.0, 4.0, b)
    let ea = hlod_encode(a)
    let eb = hlod_encode(b)
    expect_eq(len(ea), len(eb))
    var same = true
    for i in 0 .. len(ea) { if ea[i] != eb[i] { same = false } }
    expect(same)
  }

  test "unknown kit ids are skipped" {
    let c = cell_content_new(0, 0, 128.0, 4)
    cell_add(c, 99, 10.0, 0.0, 10.0, 0.0, 1.0, 0, 0, 0)
    cell_add(c, -1, 20.0, 0.0, 10.0, 0.0, 1.0, 0, 0, 0)
    cell_add(c, 0, 30.0, 0.0, 10.0, 0.0, 1.0, cell_rgba(255, 255, 255, 255), 0, 0)
    let m = hlod_new(0, 0, 128.0, 1)
    hlod_bake(c, kits(), 16.0, 6.0, 3.0, m)
    expect_eq(m.boxes, 1)
    expect_eq(m.source, 1)
  }

  # the colour of every vertex of the faces whose normal's y is `up` (1 the roof, 0 the walls) is (r, g, b) to a byte
  function faces_are(m: HlodMesh, up: float, r: float, g: float, b: float) -> bool {
    var seen = 0
    for v in 0 .. m.nv {
      if Math.abs(m.vtx[v * HLOD_V + 4] - up) > 0.01 { continue }
      let bits = float_bits(m.vtx[v * HLOD_V + 6])
      if Math.abs(cell_rgba_r(bits) - r) > 0.003 or Math.abs(cell_rgba_g(bits) - g) > 0.003 or Math.abs(cell_rgba_b(bits) - b) > 0.003 { return false }
      seen += 1
    }
    return seen > 0
  }

  # a quad (a, b, c, d round its edge) into the colour sums as two triangles, wound either way (no normals: its own winding says out)
  function quad_into(acc: floats, q: floats, r: float, g: float, b: float) -> void {
    hlod_colour_tri(acc, q, null, 0, 1, 2, r, g, b)
    hlod_colour_tri(acc, q, null, 0, 2, 3, r, g, b)
  }
  function quad(ax: float, ay: float, az: float, bx: float, by: float, bz: float, cx: float, cy: float, cz: float, dx: float, dy: float, dz: float) -> floats {
    let q = floats(12)
    q[0] = ax;  q[1] = ay;  q[2] = az;  q[3] = bx;  q[4] = by;  q[5] = bz
    q[6] = cx;  q[7] = cy;  q[8] = cz;  q[9] = dx;  q[10] = dy;  q[11] = dz
    return q
  }

  test "a kit's proxy colours are what its mesh shows: the walls from the side, the roof from above" {
    # a 10 m cube: four walls (0.6, 0.5, 0.4) and a flat roof (0.1, 0.1, 0.1), the roof's quad wound to face down (a two-sided mesh)
    let acc = floats(HLOD_COL_ACC)
    for i in 0 .. HLOD_COL_ACC { acc[i] = 0.0 }
    quad_into(acc, quad(0.0, 0.0, 0.0, 10.0, 0.0, 0.0, 10.0, 10.0, 0.0, 0.0, 10.0, 0.0), 0.6, 0.5, 0.4)
    quad_into(acc, quad(0.0, 0.0, 10.0, 0.0, 10.0, 10.0, 10.0, 10.0, 10.0, 10.0, 0.0, 10.0), 0.6, 0.5, 0.4)
    quad_into(acc, quad(0.0, 0.0, 0.0, 0.0, 10.0, 0.0, 0.0, 10.0, 10.0, 0.0, 0.0, 10.0), 0.6, 0.5, 0.4)
    quad_into(acc, quad(10.0, 0.0, 0.0, 10.0, 0.0, 10.0, 10.0, 10.0, 10.0, 10.0, 10.0, 0.0), 0.6, 0.5, 0.4)
    let roof = quad(0.0, 10.0, 0.0, 10.0, 10.0, 0.0, 10.0, 10.0, 10.0, 0.0, 10.0, 10.0)
    let nrm = floats(12)
    for v in 0 .. 4 { nrm[v * 3] = 0.0;  nrm[v * 3 + 1] = 1.0;  nrm[v * 3 + 2] = 0.0 }
    hlod_colour_tri(acc, roof, nrm, 0, 1, 2, 0.1, 0.1, 0.1)
    hlod_colour_tri(acc, roof, nrm, 0, 2, 3, 0.1, 0.1, 0.1)
    let k = new RenderKit
    expect(hlod_colour_apply(acc, k))
    expect_near(k.proxy_r, 0.6, 0.0005)
    expect_near(k.proxy_g, 0.5, 0.0005)
    expect_near(k.proxy_b, 0.4, 0.0005)
    expect(k.proxy_roof)
    expect_near(k.proxy_roof_r, 0.1, 0.0005)
    # a roof pitched at 45 degrees counts for both: as much of it is seen from the side as from above
    let pitched = quad(0.0, 10.0, 0.0, 10.0, 10.0, 0.0, 10.0, 20.0, 10.0, 0.0, 20.0, 10.0)
    let a2 = floats(HLOD_COL_ACC)
    for i in 0 .. HLOD_COL_ACC { a2[i] = 0.0 }
    hlod_colour_tri(a2, pitched, null, 0, 2, 1, 0.2, 0.2, 0.2)
    hlod_colour_tri(a2, pitched, null, 0, 3, 2, 0.2, 0.2, 0.2)
    expect_near(a2[3], a2[7], 0.001)
    expect_near(a2[7], 100.0, 0.01)                      # its plan: 10 x 10 m
    # nothing counted: the row stays as it was
    let none = floats(HLOD_COL_ACC)
    for i in 0 .. HLOD_COL_ACC { none[i] = 0.0 }
    let k2 = new RenderKit
    expect(not hlod_colour_apply(none, k2))
    expect(not k2.proxy_roof)
    expect_near(k2.proxy_r, 0.55, 0.0001)
  }

  test "a kit with a roof colour gives its proxy's roof that colour and its walls their own; one without keeps one colour" {
    let rows = kits()
    let k = rows[0]
    k.proxy_roof = true
    k.proxy_roof_r = 0.1;  k.proxy_roof_g = 0.2;  k.proxy_roof_b = 0.3
    let c = cell_content_new(0, 0, 128.0, 4)
    cell_add(c, 0, 10.0, 0.0, 10.0, 0.3, 1.0, cell_rgba(255, 255, 255, 255), 0, 0)
    let m = hlod_new(0, 0, 128.0, 1)
    hlod_bake(c, rows, 0.0, 6.0, 3.0, m)
    expect(faces_are(m, 1.0, 0.1, 0.2, 0.3))
    expect(faces_are(m, 0.0, k.proxy_r, k.proxy_g, k.proxy_b))
    # two of them merged: the merged box's roof is their roofs' colour too
    let c2 = cell_content_new(0, 0, 128.0, 4)
    cell_add(c2, 0, 10.0, 0.0, 10.0, 0.0, 1.0, cell_rgba(255, 255, 255, 255), 0, 0)
    cell_add(c2, 0, 21.0, 0.0, 10.0, 0.0, 1.0, cell_rgba(255, 255, 255, 255), 0, 0)
    let m2 = hlod_new(0, 0, 128.0, 1)
    hlod_bake(c2, rows, 64.0, 6.0, 3.0, m2)
    expect_eq(m2.boxes, 1)
    expect(faces_are(m2, 1.0, 0.1, 0.2, 0.3))
    expect(faces_are(m2, 0.0, k.proxy_r, k.proxy_g, k.proxy_b))
    # the fixture's rows give no roof colour: walls and roof are one
    let plain = kits()
    let m3 = hlod_new(0, 0, 128.0, 1)
    hlod_bake(c, plain, 0.0, 6.0, 3.0, m3)
    expect(faces_are(m3, 1.0, plain[0].proxy_r, plain[0].proxy_g, plain[0].proxy_b))
  }

  test "the proxy's colour is the kit's times the instance's tint" {
    let c = cell_content_new(0, 0, 128.0, 4)
    cell_add(c, 0, 10.0, 0.0, 10.0, 0.0, 1.0, cell_rgba(128, 255, 0, 255), 0, 0)
    let m = hlod_new(0, 0, 128.0, 1)
    hlod_bake(c, kits(), 0.0, 6.0, 3.0, m)
    let bits = float_bits(m.vtx[6])
    expect_near(cell_rgba_r(bits), 0.6 * 128.0 / 255.0, 0.005)     # house proxy_r 0.6
    expect_near(cell_rgba_g(bits), 0.45, 0.005)
    expect_near(cell_rgba_b(bits), 0.0, 0.005)
  }

  # the 12 triangles of a box (x0 .. x1, y0 .. y1, z0 .. z1) into tri at triangle t; the next free triangle
  function box_tris(tri: floats, t: int, x0: float, y0: float, z0: float, x1: float, y1: float, z1: float) -> int {
    let xs = [x0, x1]
    let ys = [y0, y1]
    let zs = [z0, z1]
    var n = t
    # each face as two triangles over its four corners
    for a in 0 .. 3 {
      for side in 0 .. 2 {
        let q = floats(12)
        for k in 0 .. 4 {
          var u = 0
          var v = 0
          if k == 1 or k == 2 { u = 1 }
          if k >= 2 { v = 1 }
          var cx = xs[u]
          var cy = ys[v]
          var cz = zs[side]
          if a == 1 { cx = xs[side];  cy = ys[u];  cz = zs[v] }
          if a == 2 { cx = xs[u];  cy = ys[side];  cz = zs[v] }
          q[k * 3] = cx;  q[k * 3 + 1] = cy;  q[k * 3 + 2] = cz
        }
        let order = [0, 1, 2, 0, 2, 3]
        for e in 0 .. 6 {
          let o = n * 9 + e * 3
          tri[o] = q[order[e] * 3];  tri[o + 1] = q[order[e] * 3 + 1];  tri[o + 2] = q[order[e] * 3 + 2]
        }
        n += 2
      }
    }
    return n
  }

  function in_part(p: floats, x: float, y: float, z: float, slack: float) -> bool {
    var q = 0
    while q + HLOD_PART <= len(p) {
      if x >= p[q] - slack and x <= p[q + 3] + slack and y >= p[q + 1] - slack and y <= p[q + 4] + slack and z >= p[q + 2] - slack and z <= p[q + 5] + slack { return true }
      q += HLOD_PART
    }
    return false
  }

  test "a crane's mesh is a few boxes that follow it: a tower and a jib, not the box round both" {
    # a tower 2 x 30 x 2 and a jib 2 x 2 x 50 at its top, reaching 35 m one way and 15 m the other (the mesh is not centred)
    let tri = floats(24 * 9)
    var n = box_tris(tri, 0, -1.0, 0.0, -1.0, 1.0, 30.0, 1.0)
    n = box_tris(tri, n, -1.0, 28.0, -15.0, 1.0, 30.0, 35.0)
    expect_eq(n, 24)
    let p = hlod_parts(tri, n, 8)
    expect(p != null)
    if p == null { return }
    let nb = len(p) / HLOD_PART
    print(`crane: {nb} parts`)
    expect(nb >= 2 and nb <= 8)
    # every vertex of the mesh is in a part, the parts together reach the mesh's bounds and no further
    var vol = 0.0
    var x0 = 1000.0
    var z1 = -1000.0
    var y1 = -1000.0
    for b in 0 .. nb {
      let q = b * HLOD_PART
      vol = vol + (p[q + 3] - p[q]) * (p[q + 4] - p[q + 1]) * (p[q + 5] - p[q + 2])
      x0 = Math.min(x0, p[q]);  y1 = Math.max(y1, p[q + 4]);  z1 = Math.max(z1, p[q + 5])
    }
    for v in 0 .. n * 3 { expect(in_part(p, tri[v * 3], tri[v * 3 + 1], tri[v * 3 + 2], 0.001)) }
    expect_near(x0, -1.0, 0.001)
    expect_near(y1, 30.0, 0.001)
    expect_near(z1, 35.0, 0.001)
    # the empty air under the jib is in none (the one box round both was 2 x 30 x 50: 3000 m3; the crane itself is 320 m3)
    expect(not in_part(p, 0.0, 14.0, 20.0, 0.0))
    expect(not in_part(p, 0.0, 14.0, -10.0, 0.0))
    print(`crane parts: {vol} m3 (the box round it 3000 m3)`)
    expect(vol < 3000.0 * 0.3)
    # deterministic
    let p2 = hlod_parts(tri, n, 8)
    expect_eq(len(p2), len(p))
    for i in 0 .. len(p) { expect(p2[i] == p[i]) }
    # no triangle: none
    expect(hlod_parts(tri, 0, 8) == null)
  }

  test "a kit with parts is drawn as its parts, turned and moved with its instance, and never merged with its neighbours" {
    let kk = kits()
    let parts = new []floats
    for i in 0 .. len(kk) { push(parts, null) }
    # kit 0 (the house, 10 x 8 x 7): two parts, one off its middle
    let p = floats(12)
    p[0] = -5.0;  p[1] = 0.0;  p[2] = -4.0;  p[3] = 5.0;  p[4] = 3.0;  p[5] = 4.0
    p[6] = 2.0;  p[7] = 3.0;  p[8] = 10.0;  p[9] = 4.0;  p[10] = 20.0;  p[11] = 14.0
    parts[0] = p
    let c = cell_content_new(0, 0, 128.0, 4)
    # a house turned 90 degrees at (50, 60), and two neighbours of another kit beside it (merged with each other, not with it)
    cell_add(c, 0, 50.0, 1.0, 60.0, Math.deg_to_rad(90.0), 1.0, cell_rgba(255, 255, 255, 255), 0, 0)
    cell_add(c, 1, 56.0, 0.0, 52.0, 0.0, 1.0, cell_rgba(255, 255, 255, 255), 0, 0)
    cell_add(c, 1, 62.0, 0.0, 52.0, 0.0, 1.0, cell_rgba(255, 255, 255, 255), 0, 0)
    let m = hlod_new(0, 0, 128.0, 4)
    hlod_bake_parts(c, kk, parts, 32.0, 100.0, 100.0, m)
    expect(faces_out(m))
    expect_eq(m.boxes, 3)
    expect_eq(m.source, 3)
    # the second part: x 2 .. 4, z 10 .. 14 in the kit's frame, turned 90 degrees (x' = c x + s z, z' = -s x + c z) at (50, 60): x 60 .. 64,
    # z 56 .. 58, from y 4 to 21
    var found = false
    for b in 0 .. m.boxes {
      var bx0 = 1000.0
      var bx1 = -1000.0
      var bz0 = 1000.0
      var bz1 = -1000.0
      var by1 = -1000.0
      for v in b * 20 .. b * 20 + 20 {
        bx0 = Math.min(bx0, m.vtx[v * HLOD_V]);  bx1 = Math.max(bx1, m.vtx[v * HLOD_V])
        bz0 = Math.min(bz0, m.vtx[v * HLOD_V + 2]);  bz1 = Math.max(bz1, m.vtx[v * HLOD_V + 2])
        by1 = Math.max(by1, m.vtx[v * HLOD_V + 1])
      }
      if Math.abs(bx0 - 60.0) < 0.01 and Math.abs(bx1 - 64.0) < 0.01 and Math.abs(bz0 - 56.0) < 0.01 and Math.abs(bz1 - 58.0) < 0.01 and Math.abs(by1 - 21.0) < 0.01 { found = true }
    }
    expect(found)
    # with no parts it is the house's one box, merged with the neighbours as before
    let m2 = hlod_new(0, 0, 128.0, 4)
    hlod_bake_parts(c, kk, null, 32.0, 100.0, 100.0, m2)
    let m3 = hlod_new(0, 0, 128.0, 4)
    hlod_bake(c, kk, 32.0, 100.0, 100.0, m3)
    expect_eq(m2.boxes, m3.boxes)
    expect_eq(m2.nv, m3.nv)
    for i in 0 .. m2.nv * HLOD_V { expect(m2.vtx[i] == m3.vtx[i] or float_bits(m2.vtx[i]) == float_bits(m3.vtx[i])) }
  }

  test "the proxy file round-trips and refuses damage" {
    let c = cell_content_new(3, -2, 128.0, 4)
    for i in 0 .. 3 { cell_add(c, i, 10.0 + float(i) * 30.0, 0.0, 10.0, 0.0, 1.0, cell_rgba(255, 255, 255, 255), 0, 0) }
    let m = hlod_new(3, -2, 128.0, 1)
    hlod_bake(c, kits(), 0.0, 6.0, 3.0, m)
    let b = hlod_encode(m)
    expect_eq(len(b), hlod_bytes(m))
    let d = hlod_decode(b)
    expect(d != null and d.cx == 3 and d.cz == -2 and d.nv == m.nv and d.ni == m.ni and d.boxes == 3)
    for i in 0 .. m.nv * HLOD_V { expect(d.vtx[i] == m.vtx[i] or float_bits(d.vtx[i]) == float_bits(m.vtx[i])) }
    for i in 0 .. m.ni { expect_eq(d.idx[i], m.idx[i]) }
    expect(hlod_decode(null) == null)
    let cut = buffer(len(b) - 4)
    for i in 0 .. len(cut) { cut[i] = b[i] }
    expect(hlod_decode(cut) == null)
    let bad = buffer(len(b))
    for i in 0 .. len(b) { bad[i] = b[i] }
    lw_put32(bad, len(b) - 4, 99999)                    # an index past the vertices
    expect(hlod_decode(bad) == null)
    let dir = Os.temp_dir() + "/r3d_hlod_test"
    expect(hlod_save(dir, m))
    expect(hlod_load(dir, 3, -2) != null)
    expect(hlod_load(dir, 0, 0) == null)
  }

  test "the dev bake walks a directory of content and writes proxies and an index" {
    let dir_in = Os.temp_dir() + "/r3d_hlod_in"
    let dir_out = Os.temp_dir() + "/r3d_hlod_out"
    for q in 0 .. 3 {
      let c = cell_content_new(q, 7, 128.0, 4)
      for i in 0 .. 6 { cell_add(c, 0, 4.0 + float(i) * 3.0, 0.0, 8.0, 0.0, 1.0, cell_rgba(255, 255, 255, 255), 0, 0) }
      expect(cell_save(dir_in, c))
    }
    let empty = cell_content_new(9, 9, 128.0, 1)
    expect(cell_save(dir_in, empty))
    let n = hlod_bake_dir(dir_in, dir_out, kits(), 128.0, 16.0, 6.0, 3.0)
    expect_eq(n, 4)
    let ix = cell_index_load(dir_out)
    expect(ix != null and len(ix.entries) == 4)
    let k = cell_index_find(ix, 1, 7)
    expect(k >= 0 and ix.entries[k].n == 6 and ix.entries[k].bytes_hlod > 0 and ix.entries[k].bytes_full > 0)
    let e = cell_index_find(ix, 9, 9)
    expect(e >= 0 and ix.entries[e].bytes_hlod == 0)
    expect(hlod_load(dir_out, 2, 7) != null)
    expect(hlod_load(dir_out, 9, 9) == null)
  }
}
