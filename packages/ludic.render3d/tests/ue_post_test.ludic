# ue_post_test.ludic - Unreal's post-process settings (ue_post.ludic) without a device: the defaults of FPostProcessSettings, the
# packed settings round trip, and Post Process Volumes as UE 5.8 blends them (World.cpp DoPostProcessVolume, SceneView.cpp
# OverridePostProcessSettings): weight 1 inside, falling linearly to 0 over BlendRadius outside, nothing past it, unbound everywhere,
# only overridden settings move, lower priority first so the higher wins, TemperatureType set rather than blended, and the rebase.
import "ludic.render3d/r3d.ludic"
program UePostTest {
  numbers float
  function links_runtime() -> bool { return Input.key_pressed(0) }

  test "the base settings are Unreal's defaults" (render3d_st: mut Render3dState) {
    let pp = r3d_pp(render3d_st)
    expect_near(pp.film_slope, 0.88, 0.000001)
    expect_near(pp.film_toe, 0.55, 0.000001)
    expect_near(pp.film_white_clip, 0.04, 0.000001)
    expect_near(pp.bloom_intensity, 0.675, 0.000001)
    expect_near(pp.bloom_size[5], 64.0, 0.000001)
    expect_near(pp.bloom_tint[0], 0.3465, 0.000001)
    expect_near(pp.auto_exposure_bias, 1.0, 0.000001)
    expect_near(pp.grade[ue_pp_grade_index(UE_GRADE_SHADOWS, UE_CC_GAIN, 0) - UE_PP_GRADE], 1.0, 0.000001)
    expect_near(pp.grade[ue_pp_grade_index(UE_GRADE_HIGHLIGHTS, UE_CC_OFFSET, 3) - UE_PP_GRADE], 0.0, 0.000001)
  }

  test "with no volumes the frame's settings are the base" (render3d_st: mut Render3dState) {
    let pp = r3d_pp(render3d_st)
    pp.film_slope = 0.7
    pp.white_temp = 5000.0
    let f = ue_pp_resolve(render3d_st, 0.0, 0.0, 0.0)
    expect_near(f.film_slope, 0.7, 0.000001)
    expect_near(f.white_temp, 5000.0, 0.000001)
    expect_near(f.bloom_tint[17], 0.061, 0.000001)
  }

  test "a box volume weighs 1 inside and falls linearly over its blend radius" (render3d_st: mut Render3dState) {
    let v = ue_ppv_add(render3d_st, 0.0, 10.0, 1.0, false)
    ue_ppv_box(v, 0.0, 0.0, 0.0, 5.0, 5.0, 5.0, 0.0)
    expect_near(ue_ppv_weight(v, 0.0, 0.0, 0.0), 1.0, 0.000001)
    expect_near(ue_ppv_weight(v, 5.0, 0.0, 0.0), 1.0, 0.000001)
    expect_near(ue_ppv_weight(v, 10.0, 0.0, 0.0), 0.5, 0.000001)
    expect_near(ue_ppv_weight(v, 15.0, 0.0, 0.0), 0.0, 0.000001)
    expect_near(ue_ppv_weight(v, 20.0, 0.0, 0.0), 0.0, 0.000001)
    # past a corner the distance is to the corner
    expect_near(ue_ppv_distance(v, 8.0, 9.0, 0.0), 5.0, 0.00001)
    # BlendWeight scales it
    v.blend_weight = 0.5
    expect_near(ue_ppv_weight(v, 10.0, 0.0, 0.0), 0.25, 0.000001)
    # a radius under 1 is a hard edge
    v.blend_weight = 1.0
    v.blend_radius = 0.5
    expect_near(ue_ppv_weight(v, 4.9, 0.0, 0.0), 1.0, 0.000001)
    expect_near(ue_ppv_weight(v, 5.2, 0.0, 0.0), 0.0, 0.000001)
    v.enabled = false
    expect_near(ue_ppv_weight(v, 0.0, 0.0, 0.0), 0.0, 0.000001)
  }

  test "a turned box and a sphere" (render3d_st: mut Render3dState) {
    let v = ue_ppv_add(render3d_st, 0.0, 0.0, 1.0, false)
    ue_ppv_box(v, 0.0, 0.0, 0.0, 1.0, 1.0, 10.0, PI * 0.5)       # its depth along world x
    expect_near(ue_ppv_distance(v, 9.0, 0.0, 0.0), 0.0, 0.00001)
    expect_near(ue_ppv_distance(v, 0.0, 0.0, 9.0), 8.0, 0.00001)
    let s = ue_ppv_add(render3d_st, 0.0, 0.0, 1.0, false)
    ue_ppv_sphere(s, 1.0, 2.0, 3.0, 4.0)
    expect_near(ue_ppv_distance(s, 1.0, 2.0, 3.0), 0.0, 0.00001)
    expect_near(ue_ppv_distance(s, 1.0, 2.0, 10.0), 3.0, 0.00001)
  }

  test "only overridden settings blend, by the volume's weight" (render3d_st: mut Render3dState) {
    let v = ue_ppv_add(render3d_st, 0.0, 10.0, 1.0, false)
    ue_ppv_box(v, 0.0, 0.0, 0.0, 5.0, 5.0, 5.0, 0.0)
    ue_ppv_set(v, UE_PP_FILM_SLOPE, 0.48)
    ue_ppv_set(v, ue_pp_grade_index(UE_GRADE_SHADOWS, UE_CC_SATURATION, 3), 0.5)
    let f = ue_pp_resolve(render3d_st, 10.0, 0.0, 0.0)             # weight 0.5
    expect_near(f.film_slope, 0.68, 0.00001)
    expect_near(f.grade[ue_pp_grade_index(UE_GRADE_SHADOWS, UE_CC_SATURATION, 3) - UE_PP_GRADE], 0.75, 0.00001)
    expect_near(f.film_toe, 0.55, 0.00001)                          # not overridden: the base
    let g = ue_pp_resolve(render3d_st, 100.0, 0.0, 0.0)            # outside: the base
    expect_near(g.film_slope, 0.88, 0.00001)
    r3d_ue_volumes(render3d_st, false)
    let h = ue_pp_resolve(render3d_st, 0.0, 0.0, 0.0)               # volumes off
    expect_near(h.film_slope, 0.88, 0.00001)
  }

  test "volumes apply lowest priority first, so the higher one wins where both are full" (render3d_st: mut Render3dState) {
    let hi = ue_ppv_add(render3d_st, 5.0, 0.0, 1.0, true)
    ue_ppv_set(hi, UE_PP_BLOOM_INTENSITY, 2.0)
    let lo = ue_ppv_add(render3d_st, 1.0, 0.0, 1.0, true)
    ue_ppv_set(lo, UE_PP_BLOOM_INTENSITY, 0.0)
    expect_near(ue_pp_resolve(render3d_st, 0.0, 0.0, 0.0).bloom_intensity, 2.0, 0.00001)
    # half weight on the high one: lerp(0, 2, 0.5) after the low one set 0
    hi.blend_weight = 0.5
    expect_near(ue_pp_resolve(render3d_st, 0.0, 0.0, 0.0).bloom_intensity, 1.0, 0.00001)
    # equal priority: unbound first, then larger first, so the smaller bounded one is applied last
    let a = ue_ppv_add(render3d_st, 9.0, 0.0, 1.0, false)
    ue_ppv_box(a, 0.0, 0.0, 0.0, 1.0, 1.0, 1.0, 0.0)
    ue_ppv_set(a, UE_PP_FILM_TOE, 0.3)
    let b = ue_ppv_add(render3d_st, 9.0, 0.0, 1.0, false)
    ue_ppv_box(b, 0.0, 0.0, 0.0, 10.0, 10.0, 10.0, 0.0)
    ue_ppv_set(b, UE_PP_FILM_TOE, 0.9)
    expect_near(ue_pp_resolve(render3d_st, 0.0, 0.0, 0.0).film_toe, 0.3, 0.00001)
  }

  test "TemperatureType is set, not blended" (render3d_st: mut Render3dState) {
    let v = ue_ppv_add(render3d_st, 0.0, 0.0, 0.1, true)
    ue_ppv_set(v, UE_PP_TEMP_IS_WHITE_BALANCE, 0.0)
    expect_eq(ue_pp_resolve(render3d_st, 0.0, 0.0, 0.0).temp_is_white_balance, false)
  }

  test "settings by name, and decimal numbers" (render3d_st: mut Render3dState) {
    expect_eq(ue_pp_index_of("film_slope"), UE_PP_FILM_SLOPE)
    expect_eq(ue_pp_index_of("grade:3"), UE_PP_GRADE + 3)
    expect_eq(ue_pp_index_of("bloom_tint:17"), UE_PP_BLOOM_TINT + 17)
    expect_eq(ue_pp_index_of("lut_size"), -1)                       # a console variable, not a volume setting
    expect_near(ue_parse_float("12.5"), 12.5, 0.000001)
    expect_near(ue_parse_float("-0.25"), -0.25, 0.000001)
    expect_near(ue_parse_float("4000"), 4000.0, 0.000001)
    expect_near(ue_parse_float("0.06"), 0.06, 0.000001)
  }

  test "volumes move with the floating origin and can be removed" (render3d_st: mut Render3dState) {
    let v = ue_ppv_add(render3d_st, 0.0, 0.0, 1.0, false)
    ue_ppv_box(v, 0.0, 0.0, 0.0, 1.0, 1.0, 1.0, 0.0)
    ue_ppv_set(v, UE_PP_VIGNETTE_INTENSITY, 0.0)
    ue_ppv_rebase(render3d_st, 100.0, 0.0, 0.0)
    expect_near(ue_pp_resolve(render3d_st, 100.0, 0.0, 0.0).vignette_intensity, 0.0, 0.00001)
    expect_near(ue_pp_resolve(render3d_st, 0.0, 0.0, 0.0).vignette_intensity, 0.4, 0.00001)
    ue_ppv_remove(render3d_st, v)
    expect_near(ue_pp_resolve(render3d_st, 100.0, 0.0, 0.0).vignette_intensity, 0.4, 0.00001)
  }
}
