# tilemap_lock_test.ludic - the terrain LOD lock (tilemap_bake.ludic TmLock) on the lock fixture (tests/maps/lock, made by
# make_lock.py: one tile of 128 m at 1 m texels, hills, a graded road with sidewalks in cut and fill, a flat pad, a lake with
# a sand shore; classes shore 1, grass 2, road 3, sidewalk 4, pad 5, lake bed 6). OC-140.I8: read back through the game's
# reader, every level's drawn surface at every locked texel (its centre and corners) equals level 0 within 1 cm; unlocked
# texels are free (an unlocked bake moves the road by metres; a locked level is cut only where it must, and every level
# still covers every texel with no hole); old files (kind word 0) read as before; a locked level wears land-use tones. No device.
import "ludic.render3d/r3d.ludic"
program TileLockTest {
  numbers float
  function links_runtime() -> bool { return Input.key_pressed(0) }

  function open(render3d_st: mut Render3dState) -> TileMap {
    let pattern = render3d_st.r3d_root + "/tests/maps/lock/{tx}_{tz}.png"
    let tm = tmap_new(pattern, 128.0, 128, 1, 1, 0.0, 0.0, -20.0, 40.0, 0.0, 400.0)
    tmap_patches(tm, 64)                       # 2 x 2 patches, levels of 64, 32, 16, 8, 4 cells
    return tm
  }
  function lock_of(render3d_st: Render3dState) -> TmLock {
    let cs = new []int
    push(cs, 3);  push(cs, 4);  push(cs, 5);  push(cs, 1)
    return tmb_lock_new(render3d_st.r3d_root + "/tests/maps/lock/{tx}_{tz}.mask.png", cs)
  }
  # bake into a fresh folder (k null: unlocked) and point the map's reader at it
  function bake(render3d_st: mut Render3dState, tm: TileMap, tag: string, k: TmLock) -> string {
    let pattern = Os.temp_dir() + "/r3d_lock_" + tag + "/{tx}_{tz}.lwt"
    if Fs.exists(Os.temp_dir() + "/r3d_lock_" + tag + "/0_0.lwt") { Fs.remove(Os.temp_dir() + "/r3d_lock_" + tag + "/0_0.lwt") }
    expect_eq(tmb_map_locked(render3d_st, tm, pattern, k), 1)
    tmap_mesh_pattern(tm, pattern)
    return pattern
  }

  # the mask, read by the test itself: class of texel (i, j)
  function classes(render3d_st: mut Render3dState) -> []byte {
    let px = png_decode_bytes(render3d_st, render3d_st.r3d_root + "/tests/maps/lock/0_0.mask.png", null)
    expect(px != null)
    expect_eq(render3d_st.tex_w, 128)
    let step = render3d_st.tex_channels * (render3d_st.tex_depth / 8)
    let out = buffer(128 * 128)
    for i in 0 .. 128 * 128 { out[i] = px[i * step] }
    return out
  }
  function locks(c: int) -> bool { return c == 1 or c == 3 or c == 4 or c == 5 }

  # The expanded patch (the reader's scratch: ms.vbuf, ms.ibuf) drawn at every texel centre of the patch into out[j * 64 + i]:
  # every grid triangle (the skirt's left out) rasterised; how many centres no triangle covers (a hole) plus how many two
  # triangles disagree on (more than 1 mm) plus how many triangles are wound unlike the grid's or are slivers.
  function draw(ms: TmMeshes, size: float, out: floats) -> int {
    let tex = size / 64.0
    let hit = words(64 * 64)
    for t in 0 .. 64 * 64 { hit[t] = 0 }
    var nsk = ms.nv - ms.np
    if not ms.locked {
      var n1 = 2
      while n1 * n1 + 4 * (n1 - 1) < ms.nv { n1 += 1 }
      nsk = n1 * n1
    }
    var bad = 0
    var t = 0
    while t + 2 < ms.ni {
      let i0 = ms.ibuf[t];  let i1 = ms.ibuf[t + 1];  let i2 = ms.ibuf[t + 2]
      t += 3
      if i0 >= nsk or i1 >= nsk or i2 >= nsk { continue }
      let x0 = (ms.vbuf[i0 * 8] + size * 0.5) / tex;  let z0 = (ms.vbuf[i0 * 8 + 2] + size * 0.5) / tex
      let x1 = (ms.vbuf[i1 * 8] + size * 0.5) / tex;  let z1 = (ms.vbuf[i1 * 8 + 2] + size * 0.5) / tex
      let x2 = (ms.vbuf[i2 * 8] + size * 0.5) / tex;  let z2 = (ms.vbuf[i2 * 8 + 2] + size * 0.5) / tex
      let cr = (x1 - x0) * (z2 - z0) - (z1 - z0) * (x2 - x0)
      if cr >= 0.0 { bad += 1;  continue }
      # no sliver: twice the area over the longest side squared is at least 0.2 (a graded fan's thinnest is 0.25)
      let e0 = (x1 - x0) * (x1 - x0) + (z1 - z0) * (z1 - z0)
      let e1 = (x2 - x1) * (x2 - x1) + (z2 - z1) * (z2 - z1)
      let e2 = (x0 - x2) * (x0 - x2) + (z0 - z2) * (z0 - z2)
      if -cr / Math.max(e0, Math.max(e1, e2)) < 0.2 { bad += 1 }
      let d = (z1 - z2) * (x0 - x2) + (x2 - x1) * (z0 - z2)
      let ia = max(int(Math.floor(Math.min(x0, Math.min(x1, x2)))), 0);  let ib = min(int(Math.ceil(Math.max(x0, Math.max(x1, x2)))), 64)
      let ja = max(int(Math.floor(Math.min(z0, Math.min(z1, z2)))), 0);  let jb = min(int(Math.ceil(Math.max(z0, Math.max(z1, z2)))), 64)
      for j in ja .. jb {
        for i in ia .. ib {
          let u = float(i) + 0.5;  let v = float(j) + 0.5
          let w0 = ((z1 - z2) * (u - x2) + (x2 - x1) * (v - z2)) / d
          let w1 = ((z2 - z0) * (u - x2) + (x0 - x2) * (v - z2)) / d
          let w2 = 1.0 - w0 - w1
          if w0 < -0.000001 or w1 < -0.000001 or w2 < -0.000001 { continue }
          let h = w0 * ms.vbuf[i0 * 8 + 1] + w1 * ms.vbuf[i1 * 8 + 1] + w2 * ms.vbuf[i2 * 8 + 1]
          if hit[j * 64 + i] == 1 and Math.abs(out[j * 64 + i] - h) > 0.001 { bad += 1 }
          out[j * 64 + i] = h
          hit[j * 64 + i] = 1
        }
      }
    }
    for k in 0 .. 64 * 64 { if hit[k] == 0 { bad += 1 } }
    return bad
  }

  # the worst move of a locked texel (wanted: locked) or an unlocked one, any level against level 0, read back from the file
  # through the game's reader; every level must cover every texel centre once, with no disagreement and the grid's winding
  function worst(render3d_st: mut Render3dState, tm: TileMap, cls: []byte, wanted: bool) -> float {
    let ms = tmm_new(tm, 1)
    let s = tmm_load(ms, tm, 0, 0)
    expect(s >= 0)
    let size = tmap_patch_size(tm)
    let lev0 = floats(64 * 64)
    let got = floats(64 * 64)
    var w = 0.0
    for pz in 0 .. 2 {
      for px in 0 .. 2 {
        expect(tmm_patch(ms, tm, s, 0, 0, px, pz, 0, 0.0))
        expect(not ms.locked)
        expect_eq(draw(ms, size, lev0), 0)
        for lod in 1 .. tm.lod_max + 1 {
          expect(tmm_patch(ms, tm, s, 0, 0, px, pz, lod, 0.0))
          expect_eq(draw(ms, size, got), 0)
          for j in 0 .. 64 {
            for i in 0 .. 64 {
              if locks(int(cls[(pz * 64 + j) * 128 + px * 64 + i])) != wanted { continue }
              w = Math.max(w, Math.abs(got[j * 64 + i] - lev0[j * 64 + i]))
            }
          }
        }
      }
    }
    return w
  }

  test "the fixture locks a road, its sidewalks, a pad and a shore, and leaves the hills free" (render3d_st: mut Render3dState) {
    let cls = classes(render3d_st)
    var n = 0
    for i in 0 .. 128 * 128 { if locks(int(cls[i])) { n += 1 } }
    expect_eq(n, 342 + 1024 + 512 + 750)             # make_lock.py's counts: shore, road, sidewalk, pad
    let tm = open(render3d_st)
    expect_eq(tm.lod_max, 4)
  }

  test "unlocked, the coarse levels move the road and the shore by far more than a centimetre" (render3d_st: mut Render3dState) {
    let tm = open(render3d_st)
    bake(render3d_st, tm, "free", null)
    let w = worst(render3d_st, tm, classes(render3d_st), true)
    print(`  unlocked: a locked texel moves up to {w} m`)
    expect(w > 0.5)
  }

  test "OC-140.I8: locked, every level keeps every locked texel at its level 0 height within 1 cm" (render3d_st: mut Render3dState) {
    let tm = open(render3d_st)
    let k = lock_of(render3d_st)
    bake(render3d_st, tm, "locked", k)
    let w = worst(render3d_st, tm, classes(render3d_st), true)
    print(`  locked: a locked texel moves up to {w} m; {k.locked_levels} of {4 * 4} coarse patch levels are locked meshes; {k.locked} locked texels`)
    expect(w <= 0.01)
    expect_eq(k.locked, 342 + 1024 + 512 + 750)
    expect(k.locked_levels > 0)
    # the free ground still moves: the lock holds levels, it does not flatten or fix the hills
    expect(worst(render3d_st, tm, classes(render3d_st), false) > 0.5)
  }

  test "only the patch levels whose own grid moves a locked texel are locked meshes, and they stay coarse away from it" (render3d_st: mut Render3dState) {
    let tm = open(render3d_st)
    let k = lock_of(render3d_st)
    bake(render3d_st, tm, "kinds", k)
    let ms = tmm_new(tm, 1)
    let s = tmm_load(ms, tm, 0, 0)
    expect(s >= 0)
    var locked = 0
    for pz in 0 .. 2 {
      for px in 0 .. 2 {
        expect(not tmm_locked(ms, tm, s, px, pz, 0))                 # level 0 is always the plain grid
        for lod in 1 .. tm.lod_max + 1 { if tmm_locked(ms, tm, s, px, pz, lod) { locked += 1 } }
      }
    }
    expect_eq(locked, k.locked_levels)
    expect(locked > 0)
    # a locked mesh is far lighter than level 0's grid: cells are cut only along the locked ground's edges and bends
    print(`  {k.locked_levels} locked patch levels: {k.tris} grid triangles where their own grids had {k.tris_own} and level 0 has {k.locked_levels * 2 * 64 * 64}`)
    expect(k.tris < k.locked_levels * 2 * 64 * 64 / 2)
    expect(k.tris >= k.tris_own)
    # the file is version 2, and the reader expands a locked level with its skirt hung from the perimeter
    let raw = Fs.read_bytes(Text.replace(Text.replace(tm.mesh_pattern, "{tx}", "0"), "{tz}", "0"))
    expect_eq(lw_get32(raw, 4), 2)
    for pz in 0 .. 2 {
      for px in 0 .. 2 {
        for lod in 1 .. tm.lod_max + 1 {
          if not tmm_locked(ms, tm, s, px, pz, lod) { continue }
          expect(tmm_patch(ms, tm, s, 0, 0, px, pz, lod, 0.0))
          expect(ms.locked)
          expect(ms.np >= 4 * (64 >> lod))                           # at least the level's own edge points
          let sk = ms.nv - ms.np
          for p in 0 .. ms.np {
            let e = ms.per[p]
            expect(Math.abs(ms.vbuf[(sk + p) * 8] - ms.vbuf[e * 8]) < 0.0001)       # straight below its edge vertex
            expect(ms.vbuf[(sk + p) * 8 + 1] < ms.vbuf[e * 8 + 1] - 0.5)
            # on the patch's edge
            let ga = ms.vga[e];  let gb = ms.vgb[e]
            expect(ga == 0 or ga == 64 or gb == 0 or gb == 64)
          }
          for i in 0 .. ms.ni { expect(ms.ibuf[i] >= 0 and ms.ibuf[i] < ms.nv) }
        }
      }
    }
  }

  test "a locked level's vertices take land-use tones like the plain grid's" (render3d_st: mut Render3dState) {
    let tm = open(render3d_st)
    bake(render3d_st, tm, "tones", lock_of(render3d_st))
    let td = tmd_new(render3d_st, tm, 400.0)
    tmd_tone_set(td, 3, 0.05, 0.05, 0.06)     # road
    tmd_tone_set(td, 2, 0.2, 0.3, 0.1)        # grass
    let s = tmm_load(td.ms, tm, 0, 0)
    var seen = 0
    for lod in 1 .. tm.lod_max + 1 {
      if not tmm_locked(td.ms, tm, s, 0, 0, lod) { continue }
      expect(tmm_patch(td.ms, tm, s, 0, 0, 0, 0, lod, 0.0))
      expect(tmk_colours(render3d_st, td, s, 0, 0, 0, 0, lod))
      let sk = td.ms.nv - td.ms.np
      for v in 0 .. td.ms.nv {
        expect(td.cbuf[v * 4 + 3] == 1.0)
        expect(td.cbuf[v * 4] >= 0.049 and td.cbuf[v * 4] <= 0.51)
      }
      for p in 0 .. td.ms.np { expect(td.cbuf[(sk + p) * 4 + 1] == td.cbuf[td.ms.per[p] * 4 + 1]) }
      seen += 1
    }
    expect(seen > 0)
  }

  test "no mask, or no lock: the bake is byte for byte the unlocked one, a version 1 file whose kind words are 0" (render3d_st: mut Render3dState) {
    let tm = open(render3d_st)
    let a = bake(render3d_st, tm, "plain", null)
    let k = lock_of(render3d_st)
    k.pattern = render3d_st.r3d_root + "/tests/maps/lock/none_{tx}_{tz}.mask.png"
    let b = bake(render3d_st, tm, "nomask", k)
    let ra = Fs.read_bytes(Text.replace(Text.replace(a, "{tx}", "0"), "{tz}", "0"))
    let rb = Fs.read_bytes(Text.replace(Text.replace(b, "{tx}", "0"), "{tz}", "0"))
    expect_eq(len(ra), len(rb))
    var same = true
    for i in 0 .. len(ra) { if ra[i] != rb[i] { same = false } }
    expect(same)
    expect_eq(lw_get32(ra, 4), 1)
    for e in 0 .. 2 * 2 * (tm.lod_max + 1) { expect_eq(lw_get32(ra, LWT_HEAD + e * LWT_ENTRY * 4 + 12), 0) }
    expect_eq(k.locked_levels, 0)
  }

  test "a version 1 file baked before the lock reads each level as its plain grid" (render3d_st: mut Render3dState) {
    let pattern = render3d_st.r3d_root + "/tests/maps/shore/{tx}_{tz}.png"
    let tm = tmap_new(pattern, 64.0, 64, 3, 1, -96.0, -32.0, -10.0, 10.0, 0.0, 200.0)
    tmap_patches(tm, 128)
    tmap_mesh_pattern(tm, tmap_mesh_pattern_of(pattern))
    let ms = tmm_new(tm, 2)
    let s = tmm_load(ms, tm, 0, 0)
    expect(s >= 0)
    for lod in 0 .. tm.lod_max + 1 {
      expect(not tmm_locked(ms, tm, s, 0, 0, lod))
      expect(tmm_patch(ms, tm, s, 0, 0, 0, 0, lod, 0.0))
      expect(not ms.locked)
      let c = tm.patch_texels >> lod
      expect_eq(ms.nv, (c + 1) * (c + 1) + 4 * c)
    }
  }
}
