# kinst_test.ludic - culling and binning at scale, exactly: planes from a real projection, cells culled whole, the
# mesh / card / gone levels by distance, a cap per list, determinism, the floating origin's rebase leaving
# render-space numbers as a fresh add would make them, and the adaptive distance scale settling
import "ludic.render3d/bigworld.ludic"
program KInstTest {
  numbers float
  def InteriorAtlases from "interior_atlases.lres"

  # a camera at (cx, cy, cz) looking toward -z with a 60 degree vertical field, near 0.3, far 5000
  function view_of(out_vp: floats, cx: float, cy: float, cz: float, yaw_deg: float) -> void {
    let proj = m4_new()
    let v = m4_new()
    m4_perspective(proj, Math.deg_to_rad(60.0), 1.5, 0.3, 5000.0)
    let a = Math.deg_to_rad(yaw_deg)
    m4_look_at_xyz(v, cx, cy, cz, cx - Math.sin(a), cy, cz - Math.cos(a), 0.0, 1.0, 0.0)
    m4_mul(out_vp, proj, v)
  }

  function culler() -> KCull {
    let k = kinst_new(3)
    kinst_kit(k, 0, 100.0, 600.0, 8.0, true)       # a house
    kinst_kit(k, 1, 200.0, 1500.0, 20.0, true)     # a block
    kinst_kit(k, 2, 300.0, 3000.0, 60.0, false)    # a tower: no card, gone past near
    return k
  }

  # a cell of n things on a lattice at spacing `step`, kit by index modulo `kits`
  function lattice(cx: int, cz: int, n: int, step: float, kits: int) -> CellContent {
    let c = cell_content_new(cx, cz, 512.0, n)
    let side = int(Math.ceil(Math.sqrt(float(n))))
    for i in 0 .. n {
      cell_add(c, i % kits, 4.0 + float(i % side) * step, 0.0, 4.0 + float(i / side) * step, float(i) * 0.05, 1.0, cell_rgba(255, 200, 100, 255), i, 0)
    }
    return c
  }

  test "planes from a projection: a point ahead is inside all six, one behind or far is not" {
    let vp = m4_new()
    view_of(vp, 0.0, 10.0, 0.0, 0.0)
    let pl = floats(24)
    kinst_planes(vp, pl)
    expect(kinst_sphere_in(pl, 0.0, 10.0, -100.0, 1.0))
    expect(not kinst_sphere_in(pl, 0.0, 10.0, 100.0, 1.0))         # behind
    expect(not kinst_sphere_in(pl, 0.0, 10.0, -6000.0, 1.0))       # past far
    expect(not kinst_sphere_in(pl, 500.0, 10.0, -100.0, 1.0))      # far to the right of a 60 degree view
    expect(kinst_sphere_in(pl, 500.0, 10.0, -100.0, 450.0))        # but a big enough sphere reaches in
    expect(not kinst_sphere_in(pl, 0.0, 500.0, -100.0, 1.0))
  }

  test "distance picks the level: mesh inside near, card to far, nothing beyond" {
    let k = culler()
    let c = cell_content_new(0, 0, 512.0, 8)
    cell_add(c, 0, 0.0, 0.0, -50.0, 0.0, 1.0, 0, 0, 0)       # 50 m: mesh
    cell_add(c, 0, 0.0, 0.0, -300.0, 0.0, 1.0, 0, 0, 0)      # 300 m: card (near 100, far 600)
    cell_add(c, 0, 0.0, 0.0, -700.0, 0.0, 1.0, 0, 0, 0)      # past far: gone
    cell_add(c, 2, 0.0, 0.0, -200.0, 0.0, 1.0, 0, 0, 0)      # tower at 200 m: near is 300: mesh
    cell_add(c, 2, 0.0, 0.0, -400.0, 0.0, 1.0, 0, 0, 0)      # tower at 400 m: no card: gone
    kinst_add_cell(k, 7, c, 0.0, 0.0, 0.0)
    let vp = m4_new()
    view_of(vp, 0.0, 10.0, 0.0, 0.0)
    kinst_begin(k, vp, 0.0, 10.0, 0.0)
    expect_eq(kinst_cull(k), 3)
    expect_eq(kinst_bin_count(k, 0, KI_MESH), 1)
    expect_eq(kinst_bin_count(k, 0, KI_CARD), 1)
    expect_eq(kinst_bin_count(k, 2, KI_MESH), 1)
    expect_eq(kinst_bin_count(k, 2, KI_CARD), 0)
  }

  test "what is behind the camera or to the side is culled, and whole cells go by their box" {
    let k = culler()
    let behind = lattice(0, 1, 100, 4.0, 1)       # cell (0, 1): z in 512 .. 1024: behind a camera at the origin looking -z
    kinst_add_cell(k, 1, behind, 0.0, 0.0, 512.0)
    let ahead = lattice(0, -1, 100, 4.0, 1)       # z in -512 .. 0
    kinst_add_cell(k, 2, ahead, 0.0, 0.0, -512.0)
    let vp = m4_new()
    view_of(vp, 200.0, 10.0, 10.0, 0.0)
    kinst_begin(k, vp, 200.0, 10.0, 10.0)
    let vis = kinst_cull(k)
    expect(vis > 0)
    expect_eq(k.cells_tested, 2)
    expect_eq(k.cells_culled, 1)                   # the cell behind was skipped without a look at its hundred things
    expect(k.tested <= 100)
  }

  test "the same view twice gives the same lists" {
    let k = culler()
    kinst_add_cell(k, 1, lattice(0, -1, 400, 5.0, 3), 0.0, 0.0, -512.0)
    let vp = m4_new()
    view_of(vp, 100.0, 10.0, 0.0, 10.0)
    kinst_begin(k, vp, 100.0, 10.0, 0.0)
    let a = kinst_cull(k)
    var sum = 0.0
    for b in 0 .. 6 { for q in 0 .. kinst_bin_count(k, b / 2, b % 2) * KI_FLOATS { sum = sum + kinst_bin(k, b / 2, b % 2)[q] } }
    kinst_begin(k, vp, 100.0, 10.0, 0.0)
    let b2 = kinst_cull(k)
    var sum2 = 0.0
    for b in 0 .. 6 { for q in 0 .. kinst_bin_count(k, b / 2, b % 2) * KI_FLOATS { sum2 = sum2 + kinst_bin(k, b / 2, b % 2)[q] } }
    expect_eq(a, b2)
    expect(sum == sum2)
  }

  test "records in a list are render space, with yaw as sin and cos, tint and variation carried" {
    let k = culler()
    let c = cell_content_new(3, -2, 512.0, 2)
    cell_add(c, 1, 10.0, 2.0, 20.0, 0.5, 1.5, cell_rgba(255, 0, 128, 255), 12345, 7)
    kinst_add_cell(k, 0, c, 1000.0, 0.0, -2000.0)        # the cell's corner in render space
    let vp = m4_new()
    view_of(vp, 1010.0, 10.0, -1950.0, 0.0)
    kinst_begin(k, vp, 1010.0, 10.0, -1950.0)
    expect_eq(kinst_cull(k), 1)
    let r = kinst_bin(k, 1, KI_MESH)
    expect(r[0] == 1010.0 and r[1] == 2.0 and r[2] == -1980.0 and r[3] == 1.5)
    expect_near(r[4], Math.sin(0.5), 0.0001)
    expect_near(r[5], Math.cos(0.5), 0.0001)
    expect_near(r[6], 12345.0 / 65536.0, 0.0001)
    expect(r[7] == 7.0)
    expect_near(r[8], 1.0, 0.0001)
    expect_near(r[9], 0.0, 0.0001)
    expect_near(r[10], 128.0 / 255.0, 0.001)
    expect(r[11] == 12345.0)
  }

  test "a cap on a list counts what it refuses" {
    let k = culler()
    k.max_per_bin = 50
    kinst_add_cell(k, 1, lattice(0, -1, 400, 1.0, 1), 0.0, 0.0, -512.0)   # 400 houses within a few metres: mesh list
    let vp = m4_new()
    view_of(vp, 10.0, 10.0, 10.0, 0.0)
    kinst_begin(k, vp, 10.0, 10.0, 10.0)
    let vis = kinst_cull(k)
    expect_eq(kinst_bin_count(k, 0, KI_MESH) + kinst_bin_count(k, 0, KI_CARD), vis)
    expect(kinst_bin_count(k, 0, KI_MESH) <= 50 and kinst_bin_count(k, 0, KI_CARD) <= 50)
    expect(k.overflow > 0)
    expect(vis + k.overflow <= k.tested)
  }

  test "cells come and go, and the rebase keeps the lists exactly what a fresh add would make" {
    let o = forg_new(256.0, 1024.0)
    forg_reset(o, 50000.0, 0.0, 50000.0)
    let k = culler()
    let cx = 97
    let cz = 97
    let c = lattice(cx, cz, 200, 6.0, 2)
    kinst_add_cell(k, 5, c, cell_render_x(o, cx, 512.0), 0.0, cell_render_z(o, cz, 512.0))
    expect_eq(kinst_cell_count(k), 1)
    # the camera near the cell, in render space
    let camx = float(double(cx * 512) + 40.0 - o.ox)
    let camz = float(double(cz * 512) + 60.0 - o.oz)
    let vp = m4_new()
    view_of(vp, camx, 10.0, camz, 0.0)
    kinst_begin(k, vp, camx, 10.0, camz)
    let a = kinst_cull(k)
    expect(a > 0)
    let first = floats(a * KI_FLOATS)
    var at = 0
    for b in 0 .. 6 { for q in 0 .. kinst_bin_count(k, b / 2, b % 2) * KI_FLOATS { first[at] = kinst_bin(k, b / 2, b % 2)[q];  at += 1 } }
    # the origin moves (the camera walked a kilometre away and back: force a rebase by teleporting)
    forg_update(o, 52000.0, 0.0, 52000.0)
    kinst_rebase(k, o.shift_x, o.shift_y, o.shift_z)
    # the same world point, the camera in the new render space
    let camx2 = float(double(cx * 512) + 40.0 - o.ox)
    let camz2 = float(double(cz * 512) + 60.0 - o.oz)
    view_of(vp, camx2, 10.0, camz2, 0.0)
    kinst_begin(k, vp, camx2, 10.0, camz2)
    let b2 = kinst_cull(k)
    expect_eq(a, b2)
    # every position is the old one minus the shift, exactly; everything else identical
    at = 0
    var same = true
    for b in 0 .. 6 {
      for q in 0 .. kinst_bin_count(k, b / 2, b % 2) {
        let r = kinst_bin(k, b / 2, b % 2)
        let f = q * KI_FLOATS
        if r[f] != first[at + 0] - o.shift_x or r[f + 2] != first[at + 2] - o.shift_z or r[f + 1] != first[at + 1] { same = false }
        for j in 3 .. KI_FLOATS { if r[f + j] != first[at + j] { same = false } }
        at += KI_FLOATS
      }
    }
    expect(same)
    expect(kinst_remove_cell(k, 5))
    expect(not kinst_remove_cell(k, 5))
    expect_eq(kinst_cell_count(k), 0)
  }

  test "a cell added twice under one slot is replaced, not doubled" {
    let k = culler()
    kinst_add_cell(k, 3, lattice(0, 0, 10, 4.0, 1), 0.0, 0.0, 0.0)
    kinst_add_cell(k, 3, lattice(0, 0, 20, 4.0, 1), 0.0, 0.0, 0.0)
    expect_eq(kinst_cell_count(k), 1)
    expect_eq(kinst_total(k), 20)
  }

  test "a hundred thousand instances: cells behind or out of reach cost nothing, the rest are the ones in view" {
    let k = culler()
    # 100 cells of 1000 things, a 10 x 10 block of cells 512 m across; the camera sits at one corner looking along -z
    var slot = 0
    for j in 0 .. 10 {
      for i in 0 .. 10 {
        kinst_add_cell(k, slot, lattice(i, -1 - j, 1000, 15.0, 3), float(i) * 512.0, 0.0, -512.0 * float(j + 1))
        slot += 1
      }
    }
    expect_eq(kinst_total(k), 100000)
    let vp = m4_new()
    view_of(vp, 0.0, 15.0, 0.0, 0.0)
    kinst_begin(k, vp, 0.0, 15.0, 0.0)
    let vis = kinst_cull(k)
    expect(vis > 0 and vis < 100000)
    expect(k.cells_culled > 50)                # most cells are out of reach or out of view
    expect(k.tested < 60000)
    # with a shorter scale, strictly less is drawn
    k.scale = 0.5
    kinst_begin(k, vp, 0.0, 15.0, 0.0)
    let vis2 = kinst_cull(k)
    expect(vis2 < vis)
  }

  test "the adaptive scale moves toward a target and settles inside its dead band" {
    let k = culler()
    kinst_add_cell(k, 1, lattice(0, -1, 2000, 2.5, 3), 0.0, 0.0, -512.0)
    let vp = m4_new()
    view_of(vp, 0.0, 20.0, 0.0, 0.0)
    var seen = 0
    for f in 0 .. 60 {
      kinst_begin(k, vp, 0.0, 20.0, 0.0)
      seen = kinst_cull(k)
      kinst_adapt(k, 300, 0.05)
    }
    expect(k.scale < 1.0)
    expect(seen <= 300 or k.scale <= 0.26)
    # once settled it stops moving
    let s = k.scale
    for f in 0 .. 10 {
      kinst_begin(k, vp, 0.0, 20.0, 0.0)
      kinst_cull(k)
      kinst_adapt(k, 300, 0.05)
    }
    expect(Math.abs(k.scale - s) < 0.12)
    # an empty view lets the scale grow back to 1
    let e = culler()
    e.scale = 0.4
    for f in 0 .. 30 {
      kinst_begin(e, vp, 0.0, 20.0, 0.0)
      kinst_cull(e)
      kinst_adapt(e, 300, 0.05)
    }
    expect(e.scale == 1.0)
  }

  test "kits from the map's rows" {
    let rows = new RenderKits
    expect(render_kits_load(rows, "city"))
    let k = kinst_new(3)
    kinst_kits_from(k, rows.rows)
    expect(k.kit_near[1] == 500.0 and k.kit_far[2] == 8000.0)
    expect(k.kit_rad[0] > 6.0 and k.kit_rad[0] < 10.0)        # half the diagonal of 10 x 8 x 7
  }
}
