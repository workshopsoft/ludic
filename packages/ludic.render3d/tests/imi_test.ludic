# imi_test.ludic - interior mapping's rules: a window always shows the same room, rooms spread evenly and neighbours
# differ, lights switch on one by one as night deepens and never switch off again, the ray meets the room's box on
# the right face at the right place, and atlas uvs stay inside their face of their tile
import "ludic.render3d/bigworld.ludic"
program ImiTest {
  numbers float

  test "the hash is PCG: known values, wrapped 32-bit, logical shifts" {
    # reference values of pcg(v) for v = 0, 1, 2 (the shader's uint arithmetic), as signed 32-bit words
    expect_eq(imi_pcg(0), 129708002)
    expect_eq(imi_pcg(1), -1463883204)
    expect_eq(imi_pcg(2), 2055130248)
    expect_eq(imi_pcg(12345), -195121906)
  }

  test "the window hash equals the shader's uint arithmetic: golden values from an independent 32-bit implementation" {
    # computed outside Ludic with the shader's parenthesised form, (seed * a) ^ (wall * b), each product wrapped to 32 bits
    expect_eq(imi_hash(12345, 2, 3, -7, 0), -263961895)
    expect_eq(imi_hash(12345, 2, 3, -7, 1), -1198391983)
    expect_eq(imi_hash(99, 0, -100, 40, 2), 1470913944)
    expect_eq(imi_hash(65535, 3, 1000, 5, 0), 169947113)
    expect_eq(imi_room(14, 12345, 2, 3, -7), 13)
    expect_eq(imi_room(14, 65535, 3, 1000, 5), 0)
  }

  test "a window's room is a pure function of where it is: the same every call" {
    for c in 0 .. 50 {
      let a = imi_room(14, 7777, 2, c - 25, c % 9)
      let b = imi_room(14, 7777, 2, c - 25, c % 9)
      expect_eq(a, b)
      expect(a >= 0 and a < 14)
    }
    expect_eq(imi_room(1, 5, 0, 3, 3), 0)
  }

  test "rooms are spread evenly over a facade" {
    let rooms = 14
    let counts = words(rooms)
    let total = 100 * 40
    for cx in 0 .. 100 { for cy in 0 .. 40 { counts[imi_room(rooms, 4242, 2, cx, cy)] += 1 } }
    let mean = float(total) / float(rooms)
    for r in 0 .. rooms {
      expect(float(counts[r]) > mean * 0.75 and float(counts[r]) < mean * 1.25)
    }
  }

  test "neighbouring windows and floors differ, and two buildings differ" {
    let rooms = 16
    var same_h = 0
    var same_v = 0
    var same_b = 0
    for cx in 0 .. 60 {
      for cy in 0 .. 60 {
        if imi_room(rooms, 99, 2, cx, cy) == imi_room(rooms, 99, 2, cx + 1, cy) { same_h += 1 }
        if imi_room(rooms, 99, 2, cx, cy) == imi_room(rooms, 99, 2, cx, cy + 1) { same_v += 1 }
        if imi_room(rooms, 99, 2, cx, cy) == imi_room(rooms, 100, 2, cx, cy) { same_b += 1 }
      }
    }
    # chance alone is 1/16 of 3600 = 225
    expect(same_h < 330 and same_v < 330 and same_b < 330)
    # and walls of one building differ from each other
    var same_w = 0
    for cx in 0 .. 60 { for cy in 0 .. 60 { if imi_room(rooms, 99, 0, cx, cy) == imi_room(rooms, 99, 1, cx, cy) { same_w += 1 } } }
    expect(same_w < 330)
  }

  test "no lights by day, night_lit of them at full night, and a light that is on stays on as night deepens" {
    var day = 0
    var full = 0
    for cx in 0 .. 100 {
      for cy in 0 .. 50 {
        if imi_lit(0.0, 0.6, 31, 2, cx, cy) { day += 1 }
        if imi_lit(1.0, 0.6, 31, 2, cx, cy) { full += 1 }
      }
    }
    expect_eq(day, 0)
    expect(float(full) > 5000.0 * 0.6 * 0.9 and float(full) < 5000.0 * 0.6 * 1.1)
    var back = 0
    for cx in 0 .. 60 {
      for cy in 0 .. 40 {
        var was = false
        for step in 0 .. 11 {
          let lit = imi_lit(float(step) / 10.0, 0.5, 31, 0, cx, cy)
          if was and not lit { back += 1 }
          was = lit
        }
      }
    }
    expect_eq(back, 0)
  }

  test "night follows the sun: zero in daylight, one well below the horizon, smooth between" {
    expect(imi_night(0.6) == 0.0)
    expect(imi_night(0.06) == 0.0)
    expect(imi_night(-0.3) == 1.0)
    var last = -1.0
    var y = 0.2
    while y > -0.3 {
      let n = imi_night(y)
      expect(n >= last)
      last = n
      y = y - 0.01
    }
    expect(imi_night(-0.04) > 0.3 and imi_night(-0.04) < 0.7)
  }

  test "walls are told apart by their normals, and u grows to the viewer's right" {
    expect_eq(imi_wall(1.0, 0.0, 0.0), 0)
    expect_eq(imi_wall(-1.0, 0.0, 0.0), 1)
    expect_eq(imi_wall(0.0, 0.0, 1.0), 2)
    expect_eq(imi_wall(0.0, 0.0, -1.0), 3)
    expect_eq(imi_wall(0.0, 1.0, 0.0), -1)
    expect_eq(imi_wall(0.7, 0.0, 0.7), -1)
    # looking at the +z wall from outside (from +z toward -z), right is +x
    expect(imi_facade_u(2, 5.0, 10.0) == 5.0)
    # looking at the +x wall from outside (from +x toward -x), right is -z
    expect(imi_facade_u(0, 10.0, 5.0) == -5.0)
    expect(imi_facade_u(1, 10.0, 5.0) == 5.0)
    expect(imi_facade_u(3, 5.0, -10.0) == -5.0)
  }

  test "window cells and the glass inside them" {
    let c = floats(4)
    imi_cell(7.5, 10.0, 3.0, 3.2, c)
    expect(c[0] == 2.0 and c[1] == 3.0)
    expect_near(c[2], 1.5, 0.0001)
    expect_near(c[3], 0.4, 0.0001)
    imi_cell(-0.5, -0.1, 3.0, 3.2, c)          # below zero: the cell before
    expect(c[0] == -1.0 and c[1] == -1.0)
    expect_near(c[2], 2.5, 0.0001)
    expect(imi_glass(1.5, 1.6, 3.0, 3.2, 0.1))
    expect(not imi_glass(0.1, 1.6, 3.0, 3.2, 0.1))        # the frame
    expect(not imi_glass(1.5, 3.1, 3.0, 3.2, 0.1))
    expect(imi_glass(1.5, 1.6, 3.0, 3.2, 0.0))
  }

  test "a ray straight in meets the back wall's middle; a slanted one meets the side it is heading for" {
    let o = floats(4)
    imi_hit(3.0, 3.0, 4.0, 1.5, 1.5, 0.0, 0.0, 1.0, o)
    expect(o[0] == float(IMI_BACK))
    expect_near(o[1], 0.5, 0.0001)
    expect_near(o[2], 0.5, 0.0001)
    expect_near(o[3], 4.0, 0.0001)
    imi_hit(3.0, 3.0, 4.0, 1.5, 1.5, -1.0, 0.0, 0.5, o)    # left and in: reaches x = 0 at t = 1.5, z = 0.75
    expect(o[0] == float(IMI_LEFT))
    expect_near(o[1], 1.0 - 0.75 / 4.0, 0.001)
    expect_near(o[2], 0.5, 0.001)
    imi_hit(3.0, 3.0, 4.0, 1.5, 1.5, 1.0, 0.0, 0.5, o)
    expect(o[0] == float(IMI_RIGHT))
    imi_hit(3.0, 3.0, 4.0, 1.5, 1.5, 0.0, 1.0, 0.5, o)
    expect(o[0] == float(IMI_CEIL))
    imi_hit(3.0, 3.0, 4.0, 1.5, 1.5, 0.0, -1.0, 0.5, o)
    expect(o[0] == float(IMI_FLOOR))
  }

  test "every ray ends on the box: the hit point is on the ray, on the face it names, inside the room" {
    let o = floats(4)
    var bad = 0
    for a in 0 .. 40 {
      for b in 0 .. 40 {
        let px = 0.05 + float(a) * 0.0737
        let py = 0.05 + float(b) * 0.0737
        let ax = (float(a) - 20.0) * 0.11
        let ay = (float(b) - 20.0) * 0.11
        var dx = ax
        var dy = ay
        var dz = 1.0
        let l = Math.sqrt(dx * dx + dy * dy + dz * dz)
        dx = dx / l;  dy = dy / l;  dz = dz / l
        imi_hit(3.0, 3.0, 4.5, px, py, dx, dy, dz, o)
        let t = o[3]
        let x = px + dx * t
        let y = py + dy * t
        let z = dz * t
        if t <= 0.0 { bad += 1 }
        if x < -0.001 or x > 3.001 or y < -0.001 or y > 3.001 or z < -0.001 or z > 4.501 { bad += 1 }
        let f = int(o[0])
        if f == IMI_BACK and Math.abs(z - 4.5) > 0.001 { bad += 1 }
        if f == IMI_LEFT and Math.abs(x) > 0.001 { bad += 1 }
        if f == IMI_RIGHT and Math.abs(x - 3.0) > 0.001 { bad += 1 }
        if f == IMI_FLOOR and Math.abs(y) > 0.001 { bad += 1 }
        if f == IMI_CEIL and Math.abs(y - 3.0) > 0.001 { bad += 1 }
        if o[1] < 0.0 or o[1] > 1.0 or o[2] < 0.0 or o[2] > 1.0 { bad += 1 }
      }
    }
    expect_eq(bad, 0)
  }

  test "atlas uvs stay inside their face of their room's tile" {
    let cols = 4
    let rows = 4
    let out = floats(2)
    var bad = 0
    for room in 0 .. 14 {
      for face in 0 .. 5 {
        let fc = floats(2)
        imi_face_cell(face, fc)
        let x0 = (float(room % cols) + fc[0] / 3.0) / float(cols)
        let x1 = (float(room % cols) + (fc[0] + 1.0) / 3.0) / float(cols)
        let y0 = (float(room / cols) + fc[1] / 2.0) / float(rows)
        let y1 = (float(room / cols) + (fc[1] + 1.0) / 2.0) / float(rows)
        for k in 0 .. 11 {
          imi_atlas_uv(cols, rows, room, face, float(k) / 10.0, float(10 - k) / 10.0, 0.01, out)
          if out[0] < x0 or out[0] > x1 or out[1] < y0 or out[1] > y1 { bad += 1 }
        }
      }
    }
    expect_eq(bad, 0)
    # no two faces of a tile share a cell
    let seen = words(6)
    for face in 0 .. 5 {
      let fc = floats(2)
      imi_face_cell(face, fc)
      seen[int(fc[1]) * 3 + int(fc[0])] += 1
    }
    var used = 0
    for i in 0 .. 6 { if seen[i] == 1 { used += 1 } }
    expect_eq(used, 5)
  }

  test "room brightness: day is 1, unlit night is dark, lit night is bright" {
    expect(imi_room_gain(0.0, false, 0.05, 2.2) == 1.0)
    expect(imi_room_gain(0.0, true, 0.05, 2.2) == 1.0)
    expect_near(imi_room_gain(1.0, false, 0.05, 2.2), 0.05, 0.0001)
    expect_near(imi_room_gain(1.0, true, 0.05, 2.2), 2.2, 0.0001)
    expect(imi_room_gain(0.5, true, 0.05, 2.2) > imi_room_gain(0.5, false, 0.05, 2.2))
  }
}
