# glb_test.ludic - a binary glTF opened through the same path as a .gltf with its .bin: the two forms of one
# triangle (tests/models) answer the same accessors, the BIN chunk is found by the header and not by the name, a
# reader that comes after the load (ludic.anim's clips) reopens the right bytes, and a damaged file is refused
# with nothing left open. No device: the loader's document and accessor path only.
import "ludic.render3d/r3d.ludic"
program GlbTest {
  numbers float
  function links_runtime() -> bool { return Input.key_pressed(0) }

  function models(render3d_st: Render3dState) -> string { return render3d_st.r3d_root + "/tests/models" }

  function tri_ok(render3d_st: mut Render3dState) -> bool {
    let p = gltf_accessor_floats(render3d_st, 0)
    let n = gltf_accessor_floats(render3d_st, 1)
    if len(p) != 9 or len(n) != 9 { return false }
    if p[0] != 0.0 or p[3] != 2.0 or p[7] != 3.0 or p[8] != 1.0 or p[1] != 0.0 or p[4] != 0.0 { return false }
    for i in 0 .. 9 {
      var w = 0.0
      if i % 3 == 2 { w = 1.0 }
      if n[i] != w { return false }
    }
    return gltf_accessor_count(render3d_st, 2) == 3
  }

  test "a .gltf and its .glb answer the same accessors" (render3d_st: mut Render3dState) {
    let dir = models(render3d_st)
    expect(gltf_open(render3d_st, dir, "tri.gltf"))
    expect_eq(render3d_st.gltf_bin_base, 0)
    expect(tri_ok(render3d_st))
    file_close(render3d_st.gltf_bin)
    expect(gltf_open(render3d_st, dir, "tri.glb"))
    expect(render3d_st.gltf_bin_base > 20)
    expect(tri_ok(render3d_st))
    file_close(render3d_st.gltf_bin)
  }

  test "a glb is told by its first bytes, not its name" (render3d_st: mut Render3dState) {
    let at = Os.temp_dir() + "/r3d_glb_name"
    Fs.mkdir(at)
    expect(Fs.copy(models(render3d_st) + "/tri.glb", at + "/whatever.gltf"))
    expect(gltf_open(render3d_st, at, "whatever.gltf"))
    expect(tri_ok(render3d_st))
    file_close(render3d_st.gltf_bin)
  }

  test "the same file opened again keeps its parsed document, the binary is read afresh" (render3d_st: mut Render3dState) {
    let dir = models(render3d_st)
    keeps(render3d_st, dir, "tri.glb")
    keeps(render3d_st, dir, "tri.gltf")
  }
  function keeps(render3d_st: mut Render3dState, dir: string, name: string) -> void {
    expect(gltf_open(render3d_st, dir, name))
    let first = render3d_st.gltf_doc
    expect(tri_ok(render3d_st))
    file_close(render3d_st.gltf_bin)
    expect(gltf_open(render3d_st, dir, name))
    expect(render3d_st.gltf_doc == first)                  # not parsed again
    expect(tri_ok(render3d_st))                            # and the binary reads right
    file_close(render3d_st.gltf_bin)
  }

  test "another file, or the same path changed, is parsed anew" (render3d_st: mut Render3dState) {
    let dir = Os.temp_dir() + "/r3d_glb_keep"
    Fs.mkdir(dir)
    let good = Fs.read_bytes(models(render3d_st) + "/tri.glb")
    let n = Fs.size(models(render3d_st) + "/tri.glb")
    expect(Fs.write_bytes(dir + "/a.glb", good, n))
    expect(gltf_open(render3d_st, dir, "a.glb"))
    file_close(render3d_st.gltf_bin)
    expect(render3d_st.gltf_doc_key == dir + "/a.glb")
    expect(Fs.copy(models(render3d_st) + "/tri.glb", dir + "/b.glb"))
    expect(gltf_open(render3d_st, dir, "b.glb"))
    expect(render3d_st.gltf_doc_key == dir + "/b.glb")
    expect(tri_ok(render3d_st))
    file_close(render3d_st.gltf_bin)
    # a document set by hand is never mistaken for the kept one
    render3d_st.gltf_doc = Json.parse("{\"nodes\": []}")
    expect(gltf_open(render3d_st, dir, "b.glb"))
    expect(value_has(render3d_st.gltf_doc, "accessors") != 0)
    expect(tri_ok(render3d_st))
    file_close(render3d_st.gltf_bin)
  }

  test "the binary reopens after a load closed it, for a .glb and a .gltf" (render3d_st: mut Render3dState) {
    let dir = models(render3d_st)
    reopens(render3d_st, dir, "tri.glb")
    reopens(render3d_st, dir, "tri.gltf")
  }
  function reopens(render3d_st: mut Render3dState, dir: string, name: string) -> void {
    expect(gltf_open(render3d_st, dir, name))
    file_close(render3d_st.gltf_bin)
    render3d_st.gltf_bin = null
    expect(gltf_bin_reopen(render3d_st, dir))
    expect(tri_ok(render3d_st))
    file_close(render3d_st.gltf_bin)
    render3d_st.gltf_bin = null
  }

  test "the header is read: chunk places and lengths" {
    let f = file_open("packages/ludic.render3d/tests/models/tri.glb", "rb")
    expect(f != null)
    let out = words(4)
    expect(glb_scan(f, 696, out))
    expect_eq(out[0], 20)
    expect_eq(out[2], 696 - 80)
    expect_eq(out[3], 80)
    expect_eq(out[0] + out[1] + 8, out[2])
    expect(not glb_scan(f, 600, out))                       # a file shorter than its header says
    file_close(f)
  }

  test "a damaged or foreign file is refused" (render3d_st: mut Render3dState) {
    let dir = Os.temp_dir() + "/r3d_glb_bad"
    Fs.mkdir(dir)
    let good = Fs.read_bytes(models(render3d_st) + "/tri.glb")
    expect(good != null)
    let n = len(good)
    # cut short: the BIN chunk overruns the file
    expect(Fs.write_bytes(dir + "/cut.glb", good, n - 10))
    expect(not gltf_open(render3d_st, dir, "cut.glb"))
    # the version is 3
    good[4] = 3
    expect(Fs.write_bytes(dir + "/v3.glb", good, n))
    expect(not gltf_open(render3d_st, dir, "v3.glb"))
    good[4] = 2
    # a JSON chunk longer than the file
    good[12] = 255;  good[13] = 255
    expect(Fs.write_bytes(dir + "/long.glb", good, n))
    expect(not gltf_open(render3d_st, dir, "long.glb"))
    expect(not gltf_open(render3d_st, dir, "missing.glb"))
    # still fine afterwards
    expect(gltf_open(render3d_st, models(render3d_st), "tri.glb"))
    expect(tri_ok(render3d_st))
    file_close(render3d_st.gltf_bin)
  }

  test "COLOR_0 of a glb reads as RGBA8, white-alpha when vec3, float and ushort forms agree" (render3d_st: mut Render3dState) {
    expect(gltf_open(render3d_st, models(render3d_st), "vcol.glb"))
    let data = gltf_accessor(render3d_st, 1)
    expect_eq(render3d_st.gltf_count, 3)
    expect_eq(render3d_st.gltf_comps, 4)
    expect_eq(render3d_st.gltf_ctype, 5121)
    let rgba = gltf_colour_rgba8(data, 3, 4, 5121)
    expect_eq(gltf_byte_at(rgba, 0), 255);  expect_eq(gltf_byte_at(rgba, 1), 0);   expect_eq(gltf_byte_at(rgba, 3), 255)
    expect_eq(gltf_byte_at(rgba, 5), 255);  expect_eq(gltf_byte_at(rgba, 7), 128)
    expect_eq(gltf_byte_at(rgba, 10), 255)
    gltf_bytes_free(rgba)
    # the same bytes as a vec3 of unsigned bytes: alpha is 1, vertex 1 starts at the fourth byte
    let v3 = gltf_colour_rgba8(data, 3, 3, 5121)
    expect_eq(gltf_byte_at(v3, 0), 255);  expect_eq(gltf_byte_at(v3, 3), 255);  expect_eq(gltf_byte_at(v3, 4), 255)
    gltf_bytes_free(v3)
    gltf_bytes_free(data)
    # floats: 0.5 -> 128, out of range clamps
    let f = floats(3)
    f[0] = 0.5;  f[1] = 2.0;  f[2] = -1.0
    let fr = gltf_colour_floats(f, 1, 3)
    expect_eq(gltf_byte_at(fr, 0), 128);  expect_eq(gltf_byte_at(fr, 1), 255);  expect_eq(gltf_byte_at(fr, 2), 0);  expect_eq(gltf_byte_at(fr, 3), 255)
    gltf_bytes_free(fr)
    file_close(render3d_st.gltf_bin)
  }

  test "an image embedded in a glb is found by its bufferView and decodes; materials own their textures" (render3d_st: mut Render3dState) {
    expect(gltf_open(render3d_st, models(render3d_st), "emb.glb"))
    let mats = value_get(render3d_st.gltf_doc, "materials")
    let denim = value_at(mats, 0)
    expect(gltf_mat_uri(render3d_st, denim, "baseColorTexture") == null)
    expect_eq(gltf_mat_bv(render3d_st, denim, "baseColorTexture"), 3)
    expect_eq(gltf_mat_bv(render3d_st, denim, "normalTexture"), -1)
    # read the bytes the way gltf_texture_bv does and decode them
    let n = jint(value_at(value_get(render3d_st.gltf_doc, "bufferViews"), 3), "byteLength", 0)
    let buf = gltf_view_bytes(render3d_st, 3)
    let j = png_parse_mem(render3d_st, buf, n, "emb.glb#3")
    expect(j != null)
    j.z = tex_z(render3d_st, 0)
    png_work(j)
    let px = png_take(render3d_st, j)
    expect(px != null)
    expect_eq(render3d_st.tex_w, 2);  expect_eq(render3d_st.tex_h, 2);  expect_eq(render3d_st.tex_channels, 4)
    expect_eq(gltf_byte_at(px, 0), 255);  expect_eq(gltf_byte_at(px, 1), 0)
    expect_eq(gltf_byte_at(px, 5), 255);  expect_eq(gltf_byte_at(px, 11), 255);  expect_eq(gltf_byte_at(px, 15), 128)
    gltf_bytes_free(px)
    # a colour of its own, other than white, keeps a material off the name cache; white does not
    expect(gltf_mat_has_colour(value_at(mats, 1)))
    expect(not gltf_mat_has_colour(value_at(mats, 2)))
    expect(not gltf_mat_has_colour(denim))
    file_close(render3d_st.gltf_bin)
  }
}
