# ============================================================================
# strands.ludic — a groom's strands (a MetaHuman's brows and lashes), as Unreal's hair strands drawn forward.
#
# An actor marked strands (actor.strands) is a mesh of ribbons: each strand point twice, its tangent times its radius, its side, the skin's
# normal at its root and the strand's seed (skin.vert STRANDS). Unreal widens each ribbon toward the camera to the least radius a strand
# is rasterised at (ComputeMinStrandRadiusAtDepth1: half of r.HairStrands.RasterizationScale 0.5 x SampleCountToSubPixelSize x a pixel).
# Its default path (HairVisibilityRenderMode_MSAA_Visibility), here, after the opaque scene, its subsurface and the eyes' shells:
#   the transmittance (one sample, a quarter pixel's radius): each strand's 1 - r / max(r, that radius) multiplied in, depth-tested
#     against the scene and writing none (HairStrandsVisibilityPS TRANSMITTANCE)
#   the visibility (eight samples, a sixteenth of a pixel's radius): the strands depth-tested among themselves into a multisampled
#     target, so each sample holds its front strand alone. Unreal stores that strand's id and lights each distinct one once, weighted
#     by the samples it holds over the samples hit (HairStrandsVisibilityCompaction); the hardware does the same here: each strand lit
#     once a pixel (strands.frag: Epic's HairShading with the dual scattering, the sky over the sphere) into the samples it won, and
#     the resolve's average over the samples hit is that weighted sum
#   the composition over the scene (strands_resolve.frag: the pixel's coverage from the transmittance at the threshold 0.98, its colour
#     the visibility samples', premultiplied over)
# The targets are made when a groom is first in view; the dual scattering LUT (hair_lut.frag) is drawn then, once.
# The cost cuts after Unreal's, each ON unless its variable is 0:
#   R3D_HAIR_VIS: the visibility split as MSAA_Visibility does it. The visibility pass first takes the scene's depth into every sample
#     (HairStrandsVisibility.cpp AddHairVisibilityFillOpaqueDepth), so the hardware culls what the scene hides; a head of hair then writes
#     its segment's id and its slot alone (HairStrandsVisibilityPS.usf MainVisibility, PackHairVisControlPointMaterialId), and a full-screen
#     pass lights each pixel's distinct strands once, weighted by their samples (HairStrandsVisibilityCompaction.usf; strands_shade). A
#     groom of ribbons (brows, lashes), and a head of hair past ST_VIS_SLOTS, is still lit where it is drawn, into the same samples
#   R3D_HAIR_DEPTH: the hair's depth from the composition's nearest visibility sample (HairStrandsComposition.usf ComposeSamplePS,
#     PERMUTATION_WRITE_DEPTH), not a draw of its own
#   R3D_HAIR_DOM_FIT: the deep shadow's tile sized from its screen size (strands_shadow_pass)
# ============================================================================

const ST_LUT_SIZE: int = 256
const ST_MSAA: int = 8
const ST_RASTER_SCALE: float = 0.5          # r.HairStrands.RasterizationScale
const ST_SCENE_DEPTH_UNIT: int = 10         # the visibility pass's scene depth (actor_blend's unit; unused by the strand programs)
const ST_VIS_SLOTS: int = 4                 # heads of hair a frame's visibility tells apart (strands.frag SHADE: u_stm_*, u_st_pts0 .. 3)

# the flags (R3D_HAIR_VIS, R3D_HAIR_DEPTH, R3D_HAIR_DOM_FIT: on unless 0), read once
function strands_flags(render3d_st: mut Render3dState) -> void {
  if render3d_st.st_vis_on >= 0 { return }
  render3d_st.st_vis_on = 1;  render3d_st.st_wdepth_on = 1;  render3d_st.st_dom_fit_on = 1
  if r3d_env_has(render3d_st, "R3D_HAIR_VIS") and r3d_env(render3d_st, "R3D_HAIR_VIS") == "0" { render3d_st.st_vis_on = 0 }
  if r3d_env_has(render3d_st, "R3D_HAIR_DEPTH") and r3d_env(render3d_st, "R3D_HAIR_DEPTH") == "0" { render3d_st.st_wdepth_on = 0 }
  if r3d_env_has(render3d_st, "R3D_HAIR_DOM_FIT") and r3d_env(render3d_st, "R3D_HAIR_DOM_FIT") == "0" { render3d_st.st_dom_fit_on = 0 }
}

# SampleCountToSubPixelSize (HairStrandsUtils.cpp): a strand's least diameter in pixels at n samples
function strands_subpixel(n: int) -> float {
  if n >= 8 { return 0.25 }
  if n >= 2 { return 0.5 }
  return 1.0
}

@alloc_ok("made when a groom is first in view, at post's size, and kept until post is remade")
function strands_ensure(render3d_st: mut Render3dState) -> void {
  if render3d_st.st_trans != null and render3d_st.st_trans.w == render3d_st.post_w and render3d_st.st_trans.h == render3d_st.post_h { return }
  strands_free(render3d_st)
  let w = render3d_st.post_w
  let h = render3d_st.post_h
  render3d_st.st_trans = target_new(render3d_st, w, h, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_NEAREST)
  render3d_st.st_acc = target_new(render3d_st, w, h, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_NEAREST)
  render3d_st.st_fb_t = gpu_fb_new(render3d_st)
  gpu_fb_bind(render3d_st, render3d_st.st_fb_t)
  gpu_fb_color(render3d_st, 0, render3d_st.st_trans.color)
  gpu_fb_depth(render3d_st, render3d_st.post_hdr.depth)
  render3d_st.st_fb_a = gpu_fb_new(render3d_st)
  gpu_fb_bind(render3d_st, render3d_st.st_fb_a)
  gpu_fb_color(render3d_st, 0, render3d_st.st_acc.color)
  # Unreal's r.HairStrands.Visibility.MSAA.SamplePerPixel 8, or the most the device has
  render3d_st.st_ms_n = min(ST_MSAA, max(gpu_msaa_max(render3d_st), 1))
  render3d_st.st_ms_fb = gpu_fb_new(render3d_st)
  gpu_fb_bind(render3d_st, render3d_st.st_ms_fb)
  render3d_st.st_ms_c = gpu_rb_new(render3d_st)
  gpu_rb_storage(render3d_st, render3d_st.st_ms_c, GPU_RGBA16F, w, h, render3d_st.st_ms_n)
  gpu_fb_color_rb(render3d_st, 0, render3d_st.st_ms_c)
  render3d_st.st_ms_d = gpu_rb_new(render3d_st)
  gpu_rb_storage(render3d_st, render3d_st.st_ms_d, GPU_DEPTH_COMPONENT32F, w, h, render3d_st.st_ms_n)
  gpu_fb_depth_rb(render3d_st, render3d_st.st_ms_d)
  gpu_fb_bind(render3d_st, 0)
  if render3d_st.st_p_resolve == 0 { render3d_st.st_p_resolve = r3d_program(render3d_st, "fullscreen.vert", "strands_resolve.frag", "") }
  if render3d_st.st_p_fill == 0 { render3d_st.st_p_fill = r3d_program(render3d_st, "fullscreen.vert", "strands_resolve.frag", "#define FILL_DEPTH\n") }
  if render3d_st.st_p_resolve_d == 0 { render3d_st.st_p_resolve_d = r3d_program(render3d_st, "fullscreen.vert", "strands_resolve.frag", "#define WRITE_DEPTH\n") }
  if render3d_st.st_lut == null {
    render3d_st.st_p_lut = r3d_program(render3d_st, "fullscreen.vert", "hair_lut.frag", "")
    render3d_st.st_lut = target_new(render3d_st, ST_LUT_SIZE, ST_LUT_SIZE, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR)
    target_bind(render3d_st, render3d_st.st_lut)
    gpu_depth_test(render3d_st, false)
    gpu_blend(render3d_st, false)
    gpu_cull(render3d_st, false)
    gpu_use_program(render3d_st, render3d_st.st_p_lut)
    mesh_draw(render3d_st, render3d_st.post_fs)
    gpu_cull(render3d_st, true)
    gpu_fb_bind(render3d_st, 0)
  }
}
function strands_free(render3d_st: mut Render3dState) -> void {
  if render3d_st.st_trans == null { return }
  gpu_fb_free(render3d_st, render3d_st.st_fb_t);  render3d_st.st_fb_t = 0
  gpu_fb_free(render3d_st, render3d_st.st_fb_a);  render3d_st.st_fb_a = 0
  gpu_fb_free(render3d_st, render3d_st.st_ms_fb);  render3d_st.st_ms_fb = 0
  gpu_rb_free(render3d_st, render3d_st.st_ms_c);  render3d_st.st_ms_c = 0
  gpu_rb_free(render3d_st, render3d_st.st_ms_d);  render3d_st.st_ms_d = 0
  target_free(render3d_st, render3d_st.st_trans);  render3d_st.st_trans = null
  target_free(render3d_st, render3d_st.st_acc);  render3d_st.st_acc = null
}

# one pass's strands: each visible strands actor, its pose and, per primitive, its material (u_fp) and the LUT
# a strands program's frame-wide uniforms (its camera, the least radius, the frame, the LUT)
function strands_prog(render3d_st: mut Render3dState, ap: AcProg, minr: float, view: floats, proj: floats) -> void {
  let p = ap.prog
  gpu_use_program(render3d_st, p)
  u_mat4(render3d_st, ap.l_view, view)
  u_mat4(render3d_st, ap.l_proj, proj)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_strand_minr"), minr)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_frame"), float(render3d_st.ac_frame % 64))
  # R3D_STRAND_TERMS=sun or sky: one of the strands' two lights alone (a debug view; both when unset)
  var terms = 0.0
  if r3d_env_has(render3d_st, "R3D_STRAND_TERMS") {
    if r3d_env(render3d_st, "R3D_STRAND_TERMS") == "sun" { terms = 1.0 }
    if r3d_env(render3d_st, "R3D_STRAND_TERMS") == "sky" { terms = 2.0 }
  }
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_st_terms"), terms)
  if render3d_st.st_lut != null { r3d_bind_2d(render3d_st, p, "u_hair_lut", 3, render3d_st.st_lut.color) }
}
# one pass's strands: each visible strands actor, its pose and, per primitive, its material (u_fp) and the LUT. api: the same pass's
# program for a head of hair (skin.vert INST: model_set_strand_points' records, a segment an instance)
function strands_draw(render3d_st: mut Render3dState, ap: AcProg, api: AcProg, minr: float, view: floats, proj: floats) -> void {
  strands_prog(render3d_st, ap, minr, view, proj)
  if api != null { strands_prog(render3d_st, api, minr, view, proj) }
  let t = render3d_st.ac_fab_tmp
  for i in 0 .. len(render3d_st.ac_actors) {
    let a = render3d_st.ac_actors[i]
    if not a.strands or not ac_visible(render3d_st, a, false) { continue }
    let model = a.model
    var use = ap
    if api != null and len(model.prims) > 0 and model.prims[0].inst_n > 0 { use = api }
    # the visibility's id pass: a head of hair a slot each prim, lit where drawn (the forward program) when the slots run out
    var vis = render3d_st.ac_strand_v_i != null and use.prog == render3d_st.ac_strand_v_i.prog
    if vis {
      var need = 0
      for k in 0 .. len(model.prims) { if model.prims[k].inst_n > 0 and (a.hide == null or a.hide[k] == 0) { need += 1 } }
      if render3d_st.st_vs_n + need > ST_VIS_SLOTS or model.prims[0].inst_buf == 0 {
        vis = false
        use = render3d_st.ac_strand_l_i
      }
    }
    let p = use.prog
    gpu_use_program(render3d_st, p)
    u_mat4(render3d_st, use.l_view, view)
    u_mat4(render3d_st, use.l_proj, proj)
    u_mat4(render3d_st, use.l_model, a.mat)
    ac_bind_pose(render3d_st, a, use)
    gpu_cull(render3d_st, false)
    for k in 0 .. len(model.prims) {
      let pr = model.prims[k]
      if a.hide != null and a.hide[k] != 0 { continue }
      if use.l_fp >= 0 {
        for f in 0 .. AC_FAB_FLOATS { t[f] = 0.0 }
        if pr.fab != null { for f in 0 .. AC_FAB_FLOATS { t[f] = pr.fab[f] } } else { t[13] = 1.0 }
        gvk_u_set(render3d_st, use.l_fp, data_of(t), 16, AC_FAB_FLOATS / 4)
      }
      if vis and pr.inst_n > 0 {
        let s = render3d_st.st_vs_n
        render3d_st.st_vs_n = s + 1
        for f in 0 .. AC_FAB_FLOATS { render3d_st.st_vs_fp[s * AC_FAB_FLOATS + f] = 0.0 }
        if pr.fab != null { for f in 0 .. AC_FAB_FLOATS { render3d_st.st_vs_fp[s * AC_FAB_FLOATS + f] = pr.fab[f] } } else { render3d_st.st_vs_fp[s * AC_FAB_FLOATS + 13] = 1.0 }
        strands_skin_mat(a, render3d_st.st_vs_m, s * 16)
        render3d_st.st_vs_c[s * 4] = pr.st_cx;  render3d_st.st_vs_c[s * 4 + 1] = pr.st_cy;  render3d_st.st_vs_c[s * 4 + 2] = pr.st_cz
        render3d_st.st_vs_c[s * 4 + 3] = pr.st_rmax
        render3d_st.st_vs_buf[s] = model.prims[0].inst_buf
        u_f(render3d_st, gpu_uniform(render3d_st, p, "u_st_slot"), float(s))
      }
      if pr.inst_n > 0 {
        strands_lod(render3d_st, a, pr)
        u_f3(render3d_st, gpu_uniform(render3d_st, p, "u_strand_c"), pr.st_cx, pr.st_cy, pr.st_cz)
        u_f(render3d_st, gpu_uniform(render3d_st, p, "u_strand_rmax"), pr.st_rmax)
        u_f(render3d_st, gpu_uniform(render3d_st, p, "u_st_cov"), pr.st_lod_cov)
        mesh_draw_instanced(render3d_st, pr.mesh, pr.st_lod_n)
      } else {
        u_f(render3d_st, gpu_uniform(render3d_st, p, "u_st_cov"), 1.0)
        mesh_draw(render3d_st, pr.mesh)
      }
      render3d_st.st_draws += 1
    }
  }
}

# Unreal's hair Auto LOD (GroomManager.cpp ComputeHairLODIndex, ComputeActiveCurveCount; r.HairStrands.LODMode 1, its default): a groom
# draws the first N of its curves, N = curves x clamp(ScreenSize + bias, 0, 1), the screen size ComputeBoundsScreenSize's of the bounds'
# centre and largest half extent in the main view, the bias the asset's AutoLODBias (0) and r.HairStrands.AutoLOD.Bias (0.1). The build
# shuffled the curves, so the first N are an even thinning, and what the thinning takes is given back in the strands' coverage by the
# groom's scale at N / curves (FHairStrandsBulkData::GetCoverageScale; HairStrandsVisibilityPS's HairCoverageScale: strands.frag
# u_st_cov). Chosen once a frame from the camera, so every pass (the transmittance, the visibility, the depth, the deep shadow) draws the
# same curves. R3D_HAIR_AUTOLOD_BIAS=<b> sets the global bias; model_set_strand_lod_bias a groom's own (UGroomAsset::GetAutoLODBias:
# the asset's and its group's, a head of hair, a beard and a moustache each); the curves kept are never fewer than the groom's clusters
# (morph.ludic strands_cluster_count).
# OFF unless R3D_HAIR_AUTOLOD=1 (2026-10-28): on, it cut the hair from 93 to 24 ms a frame over the shoulder on the island, but the thinned
# beard went patchy and the scalp showed through the back of the head at 1.3 to 2.6 m (hero_shots.py, bruce). Unreal's own look at those
# distances, and the MetaHuman grooms' LODMode / AutoLODBias, are to be read from the editor before it is on by default.
function strands_lod(render3d_st: mut Render3dState, a: Actor, pr: Prim) -> void {
  if pr.st_lod_frame == render3d_st.ac_frame { return }
  pr.st_lod_frame = render3d_st.ac_frame
  if render3d_st.st_lod_on < 0 {
    render3d_st.st_lod_on = 0
    if r3d_env_has(render3d_st, "R3D_HAIR_AUTOLOD") and r3d_env(render3d_st, "R3D_HAIR_AUTOLOD") == "1" { render3d_st.st_lod_on = 1 }
    if r3d_env_has(render3d_st, "R3D_HAIR_AUTOLOD_BIAS") { render3d_st.st_lod_bias = ue_parse_float(r3d_env(render3d_st, "R3D_HAIR_AUTOLOD_BIAS")) }
  }
  pr.st_lod_n = pr.inst_n
  pr.st_lod_cov = 1.0
  if render3d_st.st_lod_on == 0 or pr.st_nc < 2 or pr.st_ends == null { return }
  let c = render3d_st.st_lod_c
  let px = pr.st_cx + pr.st_bx;  let py = pr.st_cy + pr.st_by;  let pz = pr.st_cz + pr.st_bz
  if a.model.skin != null { strands_world(render3d_st, a, px, py, pz, c) }
  else {
    let m = a.mat
    c[0] = m[0] * px + m[4] * py + m[8] * pz + m[12];  c[1] = m[1] * px + m[5] * py + m[9] * pz + m[13];  c[2] = m[2] * px + m[6] * py + m[10] * pz + m[14]
  }
  let dx = c[0] - render3d_st.cam_pos[0];  let dy = c[1] - render3d_st.cam_pos[1];  let dz = c[2] - render3d_st.cam_pos[2]
  # ComputeBoundsScreenSize (SceneManagement.cpp), as ComputeHairLODIndex calls it for ContinuousLODScreenSize: the rest bounds' sphere
  # (its centre the instance bounds' centre, its radius BoundRadius = the rest box's largest half extent x the largest scale), the distance
  # to the view's origin held to a centimetre at least (FMath::Max(1.0f, Dist) in Unreal's cm), ScreenMultiple = max(0.5 P[0][0],
  # 0.5 P[1][1]) of the view-to-clip, the diameter returned, clamped to [0, 1]. Checked 2026-10-28 against UE 5.8: the same input
  let mult = Math.max(0.5 * render3d_st.cam_proj[0], 0.5 * render3d_st.cam_proj[5])
  let size = Math.clamp(2.0 * mult * pr.st_ext * a.scale / Math.max(Math.sqrt(dx * dx + dy * dy + dz * dz), 0.01), 0.0, 1.0)
  # ComputeActiveCurveCount: ScreenSizeBias = clamp(the groom's AutoLODBias + GetHairStrandsAutoLODBias(), -1, 1); N = curves x
  # (screen size + bias)^1, truncated; N = max(ClusterCount, N) ("at least 1 curve per cluster"); N in [1, curves]
  let bias = Math.clamp(pr.st_lod_gbias + Math.clamp(render3d_st.st_lod_bias, -1.0, 1.0), -1.0, 1.0)
  var n = int(float(pr.st_nc) * Math.clamp(size + bias, 0.0, 1.0))
  n = max(pr.st_ncl, n)
  n = min(max(n, 1), pr.st_nc)
  pr.st_lod_n = pr.st_ends[n - 1]
  if pr.st_cov != null {
    # GetCoverageScale: between the two buckets either side of the share kept
    let cn = len(pr.st_cov)
    let f = Math.clamp(float(n) / float(pr.st_nc) * float(cn), 0.0, float(cn - 1))
    let i0 = int(Math.floor(f))
    let i1 = min(i0 + 1, cn - 1)
    pr.st_lod_cov = pr.st_cov[i0] + (pr.st_cov[i1] - pr.st_cov[i0]) * (f - float(i0))
  }
}

# a head of hair's bind space to the world, as skin.vert makes it for its segment's quad (weighted wholly to the "head" joint, art
# strands_mh.py): the actor's matrix x that joint's palette entry (the leader's pose for a part that follows one; ac_bind_pose's palette)
function strands_skin_mat(a: Actor, out: floats, oo: int) -> void {
  let m = a.mat
  let sk = a.model.skin
  var pal: floats = null
  var po = 0
  if sk != null {
    var j = 0
    for k in 0 .. sk.n_joints { if sk.names[sk.joints[k]] == "head" { j = k } }
    if a.leader != null and a.fmap != null { pal = a.fbones } else if a.skin != null { pal = a.skin.bones } else { pal = sk.bones }
    po = j * 16
  }
  for c in 0 .. 4 {
    for r in 0 .. 4 {
      var v = 0.0
      if pal == null { v = m[c * 4 + r] } else { for k in 0 .. 4 { v = v + m[k * 4 + r] * pal[po + c * 4 + k] } }
      out[oo + c * 4 + r] = v
    }
  }
}
# a uniform array's location by its first element's name, else its own (the manifest names either)
function strands_u(render3d_st: mut Render3dState, p: int, first: string, name: string) -> int {
  let l = gpu_uniform(render3d_st, p, first)
  if l >= 0 { return l }
  return gpu_uniform(render3d_st, p, name)
}
# the visibility's samples lit (strands.frag SHADE: HairStrandsVisibilityCompaction.usf's distinct samples of a pixel, each lit once and
# weighted by its samples), into st_acc as the multisampled resolve wrote it: every pixel written, so it needs no clear
function strands_shade(render3d_st: mut Render3dState) -> void {
  let sp = render3d_st.ac_strand_shade
  sp.scene_frame = -1
  ac_bind_scene(render3d_st, sp)                    # the sun, the sky, the shadows, the fog, the character light, the hair's deep shadow
  let p = sp.prog
  gpu_fb_bind(render3d_st, render3d_st.st_fb_a)
  gpu_viewport(render3d_st, 0, 0, render3d_st.post_w, render3d_st.post_h)
  gpu_depth_test(render3d_st, false)
  gpu_depth_write(render3d_st, false)
  gpu_blend(render3d_st, false)
  gpu_cull(render3d_st, false)
  gpu_use_program(render3d_st, p)
  r3d_bind_2d(render3d_st, p, "u_st_vis", 0, render3d_st.st_ms_c)
  r3d_bind_2d(render3d_st, p, "u_st_vdep", 1, render3d_st.st_ms_d)
  if render3d_st.st_lut != null { r3d_bind_2d(render3d_st, p, "u_hair_lut", 3, render3d_st.st_lut.color) }
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_st_n"), float(render3d_st.st_ms_n))
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_st_size"), float(render3d_st.post_w), float(render3d_st.post_h))
  m4_mul(render3d_st.st_vp_tmp, render3d_st.cam_proj, render3d_st.cam_view)
  m4_inverse(render3d_st.st_ivp, render3d_st.st_vp_tmp)
  u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_st_ivp"), render3d_st.st_ivp)
  let v = render3d_st.cam_view
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "u_st_fwd"), -v[2], -v[6], -v[10])
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_frame"), float(render3d_st.ac_frame % 64))
  var terms = 0.0
  if r3d_env_has(render3d_st, "R3D_STRAND_TERMS") {
    if r3d_env(render3d_st, "R3D_STRAND_TERMS") == "sun" { terms = 1.0 }
    if r3d_env(render3d_st, "R3D_STRAND_TERMS") == "sky" { terms = 2.0 }
  }
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_st_terms"), terms)
  u_f4v(render3d_st, strands_u(render3d_st, p, "u_stm_fp[0]", "u_stm_fp"), ST_VIS_SLOTS * AC_FAB_FLOATS / 4, render3d_st.st_vs_fp)
  u_mat4n(render3d_st, strands_u(render3d_st, p, "u_stm_m[0]", "u_stm_m"), ST_VIS_SLOTS, render3d_st.st_vs_m)
  u_f4v(render3d_st, strands_u(render3d_st, p, "u_stm_c[0]", "u_stm_c"), ST_VIS_SLOTS, render3d_st.st_vs_c)
  # a slot no head of hair holds: none bound (the backend's null buffer)
  for k in 0 .. ST_VIS_SLOTS { if k >= render3d_st.st_vs_n { render3d_st.st_vs_buf[k] = 0 } }
  gpu_bind_buffer(render3d_st, p, "u_st_pts0", render3d_st.st_vs_buf[0])
  gpu_bind_buffer(render3d_st, p, "u_st_pts1", render3d_st.st_vs_buf[1])
  gpu_bind_buffer(render3d_st, p, "u_st_pts2", render3d_st.st_vs_buf[2])
  gpu_bind_buffer(render3d_st, p, "u_st_pts3", render3d_st.st_vs_buf[3])
  mesh_draw(render3d_st, render3d_st.post_fs)
}

function actor_draw_strands(render3d_st: mut Render3dState) -> void {
  render3d_st.st_draws = 0
  if render3d_st.ac_actors == null or render3d_st.ac_strand_l == null or render3d_st.post_hdr == null { return }
  var any = false
  for i in 0 .. len(render3d_st.ac_actors) {
    let a = render3d_st.ac_actors[i]
    if a.strands and ac_visible(render3d_st, a, false) { any = true }
  }
  if not any or r3d_env_has(render3d_st, "R3D_NOSTRANDS") { return }
  prof_begin(render3d_st, "strands")
  strands_flags(render3d_st)
  strands_ensure(render3d_st)
  let vis = render3d_st.st_vis_on == 1 and render3d_st.ac_strand_v_i != null and render3d_st.ac_strand_shade != null
  let wdepth = render3d_st.st_wdepth_on == 1 and render3d_st.st_p_resolve_d != 0
  # a pixel at a metre: 2 tan(fov/2) / h; the least radius there, as ComputeMinStrandRadiusAtDepth1 takes it, at one sample and at the
  # visibility's samples
  let px = 2.0 / (render3d_st.cam_proj[5] * float(render3d_st.post_h))
  let minr_t = 0.5 * ST_RASTER_SCALE * strands_subpixel(1) * px
  let minr_v = 0.5 * ST_RASTER_SCALE * strands_subpixel(render3d_st.st_ms_n) * px
  gpu_depth_test(render3d_st, true)
  gpu_depth_func(render3d_st, GPU_GEQUAL)
  gpu_depth_write(render3d_st, false)
  # the transmittance: cleared to 1, each strand's (1 - coverage) multiplied in
  gpu_fb_bind(render3d_st, render3d_st.st_fb_t)
  gpu_viewport(render3d_st, 0, 0, render3d_st.st_trans.w, render3d_st.st_trans.h)
  gpu_clear_color(render3d_st, 1.0, 1.0, 1.0, 1.0)
  gpu_clear(render3d_st, GPU_COLOR_BUFFER_BIT)
  gpu_blend(render3d_st, true)
  gpu_blend_func(render3d_st, GPU_ZERO, GPU_SRC_COLOR)
  strands_draw(render3d_st, render3d_st.ac_strand_t, render3d_st.ac_strand_t_i, minr_t, render3d_st.cam_view, render3d_st.cam_proj)
  gpu_blend(render3d_st, false)
  # the visibility: the front strand of each sample (lit there, or its id alone: R3D_HAIR_VIS)
  gpu_fb_bind(render3d_st, render3d_st.st_ms_fb)
  gpu_viewport(render3d_st, 0, 0, render3d_st.post_w, render3d_st.post_h)
  gpu_clear_color(render3d_st, 0.0, 0.0, 0.0, 0.0)
  gpu_clear(render3d_st, GPU_COLOR_BUFFER_BIT | GPU_DEPTH_BUFFER_BIT)
  if vis {
    # AddHairVisibilityFillOpaqueDepth: the scene's depth into every sample (depth CF_Always, written), so what the scene hides is never
    # shaded and a strand's shader tests nothing
    gpu_cull(render3d_st, false)
    gpu_color_write(render3d_st, false)
    gpu_depth_func(render3d_st, GPU_ALWAYS)
    gpu_depth_write(render3d_st, true)
    gpu_use_program(render3d_st, render3d_st.st_p_fill)
    r3d_bind_2d(render3d_st, render3d_st.st_p_fill, "u_scene_depth", 0, render3d_st.post_depth_copy.depth)
    mesh_draw(render3d_st, render3d_st.post_fs)
    gpu_color_write(render3d_st, true)
  }
  gpu_depth_func(render3d_st, GPU_GREATER)
  gpu_depth_write(render3d_st, true)
  let lp = render3d_st.ac_strand_l
  lp.scene_frame = -1
  ac_bind_scene(render3d_st, lp)
  r3d_bind_2d(render3d_st, lp.prog, "u_scene_depth", ST_SCENE_DEPTH_UNIT, render3d_st.post_depth_copy.depth)
  let lpi = render3d_st.ac_strand_l_i
  lpi.scene_frame = -1
  ac_bind_scene(render3d_st, lpi)
  r3d_bind_2d(render3d_st, lpi.prog, "u_scene_depth", ST_SCENE_DEPTH_UNIT, render3d_st.post_depth_copy.depth)
  if vis {
    # the heads of hair their ids (a slot each), the ribbons and any head past the slots lit; then the samples lit, resolved into st_acc
    render3d_st.st_vs_n = 0
    strands_prog(render3d_st, lpi, minr_v, render3d_st.cam_view, render3d_st.cam_proj)
    strands_draw(render3d_st, lp, render3d_st.ac_strand_v_i, minr_v, render3d_st.cam_view, render3d_st.cam_proj)
    strands_shade(render3d_st)
  } else {
    strands_draw(render3d_st, lp, lpi, minr_v, render3d_st.cam_view, render3d_st.cam_proj)
    # its samples averaged: the hit ones' light summed over all (alpha: the share hit)
    gpu_fb_bind_read(render3d_st, render3d_st.st_ms_fb)
    gpu_fb_bind_draw(render3d_st, render3d_st.st_fb_a)
    gpu_blit(render3d_st, render3d_st.post_w, render3d_st.post_h, GPU_COLOR_BUFFER_BIT)
  }
  gpu_blend(render3d_st, true)
  # the resolve, premultiplied over the scene; with R3D_HAIR_DEPTH the hair's nearest visibility sample into the scene's depth there
  # (HairStrandsComposition.usf ComposeSamplePS, PERMUTATION_WRITE_DEPTH: OutDepth = the hair-only depth). What reads the depth after
  # (the height fog and aerial perspective, TAA, depth of field, SSAO) then takes a hair pixel at the hair's distance; it took one over
  # the sky as the sky's, and the fog drew a pale veil over the hair outside the head's outline
  target_bind(render3d_st, render3d_st.post_hdr)
  if wdepth {
    gpu_depth_test(render3d_st, true)
    gpu_depth_func(render3d_st, GPU_GEQUAL)
    gpu_depth_write(render3d_st, true)
  } else {
    gpu_depth_test(render3d_st, false)
  }
  gpu_blend_func(render3d_st, GPU_ONE, GPU_ONE_MINUS_SRC_ALPHA)
  gpu_cull(render3d_st, false)
  var p = render3d_st.st_p_resolve
  if wdepth { p = render3d_st.st_p_resolve_d }
  gpu_use_program(render3d_st, p)
  r3d_bind_2d(render3d_st, p, "u_st_trans", 0, render3d_st.st_trans.color)
  r3d_bind_2d(render3d_st, p, "u_st_acc", 1, render3d_st.st_acc.color)
  if wdepth {
    r3d_bind_2d(render3d_st, p, "u_st_vdep", 2, render3d_st.st_ms_d)
    u_f(render3d_st, gpu_uniform(render3d_st, p, "u_st_n"), float(render3d_st.st_ms_n))
  }
  var dbg = 0.0
  if r3d_env_has(render3d_st, "R3D_STRAND_COV") { dbg = 1.0 }
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_st_dbg"), dbg)
  mesh_draw(render3d_st, render3d_st.post_fs)
  gpu_blend(render3d_st, false)
  if not wdepth {
    # the hair's depth by a draw of its own: the strands' depth alone at the visibility's least radius, the nearest, where they are in
    # front of the scene
    gpu_color_write(render3d_st, false)
    gpu_depth_test(render3d_st, true)
    gpu_depth_func(render3d_st, GPU_GREATER)
    gpu_depth_write(render3d_st, true)
    strands_draw(render3d_st, render3d_st.ac_strand_t, render3d_st.ac_strand_t_i, minr_v, render3d_st.cam_view, render3d_st.cam_proj)
    gpu_color_write(render3d_st, true)
  }
  gpu_depth_test(render3d_st, true)
  gpu_depth_func(render3d_st, GPU_GREATER)
  gpu_depth_write(render3d_st, true)
  gpu_cull(render3d_st, true)
  gpu_fb_bind(render3d_st, 0)
  prof_end(render3d_st)
}

# ---- the grooms' deep shadow from the sun, as Unreal's (HairStrandsDeepShadow.cpp, HairStrandsDeepShadowPS.usf): a front depth and four
# layers of hair coverage, in an orthographic view fitted to the nearest groom's bounds' sphere (HairStrandsUtils.cpp
# ComputeTranslatedWorldToLightClip for a directional light: R either side, a depth range of 2R). The front pass draws the strands'
# depth alone (MainDepth: the nearest to the sun wins); the layer pass adds each strand's coverage into every layer its distance behind
# that front lies within (MainDom, ComputeDOMWeights), the layers at ComputeDeepShadowLayerDepths of the light's
# DeepShadowLayerDistribution 0.5: 0.2^3.6, 0.4^3.6, 0.6^3.6, 0.8^3.6 of the range. A strand reads the count in front of it through
# SampleDOM_PCF (r.HairStrands.DeepShadow.KernelType 2) x DensityScale 2; the face and eyes through ShadowMaskKernelType 4
# (InternalGaussianTransmissionFilter: lighting.glsl hairShadow). The eye is ST_HS_EYE out along the sun so the strands' least radius,
# which skin.vert scales by the distance to the eye, holds Unreal's constant R / resolution within R / ST_HS_EYE.
# R3D_CARDS_DOM (on unless 0; actor.ludic ac_card_flags): a groom's cards drawn into the map too, as Unreal draws a cards or meshes groom
# into its deep shadow (HairStrandsInterface.cpp: EHairInstanceVisibilityType::CardsOrMeshesShadowView; HairStrandsRasterCommon.cpp
# FHairRasterMeshProcessor: FrontDepth and DeepOpacityMap for a cards material that casts dynamic shadow): the front pass their depth
# (FDeepShadowDepthMeshPS, no opacity mask: SUPPORT_OPACITY_MASK 0), the layer pass each card's coverage 1 (HairStrandsDeepShadowVS.usf: a
# mesh that is not strands) into its layers (shadow.frag CARD_DOM). The nearest groom, strands or cards, centres the map; a cards groom's
# bounds are its head and a quarter metre, as a groom of ribbons'. A card then reads the map as an opaque pixel does (model.frag FABRIC,
# lighting.glsl hairShadow: HairStrandsDeepShadowMask.usf for a pixel the strands' visibility does not cover)
# R3D_HAIR_DOM_FIT (on unless 0): the map drawn into a tile of the target as Unreal's atlas sizes one (HairStrandsDeepShadowAllocation.usf
# CreateViewInfo: ComputeProjectedScreenSize, the light view's square projected onto the screen in pixels; AddToAtlasTileBin, its larger
# side's pow2 bin in [r.HairStrands.DeepShadow.MinResolution 64, 64 x 2^(NUM_ATLAS_TILE_BINS 6 - 1) = 2048] and the tile that side
# within its bin, 64 at least: AllocateAtlasTiles' min(DesiredResolution, BinResolution)). The strands' least radius keeps the slot's
# resolution (RadiusAtDepth1 = Radius / min(SlotResolution) with SlotResolution r.HairStrands.DeepShadow.Resolution, not the tile's)
const ST_HS_SIZE: int = 2048                # r.HairStrands.DeepShadow.Resolution
const ST_HS_EYE: float = 10.0               # metres from the bounds' centre to the orthographic view's eye
const ST_HS_RASTER: float = 1.0             # r.HairStrands.ShadowRasterizationScale
const ST_HS_LAYER_DIST: float = 0.5         # ULightComponent::DeepShadowLayerDistribution's default
const ST_HS_DENSITY: float = 2.0            # r.HairStrands.DeepShadow.DensityScale
const ST_HS_BIAS: float = 0.05              # r.HairStrands.DeepShadow.DepthBiasScale
const ST_HS_MIN_LOG2: int = 6               # FloorLog2(r.HairStrands.DeepShadow.MinResolution 64)
const ST_HS_BINS: int = 6                   # NUM_ATLAS_TILE_BINS

@alloc_ok("made when a groom is first in view and kept")
function strands_shadow_ensure(render3d_st: mut Render3dState) -> void {
  if render3d_st.st_hs != null { return }
  render3d_st.st_hs = target_new(render3d_st, ST_HS_SIZE, ST_HS_SIZE, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, true, GPU_NEAREST)
  # the layer pass reads the front depth: its own framebuffer, the layers alone
  render3d_st.st_hs_fbl = gpu_fb_new(render3d_st)
  gpu_fb_bind(render3d_st, render3d_st.st_hs_fbl)
  gpu_fb_color(render3d_st, 0, render3d_st.st_hs.color)
  gpu_fb_bind(render3d_st, 0)
  render3d_st.st_hs_view = m4_new();  render3d_st.st_hs_proj = m4_new()
  render3d_st.st_hs_tmp = m4_new();  render3d_st.st_hs_tmp2 = m4_new()
}
@alloc_ok("one texture, made once")
function strands_shadow_black(render3d_st: mut Render3dState) -> int {
  if render3d_st.st_hs_black == 0 { render3d_st.st_hs_black = tex_solid(render3d_st, 0, 0, 0, 0) }
  return render3d_st.st_hs_black
}
# a strands actor's point in the world: a point of its bind space carried by its skin's "head" joint (else its first) at this frame's pose
function strands_world(render3d_st: mut Render3dState, a: Actor, px: float, py: float, pz: float, out: floats) -> void {
  let sk = a.model.skin
  var j = 0
  for k in 0 .. sk.n_joints { if sk.names[sk.joints[k]] == "head" { j = k } }
  var x = px;  var y = py;  var z = pz
  if a.leader != null and a.fmap != null {
    ac_follow_palette(a)
    let b = a.fbones_v[j]
    let bx = b[0] * x + b[4] * y + b[8] * z + b[12];  let by = b[1] * x + b[5] * y + b[9] * z + b[13];  let bz = b[2] * x + b[6] * y + b[10] * z + b[14]
    x = bx;  y = by;  z = bz
  }
  let m = a.mat
  out[0] = m[0] * x + m[4] * y + m[8] * z + m[12];  out[1] = m[1] * x + m[5] * y + m[9] * z + m[13];  out[2] = m[2] * x + m[6] * y + m[10] * z + m[14]
}
# a strands actor's head in the world: its skin's "head" joint at this frame's pose
function strands_head(render3d_st: mut Render3dState, a: Actor, out: floats) -> void {
  let sk = a.model.skin
  var j = 0
  for k in 0 .. sk.n_joints { if sk.names[sk.joints[k]] == "head" { j = k } }
  let t = render3d_st.st_hs_tmp
  m4_inverse(t, sk.inv_v[j])
  strands_world(render3d_st, a, t[12], t[13], t[14], out)
}
# HairStrandsDeepShadowAllocation.usf ComputeProjectedScreenSize then AddToAtlasTileBin / AllocateAtlasTiles: the light view's clip
# square (its corners at clip depth 0) to the world and onto the camera's screen, the larger side of its bounds in pixels, its tile
function strands_dom_res(render3d_st: mut Render3dState) -> int {
  let lc = render3d_st.st_hs_tmp3
  m4_mul(lc, render3d_st.st_hs_proj, render3d_st.st_hs_view)
  let inv = render3d_st.st_vp_tmp
  if not m4_inverse(inv, lc) { return ST_HS_SIZE }
  m4_mul(lc, render3d_st.cam_proj, render3d_st.cam_view)
  let q = render3d_st.st_hs_pt
  var u0 = 99999.0;  var v0 = 99999.0;  var u1 = -99999.0;  var v1 = -99999.0
  for y in 0 .. 2 {
    for x in 0 .. 2 {
      var w = m4_xform_point(q, inv, float(x) * 2.0 - 1.0, float(y) * 2.0 - 1.0, 0.0)
      if Math.abs(w) < 0.000000001 { w = 0.000000001 }
      let wx = q[0] / w;  let wy = q[1] / w;  let wz = q[2] / w
      var sw = m4_xform_point(q, lc, wx, wy, wz)
      if Math.abs(sw) < 0.000000001 { sw = 0.000000001 }
      let su = q[0] / sw * 0.5 + 0.5;  let sv = q[1] / sw * -0.5 + 0.5
      u0 = Math.min(u0, su);  v0 = Math.min(v0, sv);  u1 = Math.max(u1, su);  v1 = Math.max(v1, sv)
    }
  }
  let side = Math.ceil(Math.max(Math.max(u1 - u0, 0.0) * float(render3d_st.post_w), Math.max(v1 - v0, 0.0) * float(render3d_st.post_h)))
  var lg = 0
  if side > 0.0 { lg = int(Math.ceil(Math.log(side) / Math.log(2.0))) }
  lg = min(max(lg, ST_HS_MIN_LOG2), ST_HS_MIN_LOG2 + ST_HS_BINS - 1)
  let bin = 1 << lg
  let want = max(1 << ST_HS_MIN_LOG2, int(Math.min(side, float(ST_HS_SIZE))))
  return min(min(want, bin), ST_HS_SIZE)
}
# ComputeDeepShadowLayerDepths: the four layers' depths, as fractions of the view's depth range
function strands_layer(k: int) -> float {
  let e = Math.clamp(ST_HS_LAYER_DIST, 0.0, 1.0) * 5.2 + 1.0
  return Math.pow(0.2 * float(k + 1), e)
}
function strands_shadow_pass(render3d_st: mut Render3dState) -> void {
  render3d_st.st_hs_on = false
  if render3d_st.ac_actors == null or render3d_st.ac_strand_dom == null or render3d_st.ac_strand_t == null or render3d_st.sun_dir == null { return }
  # the groom nearest the camera (its strands, or its cards: R3D_CARDS_DOM)
  let cards = render3d_st.ac_cards_dom and render3d_st.ac_card_dom != null and render3d_st.ac_sh != null
  var best: Actor = null
  var bd = 1000000000.0
  for i in 0 .. len(render3d_st.ac_actors) {
    let a = render3d_st.ac_actors[i]
    if not a.strands and not (cards and ac_card_hair(a)) { continue }
    if not ac_visible(render3d_st, a, false) or a.model.skin == null { continue }
    if not a.strands and not a.casts { continue }                # (a cards material that casts no dynamic shadow is not drawn there)
    let dx = a.x - render3d_st.cam_pos[0];  let dy = a.y - render3d_st.cam_pos[1];  let dz = a.z - render3d_st.cam_pos[2]
    let d = dx * dx + dy * dy + dz * dz
    if d < bd { bd = d;  best = a }
  }
  if best == null or bd > 400.0 { return }                  # past 20 m its shadow is under a pixel
  prof_begin(render3d_st, "strands shadow")
  strands_flags(render3d_st)
  strands_shadow_ensure(render3d_st)
  # its bounds' sphere (a head of hair's points; a groom of ribbons, the head and a quarter metre)
  let c = render3d_st.st_hs_tmp2
  var R = 0.25
  let p0 = best.model.prims[0]
  if p0.inst_n > 0 and p0.st_br > 0.0 {
    strands_world(render3d_st, best, p0.st_cx + p0.st_bx, p0.st_cy + p0.st_by, p0.st_cz + p0.st_bz, c)
    R = p0.st_br
  } else {
    strands_head(render3d_st, best, c)
  }
  render3d_st.st_hs_r = R
  let sx = render3d_st.sun_dir[0];  let sy = render3d_st.sun_dir[1];  let sz = render3d_st.sun_dir[2]
  var ux = 0.0;  var uy = 1.0;  var uz = 0.0
  if Math.abs(sy) > 0.95 { uy = 0.0;  uz = 1.0 }
  m4_look_at_xyz(render3d_st.st_hs_view, c[0] + sx * ST_HS_EYE, c[1] + sy * ST_HS_EYE, c[2] + sz * ST_HS_EYE, c[0], c[1], c[2], ux, uy, uz)
  m4_ortho_rz(render3d_st.st_hs_proj, -R, R, -R, R, ST_HS_EYE - R, ST_HS_EYE + R)
  # the least radius: R over the slot's resolution (x the shadow's rasterisation scale), at the eye's distance
  let minr = R / float(ST_HS_SIZE) * ST_HS_RASTER / ST_HS_EYE
  # the tile this frame (R3D_HAIR_DOM_FIT), from the corner of the target
  var res = ST_HS_SIZE
  if render3d_st.st_dom_fit_on == 1 { res = strands_dom_res(render3d_st) }
  render3d_st.st_hs_res = res
  # the front depth: the strands' depth alone, the nearest to the sun (reversed: the greater)
  target_bind(render3d_st, render3d_st.st_hs)
  gpu_clear(render3d_st, GPU_DEPTH_BUFFER_BIT)
  gpu_viewport(render3d_st, 0, 0, res, res)
  gpu_blend(render3d_st, false)
  gpu_color_write(render3d_st, false)
  gpu_depth_test(render3d_st, true)
  gpu_depth_write(render3d_st, true)
  gpu_depth_func(render3d_st, GPU_GREATER)
  strands_draw(render3d_st, render3d_st.ac_strand_t, render3d_st.ac_strand_t_i, minr, render3d_st.st_hs_view, render3d_st.st_hs_proj)
  let lvp = render3d_st.st_hs_lvp
  m4_mul(lvp, render3d_st.st_hs_proj, render3d_st.st_hs_view)
  let lead = ac_lead(best)
  if cards { strands_cards_draw(render3d_st, render3d_st.ac_sh, lvp, lead) }              # (FDeepShadowDepthMeshPS: the depth alone)
  gpu_color_write(render3d_st, true)
  # the layers: each strand's coverage into the layers it lies within, added up
  gpu_fb_bind(render3d_st, render3d_st.st_hs_fbl)
  gpu_clear_color(render3d_st, 0.0, 0.0, 0.0, 0.0)
  gpu_clear(render3d_st, GPU_COLOR_BUFFER_BIT)
  gpu_viewport(render3d_st, 0, 0, res, res)
  gpu_depth_test(render3d_st, false)
  gpu_depth_write(render3d_st, false)
  gpu_blend(render3d_st, true)
  gpu_blend_func(render3d_st, GPU_ONE, GPU_ONE)
  let ap = render3d_st.ac_strand_dom
  for pi in 0 .. 2 {
    var q = ap
    if pi == 1 { q = render3d_st.ac_strand_dom_i }
    if q == null { continue }
    gpu_use_program(render3d_st, q.prog)
    r3d_bind_2d(render3d_st, q.prog, "u_hs_front", 24, render3d_st.st_hs.depth)
    u_f4(render3d_st, gpu_uniform(render3d_st, q.prog, "u_hs_layers"), strands_layer(0), strands_layer(1), strands_layer(2), strands_layer(3))
  }
  strands_draw(render3d_st, ap, render3d_st.ac_strand_dom_i, minr, render3d_st.st_hs_view, render3d_st.st_hs_proj)
  if cards {
    let cp = render3d_st.ac_card_dom.prog
    gpu_use_program(render3d_st, cp)
    r3d_bind_2d(render3d_st, cp, "u_hs_front", 24, render3d_st.st_hs.depth)
    u_f4(render3d_st, gpu_uniform(render3d_st, cp, "u_hs_layers"), strands_layer(0), strands_layer(1), strands_layer(2), strands_layer(3))
    gpu_blend(render3d_st, true)
    gpu_blend_func(render3d_st, GPU_ONE, GPU_ONE)
    gpu_depth_test(render3d_st, false)
    gpu_depth_write(render3d_st, false)
    strands_cards_draw(render3d_st, render3d_st.ac_card_dom, lvp, lead)
  }
  gpu_blend(render3d_st, false)
  gpu_depth_test(render3d_st, true)
  gpu_depth_write(render3d_st, true)
  gpu_cull(render3d_st, true)
  gpu_fb_bind(render3d_st, 0)
  render3d_st.st_hs_on = true
  prof_end(render3d_st)
}
# the hair cards of the groom the map is centred on (its leader's parts, R3D_CARDS_DOM) drawn into it by program ap (its light
# view-projection lvp): the front depth (ac_sh) or the layers (ac_card_dom)
function strands_cards_draw(render3d_st: mut Render3dState, ap: AcProg, lvp: floats, lead: Actor) -> void {
  for i in 0 .. len(render3d_st.ac_actors) {
    let a = render3d_st.ac_actors[i]
    if not ac_card_hair(a) or ac_lead(a) != lead or not ac_visible(render3d_st, a, false) or not a.casts or a.model.skin == null { continue }
    gpu_use_program(render3d_st, ap.prog)
    u_mat4(render3d_st, ap.l_lvp, lvp)
    actor_draw_one(render3d_st, a, ap, true)
    render3d_st.st_draws += 1
  }
}
# the actor a part follows, else itself: a character's parts share it
function ac_lead(a: Actor) -> Actor {
  if a.leader != null { return a.leader }
  return a
}
# the map on a program that looks it up (lighting.glsl hairShadow: the face's and eyes', a hair card's with R3D_CARDS_DOM), or its switch
# off (a hair card's program without R3D_CARDS_DOM: model.frag FABRIC keeps its stand-in)
function strands_bind_shadow(render3d_st: mut Render3dState, p: int) -> void {
  let lp = gpu_uniform(render3d_st, p, "u_hs_p")
  if lp < 0 { return }
  var on = render3d_st.st_hs_on
  if on and not render3d_st.ac_cards_dom and gpu_uniform(render3d_st, p, "u_fmask") >= 0 { on = false }
  if on {
    r3d_bind_2d(render3d_st, p, "u_hairsh", 16, render3d_st.st_hs.color)
    r3d_bind_2d(render3d_st, p, "u_hs_front", 24, render3d_st.st_hs.depth)
    u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_hs_view"), render3d_st.st_hs_view)
    u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_hs_proj"), render3d_st.st_hs_proj)
    u_f4(render3d_st, lp, 1.0, float(render3d_st.st_hs_res), strands_layer(0) * ST_HS_BIAS, ST_HS_DENSITY)
    u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_hs_layers"), strands_layer(0), strands_layer(1), strands_layer(2), strands_layer(3))
  } else {
    r3d_bind_2d(render3d_st, p, "u_hairsh", 16, strands_shadow_black(render3d_st))
    r3d_bind_2d(render3d_st, p, "u_hs_front", 24, strands_shadow_black(render3d_st))
    u_f4(render3d_st, lp, 0.0, 0.0, 0.0, 0.0)
  }
}
