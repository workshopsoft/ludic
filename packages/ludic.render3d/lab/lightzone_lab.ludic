# lightzone_lab.ludic - light zones (lightzone.ludic) photographed on the lab plate: probes (a box and a ball) on both
# sides of a zone that covers the plate's +x half, in the plate's sun. The shot test (lab/lightzone_check.py):
# inside the zone the frame is the frame with no sun at all; outside it, the frame with no zone.
#
#   ludic build packages/ludic.render3d/lab/lightzone_lab.ludic --headless -o build/lightzone_lab
#   for s in zone zone_nosun zone_off; do yes '' | head -n 400 | R3D_NOGI=1 R3D_NOVOL=1 R3D_NOGRAIN=1 R3D_SCENE=$s ./build/lightzone_lab; done
#   yes '' | head -n 400 | R3D_SCENE=zone_tunnel ./build/lightzone_lab
#   python3 packages/ludic.render3d/lab/lightzone_check.py build/lab
#
# Scenes: `zone` (the zone: no ambient, the sky kept, so inside it only the sun is taken away), `zone_nosun` (the same
# zone with the sun's colour 0 every frame: the reference with no sun anywhere), `zone_off` (no zone: the plain plate),
# `zone_tunnel` (a narrower turned zone with no sky and a warm ambient, every effect on: how a tunnel's tube reads).
# The measured scenes fix the exposure and turn bloom off so one frame's light cannot change another's pixels.
import "ludic.lab"
program LightZoneLab {
  numbers float
  state ZoneScene { nosun: bool = false }

  function probes(lab_st: mut LabState, render3d_st: mut Render3dState) -> void {
    let dir = lab_plate_dir(lab_st)
    for k in 0 .. 3 {
      lab_model(render3d_st, dir, "probe.gltf", "probe", -2.5, -3.0 + 3.0 * float(k), 0.5)
      lab_model(render3d_st, dir, "probe.gltf", "probe", 2.5, -3.0 + 3.0 * float(k), 0.5)
    }
  }
  # a fixed exposure and no bloom: the measured frames differ only by the light that reaches each surface
  function measured(render3d_st: mut Render3dState) -> void {
    render3d_st.post_auto = false
    render3d_st.post_exposure = 0.36
    render3d_st.post_bloom_strength = float_bits(0.0)
  }
  function shots(lab_st: mut LabState) -> void {
    lab_settle(lab_st, 60)
    lab_shot_at(lab_st, "above", 0.0, 0.0, 0.0, 14.0, 0.0, 89.0)
    lab_shot_at(lab_st, "side", 0.0, 0.5, 0.0, 12.0, 0.0, 30.0)
  }
  # the zone over x 0 .. 8 (z -8 .. 8, y -1 .. 3), feather 0.25 m; no ambient, the whole sky
  function zone_add(render3d_st: mut Render3dState) -> int {
    let z = lightzone_add(render3d_st, 4.0, 1.0, 0.0, 0.0, 8.0, 4.0, 16.0, 0.25)
    lightzone_ambient(render3d_st, z, 0.0, 0.0, 0.0, 1.0)
    return z
  }
  function zone_setup(zs: mut ZoneScene, lab_st: mut LabState, render3d_st: mut Render3dState) -> void {
    probes(lab_st, render3d_st);  measured(render3d_st);  zone_add(render3d_st);  shots(lab_st)
    lab_note(lab_st, "a light zone over the +x half: no sun inside, the sky kept")
  }
  function nosun_setup(zs: mut ZoneScene, lab_st: mut LabState, render3d_st: mut Render3dState) -> void {
    probes(lab_st, render3d_st);  measured(render3d_st);  zone_add(render3d_st);  shots(lab_st)
    zs.nosun = true
    lab_note(lab_st, "the zone, and no sun anywhere: the reference")
  }
  function off_setup(zs: mut ZoneScene, lab_st: mut LabState, render3d_st: mut Render3dState) -> void {
    probes(lab_st, render3d_st);  measured(render3d_st);  shots(lab_st)
    lab_note(lab_st, "no zone")
  }
  function tunnel_setup(zs: mut ZoneScene, lab_st: mut LabState, render3d_st: mut Render3dState) -> void {
    probes(lab_st, render3d_st)
    let z = lightzone_add(render3d_st, 2.0, 1.0, 0.0, 0.35, 3.5, 4.0, 14.0, 0.6)
    lightzone_ambient(render3d_st, z, 0.9, 0.62, 0.35, 0.0)
    shots(lab_st)
    lab_note(lab_st, "a turned tube: no sun, no sky, a warm ambient, every effect on")
  }
  function zone_tick(zs: mut ZoneScene, render3d_st: mut Render3dState) -> void {
    if zs.nosun { v3_set(render3d_st.sun_color, 0.0, 0.0, 0.0) }
  }
  def LabScenes zone { setup: fn zone_setup }
  def LabScenes zone_nosun { setup: fn nosun_setup }
  def LabScenes zone_off { setup: fn off_setup }
  def LabScenes zone_tunnel { setup: fn tunnel_setup }
  handler Boot(lab_st: mut LabState, render3d_st: mut Render3dState) phase Start { lab_boot(lab_st, render3d_st) }
  handler Sun(zs: mut ZoneScene, render3d_st: mut Render3dState) phase Update { zone_tick(zs, render3d_st) }
  handler Look(lab_st: mut LabState, render3d_st: mut Render3dState) phase Input { lab_input(lab_st, render3d_st) }
  handler Draw(lab_st: mut LabState, render3d_st: mut Render3dState) phase Render { lab_render(lab_st, render3d_st) }
}
