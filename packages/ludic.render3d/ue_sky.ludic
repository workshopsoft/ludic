# ============================================================================
# ue_sky.ludic — Unreal's Sky Atmosphere: the physical sky (Rayleigh, Mie, ozone) as UE 5.8 renders it.
#
# UeSky is USkyAtmosphereComponent (Engine/Private/Components/SkyAtmosphereComponent.cpp) with its Earth defaults and Unreal's names;
# ue_sky_setup turns it into the shader's atmosphere as FAtmosphereSetup::InternalInit does (SkyAtmosphereCommonData.cpp). The LUTs
# are SkyAtmosphereRendering.cpp's, at its r.SkyAtmosphere.* sizes and sample counts: transmittance 256x64 and multi-scattering 32x32
# (remade only when the atmosphere changes, r.SkyAtmosphere.StateVersioning), the sky view 192x104 every frame
# (ue_atmosphere.frag). The visible sky reads them (sky.frag uaSkyLuminance, the FASTSKY path) with the sun's disc
# (GetLightDiskLuminance: OuterSpaceIlluminance / the disc's solid angle at LightSourceAngle 0.5357 degrees).
#
# The planet is PlanetTopAtAbsoluteWorldOrigin: y = 0 is its ground, a metre a thousandth of a sky unit (km). The atmosphere light is the
# sun's true direction (daylight.ludic sky_disc_dir; the light itself is pointed at the moon at night) with an outer-space illuminance
# (UeSky.light_illuminance_*, by default the scene's own sun so the sky and the lit ground share one scale).
# R3D_UE_SKY=0 (or r3d_ue_sky(st, false)) puts the photograph sky back; on by default.
# ============================================================================

property UeSky {
  bottom_radius: float = 6360.0,                  # BottomRadius (km)
  atmosphere_height: float = 60.0,                # AtmosphereHeight (km)
  ground_albedo_r: float = 0.4019777798,          # GroundAlbedo FColor(170, 170, 170) in linear
  ground_albedo_g: float = 0.4019777798,
  ground_albedo_b: float = 0.4019777798,
  rayleigh_r: float = 0.175287,                   # RayleighScattering (0.005802, 0.013558, 0.0331) / 0.0331
  rayleigh_g: float = 0.409607,
  rayleigh_b: float = 1.0,
  rayleigh_scattering_scale: float = 0.0331,      # RayleighScatteringScale
  rayleigh_exponential_distribution: float = 8.0,  # RayleighExponentialDistribution (km)
  mie_scattering_scale: float = 0.003996,         # MieScatteringScale (MieScattering white)
  mie_absorption_scale: float = 0.000444,         # MieAbsorptionScale (MieAbsorption white)
  mie_anisotropy: float = 0.8,                    # MieAnisotropy
  mie_exponential_distribution: float = 1.2,      # MieExponentialDistribution (km)
  other_absorption_r: float = 0.345561,           # OtherAbsorption (0.00065, 0.001881, 0.000085) / 0.001881
  other_absorption_g: float = 1.0,
  other_absorption_b: float = 0.045189,
  other_absorption_scale: float = 0.001881,       # OtherAbsorptionScale
  tent_tip_altitude: float = 25.0,                # OtherTentDistribution.TipAltitude (km)
  tent_tip_value: float = 1.0,                    # .TipValue
  tent_width: float = 15.0,                       # .Width (km)
  multi_scattering_factor: float = 1.0,           # MultiScatteringFactor
  sky_luminance_factor: float = 1.0,              # SkyLuminanceFactor (white)
  sky_and_aerial_perspective_luminance_factor: float = 1.0,   # SkyAndAerialPerspectiveLuminanceFactor (white)
  aerial_pespective_view_distance_scale: float = 1.0,  # AerialPespectiveViewDistanceScale
  aerial_perspective_start_depth: float = 0.1,    # AerialPerspectiveStartDepth (km)
  height_fog_contribution: float = 1.0,           # HeightFogContribution
  trace_sample_count_scale: float = 1.0,          # TraceSampleCountScale
  light_source_angle: float = 0.5357,             # the sun's LightSourceAngle (degrees)
  sun_disk_color_scale: float = 1.0,              # AtmosphereSunDiskColorScale (white)
  light_illuminance_r: float = -1.0,              # the sun's outer-space illuminance; negative: the scene's own sun (day_sun_base)
  light_illuminance_g: float = -1.0,
  light_illuminance_b: float = -1.0,
  # r.SkyAtmosphere.*
  transmittance_lut_width: int = 256,
  transmittance_lut_height: int = 64,
  transmittance_sample_count: float = 10.0,
  multi_scattering_lut_size: int = 32,
  multi_scattering_sample_count: float = 15.0,
  fast_sky_lut_width: int = 192,
  fast_sky_lut_height: int = 104,
  fast_sky_sample_count_min: float = 4.0,
  fast_sky_sample_count_max: float = 32.0,
  fast_sky_distance_to_sample_count_max: float = 150.0,
  ap_depth_resolution: float = 16.0,              # r.SkyAtmosphere.AerialPerspectiveLUT.DepthResolution
  ap_depth_km: float = 96.0,                      # r.SkyAtmosphere.AerialPerspectiveLUT.Depth
  ap_sample_count_per_slice: float = 2.0          # r.SkyAtmosphere.AerialPerspectiveLUT.SampleCountMaxPerSlice
}

@alloc_ok("made once per resource and kept for its life (a texture, program, sampler, view, layout or memory block is created when first asked for)")
export function r3d_sky_atmosphere(render3d_st: mut Render3dState) -> UeSky {
  if render3d_st.ue_sky_s == null { render3d_st.ue_sky_s = new UeSky }
  return render3d_st.ue_sky_s
}
export function r3d_ue_sky(render3d_st: mut Render3dState, on: bool) -> void {
  render3d_st.ue_sky_on = 0
  if on { render3d_st.ue_sky_on = 1 }
}
function ue_sky_on(render3d_st: mut Render3dState) -> bool {
  if render3d_st.ue_sky_on < 0 {
    render3d_st.ue_sky_on = 1
    if r3d_env_has(render3d_st, "R3D_UE_SKY") and r3d_env(render3d_st, "R3D_UE_SKY") == "0" { render3d_st.ue_sky_on = 0 }
  }
  return render3d_st.ue_sky_on == 1
}

# the sun's true direction, toward it (ours: y up)
function ue_sky_sun(render3d_st: mut Render3dState, o: floats) -> void {
  if render3d_st.day_on { v3_set(o, render3d_st.sky_disc_dir[0], render3d_st.sky_disc_dir[1], render3d_st.sky_disc_dir[2]) }
  else { v3_set(o, render3d_st.sun_dir[0], render3d_st.sun_dir[1], render3d_st.sun_dir[2]) }
}
# the outer-space illuminance
function ue_sky_illum(render3d_st: mut Render3dState, o: floats) -> void {
  let s = r3d_sky_atmosphere(render3d_st)
  if s.light_illuminance_r >= 0.0 { v3_set(o, s.light_illuminance_r, s.light_illuminance_g, s.light_illuminance_b);  return }
  if render3d_st.day_sun_base != null { v3_set(o, render3d_st.day_sun_base[0], render3d_st.day_sun_base[1], render3d_st.day_sun_base[2]);  return }
  v3_set(o, render3d_st.sun_color[0], render3d_st.sun_color[1], render3d_st.sun_color[2])
}

# FAtmosphereSetup::InternalInit, as the atmosphere uniforms of ue_atmosphere.frag
function ue_sky_setup(render3d_st: mut Render3dState, p: int) -> void {
  let s = r3d_sky_atmosphere(render3d_st)
  let bottom = s.bottom_radius
  let top = s.bottom_radius + Math.max(0.1, s.atmosphere_height)
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "ua_radii"), bottom, top)
  let rs = s.rayleigh_scattering_scale
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "ua_rayleigh"), s.rayleigh_r * rs, s.rayleigh_g * rs, s.rayleigh_b * rs, -1.0 / s.rayleigh_exponential_distribution)
  let ms = s.mie_scattering_scale
  let ma = s.mie_absorption_scale
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "ua_mie_sca"), ms, ms, ms, -1.0 / s.mie_exponential_distribution)
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "ua_mie_ext"), ms + ma, ms + ma, ms + ma, s.mie_anisotropy)
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "ua_mie_abs"), ma, ma, ma)
  let os = s.other_absorption_scale
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "ua_ozone"), s.other_absorption_r * os, s.other_absorption_g * os, s.other_absorption_b * os)
  # TentToCoefficients
  var width = 0.0;  var lin0 = 0.0;  var lin1 = 0.0;  var c0 = 0.0;  var c1 = 0.0
  if s.tent_width > 0.0 and s.tent_tip_value > 0.0 {
    let px = s.tent_tip_altitude
    let py = s.tent_tip_value
    let slope = s.tent_tip_value / s.tent_width
    width = px;  lin0 = slope;  lin1 = -slope
    c0 = py - px * lin0;  c1 = py - px * lin1
  }
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "ua_ozone_tent"), width, lin0, c0, lin1)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "ua_ozone_c1"), c1)
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "ua_ground_albedo"), s.ground_albedo_r, s.ground_albedo_g, s.ground_albedo_b)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "ua_ms_factor"), Math.clamp(s.multi_scattering_factor, 0.0, 100.0))
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "ua_samples"), s.transmittance_sample_count, s.multi_scattering_sample_count, s.fast_sky_sample_count_min, s.fast_sky_sample_count_max)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "ua_dist_to_max_inv"), 1.0 / Math.max(s.fast_sky_distance_to_sample_count_max, 1.0))
  # AerialPespectiveViewDistanceScale is 1 in every pass but the aerial perspective volume (ue_fog_luts sets it there)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "ua_ap_scale"), 1.0)
}

# a key over everything the transmittance and multi-scattering LUTs depend on (Unreal's atmosphere version)
function ue_sky_version(s: UeSky) -> float {
  var k = 0.0
  k += s.bottom_radius * 1.3
  k += s.atmosphere_height * 2.7
  k += s.rayleigh_r * 3.1
  k += s.rayleigh_g * 5.3
  k += s.rayleigh_b * 7.7
  k += s.rayleigh_scattering_scale * 1100.0
  k += s.rayleigh_exponential_distribution * 11.0
  k += s.mie_scattering_scale * 13000.0
  k += s.mie_absorption_scale * 17000.0
  k += s.mie_anisotropy * 19.0
  k += s.mie_exponential_distribution * 23.0
  k += s.other_absorption_r * 29.0
  k += s.other_absorption_g * 31.0
  k += s.other_absorption_b * 37.0
  k += s.other_absorption_scale * 41000.0
  k += s.tent_tip_altitude * 43.0
  k += s.tent_tip_value * 47.0
  k += s.tent_width * 53.0
  k += s.multi_scattering_factor * 59.0
  k += s.ground_albedo_r * 61.0
  k += s.ground_albedo_g * 67.0
  k += s.ground_albedo_b * 71.0
  k += s.transmittance_sample_count * 73.0
  k += s.multi_scattering_sample_count * 79.0
  k += float(s.transmittance_lut_width) * 83.0
  k += float(s.transmittance_lut_height) * 89.0
  k += float(s.multi_scattering_lut_size) * 97.0
  return k
}

function ue_sky_lut_draw(render3d_st: mut Render3dState, t: Target, p: int) -> void {
  target_bind(render3d_st, t)
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "ua_size"), float(t.w), float(t.h), 1.0 / float(t.w), 1.0 / float(t.h))
  mesh_draw(render3d_st, render3d_st.post_fs)
}

# The camera's view height and the sky view LUT's frame (FAtmosphereSetup::ComputeViewData, PlanetTopAtAbsoluteWorldOrigin), into
# ue_sky_frame: [0..2] forward, [3..5] left, [6..8] up (Unreal's frame), [9] the view height (km)
function ue_sky_view_data(render3d_st: mut Render3dState) -> void {
  let s = r3d_sky_atmosphere(render3d_st)
  let f = render3d_st.ue_sky_frame
  # the planet's centre straight below the camera: up is +z, and the height is the bottom radius plus the camera's (km), held 5 m above
  let h = Math.max(s.bottom_radius + render3d_st.cam_pos[1] * 0.001, s.bottom_radius + 0.005)
  let ux = 0.0;  let uy = 0.0;  let uz = 1.0
  # the camera's forward in Unreal's frame (x, z, y)
  var fx = render3d_st.cam_fwd[0];  var fy = render3d_st.cam_fwd[2];  var fz = render3d_st.cam_fwd[1]
  # Left = Forward x Up, normalised
  var lx = fy * uz - fz * uy;  var ly = fz * ux - fx * uz;  var lz = fx * uy - fy * ux
  let ll = Math.sqrt(lx * lx + ly * ly + lz * lz)
  if Math.abs(fz) > 0.999 or ll < 0.000001 {
    # straight up or down: Unreal's orthonormal basis from Up (z up: Sign 1, a -1/2, b 0)
    fx = 1.0 - 0.5 * ux * ux;  fy = 0.0;  fz = -ux
    lx = 0.0;  ly = 1.0 - 0.5 * uy * uy;  lz = -uy
  } else {
    lx = lx / ll;  ly = ly / ll;  lz = lz / ll
    # Forward = Up x Left
    fx = uy * lz - uz * ly;  fy = uz * lx - ux * lz;  fz = ux * ly - uy * lx
    let fl = Math.sqrt(fx * fx + fy * fy + fz * fz)
    fx = fx / fl;  fy = fy / fl;  fz = fz / fl
  }
  f[0] = fx;  f[1] = fy;  f[2] = fz;  f[3] = lx;  f[4] = ly;  f[5] = lz;  f[6] = ux;  f[7] = uy;  f[8] = uz;  f[9] = h
}

@alloc_ok("a world being set up (a stream, a layer, water, post, a bake): the map loading or swapping, not a frame")
function ue_sky_targets(render3d_st: mut Render3dState) -> void {
  let s = r3d_sky_atmosphere(render3d_st)
  if render3d_st.ue_sky_trans != null and (render3d_st.ue_sky_trans.w != s.transmittance_lut_width or render3d_st.ue_sky_trans.h != s.transmittance_lut_height) {
    target_free(render3d_st, render3d_st.ue_sky_trans);  render3d_st.ue_sky_trans = null
  }
  if render3d_st.ue_sky_ms != null and render3d_st.ue_sky_ms.w != s.multi_scattering_lut_size { target_free(render3d_st, render3d_st.ue_sky_ms);  render3d_st.ue_sky_ms = null }
  if render3d_st.ue_sky_view != null and (render3d_st.ue_sky_view.w != s.fast_sky_lut_width or render3d_st.ue_sky_view.h != s.fast_sky_lut_height) {
    target_free(render3d_st, render3d_st.ue_sky_view);  render3d_st.ue_sky_view = null
  }
  if render3d_st.ue_sky_trans == null {
    render3d_st.ue_sky_trans = target_new(render3d_st, max(s.transmittance_lut_width, 4), max(s.transmittance_lut_height, 4), GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR)
    render3d_st.ue_sky_version = -1.0
  }
  if render3d_st.ue_sky_ms == null {
    render3d_st.ue_sky_ms = target_new(render3d_st, max(s.multi_scattering_lut_size, 4), max(s.multi_scattering_lut_size, 4), GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR)
    render3d_st.ue_sky_version = -1.0
  }
  if render3d_st.ue_sky_view == null {
    render3d_st.ue_sky_view = target_new(render3d_st, max(s.fast_sky_lut_width, 4), max(s.fast_sky_lut_height, 4), GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR)
  }
  if render3d_st.ue_sky_tmp == null { render3d_st.ue_sky_tmp = floats(6);  render3d_st.ue_sky_frame = floats(10);  render3d_st.ue_fog_tmp = floats(3) }
  if render3d_st.ue_sky_pt == 0 {
    render3d_st.ue_sky_pt = r3d_program(render3d_st, "fullscreen.vert", "ue_atmosphere.frag", "#define UA_TRANSMITTANCE\n")
    render3d_st.ue_sky_pm = r3d_program(render3d_st, "fullscreen.vert", "ue_atmosphere.frag", "#define UA_MULTISCAT\n")
    render3d_st.ue_sky_pv = r3d_program(render3d_st, "fullscreen.vert", "ue_atmosphere.frag", "#define UA_SKYVIEW\n")
  }
}

# Before the scene: the transmittance and multi-scattering LUTs when the atmosphere changed, the sky view LUT every frame
function ue_sky_luts(render3d_st: mut Render3dState) -> void {
  if not ue_sky_on(render3d_st) or render3d_st.post_fs == null or render3d_st.cam_pos == null { return }
  ue_sky_targets(render3d_st)
  let s = r3d_sky_atmosphere(render3d_st)
  prof_begin(render3d_st, "UE sky LUTs")
  gpu_depth_test(render3d_st, false)
  gpu_blend(render3d_st, false)
  let v = ue_sky_version(s)
  if v != render3d_st.ue_sky_version {
    var p = render3d_st.ue_sky_pt
    gpu_use_program(render3d_st, p)
    ue_sky_setup(render3d_st, p)
    ue_sky_lut_draw(render3d_st, render3d_st.ue_sky_trans, p)
    p = render3d_st.ue_sky_pm
    gpu_use_program(render3d_st, p)
    ue_sky_setup(render3d_st, p)
    r3d_bind_2d(render3d_st, p, "ua_transmittance", 0, render3d_st.ue_sky_trans.color)
    ue_sky_lut_draw(render3d_st, render3d_st.ue_sky_ms, p)
    render3d_st.ue_sky_version = v
  }
  ue_sky_view_data(render3d_st)
  let f = render3d_st.ue_sky_frame
  let sun = render3d_st.ue_sky_tmp
  ue_sky_sun(render3d_st, sun)
  # the sun in Unreal's frame, then in the LUT's local frame (mul(LocalReferencial, dir): the rows forward, left, up)
  let sx = sun[0];  let sy = sun[2];  let sz = sun[1]
  let p = render3d_st.ue_sky_pv
  gpu_use_program(render3d_st, p)
  ue_sky_setup(render3d_st, p)
  r3d_bind_2d(render3d_st, p, "ua_transmittance", 0, render3d_st.ue_sky_trans.color)
  r3d_bind_2d(render3d_st, p, "ua_multiscat", 1, render3d_st.ue_sky_ms.color)
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "ua_light_dir"), f[0] * sx + f[1] * sy + f[2] * sz, f[3] * sx + f[4] * sy + f[5] * sz, f[6] * sx + f[7] * sy + f[8] * sz, f[9])
  ue_sky_illum(render3d_st, sun)
  let k = s.sky_and_aerial_perspective_luminance_factor
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "ua_light_illum"), sun[0] * k, sun[1] * k, sun[2] * k)
  ue_sky_lut_draw(render3d_st, render3d_st.ue_sky_view, p)
  prof_end(render3d_st)
  ue_fog_luts(render3d_st)
}

# the visible sky's uniforms (sky.frag): ua_on 0 leaves the photograph sky
function ue_sky_bind(render3d_st: mut Render3dState, prog: int) -> void {
  var on = 0.0
  if ue_sky_on(render3d_st) and render3d_st.ue_sky_view != null and render3d_st.ue_sky_frame != null { on = 1.0 }
  u_f(render3d_st, gpu_uniform(render3d_st, prog, "ua_on"), on)
  if on < 0.5 { return }
  let s = r3d_sky_atmosphere(render3d_st)
  let f = render3d_st.ue_sky_frame
  r3d_bind_2d(render3d_st, prog, "ua_skyview", 6, render3d_st.ue_sky_view.color)
  r3d_bind_2d(render3d_st, prog, "ua_trans", 7, render3d_st.ue_sky_trans.color)
  let w = float(render3d_st.ue_sky_view.w);  let h = float(render3d_st.ue_sky_view.h)
  u_f4(render3d_st, gpu_uniform(render3d_st, prog, "ua_skyview_size"), w, h, 1.0 / w, 1.0 / h)
  u_f2(render3d_st, gpu_uniform(render3d_st, prog, "ua_radii_s"), s.bottom_radius, s.bottom_radius + Math.max(0.1, s.atmosphere_height))
  u_f(render3d_st, gpu_uniform(render3d_st, prog, "ua_view_height"), f[9])
  u_f3(render3d_st, gpu_uniform(render3d_st, prog, "ua_ref0"), f[0], f[1], f[2])
  u_f3(render3d_st, gpu_uniform(render3d_st, prog, "ua_ref1"), f[3], f[4], f[5])
  u_f3(render3d_st, gpu_uniform(render3d_st, prog, "ua_ref2"), f[6], f[7], f[8])
  let sun = render3d_st.ue_sky_tmp
  ue_sky_sun(render3d_st, sun)
  u_f3(render3d_st, gpu_uniform(render3d_st, prog, "ua_sun_ue"), sun[0], sun[2], sun[1])
  # GetLightDiskLuminance: illuminance x AtmosphereSunDiskColorScale / the disc's solid angle; LightSourceAngle is the full apex
  let half = Math.deg_to_rad(s.light_source_angle) * 0.5
  let solid = 2.0 * PI * (1.0 - Math.cos(half))
  ue_sky_illum(render3d_st, sun)
  let k = s.sun_disk_color_scale / solid
  u_f4(render3d_st, gpu_uniform(render3d_st, prog, "ua_disc"), sun[0] * k, sun[1] * k, sun[2] * k, Math.cos(half))
  let lf = s.sky_luminance_factor
  u_f3(render3d_st, gpu_uniform(render3d_st, prog, "ua_sky_factor"), lf, lf, lf)
}
