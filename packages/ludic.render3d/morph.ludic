# ============================================================================
# morph.ludic — a glTF primitive's morph targets (blend shapes): read with the model, applied on the CPU when
# their weights change (model_morph) — a person's build set on a wardrobe's sliders, not every frame. The
# primitive's POSITION and NORMAL buffers are filled again: base + the sum of weight x delta, the normals
# renormalised. A buffer refilled while a frame still reads it swaps to its second (gvk_buf_reserve).
# ============================================================================

property Morph {
  n: int = 0,              # vertices
  pos: pointer,            # the base positions (n x 3 floats), and normals (null: the mesh has none)
  nrm: pointer,
  dpos: []pointer,         # per target: its position deltas, its normal deltas (null: none)
  dnrm: []pointer,
  names: []string,         # per target: its name (the mesh's extras.targetNames), "" unnamed
  pbuf: int = 0,           # the mesh's POSITION buffer, its NORMAL buffer (0 none)
  nbuf: int = 0,
  outp: pointer,           # scratch: the morphed positions and normals
  outn: pointer,
  idx: pointer,            # the primitive's own indices (isz bytes each, ntri x 3): a body hides the triangles clothes cover
  isz: int = 4,
  ntri: int = 0,
  outi: pointer            # scratch: the indices drawn
}

# a copy of an accessor's floats (n x comps), as a float buffer of our own
@alloc_ok("loading a model: a morph target's data, once")
function morph_floats(render3d_st: mut Render3dState, acc: int) -> pointer {
  let data = gltf_accessor(render3d_st, acc)
  let k = render3d_st.gltf_count * render3d_st.gltf_comps
  let out = fbuf_floats(k)
  for i in 0 .. k { fbuf_put_bits(out, i, mem_get_f32_bits(data, i)) }
  free(data)
  return out
}

# the morph targets of glTF primitive p (mesh: its mesh, for the names) onto pr; nothing when it has none. The
# targets' accessors must be dense (Blender: export_try_sparse_sk off)
@alloc_ok("loading a model: a primitive's morph targets, once")
function morph_load(render3d_st: mut Render3dState, pr: Prim, p: Val, mesh: Val) -> void {
  var nt = 0
  if value_has(p, "targets") != 0 { nt = value_count(value_get(p, "targets")) }
  if nt == 0 {
    # no targets: only the indices, and only when asked (a body clothes hide triangles of: model_hide_triangles)
    if not render3d_st.gltf_keep_idx or value_has(p, "indices") == 0 { return }
    let mi = new Morph
    mi.dpos = new []pointer
    mi.dnrm = new []pointer
    mi.names = new []string
    morph_indices(render3d_st, mi, p)
    pr.morph = mi
    return
  }
  let ts = value_get(p, "targets")
  let attrs = value_get(p, "attributes")
  let mo = new Morph
  mo.pos = morph_floats(render3d_st, value_as_int(value_get(attrs, "POSITION")))
  mo.n = render3d_st.gltf_count
  if value_has(attrs, "NORMAL") != 0 { mo.nrm = morph_floats(render3d_st, value_as_int(value_get(attrs, "NORMAL"))) }
  mo.dpos = new []pointer
  mo.dnrm = new []pointer
  mo.names = new []string
  var names: Val = null
  if mesh != null and value_has(mesh, "extras") != 0 and value_has(value_get(mesh, "extras"), "targetNames") != 0 {
    names = value_get(value_get(mesh, "extras"), "targetNames")
  }
  for t in 0 .. nt {
    let tg = value_at(ts, t)
    var dp: pointer = null
    var dn: pointer = null
    if value_has(tg, "POSITION") != 0 { dp = morph_floats(render3d_st, value_as_int(value_get(tg, "POSITION"))) }
    if value_has(tg, "NORMAL") != 0 and mo.nrm != null { dn = morph_floats(render3d_st, value_as_int(value_get(tg, "NORMAL"))) }
    push(mo.dpos, dp)
    push(mo.dnrm, dn)
    var nm = ""
    if names != null and t < value_count(names) { let s = value_as_str(value_at(names, t));  nm = s[0..len(s)] }
    push(mo.names, nm)
  }
  # the buffers gltf_prim made: POSITION first, NORMAL second when there is one
  let m = pr.mesh
  if m.n_vbufs > 0 { mo.pbuf = m.vbufs[0] }
  if mo.nrm != null and m.n_vbufs > 1 { mo.nbuf = m.vbufs[1] }
  mo.outp = fbuf_floats(mo.n * 3)
  if mo.nrm != null { mo.outn = fbuf_floats(mo.n * 3) }
  morph_indices(render3d_st, mo, p)
  pr.morph = mo
}

# the primitive's own indices kept on mo (a copy the triangles hidden are left out of when the index buffer is filled again)
@alloc_ok("loading a model: a primitive's indices, once")
function morph_indices(render3d_st: mut Render3dState, mo: Morph, p: Val) -> void {
  if value_has(p, "indices") == 0 { return }
  mo.idx = gltf_accessor(render3d_st, value_as_int(value_get(p, "indices")))
  mo.isz = 4
  if render3d_st.gltf_ctype == 5123 { mo.isz = 2 }
  mo.ntri = render3d_st.gltf_count / 3
  mo.outi = bytes(render3d_st.gltf_count * mo.isz + 8)
}

# The model's first primitive drawn without the triangles flagged in `hidden` (one word a triangle, in the primitive's order: nonzero
# hides it); null shows them all. The index buffer is filled again; the vertices stay. True when it was
export function model_hide_triangles(render3d_st: mut Render3dState, model: Model, hidden: words) -> bool {
  if model == null or len(model.prims) == 0 { return false }
  let pr = model.prims[0]
  let mo = pr.morph
  if mo == null or mo.idx == null { return false }
  var k = 0
  for t in 0 .. mo.ntri {
    if hidden != null and t < len(hidden) and hidden[t] != 0 { continue }
    let at = t * 3 * mo.isz
    for b in 0 .. 3 * mo.isz { mo.outi[k * 3 * mo.isz + b] = mo.idx[at + b] }
    k += 1
  }
  gpu_buffer_upload(render3d_st, pr.mesh.ebo, k * 3 * mo.isz, mo.outi, GPU_STATIC)
  pr.mesh.count = k * 3
  return true
}

# The model's morph targets at these weights: names[i] at w[i] (a target not named is at 0). Every primitive with
# targets is filled again; true when any was
export function model_morph(render3d_st: mut Render3dState, model: Model, names: []string, w: floats) -> bool {
  if model == null { return false }
  var any = false
  for pi in 0 .. len(model.prims) {
    let mo = model.prims[pi].morph
    if mo == null or mo.pbuf == 0 { continue }
    let nt = len(mo.names)
    let k = mo.n * 3
    for i in 0 .. k { fbuf_put_bits(mo.outp, i, mem_get_f32_bits(mo.pos, i)) }
    if mo.outn != null { for i in 0 .. k { fbuf_put_bits(mo.outn, i, mem_get_f32_bits(mo.nrm, i)) } }
    for t in 0 .. nt {
      var wt = 0.0
      for j in 0 .. len(names) { if names[j] == mo.names[t] { wt = w[j] } }
      if wt == 0.0 { continue }
      let dp = mo.dpos[t]
      if dp != null {
        for i in 0 .. k { fbuf_put_bits(mo.outp, i, float_bits(float_from_bits(mem_get_f32_bits(mo.outp, i)) + wt * float_from_bits(mem_get_f32_bits(dp, i)))) }
      }
      let dn = mo.dnrm[t]
      if dn != null and mo.outn != null {
        for i in 0 .. k { fbuf_put_bits(mo.outn, i, float_bits(float_from_bits(mem_get_f32_bits(mo.outn, i)) + wt * float_from_bits(mem_get_f32_bits(dn, i)))) }
      }
    }
    if mo.outn != null {
      for v in 0 .. mo.n {
        let x = float_from_bits(mem_get_f32_bits(mo.outn, v * 3))
        let y = float_from_bits(mem_get_f32_bits(mo.outn, v * 3 + 1))
        let z = float_from_bits(mem_get_f32_bits(mo.outn, v * 3 + 2))
        let l = Math.sqrt(x * x + y * y + z * z)
        if l > 0.000001 {
          fbuf_put_bits(mo.outn, v * 3, float_bits(x / l))
          fbuf_put_bits(mo.outn, v * 3 + 1, float_bits(y / l))
          fbuf_put_bits(mo.outn, v * 3 + 2, float_bits(z / l))
        }
      }
      if mo.nbuf != 0 { gpu_buffer_upload(render3d_st, mo.nbuf, fbuf_bytes_of(k), mo.outn, GPU_STATIC) }
    }
    gpu_buffer_upload(render3d_st, mo.pbuf, fbuf_bytes_of(k), mo.outp, GPU_STATIC)
    any = true
  }
  return any
}

# Every primitive of the model in the colour texture at `path` (a PNG, sRGB), loaded once through the glTF texture cache (keyed by path):
# a modular person's parts take their atlas this way (a body worn with any face's skin), not one copy of it in every file. `cutout`: the
# texture's alpha cuts (its edges dilated as a cut-out atlas's are). False when it would not load (the textures stay)
@alloc_ok("a look put on: an event, not a frame")
export function model_set_texture(render3d_st: mut Render3dState, model: Model, path: string, cutout: bool) -> bool {
  if model == null { return false }
  var dil = 0
  if cutout { dil = 24 }
  let id = tex_cached(render3d_st, path, true, dil)
  if id == 0 { return false }
  for pi in 0 .. len(model.prims) {
    # counted, as the loader counts its own: a part let go of releases this one reference, never the last one another part holds
    gltf_tex_ref(render3d_st, id)
    gltf_tex_unref(render3d_st, model.prims[pi].diff)
    model.prims[pi].diff = id
  }
  return true
}

# The model's surface detail from PNGs beside its colour: a normal map (tangent space, glTF's: green up) and an
# occlusion/roughness/metal map (R, G, B), both linear. "" keeps what the model has. True when both given loaded
@alloc_ok("a look put on: an event, not a frame")
# A head of hair as strands (a groom's strand points, the parts converter's strands_mh.py: <part>.bin beside its glb): 96 bytes a point,
# its four vec4s (position and radius, tangent and u, the hair toward the sky, the skin's normal and seed) then the next point's first
# two (a segment's other end, in the same record), one instance a segment;
# the model's mesh the segment's quad (skin.vert STRANDS INST). Its strands then drawn by strands.ludic as a groom's
@alloc_ok("a look put on: an event, not a frame")
# A head of hair's strand points (art/character/hair strands_mh.py pack_points), Unreal's packed control points (FPackedHairVertex:
# position as three halves from the groom's centre, u 8 bits, radius 6 bits of the groom's largest, type 2 bits: inside, root, tip) and
# what we bake beside them: the hair toward the sky (four halves: x + yzw.L) and the skin's normal at the root (octahedral, 2 x 8 bits) with
# the strand's seed (8 bits, Unreal's RandHelper(255) / 255). 20 bytes a point after a 32-byte header ("STR2", the count, the centre, the
# largest radius); one point of padding before and two after. Each instance is a segment (skin.vert INST): the same buffer read at four
# offsets gives its previous point, its two ends and the next, the tangents made from them as Unreal's tangent pass makes them
const ST_REC: int = 20
const ST_MAGIC: int = 0x32525453              # "STR2"
export function model_set_strand_points(render3d_st: mut Render3dState, model: Model, path: string) -> bool {
  if model == null or not Fs.exists(path) { return false }
  let b = Fs.read_bytes(path)
  if b == null { return false }
  if len(b) < 32 + 3 * ST_REC or mem_get_i32(data_of(b), 0) != ST_MAGIC {
    free(b)
    return false
  }
  let n = mem_get_i32(data_of(b), 4)
  if 32 + (n + 3) * ST_REC > len(b) or n < 2 {
    free(b)
    return false
  }
  let cx = float_from_bits(mem_get_f32_bits(data_of(b), 2));  let cy = float_from_bits(mem_get_f32_bits(data_of(b), 3))
  let cz = float_from_bits(mem_get_f32_bits(data_of(b), 4));  let rmax = float_from_bits(mem_get_f32_bits(data_of(b), 5))
  let buf = gpu_buffer_new(render3d_st)
  gpu_buffer_upload(render3d_st, buf, (n + 3) * ST_REC, mem_off(data_of(b), 32), GPU_STATIC)
  free(b)
  for pi in 0 .. len(model.prims) {
    let pr = model.prims[pi]
    let m = pr.mesh
    gpu_mesh_bind_instances(render3d_st, m, buf)
    gpu_mesh_attr_inst(render3d_st, m, 8, 4, GPU_U16, ST_REC, 0)                # the previous point
    gpu_mesh_attr_inst(render3d_st, m, 3, 4, GPU_U16, ST_REC, ST_REC)           # A
    gpu_mesh_attr_inst(render3d_st, m, 13, 4, GPU_U16, ST_REC, ST_REC + 8)      # its sky
    gpu_mesh_record(m, 15, 4, GPU_U8, ST_REC, ST_REC + 16, true, true)          # its root's normal and seed
    gpu_mesh_attr_inst(render3d_st, m, 4, 4, GPU_U16, ST_REC, 2 * ST_REC)       # B
    gpu_mesh_attr_inst(render3d_st, m, 14, 4, GPU_U16, ST_REC, 2 * ST_REC + 8)  # its sky
    gpu_mesh_attr_inst(render3d_st, m, 12, 4, GPU_U16, ST_REC, 3 * ST_REC)      # the next point
    gpu_mesh_done(render3d_st, m)
    if pi == 0 { pr.inst_buf = buf }
    pr.inst_n = n
    pr.st_cx = cx;  pr.st_cy = cy;  pr.st_cz = cz;  pr.st_rmax = rmax
  }
  return true
}

# A MetaHuman face's head at its own full resolution (Unreal's T_Head_N and T_Head_SRMF, 8K there; the parts converter's head_maps.py):
# one map, RGB the normal (green up), A the roughness, over the head's own uvs, which the look's atlas packs into its quadrant u, v < 0.5.
# The face's programs (model.frag EYE, SSS_SPLIT) read it there in place of the atlas's texels; the atlas keeps the micro detail's tile
export function model_set_headmap(render3d_st: mut Render3dState, model: Model, path: string) -> bool {
  if model == null { return false }
  let id = tex_cached(render3d_st, path, false, 0)
  if id == 0 { return false }
  for pi in 0 .. len(model.prims) {
    gltf_tex_ref(render3d_st, id)
    gltf_tex_unref(render3d_st, model.prims[pi].hmap)
    model.prims[pi].hmap = id
  }
  return true
}
export function model_set_maps(render3d_st: mut Render3dState, model: Model, nrm: string, arm: string) -> bool {
  if model == null { return false }
  var ok = true
  if nrm != "" {
    let id = tex_cached(render3d_st, nrm, false, 0)
    if id == 0 { ok = false } else {
      for pi in 0 .. len(model.prims) {
        gltf_tex_ref(render3d_st, id)
        gltf_tex_unref(render3d_st, model.prims[pi].nrm)
        model.prims[pi].nrm = id
      }
    }
  }
  if arm != "" {
    let id = tex_cached(render3d_st, arm, false, 0)
    if id == 0 { ok = false } else {
      for pi in 0 .. len(model.prims) {
        gltf_tex_ref(render3d_st, id)
        gltf_tex_unref(render3d_st, model.prims[pi].arm)
        model.prims[pi].arm = id
        # the map carries the roughness and metal: the file's own factors (a placeholder's 0.7) no longer scale them
        let f = model.prims[pi].fac
        if f != null { f[4] = 1.0;  f[5] = 1.0 }
      }
    }
  }
  return ok
}

# a garment's fabric on every primitive of a model (model.frag FABRIC, Epic's M_fabric_simpler): p, 68 floats (u_fp's 17 vec4), and
# its textures by path, linear: the garment's masks, material A's tiled kit and normals, material B's ("" for none: the program
# binds the mask there). False when the mask could not be loaded (the model is left as it was)
@alloc_ok("a garment's fabric, set once when it is first worn")
export function model_set_fabric(render3d_st: mut Render3dState, model: Model, p: floats, mask: string, kit: string, dn: string, kitb: string, dnb: string) -> bool {
  if model == null or len(p) != 68 { return false }
  let paths = [mask, kit, dn, kitb, dnb]
  let ids = words(5)
  for k in 0 .. 5 {
    ids[k] = 0
    if paths[k] != "" { ids[k] = tex_cached(render3d_st, paths[k], false, 0) }
  }
  if ids[0] == 0 {
    free(ids)
    return false
  }
  for pi in 0 .. len(model.prims) {
    let pr = model.prims[pi]
    if pr.ftex == null { pr.ftex = words(5);  for k in 0 .. 5 { pr.ftex[k] = 0 } }
    for k in 0 .. 5 {
      gltf_tex_ref(render3d_st, ids[k])
      gltf_tex_unref(render3d_st, pr.ftex[k])
      pr.ftex[k] = ids[k]
    }
    if pr.fab == null { pr.fab = floats(68) }
    for k in 0 .. 68 { pr.fab[k] = p[k] }
  }
  free(ids)
  return true
}

# A MetaHuman face's eyes (model.frag EYE: Epic's M_eye_eyeball_unified and the Eye shading model) on every primitive of a model whose
# eyeballs sit in two square cells of its atlas: cells = the left cell's u, the right's, their top v, their size, the inset each keeps
# (the eye's UV fills the rest); the five maps eye_maps.py bakes, by path: the sclera (sRGB), the normals, the iris (sRGB), the iris
# normal, the cornea's height, and the face's own: its eyeballs' visibility past the lids (eye_vis.py). False when one could not be
# loaded (the model is left as it was)
@alloc_ok("a face's eyes, set once when it is first worn")
export function model_set_eyes(render3d_st: mut Render3dState, model: Model, cells: floats, sclera: string, nrm: string, iris: string, irisn: string, disp: string, vis: string) -> bool {
  if model == null or len(cells) != 5 { return false }
  let paths = [sclera, nrm, iris, irisn, disp, vis]
  let ids = words(6)
  for k in 0 .. 6 {
    ids[k] = tex_cached(render3d_st, paths[k], k == 0 or k == 2, 0)
    if ids[k] == 0 {
      free(ids)
      return false
    }
  }
  for pi in 0 .. len(model.prims) {
    let pr = model.prims[pi]
    if pr.etex == null { pr.etex = words(6);  for k in 0 .. 6 { pr.etex[k] = 0 } }
    for k in 0 .. 6 {
      gltf_tex_ref(render3d_st, ids[k])
      gltf_tex_unref(render3d_st, pr.etex[k])
      pr.etex[k] = ids[k]
    }
    if pr.eye == null { pr.eye = floats(5) }
    for k in 0 .. 5 { pr.eye[k] = cells[k] }
  }
  free(ids)
  return true
}

# a PNG's texture, loaded once per path (the path cache gltf shares)
@alloc_ok("a texture loaded once per path")
function tex_cached(render3d_st: mut Render3dState, path: string, srgb: bool, dil: int) -> int {
  if render3d_st.gltf_tex_paths == null { render3d_st.gltf_tex_paths = new []pointer;  render3d_st.gltf_tex_ids = words(256);  render3d_st.gltf_tex_refs = words(256) }
  var i = 0
  while i < render3d_st.gltf_tex_n {
    if render3d_st.gltf_tex_paths[i] == path { return render3d_st.gltf_tex_ids[i] }
    i += 1
  }
  let key = path[0..len(path)]
  let id = tex_load_ex(render3d_st, key, srgb, dil)
  if id == 0 { return 0 }
  # (counted from 0: each primitive that takes it adds itself, gltf_tex_ref)
  gltf_tex_add(render3d_st, key, id, 0)
  return id
}

# the names of the model's morph targets (every primitive's, once each), for a caller that lists its sliders
@alloc_ok("a list made when asked: a wardrobe opening, not a frame")
export function model_morph_names(model: Model) -> []string {
  let out = new []string
  if model == null { return out }
  for pi in 0 .. len(model.prims) {
    let mo = model.prims[pi].morph
    if mo == null { continue }
    for t in 0 .. len(mo.names) {
      var seen = false
      for j in 0 .. len(out) { if out[j] == mo.names[t] { seen = true } }
      if not seen { push(out, mo.names[t]) }
    }
  }
  return out
}
