# grass_clear.ludic — the clearings (ground_clear.ludic) for the blades: grass_cull.comp thins every blade by
# them as ground_clear_at thins a trampled layer's candidate, at each clearing's floor and feather, so the long
# grass keeps off a camp's props and a cabin's floor as the tufts and the flowers do. The GPU holds the list as
# it is held here - GD_CLEAR_W floats a clearing, then the areas' and strips' points - sent again only when a
# clearing is put or the list let go (gd_clear_ver), never per frame; the cull walks it, each box first.

const GG_CLEAR_PTS_AT: int = 640     # GD_CLEAR_MAX * GD_CLEAR_W: where the points start in the buffer
const GG_CLEAR_FLOATS: int = 8832    # ... and the whole buffer: the clearings, then GD_CLEAR_PTS (x, z) points

# once, with the cull's buffers: the list's floats and its buffer, empty
@alloc_ok("start-up: the clearings' copy and buffer for the blade cull, once")
function gg_clear_init(render3d_st: mut Render3dState) -> void {
  render3d_st.gg_clear_data = floats(GG_CLEAR_FLOATS)
  for i in 0 .. GG_CLEAR_FLOATS { render3d_st.gg_clear_data[i] = 0.0 }
  render3d_st.gg_clear_buf = gpu_buffer_new(render3d_st)
  gpu_buffer_upload(render3d_st, render3d_st.gg_clear_buf, GG_CLEAR_FLOATS * 4, data_of(render3d_st.gg_clear_data), GPU_DYNAMIC)
  render3d_st.gg_clear_ver = render3d_st.gd_clear_ver - 1
}

# before the cull: the list sent when it changed since it was last sent
function gg_clear_frame(render3d_st: mut Render3dState) -> void {
  if render3d_st.gg_clear_ver == render3d_st.gd_clear_ver or render3d_st.gg_clear_data == null { return }
  render3d_st.gg_clear_ver = render3d_st.gd_clear_ver
  gg_clear_pack(render3d_st)
  gpu_buffer_upload(render3d_st, render3d_st.gg_clear_buf, GG_CLEAR_FLOATS * 4, data_of(render3d_st.gg_clear_data), GPU_DYNAMIC)
}

# the clearings and their points into the buffer's floats, as grass_cull.comp reads them (a test reads it too)
function gg_clear_pack(render3d_st: mut Render3dState) -> void {
  let d = render3d_st.gg_clear_data
  for i in 0 .. render3d_st.gd_clear_n * GD_CLEAR_W { d[i] = render3d_st.gd_clear[i] }
  for i in 0 .. render3d_st.gd_clear_pn * 2 { d[GG_CLEAR_PTS_AT + i] = render3d_st.gd_clear_pts[i] }
}

# grass_cull.comp's Params word 80: how many clearings the list holds
function gg_clear_params(render3d_st: Render3dState, pr: words) -> void {
  var n = 0
  if render3d_st.gg_clear_data != null { n = render3d_st.gd_clear_n }
  pr[80] = float_bits(float(n))
}
