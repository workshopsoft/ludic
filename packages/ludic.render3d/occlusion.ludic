# occlusion.ludic - the actors' occlusion culling, as Unreal 5.8 does it by default (SceneVisibility.cpp r.HZBOcclusion 0: hardware occlusion
# queries; r.AllowOcclusionQueries 1). After the opaque scene each actor worth testing has its bounds drawn as a box against the scene's
# depth, writing nothing, inside a query; the next frame reads how many samples passed (r.NumBufferedOcclusionQueries 1: the frame before)
# and an actor none of whose box showed is not drawn in the main view. Its shadow is untouched (r.Shadow.OcclusionCullCascadedShadowMaps 0).
# Unreal's rules kept: a box the near plane cuts is visible and not tested (its bAllowBoundsTest, FVector::BoxPushOut), an actor not
# tested this frame is visible the next, a query not ready is visible. Not kept: its grouped queries for the occluded and its random
# re-test of the visible (every candidate is tested every frame). R3D_UE_OCCLUSION=0 switches it off; R3D_UE_OCCLUSION_MIN_TRIS (1000)
# is the smallest model tested, below which a query costs more than it saves.
# By default it is Unreal's r.HZBOcclusion 1 instead (R3D_UE_HZB_OCCLUSION=0: the queries above) ("less GPU and CPU cost, more conservative"): after the resolve the
# furthest HZB is built from the frame's depth (hzb_build.comp) and one dispatch tests every candidate's box against it
# (hzb_test.comp, FHZBOcclusionTester / HZBOcclusion.usf), into a buffer read the next frame by the same rules.
const OCC_MAX: int = 4096
const OCC_MIN_TRIS: int = 1000
const OCC_SLACK: float = 1.1          # a model's box widened: a skinned figure's pose leaves its bind pose's bounds

function occ_on(render3d_st: mut Render3dState) -> bool {
  if render3d_st.occ_state == 0 {
    render3d_st.occ_state = 2
    if render3d_st.gpu_kind == GPU_VK and not (r3d_env_has(render3d_st, "R3D_UE_OCCLUSION") and r3d_env(render3d_st, "R3D_UE_OCCLUSION") == "0") {
      if not (r3d_env_has(render3d_st, "R3D_UE_HZB_OCCLUSION") and r3d_env(render3d_st, "R3D_UE_HZB_OCCLUSION") == "0") {
        if occ_hzb_init(render3d_st) { render3d_st.occ_state = 1;  render3d_st.occ_hzb = true }
      } else if render3d_st.gvk_has_hqr and occ_init(render3d_st) { render3d_st.occ_state = 1 }
    }
    render3d_st.occ_min_tris = OCC_MIN_TRIS
    if r3d_env_has(render3d_st, "R3D_UE_OCCLUSION_MIN_TRIS") { render3d_st.occ_min_tris = Text.to_int(r3d_env(render3d_st, "R3D_UE_OCCLUSION_MIN_TRIS")) }
  }
  return render3d_st.occ_state == 1
}

function occ_init(render3d_st: mut Render3dState) -> bool {
  let qci = gvk_tmp(render3d_st, VkQueryPoolCreateInfo_sizeof)
  Vk.zero(qci, VkQueryPoolCreateInfo_sizeof)
  Vk.put_i32(qci, VkQueryPoolCreateInfo_sType, VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO)
  Vk.put_i32(qci, VkQueryPoolCreateInfo_queryType, VK_QUERY_TYPE_OCCLUSION)
  Vk.put_i32(qci, VkQueryPoolCreateInfo_queryCount, OCC_MAX)
  let out = gvk_tmp(render3d_st, 8)
  if Vk.create_query_pool(render3d_st.gvk_dev, qci, render3d_st.gvk_ac, out) != VK_SUCCESS { return false }
  render3d_st.gvk_occ_pool = gvk_handle(out)
  Vk.reset_query_pool(render3d_st.gvk_dev, render3d_st.gvk_occ_pool, 0, OCC_MAX)
  render3d_st.occ_prog = r3d_program(render3d_st, "occ_box.vert", "occ_box.frag", "")
  render3d_st.occ_list = new []Actor                       # OCC_MAX slots, filled in order each frame (occ_n of them)
  for i in 0 .. OCC_MAX { push(render3d_st.occ_list, null) }
  render3d_st.occ_ids = words(OCC_MAX)
  render3d_st.occ_b = floats(6)
  # the unit cube, -1..1
  let m = gpu_mesh_new(render3d_st)
  let v = fbuf_floats(24)
  for i in 0 .. 8 {
    fbuf_put_bits(v, i * 3, float_bits(float((i & 1) * 2 - 1)))
    fbuf_put_bits(v, i * 3 + 1, float_bits(float(((i >> 1) & 1) * 2 - 1)))
    fbuf_put_bits(v, i * 3 + 2, float_bits(float(((i >> 2) & 1) * 2 - 1)))
  }
  gpu_mesh_vertices(render3d_st, m, v, fbuf_bytes_of(24), GPU_STATIC)
  gpu_mesh_attr(render3d_st, m, 0, 3, GPU_F32, 12, 0, false)
  free(v)
  # six faces, two triangles each (both sides drawn: the winding does not matter)
  let faces = [0, 1, 3, 2,  4, 5, 7, 6,  0, 1, 5, 4,  2, 3, 7, 6,  0, 2, 6, 4,  1, 3, 7, 5]
  let idx = words(36)
  for f in 0 .. 6 {
    let a = faces[f * 4];  let b = faces[f * 4 + 1];  let c = faces[f * 4 + 2];  let d = faces[f * 4 + 3]
    idx[f * 6] = a;  idx[f * 6 + 1] = b;  idx[f * 6 + 2] = c
    idx[f * 6 + 3] = a;  idx[f * 6 + 4] = c;  idx[f * 6 + 5] = d
  }
  gpu_mesh_indices(render3d_st, m, data_of(idx), 36 * 4, 4)
  free(idx)
  m.count = 36
  gpu_mesh_done(render3d_st, m)
  render3d_st.occ_box = m
  return true
}

# last frame's results, once a frame before its first actor is drawn (the frame before has been waited for: its queries are done)
function occ_read(render3d_st: mut Render3dState) -> void {
  if render3d_st.occ_read_no == render3d_st.gvk_frame_no { return }
  render3d_st.occ_read_no = render3d_st.gvk_frame_no
  render3d_st.occ_live = false
  if not occ_on(render3d_st) { return }
  render3d_st.occ_live = true
  # an actor untested last frame is visible in this one
  if render3d_st.ac_actors != null { for i in 0 .. len(render3d_st.ac_actors) { render3d_st.ac_actors[i].occ_hidden = false } }
  let n = render3d_st.occ_n
  render3d_st.occ_hidden_n = 0
  if n == 0 { return }
  if render3d_st.occ_hzb { occ_hzb_read(render3d_st, n) } else {
    let data = gvk_tmp(render3d_st, n * 16)
    let size: long = n * 16
    let stride: long = 16
    # not waited for: a query not yet available reads as visible
    Vk.get_query_pool_results(render3d_st.gvk_dev, render3d_st.gvk_occ_pool, 0, n, size, data, stride, VK_QUERY_RESULT_64_BIT + VK_QUERY_RESULT_WITH_AVAILABILITY_BIT)
    for i in 0 .. n {
      let a = render3d_st.occ_list[i]
      render3d_st.occ_list[i] = null
      if a == null or a.id != render3d_st.occ_ids[i] { continue }             # released and taken again since
      let ready = Vk.get_i64(data, i * 16 + 8) != 0
      a.occ_hidden = ready and Vk.get_i64(data, i * 16) == 0
      if a.occ_hidden { render3d_st.occ_hidden_n += 1 }
    }
    Vk.reset_query_pool(render3d_st.gvk_dev, render3d_st.gvk_occ_pool, 0, n)
  }
  render3d_st.occ_n = 0
  # R3D_UE_OCCLUSION_STATS=k: every k frames, how many were tested and how many of them hidden
  if r3d_env_has(render3d_st, "R3D_UE_OCCLUSION_STATS") {
    let k = Text.to_int(r3d_env(render3d_st, "R3D_UE_OCCLUSION_STATS"))
    if k > 0 and render3d_st.gvk_frame_no % k == 0 { print(`occlusion: {n} actors tested, {render3d_st.occ_hidden_n} hidden`) }
  }
}

# whether the main view skips actor a: hidden behind the scene last frame (a part goes with its leader)
function occ_hidden(render3d_st: Render3dState, a: Actor) -> bool {
  if not render3d_st.occ_live or render3d_st.ter_reflect { return false }
  if a.leader != null { return a.leader.occ_hidden }
  return a.occ_hidden
}

# the box actor a is tested with: its cull sphere's middle and the ground's own extents (occ_hx), else its model's bounds
function occ_bounds(a: Actor, b: floats) -> void {
  let s = a.scale
  if a.occ_hx > 0.0 {
    b[0] = a.x;  b[1] = a.y + a.radius * s;  b[2] = a.z
    b[3] = a.occ_hx;  b[4] = a.occ_hy;  b[5] = a.occ_hx
    return
  }
  let m = a.model
  let r = m.radius * s * OCC_SLACK
  let y0 = a.y + m.ymin * s
  let hy = m.height * s * 0.5 * OCC_SLACK
  b[0] = a.x;  b[1] = y0 + m.height * s * 0.5;  b[2] = a.z
  b[3] = r;  b[4] = hy;  b[5] = r
}

# whether actor a is tested this frame, its box into b: worth a test and in view, and the near plane does not cut its box (cut: visible,
# untested - Unreal's NearClippingPlane.PlaneDot against BoxPushOut). Asked with occ_live off: the actors' own view test, not last frame's result
function occ_candidate(render3d_st: Render3dState, a: Actor, b: floats) -> bool {
  if a.leader != null or a.blend != 0 or a.shell or a.strands or a.model == null { return false }
  if a.occ_hx <= 0.0 and a.model.tris < render3d_st.occ_min_tris { return false }
  if not ac_visible(render3d_st, a, false) { return false }
  occ_bounds(a, b)
  let f = render3d_st.cam_fwd
  let cp = render3d_st.cam_pos
  let d = (b[0] - cp[0]) * f[0] + (b[1] - cp[1]) * f[1] + (b[2] - cp[2]) * f[2] - render3d_st.cam_near
  let push = b[3] * Math.abs(f[0]) + b[4] * Math.abs(f[1]) + b[5] * Math.abs(f[2])
  return d > push
}

# The tests, after the opaque scene and in its pass: every actor worth one that is in view, each box drawn into its own query
function occ_pass(render3d_st: mut Render3dState) -> void {
  if not render3d_st.occ_live or render3d_st.occ_hzb or render3d_st.ac_actors == null { return }
  let b = render3d_st.occ_b
  let p = render3d_st.occ_prog
  gpu_use_program(render3d_st, p)
  u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_vp"), render3d_st.cam_vp)
  let l_c = gpu_uniform(render3d_st, p, "u_c")
  let l_e = gpu_uniform(render3d_st, p, "u_e")
  gpu_depth_test(render3d_st, true)
  gpu_depth_func(render3d_st, GPU_GEQUAL)
  gpu_depth_write(render3d_st, false)
  gpu_color_write(render3d_st, false)
  gpu_blend(render3d_st, false)
  gpu_cull(render3d_st, false)
  render3d_st.occ_live = false                               # the actors' own view test, not last frame's result
  var n = 0
  for i in 0 .. len(render3d_st.ac_actors) {
    let a = render3d_st.ac_actors[i]
    if n >= OCC_MAX or not occ_candidate(render3d_st, a, b) { continue }
    u_f3(render3d_st, l_c, b[0], b[1], b[2])
    u_f3(render3d_st, l_e, b[3], b[4], b[5])
    render3d_st.gvk_occ_q = n
    mesh_draw(render3d_st, render3d_st.occ_box)
    render3d_st.gvk_occ_q = -1
    render3d_st.occ_list[n] = a
    render3d_st.occ_ids[n] = a.id
    n += 1
  }
  render3d_st.occ_live = true
  render3d_st.occ_n = n
  gpu_color_write(render3d_st, true)
  gpu_depth_write(render3d_st, true)
  gpu_depth_func(render3d_st, GPU_GREATER)
}

# ---- the HZB path (the default; R3D_UE_HZB_OCCLUSION=0 the queries) ----------------------------------------------------------------------------------------
const OCC_HZB_MIPS: int = 16

function occ_hzb_init(render3d_st: mut Render3dState) -> bool {
  render3d_st.occ_hzb_build = gpu_compute_tex(render3d_st, "hzb_build", 1, 1)
  render3d_st.occ_hzb_test = gpu_compute(render3d_st, "hzb_test", 3)
  if render3d_st.occ_hzb_build == 0 or render3d_st.occ_hzb_test == 0 { return false }
  render3d_st.occ_list = new []Actor
  for i in 0 .. OCC_MAX { push(render3d_st.occ_list, null) }
  render3d_st.occ_ids = words(OCC_MAX)
  render3d_st.occ_b = floats(6)
  render3d_st.occ_hzb_box = floats(OCC_MAX * 8)
  render3d_st.occ_hzb_mips = words(OCC_HZB_MIPS * 4)
  render3d_st.occ_hzb_pr = words(24 + OCC_HZB_MIPS * 4)
  render3d_st.occ_hzb_bufs = words(3)
  render3d_st.occ_hzb_texs = words(1)
  render3d_st.occ_hzb_buf = gpu_buffer_new(render3d_st)
  render3d_st.occ_hzb_bounds = words(2)
  render3d_st.occ_hzb_res = words(2)
  for k in 0 .. 2 {
    let bb = gpu_buffer_new(render3d_st)
    gpu_buffer_upload(render3d_st, bb, OCC_MAX * 32, null, GPU_DYNAMIC)
    render3d_st.occ_hzb_bounds[k] = bb
    let rb = gpu_buffer_new(render3d_st)
    gpu_buffer_upload(render3d_st, rb, OCC_MAX * 4, null, GPU_DYNAMIC)
    gpu_buffer_gpu_owned(render3d_st, rb)
    Vk.zero(gpu_buffer_map(render3d_st, rb), OCC_MAX * 4)              # no tag: read as visible
    render3d_st.occ_hzb_res[k] = rb
  }
  return true
}

# The pyramid's layout for a w x h frame: mip 0 half its power-of-two size (Unreal's HZBMipmap0Size), down to 1 x 1, one buffer
@alloc_ok("made again only when the frame's size changes, as the post targets are")
function occ_hzb_size(render3d_st: mut Render3dState, w: int, h: int) -> void {
  if w == render3d_st.occ_hzb_w and h == render3d_st.occ_hzb_h { return }
  render3d_st.occ_hzb_w = w;  render3d_st.occ_hzb_h = h
  var mw = 1
  while mw < w { mw = mw * 2 }
  var mh = 1
  while mh < h { mh = mh * 2 }
  mw = max(mw / 2, 1);  mh = max(mh / 2, 1)
  let mips = render3d_st.occ_hzb_mips
  var n = 0
  var at = 0
  while n < OCC_HZB_MIPS {
    mips[n * 4] = mw;  mips[n * 4 + 1] = mh;  mips[n * 4 + 2] = at;  mips[n * 4 + 3] = 0
    at += mw * mh
    n += 1
    if mw == 1 and mh == 1 { break }
    mw = max(mw / 2, 1);  mh = max(mh / 2, 1)
  }
  render3d_st.occ_hzb_n_mips = n
  gpu_buffer_upload(render3d_st, render3d_st.occ_hzb_buf, at * 4, null, GPU_DYNAMIC)
  gpu_buffer_gpu_owned(render3d_st, render3d_st.occ_hzb_buf)
}

# mips a build dispatch writes: 4 as Unreal's FHZBBuildCS (HZB.usf MAX_MIP_BATCH_SIZE); R3D_HZB_BATCH=0 one a dispatch
function occ_hzb_batch(render3d_st: mut Render3dState) -> int {
  if render3d_st.occ_hzb_batch == 0 {
    render3d_st.occ_hzb_batch = 4
    if r3d_env_has(render3d_st, "R3D_HZB_BATCH") and r3d_env(render3d_st, "R3D_HZB_BATCH") == "0" { render3d_st.occ_hzb_batch = 1 }
  }
  return render3d_st.occ_hzb_batch
}

# After the resolve: the candidates' boxes, the furthest HZB from the depth copy, and one dispatch testing every box against it
function occ_hzb_pass(render3d_st: mut Render3dState) -> void {
  if not render3d_st.occ_live or render3d_st.ac_actors == null or render3d_st.post_depth_copy == null { return }
  let b = render3d_st.occ_b
  let box = render3d_st.occ_hzb_box
  render3d_st.occ_live = false                               # the actors' own view test, not last frame's result
  var n = 0
  for i in 0 .. len(render3d_st.ac_actors) {
    let a = render3d_st.ac_actors[i]
    if n >= OCC_MAX or not occ_candidate(render3d_st, a, b) { continue }
    for k in 0 .. 3 { box[n * 8 + k] = b[k];  box[n * 8 + 4 + k] = b[3 + k] }
    box[n * 8 + 3] = 0.0;  box[n * 8 + 7] = 0.0
    render3d_st.occ_list[n] = a
    render3d_st.occ_ids[n] = a.id
    n += 1
  }
  render3d_st.occ_live = true
  render3d_st.occ_n = n
  if n == 0 { return }
  let w = render3d_st.post_w
  let h = render3d_st.post_h
  occ_hzb_size(render3d_st, w, h)
  let mips = render3d_st.occ_hzb_mips
  let pr = render3d_st.occ_hzb_pr
  let bufs = render3d_st.occ_hzb_bufs
  let texs = render3d_st.occ_hzb_texs
  bufs[0] = render3d_st.occ_hzb_buf
  texs[0] = render3d_st.post_depth_copy.depth
  # the pyramid as Unreal's BuildHZB (SceneTextureReductions.cpp): FHZBBuildCS writes up to kMaxMipBatchSize = 4 mips a dispatch,
  # mip 0 from the depth, each batch from the last mip of the one before; the dispatches' own barriers sit between the batches
  let batch = occ_hzb_batch(render3d_st)
  var m = 0
  while m < render3d_st.occ_hzb_n_mips {
    let k = min(batch, render3d_st.occ_hzb_n_mips - m)
    if m == 0 { pr[0] = w;  pr[1] = h;  pr[2] = 0;  pr[3] = 0 } else { pr[0] = mips[m * 4 - 4];  pr[1] = mips[m * 4 - 3];  pr[2] = mips[m * 4 - 2];  pr[3] = 1 }
    pr[4] = k;  pr[5] = 0;  pr[6] = 0;  pr[7] = 0
    for j in 0 .. 4 {
      let s = min(m + j, m + k - 1) * 4
      pr[8 + j * 4] = mips[s];  pr[9 + j * 4] = mips[s + 1];  pr[10 + j * 4] = mips[s + 2];  pr[11 + j * 4] = 0
    }
    gpu_dispatch_tex(render3d_st, render3d_st.occ_hzb_build, data_of(pr), 96, bufs, texs, (mips[m * 4] + 7) / 8, (mips[m * 4 + 1] + 7) / 8)
    m += k
  }
  # the tests, into this frame's result slot under its tag (never 0: a zeroed slot is no result)
  let slot = render3d_st.gvk_frame_no & 1
  let tag = render3d_st.gvk_frame_no % 0x3FFFFFFF + 1
  render3d_st.occ_hzb_slot = slot
  render3d_st.occ_hzb_tag = tag
  let bounds = render3d_st.occ_hzb_bounds[slot]
  gpu_buffer_upload(render3d_st, bounds, n * 32, data_of(box), GPU_DYNAMIC)
  let vp = render3d_st.cam_vp
  for i in 0 .. 16 { pr[i] = float_bits(vp[i]) }
  pr[16] = w;  pr[17] = h;  pr[18] = n;  pr[19] = tag
  pr[20] = mips[0];  pr[21] = mips[1];  pr[22] = render3d_st.occ_hzb_n_mips;  pr[23] = 0
  for i in 0 .. OCC_HZB_MIPS * 4 { pr[24 + i] = mips[i] }
  bufs[0] = bounds;  bufs[1] = render3d_st.occ_hzb_buf;  bufs[2] = render3d_st.occ_hzb_res[slot]
  gpu_dispatch(render3d_st, render3d_st.occ_hzb_test, data_of(pr), (24 + OCC_HZB_MIPS * 4) * 4, bufs, (n + 63) / 64)
}

# last frame's n results: hidden where its own tag says not visible; a slot the GPU has not reached yet is visible
function occ_hzb_read(render3d_st: mut Render3dState, n: int) -> void {
  let res = gpu_buffer_map(render3d_st, render3d_st.occ_hzb_res[render3d_st.occ_hzb_slot])
  let hidden = render3d_st.occ_hzb_tag << 1
  for i in 0 .. n {
    let a = render3d_st.occ_list[i]
    render3d_st.occ_list[i] = null
    if a == null or a.id != render3d_st.occ_ids[i] { continue }             # released and taken again since
    a.occ_hidden = res != null and Vk.get_i32(res, i * 4) == hidden
    if a.occ_hidden { render3d_st.occ_hidden_n += 1 }
  }
}
