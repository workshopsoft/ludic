# ============================================================================
# taa.ludic — temporal anti-aliasing: the jitter, the motion target and the resolve.
#
# On by default (R3D_NOTAA=1 or r3d_taa(false) turns it off), and never while DLSS resolves the frame
# (streamline.ludic): DLSS is a temporal resolve of its own and takes the same motion target.
#
#   1. cam_begin_frame -> taa_jitter_frame: the projection the scene draws with moves by a sub-pixel
#      offset on an 8-phase Halton (2, 3) cycle. Culling, the frustum and the motion keep the clean one.
#   2. after the MSAA resolve -> taa_motion_pass: an RG16F target of prev uv - this uv at every pixel.
#      The camera's motion comes from the depth (taa_mv.frag) - exact for the whole still world - and
#      every actor that moved or is skinned is drawn over it with its own (skin.vert VELOCITY: last
#      frame's model matrix and bone palette, velocity.frag), depth-tested GEQUAL against the scene.
#   3. after the water, puddles, blended actors and light shafts -> taa_resolve (taa.frag): the frame
#      into a ping-ponged history, which the rest of post reads instead of post_hdr. The sharpen pass
#      then runs RCAS in place of FXAA and the unsharp mask (sharpen.frag).
#
# What does NOT write motion of its own: the instanced world (scatter, grass, kit instances), whose
# wind sway is reprojected with the camera's motion and kept honest by the history clip; and the
# transparent passes (water, puddles, blended actors), which the resolve finds by comparing the final
# colour with the opaque copy taken before them and treats as responsive (taa.frag).
#
# Cost, measured with R3D_PROF=1 at 1920x1080: see FEATURES.md (temporal anti-aliasing).
# ============================================================================

const TAA_PHASES: int = 8               # Unreal's default; DLSS takes more (streamline.ludic)
const TAA_WEIGHT: float = 0.04          # the current frame's share on a still pixel (Unreal's default)
const TAA_RCAS: float = 0.6             # the sharpen after it (sharpen.frag u_rcas, 0..1)
const TAA_CUT: float = 25.0             # metres in one frame: a cut, not a move - the history is dropped

function taa_wanted(render3d_st: mut Render3dState) -> bool {
  if render3d_st.taa_want < 0 {
    render3d_st.taa_want = 1
    if r3d_env_has(render3d_st, "R3D_NOTAA") { render3d_st.taa_want = 0 }
  }
  return render3d_st.taa_want == 1
}
# a game's switch (its anti-aliasing setting); R3D_NOTAA wins over it
export function r3d_taa(render3d_st: mut Render3dState, on: bool) -> void {
  var w = 0
  if on { w = 1 }
  if r3d_env_has(render3d_st, "R3D_NOTAA") { w = 0 }
  if w != render3d_st.taa_want { render3d_st.taa_reset = true }
  render3d_st.taa_want = w
}
# a camera cut the game knows of (a teleport, a cutscene): the next frame starts a fresh history
export function r3d_taa_cut(render3d_st: mut Render3dState) -> void { render3d_st.taa_reset = true }

# cam_begin_frame, after gsl_jitter_frame: this frame's offset, in the same fields DLSS's goes in
function taa_jitter_frame(render3d_st: mut Render3dState) -> void {
  let was = render3d_st.taa_live
  render3d_st.taa_live = taa_wanted(render3d_st) and not gsl_dlss_live(render3d_st) and render3d_st.post_hdr != null and render3d_st.post_w > 0 and render3d_st.post_h > 0
  if not render3d_st.taa_live { return }
  if not was { render3d_st.taa_reset = true }
  let i = (render3d_st.taa_frame % TAA_PHASES) + 1
  render3d_st.gsl_jpx = gsl_halton(i, 2) - 0.5
  render3d_st.gsl_jpy = gsl_halton(i, 3) - 0.5
  render3d_st.gsl_jitter_x = 2.0 * render3d_st.gsl_jpx / float(render3d_st.post_w)
  render3d_st.gsl_jitter_y = 2.0 * render3d_st.gsl_jpy / float(render3d_st.post_h)
}

# the screen-sized targets, made at post's size (post_init) and gone with it (post_free)
@alloc_ok("a world being set up (a stream, a layer, water, post, a bake): the map loading or swapping, not a frame")
function taa_init(render3d_st: mut Render3dState, w: int, h: int) -> void {
  render3d_st.taa_hist = new []Target
  for k in 0 .. 2 { push(render3d_st.taa_hist, target_new(render3d_st, w, h, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR)) }
  render3d_st.taa_vel = target_new(render3d_st, w, h, GPU_RG16F, GPU_RG, GPU_HALF_FLOAT, false, GPU_NEAREST)
  # the same colour with the scene's depth, so the moving actors are tested against what was drawn
  render3d_st.taa_vel_fb = gpu_fb_new(render3d_st)
  gpu_fb_bind(render3d_st, render3d_st.taa_vel_fb)
  gpu_fb_color(render3d_st, 0, render3d_st.taa_vel.color)
  gpu_fb_depth(render3d_st, render3d_st.post_hdr.depth)
  gpu_fb_bind(render3d_st, 0)
  if render3d_st.taa_p == 0 {
    render3d_st.taa_p = r3d_program(render3d_st, "fullscreen.vert", "taa.frag", "")
    render3d_st.taa_p_mv = r3d_program(render3d_st, "fullscreen.vert", "taa_mv.frag", "")
  }
  if render3d_st.taa_prev_vp == null { render3d_st.taa_prev_vp = m4_new();  render3d_st.taa_inv_vp = m4_new();  render3d_st.taa_cam_prev = v3_new(0.0, 0.0, 0.0) }
  render3d_st.taa_reset = true
  render3d_st.taa_prev_ok = false
}
function taa_free(render3d_st: mut Render3dState) -> void {
  if render3d_st.taa_hist == null { return }
  for k in 0 .. len(render3d_st.taa_hist) { target_free(render3d_st, render3d_st.taa_hist[k]) }
  render3d_st.taa_hist = null
  if render3d_st.taa_vel_fb != 0 { gpu_fb_free(render3d_st, render3d_st.taa_vel_fb);  render3d_st.taa_vel_fb = 0 }
  target_free(render3d_st, render3d_st.taa_vel);  render3d_st.taa_vel = null
  render3d_st.taa_reset = true
}

# The motion target, after the MSAA resolve and before anything transparent: the camera's motion at
# every pixel, then each moving actor's own over it. DLSS reads it too, so it is drawn for either.
function taa_motion_pass(render3d_st: mut Render3dState) -> void {
  render3d_st.taa_vel_ok = false
  if render3d_st.taa_vel == null or render3d_st.taa_prev_vp == null { return }
  if not render3d_st.taa_live and not gsl_dlss_live(render3d_st) { return }
  prof_begin(render3d_st, "TAA motion")
  # the first frame, or straight after a cut: last frame's matrix is this frame's
  let dx = render3d_st.cam_pos[0] - render3d_st.taa_cam_prev[0];  let dy = render3d_st.cam_pos[1] - render3d_st.taa_cam_prev[1];  let dz = render3d_st.cam_pos[2] - render3d_st.taa_cam_prev[2]
  let cut = dx * dx + dy * dy + dz * dz > TAA_CUT * TAA_CUT
  if cut { render3d_st.taa_reset = true;  render3d_st.gsl_reset = true }
  if cut or not render3d_st.taa_prev_ok { m4_copy(render3d_st.taa_prev_vp, render3d_st.cam_vp_clean) }
  gpu_fb_bind(render3d_st, render3d_st.taa_vel_fb)
  gpu_viewport(render3d_st, 0, 0, render3d_st.taa_vel.w, render3d_st.taa_vel.h)
  gpu_depth_test(render3d_st, false)
  gpu_depth_write(render3d_st, false)
  gpu_blend(render3d_st, false)
  gpu_cull(render3d_st, false)
  let p = render3d_st.taa_p_mv
  gpu_use_program(render3d_st, p)
  r3d_bind_2d(render3d_st, p, "u_depth", 0, render3d_st.post_depth_copy.depth)
  u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_inv_vp"), render3d_st.cam_inv_vp)
  u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_vp_cur"), render3d_st.cam_vp_clean)
  u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_vp_prev"), render3d_st.taa_prev_vp)
  mesh_draw(render3d_st, render3d_st.post_fs)
  prof_end(render3d_st)
  render3d_st.taa_vel_draws = 0
  prof_begin(render3d_st, "TAA motion actors")
  gpu_depth_test(render3d_st, true)
  gpu_depth_func(render3d_st, GPU_GEQUAL)
  actor_draw_velocity(render3d_st, render3d_st.taa_prev_vp, render3d_st.taa_frame)
  prof_end(render3d_st)
  gpu_depth_func(render3d_st, GPU_GREATER)
  gpu_depth_write(render3d_st, true)
  gpu_cull(render3d_st, true)
  gpu_fb_bind(render3d_st, 0)
  render3d_st.taa_vel_ok = true
}

# The resolve, after everything the scene composites (water, puddles, blended actors, shafts): the
# colour the rest of post reads.
function taa_resolve(render3d_st: mut Render3dState) -> int {
  let cur = render3d_st.taa_hist[render3d_st.taa_i]
  let prev = render3d_st.taa_hist[1 - render3d_st.taa_i]
  target_bind(render3d_st, cur)
  gpu_depth_test(render3d_st, false)
  gpu_blend(render3d_st, false)
  let p = render3d_st.taa_p
  gpu_use_program(render3d_st, p)
  r3d_bind_2d(render3d_st, p, "u_cur", 0, render3d_st.post_hdr.color)
  r3d_bind_2d(render3d_st, p, "u_hist", 1, prev.color)
  r3d_bind_2d(render3d_st, p, "u_vel", 2, render3d_st.taa_vel.color)
  r3d_bind_2d(render3d_st, p, "u_depth", 3, render3d_st.post_hdr.depth)
  var opaque = 0.0
  var otex = render3d_st.post_neutral
  if render3d_st.taa_opaque { opaque = 1.0;  otex = render3d_st.post_scene.color }
  r3d_bind_2d(render3d_st, p, "u_opaque", 4, otex)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_has_opaque"), opaque)
  var auto = 0.0
  var atex = render3d_st.post_neutral
  if render3d_st.post_auto and render3d_st.post_adapt_t != null { auto = 1.0;  atex = render3d_st.post_adapt_t[render3d_st.post_adapt_i].color }
  r3d_bind_2d(render3d_st, p, "u_adapt", 5, atex)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_auto"), auto)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_exposure"), render3d_st.post_exposure)
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_texel"), 1.0 / float(cur.w), 1.0 / float(cur.h))
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_jitter"), render3d_st.gsl_jpx, render3d_st.gsl_jpy)
  taa_weights(render3d_st, p)
  var reset = 0.0
  if render3d_st.taa_reset or not render3d_st.taa_vel_ok { reset = 1.0 }
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_reset"), reset)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_weight"), TAA_WEIGHT)
  u_mat4(render3d_st, gpu_uniform(render3d_st, p, "u_inv_proj"), render3d_st.cam_inv_proj)
  let dx = render3d_st.cam_pos[0] - render3d_st.taa_cam_prev[0];  let dy = render3d_st.cam_pos[1] - render3d_st.taa_cam_prev[1];  let dz = render3d_st.cam_pos[2] - render3d_st.taa_cam_prev[2]
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_cam_move"), Math.sqrt(dx * dx + dy * dy + dz * dz))
  mesh_draw(render3d_st, render3d_st.post_fs)
  render3d_st.post_color_w = cur.w;  render3d_st.post_color_h = cur.h
  return cur.color
}

# The 3x3 reconstruction's weights for this frame's jitter (taa.frag u_wa, u_wb, u_wc): the sample at
# offset o shows what lies at o - jitter in the still image, weighted exp(-2.29 d^2) by its distance d
# from the pixel's centre (a Gaussian fitted to Blackman-Harris, as Unreal's TAA), normalised.
function taa_weights(render3d_st: mut Render3dState, p: int) -> void {
  var w0 = 0.0;  var w1 = 0.0;  var w2 = 0.0;  var w3 = 0.0;  var w4 = 0.0;  var w5 = 0.0;  var w6 = 0.0;  var w7 = 0.0;  var w8 = 0.0
  var sum = 0.0
  for k in 0 .. 9 {
    let ox = float(k % 3 - 1) - render3d_st.gsl_jpx
    let oy = float(k / 3 - 1) - render3d_st.gsl_jpy
    let w = Math.exp(-2.29 * (ox * ox + oy * oy))
    sum = sum + w
    if k == 0 { w0 = w } else if k == 1 { w1 = w } else if k == 2 { w2 = w } else if k == 3 { w3 = w } else if k == 4 { w4 = w }
    else if k == 5 { w5 = w } else if k == 6 { w6 = w } else if k == 7 { w7 = w } else { w8 = w }
  }
  let s = 1.0 / sum
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_wa"), w0 * s, w1 * s, w2 * s, w3 * s)
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_wb"), w4 * s, w5 * s, w6 * s, w7 * s)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_wc"), w8 * s)
}

# did this frame resolve? (the sharpen takes RCAS, the bounce reads the resolved colour)
function taa_ran(render3d_st: Render3dState) -> bool { return render3d_st.taa_live and render3d_st.taa_hist != null }
# the resolved colour of this frame, for the SSGI bounce (post_prev's copy is not made while TAA runs)
function taa_color(render3d_st: Render3dState) -> int { return render3d_st.taa_hist[render3d_st.taa_i].color }
function taa_rcas(render3d_st: Render3dState) -> float { if taa_ran(render3d_st) { return TAA_RCAS };  return 0.0 }

# the end of the frame: this frame's matrix and place become last frame's, the history flips
function taa_end_frame(render3d_st: mut Render3dState) -> void {
  if render3d_st.taa_prev_vp == null { return }
  m4_copy(render3d_st.taa_prev_vp, render3d_st.cam_vp_clean)
  v3_set(render3d_st.taa_cam_prev, render3d_st.cam_pos[0], render3d_st.cam_pos[1], render3d_st.cam_pos[2])
  render3d_st.taa_prev_ok = true
  if render3d_st.taa_vel_ok { render3d_st.taa_frame += 1 }
  if taa_ran(render3d_st) {
    render3d_st.taa_i = 1 - render3d_st.taa_i
    render3d_st.taa_reset = false
  } else {
    render3d_st.taa_reset = true
  }
  # R3D_TAA_LOG=1: every 120 frames, what the pass did
  if render3d_st.taa_log < 0 { render3d_st.taa_log = 0;  if r3d_env_has(render3d_st, "R3D_TAA_LOG") { render3d_st.taa_log = 1 } }
  if render3d_st.taa_log == 1 and render3d_st.taa_frame % 120 == 0 { taa_say(render3d_st) }
  render3d_st.taa_opaque = false
}
@alloc_ok("a message, built only when it is said: a failure, a warning or a debug switch")
function taa_say(render3d_st: Render3dState) -> void { print(`taa: frame {render3d_st.taa_frame} live {render3d_st.taa_live} motion {render3d_st.taa_vel_ok} actors {render3d_st.taa_vel_draws} opaque {render3d_st.taa_opaque} jitter {int(render3d_st.gsl_jpx * 1000.0)} {int(render3d_st.gsl_jpy * 1000.0)}`) }
