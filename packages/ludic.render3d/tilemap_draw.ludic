# ============================================================================
# tilemap_draw.ludic - the ground, drawn from its baked levels (tilemap_lwt.ludic, made by tilemap_bake.ludic): a patch at a
# time, each an Actor over a mesh of its own level, so the renderer's own model pass lights, shadows and fogs it and no
# shader is added. The game only LOADS and streams: a tile's table is read a frame within budget, a patch's level is
# read from its file and uploaded a few a frame nearest first, a patch whose level changes gets the new mesh and lets the old one
# go. A tile with no baked file, or one baked for other numbers than the row's, draws nothing and says so once.
#
#   let tm = tmap_new(m.tiles, m.tile_size, m.tile_res, m.tile_cols, m.tile_rows, m.origin_x, m.origin_z, m.height_min, m.height_max, 0.0, 300.0)
#   let td = tmd_new(render3d_st, tm, 3000.0)
#   r3d_plate_mode(render3d_st, true)                   # the sky, the sun, the shadows: this is the ground
#   each frame (the camera's world x and z, the floating origin's, the view distance):
#     tmd_frame(render3d_st, td, cam_x, cam_z, origin_x, origin_z, 3000.0)
#
# `tm`'s own pool (radius 300 above) is the ground as data for physics and placement (tilemap.ludic); drawing does not use it.
# A frame allocates nothing: every patch slot's mesh, model and primitive records are made once with the draw (tmd_new) and a
# change of level refills them, its old buffers given back and the new ones uploaded into the same mesh. (Made at each change
# and freed with the old level, they were memory that rose with the patches in view for as long as a drive went into new
# ground, and the allocation fence failed the run.) The ground casts no shadow map of its own (buildings and trees still
# fall on it).
# ============================================================================
numbers float

export property TmPatch {
  tile: int = -1                     # the tile it is of (tz * cols + tx) while it holds a mesh
  px: int = 0
  pz: int = 0
  lod: int = -1                      # the level of the mesh it holds, -1 none
  actor: Actor = null
  model: Model = null                # its records, made once (tmd_new): the model, its one primitive, the primitive's mesh
  mesh: Mesh = null
  held: bool = false                 # the mesh holds a level's buffers
  coloured: bool = false             # ... with the land use's vertex colours (attribute 7)
}

export property TileDraw {
  tm: TileMap = null
  ms: TmMeshes = null
  patches: []TmPatch = null          # mesh slot * patches * patches + pz * patches + px
  fac: floats = null                 # the patches' material factors (white, the roughness below): each patch's primitive owns a copy
  color: floats = null               # the ground's colour, r g b (an actor's tint): a mid grey until the game says
  rough: float = 0.95                # read when tmd_new makes the factors
  build_budget: int = 2              # patches uploaded a frame
  tile_budget: int = 1               # tile tables read a frame
  ox: float = 0.0                    # the floating origin the actors stand in render space by
  oz: float = 0.0
  # the land-use mask and its tones (tilemap_mask.ludic)
  mask_pattern: string = ""          # the mask tiles ({tx} {tz}); "" none
  tones: floats = null               # 8 x r g b, linear
  surf_green: string = ""            # the surfaces laid over the ground (tmd_surfaces; surface.ludic surf_apply_ground): where the
  surf_paved: string = ""            # tone is green, and elsewhere; "" for the plain tones
  tone_on: words = null              # 1 where a class has a tone
  mk_tile: words = null              # per mesh slot: the tile its coarse grid is of, -1 none read
  lu_tex: words = null               # per mesh slot: its tile's lawn coverage (tmk_lawn), 0 none
  lu_a: []byte = null                # tmk_lawn's working texels, res x res each
  lu_b: []byte = null
  mk_has: words = null               # per mesh slot: 1 when that tile has a mask
  mk_coarse: []byte = null           # per mesh slot: the majority class of each mk_cf x mk_cf block
  mk_cf: int = 8
  mk_fine: int = 0                   # the coarsest level that reads the full texels
  mk_scratch: []byte = null          # a decode's samples, reused
  mk_tone: floats = floats(3)
  noskirt: words = null              # 256: 1 for a class no skirt hangs from (tmd_noskirt: a hole's edge, thin ground over a tunnel), null none
  steep_ny: float = 0.0              # a texel no class names draws steep_color where the ground's normal y is below this (0: never)
  steep_color: floats = floats(3)
  fk_n: int = 0                      # the pool of full masks: places, their tiles, when last wanted, the texels
  fk_tile: words = null
  fk_used: words = null
  fk_clock: int = 0
  fk_data: []byte = null
  cbuf: floats = null                # a patch level's vertex colours, four floats a vertex
  shown: int = 0                     # patches holding a mesh now
  builds: int = 0                    # meshes made, all time
  frees: int = 0
}

@alloc_ok("a map being opened: the reader's pool and one record a patch slot (its mesh, model and primitive too), made once")
export function tmd_new(render3d_st: mut Render3dState, tm: TileMap, radius: float) -> TileDraw {
  let td = new TileDraw
  td.tm = tm
  let a = Math.max(radius, 0.0) / tm.tile_size + 1.5
  td.ms = tmm_new(tm, int(3.15 * a * a) + 4)
  let pp = tm.patches * tm.patches
  td.color = floats(3)
  td.color[0] = 0.5;  td.color[1] = 0.5;  td.color[2] = 0.5
  td.fac = floats(9)
  for k in 0 .. 6 { td.fac[k] = 1.0 }
  for k in 6 .. 9 { td.fac[k] = 0.0 }
  td.fac[4] = td.rough;  td.fac[5] = 0.0
  td.patches = new []TmPatch
  for i in 0 .. td.ms.mslots * pp {
    let p = new TmPatch
    p.mesh = gpu_mesh_new(render3d_st)               # a record and its lists only: nothing on the GPU until a level is uploaded
    p.model = tmd_model_of(render3d_st, td, p.mesh, 0, 0)
    push(td.patches, p)
  }
  tmk_init(td)
  return td
}

# a patch's level let go: its actor off the stage, its mesh's buffers given back (the records stay for its next level)
function tmd_release(render3d_st: mut Render3dState, td: TileDraw, p: TmPatch) -> void {
  if p.actor != null { actor_release(render3d_st, p.actor);  p.actor = null;  td.shown -= 1 }
  if p.held { gpu_mesh_free(render3d_st, p.mesh);  p.held = false;  td.frees += 1 }
  p.lod = -1
  p.tile = -1
}

# the whole ground let go (a map swap, the end): every level, then every patch's records
export function tmd_free(render3d_st: mut Render3dState, td: TileDraw) -> void {
  for i in 0 .. len(td.patches) {
    let p = td.patches[i]
    tmd_release(render3d_st, td, p)
    if p.model != null { model_release(render3d_st, p.model) }    # the primitive, its mesh record, the model
    p.model = null
    p.mesh = null
  }
}

# metres from a point to a patch's square
function tmd_dist(tm: TileMap, cx: float, cz: float, x: float, z: float) -> float {
  let h = tmap_patch_size(tm) * 0.5
  let dx = Math.max(Math.max(cx - h - x, x - (cx + h)), 0.0)
  let dz = Math.max(Math.max(cz - h - z, z - (cz + h)), 0.0)
  return Math.sqrt(dx * dx + dz * dz)
}

# the white textures the ground's material stands on (what a glTF material without textures uses), made once
function tmd_textures(render3d_st: mut Render3dState) -> void {
  if render3d_st.gltf_white == 0 { render3d_st.gltf_white = tex_solid(render3d_st, 200, 200, 200, 255);  render3d_st.gltf_flat = tex_solid(render3d_st, 128, 128, 255, 255) }
  if render3d_st.gltf_pure == 0 { render3d_st.gltf_pure = tex_solid(render3d_st, 255, 255, 255, 255) }
}

# The level the reader expanded (tmm_patch) into patch p's own mesh and model: the level before's buffers given back, the new
# ones uploaded into the same record (attribute 0 the position, 1 the normal, 2 the uv, all read from one interleaved buffer;
# 7 the land use's colour). Nothing is made but the GPU's buffers.
function tmd_fill(render3d_st: mut Render3dState, td: TileDraw, p: TmPatch, coloured: bool) -> void {
  let ms = td.ms
  tmd_textures(render3d_st)
  let m = p.mesh
  if p.held { gpu_mesh_free(render3d_st, m);  td.frees += 1 }
  # a level with the colours after one without (or the other way) has another layout: the record's attributes start over
  if coloured != p.coloured or not p.held {
    for i in 0 .. len(m.attrs) { m.attrs[i] = 0 }
    m.n_attrs = 0
    m.vk_layout = 0
  }
  m.cur_buf = 0
  let was = render3d_st.gvk_tag
  render3d_st.gvk_tag = VKM_TERRAIN
  gpu_mesh_vertices(render3d_st, m, data_of(ms.vbuf), ms.nv * TM_VERT * 4, GPU_STATIC)
  gpu_mesh_attr(render3d_st, m, 0, 3, GPU_F32, TM_VERT * 4, 0, false)
  gpu_mesh_attr(render3d_st, m, 1, 3, GPU_F32, TM_VERT * 4, 12, false)
  gpu_mesh_attr(render3d_st, m, 2, 2, GPU_F32, TM_VERT * 4, 24, false)
  # the land use's tones (tilemap_mask.ludic), as the vertex colour the model pass multiplies in
  if coloured {
    gpu_mesh_vertices(render3d_st, m, data_of(td.cbuf), ms.nv * 16, GPU_STATIC)
    gpu_mesh_attr(render3d_st, m, 7, 4, GPU_F32, 16, 0, false)
  }
  gpu_mesh_indices(render3d_st, m, data_of(ms.ibuf), ms.ni * 4, 4)
  m.count = ms.ni
  gpu_mesh_done(render3d_st, m)
  render3d_st.gvk_tag = was
  let pr = p.model.prims[0]
  pr.verts = ms.nv
  pr.diff = render3d_st.gltf_pure;  pr.nrm = render3d_st.gltf_flat;  pr.arm = render3d_st.gltf_pure
  if td.surf_green != "" { surf_apply_ground(render3d_st.surf_lib, pr, td.surf_green, td.surf_paved) }
  p.model.tris = ms.ni / 3
  p.held = true
  p.coloured = coloured
}
# a mesh as a patch's model: its primitive wears the ground's material and owns a copy of its factors, since model_release
# gives a primitive's factors back (one array shared by every patch was freed with the first). Made once a patch slot (tmd_new)
@alloc_ok("a map being opened: a patch slot's model, made once")
function tmd_model_of(render3d_st: Render3dState, td: TileDraw, m: Mesh, nv: int, ni: int) -> Model {
  let pr = new Prim
  pr.mesh = m
  pr.verts = nv
  pr.diff = render3d_st.gltf_pure;  pr.nrm = render3d_st.gltf_flat;  pr.arm = render3d_st.gltf_pure
  if td.surf_green != "" { surf_apply_ground(render3d_st.surf_lib, pr, td.surf_green, td.surf_paved) }
  pr.fac = floats(9)
  for k in 0 .. 9 { pr.fac[k] = td.fac[k] }
  let model = new Model
  model.prims = new []Prim
  push(model.prims, pr)
  model.tris = ni / 3
  return model
}

# patch p (of mesh slot `slot`) at level `lod`: read, uploaded and put on the stage (or its actor given the new mesh and the old one
# let go); false when its file cannot be read
@alloc_ok("a patch changing level: its actor taken from the stage's spares when it has none")
function tmd_build(render3d_st: mut Render3dState, td: TileDraw, p: TmPatch, slot: int, lod: int) -> bool {
  let tm = td.tm
  let ms = td.ms
  let tx = p.tile % tm.cols
  let tz = p.tile / tm.cols
  let half = tmap_patch_size(tm) * 0.5
  let cell = tmap_patch_size(tm) / float(tm.patch_texels >> lod)
  let y0 = tmm_ymin(ms, tm, slot, p.px, p.pz, lod) - (2.0 * cell + tm.skirt)
  let y1 = tmm_ymax(ms, tm, slot, p.px, p.pz, lod)
  let r = Math.sqrt(2.0 * half * half + (y1 - y0) * (y1 - y0) * 0.25) + 1.0
  let lift = (y0 + y1) * 0.5 - r                      # an actor's cull sphere is centred r above its origin
  if not tmm_patch(ms, tm, slot, tx, tz, p.px, p.pz, lod, lift) { return false }
  let coloured = tmk_colours(render3d_st, td, slot, tx, tz, p.px, p.pz, lod)
  tmd_fill(render3d_st, td, p, coloured)
  # the lawn's edge from the mask itself (tmk_lawn), not the vertex colour a whole cell wide
  let pr = p.model.prims[0]
  pr.lu = 0
  if coloured and td.mk_tile[slot] == p.tile { pr.lu = td.lu_tex[slot] }
  pr.lu_tx = float(tx);  pr.lu_tz = float(tz)
  if p.actor == null {
    p.actor = actor_new(render3d_st, p.model)
    p.actor.casts = false
    p.actor.cull = 0.0
    td.shown += 1
  } else { p.actor.model = p.model }
  # a masked patch's colour is the tones alone (they carry the tint where a class has none); else the tint
  if coloured { p.actor.tint[0] = 1.0;  p.actor.tint[1] = 1.0;  p.actor.tint[2] = 1.0 }
  else { p.actor.tint[0] = td.color[0];  p.actor.tint[1] = td.color[1];  p.actor.tint[2] = td.color[2] }
  p.actor.radius = r
  p.lod = lod
  actor_place(p.actor, tmap_patch_cx(tm, tx, p.px) - td.ox, lift, tmap_patch_cz(tm, tz, p.pz) - td.oz, 0.0)
  td.builds += 1
  return true
}

# One frame of the ground: the tile tables within `radius` of the camera read (the nearest `tile_budget` a frame), the patches
# inside `radius` given the level their distance asks for (the nearest `build_budget` changes a frame), the rest let go, and every
# actor stood where the floating origin (`ox`, `oz`: zero without one) puts it. Give the camera's WORLD x and z.
export function tmd_frame(render3d_st: mut Render3dState, td: TileDraw, cam_x: float, cam_z: float, ox: float, oz: float, radius: float) -> void {
  let tm = td.tm
  let ms = td.ms
  let ps = tmap_patch_size(tm)
  ms.clock += 1
  let dox = ox - td.ox
  let doz = oz - td.oz
  td.ox = ox;  td.oz = oz
  # the tables: wanted ones marked, then the nearest not read yet
  let tx0 = tmap_tile_x(tm, cam_x - radius)
  let tx1 = tmap_tile_x(tm, cam_x + radius)
  let tz0 = tmap_tile_z(tm, cam_z - radius)
  let tz1 = tmap_tile_z(tm, cam_z + radius)
  for tz in tz0 .. tz1 + 1 {
    for tx in tx0 .. tx1 + 1 {
      let s = ms.slot_of[tz * tm.cols + tx]
      if s >= 0 and tmap_tile_dist(tm, tx, tz, cam_x, cam_z) <= radius { ms.slot_used[s] = ms.clock }
    }
  }
  for n in 0 .. td.tile_budget {
    var bx = -1;  var bz = -1;  var bd = 1000000000.0
    for tz in tz0 .. tz1 + 1 {
      for tx in tx0 .. tx1 + 1 {
        if ms.slot_of[tz * tm.cols + tx] != -1 { continue }
        let d = tmap_tile_dist(tm, tx, tz, cam_x, cam_z)
        if d <= radius and d < bd { bx = tx;  bz = tz;  bd = d }
      }
    }
    if bx < 0 { break }
    if tmm_load(ms, tm, bx, bz) == -1 { break }
  }
  # what a mesh slot holds now: patches of a tile that left are let go, patches out of range too, the rest stood
  let pp = tm.patches * tm.patches
  for s in 0 .. ms.mslots {
    let t = ms.slot_tile[s]
    for k in 0 .. pp {
      let p = td.patches[s * pp + k]
      if p.tile >= 0 and p.tile != t { tmd_release(render3d_st, td, p);  continue }
      if p.tile < 0 { continue }
      let d = tmd_dist(tm, tmap_patch_cx(tm, t % tm.cols, k % tm.patches), tmap_patch_cz(tm, t / tm.cols, k / tm.patches), cam_x, cam_z)
      if d > radius * 1.05 { tmd_release(render3d_st, td, p);  continue }
      if p.actor != null and (dox != 0.0 or doz != 0.0) { actor_place(p.actor, p.actor.x - dox, p.actor.y, p.actor.z - doz, 0.0) }
    }
  }
  # the nearest patches that need another level, a few a frame
  for n in 0 .. td.build_budget {
    var bi = -1
    var bd = 1000000000.0
    for s in 0 .. ms.mslots {
      let t = ms.slot_tile[s]
      if t < 0 { continue }
      for k in 0 .. pp {
        let p = td.patches[s * pp + k]
        let d = tmd_dist(tm, tmap_patch_cx(tm, t % tm.cols, k % tm.patches), tmap_patch_cz(tm, t / tm.cols, k / tm.patches), cam_x, cam_z)
        if d > radius or d >= bd { continue }
        if tmap_lod_for(tm, d, p.lod) == p.lod { continue }
        bi = s * pp + k;  bd = d
      }
    }
    if bi < 0 { break }
    let s = bi / pp
    let k = bi % pp
    let p = td.patches[bi]
    p.tile = ms.slot_tile[s];  p.px = k % tm.patches;  p.pz = k / tm.patches
    let want = tmap_lod_for(tm, bd, p.lod)
    if not tmd_build(render3d_st, td, p, s, want) { p.lod = want }      # unreadable: no mesh, and not asked for again every frame
  }
}

# the ground's surfaces from the renderer's library (r3d_surfaces_use): `green` over the green tones (grass), `paved` over the rest
# (pads, walks, yards), both keeping the tones' colours when their rows say tone. Patches drawn already are made again.
export function tmd_surfaces(td: TileDraw, green: string, paved: string) -> void {
  td.surf_green = green
  td.surf_paved = paved
  tmk_redraw(td)
}
