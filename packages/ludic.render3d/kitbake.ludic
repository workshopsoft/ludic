# ============================================================================
# kitbake.ludic - placed things baked into what the large world streams: a list of (model, node, where, how turned) becomes the
# map's RenderKits rows (one kit for each model and node, so every placement of it shares ONE mesh, drawn instanced by the
# cell) and the cell files (cells.lwi, cell_<cx>_<cz>.lwc: cellfile.ludic) the scheduler loads. It knows nothing of what
# placed the things (a city, a forest, a prop list): a program that does calls it; ludic.city's is
# packages/ludic.city/tools/cells_bake.ludic.
#
# Baked, not derived in play: the game only loads the files and the kit rows (bigworld_gpu.ludic's bw_open, bw_setup_kits). Nothing
# here is for a frame; it is what a person runs, or a package.ludic `hook before build`, after the rows change. The far layers
# are baked after it by the tools that exist for them: `hlod_bake` (the merged proxy of each cell) and `kgpu_bake_kit` (a kit's
# impostor atlas, a person's click).
#
#   let kb = kitbake_new(256.0)
#   kitbake_seed(kb, existing_kits.rows)              # rows already written keep their ids (kits are only ever appended)
#   let id = kitbake_kit(kb, "city/block_3.glb", "tower_a", 30.0, 30.0, 120.0, "")
#   kitbake_place(kb, id, x, y, z, yaw_radians, 1.0, cell_rgba(255, 255, 255, 255), variation, flags)
#   let b = kitbake_kit_box(kb, "kits/massing.glb", "flat", box, 20.0, 15.0, 10.2, "")   # a box kit (kitbox.ludic): box = kitbox_read's
#   kitbake_place_box(kb, b, x, y, z, yaw_radians, w, d, h, cell_rgba(255, 255, 255, 255), variation, flags)
#   kitbake_write(kb, "assets/maps/meridian/cells")   # cells.lwi and the cell files
#   Fs.write_text("assets/maps/meridian/render_kits.lres", kitbake_rows(kb, 0))
# ============================================================================
numbers float

export property KitBake {
  size: float = 256.0                # the cell's side, metres (the map's WorldPartition.cell_size)
  kits: []RenderKit = null
  boxes: []KitBox = null             # a box kit's anchor tuples by kit id, null for an ordinary kit (or a seeded box kit not asked for again)
  box_tuples: []KitBox = null        # the tuples kitbake_box registered, and ...
  box_of: Dict = null                # ... "model|node" -> their index: every kit of that model and node is a box kit
  kit_of: Dict = null                # "model|node|interior" -> kit id
  seeded: int = 0                    # kits that came from rows already written
  cells: []CellContent = null
  cell_of: Dict = null               # "cx,cz" -> index in cells
  placed: int = 0
  near_scale: float = 30.0           # a new kit's `near` is this times its bounding radius ...
  far_scale: float = 180.0           # ... its `far` this
  near_min: float = 150.0
  far_min: float = 1200.0
}

@alloc_ok("a bake: the lists are made once")
export function kitbake_new(size: float) -> KitBake {
  let kb = new KitBake
  kb.size = size
  kb.kits = new []RenderKit
  kb.boxes = new []KitBox
  kb.box_tuples = new []KitBox
  kb.box_of = Dict.new()
  kb.kit_of = Dict.new()
  kb.cells = new []CellContent
  kb.cell_of = Dict.new()
  return kb
}

# the kit's name in the Dict: what makes two placements one mesh
function kb_id(model: string, node: string, interior: string) -> string { return `{model}|{node}|{interior}` }
# ... and with a facade style: another kit of the same mesh (the style's uniforms are the kit's)
function kb_id_styled(model: string, node: string, interior: string, facade: string) -> string {
  if facade == "" { return kb_id(model, node, interior) }
  return `{model}|{node}|{interior}|{facade}`
}

# rows already written (the map's render_kits.lres as loaded): they keep their ids, and kitbake_kit finds them again by model,
# node and interior atlas
@alloc_ok("a bake: the existing rows are added once")
export function kitbake_seed(kb: KitBake, rows: []RenderKit) -> void {
  for i in 0 .. len(rows) {
    push(kb.kits, rows[i])
    push(kb.boxes, null)
    Dict.set(kb.kit_of, kb_id_styled(rows[i].model, rows[i].node, rows[i].interior, rows[i].facade), i)
  }
  kb.seeded = len(rows)
}

# a kit key: the node's name with anything a row's key cannot hold turned to "_"
function kb_key(node: string) -> string {
  var out = ""
  for i in 0 .. len(node) {
    let c = int(node[i])
    let ok = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
    if ok { out = out + Text.slice(node, i, i + 1) } else { out = out + "_" }
  }
  if out == "" { return "kit" }
  let c0 = int(out[0])
  if c0 >= 48 and c0 <= 57 { return "k_" + out }
  return out
}
function kb_key_free(kb: KitBake, key: string) -> bool {
  for i in 0 .. len(kb.kits) { if kb.kits[i].key == key { return false } }
  return true
}

# The kit of a model's node (a glTF and the node in it: origin at the middle of the footprint, on the ground, +y up), made on the
# first ask and the same one after: its id. `w`, `d`, `h` are the footprint and height in metres (the HLOD box, the impostor's
# frame and the far distances come from them); `interior` is the InteriorAtlases key its windows show ("" plain glass). A second ask
# with other measures keeps the first's.
@alloc_ok("a bake: a kit's row is made once")
export function kitbake_kit(kb: KitBake, model: string, node: string, w: float, d: float, h: float, interior: string) -> int {
  return kitbake_kit_styled(kb, model, node, w, d, h, interior, "")
}

# kitbake_kit with a facade style: `facade` names the style (kitbake_facade gives its numbers); "" is kitbake_kit. The kit's key is
# the node's and the style's ("flat_office")
@alloc_ok("a bake: a kit's row is made once")
export function kitbake_kit_styled(kb: KitBake, model: string, node: string, w: float, d: float, h: float, interior: string, facade: string) -> int {
  let id = kb_id_styled(model, node, interior, facade)
  if Dict.has(kb.kit_of, id) { return Dict.get(kb.kit_of, id) }
  let k = new RenderKit
  var base = kb_key(node)
  if facade != "" { base = kb_key(`{node}_{facade}`) }
  var key = base
  var n = 2
  while not kb_key_free(kb, key) { key = `{base}_{n}`;  n += 1 }
  k.key = key
  k.model = model
  k.node = node
  k.w = Math.max(w, 0.1);  k.d = Math.max(d, 0.1);  k.h = Math.max(h, 0.1)
  let r = 0.5 * Math.sqrt(k.w * k.w + k.d * k.d + k.h * k.h)
  kb_dists(kb, k, r)
  k.interior = interior
  k.facade = facade
  push(kb.kits, k)
  push(kb.boxes, null)
  Dict.set(kb.kit_of, id, len(kb.kits) - 1)
  kb_box_mark(kb, len(kb.kits) - 1)
  return len(kb.kits) - 1
}

# a kit's distances from its bounding radius `r`: `near` and `far` scale with it, held within the row's @Range (cellfile.ludic RenderKit:
# 0 .. KB_DIST_MAX m), so a kit as big as an airport writes a row the game's registry reads (a far past the camera's reach draws the same)
const KB_DIST_MAX: float = 20000.0
function kb_dists(kb: KitBake, k: RenderKit, r: float) -> void {
  k.near = Math.min(Math.max(r * kb.near_scale, kb.near_min), KB_DIST_MAX)
  k.far = Math.min(Math.max(r * kb.far_scale, Math.max(kb.far_min, k.near * 2.0)), KB_DIST_MAX)
}

# kit `id` made a box kit when its model and node were registered (kitbake_box): its row says so, its distances come from its
# reference instance's drawn bounds
@alloc_ok("a bake: once a kit")
function kb_box_mark(kb: KitBake, id: int) -> void {
  let k = kb.kits[id]
  let key = `{k.model}|{k.node}`
  if not Dict.has(kb.box_of, key) { return }
  let box = kb.box_tuples[Dict.get(kb.box_of, key)]
  kb.boxes[id] = box
  k.box = true
  if id < kb.seeded { return }
  let b = floats(6)
  kitbox_bounds(box, k.w, k.d, k.h, b)
  let r = kitbox_radius_of(b)
  kb_dists(kb, k, r)
  free(b)
}

# Register a model's node as a BOX kit (kitbox.ludic): `box` its anchor tuples as kitbox_read gave them. Every kit made of that
# model and node, before or after, is a box kit whose instances are placed with kitbake_place_box. false when `box` has no anchors.
@alloc_ok("a bake: a box kit is registered once")
export function kitbake_box(kb: KitBake, model: string, node: string, box: KitBox) -> bool {
  if box == null or not box.on { return false }
  let key = `{model}|{node}`
  if Dict.has(kb.box_of, key) { kb.box_tuples[Dict.get(kb.box_of, key)] = box } else {
    push(kb.box_tuples, box)
    Dict.set(kb.box_of, key, len(kb.box_tuples) - 1)
  }
  for i in 0 .. len(kb.kits) { if kb.kits[i].model == model and kb.kits[i].node == node { kb_box_mark(kb, i) } }
  return true
}

# is kit `id` a box kit of this bake (its tuples known)?
export function kitbake_is_box(kb: KitBake, id: int) -> bool { return id >= 0 and id < len(kb.boxes) and kb.boxes[id] != null }

# The BOX kit of a model's node (kitbox.ludic: its vertices carry anchors), its tuples `box` as kitbox_read gave them: every
# instance is placed with its own w, d, h (kitbake_place_box). `w`, `d`, `h` here are the instance its impostor is baked at (a
# typical building of the kit); the row says `box: true`. -1 when `box` has no anchors.
export function kitbake_kit_box(kb: KitBake, model: string, node: string, box: KitBox, w: float, d: float, h: float, interior: string) -> int {
  if not kitbake_box(kb, model, node, box) { return -1 }
  return kitbake_kit(kb, model, node, w, d, h, interior)
}

# kitbake_kit_box with a facade style (kitbake_kit_styled)
export function kitbake_kit_box_styled(kb: KitBake, model: string, node: string, box: KitBox, w: float, d: float, h: float, interior: string, facade: string) -> int {
  if not kitbake_box(kb, model, node, box) { return -1 }
  return kitbake_kit_styled(kb, model, node, w, d, h, interior, facade)
}

# kit `id`'s facade numbers from `src` (its fac_* fields and its window cell: kit.frag FACADE draws them); the style's name stays the kit's
export function kitbake_facade(kb: KitBake, id: int, src: RenderKit) -> void {
  if id < 0 or id >= len(kb.kits) or src == null { return }
  let k = kb.kits[id]
  k.fac_bay = src.fac_bay;  k.fac_glass = src.fac_glass;  k.fac_sill = src.fac_sill;  k.fac_head = src.fac_head
  k.fac_pier = src.fac_pier;  k.fac_mull = src.fac_mull;  k.fac_tran = src.fac_tran;  k.fac_reveal = src.fac_reveal
  k.fac_ground = src.fac_ground;  k.fac_spandrel = src.fac_spandrel;  k.fac_shop_b = src.fac_shop_b;  k.fac_shop_t = src.fac_shop_t
  k.fac_near = src.fac_near;  k.fac_frame = src.fac_frame
  k.fac_frame_r = src.fac_frame_r;  k.fac_frame_g = src.fac_frame_g;  k.fac_frame_b = src.fac_frame_b
  k.win_w = src.win_w;  k.win_h = src.win_h
}

# kit `id`'s distances set, not derived: its full mesh inside `near`, its card to `far` when it has an `impostor` (a small detail has none
# and is gone past `near`)
export function kitbake_dists(kb: KitBake, id: int, near: float, far: float, impostor: bool) -> void {
  if id < 0 or id >= len(kb.kits) { return }
  let k = kb.kits[id]
  k.near = Math.min(Math.max(near, 0.0), KB_DIST_MAX)
  k.far = Math.min(Math.max(far, k.near), KB_DIST_MAX)
  k.impostor = impostor
}

# kit `id`'s walls carry a line every `h` metres (from a box instance's eave down, from an ordinary instance's base up), `line` metres thick (0: none): the RenderKits row
# says `storey_h` and `storey_line`, and kit.frag draws them
export function kitbake_storey(kb: KitBake, id: int, h: float, line: float) -> void {
  if id < 0 or id >= len(kb.kits) { return }
  kb.kits[id].storey_h = Math.max(h, 0.0)
  kb.kits[id].storey_line = line
}

# the cell (cx, cz)'s content, made on the first placement
function kb_cell(kb: KitBake, cx: int, cz: int) -> CellContent {
  let key = `{cx},{cz}`
  if Dict.has(kb.cell_of, key) { return kb.cells[Dict.get(kb.cell_of, key)] }
  let c = cell_content_new(cx, cz, kb.size, 16)
  push(kb.cells, c)
  Dict.set(kb.cell_of, key, len(kb.cells) - 1)
  return c
}

# One placement at world (x, y, z): into the cell the point is in, relative to its corner (exact however far from the origin).
# `yaw` in radians as the renderer turns an instance, `tint` RGBA8 (cell_rgba), `variation` 0 .. 65535 seeds the facade and
# each window's room, `flags` are the game's own bits. false for a kit that was never made.
@alloc_ok("a bake: the cell's columns grow while it is filled")
export function kitbake_place(kb: KitBake, kit: int, x: float, y: float, z: float, yaw: float, scale: float, tint: int, variation: int, flags: int) -> bool {
  if kit < 0 or kit >= len(kb.kits) { return false }
  let cx = int(Math.floor(x / kb.size))
  let cz = int(Math.floor(z / kb.size))
  cell_add(kb_cell(kb, cx, cz), kit, x - float(cx) * kb.size, y, z - float(cz) * kb.size, yaw, scale, tint, variation & 65535, flags)
  kb.placed += 1
  return true
}

# One box instance at world (x, y, z) of kit `kit` (kitbake_kit_box), its own width `w` (along its x), depth `d` and height `h`
# (kitbox.ludic): its drawn bounds are worked out from the kit's tuples and kept with it (the culling sphere, the HLOD box).
# false for a kit that is not a box kit of this bake.
@alloc_ok("a bake: the cell's columns grow while it is filled")
export function kitbake_place_box(kb: KitBake, kit: int, x: float, y: float, z: float, yaw: float, w: float, d: float, h: float, tint: int, variation: int, flags: int) -> bool {
  if kit < 0 or kit >= len(kb.kits) or kb.boxes[kit] == null { return false }
  let b = floats(6)
  kitbox_bounds(kb.boxes[kit], w, d, h, b)
  let cx = int(Math.floor(x / kb.size))
  let cz = int(Math.floor(z / kb.size))
  cell_add_box(kb_cell(kb, cx, cz), kit, x - float(cx) * kb.size, y, z - float(cz) * kb.size, yaw, w, d, h, b, tint, variation & 65535, flags)
  free(b)
  kb.placed += 1
  return true
}

export function kitbake_kit_count(kb: KitBake) -> int { return len(kb.kits) }
export function kitbake_cell_count(kb: KitBake) -> int { return len(kb.cells) }

# the cell files and the index into `dir` (made if need be): how many cells were written. The index's "proxy" weights stay 0 until
# hlod_bake has run over the directory (it rewrites the index with them).
@alloc_ok("a bake: the index is made once")
export function kitbake_write(kb: KitBake, dir: string) -> int {
  Fs.mkdir(dir)
  let ix = cell_index_new(kb.size)
  var n = 0
  for i in 0 .. len(kb.cells) {
    let c = kb.cells[i]
    if not cell_save(dir, c) { print(`kitbake: cannot write {cell_path(dir, c.cx, c.cz, "lwc")}`);  continue }
    cell_index_set(ix, c.cx, c.cz, c.n, cell_bytes(c), 0)
    n += 1
  }
  if not cell_index_save(dir, ix) { print(`kitbake: cannot write the index in {dir}`);  return -1 }
  return n
}

# a float as a row writes it ("12.5", never "1e1")
function kb_num(v: float) -> string { return `{v}` }
# a colour component to the thousandth (a row's colour, not a measure: the file stays readable and the bake byte-stable)
function kb_c3(v: float) -> float { return Math.floor(Math.clamp(v, 0.0, 1.0) * 1000.0 + 0.5) / 1000.0 }

# The rows of RenderKits from kit `from` on, as the text of a render_kits.lres (`from` = the count that was seeded appends to an
# existing file; 0 writes them all): the same fields the studio's RenderKits table edits.
@alloc_ok("a bake: the rows' text is made once")
export function kitbake_rows(kb: KitBake, from: int) -> string {
  var out = ""
  for i in from .. len(kb.kits) {
    let k = kb.kits[i]
    out = out + `{k.key} \{\n  model: "{k.model}", node: "{k.node}"\n  w: {kb_num(k.w)}, d: {kb_num(k.d)}, h: {kb_num(k.h)}\n  near: {kb_num(k.near)}, far: {kb_num(k.far)}\n`
    if k.interior != "" { out = out + `  interior: "{k.interior}"\n  win_w: {kb_num(k.win_w)}, win_h: {kb_num(k.win_h)}\n` }
    if k.storey_h > 0.0 { out = out + `  storey_h: {kb_num(k.storey_h)}, storey_line: {kb_num(k.storey_line)}\n` }
    if k.box { out = out + "  box: true\n" }
    if not k.impostor { out = out + "  impostor: false\n" }
    if k.facade != "" or k.fac_bay > 0.0 {
      if k.interior == "" { out = out + `  win_w: {kb_num(k.win_w)}, win_h: {kb_num(k.win_h)}\n` }
      out = out + `  facade: "{k.facade}", fac_bay: {kb_num(k.fac_bay)}, fac_glass: {kb_num(k.fac_glass)}, fac_sill: {kb_num(k.fac_sill)}, fac_head: {kb_num(k.fac_head)}\n`
      out = out + `  fac_pier: {kb_num(k.fac_pier)}, fac_mull: {k.fac_mull}, fac_tran: {k.fac_tran}, fac_reveal: {kb_num(k.fac_reveal)}, fac_ground: {k.fac_ground}, fac_spandrel: {kb_num(k.fac_spandrel)}\n`
      out = out + `  fac_shop_b: {kb_num(k.fac_shop_b)}, fac_shop_t: {kb_num(k.fac_shop_t)}, fac_near: {kb_num(k.fac_near)}, fac_frame: {kb_num(k.fac_frame)}\n`
      out = out + `  fac_frame_r: {kb_num(kb_c3(k.fac_frame_r))}, fac_frame_g: {kb_num(kb_c3(k.fac_frame_g))}, fac_frame_b: {kb_num(kb_c3(k.fac_frame_b))}\n`
    }
    let d = new RenderKit
    if k.proxy_roof or k.proxy_r != d.proxy_r or k.proxy_g != d.proxy_g or k.proxy_b != d.proxy_b {
      out = out + `  proxy_r: {kb_num(kb_c3(k.proxy_r))}, proxy_g: {kb_num(kb_c3(k.proxy_g))}, proxy_b: {kb_num(kb_c3(k.proxy_b))}\n`
    }
    if k.proxy_roof {
      out = out + `  proxy_roof: true, proxy_roof_r: {kb_num(kb_c3(k.proxy_roof_r))}, proxy_roof_g: {kb_num(kb_c3(k.proxy_roof_g))}, proxy_roof_b: {kb_num(kb_c3(k.proxy_roof_b))}\n`
    }
    out = out + "}\n"
  }
  return out
}
