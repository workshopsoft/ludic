# ============================================================================
# ies.ludic — IES light profiles (IESNA LM-63 photometric files) as Unreal 5.8 reads and applies them.
#
# The parser is UE's FIESLoader (Engine/Source/Runtime/IESFile/Private/IESLoader.cpp, 5.8.4-release): the version line (LM-63-1986,
# 1991, 1995, 2002), the keyword lines up to TILT=NONE (any other TILT is refused, as UE does), the header numbers (light count,
# lumens per lamp, candela multiplier, the vertical and horizontal angle counts, the photometric type, the units, the size, the ballast
# factor, the future use, the input watts), the vertical and horizontal angles (each increasing), the candela values (a horizontal
# angle's column of vertical angles at a time, times the multiplier), an optional END. Brightness is the max candela (ComputeMax).
# Interpolate2D is UE's: Type A angles turned into Type C's, the horizontal symmetry of 0 / 90 / 180 / 360 degree files (and those
# from 90 to 270), ComputeFilterPos's binary search, InterpolateBilinear. ExtractInRGBA16F's texture: GetWidth x GetHeight (256 x 256),
# x the vertical angle (0 .. 180 over the width), y the horizontal (0 .. 360 over the height), each texel the candela over the max
# (UE's TextureMultiplier 1).
#
# The renderer keeps the profiles as layers of one array texture (UE 5.8's IES atlas, View.IESAtlasTexture): ies_profile_add parses a
# file's text once and hands back its layer; a UeLocalLight's `ies` names it. lighting.glsl ueLightProfile is
# ComputeLightProfileMultiplier (IESLightProfilesCommon.ush); ies_profile_multiplier here is the same arithmetic on the CPU (the tests'
# reference, and a game's own light meter).
# ============================================================================

export const IES_TEX_W: int = 256          # FIESLoader::GetWidth: the vertical angles
export const IES_TEX_H: int = 256          # FIESLoader::GetHeight: the horizontal angles
export const IES_TYPE_C: int = 1
export const IES_TYPE_B: int = 2
export const IES_TYPE_A: int = 3

property IesProfile {
  ok: bool = false,
  error: string = "No data loaded",
  photometric_type: int = 1,
  v_angles: floats = null,
  h_angles: floats = null,
  candela: floats = null,      # [h * len(v_angles) + v], already times the candela multiplier
  lumens_per_lamp: float = 0.0,
  brightness: float = 0.0      # the max candela (UE's Brightness)
}

# ---- parsing -----------------------------------------------------------------------------------------------------------------------

# a number as atof reads it: sign, digits, a fraction, an exponent; anything else ends it (0 when there is no number)
export function ies_atof(t: string) -> float {
  let n = Text.length(t)
  var i = 0
  var sgn = 1.0
  if i < n and (Text.char_at(t, i) == 45 or Text.char_at(t, i) == 43) {
    if Text.char_at(t, i) == 45 { sgn = -1.0 }
    i += 1
  }
  var v = 0.0
  while i < n and ies_digit(Text.char_at(t, i)) {
    v = v * 10.0 + float(Text.char_at(t, i) - 48)
    i += 1
  }
  if i < n and Text.char_at(t, i) == 46 {
    i += 1
    var scale = 0.1
    while i < n and ies_digit(Text.char_at(t, i)) {
      v += scale * float(Text.char_at(t, i) - 48)
      scale = scale * 0.1
      i += 1
    }
  }
  if i < n and (Text.char_at(t, i) == 101 or Text.char_at(t, i) == 69) {
    var j = i + 1
    var es = 1
    if j < n and (Text.char_at(t, j) == 45 or Text.char_at(t, j) == 43) {
      if Text.char_at(t, j) == 45 { es = -1 }
      j += 1
    }
    var e = 0
    var any = false
    while j < n and ies_digit(Text.char_at(t, j)) {
      e = e * 10 + (Text.char_at(t, j) - 48)
      any = true
      j += 1
    }
    if any { v = v * Math.pow(10.0, float(es * e)) }
  }
  return sgn * v
}
function ies_digit(c: int) -> bool { return c >= 48 and c <= 57 }

# the file's text split into lines (CR LF, LF or CR), each trimmed
@alloc_ok("an IES file parsed: a light profile loaded, not a frame")
function ies_lines(text: string) -> []string {
  let t = Text.replace(Text.replace(text, "\r\n", "\n"), "\r", "\n")
  let raw = Text.split(t, "\n")
  let out = new []string
  for i in 0 .. len(raw) { push(out, Text.trim(Text.replace(raw[i], "\t", " "))) }
  return out
}

# FIESLoader::Load
@alloc_ok("an IES file parsed: a light profile loaded, not a frame")
export function ies_parse(text: string) -> IesProfile {
  let p = new IesProfile
  let lines = ies_lines(text)
  var li = 0
  # (UE skips the white space before each line: blank lines are not lines)
  while li < len(lines) and lines[li] == "" { li += 1 }
  p.error = "VersionError"
  if li < len(lines) {
    let v = Text.upper(lines[li])
    if v == "IESNA:LM-63-1995" or v == "IESNA91" or v == "IESNA:LM-63-2002" { li += 1 }
  }
  p.error = "HeaderError"
  var tilt = false
  while li < len(lines) {
    let l = lines[li]
    li += 1
    if l == "TILT=NONE" { tilt = true;  break }
    if Text.starts_with(l, "TILT=") { return p }        # TILT=INCLUDE and TILT=<file>: not supported, as UE's
  }
  if not tilt { return p }
  # every number after TILT=NONE, white space apart
  let tok = new []string
  while li < len(lines) {
    let parts = Text.split(lines[li], " ")
    for k in 0 .. len(parts) { if parts[k] != "" { push(tok, parts[k]) } }
    li += 1
  }
  p.error = "HeaderParameterError"
  if len(tok) < 13 { return p }
  var ti = 0
  let count = int(ies_atof(tok[ti]));  ti += 1
  if count < 1 { p.error = "Light count needs to be positive.";  return p }
  p.lumens_per_lamp = ies_atof(tok[ti]);  ti += 1
  let mult = ies_atof(tok[ti]);  ti += 1
  if mult < 0.0 { p.error = "CandelaMult is negative";  return p }
  let nv = int(ies_atof(tok[ti]));  ti += 1
  let nh = int(ies_atof(tok[ti]));  ti += 1
  if nv < 0 { p.error = "VAnglesNum is not valid";  return p }
  if nh < 0 { p.error = "HAnglesNum is not valid";  return p }
  let ptype = int(ies_atof(tok[ti]));  ti += 1
  if ptype >= IES_TYPE_C and ptype <= IES_TYPE_A { p.photometric_type = ptype }
  ti += 1                                                   # units (1 feet, 2 metres)
  ti += 3                                                   # width, length, height
  ti += 2                                                   # ballast factor, future use
  ti += 1                                                   # input watts
  p.error = "ContentError"
  if len(tok) < ti + nv + nh + nv * nh { return p }
  p.v_angles = floats(nv)
  var lo = -1000000000.0
  for k in 0 .. nv {
    let a = ies_atof(tok[ti]);  ti += 1
    if a < lo { p.error = "V Values are not in increasing order";  return p }
    lo = a
    p.v_angles[k] = a
  }
  p.h_angles = floats(nh)
  lo = -1000000000.0
  for k in 0 .. nh {
    let a = ies_atof(tok[ti]);  ti += 1
    if a < lo { p.error = "H Values are not in increasing order";  return p }
    lo = a
    p.h_angles[k] = a
  }
  p.candela = floats(nv * nh)
  for k in 0 .. nv * nh {
    p.candela[k] = ies_atof(tok[ti]) * mult
    ti += 1
  }
  p.error = "Unexpected content after candela values."
  if ti < len(tok) and Text.upper(tok[ti]) == "END" { ti += 1 }
  if ti < len(tok) { p.error = "Unexpected content after END.";  return p }
  p.error = ""
  p.ok = true
  p.brightness = ies_max(p)
  if p.brightness <= 0.0 { p.brightness = 1000.0 }          # "use some reasonable value"
  return p
}

export function ies_max(p: IesProfile) -> float {
  var m = 0.0
  if p.candela == null { return m }
  for k in 0 .. len(p.candela) { m = Math.max(m, p.candela[k]) }
  return m
}

# ---- interpolation (FIESLoader) ------------------------------------------------------------------------------------------------------

# ComputeFilterPos: the fractional index of a value in increasing angles
export function ies_filter_pos(value: float, sorted: floats) -> float {
  let n = len(sorted)
  if value < sorted[0] { return 0.0 }
  if value > sorted[n - 1] { return float(n - 1) }
  var s = 0
  var e = n - 1
  while s < e {
    let t = (s + e + 1) / 2
    if value >= sorted[t] { s = t } else { e = t - 1 }
  }
  var frac = 0.0
  if s + 1 < n {
    let d = sorted[s + 1] - sorted[s]
    if d > 0.0001 { frac = (value - sorted[s]) / d }
  }
  return float(s) + frac
}

function ies_point(p: IesProfile, x: int, y: int) -> float {
  let nh = len(p.h_angles)
  let nv = len(p.v_angles)
  return p.candela[(y % nv) + nv * (x % nh)]
}

# InterpolateBilinear: x the horizontal index, y the vertical
export function ies_bilinear(p: IesProfile, fx: float, fy: float) -> float {
  let x = int(fx)
  let y = int(fy)
  let ax = fx - float(x)
  let ay = fy - float(y)
  let p00 = ies_point(p, x, y)
  let p10 = ies_point(p, x + 1, y)
  let p01 = ies_point(p, x, y + 1)
  let p11 = ies_point(p, x + 1, y + 1)
  let p0 = p00 + (p01 - p00) * ay
  let p1 = p10 + (p11 - p10) * ay
  return p0 + (p1 - p0) * ax
}

# Interpolate2D: the candela at a horizontal and a vertical angle (degrees)
export function ies_interpolate2d(p: IesProfile, h_angle: float, v_angle: float) -> float {
  var u = 0.0
  var v = 0.0
  if p.photometric_type == IES_TYPE_A {
    let r = PI / 180.0
    let x = Math.cos(v_angle * r)
    let y = Math.sin(v_angle * r) * Math.sin(h_angle * r)
    let z = Math.sin(v_angle * r) * Math.cos(h_angle * r)
    let nva = Math.asin(z) / r
    let nha = -Math.atan2(y, x) / r
    u = ies_filter_pos(nha, p.h_angles)
    v = ies_filter_pos(nva, p.v_angles)
  } else {
    var h = h_angle
    let n = len(p.h_angles)
    if n > 0 {
      let last = p.h_angles[n - 1]
      if last > 0.0 and h > last {
        let quadrant = int(h / last)
        if quadrant == 1 or quadrant == 3 { h = last - (h - Math.floor(h / last) * last) } else { h = h - Math.floor(h / last) * last }
      } else if p.h_angles[0] > 0.0 and h < p.h_angles[0] {
        h = last - p.h_angles[0] - h
      }
    }
    u = ies_filter_pos(h, p.h_angles)
    v = ies_filter_pos(v_angle, p.v_angles)
  }
  return ies_bilinear(p, u, v)
}

# ExtractInRGBA16F's values (one channel): out[y * w + x] = candela at (y / h x 360, x / w x 180) over the max
export function ies_extract(p: IesProfile, w: int, h: int, out: floats) -> void {
  let mx = ies_max(p)
  var inv = 0.0
  if mx > 0.0 { inv = 1.0 / mx }
  for y in 0 .. h {
    let hf = float(y) / float(h)
    for x in 0 .. w {
      let vf = float(x) / float(w)
      out[y * w + x] = inv * ies_interpolate2d(p, hf * 360.0, vf * 180.0)
    }
  }
}

# ---- the lookup (IESLightProfilesCommon.ush ComputeLightProfileMultiplier) --------------------------------------------------------

# the texture coordinates the shader samples for a point lit from a light: `to_light` the unit vector from the point to the light,
# `dir` the light's direction (its forward), `tan` its tangent (UE's LightTangent: the light's up). out[0] NormAngle (the vertical angle
# / 180), out[1] NormTangentAngle (the horizontal / 360)
export function ies_profile_uv(tlx: float, tly: float, tlz: float, dx: float, dy: float, dz: float, tx: float, ty: float, tz: float, out: floats) -> void {
  # LightBitangent = normalize(cross(LightTangent, LightDirection))
  var bx = ty * dz - tz * dy
  var by = tz * dx - tx * dz
  var bz = tx * dy - ty * dx
  let bl = Math.max(Math.sqrt(bx * bx + by * by + bz * bz), 1.0 e - 12)
  bx = bx / bl;  by = by / bl;  bz = bz / bl
  # LocalToLight = ToLight in (Direction, Bitangent, Tangent)
  let ly = tlx * bx + tly * by + tlz * bz
  let lz = tlx * tx + tly * ty + tlz * tz
  let dp = Math.clamp(tlx * dx + tly * dy + tlz * dz, -1.0, 1.0)
  out[0] = Math.asin(dp) / PI + 0.5
  out[1] = Math.atan2(-lz, -ly) / (PI * 2.0) + 0.5
}

# the multiplier the shader gives (the texture's bilinear sample), from the profile itself: the texture's texel centres as a GPU's
# bilinear filter with clamped edges meets them
export function ies_profile_multiplier(p: IesProfile, tex: floats, w: int, h: int, tlx: float, tly: float, tlz: float, dx: float, dy: float, dz: float, tx: float, ty: float, tz: float, tmp: floats) -> float {
  ies_profile_uv(tlx, tly, tlz, dx, dy, dz, tx, ty, tz, tmp)
  let fx = Math.clamp(tmp[0] * float(w) - 0.5, 0.0, float(w - 1))
  let fy = Math.clamp(tmp[1] * float(h) - 0.5, 0.0, float(h - 1))
  let x0 = int(fx)
  let y0 = int(fy)
  let x1 = Math.min(x0 + 1, w - 1)
  let y1 = Math.min(y0 + 1, h - 1)
  let ax = fx - float(x0)
  let ay = fy - float(y0)
  let a = tex[y0 * w + x0] + (tex[y0 * w + x1] - tex[y0 * w + x0]) * ax
  let b = tex[y1 * w + x0] + (tex[y1 * w + x1] - tex[y1 * w + x0]) * ax
  return a + (b - a) * ay
}

# ---- the renderer's profiles: one array texture, a layer each ------------------------------------------------------------------------

# a profile from an LM-63 file's text: its layer (a UeLocalLight's `ies`), or -1 when the file is not one (ies_profile_error says why)
@alloc_ok("a light profile loaded: once a profile, not a frame")
export function ies_profile_add(render3d_st: mut Render3dState, text: string) -> int {
  let p = ies_parse(text)
  if not p.ok {
    render3d_st.ies_error = p.error
    return -1
  }
  if render3d_st.ies_profiles == null { render3d_st.ies_profiles = new []IesProfile }
  push(render3d_st.ies_profiles, p)
  render3d_st.ies_dirty = true
  return len(render3d_st.ies_profiles) - 1
}
# a profile from a file, read once: a path asked for again is the same layer
@alloc_ok("a light profile loaded: once a profile, not a frame")
export function ies_profile_load(render3d_st: mut Render3dState, path: string) -> int {
  if render3d_st.ies_paths == null { render3d_st.ies_paths = new []string;  render3d_st.ies_layers = new []int }
  for i in 0 .. len(render3d_st.ies_paths) { if render3d_st.ies_paths[i] == path { return render3d_st.ies_layers[i] } }
  var k = -1
  if Fs.exists(path) { k = ies_profile_add(render3d_st, Fs.read_text(path)) } else { render3d_st.ies_error = `no such file: {path}` }
  push(render3d_st.ies_paths, path)
  push(render3d_st.ies_layers, k)
  return k
}
# are the profiles looked up (R3D_IES=0 or ies_lookups(st, false): every light's multiplier 1, its brightness still its profile's - an
# A/B of the lookup's cost on one build)?
export function ies_lookups(render3d_st: mut Render3dState, on: bool) -> void {
  render3d_st.ies_on = 0
  if on { render3d_st.ies_on = 1 }
}
export function ies_lookups_on(render3d_st: mut Render3dState) -> bool {
  if render3d_st.ies_on < 0 {
    render3d_st.ies_on = 1
    if r3d_env_has(render3d_st, "R3D_IES") and r3d_env(render3d_st, "R3D_IES") == "0" { render3d_st.ies_on = 0 }
  }
  return render3d_st.ies_on == 1
}
export function ies_profile_error(render3d_st: Render3dState) -> string { return render3d_st.ies_error }
# the profile's max candela (UE's IESTexture->Brightness: what a light with use_ies_brightness shines at), 0 for no such profile
export function ies_profile_brightness(render3d_st: Render3dState, layer: int) -> float {
  if render3d_st.ies_profiles == null or layer < 0 or layer >= len(render3d_st.ies_profiles) { return 0.0 }
  return render3d_st.ies_profiles[layer].brightness
}

# the array texture, made again when a profile came; a 1 x 1 white layer when there are none (the shader samples it only for a light
# that names a layer)
@alloc_ok("the light profiles' texture: made when a profile is added, not a frame")
function ies_texture(render3d_st: mut Render3dState) -> int {
  if render3d_st.ies_tex != 0 and not render3d_st.ies_dirty { return render3d_st.ies_tex }
  if render3d_st.ies_tex != 0 { gpu_tex_free(render3d_st, render3d_st.ies_tex) }
  var n = 0
  if render3d_st.ies_profiles != null { n = len(render3d_st.ies_profiles) }
  var w = IES_TEX_W
  var h = IES_TEX_H
  var layers = n
  if n == 0 { w = 1;  h = 1;  layers = 1 }
  let px = floats(w * h * layers * 4)
  if n == 0 {
    for k in 0 .. 4 { px[k] = 1.0 }
  } else {
    let one = floats(w * h)
    for l in 0 .. n {
      ies_extract(render3d_st.ies_profiles[l], w, h, one)
      let o = l * w * h * 4
      for k in 0 .. w * h { let v = one[k];  px[o + k * 4] = v;  px[o + k * 4 + 1] = v;  px[o + k * 4 + 2] = v;  px[o + k * 4 + 3] = v }
    }
  }
  let id = gpu_tex_new(render3d_st)
  gpu_tex_bind(render3d_st, GPU_TEX2D_ARRAY, id)
  gpu_tex_image3d(render3d_st, GPU_RGBA16F, w, h, layers, GPU_RGBA, GPU_FLOAT, data_of(px))
  gpu_tex_param(render3d_st, GPU_TEX2D_ARRAY, GPU_TEXTURE_WRAP_S, GPU_CLAMP_TO_EDGE)
  gpu_tex_param(render3d_st, GPU_TEX2D_ARRAY, GPU_TEXTURE_WRAP_T, GPU_CLAMP_TO_EDGE)
  gpu_tex_param(render3d_st, GPU_TEX2D_ARRAY, GPU_TEXTURE_MAG_FILTER, GPU_LINEAR)
  gpu_tex_param(render3d_st, GPU_TEX2D_ARRAY, GPU_TEXTURE_MIN_FILTER, GPU_LINEAR)
  free(px)
  render3d_st.ies_tex = id
  render3d_st.ies_dirty = false
  return id
}
