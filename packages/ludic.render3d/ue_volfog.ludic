# ============================================================================
# ue_volfog.ludic — Unreal's volumetric fog: the height fog as a lit participating medium in a froxel grid (UE 5.8 VolumetricFog).
#
# UeVolFog holds UExponentialHeightFogComponent's volumetric settings (bEnableVolumetricFog, VolumetricFogScatteringDistribution 0.2,
# albedo white, emissive black, extinction scale 1, VolumetricFogDistance 6000 cm = 60 m) and the r.VolumetricFog.* defaults
# (GridPixelSize 16, GridSizeZ 64, DepthDistributionScale 32, TemporalReprojection 1, Jitter 1, HistoryWeight 0.9,
# GridCenterOffsetFromDepthBuffer 0.5, OffsetThresholdToAcceptDepthBufferOffset 1, ConservativeDepth 1). Unreal's component leaves bEnableVolumetricFog
# off; it is on here because the game wants its shafts. Lights take part by their VolumetricScatteringIntensity (1): the sun with
# its cascades, height-field and cloud shadows, and the sky light (SkyLightVolumetricScatteringIntensity 1) through its SH.
#
# Each frame (after the opaque scene, the water and the blended actors): ue_volfog.frag VF_SCATTER per slice into this frame's grid
# (last frame's as history), VF_INTEGRATE per slice into the integrated grid; ue_fog.frag combines it (CombineVolumetricFog) and
# keeps the analytic fog to beyond its range. While it runs the old shafts (volumetric.frag) are off. With ConservativeDepth a tile's
# furthest depth (VF_CDEPTH, before the scatter) lets the scatter skip cells wholly behind the scene and the history read avoid them
# (R3D_UE_VOLFOG_CONSERVATIVE_DEPTH=0 turns it off). The integration is FinalIntegrationCS's front-to-back march, a slice a pass
# with the sum so far carried in a second target (R3D_UE_VOLFOG_MARCH=0: each slice integrates every slice before it again).
# The grid is a 2D atlas, a tile a slice (ue_volfog.frag VF_ATLAS): one pass scatters every cell and one integrates them, where the
# array grid (R3D_UE_VOLFOG_ATLAS=0) took a pass a slice for each. Unreal writes a 3D texture from compute; this GPU layer has no
# 3D or storage-image targets, and a pass a slice was a render pass a slice.
# R3D_UE_VOLFOG=0 (or r3d_ue_volfog(st, false)) turns it off; needs Unreal's fog.
# ============================================================================

property UeVolFog {
  enable_volumetric_fog: bool = true,                  # bEnableVolumetricFog (Unreal's default false; see above)
  scattering_distribution: float = 0.2,                # VolumetricFogScatteringDistribution (the phase function's g)
  albedo_r: float = 1.0,                               # VolumetricFogAlbedo
  albedo_g: float = 1.0,
  albedo_b: float = 1.0,
  emissive_r: float = 0.0,                             # VolumetricFogEmissive (x 1/10000 as FExponentialHeightFogSceneInfo)
  emissive_g: float = 0.0,
  emissive_b: float = 0.0,
  extinction_scale: float = 1.0,                       # VolumetricFogExtinctionScale
  distance: float = 60.0,                              # VolumetricFogDistance (m)
  near_fade_in_distance: float = 0.0,                  # VolumetricFogNearFadeInDistance (m)
  sun_volumetric_scattering_intensity: float = 1.0,    # the sun's VolumetricScatteringIntensity
  sky_light_volumetric_scattering_intensity: float = 1.0,   # the sky light's
  grid_pixel_size: int = 16,                           # r.VolumetricFog.GridPixelSize
  grid_size_z: int = 64,                               # r.VolumetricFog.GridSizeZ
  depth_distribution_scale: float = 32.0,              # r.VolumetricFog.DepthDistributionScale
  temporal_reprojection: bool = true,                  # r.VolumetricFog.TemporalReprojection
  jitter: bool = true,                                 # r.VolumetricFog.Jitter
  history_weight: float = 0.9,                         # r.VolumetricFog.HistoryWeight
  grid_center_offset_from_depth_buffer: float = 0.5,   # r.VolumetricFog.GridCenterOffsetFromDepthBuffer
  offset_threshold_to_accept_depth_buffer_offset: float = 1.0,
  conservative_depth: bool = true,                     # r.VolumetricFog.ConservativeDepth
  march: bool = true,                                  # the integration carried slice to slice (R3D_UE_VOLFOG_MARCH), array grid only
  atlas: bool = true                                   # the grid as one 2D atlas (R3D_UE_VOLFOG_ATLAS)
}

@alloc_ok("made once per resource and kept for its life (a texture, program, sampler, view, layout or memory block is created when first asked for)")
export function r3d_volumetric_fog(render3d_st: mut Render3dState) -> UeVolFog {
  if render3d_st.ue_vf_s == null {
    render3d_st.ue_vf_s = new UeVolFog
    # R3D_UE_VOLFOG_G=<g>: VolumetricFogScatteringDistribution for shots and tuning (Unreal's default 0.2)
    if r3d_env_has(render3d_st, "R3D_UE_VOLFOG_G") { render3d_st.ue_vf_s.scattering_distribution = ue_parse_float(r3d_env(render3d_st, "R3D_UE_VOLFOG_G")) }
    # R3D_UE_VOLFOG_CONSERVATIVE_DEPTH=0: r.VolumetricFog.ConservativeDepth 0, every cell lit
    if r3d_env_has(render3d_st, "R3D_UE_VOLFOG_CONSERVATIVE_DEPTH") and r3d_env(render3d_st, "R3D_UE_VOLFOG_CONSERVATIVE_DEPTH") == "0" { render3d_st.ue_vf_s.conservative_depth = false }
    if r3d_env_has(render3d_st, "R3D_UE_VOLFOG_ATLAS") and r3d_env(render3d_st, "R3D_UE_VOLFOG_ATLAS") == "0" { render3d_st.ue_vf_s.atlas = false }
    if r3d_env_has(render3d_st, "R3D_UE_VOLFOG_MARCH") and r3d_env(render3d_st, "R3D_UE_VOLFOG_MARCH") == "0" { render3d_st.ue_vf_s.march = false }
  }
  return render3d_st.ue_vf_s
}
export function r3d_ue_volfog(render3d_st: mut Render3dState, on: bool) -> void {
  render3d_st.ue_vf_on = 0
  if on { render3d_st.ue_vf_on = 1 }
}
function ue_volfog_on(render3d_st: mut Render3dState) -> bool {
  if render3d_st.ue_vf_on < 0 {
    render3d_st.ue_vf_on = 1
    if r3d_env_has(render3d_st, "R3D_UE_VOLFOG") and r3d_env(render3d_st, "R3D_UE_VOLFOG") == "0" { render3d_st.ue_vf_on = 0 }
  }
  return render3d_st.ue_vf_on == 1 and ue_fog_on(render3d_st) and r3d_volumetric_fog(render3d_st).enable_volumetric_fog
}

# a w x h x layers 2D array, linear, clamped, and a framebuffer a layer
@alloc_ok("made once per resource and kept for its life (a texture, program, sampler, view, layout or memory block is created when first asked for)")
function ue_vf_array(render3d_st: mut Render3dState, w: int, h: int, layers: int, fbs: words) -> int {
  let t = gpu_tex_new(render3d_st)
  gpu_tex_bind(render3d_st, GPU_TEX2D_ARRAY, t)
  gpu_tex_image3d(render3d_st, GPU_RGBA16F, w, h, layers, GPU_RGBA, GPU_HALF_FLOAT, null)
  gpu_tex_param(render3d_st, GPU_TEX2D_ARRAY, GPU_TEXTURE_WRAP_S, GPU_CLAMP_TO_EDGE)
  gpu_tex_param(render3d_st, GPU_TEX2D_ARRAY, GPU_TEXTURE_WRAP_T, GPU_CLAMP_TO_EDGE)
  gpu_tex_param(render3d_st, GPU_TEX2D_ARRAY, GPU_TEXTURE_MAG_FILTER, GPU_LINEAR)
  gpu_tex_param(render3d_st, GPU_TEX2D_ARRAY, GPU_TEXTURE_MIN_FILTER, GPU_LINEAR)
  for l in 0 .. layers {
    let fb = gpu_fb_new(render3d_st)
    gpu_fb_bind(render3d_st, fb)
    gpu_fb_color_layer(render3d_st, 0, t, l)
    fbs[l] = fb
  }
  gpu_fb_bind(render3d_st, 0)
  return t
}

# the grid's three arrays and their layers' framebuffers
# what the last size made, either set (VF_ATLAS's tiled targets, or the per-slice arrays and their framebuffers) and the conservative
# depths both make: a set never made is null (the atlas makes no per-slice framebuffers; freeing their lists crashed a resize)
function ue_vf_free(render3d_st: mut Render3dState) -> void {
  if render3d_st.ue_vf_fb_a != null {
    for l in 0 .. render3d_st.ue_vf_gz {
      gpu_fb_free(render3d_st, render3d_st.ue_vf_fb_a[l]);  gpu_fb_free(render3d_st, render3d_st.ue_vf_fb_b[l]);  gpu_fb_free(render3d_st, render3d_st.ue_vf_fb_i[l])
      if render3d_st.ue_vf_fb_m != null { gpu_fb_free(render3d_st, render3d_st.ue_vf_fb_m[l]) }
    }
    free(render3d_st.ue_vf_fb_a);  free(render3d_st.ue_vf_fb_b);  free(render3d_st.ue_vf_fb_i)
    render3d_st.ue_vf_fb_a = null;  render3d_st.ue_vf_fb_b = null;  render3d_st.ue_vf_fb_i = null
    if render3d_st.ue_vf_fb_m != null { free(render3d_st.ue_vf_fb_m);  render3d_st.ue_vf_fb_m = null }
  }
  if render3d_st.ue_vf_a != 0 { gpu_tex_free(render3d_st, render3d_st.ue_vf_a);  render3d_st.ue_vf_a = 0 }
  if render3d_st.ue_vf_b != 0 { gpu_tex_free(render3d_st, render3d_st.ue_vf_b);  render3d_st.ue_vf_b = 0 }
  if render3d_st.ue_vf_i != 0 { gpu_tex_free(render3d_st, render3d_st.ue_vf_i);  render3d_st.ue_vf_i = 0 }
  if render3d_st.ue_vf_carry_a != null { target_free(render3d_st, render3d_st.ue_vf_carry_a);  render3d_st.ue_vf_carry_a = null }
  if render3d_st.ue_vf_carry_b != null { target_free(render3d_st, render3d_st.ue_vf_carry_b);  render3d_st.ue_vf_carry_b = null }
  if render3d_st.ue_vf_ta != null { target_free(render3d_st, render3d_st.ue_vf_ta);  render3d_st.ue_vf_ta = null }
  if render3d_st.ue_vf_tb != null { target_free(render3d_st, render3d_st.ue_vf_tb);  render3d_st.ue_vf_tb = null }
  if render3d_st.ue_vf_ti != null { target_free(render3d_st, render3d_st.ue_vf_ti);  render3d_st.ue_vf_ti = null }
  if render3d_st.ue_vf_cd_a != null { target_free(render3d_st, render3d_st.ue_vf_cd_a);  render3d_st.ue_vf_cd_a = null }
  if render3d_st.ue_vf_cd_b != null { target_free(render3d_st, render3d_st.ue_vf_cd_b);  render3d_st.ue_vf_cd_b = null }
  if render3d_st.ue_vf_cdq != null { target_free(render3d_st, render3d_st.ue_vf_cdq);  render3d_st.ue_vf_cdq = null }
}

@alloc_ok("made once per resource and kept for its life (a texture, program, sampler, view, layout or memory block is created when first asked for)")
function ue_vf_init(render3d_st: mut Render3dState) -> void {
  let vf = r3d_volumetric_fog(render3d_st)
  let px = max(vf.grid_pixel_size, 4)
  let gw = (render3d_st.post_w + px - 1) / px
  let gh = (render3d_st.post_h + px - 1) / px
  let gz = max(min(vf.grid_size_z, 128), 8)
  if render3d_st.ue_vf_gw == gw and render3d_st.ue_vf_gh == gh and render3d_st.ue_vf_gz == gz { return }
  # a new size makes a new set and gives the old one back: the render size moves with the screen percentage and dynamic
  # resolution (upscale.ludic), as Unreal's grid follows the view rect, and a set left to the teardown was 50 MB a size
  if render3d_st.ue_vf_gw > 0 { ue_vf_free(render3d_st) }
  render3d_st.ue_vf_gw = gw;  render3d_st.ue_vf_gh = gh;  render3d_st.ue_vf_gz = gz
  render3d_st.ue_vf_cd_a = target_new(render3d_st, gw, gh, GPU_R32F, GPU_RED, GPU_FLOAT, false, GPU_NEAREST)
  render3d_st.ue_vf_cd_b = target_new(render3d_st, gw, gh, GPU_R32F, GPU_RED, GPU_FLOAT, false, GPU_NEAREST)
  render3d_st.ue_vf_cdq = target_new(render3d_st, (render3d_st.post_w + 3) / 4, (render3d_st.post_h + 3) / 4, GPU_R32F, GPU_RED, GPU_FLOAT, false, GPU_NEAREST)
  render3d_st.ue_vf_hist_ok = false
  render3d_st.ue_vf_cd_ok = false
  if vf.atlas {
    # tiles as near square as the slices allow
    var tx = 1
    while tx * tx < gz { tx += 1 }
    render3d_st.ue_vf_tx = tx;  render3d_st.ue_vf_ty = (gz + tx - 1) / tx
    let aw = gw * tx
    let ah = gh * render3d_st.ue_vf_ty
    render3d_st.ue_vf_ta = target_new(render3d_st, aw, ah, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR)
    render3d_st.ue_vf_tb = target_new(render3d_st, aw, ah, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR)
    render3d_st.ue_vf_ti = target_new(render3d_st, aw, ah, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR)
    return
  }
  render3d_st.ue_vf_fb_a = words(gz);  render3d_st.ue_vf_fb_b = words(gz);  render3d_st.ue_vf_fb_i = words(gz)
  render3d_st.ue_vf_a = ue_vf_array(render3d_st, gw, gh, gz, render3d_st.ue_vf_fb_a)
  render3d_st.ue_vf_b = ue_vf_array(render3d_st, gw, gh, gz, render3d_st.ue_vf_fb_b)
  render3d_st.ue_vf_i = ue_vf_array(render3d_st, gw, gh, gz, render3d_st.ue_vf_fb_i)
  render3d_st.ue_vf_carry_a = target_new(render3d_st, gw, gh, GPU_RGBA32F, GPU_RGBA, GPU_FLOAT, false, GPU_NEAREST)
  render3d_st.ue_vf_carry_b = target_new(render3d_st, gw, gh, GPU_RGBA32F, GPU_RGBA, GPU_FLOAT, false, GPU_NEAREST)
  render3d_st.ue_vf_fb_m = words(gz)
  for l in 0 .. gz {
    let fb = gpu_fb_new(render3d_st)
    gpu_fb_bind(render3d_st, fb)
    gpu_fb_color_layer(render3d_st, 0, render3d_st.ue_vf_i, l)
    if l % 2 == 0 { gpu_fb_color(render3d_st, 1, render3d_st.ue_vf_carry_a.color) } else { gpu_fb_color(render3d_st, 1, render3d_st.ue_vf_carry_b.color) }
    gpu_fb_draw_buffers(render3d_st, 2)
    render3d_st.ue_vf_fb_m[l] = fb
  }
  gpu_fb_bind(render3d_st, 0)
}
# the programs and the reprojection's matrix, once
@alloc_ok("made once per resource and kept for its life (a texture, program, sampler, view, layout or memory block is created when first asked for)")
function ue_vf_programs(render3d_st: mut Render3dState) -> void {
  if render3d_st.ue_vf_prev_vp == null { render3d_st.ue_vf_prev_vp = m4_new() }
  if render3d_st.ue_vf_ps == 0 {
    render3d_st.ue_vf_psa = r3d_program(render3d_st, "fullscreen.vert", "ue_volfog.frag", "#define VF_SCATTER\n#define VF_ATLAS\n")
    render3d_st.ue_vf_pia = r3d_program(render3d_st, "fullscreen.vert", "ue_volfog.frag", "#define VF_INTEGRATE\n#define VF_ATLAS\n")
    render3d_st.ue_vf_pcd = r3d_program(render3d_st, "fullscreen.vert", "ue_volfog.frag", "#define VF_CDEPTH_DOWN\n")
    render3d_st.ue_vf_ps = r3d_program(render3d_st, "fullscreen.vert", "ue_volfog.frag", "#define VF_SCATTER\n")
    render3d_st.ue_vf_pi = r3d_program(render3d_st, "fullscreen.vert", "ue_volfog.frag", "#define VF_INTEGRATE\n")
    render3d_st.ue_vf_pc = r3d_program(render3d_st, "fullscreen.vert", "ue_volfog.frag", "#define VF_CDEPTH\n")
    render3d_st.ue_vf_pm = r3d_program(render3d_st, "fullscreen.vert", "ue_volfog.frag", "#define VF_INTEGRATE\n#define VF_CARRY\n")
  }
}

# GetVolumetricFogGridZParams / CalculateGridZParams (NearOffset 0.095 m), into o (B, O, S)
function ue_vf_zparams(render3d_st: mut Render3dState, o: floats) -> void {
  let vf = r3d_volumetric_fog(render3d_st)
  let s = vf.depth_distribution_scale
  let n = render3d_st.cam_near + 0.095
  let f = Math.max(vf.distance, n + 0.01)
  let oo = (f - n * Math.pow(2.0, float(render3d_st.ue_vf_gz) / s)) / (f - n)
  let b = (1.0 - oo) / n
  v3_set(o, b, oo, s)
}

function ue_vf_common(render3d_st: mut Render3dState, p: int) -> void {
  let zp = render3d_st.ue_vf_zp
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "vf_grid"), float(render3d_st.ue_vf_gw), float(render3d_st.ue_vf_gh), float(render3d_st.ue_vf_gz))
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "vf_zp"), zp[0], zp[1], zp[2])
  u_mat4(render3d_st, gpu_uniform(render3d_st, p, "vf_inv_vp"), render3d_st.cam_inv_vp)
  u_v3(render3d_st, gpu_uniform(render3d_st, p, "vf_cam"), render3d_st.cam_pos)
  u_v3(render3d_st, gpu_uniform(render3d_st, p, "vf_fwd"), render3d_st.cam_fwd)
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "vf_screen"), float(render3d_st.post_w), float(render3d_st.post_h))
  u_f(render3d_st, gpu_uniform(render3d_st, p, "vf_pixel"), float(max(r3d_volumetric_fog(render3d_st).grid_pixel_size, 4)))
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "vf_tiles"), float(render3d_st.ue_vf_tx), float(render3d_st.ue_vf_ty))
}

# After the opaque scene, the water and the blended actors, before ue_fog_pass
function ue_volfog_pass(render3d_st: mut Render3dState) -> void {
  if not ue_volfog_on(render3d_st) or render3d_st.ue_ap == null { return }
  ue_vf_init(render3d_st)
  ue_vf_programs(render3d_st)
  let vf = r3d_volumetric_fog(render3d_st)
  if render3d_st.ue_vf_zp == null { render3d_st.ue_vf_zp = v3_new(0.0, 0.0, 0.0) }
  ue_vf_zparams(render3d_st, render3d_st.ue_vf_zp)
  prof_begin(render3d_st, "UE volumetric fog")
  gpu_depth_test(render3d_st, false)
  gpu_depth_write(render3d_st, false)
  gpu_blend(render3d_st, false)
  # this frame's grid and last frame's: the two swap
  var cur = render3d_st.ue_vf_a
  var cur_fb = render3d_st.ue_vf_fb_a
  var hist = render3d_st.ue_vf_b
  var cd = render3d_st.ue_vf_cd_a
  var cd_prev = render3d_st.ue_vf_cd_b
  var cur_t = render3d_st.ue_vf_ta
  var hist_t = render3d_st.ue_vf_tb
  if render3d_st.ue_vf_flip { cur = render3d_st.ue_vf_b;  cur_fb = render3d_st.ue_vf_fb_b;  hist = render3d_st.ue_vf_a;  cd = render3d_st.ue_vf_cd_b;  cd_prev = render3d_st.ue_vf_cd_a;  cur_t = render3d_st.ue_vf_tb;  hist_t = render3d_st.ue_vf_ta }
  let fg = r3d_height_fog(render3d_st)
  let sl = r3d_sky_light(render3d_st)
  # GenerateConservativeDepthBuffer: the tiles' furthest depth, from the depth's 4 x 4 furthest (as Unreal's reads an HZB level)
  var p = render3d_st.ue_vf_pcd
  if vf.conservative_depth {
    target_bind(render3d_st, render3d_st.ue_vf_cdq)
    gpu_use_program(render3d_st, p)
    r3d_bind_2d(render3d_st, p, "u_depth", 0, render3d_st.post_hdr.depth)
    mesh_draw(render3d_st, render3d_st.post_fs)
    p = render3d_st.ue_vf_pc
    target_bind(render3d_st, cd)
    gpu_use_program(render3d_st, p)
    ue_vf_common(render3d_st, p)
    r3d_bind_2d(render3d_st, p, "u_depth", 0, render3d_st.ue_vf_cdq.color)
    u_f(render3d_st, gpu_uniform(render3d_st, p, "vf_cd_down"), 4.0)
    mesh_draw(render3d_st, render3d_st.post_fs)
    prof_split(render3d_st, "UE volumetric fog scatter")
  }
  var cd_on = 0.0
  var cd_prev_on = 0.0
  if vf.conservative_depth { cd_on = 1.0;  if render3d_st.ue_vf_cd_ok { cd_prev_on = 1.0 } }
  p = render3d_st.ue_vf_ps
  if vf.atlas { p = render3d_st.ue_vf_psa }
  gpu_use_program(render3d_st, p)
  shadow_bind(render3d_st, p)
  sky_bind_lighting(render3d_st, p)
  ue_vf_common(render3d_st, p)
  r3d_bind_2d(render3d_st, p, "u_depth", 0, render3d_st.post_hdr.depth)
  if vf.atlas { r3d_bind_2d(render3d_st, p, "vf_hist", 1, hist_t.color) } else { r3d_bind_tex(render3d_st, p, "vf_hist", 1, GPU_TEX2D_ARRAY, hist) }
  r3d_bind_2d(render3d_st, p, "vf_cdepth", 2, cd.color)
  r3d_bind_2d(render3d_st, p, "vf_prev_cdepth", 3, cd_prev.color)
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "vf_cd_on"), cd_on, cd_prev_on)
  u_mat4(render3d_st, gpu_uniform(render3d_st, p, "vf_vp"), render3d_st.cam_vp)
  u_mat4(render3d_st, gpu_uniform(render3d_st, p, "vf_prev_vp"), render3d_st.ue_vf_prev_vp)
  var hist_on = 0.0
  if vf.temporal_reprojection and render3d_st.ue_vf_hist_ok and ue_vf_debug(render3d_st) < 0.5 { hist_on = 1.0 }
  u_f(render3d_st, gpu_uniform(render3d_st, p, "vf_hist_on"), hist_on)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "vf_hist_weight"), vf.history_weight)
  # VolumetricFogTemporalRandom: Halton (2, 3, 5) of the frame with jitter and reprojection, else the cell's centre
  render3d_st.ue_vf_frame += 1
  let fi = render3d_st.ue_vf_frame % 1024
  if vf.jitter and vf.temporal_reprojection {
    u_f3(render3d_st, gpu_uniform(render3d_st, p, "vf_jitter"), gsl_halton(fi, 2), gsl_halton(fi, 3), gsl_halton(fi, 5))
  } else {
    u_f3(render3d_st, gpu_uniform(render3d_st, p, "vf_jitter"), 0.5, 0.5, 0.5)
  }
  # the height fog's media, as ue_fog_params scales it (/ 10 per m), x MatchHeightFogFactor 0.5 x the extinction scale
  let height = render3d_st.r3d_fog_base + fg.height_offset
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "vf_fog"), fg.fog_density / 10.0, fg.fog_height_falloff / 10.0, height, 0.5 * vf.extinction_scale)
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "vf_fog2"), fg.second_fog_density / 10.0, fg.second_fog_height_falloff / 10.0, height + fg.second_fog_height_offset)
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "vf_albedo"), vf.albedo_r, vf.albedo_g, vf.albedo_b)
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "vf_emissive"), vf.emissive_r / 10000.0, vf.emissive_g / 10000.0, vf.emissive_b / 10000.0)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "vf_g"), Math.clamp(vf.scattering_distribution, -0.99, 0.99))
  let k = vf.sun_volumetric_scattering_intensity
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "vf_sun_color"), render3d_st.sun_color[0] * k, render3d_st.sun_color[1] * k, render3d_st.sun_color[2] * k)
  u_v3(render3d_st, gpu_uniform(render3d_st, p, "vf_sun_dir"), render3d_st.sun_dir)
  var sky_on = 0.0
  if ue_skylight_on(render3d_st) and render3d_st.ue_sl_ready and vf.sky_light_volumetric_scattering_intensity > 0.0 { sky_on = 1.0 }
  u_f(render3d_st, gpu_uniform(render3d_st, p, "vf_sky_on"), sky_on)
  let ks = sl.intensity * vf.sky_light_volumetric_scattering_intensity
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "vf_sky_color"), sl.light_color_r * ks, sl.light_color_g * ks, sl.light_color_b * ks)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "vf_center_offset"), vf.grid_center_offset_from_depth_buffer)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "vf_center_threshold"), vf.offset_threshold_to_accept_depth_buffer_offset)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "vf_debug"), ue_vf_debug(render3d_st))
  let gz = render3d_st.ue_vf_gz
  if vf.atlas {
    target_bind(render3d_st, cur_t)
    mesh_draw(render3d_st, render3d_st.post_fs)
  } else {
    for z in 0 .. gz {
      gpu_fb_bind(render3d_st, cur_fb[z])
      gpu_viewport(render3d_st, 0, 0, render3d_st.ue_vf_gw, render3d_st.ue_vf_gh)
      u_f(render3d_st, gpu_uniform(render3d_st, p, "vf_slice"), float(z))
      mesh_draw(render3d_st, render3d_st.post_fs)
    }
  }
  # FinalIntegrationCS, a slice at a time
  prof_split(render3d_st, "UE volumetric fog integrate")
  p = render3d_st.ue_vf_pi
  if vf.atlas { p = render3d_st.ue_vf_pia } else if vf.march { p = render3d_st.ue_vf_pm }
  gpu_use_program(render3d_st, p)
  ue_vf_common(render3d_st, p)
  if vf.atlas { r3d_bind_2d(render3d_st, p, "vf_scatter", 0, cur_t.color) } else { r3d_bind_tex(render3d_st, p, "vf_scatter", 0, GPU_TEX2D_ARRAY, cur) }
  var fade_inv = 100000000.0
  if vf.near_fade_in_distance > 0.0 { fade_inv = 1.0 / vf.near_fade_in_distance }
  u_f(render3d_st, gpu_uniform(render3d_st, p, "vf_fade_inv"), fade_inv)
  if vf.atlas {
    target_bind(render3d_st, render3d_st.ue_vf_ti)
    mesh_draw(render3d_st, render3d_st.post_fs)
  }
  for z in 0 .. gz {
    if vf.atlas { break }
    if vf.march {
      # slice z writes the carry z % 2 names and reads the other, the slice before's
      gpu_fb_bind(render3d_st, render3d_st.ue_vf_fb_m[z])
      var rd = render3d_st.ue_vf_carry_b
      if z % 2 == 1 { rd = render3d_st.ue_vf_carry_a }
      r3d_bind_2d(render3d_st, p, "vf_carry", 1, rd.color)
    } else {
      gpu_fb_bind(render3d_st, render3d_st.ue_vf_fb_i[z])
    }
    gpu_viewport(render3d_st, 0, 0, render3d_st.ue_vf_gw, render3d_st.ue_vf_gh)
    u_f(render3d_st, gpu_uniform(render3d_st, p, "vf_slice"), float(z))
    mesh_draw(render3d_st, render3d_st.post_fs)
  }
  gpu_fb_bind(render3d_st, 0)
  for i in 0 .. 16 { render3d_st.ue_vf_prev_vp[i] = render3d_st.cam_vp[i] }
  render3d_st.ue_vf_flip = not render3d_st.ue_vf_flip
  render3d_st.ue_vf_hist_ok = true
  render3d_st.ue_vf_cd_ok = vf.conservative_depth
  render3d_st.ue_vf_ready = true
  prof_end(render3d_st)
}

# the fog pass's volume uniforms (ue_fog.frag): uf_vol_on 0 when the volume is not running
function ue_volfog_bind(render3d_st: mut Render3dState, p: int) -> void {
  var on = 0.0
  if ue_volfog_on(render3d_st) and render3d_st.ue_vf_ready { on = 1.0 }
  u_f(render3d_st, gpu_uniform(render3d_st, p, "uf_vol_on"), on)
  if on < 0.5 { return }
  let vf = r3d_volumetric_fog(render3d_st)
  let zp = render3d_st.ue_vf_zp
  let px = float(max(vf.grid_pixel_size, 4))
  # the debug view shows this frame's scattering grid (the shadow factor) rather than the integrated one
  if vf.atlas {
    var volt = render3d_st.ue_vf_ti
    if ue_vf_debug(render3d_st) > 0.5 { volt = render3d_st.ue_vf_ta;  if not render3d_st.ue_vf_flip { volt = render3d_st.ue_vf_tb } }
    r3d_bind_2d(render3d_st, p, "uf_vol", 3, volt.color)
    u_f2(render3d_st, gpu_uniform(render3d_st, p, "uf_vol_tiles"), float(render3d_st.ue_vf_tx), float(render3d_st.ue_vf_ty))
  } else {
    var vol = render3d_st.ue_vf_i
    if ue_vf_debug(render3d_st) > 0.5 { vol = render3d_st.ue_vf_a;  if not render3d_st.ue_vf_flip { vol = render3d_st.ue_vf_b } }
    r3d_bind_tex(render3d_st, p, "uf_vol", 3, GPU_TEX2D_ARRAY, vol)
  }
  u_f(render3d_st, gpu_uniform(render3d_st, p, "uf_vol_debug"), ue_vf_debug(render3d_st))
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "uf_vol_grid"), float(render3d_st.ue_vf_gw), float(render3d_st.ue_vf_gh), float(render3d_st.ue_vf_gz))
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "uf_vol_zp"), zp[0], zp[1], zp[2])
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "uf_vol_uv"), float(render3d_st.post_w) / (float(render3d_st.ue_vf_gw) * px), float(render3d_st.post_h) / (float(render3d_st.ue_vf_gh) * px))
  u_f(render3d_st, gpu_uniform(render3d_st, p, "uf_vol_dist"), vf.distance)
  u_v3(render3d_st, gpu_uniform(render3d_st, p, "uf_fwd"), render3d_st.cam_fwd)
}

# the fog pass's program reads the grid as an atlas (ue_fog.frag VF_ATLAS)
function ue_volfog_atlas(render3d_st: mut Render3dState) -> bool { return r3d_volumetric_fog(render3d_st).atlas }

# R3D_UE_VOLFOG_DEBUG=1: the grid's sun shadow factor alone, shown at each pixel's depth in place of the scene (ue_fog.frag)
function ue_vf_debug(render3d_st: mut Render3dState) -> float {
  if r3d_env_has(render3d_st, "R3D_UE_VOLFOG_DEBUG") and r3d_env(render3d_st, "R3D_UE_VOLFOG_DEBUG") == "1" { return 1.0 }
  return 0.0
}
