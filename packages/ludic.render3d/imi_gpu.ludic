# ============================================================================
# imi_gpu.ludic - interior mapping's uniforms: a row of InteriorAtlases (interior_atlas.ludic) and its image, bound to a
# kit program built with INTERIOR_MAP (kit.frag). The rules live in imi.ludic and in the shader; this only hands over
# the numbers.
# ============================================================================

# the atlas image as a texture, from the game's assets directory (the row's `image` is relative to it); 0 if it will not load
export function imi_load(render3d_st: mut Render3dState, ia: InteriorAtlas, assets_dir: string) -> int {
  if ia.image == "" { return 0 }
  let was = render3d_st.gvk_tag
  render3d_st.gvk_tag = VKM_TEXTURE
  let t = tex_load(render3d_st, `{assets_dir}/{ia.image}`, true)
  render3d_st.gvk_tag = was
  return t
}

# bind the rooms and the window numbers to program `p` (unit 3 holds the atlas)
export function imi_bind(render3d_st: mut Render3dState, p: int, ia: InteriorAtlas, tex: int, win_w: float, win_h: float) -> void {
  gpu_ul_bind_2d(render3d_st, p, UL_ROOMS, 3, tex)
  u_f4(render3d_st, gpu_ul(render3d_st, p, UL_IM_CELL), win_w, win_h, ia.frame, ia.depth)
  u_f4(render3d_st, gpu_ul(render3d_st, p, UL_IM_ATLAS), float(ia.cols), float(ia.rows), float(min(ia.rooms, ia.cols * ia.rows)), ia.night_lit)
  # a room face's texel in metres is about its window cell over a third of the tile's width in texels; the atlas is
  # read at a mip chosen from it, so the face size stays a constant here rather than a per-texture query
  u_f4(render3d_st, gpu_ul(render3d_st, p, UL_IM_GAIN), ia.lit_gain, ia.dark_gain, ia.curtain, win_w / 256.0)
  u_f3(render3d_st, gpu_ul(render3d_st, p, UL_IM_LIT), ia.lit_r, ia.lit_g, ia.lit_b)
}
