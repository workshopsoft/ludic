# ============================================================================
# tilemap_lwt.ludic - the baked mesh of a tile (LWT1): what tilemap_bake.ludic writes and the game streams. A tile is cut
# into patches (tilemap.ludic), every patch into its levels of detail, every level a grid of heights and normals on
# cell corners. This file is the FORMAT: how a file is laid out, how its header is checked against the map's row (a
# file baked for other numbers is refused, never drawn wrong), how a patch's level is read, and how the grid a file
# holds becomes the vertices and indices a mesh takes (the decode: positions from the grid, the normal unpacked, the skirt
# hung from the edge). Nothing is decided here: the heights, the levels and the normals were the bake's.
#
#   <tile>.lwt, little-endian
#   0    magic "LWT1", version 1 (2 when a level is a LOCKED mesh, below)
#   8    res, patch_texels, patches (a tile's side), levels (lod_max + 1), tx, tz          (u32)
#   32   tile_size, height_min, height_max, height_offset, origin_x, origin_z              (f32: the row's numbers)
#   56   the table's offset (64), the entry size in words (4)
#   64   the table: for pz, then px, then lod: { the level's offset in the file, its lowest height and its highest (f32), kind }
#   then each level: (cells + 1)^2 vertices, row by row along +z, each 4 bytes
#        height u16 (0 = height_offset + height_min, 65535 = height_offset + height_max), nx u8, nz u8 (-1 .. 1 over 0 .. 255)
#   cells = patch_texels >> lod; the vertex (a, b) is at the patch's corner + (a, b) * (patch size / cells), the normal's y whatever
#   makes it a unit vector. That is a level of kind 0 (every version 1 file).
#   A level of kind 1 is a LOCKED mesh (the terrain LOD lock, tilemap_bake.ludic): the level's grid with some cells cut down,
#   as far as level 0's, where its triangles would move the ground under a locked texel (a road, a pad, a shore):
#        nv, nt, np (u32); nv vertices { a u16, b u16 (on level 0's grid), height u16, nx u8, nz u8 }; nt triangles (3 u32
#        vertex indices, wound as the grid's); np perimeter vertices (u32 indices) in the skirt's order (lwt_perimeter's)
#   A level of kind 2 is the same locked mesh, COMPACT (version 3 files): the cut as a quadtree and the heights alone, so a
#   locked level costs what a grid does a vertex. nv, nbits, nhole (u32); the split bits, one a cell of more than one texel,
#   depth first: for each of the level's own cells (row by row along +z) 1 when it is split (then its quarters at low x low z,
#   high x low z, low x high z, high x high z, each the same way) or 0 when it is a cell of the mesh, bit k in byte k / 8 at
#   (k % 8), the bytes padded to a word; then, when nhole is not 0, a bit for each cell of the mesh in the same order, 1 for a
#   HOLE (no triangles: tilemap_bake.ludic's hole classes), padded to a word; then nv vertices { height u16, nx u8, nz u8 },
#   every corner of a cell of the mesh, in level 0's grid order (row by row along +z). The reader makes the triangles as the bake did: each cell a fan from its
#   high-x low-z corner over the corners of its finer neighbours on its edges (lwt_ring), the perimeter in the skirt's order.
# ============================================================================
numbers float

const LWT_MAGIC: int = 0x3154574C     # "LWT1"
const LWT_HEAD: int = 64
const LWT_ENTRY: int = 4              # words a table entry

# the vertex a mesh takes: position (x, z from the patch's centre, y the height), normal, uv
const TM_VERT: int = 8

export property TmMeshes {
  mslots: int = 0
  slot_tile: words = null           # the tile whose table a slot holds, -1 free
  slot_used: words = null
  slot_of: words = null             # per tile: its slot, -1 not read, -2 no usable file
  tab: words = null                 # mslots x entries x LWT_ENTRY
  entries: int = 0                  # table entries a tile: patches^2 x levels
  clock: int = 0
  raw: []byte = null                # one level's bytes as read
  vbuf: floats = null               # the level's vertices, expanded (TM_VERT floats each, made for level 0)
  ibuf: words = null                # its indices
  nv: int = 0
  ni: int = 0
  idx: []words = null               # the index list of each level, made once (the topology: a grid and a skirt)
  idx_n: words = null
  locked: bool = false              # the level expanded last is a locked mesh: its own indices (lix) and vertex grid places
  lix: words = null                 # a locked level's indices, grid and skirt
  vga: words = null                 # a locked level's vertices: their place on level 0's grid (a, b)
  vgb: words = null
  per: words = null                 # a locked level's perimeter: its vertex indices in the skirt's order
  np: int = 0
  here: words = null                # a compact level (kind 2) being read: 1 for a level 0 grid point that is a vertex
  vid: words = null                 # its vertex index
  cx: words = null                  # its cells: low corner on level 0's grid and side
  cz: words = null
  cs: words = null
  chole: words = null               # its cells' hole flags
  ring: words = null                # one cell's boundary points
  stale: int = 0                    # files refused for another row's numbers or another cut
  no_file: int = 0
  reads: int = 0
  uv_per_tile: float = 1.0
}

function lwt_entries(tm: TileMap) -> int { return tm.patches * tm.patches * (tm.lod_max + 1) }
# the table entry of (px, pz, lod)
function lwt_entry(tm: TileMap, px: int, pz: int, lod: int) -> int { return (pz * tm.patches + px) * (tm.lod_max + 1) + lod }

# the file's bytes for a header, from the map's row and the tile: what the bake writes and the reader checks against
export function lwt_head_put(b: []byte, tm: TileMap, tx: int, tz: int) -> void {
  lw_put32(b, 0, LWT_MAGIC);  lw_put32(b, 4, 1)
  lw_put32(b, 8, tm.res);  lw_put32(b, 12, tm.patch_texels);  lw_put32(b, 16, tm.patches);  lw_put32(b, 20, tm.lod_max + 1)
  lw_put32(b, 24, tx);  lw_put32(b, 28, tz)
  lw_putf(b, 32, tm.tile_size);  lw_putf(b, 36, tm.h_min);  lw_putf(b, 40, tm.h_max);  lw_putf(b, 44, tm.h_off)
  lw_putf(b, 48, tm.origin_x);  lw_putf(b, 52, tm.origin_z)
  lw_put32(b, 56, LWT_HEAD);  lw_put32(b, 60, LWT_ENTRY)
}

# is this header a mesh of tile (tx, tz) baked for this map's numbers and this cut?
export function lwt_head_ok(b: []byte, tm: TileMap, tx: int, tz: int) -> bool {
  if len(b) < LWT_HEAD or lw_get32(b, 0) != LWT_MAGIC or lw_get32(b, 4) < 1 or lw_get32(b, 4) > 3 { return false }
  if lw_get32(b, 8) != tm.res or lw_get32(b, 12) != tm.patch_texels or lw_get32(b, 16) != tm.patches or lw_get32(b, 20) != tm.lod_max + 1 { return false }
  if lw_get32(b, 24) != tx or lw_get32(b, 28) != tz or lw_get32(b, 56) != LWT_HEAD or lw_get32(b, 60) != LWT_ENTRY { return false }
  return lw_getf(b, 32) == tm.tile_size and lw_getf(b, 36) == tm.h_min and lw_getf(b, 40) == tm.h_max and lw_getf(b, 44) == tm.h_off and lw_getf(b, 48) == tm.origin_x and lw_getf(b, 52) == tm.origin_z
}

# the reader's pool: tables for `slots` tiles and the scratch one level is read and expanded in, and every level's indices
@alloc_ok("a map being opened: the pool and the scratch are made once")
export function tmm_new(tm: TileMap, slots: int) -> TmMeshes {
  let ms = new TmMeshes
  ms.mslots = min(max(slots, 1), tm.cols * tm.rows)
  ms.entries = lwt_entries(tm)
  ms.slot_tile = words(ms.mslots);  ms.slot_used = words(ms.mslots)
  for s in 0 .. ms.mslots { ms.slot_tile[s] = -1;  ms.slot_used[s] = 0 }
  ms.slot_of = words(tm.cols * tm.rows)
  for t in 0 .. tm.cols * tm.rows { ms.slot_of[t] = -1 }
  ms.tab = words(ms.mslots * ms.entries * LWT_ENTRY)
  let c0 = tm.patch_texels
  ms.raw = buffer(lwt_locked_max(c0))
  ms.vbuf = floats(tmap_patch_verts(c0) * TM_VERT)
  ms.idx = new []words
  ms.idx_n = words(tm.lod_max + 1)
  for l in 0 .. tm.lod_max + 1 {
    let c = tm.patch_texels >> l
    let ix = words(tmap_patch_tris(c) * 3)
    ms.idx_n[l] = lwt_topology(c, ix)
    push(ms.idx, ix)
  }
  ms.ibuf = ms.idx[0]
  ms.lix = words(lwt_locked_tris(c0) * 3)
  ms.vga = words((c0 + 1) * (c0 + 1));  ms.vgb = words((c0 + 1) * (c0 + 1))
  ms.per = words(4 * c0)
  ms.here = words((c0 + 1) * (c0 + 1));  ms.vid = words((c0 + 1) * (c0 + 1))
  ms.cx = words(c0 * c0 + 64);  ms.cz = words(c0 * c0 + 64);  ms.cs = words(c0 * c0 + 64)   # the cells, and a stack at the top
  ms.chole = words(c0 * c0 + 64)
  ms.ring = words(4 * c0 + 4)
  return ms
}

# Cell (x0, z0, side s)'s boundary points on a grid n0 points a side into `ring`: every point that is a vertex (here[g] == 1),
# from its high-x low-z corner up the high-x edge, back along the high-z edge, down the low-x edge and along the low-z edge;
# how many. The bake and the reader of a locked level fan each cell over these, from ring[0].
export function lwt_ring(here: words, n0: int, x0: int, z0: int, s: int, ring: words) -> int {
  var n = 0
  for t in 0 .. s { let g = (z0 + t) * n0 + x0 + s;  if here[g] == 1 { ring[n] = g;  n += 1 } }
  for t in 0 .. s { let g = (z0 + s) * n0 + x0 + s - t;  if here[g] == 1 { ring[n] = g;  n += 1 } }
  for t in 0 .. s { let g = (z0 + s - t) * n0 + x0;  if here[g] == 1 { ring[n] = g;  n += 1 } }
  for t in 0 .. s { let g = z0 * n0 + x0 + t;  if here[g] == 1 { ring[n] = g;  n += 1 } }
  return n
}

# twice the signed area of the triangle of grid points g0 g1 g2 in (x, z): negative is the grid's winding, 0 degenerate
export function lwt_cross(n0: int, g0: int, g1: int, g2: int) -> int {
  let ax = g1 % n0 - g0 % n0;  let az = g1 / n0 - g0 / n0
  let bx = g2 % n0 - g0 % n0;  let bz = g2 / n0 - g0 / n0
  return ax * bz - az * bx
}

# the bytes of a compact level's split bits for `nbits` bits: padded to a word
export function lwt_bits_bytes(nbits: int) -> int { return ((nbits + 31) / 32) * 4 }

# a locked level of a c0-texel patch at most: its triangles (the grid's, 2 V - B - 2 for V vertices, and the skirt's) and bytes
export function lwt_locked_tris(c0: int) -> int { return 2 * (c0 + 1) * (c0 + 1) + 8 * c0 }
export function lwt_locked_max(c0: int) -> int { return 12 + (c0 + 1) * (c0 + 1) * 8 + 2 * (c0 + 1) * (c0 + 1) * 12 + 4 * c0 * 4 }

# is patch (px, pz)'s level `lod` of the tile in `slot` a locked mesh?
export function tmm_locked(ms: TmMeshes, tm: TileMap, slot: int, px: int, pz: int, lod: int) -> bool {
  return ms.tab[(slot * ms.entries + lwt_entry(tm, px, pz, lod)) * LWT_ENTRY + 3] != 0
}

# the grid index of perimeter point p of a c-cell patch: along the low-z edge, up the high-x edge, back along the high-z edge,
# down the low-x edge
function lwt_perimeter(c: int, p: int) -> int {
  let n1 = c + 1
  if p < c { return p }
  if p < 2 * c { return (p - c) * n1 + c }
  if p < 3 * c { return c * n1 + (c - (p - 2 * c)) }
  return (c - (p - 3 * c)) * n1
}

# the triangles of a c-cell patch into `idx`: the grid's two a cell, then the skirt's two a perimeter edge; how many indices
function lwt_topology(c: int, idx: words) -> int {
  let n1 = c + 1
  let sk = n1 * n1
  var k = 0
  for b in 0 .. c {
    for a in 0 .. c {
      let g = b * n1 + a
      idx[k] = g;  idx[k + 1] = g + n1;  idx[k + 2] = g + 1
      idx[k + 3] = g + 1;  idx[k + 4] = g + n1;  idx[k + 5] = g + n1 + 1
      k += 6
    }
  }
  for p in 0 .. 4 * c {
    let q = (p + 1) % (4 * c)
    let g0 = lwt_perimeter(c, p)
    let g1 = lwt_perimeter(c, q)
    idx[k] = g0;  idx[k + 1] = g1;  idx[k + 2] = sk + p
    idx[k + 3] = g1;  idx[k + 4] = sk + q;  idx[k + 5] = sk + p
    k += 6
  }
  return k
}

# Tile (tx, tz)'s table read into the pool: its slot; -2 when it has no file or one baked for other numbers (known from
# now on, so it is asked for once); -1 when the pool holds nothing it may let go of (a tile wanted this frame stays).
# A load: the header and table are read here.
@alloc_ok("a tile's table being read: its file, once")
export function tmm_load(ms: TmMeshes, tm: TileMap, tx: int, tz: int) -> int {
  let t = tz * tm.cols + tx
  if tx < 0 or tz < 0 or tx >= tm.cols or tz >= tm.rows { return -2 }
  if ms.slot_of[t] >= 0 { ms.slot_used[ms.slot_of[t]] = ms.clock;  return ms.slot_of[t] }
  if ms.slot_of[t] == -2 { return -2 }
  var s = -1
  for k in 0 .. ms.mslots {
    if ms.slot_tile[k] < 0 { s = k;  break }
    if ms.slot_used[k] != ms.clock and (s < 0 or ms.slot_used[k] < ms.slot_used[s]) { s = k }
  }
  if s < 0 { return -1 }
  let path = tmap_mesh_path(tm, tx, tz)
  let f = file_open(path, "rb")
  if f == null { free(path);  ms.slot_of[t] = -2;  ms.no_file += 1;  return -2 }
  let n = LWT_HEAD + ms.entries * LWT_ENTRY * 4
  let b = buffer(n)
  let got = file_read(f, data_of(b), n)
  file_close(f)
  if got != n or not lwt_head_ok(b, tm, tx, tz) {
    print(`tilemap: {path} was baked for other numbers or another cut (or is cut short): bake the terrain again`)
    free(path);  free(b)
    ms.slot_of[t] = -2;  ms.stale += 1
    return -2
  }
  free(path)
  if ms.slot_tile[s] >= 0 { ms.slot_of[ms.slot_tile[s]] = -1 }
  for i in 0 .. ms.entries * LWT_ENTRY { ms.tab[s * ms.entries * LWT_ENTRY + i] = lw_get32(b, LWT_HEAD + i * 4) }
  free(b)
  ms.slot_tile[s] = t
  ms.slot_used[s] = ms.clock
  ms.slot_of[t] = s
  return s
}

# a patch level's lowest and highest ground, from a loaded table
export function tmm_ymin(ms: TmMeshes, tm: TileMap, slot: int, px: int, pz: int, lod: int) -> float {
  return float_from_bits(ms.tab[(slot * ms.entries + lwt_entry(tm, px, pz, lod)) * LWT_ENTRY + 1])
}
export function tmm_ymax(ms: TmMeshes, tm: TileMap, slot: int, px: int, pz: int, lod: int) -> float {
  return float_from_bits(ms.tab[(slot * ms.entries + lwt_entry(tm, px, pz, lod)) * LWT_ENTRY + 2])
}

# Patch (px, pz) of the tile in `slot` at `lod`, read from its file and expanded into the scratch (vbuf, ibuf, nv, ni): the
# grid's vertices with positions from the patch's corner (x and z from its centre, y the height less `lift`), the normal
# unpacked, the uv, and the skirt. false when the file cannot be read. Allocates nothing.
export function tmm_patch(ms: TmMeshes, tm: TileMap, slot: int, tx: int, tz: int, px: int, pz: int, lod: int, lift: float) -> bool {
  let c = tm.patch_texels >> lod
  let n1 = c + 1
  let at = ms.tab[(slot * ms.entries + lwt_entry(tm, px, pz, lod)) * LWT_ENTRY]
  let path = tmap_mesh_path(tm, tx, tz)
  let f = file_open(path, "rb")
  free(path)
  if f == null { return false }
  file_seek(f, at, 0)
  let kind = ms.tab[(slot * ms.entries + lwt_entry(tm, px, pz, lod)) * LWT_ENTRY + 3]
  if kind == 2 { return tmm_compact_patch(ms, tm, f, tx, tz, px, pz, lod, lift) }
  if kind == 1 { return tmm_locked_patch(ms, tm, f, tx, tz, px, pz, lod, lift) }
  ms.locked = false
  let got = file_read(f, data_of(ms.raw), n1 * n1 * 4)
  file_close(f)
  if got != n1 * n1 * 4 { return false }
  ms.reads += 1
  let size = tmap_patch_size(tm)
  let cell = size / float(c)
  let drop = 2.0 * cell + tm.skirt
  let raw = ms.raw
  let v = ms.vbuf
  for b in 0 .. n1 {
    for a in 0 .. n1 {
      let i = b * n1 + a
      let q = int(raw[i * 4]) | (int(raw[i * 4 + 1]) << 8)
      let nx = float(raw[i * 4 + 2]) / 255.0 * 2.0 - 1.0
      let nz = float(raw[i * 4 + 3]) / 255.0 * 2.0 - 1.0
      let ny = Math.sqrt(Math.max(1.0 - nx * nx - nz * nz, 0.0))
      let x = float(a) * cell - size * 0.5
      let z = float(b) * cell - size * 0.5
      let wx = tmap_patch_cx(tm, tx, px) + x
      let wz = tmap_patch_cz(tm, tz, pz) + z
      lwt_vert(v, i, x, tm.h_off + tm.h_min + float(q) * tm.step - lift, z, nx, ny, nz, (wx - tm.origin_x) / tm.tile_size * ms.uv_per_tile, (wz - tm.origin_z) / tm.tile_size * ms.uv_per_tile)
    }
  }
  let sk = n1 * n1
  for p in 0 .. 4 * c {
    let o = lwt_perimeter(c, p) * TM_VERT
    lwt_vert(v, sk + p, v[o], v[o + 1] - drop, v[o + 2], v[o + 3], v[o + 4], v[o + 5], v[o + 6], v[o + 7])
  }
  ms.nv = sk + 4 * c
  ms.ibuf = ms.idx[lod]
  ms.ni = ms.idx_n[lod]
  return true
}

# a locked level (kind 1) from the open file `f` (at its offset) into the scratch: its vertices where the bake put them on
# level 0's grid, its own triangles, and the skirt hung from its perimeter. Closes `f`. Allocates nothing.
function tmm_locked_patch(ms: TmMeshes, tm: TileMap, f: pointer, tx: int, tz: int, px: int, pz: int, lod: int, lift: float) -> bool {
  let c0 = tm.patch_texels
  let raw = ms.raw
  var got = file_read(f, data_of(raw), 12)
  let nv = lw_get32(raw, 0)
  let nt = lw_get32(raw, 4)
  let np = lw_get32(raw, 8)
  if got != 12 or nv < 3 or nv > (c0 + 1) * (c0 + 1) or np < 4 or np > 4 * c0 or nt < 1 or (nt + 2 * np) > lwt_locked_tris(c0) { file_close(f);  return false }
  let body = nv * 8 + nt * 12 + np * 4
  got = file_read(f, data_of(raw), body)
  file_close(f)
  if got != body { return false }
  ms.reads += 1
  let size = tmap_patch_size(tm)
  let tex = size / float(c0)
  let drop = 2.0 * size / float(c0 >> lod) + tm.skirt
  let v = ms.vbuf
  for i in 0 .. nv {
    let o = i * 8
    let a = int(raw[o]) | (int(raw[o + 1]) << 8)
    let b = int(raw[o + 2]) | (int(raw[o + 3]) << 8)
    let q = int(raw[o + 4]) | (int(raw[o + 5]) << 8)
    if a > c0 or b > c0 { return false }
    let nx = float(raw[o + 6]) / 255.0 * 2.0 - 1.0
    let nz = float(raw[o + 7]) / 255.0 * 2.0 - 1.0
    let ny = Math.sqrt(Math.max(1.0 - nx * nx - nz * nz, 0.0))
    let x = float(a) * tex - size * 0.5
    let z = float(b) * tex - size * 0.5
    let wx = tmap_patch_cx(tm, tx, px) + x
    let wz = tmap_patch_cz(tm, tz, pz) + z
    ms.vga[i] = a;  ms.vgb[i] = b
    lwt_vert(v, i, x, tm.h_off + tm.h_min + float(q) * tm.step - lift, z, nx, ny, nz, (wx - tm.origin_x) / tm.tile_size * ms.uv_per_tile, (wz - tm.origin_z) / tm.tile_size * ms.uv_per_tile)
  }
  let ix = ms.lix
  var k = 0
  let t0 = nv * 8
  for t in 0 .. nt * 3 {
    let vi = lw_get32(raw, t0 + t * 4)
    if vi < 0 or vi >= nv { return false }
    ix[k] = vi;  k += 1
  }
  let p0 = t0 + nt * 12
  for p in 0 .. np {
    let vi = lw_get32(raw, p0 + p * 4)
    if vi < 0 or vi >= nv { return false }
    ms.per[p] = vi
  }
  for p in 0 .. np {
    let o = ms.per[p] * TM_VERT
    lwt_vert(v, nv + p, v[o], v[o + 1] - drop, v[o + 2], v[o + 3], v[o + 4], v[o + 5], v[o + 6], v[o + 7])
  }
  for p in 0 .. np {
    let q = (p + 1) % np
    let g0 = ms.per[p]
    let g1 = ms.per[q]
    ix[k] = g0;  ix[k + 1] = g1;  ix[k + 2] = nv + p
    ix[k + 3] = g1;  ix[k + 4] = nv + q;  ix[k + 5] = nv + p
    k += 6
  }
  ms.nv = nv + np
  ms.np = np
  ms.ibuf = ix
  ms.ni = k
  ms.locked = true
  return true
}

# a compact locked level (kind 2) from the open file `f` (at its offset) into the scratch: the cells from the split bits, the
# vertices on their corners in grid order, each cell's fan (lwt_ring) wound as the grid's triangles, the perimeter and the
# skirt, as tmm_locked_patch leaves them. Closes `f`. Allocates nothing.
function tmm_compact_patch(ms: TmMeshes, tm: TileMap, f: pointer, tx: int, tz: int, px: int, pz: int, lod: int, lift: float) -> bool {
  let c0 = tm.patch_texels
  let n0 = c0 + 1
  let raw = ms.raw
  var got = file_read(f, data_of(raw), 12)
  let nv = lw_get32(raw, 0)
  let nbits = lw_get32(raw, 4)
  let nhole = lw_get32(raw, 8)
  if got != 12 or nv < 4 or nv > n0 * n0 or nbits < 0 or nbits > c0 * c0 or nhole < 0 or nhole > c0 * c0 { file_close(f);  return false }
  let bb = lwt_bits_bytes(nbits)
  let hb = lwt_bits_bytes(nhole)
  let body = bb + hb + nv * 4
  got = file_read(f, data_of(raw), body)
  file_close(f)
  if got != body { return false }
  ms.reads += 1
  # the cells: the level's own, split depth first as the bits say (a stack in cx/cz/cs from the top: the last pushed is next)
  for g in 0 .. n0 * n0 { ms.here[g] = 0 }
  let s0 = 1 << lod
  let top = c0 / s0
  var nc = 0
  let cap0 = len(ms.cs)
  var sp = cap0
  var bit = 0
  for b in 0 .. top {
    for a in 0 .. top {
      sp -= 1
      ms.cx[sp] = a * s0;  ms.cz[sp] = b * s0;  ms.cs[sp] = s0
      while sp < cap0 {
        let x0 = ms.cx[sp];  let z0 = ms.cz[sp];  let s = ms.cs[sp]
        sp += 1
        var split = false
        if s > 1 {
          if bit >= nbits { return false }
          split = ((int(raw[bit / 8]) >> (bit % 8)) & 1) == 1
          bit += 1
        }
        if split {
          let h = s / 2
          if sp - 4 < nc { return false }
          # pushed in reverse so they come off in order: low x low z, high x low z, low x high z, high x high z
          sp -= 1;  ms.cx[sp] = x0 + h;  ms.cz[sp] = z0 + h;  ms.cs[sp] = h
          sp -= 1;  ms.cx[sp] = x0;  ms.cz[sp] = z0 + h;  ms.cs[sp] = h
          sp -= 1;  ms.cx[sp] = x0 + h;  ms.cz[sp] = z0;  ms.cs[sp] = h
          sp -= 1;  ms.cx[sp] = x0;  ms.cz[sp] = z0;  ms.cs[sp] = h
          continue
        }
        if nc >= sp { return false }
        ms.cx[nc] = x0;  ms.cz[nc] = z0;  ms.cs[nc] = s
        ms.chole[nc] = 0
        if nhole > 0 {
          if nc >= nhole { return false }
          ms.chole[nc] = (int(raw[bb + nc / 8]) >> (nc % 8)) & 1
        }
        nc += 1
        ms.here[z0 * n0 + x0] = 1;  ms.here[z0 * n0 + x0 + s] = 1
        ms.here[(z0 + s) * n0 + x0] = 1;  ms.here[(z0 + s) * n0 + x0 + s] = 1
      }
    }
  }
  if bit != nbits or (nhole > 0 and nc != nhole) { return false }
  let size = tmap_patch_size(tm)
  let tex = size / float(c0)
  let drop = 2.0 * size / float(c0 >> lod) + tm.skirt
  let v = ms.vbuf
  var i = 0
  for g in 0 .. n0 * n0 {
    if ms.here[g] != 1 { ms.vid[g] = -1;  continue }
    if i >= nv { return false }
    let o = bb + hb + i * 4
    let a = g % n0
    let b = g / n0
    let q = int(raw[o]) | (int(raw[o + 1]) << 8)
    let nx = float(raw[o + 2]) / 255.0 * 2.0 - 1.0
    let nz = float(raw[o + 3]) / 255.0 * 2.0 - 1.0
    let ny = Math.sqrt(Math.max(1.0 - nx * nx - nz * nz, 0.0))
    let x = float(a) * tex - size * 0.5
    let z = float(b) * tex - size * 0.5
    let wx = tmap_patch_cx(tm, tx, px) + x
    let wz = tmap_patch_cz(tm, tz, pz) + z
    ms.vga[i] = a;  ms.vgb[i] = b
    ms.vid[g] = i
    lwt_vert(v, i, x, tm.h_off + tm.h_min + float(q) * tm.step - lift, z, nx, ny, nz, (wx - tm.origin_x) / tm.tile_size * ms.uv_per_tile, (wz - tm.origin_z) / tm.tile_size * ms.uv_per_tile)
    i += 1
  }
  if i != nv { return false }
  let ix = ms.lix
  let cap = len(ix)
  var k = 0
  for c in 0 .. nc {
    if ms.chole[c] == 1 { continue }
    let n = lwt_ring(ms.here, n0, ms.cx[c], ms.cz[c], ms.cs[c], ms.ring)
    let g0 = ms.ring[0]
    for r in 1 .. n - 1 {
      let g1 = ms.ring[r];  let g2 = ms.ring[r + 1]
      let w = lwt_cross(n0, g0, g1, g2)
      if w == 0 { continue }
      if k + 3 > cap { return false }
      ix[k] = ms.vid[g0]
      if w > 0 { ix[k + 1] = ms.vid[g2];  ix[k + 2] = ms.vid[g1] } else { ix[k + 1] = ms.vid[g1];  ix[k + 2] = ms.vid[g2] }
      k += 3
    }
  }
  var np = 0
  for p in 0 .. 4 * c0 {
    let g = lwt_perimeter(c0, p)
    if ms.here[g] == 1 { ms.per[np] = ms.vid[g];  np += 1 }
  }
  if k + 6 * np > cap { return false }
  for p in 0 .. np {
    let o = ms.per[p] * TM_VERT
    lwt_vert(v, nv + p, v[o], v[o + 1] - drop, v[o + 2], v[o + 3], v[o + 4], v[o + 5], v[o + 6], v[o + 7])
  }
  for p in 0 .. np {
    let q = (p + 1) % np
    let g0 = ms.per[p]
    let g1 = ms.per[q]
    ix[k] = g0;  ix[k + 1] = g1;  ix[k + 2] = nv + p
    ix[k + 3] = g1;  ix[k + 4] = nv + q;  ix[k + 5] = nv + p
    k += 6
  }
  ms.nv = nv + np
  ms.np = np
  ms.ibuf = ix
  ms.ni = k
  ms.locked = true
  return true
}

function lwt_vert(v: floats, i: int, x: float, y: float, z: float, nx: float, ny: float, nz: float, u: float, w: float) -> void {
  let o = i * TM_VERT
  v[o] = x;  v[o + 1] = y;  v[o + 2] = z
  v[o + 3] = nx;  v[o + 4] = ny;  v[o + 5] = nz
  v[o + 6] = u;  v[o + 7] = w
}
