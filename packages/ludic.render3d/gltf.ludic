# ============================================================================
# gltf.ludic — a glTF 2.0 loader for scanned models: one named node's mesh,
# each primitive uploaded straight from the .bin (positions, normals, uvs,
# indices) with its baseColor / normal / ARM textures. Only the byte ranges the
# node needs are read, so a 500 MB scan library costs what one tree costs.
# ============================================================================

property Prim {
  @owns(Mesh) mesh: Mesh,
  diff: int = 0,
  nrm:  int = 0,
  arm:  int = 0,
  verts: int = 0,       # vertices in the mesh (each attribute buffer holds this many)
  name: string,         # the material's name (a part to tint: "hk_jacket")
  fac: floats,          # the material's factors, or null (all 1, no emission): base r g b a, roughness, metallic, emissive r g b
  ext: floats,          # glTF extensions read, or null: clear coat factor and roughness (KHR_materials_clearcoat), the metal/roughness
                        # texture's uv scale u v (KHR_texture_transform: a car paint's flakes are its noise tiled 20 times)
  morph: Morph,         # its morph targets (morph.ludic), or null
  fab: floats,          # a garment's fabric (model_set_fabric: model.frag FABRIC's u_fp, 17 vec4), or null
  ftex: words,          # its five textures: mask, material A's kit and normals, material B's kit and normals
  eye: floats,          # a MetaHuman face's eyes (model_set_eyes: model.frag EYE): the cells' u (left, right), top v, size, inset; or null
  etex: words           # their six maps: sclera, normals, iris, iris normal, the cornea's height, the face's eye visibility
}
property Model {
  prims:  []Prim,
  radius: float = 0.0,       # float bits: max horizontal extent from the origin
  height: float = 0.0,       # float bits: y extent above ymin
  ymin:   float = 0.0,
  tris:   int = 0,
  sss:    float = 0.0,       # skin for the subsurface pass (sss.ludic): its texels below this u; 0 none
  @owns(Skin) skin:   Skin           # the skeleton, for a skinned node (skin.ludic); null for a rigid model
}

# a JSON number as float bits (ints and fixed-point decimals both)
function jnum(v: Val) -> float {
  if v.tag == 2 { return float(v.num) / 65536.0 }
  return float(v.num)
}
function jint(v: Val, key: pointer, fallback: int) -> int {
  if value_has(v, key) == 0 { return fallback }
  return value_as_int(value_get(v, key))
}

# Materials seen so far, by name: a LOD chain exported from the .blend (lod_export.py)
# carries the material names but no images — the blend links textures
# that are not downloaded with it — so its primitives take the textures the LOD0
# download's material of the same name loaded.
function gltf_mat_find(render3d_st: Render3dState, name: string) -> int {
  if render3d_st.gltf_mat_names == null { return -1 }
  for i in 0 .. render3d_st.gltf_mat_n { if render3d_st.gltf_mat_names[i] == name { return i } }
  return -1
}
function gltf_mat_remember(render3d_st: mut Render3dState, name: string, diff: int, nrm: int, arm: int) -> void {
  if render3d_st.gltf_mat_names == null { render3d_st.gltf_mat_names = new []string;  render3d_st.gltf_mat_diff = words(256);  render3d_st.gltf_mat_nrm = words(256);  render3d_st.gltf_mat_arm = words(256) }
  if gltf_mat_find(render3d_st, name) >= 0 or render3d_st.gltf_mat_n >= 256 { return }
  # its own copy of the name: a primitive frees its own with it (model_release)
  push(render3d_st.gltf_mat_names, name[0..len(name)])
  render3d_st.gltf_mat_diff[render3d_st.gltf_mat_n] = diff;  render3d_st.gltf_mat_nrm[render3d_st.gltf_mat_n] = nrm;  render3d_st.gltf_mat_arm[render3d_st.gltf_mat_n] = arm
  render3d_st.gltf_mat_n += 1
}

@alloc_ok("loading a model, a texture or a font: a load, not a frame (a guest loading a teammate's look is one)")
function gltf_texture(render3d_st: mut Render3dState, uri: string, srgb: bool) -> int {
  if render3d_st.gltf_tex_paths == null { render3d_st.gltf_tex_paths = new []pointer;  render3d_st.gltf_tex_ids = words(256);  render3d_st.gltf_tex_refs = words(256) }
  var png: string = uri
  let n = len(uri)
  var made = false
  if n > 4 and uri[n - 4] == '.' and uri[n - 3] == 'j' { png = uri[0..n - 4] + ".png";  made = true }
  let path = render3d_st.gltf_dir + "/" + png
  if made { free(png) }
  var i = 0
  while i < render3d_st.gltf_tex_n {
    if render3d_st.gltf_tex_paths[i] == path {
      free(path)                                   # the cache holds its own
      render3d_st.gltf_tex_refs[i] += 1
      return render3d_st.gltf_tex_ids[i]
    }
    i += 1
  }
  var dil = 0
  if render3d_st.gltf_cutout { dil = 24 }
  let id = tex_load_ex(render3d_st, path, srgb, dil)
  gltf_tex_add(render3d_st, path, id, 1)
  return id
}

# the images[] entry behind materials[m].<slot>.index, or a null value when the material has no such slot
function gltf_mat_image(render3d_st: Render3dState, mat: Val, slot: pointer) -> Val {
  var holder = mat
  if slot == "baseColorTexture" or slot == "metallicRoughnessTexture" {
    if value_has(mat, "pbrMetallicRoughness") == 0 { return null }
    holder = value_get(mat, "pbrMetallicRoughness")
  }
  if value_has(holder, slot) == 0 { return null }
  let ti = value_as_int(value_get(value_get(holder, slot), "index"))
  let tex = value_at(value_get(render3d_st.gltf_doc, "textures"), ti)
  let src = value_as_int(value_get(tex, "source"))
  return value_at(value_get(render3d_st.gltf_doc, "images"), src)
}

# the image uri behind materials[m].<slot>.index, or null (no slot, or an image embedded in the BIN chunk: gltf_mat_bv)
function gltf_mat_uri(render3d_st: Render3dState, mat: Val, slot: pointer) -> string {
  let img = gltf_mat_image(render3d_st, mat, slot)
  if img == null or value_has(img, "uri") == 0 { return null }
  return value_as_str(value_get(img, "uri"))
}

# the bufferView holding the image behind materials[m].<slot> when it is embedded (a .glb's BIN chunk, no uri), or -1
function gltf_mat_bv(render3d_st: Render3dState, mat: Val, slot: pointer) -> int {
  let img = gltf_mat_image(render3d_st, mat, slot)
  if img == null or value_has(img, "uri") != 0 or value_has(img, "bufferView") == 0 { return -1 }
  return value_as_int(value_get(img, "bufferView"))
}

# bufferView bv's bytes from the open binary (8 spare at the end); the caller frees them
@alloc_ok("loading a model: a load, not a frame")
function gltf_view_bytes(render3d_st: mut Render3dState, bv: int) -> pointer {
  let view = value_at(value_get(render3d_st.gltf_doc, "bufferViews"), bv)
  let n = jint(view, "byteLength", 0)
  let buf = bytes(n + 8)
  file_seek(render3d_st.gltf_bin, render3d_st.gltf_bin_base + jint(view, "byteOffset", 0), 0)
  file_read(render3d_st.gltf_bin, buf, n)
  return buf
}

# An embedded PNG as a texture, once per image: the cache is keyed by the image's bytes (their length and a hash of them), so
# the same picture embedded in many files is one texture. A car's 21 paints in 3 levels of detail each embed the same interior,
# glass and wheel atlases: keyed by (file, bufferView) they were 65 copies, 3.5 GB of a gym run's 4.6.
@alloc_ok("loading a model: a load, not a frame")
function gltf_texture_bv(render3d_st: mut Render3dState, bv: int, srgb: bool) -> int {
  if render3d_st.gltf_tex_paths == null { render3d_st.gltf_tex_paths = new []pointer;  render3d_st.gltf_tex_ids = words(256);  render3d_st.gltf_tex_refs = words(256) }
  let n = jint(value_at(value_get(render3d_st.gltf_doc, "bufferViews"), bv), "byteLength", 0)
  if n <= 8 { print(`gltf: image bufferView {bv} is empty`);  return 0 }
  let buf = gltf_view_bytes(render3d_st, bv)
  var dil = 0
  if render3d_st.gltf_cutout { dil = 24 }
  let key = `png#{n}#{gltf_bytes_hash(buf, n)}#{srgb}#{dil}`
  var i = 0
  while i < render3d_st.gltf_tex_n {
    if render3d_st.gltf_tex_paths[i] == key {
      free(key)
      free(buf)
      render3d_st.gltf_tex_refs[i] += 1
      return render3d_st.gltf_tex_ids[i]
    }
    i += 1
  }
  let id = tex_load_png_mem(render3d_st, buf, n, key, srgb, dil)
  if id != 0 { gltf_tex_add(render3d_st, key, id, 1) } else { free(key) }
  return id
}

# FNV-1a over a 32-bit word every 64 bytes and the last word (a PNG's compressed stream differs throughout when its picture does)
function gltf_bytes_hash(buf: pointer, n: int) -> int {
  var h = -2128831035
  var k = 0
  while k + 4 <= n {
    h = (h ^ Vk.get_i32(buf, k)) * 16777619
    k += 64
  }
  h = (h ^ Vk.get_i32(buf, n - 4)) * 16777619
  return h
}

# one material slot's texture: a file beside the model (uri), or an image inside its .glb; 0 when it has neither
function gltf_slot_texture(render3d_st: mut Render3dState, mat: Val, slot: pointer, srgb: bool) -> int {
  let u = gltf_mat_uri(render3d_st, mat, slot)
  if u != null { return gltf_texture(render3d_st, u, srgb) }
  let bv = gltf_mat_bv(render3d_st, mat, slot)
  if bv >= 0 { return gltf_texture_bv(render3d_st, bv, srgb) }
  return 0
}

# read one accessor's bytes from the .bin; sets gltf_count / gltf_ctype / gltf_comps
function gltf_accessor(render3d_st: mut Render3dState, idx: int) -> pointer {
  let acc = value_at(value_get(render3d_st.gltf_doc, "accessors"), idx)
  let bv = value_at(value_get(render3d_st.gltf_doc, "bufferViews"), jint(acc, "bufferView", 0))
  let off = jint(bv, "byteOffset", 0) + jint(acc, "byteOffset", 0)
  render3d_st.gltf_count = jint(acc, "count", 0)
  render3d_st.gltf_ctype = jint(acc, "componentType", 5126)
  let ty = value_as_str(value_get(acc, "type"))
  render3d_st.gltf_comps = 1
  if ty == "VEC2" { render3d_st.gltf_comps = 2 }
  if ty == "VEC3" { render3d_st.gltf_comps = 3 }
  if ty == "VEC4" { render3d_st.gltf_comps = 4 }
  if ty == "MAT2" { render3d_st.gltf_comps = 4 }
  if ty == "MAT3" { render3d_st.gltf_comps = 9 }
  if ty == "MAT4" { render3d_st.gltf_comps = 16 }       # a skin's inverse bind matrices
  var csz = 4
  if render3d_st.gltf_ctype == 5123 or render3d_st.gltf_ctype == 5122 { csz = 2 }
  if render3d_st.gltf_ctype == 5121 or render3d_st.gltf_ctype == 5120 { csz = 1 }
  let n = render3d_st.gltf_count * render3d_st.gltf_comps * csz
  let buf = bytes(n + 8)
  file_seek(render3d_st.gltf_bin, render3d_st.gltf_bin_base + off, 0)
  file_read(render3d_st.gltf_bin, buf, n)
  return buf
}

function gltf_attrib(render3d_st: mut Render3dState, m: Mesh, attrs: Val, name: pointer, loc: int) -> bool {
  if value_has(attrs, name) == 0 { return false }
  let data = gltf_accessor(render3d_st, value_as_int(value_get(attrs, name)))
  gpu_mesh_vertices(render3d_st, m, data, render3d_st.gltf_count * render3d_st.gltf_comps * 4, GPU_STATIC)
  gpu_mesh_attr(render3d_st, m, loc, render3d_st.gltf_comps, GPU_F32, 0, 0, false)
  free(data)
  return true
}

# n COLOR_0 elements of `comps` (3 or 4) components of glTF componentType ct (5121 / 5123 normalized, 5126 float) as
# RGBA8; a missing alpha is 1. The caller frees it.
@alloc_ok("loading a model: a primitive's colour bytes, once")
function gltf_colour_rgba8(data: pointer, n: int, comps: int, ct: int) -> pointer {
  let out = bytes(n * 4 + 8)
  for i in 0 .. n {
    for c in 0 .. 4 {
      var v = 255
      if c < comps {
        let at = i * comps + c
        if ct == 5121 { v = int(data[at]) }
        else if ct == 5123 { v = (int(data[at * 2]) + int(data[at * 2 + 1]) * 256) * 255 / 65535 }
        else { v = int(clamp(float_from_bits(mem_get_f32_bits(data, at)), 0.0, 1.0) * 255.0 + 0.5) }
      }
      out[i * 4 + c] = v
    }
  }
  return out
}

function gltf_colour_floats(f: floats, n: int, comps: int) -> pointer { unsafe { return gltf_colour_rgba8(data_of(f), n, comps, 5126) } }
function gltf_bytes_free(p: pointer) -> void { free(p) }
function gltf_byte_at(p: pointer, i: int) -> int { return int(p[i]) }

# COLOR_0 (vec3 or vec4; float, or normalized unsigned byte / short) onto attribute 7 as RGBA8 normalized: the shaders
# multiply it into the base colour (kit.vert, model.vert). A mesh without it records nothing there and the shaders read
# the unfed input as white. Linear values, as the spec has them; 8 bits are what a building's flat colours need.
@alloc_ok("loading a model: a primitive's colour buffer, once")
function gltf_colour(render3d_st: mut Render3dState, m: Mesh, attrs: Val) -> bool {
  if value_has(attrs, "COLOR_0") == 0 { return false }
  let data = gltf_accessor(render3d_st, value_as_int(value_get(attrs, "COLOR_0")))
  let n = render3d_st.gltf_count
  let out = gltf_colour_rgba8(data, n, render3d_st.gltf_comps, render3d_st.gltf_ctype)
  free(data)
  gpu_mesh_vertices(render3d_st, m, out, n * 4, GPU_STATIC)
  gpu_mesh_attr(render3d_st, m, 7, 4, GPU_U8, 0, 0, true)
  free(out)
  return true
}

function gltf_prim(render3d_st: mut Render3dState, p: Val) -> Prim {
  let pr = new Prim
  let m = gpu_mesh_new(render3d_st)
  let attrs = value_get(p, "attributes")
  gltf_attrib(render3d_st, m, attrs, "POSITION", 0)
  let nverts = render3d_st.gltf_count
  gltf_attrib(render3d_st, m, attrs, "NORMAL", 1)
  gltf_attrib(render3d_st, m, attrs, "TEXCOORD_0", 2)
  gltf_colour(render3d_st, m, attrs)                     # COLOR_0 onto 7, when the mesh has it
  gltf_attrib(render3d_st, m, attrs, "_ANCHOR", 8)       # a box kit's anchors (sx, sz, sh, sd) and offset (kitbox.ludic, kit.vert)
  gltf_attrib(render3d_st, m, attrs, "_OFFSET", 9)
  gltf_attrib(render3d_st, m, attrs, "_HAIRSKY", 9)       # a groom's strands' hair toward the sky (strands.ludic, skin.vert STRANDS)
  skin_attribs(render3d_st, m, attrs)                    # JOINTS_0 / WEIGHTS_0 onto 5 / 6, when the mesh has them
  let idx = gltf_accessor(render3d_st, value_as_int(value_get(p, "indices")))
  var isz = 4
  if render3d_st.gltf_ctype == 5123 { isz = 2 }
  gpu_mesh_indices(render3d_st, m, idx, render3d_st.gltf_count * isz, isz)
  free(idx)
  m.count = render3d_st.gltf_count
  gpu_mesh_done(render3d_st, m)
  pr.mesh = m
  pr.verts = nverts
  # material textures
  if render3d_st.gltf_white == 0 { render3d_st.gltf_white = tex_solid(render3d_st, 200, 200, 200, 255);  render3d_st.gltf_flat = tex_solid(render3d_st, 128, 128, 255, 255) }
  # a material with no metal/roughness of its own: occlusion and roughness as before (200), and no metal (the shader reads metal now)
  if render3d_st.gltf_arm0 == 0 { render3d_st.gltf_arm0 = tex_solid(render3d_st, 200, 200, 0, 255) }
  pr.diff = render3d_st.gltf_white;  pr.nrm = render3d_st.gltf_flat;  pr.arm = render3d_st.gltf_arm0
  if value_has(p, "material") != 0 {
    let mat = value_at(value_get(render3d_st.gltf_doc, "materials"), value_as_int(value_get(p, "material")))
    render3d_st.gltf_cutout = value_has(mat, "alphaMode") != 0
    let ud = gltf_mat_uri(render3d_st, mat, "baseColorTexture")
    let ed = gltf_mat_bv(render3d_st, mat, "baseColorTexture")
    var td = 0;  var tn = 0;  var ta = 0
    if ud != null or ed >= 0 { td = gltf_slot_texture(render3d_st, mat, "baseColorTexture", true) }
    tn = gltf_slot_texture(render3d_st, mat, "normalTexture", false)
    ta = gltf_slot_texture(render3d_st, mat, "metallicRoughnessTexture", false)
    if td != 0 { pr.diff = td }
    if tn != 0 { pr.nrm = tn }
    if ta != 0 { pr.arm = ta }
    gltf_factors(render3d_st, pr, mat, td != 0, ta != 0)
    var mname: string = null
    # a copy: the document goes, strings and all, at the next load
    if value_has(mat, "name") != 0 { let s = value_as_str(value_get(mat, "name"));  mname = s[0..len(s)] }
    pr.name = mname
    if mname != null {
      # The name cache serves a LOD chain exported without images (its textures came with the LOD0 download, in the same
      # directory), so it is keyed by directory and name, and only a material with no texture of its own and no colour
      # of its own asks it. A material whose image is embedded is self-contained: it neither fills the cache nor reads it.
      let key = `{render3d_st.gltf_dir}/{mname}`
      if ud != null { gltf_mat_remember(render3d_st, key, pr.diff, pr.nrm, pr.arm) }
      else if td == 0 and not gltf_mat_has_colour(mat) {
        let k = gltf_mat_find(render3d_st, key)
        if k >= 0 {
          pr.diff = render3d_st.gltf_mat_diff[k];  pr.nrm = render3d_st.gltf_mat_nrm[k];  pr.arm = render3d_st.gltf_mat_arm[k]
          gltf_tex_ref(render3d_st, pr.diff);  gltf_tex_ref(render3d_st, pr.nrm);  gltf_tex_ref(render3d_st, pr.arm)
        }
        else { print(`gltf: material {mname} has no textures and none were loaded before it`) }
      }
      free(key)
    }
  }
  return pr
}

# a material that states its own base colour (a baseColorFactor other than white): it draws that, not another file's texture of its name
function gltf_mat_has_colour(mat: Val) -> bool {
  if value_has(mat, "pbrMetallicRoughness") == 0 { return false }
  let pbr = value_get(mat, "pbrMetallicRoughness")
  if value_has(pbr, "baseColorFactor") == 0 { return false }
  let b = value_get(pbr, "baseColorFactor")
  for k in 0 .. min(value_count(b), 3) { if jnum(value_at(b, k)) < 0.999 { return true } }
  return false          # white: the factor changes nothing
}

# The material's factors (glTF's pbrMetallicRoughness and emissiveFactor), which the shaders multiply in;
# a material that gives none keeps pr.fac null and draws as it always has. An untextured material with
# a colour, or a metal/roughness, samples white for it, so the factor is exactly what it draws.
@alloc_ok("a model being loaded: a primitive's factors, once")
function gltf_factors(render3d_st: mut Render3dState, pr: Prim, mat: Val, has_diff: bool, has_arm: bool) -> void {
  gltf_ext(pr, mat)
  let pbr = value_get(mat, "pbrMetallicRoughness")
  let has_pbr = value_has(mat, "pbrMetallicRoughness") != 0
  let has_base = has_pbr and value_has(pbr, "baseColorFactor") != 0
  let has_m = has_pbr and value_has(pbr, "metallicFactor") != 0
  let has_r = has_pbr and value_has(pbr, "roughnessFactor") != 0
  let has_e = value_has(mat, "emissiveFactor") != 0
  if not has_base and not has_m and not has_r and not has_e { return }
  let f = floats(9)
  for k in 0 .. 6 { f[k] = 1.0 }
  for k in 6 .. 9 { f[k] = 0.0 }
  if has_base { let b = value_get(pbr, "baseColorFactor");  for k in 0 .. min(value_count(b), 4) { f[k] = jnum(value_at(b, k)) } }
  if has_r { f[4] = jnum(value_get(pbr, "roughnessFactor")) }
  if has_m { f[5] = jnum(value_get(pbr, "metallicFactor")) }
  if has_e { let e = value_get(mat, "emissiveFactor");  for k in 0 .. min(value_count(e), 3) { f[6 + k] = jnum(value_at(e, k)) } }
  pr.fac = f
  if render3d_st.gltf_pure == 0 { render3d_st.gltf_pure = tex_solid(render3d_st, 255, 255, 255, 255) }
  if has_base and not has_diff { pr.diff = render3d_st.gltf_pure }
  if (has_m or has_r) and not has_arm { pr.arm = render3d_st.gltf_pure }
}

# the extensions a car's paint needs: its clear coat, and its metal/roughness texture's tiling (the flakes)
@alloc_ok("a model being loaded: a primitive's extensions, once")
function gltf_ext(pr: Prim, mat: Val) -> void {
  var coat = 0.0
  var coat_r = 0.0
  var su = 1.0
  var sv = 1.0
  if value_has(mat, "extensions") != 0 {
    let ex = value_get(mat, "extensions")
    if value_has(ex, "KHR_materials_clearcoat") != 0 {
      let cc = value_get(ex, "KHR_materials_clearcoat")
      if value_has(cc, "clearcoatFactor") != 0 { coat = jnum(value_get(cc, "clearcoatFactor")) }
      if value_has(cc, "clearcoatRoughnessFactor") != 0 { coat_r = jnum(value_get(cc, "clearcoatRoughnessFactor")) }
    }
  }
  if value_has(mat, "pbrMetallicRoughness") != 0 {
    let pbr = value_get(mat, "pbrMetallicRoughness")
    if value_has(pbr, "metallicRoughnessTexture") != 0 {
      let t = value_get(pbr, "metallicRoughnessTexture")
      if value_has(t, "extensions") != 0 and value_has(value_get(t, "extensions"), "KHR_texture_transform") != 0 {
        let tt = value_get(value_get(t, "extensions"), "KHR_texture_transform")
        if value_has(tt, "scale") != 0 {
          let sc = value_get(tt, "scale")
          if value_count(sc) >= 2 { su = jnum(value_at(sc, 0));  sv = jnum(value_at(sc, 1)) }
        }
      }
    }
  }
  if coat <= 0.0 and su == 1.0 and sv == 1.0 { return }
  let e = floats(4)
  e[0] = coat;  e[1] = coat_r;  e[2] = su;  e[3] = sv
  pr.ext = e
}

# a primitive's factors handed to program p (as 1 - factor, so a program never given them reads 1)
function prim_factors(render3d_st: mut Render3dState, p: int, pr: Prim) -> void {
  # (set every draw, the neutral values too: a program keeps a uniform from the last primitive that set it)
  let e = pr.ext
  if e == null {
    u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_fac_coat"), 0.0, 0.0)
    u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_mr_scale"), 1.0, 1.0)
  } else {
    u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_fac_coat"), e[0], e[1])
    u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_mr_scale"), e[2], e[3])
  }
  let f = pr.fac
  if f == null {
    u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_fac_base_inv"), 0.0, 0.0, 0.0, 0.0)
    u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_fac_mr_inv"), 0.0, 0.0)
    u_f3(render3d_st, gpu_uniform(render3d_st, p, "u_fac_emis"), 0.0, 0.0, 0.0)
    return
  }
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_fac_base_inv"), 1.0 - f[0], 1.0 - f[1], 1.0 - f[2], 1.0 - f[3])
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_fac_mr_inv"), 1.0 - f[4], 1.0 - f[5])
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "u_fac_emis"), f[6], f[7], f[8])
}

# Open the document `dir/file` and the binary its accessors read: a .gltf with its one external .bin (buffers[0].uri),
# or a binary glTF (.glb: the JSON chunk is the document, the BIN chunk the binary; glb.ludic), told apart by the
# file's own first bytes, not its name. On true gltf_doc is the parsed document and gltf_bin an open file positioned by
# gltf_bin_base; the caller closes gltf_bin. The last document's tree goes first.
@alloc_ok("loading a model, a texture or a font: a load, not a frame (a guest loading a teammate's look is one)")
function gltf_open(render3d_st: mut Render3dState, dir: string, file: string) -> bool {
  render3d_st.gltf_dir = dir
  let at = dir + "/" + file
  # The parsed document is kept per file: a block glb names 300+ buildings and each model_actor asks for one node, so
  # parsing its megabytes of JSON again for every node was the whole load time. The same path of the same size (and,
  # for a .glb, the same JSON chunk length) is the same document; only the binary is reopened, which is cheap.
  let size = Fs.size(at)
  var same = render3d_st.gltf_doc != null and render3d_st.gltf_doc_key != null and render3d_st.gltf_doc_key == at and render3d_st.gltf_doc_size == size and render3d_st.gltf_doc == render3d_st.gltf_doc_own
  if render3d_st.gltf_bin_path != null { free(render3d_st.gltf_bin_path);  render3d_st.gltf_bin_path = null }
  render3d_st.gltf_bin_base = 0
  let f = file_open(at, "rb")
  if f == null or size < 0 { print(`gltf: cannot read {dir}/{file}`);  free(at);  gltf_doc_drop(render3d_st);  return false }
  let lay = words(4)
  if glb_scan(f, size, lay) {
    if same and render3d_st.gltf_doc_jlen != lay[1] { same = false }
    if not same {
      gltf_doc_drop(render3d_st)
      let buf = bytes(lay[1] + 1)
      file_seek(f, lay[0], 0)
      file_read(f, buf, lay[1])
      buf[lay[1]] = 0
      let text: string = buf
      render3d_st.gltf_doc = Json.parse(text)
      free(buf)
      render3d_st.gltf_doc_own = render3d_st.gltf_doc
      render3d_st.gltf_doc_key = at
      render3d_st.gltf_doc_size = size
      render3d_st.gltf_doc_jlen = lay[1]
    } else { free(at) }
    let base = lay[2]
    free(lay)
    if base < 0 { print(`gltf: {file} has no binary chunk`);  file_close(f);  return false }
    render3d_st.gltf_bin = f
    render3d_st.gltf_bin_base = base
    render3d_st.gltf_bin_path = dir + "/" + file
    return true
  }
  free(lay)
  file_close(f)
  if not same {
    gltf_doc_drop(render3d_st)
    let text = Fs.read_text(at)
    if text == null { print(`gltf: cannot read {dir}/{file}`);  free(at);  return false }
    # the text once parsed - nothing gives memory back on its own (plan 23 of maroon-lake)
    render3d_st.gltf_doc = Json.parse(text)
    free(text)
    render3d_st.gltf_doc_own = render3d_st.gltf_doc
    render3d_st.gltf_doc_key = at
    render3d_st.gltf_doc_size = size
    render3d_st.gltf_doc_jlen = 0
  } else { free(at) }
  let buffers = value_get(render3d_st.gltf_doc, "buffers")
  if value_count(buffers) == 0 or value_has(value_at(buffers, 0), "uri") == 0 { print(`gltf: {file} names no .bin`);  return false }
  let bin_uri = value_as_str(value_get(value_at(buffers, 0), "uri"))
  let bin_at = dir + "/" + bin_uri
  render3d_st.gltf_bin = file_open(bin_at, "rb")
  if render3d_st.gltf_bin == null { print(`gltf: cannot open {bin_uri}`);  free(bin_at);  return false }
  render3d_st.gltf_bin_path = bin_at
  return true
}

# the kept document goes (a different file is opened, or a read failed), with the key that named it
@alloc_ok("loading a model: a load, not a frame")
function gltf_doc_drop(render3d_st: mut Render3dState) -> void {
  if render3d_st.gltf_doc != null { Json.free_all(render3d_st.gltf_doc);  render3d_st.gltf_doc = null }
  if render3d_st.gltf_doc_key != null { free(render3d_st.gltf_doc_key);  render3d_st.gltf_doc_key = null }
  render3d_st.gltf_doc_own = null
  render3d_st.gltf_doc_size = -1
  render3d_st.gltf_doc_jlen = 0
}

# Open the binary of the document gltf_load last read again (gltf_load closes it before it returns), for a reader of
# the document that follows a load (ludic.anim's clips): a .gltf's .bin or a .glb's BIN chunk alike. A document set
# by hand (a test's) has no path kept: its buffers[0].uri under `dir` is opened.
function gltf_bin_reopen(render3d_st: mut Render3dState, dir: string) -> bool {
  render3d_st.gltf_bin = null
  if render3d_st.gltf_bin_path != null {
    render3d_st.gltf_bin = file_open(render3d_st.gltf_bin_path, "rb")
    return render3d_st.gltf_bin != null
  }
  let buffers = value_get(render3d_st.gltf_doc, "buffers")
  if value_count(buffers) == 0 or value_has(value_at(buffers, 0), "uri") == 0 { return false }
  render3d_st.gltf_bin_base = 0
  render3d_st.gltf_bin = file_open(dir + "/" + value_as_str(value_get(value_at(buffers, 0), "uri")), "rb")
  return render3d_st.gltf_bin != null
}

# Load the mesh of the node called `node_name` from dir/file.
# the GPU memory it makes is counted as VKM_MODEL (R3D_VKMEM)
function gltf_load(render3d_st: mut Render3dState, dir: string, file: string, node_name: string) -> Model {
  let was = render3d_st.gvk_tag
  render3d_st.gvk_tag = VKM_MODEL
  let r = gltf_load__t(render3d_st, dir, file, node_name)
  render3d_st.gvk_tag = was
  return r
}
@alloc_ok("loading a model, a texture or a font: a load, not a frame (a guest loading a teammate's look is one)")
@creates(Model)
function gltf_load__t(render3d_st: mut Render3dState, dir: string, file: string, node_name: string) -> Model {
  if not gltf_open(render3d_st, dir, file) { return null }
  let nodes = value_get(render3d_st.gltf_doc, "nodes")
  var mesh_idx = -1
  var skin_idx = -1
  for i in 0 .. value_count(nodes) {
    let nd = value_at(nodes, i)
    if value_as_str(value_get(nd, "name")) == node_name { mesh_idx = jint(nd, "mesh", -1);  skin_idx = jint(nd, "skin", -1) }
  }
  if mesh_idx < 0 { print(`gltf: no node {node_name} in {file}`);  file_close(render3d_st.gltf_bin);  return null }
  let model = new Model
  model.prims = new []Prim
  let mesh = value_at(value_get(render3d_st.gltf_doc, "meshes"), mesh_idx)
  let prims = value_get(mesh, "primitives")
  var r2 = 0.0;  var ymin = 1000.0;  var ymax = -1000.0
  for i in 0 .. value_count(prims) {
    let p = value_at(prims, i)
    let pr = gltf_prim(render3d_st, p)
    model.tris += render3d_st.gltf_count / 3           # (the index count: before the morph targets' reads change it)
    morph_load(render3d_st, pr, p, mesh)
    push(model.prims, pr)
    # bounds from the accessor min/max
    let acc = value_at(value_get(render3d_st.gltf_doc, "accessors"), value_as_int(value_get(value_get(p, "attributes"), "POSITION")))
    let mn = value_get(acc, "min");  let mx = value_get(acc, "max")
    let x0 = Math.abs(jnum(value_at(mn, 0)));  let x1 = Math.abs(jnum(value_at(mx, 0)))
    let z0 = Math.abs(jnum(value_at(mn, 2)));  let z1 = Math.abs(jnum(value_at(mx, 2)))
    let rx = Math.max(x0, x1);  let rz = Math.max(z0, z1)
    let rr = rx * rx + rz * rz
    if rr > r2 { r2 = rr }
    let y0 = jnum(value_at(mn, 1));  let y1 = jnum(value_at(mx, 1))
    if y0 < ymin { ymin = y0 }
    if y1 > ymax { ymax = y1 }
  }
  if skin_idx >= 0 { model.skin = skin_load(render3d_st, skin_idx) }
  file_close(render3d_st.gltf_bin)
  model.radius = Math.sqrt(r2)
  model.ymin = ymin
  model.height = ymax - ymin
  print(`gltf: {node_name}: {len(model.prims)} prims, {model.tris} tris`)
  return model
}

# Load every mesh node of dir/file called `node_name` - or, when it is "", every mesh node of the file - as ONE model: the
# primitives of each node's mesh in document order, each named by its material as gltf_load names them. Quiet (no console
# line a load) and no node is an answer, not an error: null when the file cannot be read or no node matches. For a world
# streamed as the camera moves, whose files hold a mesh a material (a baked chunk of road: one node a slot) and are loaded
# and let go many times a minute. Node transforms are not applied (as gltf_load); a skin is not read. The bounds are
# gltf_load's (radius from the origin, ymin, height); the GPU memory is counted as VKM_MODEL.
function gltf_load_nodes(render3d_st: mut Render3dState, dir: string, file: string, node_name: string) -> Model {
  let was = render3d_st.gvk_tag
  render3d_st.gvk_tag = VKM_MODEL
  let r = gltf_load_nodes__t(render3d_st, dir, file, node_name)
  render3d_st.gvk_tag = was
  return r
}
@alloc_ok("loading a model: a load, not a frame (a streamed chunk's file, once while it is in)")
@creates(Model)
function gltf_load_nodes__t(render3d_st: mut Render3dState, dir: string, file: string, node_name: string) -> Model {
  if not Fs.exists(dir + "/" + file) { return null }
  if not gltf_open(render3d_st, dir, file) { return null }
  let nodes = value_get(render3d_st.gltf_doc, "nodes")
  let meshes = value_get(render3d_st.gltf_doc, "meshes")
  let accessors = value_get(render3d_st.gltf_doc, "accessors")
  var model: Model = null
  var r2 = 0.0;  var ymin = 1000000.0;  var ymax = -1000000.0
  for n in 0 .. value_count(nodes) {
    let nd = value_at(nodes, n)
    let mi = jint(nd, "mesh", -1)
    if mi < 0 { continue }
    if Text.length(node_name) > 0 and value_as_str(value_get(nd, "name")) != node_name { continue }
    if model == null {
      model = new Model
      model.prims = new []Prim
    }
    let prims = value_get(value_at(meshes, mi), "primitives")
    for i in 0 .. value_count(prims) {
      let p = value_at(prims, i)
      let pr = gltf_prim(render3d_st, p)
      model.tris += render3d_st.gltf_count / 3
      morph_load(render3d_st, pr, p, value_at(meshes, mi))
      push(model.prims, pr)
      let acc = value_at(accessors, value_as_int(value_get(value_get(p, "attributes"), "POSITION")))
      let mn = value_get(acc, "min");  let mx = value_get(acc, "max")
      let rx = Math.max(Math.abs(jnum(value_at(mn, 0))), Math.abs(jnum(value_at(mx, 0))))
      let rz = Math.max(Math.abs(jnum(value_at(mn, 2))), Math.abs(jnum(value_at(mx, 2))))
      if rx * rx + rz * rz > r2 { r2 = rx * rx + rz * rz }
      let y0 = jnum(value_at(mn, 1));  let y1 = jnum(value_at(mx, 1))
      if y0 < ymin { ymin = y0 }
      if y1 > ymax { ymax = y1 }
    }
  }
  file_close(render3d_st.gltf_bin)
  render3d_st.gltf_bin = null
  if model == null { return null }
  model.radius = Math.sqrt(r2)
  model.ymin = ymin
  model.height = ymax - ymin
  return model
}
