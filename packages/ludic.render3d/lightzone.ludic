# ============================================================================
# lightzone.ludic - LIGHT ZONES: boxes where the sun does not reach, a tunnel's tube or an underpass. Inside one the
# sun contributes nothing (its direct light, its bounce off the ground and its shafts in the air), the sky's light is
# scaled by the zone's `sky` (0: a tube that sees no sky) and the zone's own AMBIENT is added (linear radiance, like a
# tint: the lamps along a tunnel, a level the game tunes). A zone fades in over `feather` metres inward from its faces,
# so a portal is a short dusk and not a line; outside its box a zone does nothing. Its two ends (the faces across its
# depth, a tube's portals) and its four sides (along its depth: a tube's walls, roof and floor) may fade over different
# lengths: a tube's zone fades in at a portal and stands with hard sides in its walls and roof, so the tube's inside is
# wholly in it and the tube's outside wholly out of it. A zone may be sheared along its depth by a grade (its floor and
# roof rising `grade` metres a metre along its local z, as a tube's road does), so a box in a sloping tube still stands
# in its roof and not over it.
#
#   let z = lightzone_add(st, x, y, z, yaw, w, h, d, feather)    # centre, turn (radians, as actor_place), full sizes
#   lightzone_feather(st, z, 2.0, 0.0)                           # the ends' feather and the sides' (default: both `feather`)
#   lightzone_grade(st, z, 0.04)                                 # sheared: up 4 cm a metre along its depth (default 0)
#   lightzone_ambient(st, z, 0.9, 0.75, 0.5, 0.0)                # ambient r g b, sky fraction (default 0, 0, 0, 0)
#   lightzone_clear(st);  lightzone_rebase(st, dx, dy, dz)       # all gone; the floating origin moved by (dx, dy, dz)
#   lightzone_at(st, x, y, z)                                    # 0 .. 1: how far inside (the shaders' weight)
#
# Zones are kept on the CPU (LZ_CAP); the LZ_MAX nearest the camera go to every lit program with the sun
# (sky_bind_lighting: lighting.glsl lightZone, shade, and volumetric.frag), picked again when the camera moves a metre
# or a zone changes. With no zone the shaders' loop ends at once and nothing changes. Coordinates are the renderer's
# (the floating origin's), like an actor's.
# ============================================================================
numbers float

const LZ_CAP: int = 512            # zones kept
const LZ_MAX: int = 8              # zones a frame's shaders see (lighting.glsl LZ_MAX)
const LZ_STRIDE: int = 16          # cx cy cz cos sin hx hy hz feather r g b sky side grade 0

@alloc_ok("the zones' tables, made once on the first zone")
function lz_make(render3d_st: mut Render3dState) -> void {
  if render3d_st.lz != null { return }
  render3d_st.lz = floats(LZ_CAP * LZ_STRIDE)
  render3d_st.lz_u = floats(LZ_MAX * 16)
  render3d_st.lz_at = floats(3)
  for i in 0 .. LZ_MAX * 16 { render3d_st.lz_u[i] = 0.0 }
}

# A zone: the box centred on (x, y, z), turned by `yaw` radians about y (actor_place's turn: its local x is world
# (cos, 0, -sin)), `w` wide along its x, `h` tall, `d` deep along its z, fading in over `feather` metres from its faces
# (0: a hard edge). No ambient and no sky until lightzone_ambient says. Its index, -1 when LZ_CAP are kept already or
# the box is empty.
export function lightzone_add(render3d_st: mut Render3dState, x: float, y: float, z: float, yaw: float, w: float, h: float, d: float, feather: float) -> int {
  lz_make(render3d_st)
  if render3d_st.lz_n >= LZ_CAP or w <= 0.0 or h <= 0.0 or d <= 0.0 { return -1 }
  let i = render3d_st.lz_n
  let o = i * LZ_STRIDE
  let v = render3d_st.lz
  v[o] = x;  v[o + 1] = y;  v[o + 2] = z
  v[o + 3] = Math.cos(yaw);  v[o + 4] = Math.sin(yaw)
  v[o + 5] = w * 0.5;  v[o + 6] = h * 0.5;  v[o + 7] = d * 0.5
  v[o + 8] = Math.max(feather, 0.0)
  for k in 9 .. LZ_STRIDE { v[o + k] = 0.0 }
  v[o + 13] = v[o + 8]
  render3d_st.lz_n = i + 1
  render3d_st.lz_dirty = true
  return i
}

# zone i's own light: ambient radiance (r, g, b), linear, and the fraction of the sky's light it still sees (0 .. 1)
export function lightzone_ambient(render3d_st: mut Render3dState, i: int, r: float, g: float, b: float, sky: float) -> void {
  if i < 0 or i >= render3d_st.lz_n { return }
  let o = i * LZ_STRIDE
  render3d_st.lz[o + 9] = Math.max(r, 0.0);  render3d_st.lz[o + 10] = Math.max(g, 0.0);  render3d_st.lz[o + 11] = Math.max(b, 0.0)
  render3d_st.lz[o + 12] = Math.clamp(sky, 0.0, 1.0)
  render3d_st.lz_dirty = true
}

# zone i's feathers: over `ends` metres from its two faces across its depth (d), over `sides` from the other four (0: a hard edge)
export function lightzone_feather(render3d_st: mut Render3dState, i: int, ends: float, sides: float) -> void {
  if i < 0 or i >= render3d_st.lz_n { return }
  let o = i * LZ_STRIDE
  render3d_st.lz[o + 8] = Math.max(ends, 0.0)
  render3d_st.lz[o + 13] = Math.max(sides, 0.0)
  render3d_st.lz_dirty = true
}

# zone i sheared along its depth: its floor and roof rise `grade` metres a metre along its local z (0: a plain box)
export function lightzone_grade(render3d_st: mut Render3dState, i: int, grade: float) -> void {
  if i < 0 or i >= render3d_st.lz_n { return }
  render3d_st.lz[i * LZ_STRIDE + 14] = grade
  render3d_st.lz_dirty = true
}

export function lightzone_count(render3d_st: Render3dState) -> int { return render3d_st.lz_n }
export function lightzone_clear(render3d_st: mut Render3dState) -> void { render3d_st.lz_n = 0;  render3d_st.lz_dirty = true }

# the floating origin moved: every zone shifts with the world (as water_rebase)
export function lightzone_rebase(render3d_st: mut Render3dState, dx: float, dy: float, dz: float) -> void {
  for i in 0 .. render3d_st.lz_n {
    let o = i * LZ_STRIDE
    render3d_st.lz[o] = render3d_st.lz[o] + dx;  render3d_st.lz[o + 1] = render3d_st.lz[o + 1] + dy;  render3d_st.lz[o + 2] = render3d_st.lz[o + 2] + dz
  }
  render3d_st.lz_dirty = true
}

# how far inside zone i (x, y, z) is: 0 outside its box, 1 deeper than its feathers, smoothstep between (the ends' feather
# from its faces across its depth, the sides' from the other four: the lesser of the two; lighting.glsl lightZone, the same sum)
export function lightzone_weight(render3d_st: Render3dState, i: int, x: float, y: float, z: float) -> float {
  let o = i * LZ_STRIDE
  let v = render3d_st.lz
  let dx = x - v[o];  let dy = y - v[o + 1];  let dz = z - v[o + 2]
  let lx = v[o + 3] * dx - v[o + 4] * dz
  let lz = v[o + 4] * dx + v[o + 3] * dz
  let side = Math.min(v[o + 5] - Math.abs(lx), v[o + 6] - Math.abs(dy - v[o + 14] * lz))
  return Math.min(lz_fade(side, v[o + 13]), lz_fade(v[o + 7] - Math.abs(lz), v[o + 8]))
}
# 0 outside (inside < 0), 1 deeper than the feather, smoothstep between; a hard edge with no feather
function lz_fade(inside: float, feather: float) -> float {
  if feather <= 0.0 {
    if inside >= 0.0 { return 1.0 }
    return 0.0
  }
  let t = Math.clamp(inside / feather, 0.0, 1.0)
  return t * t * (3.0 - 2.0 * t)
}

# the strongest zone's weight at (x, y, z), over every zone kept: what the sun is scaled by there is 1 minus this
export function lightzone_at(render3d_st: Render3dState, x: float, y: float, z: float) -> float {
  var w = 0.0
  for i in 0 .. render3d_st.lz_n { w = Math.max(w, lightzone_weight(render3d_st, i, x, y, z)) }
  return w
}

# the zone index the shaders see in slot k (lightzone_pick's order), -1 past the count
export function lightzone_slot(render3d_st: Render3dState, k: int) -> int {
  if k < 0 or k >= render3d_st.lz_un { return -1 }
  return int(render3d_st.lz_u[k * 16 + 15])
}

# the LZ_MAX zones nearest (cx, cy, cz) (by the distance to their box) into the shaders' table: 4 vec4 a zone
#   (cx, cy, cz, end feather) (cos, sin, sky, grade) (hx, hy, hz, side feather) (r, g, b, index)
export function lightzone_pick(render3d_st: mut Render3dState, cx: float, cy: float, cz: float) -> void {
  lz_make(render3d_st)
  let u = render3d_st.lz_u
  let v = render3d_st.lz
  var n = 0
  for i in 0 .. render3d_st.lz_n {
    let o = i * LZ_STRIDE
    let dx = cx - v[o];  let dy = cy - v[o + 1];  let dz = cz - v[o + 2]
    let lx = Math.max(Math.abs(v[o + 3] * dx - v[o + 4] * dz) - v[o + 5], 0.0)
    let ly = Math.max(Math.abs(dy - v[o + 14] * (v[o + 4] * dx + v[o + 3] * dz)) - v[o + 6], 0.0)
    let lz = Math.max(Math.abs(v[o + 4] * dx + v[o + 3] * dz) - v[o + 7], 0.0)
    let dist = lx * lx + ly * ly + lz * lz
    # insertion into the sorted slots (kept in u's unused w of the 4th vec4 as the index, the distance beside in a scratch)
    var k = n
    if k == LZ_MAX { k = LZ_MAX - 1;  if dist >= lz_dist(u, k) { continue } }
    while k > 0 and lz_dist(u, k - 1) > dist {
      for c in 0 .. 16 { u[k * 16 + c] = u[(k - 1) * 16 + c] }
      k -= 1
    }
    let s = k * 16
    u[s] = v[o];  u[s + 1] = v[o + 1];  u[s + 2] = v[o + 2];  u[s + 3] = v[o + 8]
    u[s + 4] = v[o + 3];  u[s + 5] = v[o + 4];  u[s + 6] = v[o + 12];  u[s + 7] = dist
    u[s + 8] = v[o + 5];  u[s + 9] = v[o + 6];  u[s + 10] = v[o + 7];  u[s + 11] = v[o + 13]
    u[s + 12] = v[o + 9];  u[s + 13] = v[o + 10];  u[s + 14] = v[o + 11];  u[s + 15] = float(i)
    if n < LZ_MAX { n += 1 }
  }
  # the sort's distances (the second vec4's w) are done with: each slot's grade there for the shaders
  for k in 0 .. n { u[k * 16 + 7] = v[int(u[k * 16 + 15]) * LZ_STRIDE + 14] }
  render3d_st.lz_un = n
  render3d_st.lz_at[0] = cx;  render3d_st.lz_at[1] = cy;  render3d_st.lz_at[2] = cz
  render3d_st.lz_dirty = false
}
function lz_dist(u: floats, k: int) -> float { return u[k * 16 + 7] }

# the zones for a lit program (sky_bind_lighting): picked again for the camera when it moved a metre or a zone changed
function lightzone_bind(render3d_st: mut Render3dState, prog: int) -> void {
  if render3d_st.lz_n == 0 and render3d_st.lz_un == 0 and not render3d_st.lz_dirty {
    u_i(render3d_st, gpu_uniform(render3d_st, prog, "u_lz_n"), 0)
    return
  }
  let c = render3d_st.cam_pos
  if render3d_st.lz_dirty or render3d_st.lz_at == null or Math.abs(c[0] - render3d_st.lz_at[0]) + Math.abs(c[1] - render3d_st.lz_at[1]) + Math.abs(c[2] - render3d_st.lz_at[2]) > 1.0 {
    lightzone_pick(render3d_st, c[0], c[1], c[2])
  }
  u_i(render3d_st, gpu_uniform(render3d_st, prog, "u_lz_n"), render3d_st.lz_un)
  if render3d_st.lz_un == 0 { return }
  var loc = gpu_uniform(render3d_st, prog, "u_lz[0]")
  if loc < 0 { loc = gpu_uniform(render3d_st, prog, "u_lz") }
  u_f4v(render3d_st, loc, LZ_MAX * 4, render3d_st.lz_u)
}
