  grass_q_r: float = 0.0            # ... and no blades past this (0: the kind's own radius)
  grass_s0: float = 0.0            # float bits: blade spacing at the camera (m)
  grass_d0: float = 0.0            # the distance at which the spacing has doubled (m)
