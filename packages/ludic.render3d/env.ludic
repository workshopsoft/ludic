  gsl_dlss_ok: bool = false         # what this adapter can run, from slIsFeatureSupported
  gsl_rr_ok: bool = false
  gsl_fg_ok: bool = false
  gsl_reflex_ok: bool = false
  gsl_pcl_ok: bool = false
