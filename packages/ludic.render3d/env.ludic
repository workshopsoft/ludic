  ue_tod_on: int = -1              # the hour's grade into Unreal's settings: 1 on, 0 off, -1 not read yet (R3D_UE_HOUR_GRADE)
  ue_tod_vol: UePpVolume = null    # its unbound, lowest-priority volume (ue_tod_grade)
  ue_sky_s: UeSky = null           # Unreal's Sky Atmosphere settings (ue_sky.ludic r3d_sky_atmosphere)
  ue_sky_on: int = -1              # 1 on, 0 off, -1 not read yet (R3D_UE_SKY)
  ue_sky_trans: Target = null      # the transmittance LUT
  ue_sky_ms: Target = null         # the multi-scattering LUT
  ue_sky_view: Target = null       # the sky view LUT
  ue_sky_version: float = -1.0     # the atmosphere the two LUTs were made for
  ue_sky_frame: floats = null      # the sky view LUT's frame and the view height (ue_sky_view_data)
  ue_sky_tmp: floats = null
  ue_sky_pt: int = 0               # ue_atmosphere.frag UA_TRANSMITTANCE
  ue_sky_pm: int = 0               # UA_MULTISCAT
  ue_sky_pv: int = 0               # UA_SKYVIEW
  ue_fog_s: UeFog = null           # Unreal's exponential height fog settings (ue_fog.ludic r3d_height_fog)
  ue_fog_on: int = -1              # 1 on, 0 off, -1 not read yet (R3D_UE_FOG)
  ue_ap: Target = null             # the aerial perspective volume, unwrapped
  ue_distant: Target = null        # the distant sky light, 1x1
  ue_ap_p: int = 0                 # ue_atmosphere.frag UA_AP
  ue_distant_p: int = 0            # UA_DISTANT
  ue_fog_t: Target = null          # the fog's inscattering and transmittance at screen size
  ue_fog_p: int = 0                # ue_fog.frag
  ue_fog_ap: int = 0               # ue_fog_apply.frag
  ue_fog_tmp: floats = null
  ue_sl_s: UeSkyLight = null       # Unreal's sky light settings (ue_skylight.ludic r3d_sky_light)
  ue_sl_on: int = -1               # 1 on, 0 off, -1 not read yet (R3D_UE_SKYLIGHT)
  ue_sl_size: int = 0              # the cube's size the atlases were made for
  ue_sl_mips: int = 0
  ue_sl_cap: int = 0               # the capture's even mips (2D array atlas)
  ue_sl_cap2: int = 0              # its odd mips
  ue_sl_flt: int = 0               # the GGX-filtered cube (atlas)
  ue_sl_cap_fb: words = null       # a framebuffer a layer of each
  ue_sl_cap2_fb: words = null
  ue_sl_flt_fb: words = null
  ue_sl_sh: Target = null          # the packed SH, 7x1
  ue_sl_pc: int = 0                # ue_skylight.frag SL_CAPTURE
  ue_sl_pd: int = 0                # SL_DOWNSAMPLE
  ue_sl_pf: int = 0                # SL_FILTER
  ue_sl_ps: int = 0                # SL_SH
  ue_sl_frame: int = 0             # frames since the first, for capture_interval
  ue_sl_ready: bool = false        # captured at least once
  ue_sl_step: int = 0              # the time-sliced capture's next step (ue_skylight.ludic UE_SL_STEPS)
  ue_sl_slice: int = -1            # time-sliced (R3D_UE_SKYLIGHT_SLICE=0: the whole capture each time); -1 until read
  ue_sun_on: int = -1              # Unreal's atmosphere sun light: 1 on, 0 off, -1 not read yet (R3D_UE_SUNLIGHT)
  ue_sun_t: floats = null          # the sun's ground transmittance (daylight_set)
  ue_sun_i: floats = null          # its outer-space illuminance (daylight_set)
  ue_vf_s: UeVolFog = null         # Unreal's volumetric fog settings (ue_volfog.ludic r3d_volumetric_fog)
  ue_vf_on: int = -1               # 1 on, 0 off, -1 not read yet (R3D_UE_VOLFOG)
  ue_vf_gw: int = 0                # the grid: tiles across, down, slices
  ue_vf_gh: int = 0
  ue_vf_gz: int = 0
  ue_vf_a: int = 0                 # the scattering grids (this frame's and last frame's swap), 2D arrays a slice a layer
  ue_vf_b: int = 0
  ue_vf_i: int = 0                 # the integrated grid
  ue_vf_fb_a: words = null         # a framebuffer a layer of each
  ue_vf_fb_b: words = null
  ue_vf_fb_i: words = null
  ue_vf_flip: bool = false         # which grid is this frame's
  ue_vf_hist_ok: bool = false      # last frame's grid is there to reproject
  ue_vf_ready: bool = false        # the integrated grid has been drawn
  ue_vf_prev_vp: floats = null     # last frame's clean view-projection
  ue_vf_zp: floats = null          # GridZParams
  ue_vf_frame: int = 0             # for the jitter's Halton index
  ue_vf_ps: int = 0                # ue_volfog.frag VF_SCATTER
  ue_vf_pi: int = 0                # VF_INTEGRATE
  ue_vf_pc: int = 0                # VF_CDEPTH
  ue_vf_cd_a: Target = null        # the conservative depth, a texel a tile (this frame's and last frame's swap with the grids)
  ue_vf_cd_b: Target = null
  ue_vf_cd_ok: bool = false        # last frame's conservative depth is there
  ue_vf_pm: int = 0                # VF_INTEGRATE VF_CARRY, the march
  ue_vf_carry_a: Target = null     # the march's running sum, slice to slice (even slices write a, odd b)
  ue_vf_carry_b: Target = null
  ue_vf_fb_m: words = null         # a framebuffer a layer of the integrated grid with the carry beside it
  ue_vf_ta: Target = null          # VF_ATLAS: the scattering grids (they swap as ue_vf_a and b do) and the integrated one, a tile a slice
  ue_vf_tb: Target = null
  ue_vf_ti: Target = null
  ue_vf_tx: int = 0                # the atlas's tiles across and down
  ue_vf_ty: int = 0
  ue_vf_cdq: Target = null         # the depth's 4 x 4 furthest (VF_CDEPTH_DOWN), the conservative depth's input
  ue_vf_psa: int = 0               # VF_SCATTER VF_ATLAS
  ue_vf_pia: int = 0               # VF_INTEGRATE VF_ATLAS
  ue_vf_pcd: int = 0               # VF_CDEPTH_DOWN
  ue_fog_pa: int = 0               # ue_fog.frag VF_ATLAS
  ue_lls: []UeLocalLight = null    # Unreal's local lights (ue_lights.ludic ue_light_add)
  ue_ll_on: int = -1               # 1 on, 0 off, -1 not read yet (R3D_UE_LIGHTS)
  ue_ll_env: bool = false          # R3D_LL read
  ue_ll_n: int = 0                 # this frame's lights sent to the shaders
  ue_ll_max: int = 0               # the most lights a frame (R3D_UE_LL_MAX)
  ue_ll_data: floats = null        # the forward light buffer's contents, 20 floats a light (ue_lights_frame)
  @owns(GpuBuffer) ue_ll_buf: int = 0             # ... on the GPU (lighting.glsl u_ue_lights)
  ue_ll_sph: floats = null         # the frame's shadow-casting lights' spheres (kgpu's caster cull)
  ue_ll_nsph: int = 0
  ue_ll_dbg: int = 0
  ue_ll_cull: bool = true          # gather local light casters from the lights' bounds (R3D_UE_LS_CULL)
  ue_ll_tan: floats = null         # per light: tan(outer cone) for the grid's cone test, 0 none
  ue_ll_pick: floats = null        # the selection: indices and distances
  ue_ll_pd: floats = null
  ue_ll_tmp: floats = null
  ue_lg_on: int = -1               # Unreal's light grid: 1 on, 0 off, -1 not read yet (R3D_UE_LIGHT_GRID)
  ue_lg: UeLightGrid = null        # its settings
  ue_lg_prog: int = 0              # the cull (ue_lightgrid.comp)
  @owns(GpuBuffer) ue_lg_bpos: int = 0            # the lights' view-space positions and radii
  @owns(GpuBuffer) ue_lg_bdir: int = 0            # their view-space directions and tan(cone)
  @owns(GpuBuffer) ue_lg_bnum: int = 0            # per cell: count, first (written by the cull)
  @owns(GpuBuffer) ue_lg_bdata: int = 0           # every cell's lights' indices (one list)
  @owns(GpuBuffer) ue_lg_balloc: int = 0          # its allocator (zeroed each frame)
  ue_lg_zero: words = null
  ue_lg_cap_num: int = 0
  ue_lg_cap_data: int = 0
  ue_lg_bufs: words = null
  ue_lg_pr: words = null           # the cull's parameter block
  ue_lg_vpos: floats = null        # its inputs, filled each frame
  ue_lg_vdir: floats = null
  ue_lg_vp: floats = null          # the view-projection the grid was built with (unjittered)
  ue_lg_proj: floats = null
  ue_lg_iproj: floats = null
  ue_lg_zp: floats = null          # LightGridZParams
  ue_lg_gx: int = 0
  ue_lg_gy: int = 0
  ue_lg_gz: int = 0
  ue_lg_shift: int = 0
  ue_lg_per: int = 0
  ue_lg_built: bool = false        # this frame's grid is ready
  ue_ls_on: int = -1               # Unreal's local light shadow maps: 1 on, 0 off, -1 not read yet (R3D_UE_LIGHT_SHADOWS)
  ue_ls: UeLightShadows = null     # their settings
  @owns(GpuTexture) ue_ls_tex: int = 0          # the spot maps' atlases (layers of r.Shadow.MaxResolution)
  @owns(GpuTexture) ue_lp_tex: int = 0          # the point lights' cube faces' atlases
  @owns(GpuFramebuffer) ue_ls_fbo: int = 0
  ue_ls_size: int = 0              # an atlas's size (r.Shadow.MaxResolution)
  ue_ls_layers: int = 0            # spot atlases made
  ue_lp_layers: int = 0            # point atlases made
  ue_ls_n: int = 0                 # this frame's shadowed spot lights
  ue_lp_n: int = 0                 # ... and point lights
  ue_ls_rec: floats = null         # their records (lighting.glsl ueLsRec / ueLpRec), uploaded to the two buffers
  ue_lp_rec: floats = null
  @owns(GpuBuffer) ue_ls_buf: int = 0
  @owns(GpuBuffer) ue_lp_buf: int = 0
  ue_ls_tiles: words = null        # the frame's tiles to draw (ue_ls_tile)
  ue_ls_ntiles: int = 0
  ue_tl: words = null              # FTextureLayout's nodes, 7 words each
  ue_tl_n: int = 0
  ue_tl_sx: int = 0                # its used size
  ue_tl_sy: int = 0
  ue_ls_m: floats = null           # a map's matrix (scratch)
  ue_lp_tmp: floats = null         # a face's projection and view (scratch)
  ue_lp_view: floats = null
  ue_ls_dbg_c: int = 0             # R3D_UE_LS_DEBUG's count line
  ue_ls_dbg_n: int = 0             # R3D_UE_LS_DEBUG's frame count (a dump every 60)
  sh_local: bool = false           # the casters draw for a local light (no cascade bands or proxies): its sphere below
  sh_local_x: float = 0.0
  sh_local_y: float = 0.0
  sh_local_z: float = 0.0
  sh_local_r: float = 0.0
  post_ldr_hdr: bool = false       # post_ldr was made for HDR10 output (10-bit)
  post_sharpen: float = 0.0
  post_grain: int = 0
  post_adapt_t: []Target = null
  post_adapt_i: int = 0
  post_p_adapt: int = 0
  post_adapt_reset: bool = true
  # temporal anti-aliasing (taa.ludic): on unless R3D_NOTAA, and only while DLSS is not resolving the frame
  taa_want: int = -1               # -1 not asked yet, 0 off (R3D_NOTAA), 1 on
  taa_live: bool = false           # this frame jitters and resolves
  taa_hist: []Target = null        # two HDR histories, ping-ponged: rgb the resolved colour, a its linear depth
  taa_vel: Target = null           # the motion target (RG16F, prev uv - this uv); DLSS reads it too
  taa_vel_fb: int = 0              # it again with the scene's depth, for the moving actors
  sss_light: Target = null         # skin's diffuse light and view depth (sss.ludic)
  sss_alb: Target = null           # its base colour
  sss_fb: int = 0                  # the two with the scene's depth
  sss_p: int = 0                   # sss.frag
  sss_want: int = -1               # R3D_NOSSS, read once
  sss_draws: int = 0               # skin drawn this frame
  st_trans: Target = null          # the strands' transmittance (strands.ludic), made when a groom is first in view
  st_acc: Target = null            # their visibility samples resolved: the front strands' light averaged, the share of samples hit
  st_fb_t: int = 0                 # the transmittance's, with the scene's depth
  st_fb_a: int = 0                 # st_acc's (the resolve's destination)
  st_ms_fb: int = 0                # the visibility pass's: multisampled colour and depth (strands.ludic)
  st_ms_c: int = 0
  st_ms_d: int = 0
  st_ms_n: int = 0                 # its samples
  st_lut: Target = null            # Epic's hair dual scattering LUT (hair_lut.frag), drawn once
  st_p_resolve: int = 0            # strands_resolve.frag
  st_p_lut: int = 0
  st_draws: int = 0                # strands drawn this frame
  st_lod_on: int = -1              # Unreal's hair Auto LOD (r.HairStrands.LODMode 1; R3D_HAIR_AUTOLOD=0 off); -1 until read
  st_lod_bias: float = 0.1         # r.HairStrands.AutoLOD.Bias (R3D_HAIR_AUTOLOD_BIAS)
  st_lod_c: floats = floats(3)     # a groom's bounds' centre in the world (strands_lod)
  st_hs: Target = null             # the hair's deep shadow (strands_shadow_pass): four layers of coverage, its depth the front
  st_hs_fbl: int = 0               # its layers alone (the layer pass reads the front depth)
  st_hs_r: float = 0.0             # the bounds' sphere's radius it was fitted to
  st_hs_on: bool = false           # drawn this frame
  st_hs_view: floats = null
  st_hs_proj: floats = null
  st_hs_tmp: floats = null         # (scratch matrices)
  st_hs_tmp2: floats = null
  st_hs_black: int = 0             # the unit's texture while there is none
  st_vis_on: int = -1              # Unreal's MSAA_Visibility split (R3D_HAIR_VIS=0 off: the strands lit in the visibility pass); -1 unread
  st_wdepth_on: int = -1           # the hair's depth from the composition (R3D_HAIR_DEPTH=0 off: a separate depth draw); -1 unread
  st_dom_fit_on: int = -1          # the deep shadow's tile sized from its screen size (R3D_HAIR_DOM_FIT=0 off: ST_HS_SIZE); -1 unread
  st_p_fill: int = 0               # strands_resolve.frag FILL_DEPTH: the scene's depth into the visibility's
  st_p_resolve_d: int = 0          # strands_resolve.frag WRITE_DEPTH
  st_vs_n: int = 0                 # the visibility's slots this frame (ST_VIS_SLOTS: a head of hair each) and each one's:
  st_vs_fp: floats = floats(272)   #   material (AC_FAB_FLOATS each)
  st_vs_m: floats = floats(64)     #   bind space to the world (the model matrix x the head joint)
  st_vs_c: floats = floats(16)     #   points' centre and largest radius
  st_vs_buf: words = words(4)      #   points' buffer
  st_ivp: floats = floats(16)      # the camera's clip to the world (the visibility's depth to its position)
  st_vp_tmp: floats = floats(16)
  st_hs_res: int = 2048            # the deep shadow's tile this frame (strands_shadow_pass: AddToAtlasTileBin)
  st_hs_tmp3: floats = floats(16)
  st_hs_lvp: floats = floats(16)   # the deep shadow's view-projection for the cards drawn into it (R3D_CARDS_DOM)
  st_hs_pt: floats = floats(4)
  taa_i: int = 0                   # which of the pair is this frame's
  taa_p: int = 0                   # the resolve
  taa_p_mv: int = 0                # the camera's motion from depth
  taa_prev_vp: floats = null       # last frame's clean view-projection
  taa_inv_vp: floats = null        # scratch
  taa_reset: bool = true           # no history worth reading (first frame, a resize, a cut)
  taa_frame: int = 0               # frames resolved, the jitter's phase and the actors' 'seen last frame' stamp
  taa_opaque: bool = false         # post_scene holds this frame's opaque colour (the reactive mask's reference)
  taa_vel_ok: bool = false         # this frame's motion target was written (DLSS reads it too)
  taa_cam_prev: floats = null      # last frame's camera position, for the depth test's slack
  taa_vel_draws: int = 0           # actors the motion pass drew this frame (R3D_TAA_LOG)
  taa_vel_inst_draws: int = 0      # of its draws, the instanced ones (actor_inst.ludic ai_draw_vel: a primitive for a model's movers)
  taa_vel_skips: int = 0           # actors it left to the camera's motion as unchanged since last frame (R3D_VEL_SKIP)
  ac_vel_skip: int = -1            # R3D_VEL_SKIP: 1 skips an unchanged actor (the default), 0 draws every skinned one; -1 not read
  ac_skin4: int = -1               # R3D_SKIN4: 1 a mesh with four influences drawn by the SKIN4 programs (the default), 0 every one by eight
  taa_log: int = -1
  taa_prev_ok: bool = false        # taa_prev_vp and taa_cam_prev hold last frame's (a frame has ended since the targets were made)
  prof_on:      bool = false
  prof_names:   []pointer = null
  prof_ids:     words = null       # PROF_SLOTS * PROF_RING query objects
  prof_used:    words = null       # 1 where that query was written since it was last read (a pass that did not run reads nothing)
  prof_ns:      []long = null      # accumulated nanoseconds per slot
  prof_hits:    []long = null      # samples accumulated per slot
  prof_whole_ns:   long = 0        # the whole frame's GPU time (prof_frame_begin): its sum, its samples, its least, ns
  prof_whole_hits: long = 0
  prof_whole_min:  long = 0
  prof_wall_us:    long = 0        # the wall clock from one frame's prof_collect to the next: its sum and samples, us (R3D_PROF: WALL)
  prof_wall_hits:  long = 0
  prof_wall_last:  long = 0
  prof_min:     []long = null      # the least single sample per slot, ns (a busy GPU only ever adds: the least is the pass's own time)
  prof_n:       int = 0            # slots in use
  prof_skip:    int = 0            # frames after a reset whose results are the frames before it (the ring's latency): not counted
  prof_frame:   int = 0
  prof_active:  int = -1           # slot whose query is currently open
  prof_scratch: words = null
  prof_gen: []int = null
  prof_gen_cur: int = 0
  prof_ft: []long = null         # real frame times, microseconds
  prof_last_us: long = 0
  prof_chunk_us: []long = null
  prof_chunk_kind: []int = null
  prof_chunk_band: []int = null
  prof_chunk_n: []int = null
  prof_gen_us_cur: long = 0
  prof_gen_us: []long = null       # generation microseconds per frame
  prof_layer_us_cur: long = 0      # rebuilding and uploading instance buffers
  prof_bake_us_cur: long = 0       # the height-field shadow rebake
  prof_layer_us: []long = null
  prof_bake_us: []long = null
  prof_dt: []long = null           # frame time, aligned with the arrays above
  prof_up_cur: long = 0            # instance bytes uploaded this frame
  prof_up: []long = null
  prof_pre_swap: long = 0
  prof_cpu_us: []long = null
  prof_sum_dt: long = 0              # sums over the frames past the first eight, for the mean split
  prof_sum_cpu: long = 0
  prof_sum_game: long = 0
  prof_sum_n: int = 0
  prof_mark_last: long = 0
  prof_mark_best: long = 0
  prof_mark_name: pointer = null
  prof_mark_us: []long = null
  prof_mark_who: []pointer = null
  prof_mk_names: []pointer = null
  prof_mk_us: []long = null
  prof_mk_n: int = 0
  prof_game_us_cur: long = 0
  prof_game_us: []long = null
  r3d_root:   string = "packages/ludic.render3d"   # where shaders/ lives
  r3d_assets: string = "assets/polyhaven"          # where the CC0 assets live
  r3d_root_found: bool = false
  r3d_prog_log: int = -1
  q_scratch: floats = floats(16)
  q_sy: floats = null                     # views of q_scratch's second, third and fourth
  q_sz: floats = null
  q_st: floats = null
  r3d_sky_prog: int = 0
  r3d_fog_wall: float = 0.0          # r3d_fog_wall: > 0, nothing but the land past it is drawn
  r3d_fog_land_on: bool = true       # the land draws through the wall (fog_land.ludic); R3D_FOG_LAND=0 hides it too
  r3d_fog_density: float = 0.0
  r3d_fog_falloff: float = 0.0
  r3d_fog_inscatter: float = 0.02   # 0.02, what the shader used to hard-code
  r3d_fog_desat: float = 1.35       # 1.35
  r3d_sky_relight: float = 0.0
  r3d_time: float = 0.0
  r3d_dt: float = 0.0               # seconds since the previous r3d_frame's time (post_adapt_dt)
  r3d_ready: bool = false
  r3d_plate: bool = false
  r3d_small: bool = false        # set before r3d_open: a small UI window (a launcher) - the ring, the memory blocks and the descriptor pools sized for it
  r3d_sky_path: string = null
  r3d_debug: bool = false
  r3d_debug_shadow: bool = false
  r3d_clip_y: float = -2147483600.0            # -2^31: no clipping
  r3d_prepass_env: int = -1
  r3d_test_frame: int = 0
  r3d_test_resize: int = 0
  r3d_no_shadow: bool = false
  r3d_no_trees: bool = false
  r3d_no_refl: bool = false             # the game's: its water setting turns the reflection off
  r3d_env_no_refl: bool = false         # R3D_NOREFL, apart from it: a settings apply wrote over the switch
  r3d_env_no_gi: bool = false           # R3D_NOGI, apart from the setting's post_no_gi and strengths
  r3d_cam_log: int = -1
  sc_prog: int = 0
  sc_prog_fol: int = 0
  sc_prog_wind: int = 0
  sc_prog_blade: int = 0
  sc_prog_flower: int = 0
  sc_prog_card: int = 0
  sc_prog_card_shadow: int = 0
  sc_prog_card_cheap: int = 0
  sc_blade_base: floats = null
  sc_blade_tip: floats = null
  sc_blade_tint: floats = null
  sc_prog_shadow: int = 0
  sc_prog_shadow_wind: int = 0
  sc_prog_shadow_fol: int = 0     # foliage meshes: alpha-tested casters
  sc_prog_fol_depth: int = 0
  sc_prog_fol_eq: int = 0
  sc_prepass: bool = false        # the main pass is drawing over what the prepass laid down
  sc_prepass_lods: int = -2       # R3D_PREPASS_LODS: how many of a tree's mesh levels the prepass draws (-1 all, -2 not read yet)
  sc_imp_prog: int = 0
  sc_imp_prog_shadow: int = 0
  sc_bake_prog: int = 0
  sc_bake_card_prog: int = 0
  sc_bake_flower_prog: int = 0
  sc_card: Mesh = null
  sc_ident_buf: int = 0
  sc_layers: []Layer = null
  sc_debug_dump: bool = false
  sc_printed: bool = false
  sc_dump_n: int = 0
  sc_view_gen: int = 1
  sc_view_pos: floats = null
  sc_view_fwd: floats = null
  sc_cull_prog: int = 0
  sc_cull_tried: bool = false
  sc_ind_base: int = -1             # >= 0: layer_draw_model / layer_draw_depth draw records from here
  sc_ind_n: int = 1                 # records each of those draws covers: one per level of a material
  sc_ind_stride: int = 4            # records between one material's first and the next's (3 for the shadow LOD)
  sc_freeze: bool = false           # a secondary pass (reflection) reuses the partition
  sc_dbg_level: int = -1
  sc_dbg_lod: bool = false
  sc_dbg_tint: floats = null
  sc_cast_all: int = -1
  sc_cast_cull: int = -1              # a streamed layer's casters culled and banded (scatter.ludic layer_casters_make; R3D_SC_CAST_CULL=0 off)
  sc_cast_gen: int = -1
  sc_ss_min: float = -1.0            # Unreal's screen-size cull of instanced layers (scatter.ludic sc_ss_min; R3D_UE_CULL_SCREEN_SIZE, 0 off); -1 until read
  sc_lod_ss_on: int = -1              # a layer's levels chosen by screen size (scatter.ludic layer_lod_screen_sizes; R3D_UE_LOD_SCREEN_SIZE=0: its first level only); -1 until read
  sh_lod_on: int = -1                 # Unreal's shadow LOD (actor.ludic ac_shadow_lod_factor; R3D_UE_SHADOW_LOD=0 off); -1 until read
  sh_lod_f: float = 1.0               # r.Shadow.LODDistanceFactor (R3D_SHADOW_LOD_DISTANCE_FACTOR)
  sh_lod_cs: float = 1.0              # r.Shadow.LODDistanceFactor.CascadeScale (R3D_SHADOW_LOD_CASCADE_SCALE)
  sc_cast_dy: float = 0.0
  sc_cast_k: float = 0.0
  sc_skip_blade: bool = false
  sc_skip_grass: bool = false
  grass_force: bool = false        # R3D_BLADES: the blades on whatever the game set
  grass_env_off: bool = false      # R3D_NOBLADES: the blades off whatever the game set
  sc_skip_card: bool = false
  cb_state: int = 12345
  shadow_res: int = 2048
  shadow_refused: int = 0          # the last size the graphics card had no memory for (0: none)
  sh_tex: int = 0
  sh_fbo: int = 0
  sh_vp: floats = null            # the cascades' view-projections, 16 floats each
  sh_vp_v: [][]float = null       # a view of each
  sh_split: floats = null         # view-space far distance of each cascade
  sh_range: floats = null         # 4 light-frustum depth extents (metres)
  sh_texel: floats = null         # 4 shadow texel sizes (metres)
  sh_tmp_proj: floats = null
  sh_tmp_vp: floats = null
  sh_tmp_inv: floats = null
  sh_tmp_view: floats = null
  sh_corner: floats = null
  sh_cascade: int = 0            # the cascade being rendered (for casters that skip far ones)
  sh_printed2: bool = false
  sh_printed3: bool = false
  sh_force: int = -1   # R3D_FORCE=<c> pins every pixel to cascade c (debug)
  sh_printed: bool = false
  sky_tex: int = 0
  sky_w: int = 0
  sky_h: int = 0
  sky_irradiance: int = 0
  sky_prefilter: int = 0        # GPU_TEXTURE_2D_ARRAY
  sky_brdf: int = 0
  sun_dir: floats = null         # toward the sun (float bits)
  sun_color: floats = null       # radiance (float bits)
  sky_fullscreen: Mesh = null
  sky_yaw: float = 0.0              # radians: the HDRI is turned by this about y
  sky_rot_s: float = 0.0
  sky_rot_c: float = 0.0
  sun_hdri: floats = null        # the sun direction as found in the file
  sky_baked: bool = false      # the IBL set exists, baked at sky_baked_yaw
  sky_baked_yaw: float = 0.0
  sky_p_irr: int = 0
  sky_p_pre: int = 0
  sky_p_brdf: int = 0
  sky_prefilter_w: int = 512
  sky_bake_dir: string = ""         # where the sky's IBL bakes are (sky_baked_in, bake_load.ludic); "" = none
  sky_bake_key: string = ""
  sky_bake_version: int = 0
  sky_bake_said: bool = false       # a missing bake said once
  STREAM_MAX_CHUNKS: int = 4096
  stream_all: []Stream = null
  stream_cap_read: bool = false
  stream_no_evict: bool = false   # R3D_NOEVICT: the old behaviour, for comparison
  stream_walk_no: int = 0        # counts ring walks; a chunk's age is measured in these
  stream_evictions: int = 0
  stream_us_gen: long = 0        # generating new chunks (stream_fill)
  stream_us_gather: long = 0     # copying cached chunks into the layer buffer
  stream_us_walk: long = 0       # the ring walk itself
  stream_walks: int = 0          # streams that walked their whole ring this frame
  stream_debug_n: int = 0
  stream_scratch: floats = null
  gvk_pipe_bufs: words = null      # a pipeline's vertex buffers, while it is made
  gsl_up: floats = floats(3)
  sh_fit_cview: floats = floats(3)         # shadow_fit's scratch
  sh_fit_corners: floats = floats(24)
  sh_fit_center: floats = floats(3)
  sh_fit_eye: floats = floats(3)
  sh_fit_up: floats = floats(3)
  sh_fit_out: floats = floats(16)
  # the cached cascades (shadow_cache.ludic, R3D_UE_SHADOW_CACHE)
  sh_sun: floats = floats(3)               # the sun the shadows are cast along this frame (the live cascade's): stepped while the cache is on
  sh_sun_target: floats = floats(3)        # the step the cache is moving to
  sh_phase: int = 0                        # what the casters callback draws: SH_PHASE_ALL, _STATIC (the cache's) or _DYN (over a cached layer)
  sh_part: int = -1                        # in the static phase, the one part a time slice draws (-1 all)
  sh_cast_slack: float = 0.0               # metres a cache build widens every caster's distance band by (the camera moves inside its window)
  sc_mode: int = -1                        # R3D_UE_SHADOW_CACHE: 0 off, 1 cached, 2 the windows drawn live (to see their texels); -1 unread
  sc_tex: int = 0                          # the cached static depth: a layer each cached cascade, and one spare a rebuild draws into
  sc_res: int = 0                          # the resolution the layers were made at
  sc_slot: words = words(5)                # cascade -> its layer in sc_tex (-1 none)
  sc_spare: int = -1
  sc_valid: words = words(5)               # the cascade's layer holds what its window and sun say
  sc_stale: words = words(5)               # due a rebuild, in the background
  sc_vp: floats = floats(80)               # the cached cascades' view-projections (16 each, by cascade)
  sc_vp_v: [][]float = null
  sc_range: floats = floats(5)
  sc_texel: floats = floats(5)
  sc_cx: floats = floats(5)                # the window's centre, light space
  sc_cy: floats = floats(5)
  sc_sun: floats = floats(15)              # the sun each was cast along
  sc_fwd: floats = floats(15)              # the camera's facing when it was built (the frustum-gathered layers: sc_turn)
  sc_job: int = -1                         # the cascade a time-sliced rebuild is drawing, -1 none
  sc_job_part: int = 0
  sc_jvp: floats = floats(16)              # its window
  sc_jrange: float = 0.0
  sc_jtexel: float = 0.0
  sc_jcx: float = 0.0
  sc_jcy: float = 0.0
  sc_jsun: floats = floats(3)
  sc_urgent: words = words(5)              # rebuilt in full this frame (first frame, a teleport, the camera past a window's edge)
  sc_cull_vp: floats = floats(16)          # the window the big world's casters are culled to for this frame's static draws
  sc_cull: bool = false
  sc_active: bool = false                  # this frame's shadow pass is the cache's (shadow_cache_plan)
  sc_gen: int = 0                          # the static builds made; a still actor's stamp
  sc_dirty: bool = false                   # a still actor moved, came or went: every cached cascade due a rebuild
  sc_shlayers: int = 0                     # sh_layers then
  sc_serial: int = 0                       # the floating origin's rebase serial (shadow_cache_origin) then
  sc_serial_now: int = 0
  sc_cam: floats = floats(3)               # last frame's camera (a jump is a teleport)
  sc_k: float = 0.0                        # the frustum's corner reach (a receiver of view depth z lies within z k)
  sc_pairs: words = words(10)              # the frame's layer copies
  sc_view: floats = floats(16)             # scratch: the light's view for a sun
  sc_proj: floats = floats(16)
  sc_q: floats = floats(3)
  sc_slices: int = 2                       # R3D_UE_SHADOW_CACHE_SLICES
  sc_margin: float = 0.15                  # R3D_UE_SHADOW_CACHE_MARGIN: the window's reach past its cascade, a share of it
  sc_step: float = 1.0                     # R3D_UE_SHADOW_CACHE_SUN_STEP: degrees
  sc_turn: float = 10.0                    # R3D_UE_SHADOW_CACHE_TURN: degrees the camera turns before a background rebuild
  sc_builds: int = 0                       # statistics: full rebuilds at once, time-sliced rebuilds finished
  sc_slow: int = 0
  water_eye: floats = floats(3)            # water_reflection_pass's scratch
  water_mirror: floats = floats(16)
  water_mv: floats = floats(16)
  sc_lod_counts: words = words(64)         # layer_partition_lods' scratch (SC_LOD_ROOM)
  sc_lod_start: words = words(64)
  sc_lod_fill: words = words(64)
  sc_gpu_rec: words = words(29 * 5)        # layer_gpu_prepare's (SC_RECS * 5) and layer_gpu_cull's
  sc_gpu_zeros: words = words(5)
  sc_gpu_pr: words = words(36)
  sc_gpu_bufs: words = words(4)       # the camera's up for DLSS's constants
  ov_nine_buf: floats = floats(16)       # ov_nine's corners and uvs
  gvk_ac: pointer = null           # the VkAllocationCallbacks every create and destroy is given (R3D_ALLOC_VK=1)
  gvk_prime_b: words = null        # buffers made since the frame began, read once so MoltenVK makes their
  @max(16384) gvk_prime_h: []long = null       # Metal buffers now (gvk_prime), and their handles
  gvk_prime_n: int = 0
  gvk_prime_dst: long = 0          # the 64 bytes those reads land in
  gvk_prime_mem: long = 0
  stream_loose: Chunk = null     # the record for a chunk no stream's cache can keep this walk
  stream_deadline: long = 0
  gsl_on: bool = false              # slInit succeeded: the interposer is the loader, the plugins are in
  gsl_dlss_ok: bool = false         # what this adapter can run, from slIsFeatureSupported
  gsl_rr_ok: bool = false
  gsl_fg_ok: bool = false
  gsl_reflex_ok: bool = false
  gsl_pcl_ok: bool = false
  gsl_feats: bytes = null           # kept alive: Preferences points at it
  gsl_logdir: bytes = null          # and at this
  gsl_vp: bytes = null              # sl::ViewportHandle 0, the one view
  gsl_tok_buf: bytes = null
  gsl_idx_buf: bytes = null
  gsl_token: pointer = null         # this frame's sl::FrameToken, owned by Streamline
  gsl_frame_n: int = 0
  gsl_said: bool = false            # one failure message, not one a frame
  gsl_fresh: bool = false           # a token was taken since the last frame started (a present took it)
  gsl_reflex_mode: int = 0          # 0 off, 1 low latency, 2 low latency + boost
  gsl_reflex_applied: int = -1
  gsl_f_sleep: pointer = null
  gsl_f_marker: pointer = null
  gsl_dlss_mode: int = -1           # 0 off, 1 DLAA, 2 quality, 3 balanced, 4 performance; -1 not yet set (gsl_probe_device: quality)
  gsl_opts: bytes = null
  gsl_opt_mode: int = -1
  gsl_opt_w: int = 0
  gsl_opt_h: int = 0
  gsl_rw: int = 0                   # the render size DLSS asked for
  gsl_rh: int = 0
  gsl_set_mode: int = -1
  gsl_set_w: int = 0
  gsl_set_h: int = 0
  gsl_mv: Target = null
  gsl_out: Target = null
  gsl_consts: bytes = null
  gsl_tags: bytes = null
  gsl_res: bytes = null
  gsl_inputs: bytes = null
  gsl_prev_vp: floats = null
  gsl_reset: bool = true
  gsl_jitter_x: float = 0.0             # float bits, NDC offsets the projection carries this frame
  gsl_jitter_y: float = 0.0
  gsl_jpx: float = 0.0                  # float bits, the same in pixels
  gsl_jpy: float = 0.0
  gsl_eval_ok: bool = true         # the last evaluate worked: only then is the next frame jittered
  mfx_mode: int = -1                # MetalFX (mfx.ludic): 0 off, 1 native AA, 2 quality, 3 balanced, 4 performance; -1 not yet set
  mfx_ok: bool = false              # the device has MetalFX's temporal scaler, and its Metal objects came back
  mfx_export: pointer = null        # vkExportMetalObjectsEXT
  mfx_info: bytes = null            # VkExportMetalObjectsInfoEXT, made once
  mfx_obj: bytes = null             # the one export asked for at a time
  mfx_dev: pointer = null           # the MTLDevice
  mfx_queue: pointer = null         # the queue's MTLCommandQueue
  mfx_max_scale: float = 0.0        # the most display / render the device takes
  mfx_scaler: pointer = null        # id<MTLFXTemporalScaler>, made for one input and output size
  mfx_iw: int = 0
  mfx_ih: int = 0
  mfx_ow: int = 0
  mfx_oh: int = 0
  mfx_out: Target = null            # the upscaled colour, at the display's size
  mfx_reset: bool = true
  mfx_eval_ok: bool = true          # the last frame upscaled: only then is the next one jittered
  mfx_frame: int = 0
  mfx_said_usage: bool = false
  mfx_want: int = -1                # the mode asked for (5: auto, upscale.ludic ups_auto_mode), mfx_mode what it resolved to
  mfx_keep: []pointer = null        # R3D_MFX_KEEP: the scalers made for this output size, one per input size (mfx_targets)
  mfx_keep_w: []int = null
  mfx_keep_h: []int = null
  mfx_keep_at: []int = null         # the frame each was last used, the least recent going first
  mfx_early: int = -1               # R3D_MFX_EARLY: the work that does not read the upscaled frame goes before it; -1 unread
  mfx_split_now: bool = false       # this frame went to the queue before the scaler (gvk_frame_split)
  mfx_t_w: int = 0                  # the scaler's command buffers kept for their GPU time (R3D_PROF): written
  mfx_t_r: int = 0                  # and read
  gsl_dlss_want: int = -1           # DLSS's mode asked for (5: auto), gsl_dlss_mode what it resolved to
  ups_auto: int = -1                # R3D_UPSCALE_AUTO: the auto preset picks by the output's width (1) or is quality (0); -1 unread
  ups_sp: float = -1.0              # upscale.ludic: R3D_UE_SCREEN_PERCENTAGE as a fraction, -1 unset
  ups_frac: float = 1.0             # this frame's render size over the display's
  ups_dr: bool = false              # dynamic resolution on
  ups_budget: float = 16.7          # its frame budget, ms
  ups_min: float = 0.5
  ups_max: float = 1.0
  ups_headroom: float = 0.1
  ups_period: int = 8
  ups_steps: int = 20
  ups_log: bool = false
  ups_log_n: int = 0
  ups_cur: float = 1.0              # the fraction the heuristic holds
  ups_since: int = 0                # frames since it last changed
  ups_ignore: int = 0               # timings to drop after a change
  ups_changes: int = 0
  ups_last_ms: float = 0.0
  ups_h_frac: floats = null         # the history: each frame's fraction and GPU ms
  ups_h_ms: floats = null
  ups_h_at: int = 0
  ups_h_n: int = 0
  ups_q_ids: words = null           # the timestamp pairs' ring
  ups_q_used: words = null
  ups_q_frac: floats = null
  ups_q_frame: int = 0
  ups_scratch: words = null
  TERRAIN_HALF: int = 4096          # world half-size in metres (8 km square)
  cd_mesh: Mesh = null
  cd_range: floats = null            # float bits: how far each level is drawn
  cd_min: []floats = null            # per level: min height of each patch (float bits)
  cd_max: []floats = null
  cd_draws: int = 0
  cd_far_draws: int = 0
  cd_near_draws: int = 0
  ter_force_far: bool = false
  ter_no_split: bool = false
  ter_force_near: bool = false
  ter_skip: bool = false
  ter_height_tex: int = 0
  ter_normal_tex: int = 0            # the baked surface normal, x and z in RG16F (y rebuilt when read)
  ter_heights: floats = null         # CPU copy, float bits, TERRAIN_RES^2
  ter_reflect: bool = false          # drawing the reflection: the mid mesh is plenty
  ter_prog: int = 0
  ter_prog_far: int = 0
  ter_prog_near: int = 0           # the detailed tier alone (NEAR_ONLY)
  ter_sun_prog: int = 0            # tersun.frag: sun visibility into a screen buffer
  ter_sun_inline: bool = false     # the ground's shader reads the cascades itself (Vulkan); no sun pass
  ter_sun_tgt: Target = null       # that buffer, at the frame's size
  ter_sun_refl: Target = null      # and at the reflection's, which is smaller
  ter_sun_dumped: bool = false
  ter_sun_checked: bool = false
  ter_sun_done: bool = false      # the caller already ran the pass (so it can time it)
  ter_sun_pass: bool = false       # selection is drawing the visibility pass
  ter_sun_tex: int = 0
  ter_prog_cur: int = 0            # the program currently bound during selection
  ter_smooth: bool = false   # generate the analytic test ground instead of a survey
  ter_far_split: float = 0.0             # metres: beyond this the terrain takes its cheap far path (R3D_TFAR)
  ter_far_band: float = 0.0              # half-width of the near/far blend (R3D_TBAND)
  ter_snow_line: float = 0.0
  ter_rock_line: float = 170.0           # metres (world y): the ground turns to rock by height alone from here ...
  ter_rock_band: float = 130.0           # ... over this much more: a map's treeline (the game sets both per map)
  ter_rock_r: float = 0.385              # the map's rock: its mean albedo (linear) - the tint the scanned rock texture is dyed to ...
  ter_rock_g: float = 0.12
  ter_rock_b: float = 0.09
  ter_rock_strata: float = 0.5           # ... and how hard its bedding shows on the steep faces (0 none, 1 banded)
  ter_tex: words = null             # 11 material textures (see terrain_bind)
  ter_ox: float = 0.0                   # world x/z of the terrain centre (float bits)
  ter_oz: float = 0.0
  ter_dem_tex: int = 0              # a real height map (16-bit), or 0 for the procedural valley
  ter_dem_min: float = 0.0
  ter_dem_max: float = 0.0
  ter_dem_base: float = 0.0
  ter_ortho_tex: int = 0            # a photograph of the same window, draped with distance
  ter_carpet: int = 0               # the distant-grass carpet (carpet_bake), 0 = none
  ter_canopy: int = 0               # the crowns seen past the fog wall (ground_canopy.ludic), 0 = none
  ter_shadow_tex: int = 0           # height-field sun shadow: R32F, the lowest lit height
  stream_capture_c: Chunk = null    # the bake's capture chunk (stream_baked.ludic)
  sb_rec: floats = floats(8)        # one decoded baked record, reused (stream_baked.ludic)
  tb_tiles: string = ""              # the map's baked tiles and shadow (terrain_baked_boot.ludic)
  tb_shadow: string = ""
  tb_key: string = ""
  tb_version: int = 0
  tb_shadow_ok: bool = false         # the shadow came from its bake this map
  gltf_pure: int = 0                # a 1x1 white a factor multiplies exactly (gltf_factors)
  gd_file: pointer = null            # the map's ground densities (ground_density.ludic)
  gd_base: int = 0
  gd_n: int = 0
  gd_layers: int = 0
  gd_ch: words = null
  gd_off: words = null
  gd_pool: []byte = null
  gd_key: words = null
  gd_ref: words = null
  gd_slot_of: words = null
  gd_idx: words = null               # every layer's tile index: (offset, or 0 empty / 1 one value; length or value)
  gd_zbuf: []byte = null             # one tile's deflated bytes as read
  gd_patch: [][]byte = null          # a layer replaced in memory by a dev link's paint: its tiles (ground_density_patch.ludic)
  gd_hand: int = 0
  gd_trample_cb: fn(float, float) -> float = null
  gd_clear: floats = floats(GD_CLEAR_MAX * GD_CLEAR_W)   # the clearings as data, GD_CLEAR_W floats each (ground_clear.ludic)
  gd_clear_n: int = 0
  gd_clear_pts: floats = floats(GD_CLEAR_PTS * 2)   # the areas' and strips' points, (x, z) each
  gd_clear_pn: int = 0
  gd_clear_ver: int = 0              # bumped whenever a clearing is put or the list let go: the blade cull's copy follows it
  gg_clear_buf: int = 0              # the clearings on the GPU, for the blade cull (grass_clear.ludic)
  gg_clear_data: floats = null       # ... the floats sent
  gg_clear_ver: int = -1             # ... and the gd_clear_ver they were sent at
  gx: GroundExtras = new GroundExtras   # the map's edits and heroes over its solid layers (ground_edit.ludic)
  gd_cand: GroundCand = new GroundCand   # ground_fill's candidate, filled and reused
  gb_layer: int = -1                 # the densities' layer the blades grow by; -1: the rules (grass_density.ludic)
  gb_buf: int = 0                    # its window round the camera, on the GPU
  gb_win: words = null               # ... and the window's bytes, four texels a word, made once
  gb_tx: int = -1000000              # the window's first texel in the map, x and z (-1000000: not filled)
  gb_tz: int = 0
  tt_dir: string = ""               # terrain_tiles_to: where a map's tiles are written ("" keeps the whole copies)
  tt_key: string = ""
  tt_file: pointer = null           # the tiles' file, open for reading (terrain_tiles.ludic)
  tt_n: int = 0                     # tiles a side
  tt_oside: int = 0                 # photograph texels a tile a side
  tt_hoff: int = 0                  # where the heights and the photograph start in the file
  tt_ooff: int = 0
  tt_noff: int = 0
  tt_h: floats = null               # TT_SLOTS tiles of heights
  tt_o: words = null                # ... and of photograph, 0xRRGGBB
  tt_nm: words = null               # ... and of normals, RG16F in a word
  tt_tab: floats = null             # per tile: its heights' minimum and step (terrain_ltt2_*.ludic)
  tt_scratch: []byte = null         # one tile's bytes as read
  tt_cnoff: int = 0                 # the coarse normals and photograph in the file
  tt_cooff: int = 0
  tt_baked: bool = false            # the terrain came from a bake: nothing is generated or cut
  tt_coarse: floats = null          # the heights at TT_COARSE a side, for terrain_height_near
  tt_slot_of: words = null          # per tile: its slot, or -1
  tt_tile_in: words = null          # per slot: its tile, or -1
  tt_ref: words = null              # per slot: asked for since the clock's hand last passed
  tt_hand: int = 0
  tt_reads: int = 0                 # tiles read from the file, over the run and this frame
  tt_frame_reads: int = 0
  tt_warned: bool = false
  tf_raw: []byte = buffer(2048)      # the questions' file scratch (terrain_height_file.ludic): a tile's bytes as read,
  tf_h: floats = floats(4096)        # ... TF_KEEP tiles' heights, and which (tile + 1, 0: none)
  tf_tile: words = words(4)
  tf_next: int = 0
  tfo_px: words = words(4)          # ... and TF_KEEP tiles' photograph (sized when a map opens), and which
  tfo_tile: words = words(4)
  tfo_next: int = 0
  tp_on: bool = false               # the GPU pages the fine tiles round the camera (terrain_pages.ludic)
  tp_page_tex: int = 0              # R32F tt_n a side: slot + 1 of each resident tile, 0 = the coarse level
  tp_h_tex: int = 0                 # the pool: heights, normals and photograph, a layer a slot
  tp_n_tex: int = 0
  tp_o_tex: int = 0
  tp_dummy_page: int = 0            # bound while paging is off: an array sampler needs an array
  tp_dummy_h: int = 0
  tp_dummy_n: int = 0
  tp_dummy_o: int = 0
  tp_slots: int = 0
  tp_reach: float = 0.0             # metres the pool was sized for
  tp_page: floats = null            # the page table's CPU mirror, uploaded whole when it changes
  tp_tile_of: words = null          # per slot: its tile, or -1
  tp_free: words = null             # the free slots, a stack
  tp_nfree: int = 0
  tp_dirty: bool = false
  tp_cam_t: int = -1                # the camera's tile when residency last ran
  tp_short: bool = false            # a wanted tile was left for the next frame
  tp_cand: words = null             # this frame's loads, nearest first: their tiles, distances, slots
  tp_cand_d: floats = null
  tp_cand_s: words = null
  tp_zero: words = null             # the one layer a 2-D texture has, for gpu_layers_copy
  tp_st_buf: long = 0               # the staging buffer the loads are written into, two halves
  tp_st_mem: long = 0
  tp_st_ptr: pointer = null
  tp_st_bytes: int = 0
  tp_loads: int = 0                 # tiles loaded over the run, and this frame
  tp_frame_loads: int = 0
  tp_bytes: int = 0                 # the pool's and the page table's GPU bytes
  ter_shadow_prog_aux: int = 0      # the bake of the aux target (TS_AUX)
  ter_shadow_aux: int = 0           # beside it, RG16F: the occluder distance and the cloud mask
  ter_shadow_yaw: float = 1000000000.0  # the sky yaw it was baked for
  ter_shadow_gen: int = -1          # the daylight generation it was baked for
  ter_shadow_prog: int = 0
  ter_lake_level: float = 0.0           # a lake carved into the height map (float bits; ex = 0 → none)
  ter_lake_cx: float = 0.0
  ter_lake_cz: float = 0.0
  ter_lake_ex: float = 0.0
  ter_lake_ez: float = 0.0
  ter_lake_carve: bool = true
  ter_sea_level: float = 0.0
  ter_sea_set: bool = false
  ter_isle_cx: float = 0.0
  ter_isle_cz: float = 0.0
  ter_isle_r: float = 0.0
  ter_isle_fall: float = 0.0
  ter_isle_mode: int = 0
  ter_ortho_px: pointer = null      # the photograph on the CPU (RGB8, TERRAIN_RES^2) for placement rules
  ter_ortho_w: int = 0
  ter_ortho_c: int = 3
  ter_h_scale: float = 0.0
  ter_o_scale: float = 0.0
  ter_bw: floats = floats(8)
  ter_wire: bool = false
  ter_printed: bool = false
  ter_scr: floats = floats(16)
  tex_w: int = 0            # the last decoded image
  tex_h: int = 0
  tex_channels: int = 0
  tex_depth: int = 0        # bits per sample (8 or 16)
  tex_file_len: int = 0
  tex_pf: []PngJob = null        # what tex_prefetch decoded, for png_decode to take (png_jobs.ludic)
  tex_zs: []ZInflate = null      # an inflate context per concurrent decode, made on this thread
  tex_anisotropy: fixed = 16.0
  tex_size_ws: []int = new []int
  tex_size_hs: []int = new []int
  tex_cov: []int = new []int    # by texture id: 1 when its mips keep its alpha coverage (tex_upload_cov)
  tex_cov_ch: int = -1          # the next texture load's coverage channel (0 R .. 3 A; -1 none) and its cut (tex_upload_cov)
  tex_cov_ref: float = 0.0
  tex_cov_cutouts: bool = false  # an actor's cut-out atlases loaded now keep their coverage (tex_coverage_cutouts: the crowd's)
  hdr_max_lum: float = 0.0      # float bits of the brightest texel (sun finding)
  hdr_max_x: int = 0
  hdr_max_y: int = 0
  hdr_sun_r: float = 0.0        # irradiance (float bits) of everything above the IBL clip: the sun
  hdr_sun_g: float = 0.0
  hdr_sun_b: float = 0.0
  hdr_clip: float = 0.0         # float bits; texels above this (per channel) feed the sun, not the IBL
  tex_dump_alpha: bool = false
  water_mesh: Mesh = null
  water_prog: int = 0
  water_level: float = 0.0
  water_cx: float = 0.0
  water_cz: float = 0.0
  water_ex: float = 0.0
  water_ez: float = 0.0
  water_on: bool = false
  water_refl: Target = null            # the world mirrored in the surface, half resolution
  water_refl_div: int = 2              # R3D_REFLDIV overrides: 2 = half res, 4 = quarter
  water_saved: floats = floats(16 * 4 + 3)            # the real camera's matrices, restored after the pass
  water_saved_vp: floats = null         # views of its second and third matrices
  water_saved_ivp: floats = null
  water_dumped: bool = false
  wb_n: int = 0
  wb_level: floats = null
  wb_cx: floats = null
  wb_cz: floats = null
  wb_ex: floats = null
  wb_ez: floats = null
  wb_reflect: words = null
  wb_kind: words = null              # 0: a plane over its bounds; 1: a mesh (water_mesh_add), its own triangles only
  wb_masked: words = null            # 1: a plane drawn only on the wet texels of the wet mask (water_wet.ludic)
  wb_sea: words = null               # 1: the open sea (water_sea.ludic): swell, deep colour, the shore foam band
  wb_wash: words = null              # 1: the thin lapping wash on a still body's edge (0: none; the sea has its foam band instead)
  @max(16) wb_model: []Model = null  # a mesh body's surface, null for a plane
  wb_owned: words = null             # 1: the model was loaded for the body (water_bodies_apply) and goes with it
  water_mesh_prog: int = 0           # water.vert + water.frag for a mesh body (WATER_MESH)
  water_sea_prog: int = 0            # water.vert + water.frag for the sea's planes (WATER_SEA): the sea's code alone
  water_wet: WetMask = null          # the wet mask a masked plane reads (water_wet_use), null: none
  water_swell_a: int = 0             # the sea's baked swell: the long tile and the ripple tile (water_sea.ludic), made when first bound
  water_swell_b: int = 0
  water_wet_page0: int = 0           # the stand-ins bound when there is none: a dry-less page and one empty layer
  water_wet_tiles0: int = 0
  wb_primary: int = -1               # the body the reflection pass mirrors, or -1
  wb_cells: floats = null             # x0, z0, x1, z1 of each rectangle with water showing
  wb_ncells: int = -1                # -1: not built for the current mirrored body
  wb_blocks: words = null            # x0, z0, x1, z1, first cell, cells past the last - of each block
  lz_n: int = 0                      # light zones (lightzone.ludic): how many are kept
  lz: floats = null                  # LZ_STRIDE floats each: centre, yaw's cos and sin, half sizes, feather, ambient, sky
  lz_u: floats = null                # the LZ_MAX nearest the camera, as the shaders take them (4 vec4 each)
  lz_un: int = 0                     # how many of those
  lz_at: floats = null               # the camera they were picked for, x y z (picked again when it moves or a zone changes)
  lz_dirty: bool = true
  zl_n: int = 0                      # zone lamps (zonelamp.ludic): how many are kept
  zl: floats = null                  # x y z each, render space
  zl_u: floats = null                # the ZL_MAX nearest the camera, as the shaders take them (x y z fade)
  zl_d: floats = null                # their squared distances (the pick's sort)
  zl_idx: words = null               # their lamp indices
  zl_un: int = 0                     # how many of those
  zl_at: floats = null               # the camera they were picked for (picked again when it moves or a lamp changes)
  zl_dirty: bool = true
  zl_r: float = 0.0                  # every lamp's radiance, linear
  zl_g: float = 0.0
  zl_b: float = 0.0
  zl_reach: float = 0.0              # how far a lamp's light carries (m)
  zl_far: float = 0.0                # how far from the camera lamps are lit at all (m)
  wb_nblocks: int = 0
  wb_refl_always: int = -1
  wb_dbg: int = -1
  wb_build_us: long = 0              # how long the last water_cells_build took (R3D_REFL_DBG prints it)
  wp_n: int = 0                      # water patches (water_patch.ludic): how many
  wp_level: float = 0.02             # the plane they lie on
  wp_data: floats = null             # x, z, radius, seed of each
  wp_rip: floats = null              # rings: x, z, start time, strength
  wp_rip_tmp: floats = floats(64)    # the rings as the shader takes them (x, z, age, strength)
  wp_rip_next: int = 0
  wp_prog: int = 0
  grass_blade_tex: int = 0
  grass_blade_cols: int = 8
  grass_push_x: float = 0.0
  grass_push_z: float = 0.0
  grass_push_r: float = 0.0
  post_auto: bool = true
  post_contact: float = 1.25   # 1.25: how hard a thing is darkened where it meets the ground
  post_vol_steps: float = 24.0        # 24
  post_vol_far: float = 800.0          # 800 m
  post_vol_g: float = 0.6            # 0.6: air throws light forward
  post_vol_mist_h: float = 40.0       # 40 m
  post_fxaa: float = 1.0
  post_dof_focus: float = 10.0      # 10 m
  post_dof_aperture: float = 0.0            # 0 = no lens, and no pass
  post_dof_max: float = 12.0        # 12 px
  r3d_global_defs: string = ""
  r3d_fog_scale: float = 1.0   # float bits: a setting's multiplier over the density the day sets
  r3d_fog_base: float = 0.0            # the height fog is measured from (float bits); 0 = y = 0
  r3d_ground_alb_r: float = 0.3
  r3d_ground_alb_g: float = 0.34
  r3d_ground_alb_b: float = 0.14
  r3d_ground_hi_r: float = 0.289
  r3d_ground_hi_g: float = 0.28
  r3d_ground_hi_b: float = 0.26
  r3d_ground_hi_y: float = 480.0    # 480
  r3d_ground_hi_w: float = 150.0    # 150
  r3d_dem_path: string = null
  r3d_dem_min: float = 0.0
  r3d_dem_max: float = 0.0
  r3d_dem_base: float = 0.0
  r3d_dem_ox: float = 0.0
  r3d_dem_oz: float = 0.0
  r3d_ortho_path: string = null
  r3d_debug_max: bool = false
  r3d_cloud_shadow: float = 0.5     # 0.5
  sc_a2c: bool = true
  sc_bake_flower: bool = false
  sc_dbg_blade: int = 0
  sc_skip_flower: bool = false
  sh_enabled: bool = true
  sh_skip_terrain: bool = false
  sh_probe_x: float = 0.0
  sh_probe_y: float = 0.0
  sh_probe_z: float = 0.0
  sky_sun_boost: float = 2.3   # 2.3: the photograph's thin cloud dims its sun; a crisper day wants more
  sky_start_yaw: float = 0.0
  sky_disc_dir: floats = floats(3)   # the sun's true direction (daylight.ludic): where the analytic disc is drawn, whatever the light's own is clamped to
  sky_disc_col: floats = floats(3)   # its colour, the daylight's sun before the moon takes the light; all zero until a day runs
  STREAM_BUDGET_US: int = 2500      # microseconds of generation per frame; a setting may move it
  stream_budget_left: int = 0
  ter_wet: float = 0.0
  ter_dem_blur: float = 0.0             # gaussian texels applied to the survey (0 for lidar; ~3 for 30 m data)
  wt_wade_x: float = 0.0
  wt_wade_z: float = 0.0
  wt_wade_s: float = 0.0
}
function r3d_dev(render3d_st: mut Render3dState) -> bool {
  if render3d_st.r3d_dev_v < 0 { if Os.has_env("R3D_DEV") and Os.env("R3D_DEV") != "0" { render3d_st.r3d_dev_v = 1 } else { render3d_st.r3d_dev_v = 0 } }
  return render3d_st.r3d_dev_v == 1
}
# a switch's value, read from the environment the first time it is asked for and kept: the renderer asks for some every frame,
# and a getenv a time was 2 ms of the island's frame (the index of the kept value, -1 when it is not set)
@alloc_ok("made once per resource and kept for its life (a texture, program, sampler, view, layout or memory block is created when first asked for)")
function r3d_env_slot(render3d_st: mut Render3dState, name: string) -> int {
  if render3d_st.r3d_env_seen == null { render3d_st.r3d_env_seen = Dict.new();  render3d_st.r3d_env_vals = new []string }
  var i = Dict.get_or(render3d_st.r3d_env_seen, name, -2)
  if i == -2 {
    i = -1
    if Os.has_env(name) { i = len(render3d_st.r3d_env_vals);  push(render3d_st.r3d_env_vals, Os.env(name)) }
    Dict.set(render3d_st.r3d_env_seen, name, i)
  }
  return i
}
function r3d_env_has(render3d_st: mut Render3dState, name: string) -> bool {
  if is_windowed() and not r3d_dev(render3d_st) { return false }
  return r3d_env_slot(render3d_st, name) >= 0
}
function r3d_env(render3d_st: mut Render3dState, name: string) -> string {
  if is_windowed() and not r3d_dev(render3d_st) { return "" }
  let i = r3d_env_slot(render3d_st, name)
  if i < 0 { return "" }
  return render3d_st.r3d_env_vals[i]
}
