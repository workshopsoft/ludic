  post_bloom_strength: int = 0
  post_vignette: float = 0.0
  post_saturation: float = 0.0
  post_contrast: float = 0.0
  post_w: int = 0
  post_h: int = 0
  post_key: float = 0.0             # target mean luminance after exposure (float bits)
  post_lum: words = null
  post_mips: int = 0
  post_adapt: float = 0.0           # smoothed exposure (float bits)
  post_exposure_max: float = 20.0   # 20: the ceiling auto-exposure may reach (night lowers it)
  # the exposure meter (post_metering, adapt.frag): the band of the frame's histogram it averages, how much
  # it favours the centre, and the stops below and above open ground's exposure the day holds it to
  post_meter_lo: float = 0.3
  post_meter_hi: float = 0.98
  post_meter_centre: float = 0.5
  post_meter_below: float = 3.0
  post_meter_above: float = 1.5
  post_meter_open: float = 0.105    # a frame of open ground's band mean, as a share of the light a level face takes
  # the eye's pace, in seconds (post_adapt_speed): the time constant exposure eases over, by direction
  post_adapt_bright: float = 0.2    # the scene got brighter, exposure falls; 0.2 s is the old 0.08 a frame at 60 Hz
  post_adapt_dark: float = 0.5      # the scene got darker, exposure rises: dark adaptation is the slow one
  post_wb_r: float = 1.02      # 1.02
  post_wb_g: float = 1.0      # 1.0
  post_wb_b: float = 0.97      # 0.97
  post_lift_r: float = 0.004    # 0.004
  post_lift_g: float = 0.004    # 0.004
  post_lift_b: float = 0.012    # 0.012
  post_gain_r: float = 0.99    # 0.99
  post_gain_g: float = 0.995    # 0.995
  post_gain_b: float = 1.0    # 1.0
  post_ao: Target = null
  post_ao_blur: Target = null
  post_p_ao: int = 0
  post_p_ao_blur: int = 0
  post_ao_radius: float = 0.0
  post_ao_intensity: float = 0.0
  post_ao_strength: float = 0.0
  post_gi_strength: float = 0.4     # 0.4
  post_no_gi: bool = false
  post_neutral: int = 0               # a 1x1 black, alpha 1: what the composite reads while the SSAO pass is skipped (an unwritten target holds NaNs)
  post_ldr: Target = null
  post_depth_copy: Target = null
  post_vol: Target = null
  post_p_vol: int = 0
  post_vol_density: float = 0.002      # 0.002
  post_vol_falloff: float = 0.005      # 0.005
  post_vol_mist: float = 0.0                  # the day sets these two
  post_prev: Target = null       # last frame's scene colour, for the SSGI bounce only
  post_scene: Target = null      # this frame's scene colour before the water, for refraction
  post_frame: int = 0
  post_color_w: int = 0          # its size: the display's when DLSS upscaled it
  post_color_h: int = 0
  post_color: int = 0            # the HDR colour the rest of post reads      # the resolved depth, copied so passes can read it while drawing into the frame
  post_p_sharp: int = 0
  post_p_dof: int = 0
  post_dof: Target = null
