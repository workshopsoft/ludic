  post_ms_samples: int = 1      # temporal AA carries the edges; R3D_MSAA=n to compare
  post_bloom: []Target = null
  post_p_down: int = 0
  post_p_up: int = 0
  post_p_tone: int = 0
  post_fs: Mesh = null
