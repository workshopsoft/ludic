  gsl_frame_n: int = 0
  gsl_said: bool = false            # one failure message, not one a frame
  gsl_fresh: bool = false           # a token was taken since the last frame started (a present took it)
  gsl_reflex_mode: int = 0          # 0 off, 1 low latency, 2 low latency + boost
  gsl_reflex_applied: int = -1
  gsl_f_sleep: pointer = null
  gsl_f_marker: pointer = null
  gsl_dlss_mode: int = 0            # 0 off, 1 DLAA, 2 quality, 3 balanced, 4 performance
