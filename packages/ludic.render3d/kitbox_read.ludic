# kitbox_read.ludic - a box kit's anchors (kitbox.ludic) read from its glTF on the CPU: the renderer's own reader, no device,
# so a bake program reads them as the game's set-up does (bigworld_gpu.ludic bw_setup_kits).
numbers float

# The anchors of node `node`'s mesh in dir/file read on the CPU (no device: a bake reads them too) into `out`, also its
# positions, anchors and offsets when `pos` is not null (3, 4 and 3 floats a vertex, every primitive in turn, anchors 0 on a
# mesh without them: a test's reference). false when the file or node cannot be read; out.on false when the mesh has no _ANCHOR (an ordinary kit).
@alloc_ok("a kit being read: the file's accessors, once")
export function kitbox_read(render3d_st: mut Render3dState, dir: string, file: string, node: string, out: KitBox, pos: []float, anc: []float, off: []float) -> bool {
  if not gltf_open(render3d_st, dir, file) { return false }
  let nodes = value_get(render3d_st.gltf_doc, "nodes")
  var mi = -1
  for i in 0 .. value_count(nodes) {
    let nd = value_at(nodes, i)
    if value_has(nd, "name") != 0 and value_as_str(value_get(nd, "name")) == node { mi = jint(nd, "mesh", -1) }
  }
  if mi < 0 { file_close(render3d_st.gltf_bin);  render3d_st.gltf_bin = null;  return false }
  let prims = value_get(value_at(value_get(render3d_st.gltf_doc, "meshes"), mi), "primitives")
  for p in 0 .. value_count(prims) {
    let attrs = value_get(value_at(prims, p), "attributes")
    if value_has(attrs, "POSITION") == 0 { continue }
    let ps = gltf_accessor_floats(render3d_st, value_as_int(value_get(attrs, "POSITION")))
    let nv = render3d_st.gltf_count
    var a: floats = null
    var o: floats = null
    if value_has(attrs, "_ANCHOR") != 0 { a = gltf_accessor_floats(render3d_st, value_as_int(value_get(attrs, "_ANCHOR"))) }
    if a != null and value_has(attrs, "_OFFSET") != 0 { o = gltf_accessor_floats(render3d_st, value_as_int(value_get(attrs, "_OFFSET"))) }
    for v in 0 .. nv {
      var sx = 0.0;  var sz = 0.0;  var sh = 0.0;  var sd = 0.0
      var ox = 0.0;  var oy = 0.0;  var oz = 0.0
      if a != null {
        sx = a[v * 4];  sz = a[v * 4 + 1];  sh = a[v * 4 + 2];  sd = a[v * 4 + 3]
        if o != null { ox = o[v * 3];  oy = o[v * 3 + 1];  oz = o[v * 3 + 2] }
        kitbox_add(out, sx, sz, sh, sd, ox, oy, oz)
      }
      if pos != null {
        push(pos, ps[v * 3]);  push(pos, ps[v * 3 + 1]);  push(pos, ps[v * 3 + 2])
        push(anc, sx);  push(anc, sz);  push(anc, sh);  push(anc, sd)
        push(off, ox);  push(off, oy);  push(off, oz)
      }
    }
  }
  file_close(render3d_st.gltf_bin)
  render3d_st.gltf_bin = null
  return true
}

# Kit `k`'s proxy colours (its HLOD box's walls and roof: hlod_colour_tri, hlod_colour_apply) from node `node`'s mesh in dir/file, read
# on the CPU as kitbox_read reads the anchors: every triangle in its material's base colour as the kit shader draws it (the
# baseColorFactor; an untextured material that states none draws the renderer's white, 200 of 255). A box kit's mesh is its reference
# instance, which is what the ratios of its faces need. false, and the row left as it is, when the file or node cannot be read or the
# mesh has a texture or vertex colours (a picture's average is not this reader's: such a kit states its colours in its row).
@alloc_ok("a bake: a kit's accessors, once")
export function kit_proxy_read(render3d_st: mut Render3dState, dir: string, file: string, node: string, k: RenderKit) -> bool {
  if not gltf_open(render3d_st, dir, file) { return false }
  let doc = render3d_st.gltf_doc
  let nodes = value_get(doc, "nodes")
  var mi = -1
  for i in 0 .. value_count(nodes) {
    let nd = value_at(nodes, i)
    if value_has(nd, "name") != 0 and value_as_str(value_get(nd, "name")) == node { mi = jint(nd, "mesh", -1) }
  }
  var ok = mi >= 0
  let acc = floats(HLOD_COL_ACC)
  for i in 0 .. HLOD_COL_ACC { acc[i] = 0.0 }
  if ok {
    let prims = value_get(value_at(value_get(doc, "meshes"), mi), "primitives")
    for p in 0 .. value_count(prims) {
      let pv = value_at(prims, p)
      let attrs = value_get(pv, "attributes")
      if value_has(attrs, "POSITION") == 0 { continue }
      if value_has(attrs, "COLOR_0") != 0 { ok = false;  break }
      var r = 200.0 / 255.0
      var g = r
      var b = r
      if value_has(pv, "material") != 0 {
        let mat = value_at(value_get(doc, "materials"), value_as_int(value_get(pv, "material")))
        if gltf_mat_uri(render3d_st, mat, "baseColorTexture") != null or gltf_mat_bv(render3d_st, mat, "baseColorTexture") >= 0 { ok = false;  break }
        if value_has(mat, "pbrMetallicRoughness") != 0 {
          let pbr = value_get(mat, "pbrMetallicRoughness")
          if value_has(pbr, "baseColorFactor") != 0 {
            let f = value_get(pbr, "baseColorFactor")
            if value_count(f) >= 3 { r = jnum(value_at(f, 0));  g = jnum(value_at(f, 1));  b = jnum(value_at(f, 2)) }
          }
        }
      }
      let pos = gltf_accessor_floats(render3d_st, value_as_int(value_get(attrs, "POSITION")))
      let nv = len(pos) / 3
      var nrm: floats = null
      if value_has(attrs, "NORMAL") != 0 { nrm = gltf_accessor_floats(render3d_st, value_as_int(value_get(attrs, "NORMAL"))) }
      if nrm != null and len(nrm) != nv * 3 { nrm = null }
      if value_has(pv, "indices") != 0 {
        let idx = gltf_accessor_ints(render3d_st, value_as_int(value_get(pv, "indices")))
        var t = 0
        while t + 2 < len(idx) {
          if idx[t] < nv and idx[t + 1] < nv and idx[t + 2] < nv { hlod_colour_tri(acc, pos, nrm, idx[t], idx[t + 1], idx[t + 2], r, g, b) }
          t += 3
        }
      } else {
        var t = 0
        while t + 2 < nv {
          hlod_colour_tri(acc, pos, nrm, t, t + 1, t + 2, r, g, b)
          t += 3
        }
      }
    }
  }
  file_close(render3d_st.gltf_bin)
  render3d_st.gltf_bin = null
  if not ok { return false }
  return hlod_colour_apply(acc, k)
}

# Kit node `node`'s coarse shape from its mesh in dir/file (hlod_parts: at most max_parts boxes in the kit's own frame, HLOD_PART floats
# each), every primitive's triangles read on the CPU as kit_proxy_read reads them; null when the file or node cannot be read or has no
# triangle. A bake hands the result to hlod_bake_parts (a landmark drawn far off as a few boxes that follow it)
@alloc_ok("a bake: the triangles of one kit, once")
export function kit_parts_read(render3d_st: mut Render3dState, dir: string, file: string, node: string, max_parts: int) -> floats {
  if not gltf_open(render3d_st, dir, file) { return null }
  let doc = render3d_st.gltf_doc
  let nodes = value_get(doc, "nodes")
  var mi = -1
  for i in 0 .. value_count(nodes) {
    let nd = value_at(nodes, i)
    if value_has(nd, "name") != 0 and value_as_str(value_get(nd, "name")) == node { mi = jint(nd, "mesh", -1) }
  }
  var tri = floats(9 * 256)
  var nt = 0
  if mi >= 0 {
    let prims = value_get(value_at(value_get(doc, "meshes"), mi), "primitives")
    for p in 0 .. value_count(prims) {
      let pv = value_at(prims, p)
      let attrs = value_get(pv, "attributes")
      if value_has(attrs, "POSITION") == 0 { continue }
      let pos = gltf_accessor_floats(render3d_st, value_as_int(value_get(attrs, "POSITION")))
      let nv = len(pos) / 3
      var idx: words = null
      var n = nv / 3
      if value_has(pv, "indices") != 0 {
        idx = gltf_accessor_ints(render3d_st, value_as_int(value_get(pv, "indices")))
        n = len(idx) / 3
      }
      for t in 0 .. n {
        var a = t * 3
        var b = t * 3 + 1
        var c = t * 3 + 2
        if idx != null { a = idx[t * 3];  b = idx[t * 3 + 1];  c = idx[t * 3 + 2] }
        if a >= nv or b >= nv or c >= nv { continue }
        if (nt + 1) * 9 > len(tri) {
          let more = floats(len(tri) * 2)
          for q in 0 .. nt * 9 { more[q] = tri[q] }
          free(tri)
          tri = more
        }
        for q in 0 .. 3 {
          tri[nt * 9 + q] = pos[a * 3 + q]
          tri[nt * 9 + 3 + q] = pos[b * 3 + q]
          tri[nt * 9 + 6 + q] = pos[c * 3 + q]
        }
        nt += 1
      }
    }
  }
  file_close(render3d_st.gltf_bin)
  render3d_st.gltf_bin = null
  let out = hlod_parts(tri, nt, max_parts)
  free(tri)
  return out
}

# Kit node `node`'s triangles read on the CPU for a collider (the drawn mesh itself, every primitive): its distinct vertices appended to
# vtx (10 floats each: x y z, the anchors sx sz sh sd, the offset ox oy oz; anchors and offset 0 on an ordinary kit) and its triangles
# to tri (3 indices each, counted from the first vertex this call appends). Vertices equal in all ten are one (a hard edge's split
# normals are not a seam to a body). The vertices it appended, -1 when the file or node cannot be read.
@alloc_ok("a kit read once for its collider: the file's accessors")
export function kit_tris_read(render3d_st: mut Render3dState, dir: string, file: string, node: string, vtx: []float, tri: []int) -> int {
  if not gltf_open(render3d_st, dir, file) { return -1 }
  let doc = render3d_st.gltf_doc
  let nodes = value_get(doc, "nodes")
  var mi = -1
  for i in 0 .. value_count(nodes) {
    let nd = value_at(nodes, i)
    if value_has(nd, "name") != 0 and value_as_str(value_get(nd, "name")) == node { mi = jint(nd, "mesh", -1) }
  }
  if mi < 0 { file_close(render3d_st.gltf_bin);  render3d_st.gltf_bin = null;  return -1 }
  let base = len(vtx) / 10
  let one = floats(10)
  let prims = value_get(value_at(value_get(doc, "meshes"), mi), "primitives")
  for p in 0 .. value_count(prims) {
    let pv = value_at(prims, p)
    let attrs = value_get(pv, "attributes")
    if value_has(attrs, "POSITION") == 0 { continue }
    let ps = gltf_accessor_floats(render3d_st, value_as_int(value_get(attrs, "POSITION")))
    let nv = len(ps) / 3
    var a: floats = null
    var o: floats = null
    if value_has(attrs, "_ANCHOR") != 0 { a = gltf_accessor_floats(render3d_st, value_as_int(value_get(attrs, "_ANCHOR"))) }
    if a != null and value_has(attrs, "_OFFSET") != 0 { o = gltf_accessor_floats(render3d_st, value_as_int(value_get(attrs, "_OFFSET"))) }
    # this primitive's vertices, each mapped to its distinct vertex
    let map = words(max(nv, 1))
    for v in 0 .. nv {
      one[0] = ps[v * 3];  one[1] = ps[v * 3 + 1];  one[2] = ps[v * 3 + 2]
      for k in 3 .. 10 { one[k] = 0.0 }
      if a != null {
        one[3] = a[v * 4];  one[4] = a[v * 4 + 1];  one[5] = a[v * 4 + 2];  one[6] = a[v * 4 + 3]
        if o != null { one[7] = o[v * 3];  one[8] = o[v * 3 + 1];  one[9] = o[v * 3 + 2] }
      }
      var found = -1
      let have = len(vtx) / 10
      var u = base
      while u < have and found < 0 {
        var same = true
        var k = 0
        while k < 10 and same {
          if vtx[u * 10 + k] != one[k] { same = false }
          k += 1
        }
        if same { found = u }
        u += 1
      }
      if found < 0 {
        for k in 0 .. 10 { push(vtx, one[k]) }
        found = have
      }
      map[v] = found - base
    }
    if value_has(pv, "indices") != 0 {
      let idx = gltf_accessor_ints(render3d_st, value_as_int(value_get(pv, "indices")))
      var t = 0
      while t + 2 < len(idx) {
        if idx[t] < nv and idx[t + 1] < nv and idx[t + 2] < nv { push(tri, map[idx[t]]);  push(tri, map[idx[t + 1]]);  push(tri, map[idx[t + 2]]) }
        t += 3
      }
    } else {
      var t = 0
      while t + 2 < nv {
        push(tri, map[t]);  push(tri, map[t + 1]);  push(tri, map[t + 2])
        t += 3
      }
    }
  }
  file_close(render3d_st.gltf_bin)
  render3d_st.gltf_bin = null
  return len(vtx) / 10 - base
}
