# terrain_bake.ludic - the ground's levels of detail, made once, offline: every tile of a map's 16-bit height PNGs
# (the studio's `world_create`) cut into patches and levels and written as one mesh file a tile (tilemap_lwt.ludic), which
# the game streams (tilemap_draw.ludic). The game makes none of it.
#
#   ludic build packages/ludic.render3d/tools/terrain_bake.ludic
#   ./build/terrain_bake <tiles> <tile_size> <tile_res> <cols> <rows> <origin_x> <origin_z> <height_min> <height_max> [height_offset] [out] [patch_texels] [lock] [mask] [tol] [under] [sink] [rise] [holes]
#
#   <tiles>          the row's `tiles` pattern, with {tx} and {tz} ("assets/maps/meridian/terrain/{tx}_{tz}.png")
#   tile_size ... height_max   the row's fields of those names (tile_cols and tile_rows for <cols> and <rows>)
#   height_offset    the row's offset, default 0
#   out              where the files go, with {tx} and {tz}: default <tiles> with .lwt for .png (the game's default, or the row's `tile_mesh`)
#   patch_texels     the patch size in texels, default 128 (the game's tmap_patches must say the same: the file records its cut)
#   lock             the land-use classes no level may move the ground under, comma separated ("3,4,5,1": road, sidewalk,
#                    pad, shore in the game's numbering), default none: the LOD lock (tilemap_bake.ludic TmLock)
#   mask             the land-use mask tiles, {tx} and {tz}: default <tiles> with .mask.png for .png (tilemap_mask.ludic)
#   tol              metres a locked texel may move at any level (rise; and sink when sink is not given), default 0.005
#   under            the locked classes a surface of their own is drawn over ("3,4": road, sidewalk), default none: under them
#                    the ground only stays under the surface and meets its edge (an edge texel moves within tol and sink, one
#                    inside rises at most `rise` and may sink any depth: tilemap_bake.ludic TmLock)
#   sink             metres a locked texel (but a covered one inside) may sink, default tol
#   rise             metres a covered texel inside may rise, default tol
#   holes            the land-use classes with no ground drawn (a tunnel's mouth), default none (tilemap_bake.ludic TmLock)
#
# It reads the PNGs and writes files only: no window, no device, nothing of the game runs. A bake over a whole map is heavy
# work (every tile is read with its neighbours) and is a person's to start, or a package.ludic `hook before build`:
#
#   hook before build "ludic run packages/ludic.render3d/tools/terrain_bake.ludic -- assets/maps/meridian/terrain/{tx}_{tz}.png 1024 512 16 16 -8192 -8192 -40 600"
#
# The same code is exercised on a small map by tests/tilemap_test.ludic.
import "ludic.render3d/r3d.ludic"
program TerrainBake {
  numbers float

  # argument i, "" when it was not given (reading past the count is out of bounds)
  function given(i: int) -> string {
    if i >= Os.arg_count() { return "" }
    let s = Os.arg(i)
    if s == null { return "" }
    return s
  }

  function num(i: int, fallback: float) -> float {
    let s = given(i)
    if s == "" { return fallback }
    return Text.to_float(s)
  }

  handler Boot(render3d_st: mut Render3dState) phase Start {
    let tiles = given(1)
    if tiles == "" or given(9) == "" {
      print("usage: terrain_bake <tiles> <tile_size> <tile_res> <cols> <rows> <origin_x> <origin_z> <height_min> <height_max> [height_offset] [out] [patch_texels] [lock classes] [mask] [tol] [under classes] [sink] [rise] [hole classes]")
      exit(2)
      return
    }
    let res = int(num(3, 512.0))
    let problem = tmap_problem(tiles, num(2, 0.0), res, int(num(4, 0.0)), int(num(5, 0.0)), num(8, 0.0), num(9, 0.0))
    if problem != "" {
      print(`terrain_bake: {problem}`)
      exit(2)
      return
    }
    let tm = tmap_new(tiles, num(2, 0.0), res, int(num(4, 0.0)), int(num(5, 0.0)), num(6, 0.0), num(7, 0.0), num(8, 0.0), num(9, 0.0), num(10, 0.0), 0.0)
    tmap_patches(tm, int(num(12, 128.0)))
    var out = given(11)
    if out == "" { out = tm.mesh_pattern }
    var lock: TmLock = null
    let classes = given(13)
    if classes != "" {
      let cs = new []int
      let parts = Text.split(classes, ",")
      for i in 0 .. len(parts) { if Text.trim(parts[i]) != "" { push(cs, int(Text.to_float(Text.trim(parts[i])))) } }
      var mask = given(14)
      if mask == "" { mask = tmap_mask_pattern_of(tiles) }
      lock = tmb_lock_new(mask, cs)
      lock.tol = num(15, 0.005)
      let under = given(16)
      if under != "" {
        let us = new []int
        let ups = Text.split(under, ",")
        for i in 0 .. len(ups) { if Text.trim(ups[i]) != "" { push(us, int(Text.to_float(Text.trim(ups[i])))) } }
        tmb_lock_under(lock, us)
      }
      lock.sink = num(17, -1.0)
      lock.rise = num(18, -1.0)
      let holes = given(19)
      if holes != "" {
        let hs = new []int
        let hps = Text.split(holes, ",")
        for i in 0 .. len(hps) { if Text.trim(hps[i]) != "" { push(hs, int(Text.to_float(Text.trim(hps[i])))) } }
        tmb_lock_holes(lock, hs)
      }
    }
    let n = tmb_map_locked(render3d_st, tm, out, lock)
    print(`terrain_bake: {n} tiles baked ({tm.patches} x {tm.patches} patches of {tm.patch_texels} texels, {tm.lod_max + 1} levels) into {out}; {tm.no_file} tiles have no usable PNG`)
    if lock != null { print(`terrain_bake: lock: {lock.locked} locked texels; {lock.locked_levels} patch levels cut down where they would move one ({lock.tris} triangles where their own grids had {lock.tris_own})`) }
    if n == 0 { exit(1) }
    quit()
  }
}
