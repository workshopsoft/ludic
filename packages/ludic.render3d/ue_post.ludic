# ============================================================================
# ue_post.ludic — Unreal's post-process settings and its colour grading + filmic tonemapper.
#
# UePost is UE 5.8's FPostProcessSettings (Engine/Classes/Engine/Scene.h) for the parts ported so far, with the defaults of its
# constructor (Engine/Private/Scene.cpp FPostProcessSettings::FPostProcessSettings) and Unreal's names. Each frame the grading is
# baked into a LUT (combine_luts.frag: PostProcessCombineLUTs.usf, a r.LUT.Size^3 volume drawn unwrapped) and the tonemap pass reads it
# (tonemap.frag ueTonemap: PostProcessTonemap.usf MainPS). A game edits the settings in place: `let pp = r3d_pp(st);  pp.film_slope = 0.9`.
#
# Flags: R3D_UE_TONEMAP=0 (or r3d_ue_tonemap(st, false)) puts the old tonemapper back; on by default. HDR10 output keeps the old path
# until Unreal's HDR output transform is ported.
# ============================================================================

# grading ranges and controls: u_grade[range * 5 + control] in combine_luts.frag
export const UE_GRADE_GLOBAL: int = 0
export const UE_GRADE_SHADOWS: int = 1
export const UE_GRADE_MIDTONES: int = 2
export const UE_GRADE_HIGHLIGHTS: int = 3
export const UE_CC_SATURATION: int = 0
export const UE_CC_CONTRAST: int = 1
export const UE_CC_GAMMA: int = 2
export const UE_CC_GAIN: int = 3
export const UE_CC_OFFSET: int = 4

property UePost {
  # Color Grading|Temperature
  temp_is_white_balance: bool = true,      # TemperatureType: TEMP_WhiteBalance (true) or TEMP_ColorTemperature
  white_temp: float = 6500.0,              # WhiteTemp
  white_tint: float = 0.0,                 # WhiteTint
  # Color Grading|Global, Shadows, Midtones, Highlights: ColorSaturation/Contrast/Gamma/Gain/Offset (FVector4: rgb, and w the
  # luminance multiplier), 4 ranges x 5 controls x 4 floats, set with ue_pp_grade
  grade: floats = null,
  color_correction_shadows_max: float = 0.09,      # ColorCorrectionShadowsMax
  color_correction_highlights_min: float = 0.5,    # ColorCorrectionHighlightsMin
  color_correction_highlights_max: float = 1.0,    # ColorCorrectionHighlightsMax
  # Color Grading|Misc
  blue_correction: float = 0.6,            # BlueCorrection
  expand_gamut: float = 1.0,               # ExpandGamut
  tone_curve_amount: float = 1.0,          # ToneCurveAmount
  scene_color_tint_r: float = 1.0,         # SceneColorTint
  scene_color_tint_g: float = 1.0,
  scene_color_tint_b: float = 1.0,
  # Film (TonemappingMethod Filmic)
  film_slope: float = 0.88,                # FilmSlope
  film_toe: float = 0.55,                  # FilmToe
  film_shoulder: float = 0.26,             # FilmShoulder
  film_black_clip: float = 0.0,            # FilmBlackClip
  film_white_clip: float = 0.04,           # FilmWhiteClip
  # Lens|Image Effects
  vignette_intensity: float = 0.4,         # VignetteIntensity (VignetteType CosineFourthLaw)
  # r.LUT.Size and r.BackbufferQuantizationDitheringOverride (0: from the target's bit depth)
  lut_size: int = 32,
  dither_bits: int = 0,
  # Lens|Exposure, AutoExposureMethod Histogram: a UE5 project's defaults (r.DefaultFeature.AutoExposure.ExtendDefaultLuminanceRange 1,
  # so brightness and the histogram's range are in EV100; r.DefaultFeature.AutoExposure.Bias 1)
  auto_exposure_bias: float = 1.0,                 # AutoExposureBias (stops)
  auto_exposure_low_percent: float = 10.0,         # AutoExposureLowPercent
  auto_exposure_high_percent: float = 90.0,        # AutoExposureHighPercent
  auto_exposure_min_brightness: float = -10.0,     # AutoExposureMinBrightness (EV100)
  auto_exposure_max_brightness: float = 20.0,      # AutoExposureMaxBrightness (EV100)
  auto_exposure_speed_up: float = 3.0,             # AutoExposureSpeedUp (stops a second)
  auto_exposure_speed_down: float = 1.0,           # AutoExposureSpeedDown
  histogram_log_min: float = -10.0,                # HistogramLogMin (EV100)
  histogram_log_max: float = 20.0,                 # HistogramLogMax (EV100)
  extended_luminance_range: bool = true,           # r.DefaultFeature.AutoExposure.ExtendDefaultLuminanceRange
  lens_attenuation: float = 0.78,                  # r.EyeAdaptation.LensAttenuation
  exponential_transition_distance: float = 1.5,    # r.EyeAdaptation.ExponentialTransitionDistance (stops)
  black_histogram_bucket_influence: float = 0.0,   # r.EyeAdaptation.BlackHistogramBucketInfluence
  histogram_lod: int = 1,                          # the scene mip metered: 1 half resolution (Unreal's), 2 quarter (cheaper)
  # Lens|Bloom, BloomMethod BM_SOG (Gaussian): sizes in percent of the view, tints rgb; Bloom1 the smallest
  bloom_intensity: float = 0.675,                  # BloomIntensity
  bloom_gaussian_intensity: float = 1.0,           # BloomGaussianIntensity
  bloom_size_scale: float = 4.0,                   # BloomSizeScale
  bloom_size: floats = null,                       # Bloom1Size .. Bloom6Size: 0.3, 1, 2, 10, 30, 64
  bloom_tint: floats = null,                       # Bloom1Tint .. Bloom6Tint (rgb): 0.3465, 0.138, 0.1176, 0.066, 0.066, 0.061
  bloom_quality: int = 5,                          # r.BloomQuality: 1..5 stages used 3, 3, 4, 5, 6; 0 off
  gaussian_bloom_cross: float = 0.0,               # r.GaussianBloom.Cross
  filter_size_scale: float = 1.0,                  # r.Filter.SizeScale
  # Lens|Image Effects lens flares (PostProcessLensFlares): off as Unreal ships them (r.DefaultFeature.LensFlare 0 sets the
  # intensity to 0; 1 gives Scene.cpp's 1.0); R3D_UE_LENS_FLARE=1 turns them on
  lens_flare_intensity: float = 0.0,               # LensFlareIntensity
  lens_flare_tint: floats = null,                  # LensFlareTint (rgb) 1, 1, 1
  lens_flare_bokeh_size: float = 3.0,              # LensFlareBokehSize (percent of the view)
  lens_flare_threshold: float = 8.0,               # LensFlareThreshold
  lens_flare_tints: floats = null,                 # LensFlareTints[8] (rgba; a scales the flare's size)
  lens_flare_quality: int = 2,                     # r.LensFlareQuality: 0 off, 1 .. 3 the downsample stage read (2 a quarter)
  # Lens|Local Exposure, LocalExposureMethod Bilateral (PostProcessLocalExposure): Unreal's engine defaults, where it is off (both
  # contrast scales and the detail strength 1: the passes are skipped); new projects' templates use 0.8. R3D_UE_LOCAL_EXPOSURE=<scale>
  # sets both contrast scales
  local_exposure_highlight_contrast_scale: float = 1.0,   # LocalExposureHighlightContrastScale
  local_exposure_shadow_contrast_scale: float = 1.0,      # LocalExposureShadowContrastScale
  local_exposure_detail_strength: float = 1.0,            # LocalExposureDetailStrength
  local_exposure_blurred_luminance_blend: float = 0.6,    # LocalExposureBlurredLuminanceBlend
  local_exposure_blurred_luminance_kernel_size_percent: float = 50.0,  # LocalExposureBlurredLuminanceKernelSizePercent
  local_exposure_middle_grey_bias: float = 0.0,           # LocalExposureMiddleGreyBias
  local_exposure_highlight_threshold: float = 0.0,        # LocalExposureHighlightThreshold
  local_exposure_shadow_threshold: float = 0.0,           # LocalExposureShadowThreshold
  local_exposure_highlight_threshold_strength: float = 1.0,  # LocalExposureHighlightThresholdStrength
  local_exposure_shadow_threshold_strength: float = 1.0      # LocalExposureShadowThresholdStrength
}

# the settings, made with Unreal's defaults the first time they are asked for
@alloc_ok("made once per resource and kept for its life (a texture, program, sampler, view, layout or memory block is created when first asked for)")
export function r3d_pp(render3d_st: mut Render3dState) -> UePost {
  if render3d_st.ue_pp == null {
    let pp = new UePost
    pp.grade = floats(4 * 5 * 4)
    for r in 0 .. 4 {
      for c in 0 .. 5 {
        var v = 1.0
        if c == UE_CC_OFFSET { v = 0.0 }
        ue_pp_grade(pp, r, c, v, v, v, v)
      }
    }
    pp.bloom_size = floats(6)
    pp.bloom_tint = floats(18)
    pp.lens_flare_tint = floats(3)
    for c in 0 .. 3 { pp.lens_flare_tint[c] = 1.0 }
    # FPostProcessSettings' LensFlareTints
    pp.lens_flare_tints = floats(32)
    let lt = [1.0, 0.8, 0.4, 0.6, 1.0, 1.0, 0.6, 0.53, 0.8, 0.8, 1.0, 0.46, 0.5, 1.0, 0.4, 0.39, 0.5, 0.8, 1.0, 0.31, 0.9, 1.0, 0.8, 0.27, 1.0, 0.8, 0.4, 0.22, 0.9, 0.7, 0.7, 0.15]
    for k in 0 .. 32 { pp.lens_flare_tints[k] = lt[k] }
    if r3d_env_has(render3d_st, "R3D_UE_LENS_FLARE") and r3d_env(render3d_st, "R3D_UE_LENS_FLARE") == "1" { pp.lens_flare_intensity = 1.0 }
    if r3d_env_has(render3d_st, "R3D_UE_LOCAL_EXPOSURE") {
      let le = ue_parse_float(r3d_env(render3d_st, "R3D_UE_LOCAL_EXPOSURE"))
      pp.local_exposure_highlight_contrast_scale = le;  pp.local_exposure_shadow_contrast_scale = le
    }
    let sizes = [0.3, 1.0, 2.0, 10.0, 30.0, 64.0]
    let tints = [0.3465, 0.138, 0.1176, 0.066, 0.066, 0.061]
    for k in 0 .. 6 {
      pp.bloom_size[k] = sizes[k]
      for c in 0 .. 3 { pp.bloom_tint[k * 3 + c] = tints[k] }
    }
    render3d_st.ue_pp = pp
  }
  return render3d_st.ue_pp
}

# one grading control of one range: Unreal's FVector4 (r, g, b, and w applied to all three)
export function ue_pp_grade(pp: UePost, range: int, control: int, r: float, g: float, b: float, w: float) -> void {
  if pp == null or range < 0 or range > 3 or control < 0 or control > 4 { return }
  let i = (range * 5 + control) * 4
  pp.grade[i] = r;  pp.grade[i + 1] = g;  pp.grade[i + 2] = b;  pp.grade[i + 3] = w
}

# Unreal's tonemapper on or off (R3D_UE_TONEMAP=0 turns it off at start)
export function r3d_ue_tonemap(render3d_st: mut Render3dState, on: bool) -> void {
  render3d_st.ue_tonemap = 0
  if on { render3d_st.ue_tonemap = 1 }
}
function ue_tonemap_on(render3d_st: mut Render3dState) -> bool {
  if render3d_st.ue_tonemap < 0 {
    render3d_st.ue_tonemap = 1
    if r3d_env_has(render3d_st, "R3D_UE_TONEMAP") and r3d_env(render3d_st, "R3D_UE_TONEMAP") == "0" { render3d_st.ue_tonemap = 0 }
  }
  return render3d_st.ue_tonemap == 1
}

# the settings this frame's passes use: resolved at the camera once a frame (ue_pp_frame), the base until then
function ue_pp_now(render3d_st: mut Render3dState) -> UePost {
  if render3d_st.ue_pp_final == null { return r3d_pp(render3d_st) }
  return render3d_st.ue_pp_final
}
function ue_pp_frame(render3d_st: mut Render3dState) -> void {
  ue_ppv_env(render3d_st)
  let c = render3d_st.cam_pos
  if c == null { return }
  ue_pp_resolve(render3d_st, c[0], c[1], c[2])
}

# GetTonemappingMax: Filmic to an sRGB device leaves headroom to 1.05
const UE_LUT_MAX: float = 1.05

# CombineLUTs: the grading baked into the unwrapped LUT. Remade when its size changes; drawn every frame (32 x 32 x 32 texels).
function ue_lut_pass(render3d_st: mut Render3dState) -> void {
  let pp = ue_pp_now(render3d_st)
  let n = max(min(pp.lut_size, 64), 16)
  if render3d_st.ue_lut != null and render3d_st.ue_lut.h != n { target_free(render3d_st, render3d_st.ue_lut);  render3d_st.ue_lut = null }
  if render3d_st.ue_lut == null { render3d_st.ue_lut = target_new(render3d_st, n * n, n, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR) }
  if render3d_st.ue_lut_p == 0 { render3d_st.ue_lut_p = r3d_program(render3d_st, "fullscreen.vert", "combine_luts.frag", "") }
  prof_begin(render3d_st, "combine LUTs")
  let p = render3d_st.ue_lut_p
  target_bind(render3d_st, render3d_st.ue_lut)
  gpu_depth_test(render3d_st, false)
  gpu_blend(render3d_st, false)
  gpu_use_program(render3d_st, p)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_size"), float(n))
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_white_temp"), pp.white_temp)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_white_tint"), pp.white_tint)
  var wb = 0.0
  if pp.temp_is_white_balance { wb = 1.0 }
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_temp_is_wb"), wb)
  u_f4v(render3d_st, gpu_uniform(render3d_st, p, "u_grade"), 20, pp.grade)
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "u_cc_range"), pp.color_correction_shadows_max, pp.color_correction_highlights_min, pp.color_correction_highlights_max)
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "u_misc"), pp.blue_correction, pp.expand_gamut, pp.tone_curve_amount)
  u_f4(render3d_st, gpu_uniform(render3d_st, p, "u_film"), pp.film_slope, pp.film_toe, pp.film_shoulder, pp.film_black_clip)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_film_white_clip"), pp.film_white_clip)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_lut_inv_max"), 1.0 / UE_LUT_MAX)
  mesh_draw(render3d_st, render3d_st.post_fs)
  prof_end(render3d_st)
}

# The tonemap program's Unreal uniforms (u_ue 0 when off). Call with the tonemap program in use; binds the LUT at unit 5.
function ue_tonemap_bind(render3d_st: mut Render3dState, prog: int) -> void {
  var on = 0.0
  if ue_tonemap_on(render3d_st) and not gpu_hdr_active(render3d_st) and render3d_st.ue_lut != null { on = 1.0 }
  u_f(render3d_st, gpu_uniform(render3d_st, prog, "u_ue"), on)
  if on < 0.5 { return }
  let pp = ue_pp_now(render3d_st)
  r3d_bind_2d(render3d_st, prog, "u_lut", 5, render3d_st.ue_lut.color)
  u_f(render3d_st, gpu_uniform(render3d_st, prog, "u_lut_size"), float(render3d_st.ue_lut.h))
  u_f(render3d_st, gpu_uniform(render3d_st, prog, "u_lut_max"), UE_LUT_MAX)
  u_f3(render3d_st, gpu_uniform(render3d_st, prog, "u_scene_tint"), pp.scene_color_tint_r, pp.scene_color_tint_g, pp.scene_color_tint_b)
  let w = max(render3d_st.post_ldr.w, 1)
  u_f4(render3d_st, gpu_uniform(render3d_st, prog, "u_vignette_ue"), pp.vignette_intensity, float(render3d_st.post_ldr.h) / float(w), 0.0, 0.0)
  let fi = render3d_st.post_frame % 8                       # OutputFrameIndexMod8
  u_f2(render3d_st, gpu_uniform(render3d_st, prog, "u_grain_rand"), gsl_halton(fi % 1024, 2), gsl_halton(fi % 1024, 3))
  var bits = 8                                              # post_ldr is RGBA8 in SDR
  if pp.dither_bits > 0 { bits = pp.dither_bits }
  u_f(render3d_st, gpu_uniform(render3d_st, prog, "u_dither"), 1.0 / (Math.pow(2.0, float(bits)) - 1.0))
  # Unreal's bloom carries its intensity in its tints; nothing drawn reads as black
  if ue_bloom_on(render3d_st) {
    var bl = render3d_st.ue_bloom_tex
    if bl == 0 { bl = render3d_st.post_neutral }
    r3d_bind_2d(render3d_st, prog, "u_bloom", 1, bl)
    u_f(render3d_st, gpu_uniform(render3d_st, prog, "u_bloom_strength"), 1.0)
  }
  ue_local_exposure_bind(render3d_st, prog)
}

# ---- Unreal's eye adaptation (histogram) -----------------------------------------------------------------------------------------
# PostProcessEyeAdaptation.cpp GetEyeAdaptationParameters turned into the two passes' uniforms; ue_histogram.frag bins the scene and
# ue_eye_adapt.frag averages, adapts and writes the exposure scale the tonemapper multiplies by (post_adapt_t, as adapt.frag did).
# R3D_UE_EXPOSURE=0 (or r3d_ue_exposure(st, false)) puts the old meter back; on by default.
const UE_HIST_ROWS: int = 4

export function r3d_ue_exposure(render3d_st: mut Render3dState, on: bool) -> void {
  render3d_st.ue_exposure = 0
  if on { render3d_st.ue_exposure = 1 }
}
function ue_exposure_on(render3d_st: mut Render3dState) -> bool {
  if render3d_st.ue_exposure < 0 {
    render3d_st.ue_exposure = 1
    if r3d_env_has(render3d_st, "R3D_UE_EXPOSURE") and r3d_env(render3d_st, "R3D_UE_EXPOSURE") == "0" { render3d_st.ue_exposure = 0 }
  }
  return render3d_st.ue_exposure == 1
}

# post_hdr's mips are built (post_measure) before this runs
function ue_exposure_pass(render3d_st: mut Render3dState) -> void {
  let pp = ue_pp_now(render3d_st)
  let lod = max(min(pp.histogram_lod, 3), 0)
  let hw = max(render3d_st.post_hdr.w >> lod, 1)
  let hh = max(render3d_st.post_hdr.h >> lod, 1)
  let bands = (hh + UE_HIST_ROWS - 1) / UE_HIST_ROWS
  if render3d_st.ue_hist != null and render3d_st.ue_hist.h != bands { target_free(render3d_st, render3d_st.ue_hist);  render3d_st.ue_hist = null }
  if render3d_st.ue_hist == null { render3d_st.ue_hist = target_new(render3d_st, 16, bands, GPU_RGBA32F, GPU_RGBA, GPU_FLOAT, false, GPU_NEAREST) }
  if render3d_st.ue_hist_p == 0 { render3d_st.ue_hist_p = r3d_program(render3d_st, "fullscreen.vert", "ue_histogram.frag", "") }
  if render3d_st.ue_adapt_p == 0 { render3d_st.ue_adapt_p = r3d_program(render3d_st, "fullscreen.vert", "ue_eye_adapt.frag", "") }
  # LuminanceMaxFromLensAttenuation, and the ranges in log2 luminance (EV100ToLog2, EV100ToLuminance)
  var lum_max = 1.0
  if pp.extended_luminance_range { lum_max = 0.78 / Math.max(pp.lens_attenuation, 0.01) }
  let log2_lum_max = Math.log(lum_max) / Math.log(2.0)
  var log_max = pp.histogram_log_max
  var log_min = pp.histogram_log_min
  var min_white = pp.auto_exposure_min_brightness
  var max_white = pp.auto_exposure_max_brightness
  if pp.extended_luminance_range {
    log_max = pp.histogram_log_max + log2_lum_max
    log_min = pp.histogram_log_min + log2_lum_max
    min_white = lum_max * Math.pow(2.0, pp.auto_exposure_min_brightness)
    max_white = lum_max * Math.pow(2.0, pp.auto_exposure_max_brightness)
  }
  log_min = Math.min(log_min, log_max - 1.0)
  min_white = Math.min(min_white, max_white)
  let hist_scale = 1.0 / (log_max - log_min)
  let hist_bias = -log_min * hist_scale
  # kept for local exposure (its grid and the tonemapper bin the same way)
  render3d_st.ue_hist_scale = hist_scale;  render3d_st.ue_hist_bias = hist_bias;  render3d_st.ue_lum_min = Math.pow(2.0, log_min)
  let high = Math.clamp(pp.auto_exposure_high_percent, 1.0, 99.0) * 0.01
  let low = Math.min(Math.clamp(pp.auto_exposure_low_percent, 1.0, 99.0) * 0.01, high)
  # the exponential tail's slope matched to the linear part at StartDistance (kFrameTimeEps 1/60)
  let eps = 1.0 / 60.0
  let start_up = pp.exponential_transition_distance / Math.max(pp.auto_exposure_speed_up, 0.001)
  let start_down = pp.exponential_transition_distance / Math.max(pp.auto_exposure_speed_down, 0.001)
  let m_up = eps / ((1.0 - Math.pow(2.0, -eps * pp.auto_exposure_speed_up)) * start_up)
  let m_down = eps / ((1.0 - Math.pow(2.0, -eps * pp.auto_exposure_speed_down)) * start_down)
  prof_begin(render3d_st, "UE histogram")
  var p = render3d_st.ue_hist_p
  target_bind(render3d_st, render3d_st.ue_hist)
  gpu_depth_test(render3d_st, false)
  gpu_blend(render3d_st, false)
  gpu_use_program(render3d_st, p)
  r3d_bind_2d(render3d_st, p, "u_scene", 0, render3d_st.post_hdr.color)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_lod"), float(lod))
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_size"), float(hw), float(hh))
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_rows"), float(UE_HIST_ROWS))
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_scale_bias"), hist_scale, hist_bias)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_lum_min"), Math.pow(2.0, log_min))
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_black"), pp.black_histogram_bucket_influence)
  mesh_draw(render3d_st, render3d_st.post_fs)
  prof_end(render3d_st)
  prof_begin(render3d_st, "UE eye adaptation")
  let next = 1 - render3d_st.post_adapt_i
  p = render3d_st.ue_adapt_p
  target_bind(render3d_st, render3d_st.post_adapt_t[next])
  gpu_use_program(render3d_st, p)
  r3d_bind_2d(render3d_st, p, "u_hist", 0, render3d_st.ue_hist.color)
  r3d_bind_2d(render3d_st, p, "u_prev", 1, render3d_st.post_adapt_t[render3d_st.post_adapt_i].color)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_bands"), float(bands))
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_percent"), low, high)
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_scale_bias"), hist_scale, hist_bias)
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_avg_lum"), min_white * 0.18, max_white * 0.18)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_compensation"), Math.pow(2.0, pp.auto_exposure_bias))
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_speed"), pp.auto_exposure_speed_up, pp.auto_exposure_speed_down)
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_exp_m"), m_up, m_down)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_start_distance"), pp.exponential_transition_distance)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_dt"), render3d_st.r3d_dt)
  var force = 0.0
  if render3d_st.post_adapt_reset { force = 1.0;  render3d_st.post_adapt_reset = false }
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_force"), force)
  mesh_draw(render3d_st, render3d_st.post_fs)
  render3d_st.post_adapt_i = next
  prof_end(render3d_st)
}

# ---- Unreal's Gaussian bloom (BM_SOG) ----------------------------------------------------------------------------------------------
# PostProcessBloomSetup.cpp AddGaussianBloomPasses over the scene downsample chain (FTextureDownsampleChain: half resolution, then each
# stage half the last, ue_downsample.frag), each stage AddGaussianBlurPass (PostProcessWeightedSampleSum.cpp): an X pass (half width
# when the radius reaches r.FastBlurThreshold 7) and a Y pass weighted by the stage's tint x (1/6) x BloomIntensity x
# BloomGaussianIntensity, plus the previous (larger) stage's result. The last stage's output, at half resolution, is the bloom the
# tonemapper adds. BloomThreshold -1 (Unreal's default) needs no setup pass; a threshold is not ported yet.
# R3D_UE_BLOOM=0 (or r3d_ue_bloom(st, false)) puts the old pyramid back; on by default, with Unreal's tonemapper only.
const UE_BLOOM_STAGES: int = 6
const UE_FILTER_SAMPLES_MAX: int = 32           # MAX_FILTER_COMPILE_TIME_SAMPLES (SM5, r.Filter.LoopMode 0)
const UE_FAST_BLUR_THRESHOLD: float = 7.0       # r.FastBlurThreshold

export function r3d_ue_bloom(render3d_st: mut Render3dState, on: bool) -> void {
  render3d_st.ue_bloom = 0
  if on { render3d_st.ue_bloom = 1 }
}
function ue_bloom_on(render3d_st: mut Render3dState) -> bool {
  if render3d_st.ue_bloom < 0 {
    render3d_st.ue_bloom = 1
    if r3d_env_has(render3d_st, "R3D_UE_BLOOM") and r3d_env(render3d_st, "R3D_UE_BLOOM") == "0" { render3d_st.ue_bloom = 0 }
  }
  return render3d_st.ue_bloom == 1 and ue_tonemap_on(render3d_st) and not gpu_hdr_active(render3d_st)
}

@alloc_ok("a world being set up (a stream, a layer, water, post, a bake): the map loading or swapping, not a frame")
function ue_bloom_targets(render3d_st: mut Render3dState, w: int, h: int) -> void {
  if render3d_st.ue_bl_down != null and render3d_st.ue_bl_w == w and render3d_st.ue_bl_h == h { return }
  if render3d_st.ue_bl_down != null {
    for k in 0 .. UE_BLOOM_STAGES {
      target_free(render3d_st, render3d_st.ue_bl_down[k]);  target_free(render3d_st, render3d_st.ue_bl_hx[k])
      target_free(render3d_st, render3d_st.ue_bl_hxh[k]);  target_free(render3d_st, render3d_st.ue_bl_out[k])
    }
  }
  render3d_st.ue_bl_down = new []Target;  render3d_st.ue_bl_hx = new []Target
  render3d_st.ue_bl_hxh = new []Target;  render3d_st.ue_bl_out = new []Target
  var sw = w;  var sh = h
  for k in 0 .. UE_BLOOM_STAGES {
    sw = max((sw + 1) / 2, 1);  sh = max((sh + 1) / 2, 1)
    push(render3d_st.ue_bl_down, target_new(render3d_st, sw, sh, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR))
    push(render3d_st.ue_bl_hx, target_new(render3d_st, sw, sh, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR))
    push(render3d_st.ue_bl_hxh, target_new(render3d_st, max((sw + 1) / 2, 1), sh, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR))
    push(render3d_st.ue_bl_out, target_new(render3d_st, sw, sh, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR))
  }
  if render3d_st.ue_bl_ofs == null { render3d_st.ue_bl_ofs = floats(UE_FILTER_SAMPLES_MAX * 4);  render3d_st.ue_bl_wt = floats(UE_FILTER_SAMPLES_MAX * 4) }
  render3d_st.ue_bl_w = w;  render3d_st.ue_bl_h = h
}

# NormalDistributionUnscaled
function ue_gauss(x: float, sigma: float, cross: float) -> float {
  let dx = Math.abs(x)
  let one_minus = Math.max(0.0, 1.0 - dx)
  if cross > 1.0 { return Math.pow(one_minus, cross) }
  let g = Math.exp(-16.7 * (dx / sigma) * (dx / sigma))
  return g + (one_minus - g) * cross
}

# Compute1DGaussianFilterKernel into ue_bl_ofs (x: the offset in texels) and ue_bl_wt (x: the weight); returns the tap count
function ue_gauss_kernel(render3d_st: mut Render3dState, radius: float, cross: float, size_scale: float) -> int {
  let maxr = float(UE_FILTER_SAMPLES_MAX - 1)
  let clamped = Math.clamp(radius, 0.00001, maxr)
  let ir = min(int(Math.ceil(Math.clamp(radius * Math.clamp(size_scale, 0.1, 10.0), 0.00001, maxr))), UE_FILTER_SAMPLES_MAX - 1)
  var n = 0
  var sum = 0.0
  var i = -ir
  while i <= ir {
    let w0 = ue_gauss(float(i), clamped, cross)
    var w1 = 0.0
    if i != ir { w1 = ue_gauss(float(i + 1), clamped, cross) }
    let t = w0 + w1
    render3d_st.ue_bl_ofs[n * 4] = float(i) + w1 / t
    render3d_st.ue_bl_wt[n * 4] = t
    sum += t
    n += 1
    i += 2
  }
  for k in 0 .. n { render3d_st.ue_bl_wt[k * 4] = render3d_st.ue_bl_wt[k * 4] / sum }
  return n
}

# one blur pass: taps from ue_gauss_kernel along (dx, dy) in uv, weighted by rgb (the X pass white, the Y pass the tint)
function ue_blur_draw(render3d_st: mut Render3dState, dst: Target, src: int, src_w: int, src_h: int, n: int, horizontal: bool, r: float, g: float, b: float, add: int) -> void {
  let p = render3d_st.ue_blur_p
  # unpack the kernel: offsets to uv along the axis, weights to rgba (the tint's alpha is 1 in Unreal's FLinearColor)
  var k = n - 1
  while k >= 0 {
    let o = render3d_st.ue_bl_ofs[k * 4]
    let w = render3d_st.ue_bl_wt[k * 4]
    if horizontal { render3d_st.ue_bl_ofs[k * 4] = o / float(src_w);  render3d_st.ue_bl_ofs[k * 4 + 1] = 0.0 }
    else { render3d_st.ue_bl_ofs[k * 4] = 0.0;  render3d_st.ue_bl_ofs[k * 4 + 1] = o / float(src_h) }
    render3d_st.ue_bl_wt[k * 4] = w * r;  render3d_st.ue_bl_wt[k * 4 + 1] = w * g;  render3d_st.ue_bl_wt[k * 4 + 2] = w * b;  render3d_st.ue_bl_wt[k * 4 + 3] = w
    k -= 1
  }
  target_bind(render3d_st, dst)
  gpu_use_program(render3d_st, p)
  r3d_bind_2d(render3d_st, p, "u_src", 0, src)
  var add_on = 0.0
  if add != 0 { add_on = 1.0;  r3d_bind_2d(render3d_st, p, "u_add", 1, add) } else { r3d_bind_2d(render3d_st, p, "u_add", 1, src) }
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_add_on"), add_on)
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_out_inv"), 1.0 / float(dst.w), 1.0 / float(dst.h))
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_count"), float(n))
  u_f4v(render3d_st, gpu_uniform(render3d_st, p, "u_ofs"), UE_FILTER_SAMPLES_MAX, render3d_st.ue_bl_ofs)
  u_f4v(render3d_st, gpu_uniform(render3d_st, p, "u_w"), UE_FILTER_SAMPLES_MAX, render3d_st.ue_bl_wt)
  mesh_draw(render3d_st, render3d_st.post_fs)
}

# BloomQualityToSceneDownsampleStage: r.BloomQuality 1..5 -> 3, 3, 4, 5, 6 stages
function ue_bloom_stage_count(q: int) -> int {
  if q <= 0 { return 0 }
  if q <= 2 { return 3 }
  return q + 1
}

# the bloom texture the tonemapper reads (0 when off or nothing was drawn)
function ue_bloom_pass(render3d_st: mut Render3dState) -> int {
  let pp = ue_pp_now(render3d_st)
  let q = max(min(pp.bloom_quality, 5), 0)
  if q == 0 { return 0 }
  ue_bloom_targets(render3d_st, render3d_st.post_color_w, render3d_st.post_color_h)
  if render3d_st.ue_down_p == 0 { render3d_st.ue_down_p = r3d_program(render3d_st, "fullscreen.vert", "ue_downsample.frag", "") }
  if render3d_st.ue_blur_p == 0 { render3d_st.ue_blur_p = r3d_program(render3d_st, "fullscreen.vert", "ue_blur.frag", "") }
  prof_begin(render3d_st, "UE bloom")
  gpu_depth_test(render3d_st, false)
  gpu_blend(render3d_st, false)
  # the scene downsample chain
  var src = render3d_st.post_color
  var sw = render3d_st.post_color_w;  var sh = render3d_st.post_color_h
  let dp = render3d_st.ue_down_p
  gpu_use_program(render3d_st, dp)
  for k in 0 .. UE_BLOOM_STAGES {
    let t = render3d_st.ue_bl_down[k]
    target_bind(render3d_st, t)
    r3d_bind_2d(render3d_st, dp, "u_src", 0, src)
    u_f2(render3d_st, gpu_uniform(render3d_st, dp, "u_src_inv"), 1.0 / float(sw), 1.0 / float(sh))
    u_f2(render3d_st, gpu_uniform(render3d_st, dp, "u_out_inv"), 1.0 / float(t.w), 1.0 / float(t.h))
    mesh_draw(render3d_st, render3d_st.post_fs)
    src = t.color;  sw = t.w;  sh = t.h
  }
  # BloomQualityToSceneDownsampleStage, and the stages from the largest kernel (Bloom6 on the smallest texture) down
  let count = ue_bloom_stage_count(q)
  let tint_scale = (1.0 / float(UE_BLOOM_STAGES)) * pp.bloom_intensity * pp.bloom_gaussian_intensity
  let cross_x = Math.max(pp.gaussian_bloom_cross, 0.0)
  let cross_y = Math.abs(pp.gaussian_bloom_cross)
  var out = 0
  var last = -1
  for si in 0 .. count {
    let bi = UE_BLOOM_STAGES - 1 - si              # Bloom6 .. Bloom1
    let src_i = UE_BLOOM_STAGES - 1 - si          # SourceIndex: the smallest texture first
    let size = pp.bloom_size[bi]
    if size > 0.00001 {
      let f = render3d_st.ue_bl_down[src_i]
      # GetBlurRadius: the filter's width x KernelSizePercent% x 0.5
      let radius = float(f.w) * size * pp.bloom_size_scale * 0.01 * 0.5
      var hx = render3d_st.ue_bl_hx[src_i]
      if radius >= UE_FAST_BLUR_THRESHOLD { hx = render3d_st.ue_bl_hxh[src_i] }
      var n = ue_gauss_kernel(render3d_st, radius, cross_x, pp.filter_size_scale)
      ue_blur_draw(render3d_st, hx, f.color, f.w, f.h, n, true, 1.0, 1.0, 1.0, 0)
      n = ue_gauss_kernel(render3d_st, radius, cross_y, pp.filter_size_scale)
      let dst = render3d_st.ue_bl_out[src_i]
      ue_blur_draw(render3d_st, dst, hx.color, f.w, f.h, n, false, pp.bloom_tint[bi * 3] * tint_scale, pp.bloom_tint[bi * 3 + 1] * tint_scale, pp.bloom_tint[bi * 3 + 2] * tint_scale, out)
      out = dst.color
      last = src_i
    }
  }
  prof_end(render3d_st)
  if out != 0 and last >= 0 { ue_lens_flare_pass(render3d_st, pp, render3d_st.ue_bl_out[last]) }
  return out
}

# ---- local exposure (PostProcessLocalExposure.cpp / .usf, LocalExposureMethod Bilateral) -----------------------------------------
# As Unreal: on only when a contrast scale or the detail strength is not 1 (the engine's defaults leave it off). The bilateral grid
# (ue_le_grid.comp: 64 x 64 tiles of the half-resolution scene x 32 log-luminance buckets, summed log luminance and weight), the
# blurred log luminance (SetupLogLuminanceCS, then a Gaussian of LocalExposureBlurredLuminanceKernelSizePercent), and the tonemapper
# (tonemap.frag ueLocalExposure: CalculateBaseLogLuminance, CalculateLocalExposure) scales the scene colour by it. Not ported: the
# contrast curves, the Fusion method, local exposure on the bloom (r.Bloom.ApplyLocalExposure).
function ue_local_exposure_on(pp: UePost) -> bool {
  return Math.abs(pp.local_exposure_highlight_contrast_scale - 1.0) > 0.0001 or Math.abs(pp.local_exposure_shadow_contrast_scale - 1.0) > 0.0001 or Math.abs(pp.local_exposure_detail_strength - 1.0) > 0.0001
}
function ue_local_exposure_pass(render3d_st: mut Render3dState) -> void {
  let pp = ue_pp_now(render3d_st)
  render3d_st.ue_le_built = false
  if not ue_local_exposure_on(pp) { return }
  let lod = max(min(pp.histogram_lod, 3), 0)
  let hw = max(render3d_st.post_hdr.w >> lod, 1)
  let hh = max(render3d_st.post_hdr.h >> lod, 1)
  let tx = (hw + 63) / 64
  let ty = (hh + 63) / 64
  if render3d_st.ue_le_c == 0 { ue_le_alloc(render3d_st) }
  if render3d_st.ue_le_c == 0 { return }
  prof_begin(render3d_st, "UE local exposure")
  # the bilateral grid
  gpu_buffer_upload(render3d_st, render3d_st.ue_le_grid, tx * ty * 32 * 8, null, GPU_DYNAMIC)
  gpu_buffer_gpu_owned(render3d_st, render3d_st.ue_le_grid)
  let pr = render3d_st.ue_le_pr
  pr[0] = float_bits(render3d_st.ue_hist_scale);  pr[1] = float_bits(render3d_st.ue_hist_bias);  pr[2] = float_bits(render3d_st.ue_lum_min);  pr[3] = float_bits(float(lod))
  pr[4] = hw;  pr[5] = hh;  pr[6] = tx;  pr[7] = ty
  render3d_st.ue_le_bufs[0] = render3d_st.ue_le_grid
  render3d_st.ue_le_texs[0] = render3d_st.post_hdr.color
  gpu_dispatch_tex(render3d_st, render3d_st.ue_le_c, data_of(pr), 32, render3d_st.ue_le_bufs, render3d_st.ue_le_texs, tx, ty)
  # the blurred log luminance
  if render3d_st.ue_le_lum != null and (render3d_st.ue_le_lum.w != hw or render3d_st.ue_le_lum.h != hh) {
    target_free(render3d_st, render3d_st.ue_le_lum);  target_free(render3d_st, render3d_st.ue_le_hx);  target_free(render3d_st, render3d_st.ue_le_hxh);  target_free(render3d_st, render3d_st.ue_le_blur)
    render3d_st.ue_le_lum = null
  }
  if render3d_st.ue_le_lum == null {
    render3d_st.ue_le_lum = target_new(render3d_st, hw, hh, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR)
    render3d_st.ue_le_hx = target_new(render3d_st, hw, hh, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR)
    render3d_st.ue_le_hxh = target_new(render3d_st, max((hw + 1) / 2, 1), hh, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR)
    render3d_st.ue_le_blur = target_new(render3d_st, hw, hh, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR)
  }
  if render3d_st.ue_blur_p == 0 { render3d_st.ue_blur_p = r3d_program(render3d_st, "fullscreen.vert", "ue_blur.frag", "") }
  if render3d_st.ue_bl_ofs == null { ue_le_kernel_alloc(render3d_st) }
  gpu_depth_test(render3d_st, false)
  gpu_blend(render3d_st, false)
  let lp = render3d_st.ue_le_lum_p
  target_bind(render3d_st, render3d_st.ue_le_lum)
  gpu_use_program(render3d_st, lp)
  r3d_bind_2d(render3d_st, lp, "u_scene", 0, render3d_st.post_hdr.color)
  u_f(render3d_st, gpu_uniform(render3d_st, lp, "u_lod"), float(lod))
  u_f(render3d_st, gpu_uniform(render3d_st, lp, "u_lum_min"), render3d_st.ue_lum_min)
  mesh_draw(render3d_st, render3d_st.post_fs)
  # AddGaussianBlurPass: GetBlurRadius = width x KernelSizePercent % x 0.5, the fast blur (half width) past r.FastBlurThreshold
  let radius = float(hw) * pp.local_exposure_blurred_luminance_kernel_size_percent * 0.01 * 0.5
  var hx = render3d_st.ue_le_hx
  if radius >= UE_FAST_BLUR_THRESHOLD { hx = render3d_st.ue_le_hxh }
  var n = ue_gauss_kernel(render3d_st, radius, 0.0, pp.filter_size_scale)
  ue_blur_draw(render3d_st, hx, render3d_st.ue_le_lum.color, hw, hh, n, true, 1.0, 1.0, 1.0, 0)
  n = ue_gauss_kernel(render3d_st, radius, 0.0, pp.filter_size_scale)
  ue_blur_draw(render3d_st, render3d_st.ue_le_blur, hx.color, hw, hh, n, false, 1.0, 1.0, 1.0, 0)
  render3d_st.ue_le_tx = tx;  render3d_st.ue_le_ty = ty
  render3d_st.ue_le_uvx = float(hw) / 64.0 / float(tx);  render3d_st.ue_le_uvy = float(hh) / 64.0 / float(ty)
  render3d_st.ue_le_built = true
  prof_end(render3d_st)
}
@alloc_ok("made once per resource and kept for its life (a texture, program, sampler, view, layout or memory block is created when first asked for)")
function ue_le_alloc(render3d_st: mut Render3dState) -> void {
  render3d_st.ue_le_c = gpu_compute_tex(render3d_st, "ue_le_grid", 1, 1)
  render3d_st.ue_le_grid = gpu_buffer_new(render3d_st)
  render3d_st.ue_le_pr = words(8)
  render3d_st.ue_le_bufs = words(1)
  render3d_st.ue_le_texs = words(1)
  render3d_st.ue_le_lum_p = r3d_program(render3d_st, "fullscreen.vert", "ue_le_lum.frag", "")
}
@alloc_ok("made once per resource and kept for its life (a texture, program, sampler, view, layout or memory block is created when first asked for)")
function ue_le_kernel_alloc(render3d_st: mut Render3dState) -> void { render3d_st.ue_bl_ofs = floats(UE_FILTER_SAMPLES_MAX * 4);  render3d_st.ue_bl_wt = floats(UE_FILTER_SAMPLES_MAX * 4) }

# the tonemapper's local exposure (ue_tonemap_bind)
function ue_local_exposure_bind(render3d_st: mut Render3dState, prog: int) -> void {
  var on = 0.0
  if render3d_st.ue_le_built { on = 1.0 }
  u_f(render3d_st, gpu_uniform(render3d_st, prog, "u_le_on"), on)
  if not render3d_st.ue_le_built { return }
  let pp = ue_pp_now(render3d_st)
  gpu_bind_buffer(render3d_st, prog, "u_le_grid", render3d_st.ue_le_grid)
  r3d_bind_2d(render3d_st, prog, "u_le_blur", 6, render3d_st.ue_le_blur.color)
  u_f4(render3d_st, gpu_uniform(render3d_st, prog, "u_le_a"), pp.local_exposure_highlight_contrast_scale, pp.local_exposure_shadow_contrast_scale, pp.local_exposure_detail_strength, pp.local_exposure_blurred_luminance_blend)
  # LocalExposureMiddleGreyExposureCompensation (auto exposure: no division by the compensation)
  u_f4(render3d_st, gpu_uniform(render3d_st, prog, "u_le_b"), Math.pow(2.0, pp.local_exposure_middle_grey_bias), pp.local_exposure_highlight_threshold, pp.local_exposure_shadow_threshold, pp.local_exposure_highlight_threshold_strength)
  u_f4(render3d_st, gpu_uniform(render3d_st, prog, "u_le_c"), pp.local_exposure_shadow_threshold_strength, render3d_st.ue_le_uvx, render3d_st.ue_le_uvy, render3d_st.ue_lum_min)
  u_f4(render3d_st, gpu_uniform(render3d_st, prog, "u_le_d"), float(render3d_st.ue_le_tx), float(render3d_st.ue_le_ty), render3d_st.ue_hist_scale, render3d_st.ue_hist_bias)
}

# ---- lens flares (PostProcessLensFlares.cpp / .usf) -------------------------------------------------------------------------------
# LensFlareBlur: a bokeh quad for each pixel of the r.LensFlareQuality downsample stage (a quarter at 2) whose luminance passes the
# threshold, KernelSize = LensFlareBokehSize % of its width, within a guard band of 2; then LensFlareComposite: eight copies of
# that blur over the bloom output, additive, each centred and scaled by its tint's alpha ((a x 7 - 3.5) x 2: negative mirrors it),
# coloured LensFlareTint x LensFlareIntensity x BloomIntensity / 4 x its tint, masked by DiscMask(p) DiscMask(0.8 p). The threshold
# compares the colour times the exposure (Unreal's scene colour is pre-exposed, ours is not). The bokeh is
# Unreal's fallback, a white texture: GEngine->DefaultBokehTexture is content, not source, and is not here yet.
function ue_lens_flare_pass(render3d_st: mut Render3dState, pp: UePost, out: Target) -> void {
  if pp.lens_flare_quality <= 0 or pp.lens_flare_intensity <= 0.00001 or pp.lens_flare_bokeh_size <= 0.00001 { return }
  let tr = pp.lens_flare_tint[0];  let tg = pp.lens_flare_tint[1];  let tb = pp.lens_flare_tint[2]
  if tr + tg + tb <= 0.0001 { return }
  # ELensFlareQuality::MAX - quality - 1: the downsample stage the flare reads
  let stage = max(min(4 - min(pp.lens_flare_quality, 3) - 1, UE_BLOOM_STAGES - 1), 0)
  let src = render3d_st.ue_bl_down[stage]
  if render3d_st.ue_lf_blur != null and (render3d_st.ue_lf_blur.w != src.w or render3d_st.ue_lf_blur.h != src.h) { target_free(render3d_st, render3d_st.ue_lf_blur);  render3d_st.ue_lf_blur = null }
  if render3d_st.ue_lf_blur == null { render3d_st.ue_lf_blur = target_new(render3d_st, src.w, src.h, GPU_RGBA16F, GPU_RGBA, GPU_HALF_FLOAT, false, GPU_LINEAR) }
  if render3d_st.ue_lf_p == 0 { render3d_st.ue_lf_p = r3d_program(render3d_st, "ue_flare.vert", "ue_flare.frag", "") }
  if render3d_st.ue_lf_quad == null { ue_lf_make_quad(render3d_st) }
  prof_begin(render3d_st, "UE lens flares")
  let p = render3d_st.ue_lf_p
  gpu_depth_test(render3d_st, false)
  # the blur: one quad an input pixel, added up
  target_bind(render3d_st, render3d_st.ue_lf_blur)
  gpu_clear_color(render3d_st, 0.0, 0.0, 0.0, 0.0)
  gpu_clear(render3d_st, GPU_COLOR_BUFFER_BIT)
  gpu_blend(render3d_st, true)
  gpu_blend_func(render3d_st, GPU_ONE, GPU_ONE)
  gpu_use_program(render3d_st, p)
  let kernel = pp.lens_flare_bokeh_size * float(src.w) * 0.01
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_mode"), 0.0)
  r3d_bind_2d(render3d_st, p, "u_src", 0, src.color)
  r3d_bind_2d(render3d_st, p, "u_bokeh", 1, render3d_st.ue_lf_bokeh)
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_src_size"), float(src.w), float(src.h))
  u_f3(render3d_st, gpu_uniform(render3d_st, p, "u_kernel"), kernel, 1.0 / Math.max(1.0, kernel * kernel), pp.lens_flare_threshold)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_exposure"), render3d_st.post_exposure)
  var auto = 0.0
  if render3d_st.post_auto and render3d_st.post_adapt_t != null { auto = 1.0;  r3d_bind_2d(render3d_st, p, "u_adapt", 3, render3d_st.post_adapt_t[render3d_st.post_adapt_i].color) }
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_auto"), auto)
  gpu_draw_mesh_instanced(render3d_st, render3d_st.ue_lf_quad, src.w * src.h)
  # the composite: eight scaled copies over the bloom output (the last stage's target)
  target_bind(render3d_st, out)
  u_f(render3d_st, gpu_uniform(render3d_st, p, "u_mode"), 1.0)
  r3d_bind_2d(render3d_st, p, "u_blur", 2, render3d_st.ue_lf_blur.color)
  u_f2(render3d_st, gpu_uniform(render3d_st, p, "u_out_size"), float(out.w), float(out.h))
  let k = pp.lens_flare_intensity * pp.bloom_intensity / 4.0
  for i in 0 .. 8 {
    let o = i * 4
    let a = pp.lens_flare_tints[o + 3]
    let scale = (a * 7.0 - 3.5) * 2.0
    u_f(render3d_st, gpu_uniform(render3d_st, p, "u_scale"), scale)
    u_f3(render3d_st, gpu_uniform(render3d_st, p, "u_flare_color"), tr * k * pp.lens_flare_tints[o], tg * k * pp.lens_flare_tints[o + 1], tb * k * pp.lens_flare_tints[o + 2])
    mesh_draw(render3d_st, render3d_st.ue_lf_quad)
  }
  gpu_blend(render3d_st, false)
  prof_end(render3d_st)
}

# the lens flares' bokeh shape (LensFlareBokehShape / GEngine->DefaultBokehTexture): a texture the game loads; 0 is the white fallback
export function r3d_ue_lens_flare_bokeh(render3d_st: mut Render3dState, tex: int) -> void { render3d_st.ue_lf_bokeh = tex }

@alloc_ok("made once per resource and kept for its life (a texture, program, sampler, view, layout or memory block is created when first asked for)")
function ue_lf_make_quad(render3d_st: mut Render3dState) -> void { render3d_st.ue_lf_quad = mesh_card(render3d_st) }

# ---- Post Process Volumes ---------------------------------------------------------------------------------------------------------
# UE 5.8 World.cpp DoPostProcessVolume + SceneView.cpp OverridePostProcessSettings: the frame's settings start from the base (r3d_pp,
# the unbound defaults a game edits) and every enabled volume, in Unreal's order (PostProcessVolumeLess: priority ascending, unbound
# first, larger first, then the order they were added), blends each setting it overrides toward its own value by its weight -
# BlendWeight, scaled down linearly over BlendRadius outside its shape (EncompassesPoint's distance; 0 inside), nothing beyond. LERP_PP
# for numbers, SET_PP for TemperatureType. Unreal's console variables (LUT size, bloom quality, ...) stay global, as in Unreal.
# A volume holds its settings packed by index (UE_PP_*) with an override flag each (bOverride_*): ue_ppv_set(v, UE_PP_FILM_SLOPE, 0.8).
# Distances are metres in render space; ue_ppv_rebase moves them with the floating origin. R3D_UE_VOLUMES=0 ignores every volume.
export const UE_PP_TEMP_IS_WHITE_BALANCE: int = 0
export const UE_PP_WHITE_TEMP: int = 1
export const UE_PP_WHITE_TINT: int = 2
export const UE_PP_GRADE: int = 3
export const UE_PP_COLOR_CORRECTION_SHADOWS_MAX: int = 83
export const UE_PP_COLOR_CORRECTION_HIGHLIGHTS_MIN: int = 84
export const UE_PP_COLOR_CORRECTION_HIGHLIGHTS_MAX: int = 85
export const UE_PP_BLUE_CORRECTION: int = 86
export const UE_PP_EXPAND_GAMUT: int = 87
export const UE_PP_TONE_CURVE_AMOUNT: int = 88
export const UE_PP_SCENE_COLOR_TINT_R: int = 89
export const UE_PP_SCENE_COLOR_TINT_G: int = 90
export const UE_PP_SCENE_COLOR_TINT_B: int = 91
export const UE_PP_FILM_SLOPE: int = 92
export const UE_PP_FILM_TOE: int = 93
export const UE_PP_FILM_SHOULDER: int = 94
export const UE_PP_FILM_BLACK_CLIP: int = 95
export const UE_PP_FILM_WHITE_CLIP: int = 96
export const UE_PP_VIGNETTE_INTENSITY: int = 97
export const UE_PP_AUTO_EXPOSURE_BIAS: int = 98
export const UE_PP_AUTO_EXPOSURE_LOW_PERCENT: int = 99
export const UE_PP_AUTO_EXPOSURE_HIGH_PERCENT: int = 100
export const UE_PP_AUTO_EXPOSURE_MIN_BRIGHTNESS: int = 101
export const UE_PP_AUTO_EXPOSURE_MAX_BRIGHTNESS: int = 102
export const UE_PP_AUTO_EXPOSURE_SPEED_UP: int = 103
export const UE_PP_AUTO_EXPOSURE_SPEED_DOWN: int = 104
export const UE_PP_HISTOGRAM_LOG_MIN: int = 105
export const UE_PP_HISTOGRAM_LOG_MAX: int = 106
export const UE_PP_BLOOM_INTENSITY: int = 107
export const UE_PP_BLOOM_GAUSSIAN_INTENSITY: int = 108
export const UE_PP_BLOOM_SIZE_SCALE: int = 109
export const UE_PP_BLOOM_SIZE: int = 110
export const UE_PP_BLOOM_TINT: int = 116
export const UE_PP_LENS_FLARE_INTENSITY: int = 134
export const UE_PP_LENS_FLARE_TINT: int = 135
export const UE_PP_LENS_FLARE_BOKEH_SIZE: int = 138
export const UE_PP_LENS_FLARE_THRESHOLD: int = 139
export const UE_PP_LOCAL_EXPOSURE_HIGHLIGHT_CONTRAST_SCALE: int = 140
export const UE_PP_LOCAL_EXPOSURE_SHADOW_CONTRAST_SCALE: int = 141
export const UE_PP_LOCAL_EXPOSURE_DETAIL_STRENGTH: int = 142
export const UE_PP_LOCAL_EXPOSURE_BLURRED_LUMINANCE_BLEND: int = 143
export const UE_PP_LOCAL_EXPOSURE_BLURRED_LUMINANCE_KERNEL_SIZE_PERCENT: int = 144
export const UE_PP_LOCAL_EXPOSURE_MIDDLE_GREY_BIAS: int = 145
export const UE_PP_LOCAL_EXPOSURE_HIGHLIGHT_THRESHOLD: int = 146
export const UE_PP_LOCAL_EXPOSURE_SHADOW_THRESHOLD: int = 147
export const UE_PP_LOCAL_EXPOSURE_HIGHLIGHT_THRESHOLD_STRENGTH: int = 148
export const UE_PP_LOCAL_EXPOSURE_SHADOW_THRESHOLD_STRENGTH: int = 149
export const UE_PP_COUNT: int = 150

# a grading control's index: ue_ppv_set(v, ue_pp_grade_index(UE_GRADE_SHADOWS, UE_CC_GAIN, 2), 1.1) is the shadows' gain, blue
export function ue_pp_grade_index(range: int, control: int, channel: int) -> int { return UE_PP_GRADE + (range * 5 + control) * 4 + channel }

function ue_pp_pack(pp: UePost, v: floats) -> void {
  v[0] = 0.0;  if pp.temp_is_white_balance { v[0] = 1.0 }
  v[1] = pp.white_temp
  v[2] = pp.white_tint
  for k in 0 .. 80 { v[3 + k] = pp.grade[k] }
  v[83] = pp.color_correction_shadows_max
  v[84] = pp.color_correction_highlights_min
  v[85] = pp.color_correction_highlights_max
  v[86] = pp.blue_correction
  v[87] = pp.expand_gamut
  v[88] = pp.tone_curve_amount
  v[89] = pp.scene_color_tint_r
  v[90] = pp.scene_color_tint_g
  v[91] = pp.scene_color_tint_b
  v[92] = pp.film_slope
  v[93] = pp.film_toe
  v[94] = pp.film_shoulder
  v[95] = pp.film_black_clip
  v[96] = pp.film_white_clip
  v[97] = pp.vignette_intensity
  v[98] = pp.auto_exposure_bias
  v[99] = pp.auto_exposure_low_percent
  v[100] = pp.auto_exposure_high_percent
  v[101] = pp.auto_exposure_min_brightness
  v[102] = pp.auto_exposure_max_brightness
  v[103] = pp.auto_exposure_speed_up
  v[104] = pp.auto_exposure_speed_down
  v[105] = pp.histogram_log_min
  v[106] = pp.histogram_log_max
  v[107] = pp.bloom_intensity
  v[108] = pp.bloom_gaussian_intensity
  v[109] = pp.bloom_size_scale
  for k in 0 .. 6 { v[110 + k] = pp.bloom_size[k] }
  for k in 0 .. 18 { v[116 + k] = pp.bloom_tint[k] }
  v[134] = pp.lens_flare_intensity
  for k in 0 .. 3 { v[135 + k] = pp.lens_flare_tint[k] }
  v[138] = pp.lens_flare_bokeh_size
  v[139] = pp.lens_flare_threshold
  v[140] = pp.local_exposure_highlight_contrast_scale
  v[141] = pp.local_exposure_shadow_contrast_scale
  v[142] = pp.local_exposure_detail_strength
  v[143] = pp.local_exposure_blurred_luminance_blend
  v[144] = pp.local_exposure_blurred_luminance_kernel_size_percent
  v[145] = pp.local_exposure_middle_grey_bias
  v[146] = pp.local_exposure_highlight_threshold
  v[147] = pp.local_exposure_shadow_threshold
  v[148] = pp.local_exposure_highlight_threshold_strength
  v[149] = pp.local_exposure_shadow_threshold_strength
}
function ue_pp_unpack(v: floats, pp: UePost) -> void {
  pp.temp_is_white_balance = v[0] > 0.5
  pp.white_temp = v[1]
  pp.white_tint = v[2]
  for k in 0 .. 80 { pp.grade[k] = v[3 + k] }
  pp.color_correction_shadows_max = v[83]
  pp.color_correction_highlights_min = v[84]
  pp.color_correction_highlights_max = v[85]
  pp.blue_correction = v[86]
  pp.expand_gamut = v[87]
  pp.tone_curve_amount = v[88]
  pp.scene_color_tint_r = v[89]
  pp.scene_color_tint_g = v[90]
  pp.scene_color_tint_b = v[91]
  pp.film_slope = v[92]
  pp.film_toe = v[93]
  pp.film_shoulder = v[94]
  pp.film_black_clip = v[95]
  pp.film_white_clip = v[96]
  pp.vignette_intensity = v[97]
  pp.auto_exposure_bias = v[98]
  pp.auto_exposure_low_percent = v[99]
  pp.auto_exposure_high_percent = v[100]
  pp.auto_exposure_min_brightness = v[101]
  pp.auto_exposure_max_brightness = v[102]
  pp.auto_exposure_speed_up = v[103]
  pp.auto_exposure_speed_down = v[104]
  pp.histogram_log_min = v[105]
  pp.histogram_log_max = v[106]
  pp.bloom_intensity = v[107]
  pp.bloom_gaussian_intensity = v[108]
  pp.bloom_size_scale = v[109]
  for k in 0 .. 6 { pp.bloom_size[k] = v[110 + k] }
  for k in 0 .. 18 { pp.bloom_tint[k] = v[116 + k] }
  pp.lens_flare_intensity = v[134]
  for k in 0 .. 3 { pp.lens_flare_tint[k] = v[135 + k] }
  pp.lens_flare_bokeh_size = v[138]
  pp.lens_flare_threshold = v[139]
  pp.local_exposure_highlight_contrast_scale = v[140]
  pp.local_exposure_shadow_contrast_scale = v[141]
  pp.local_exposure_detail_strength = v[142]
  pp.local_exposure_blurred_luminance_blend = v[143]
  pp.local_exposure_blurred_luminance_kernel_size_percent = v[144]
  pp.local_exposure_middle_grey_bias = v[145]
  pp.local_exposure_highlight_threshold = v[146]
  pp.local_exposure_shadow_threshold = v[147]
  pp.local_exposure_highlight_threshold_strength = v[148]
  pp.local_exposure_shadow_threshold_strength = v[149]
}
function ue_pp_is_set(i: int) -> bool { return i == 0 }

export const UE_PPV_BOX: int = 0
export const UE_PPV_SPHERE: int = 1
property UePpVolume {
  enabled: bool = true,            # bEnabled
  unbound: bool = false,           # bUnbound: the whole world, no shape
  priority: float = 0.0,           # Priority
  blend_radius: float = 1.0,       # BlendRadius (m)
  blend_weight: float = 1.0,       # BlendWeight
  shape: int = 0,                  # UE_PPV_BOX (centre, half extents, yaw about y) or UE_PPV_SPHERE (centre, radius in hx)
  cx: float = 0.0, cy: float = 0.0, cz: float = 0.0,
  hx: float = 1.0, hy: float = 1.0, hz: float = 1.0,
  yaw: float = 0.0,
  order: int = 0,                  # the order it was added: Unreal's VolumeGuid tie-break
  values: floats = null,           # the settings, packed (UE_PP_*)
  over: floats = null              # 1 where the volume overrides that setting
}

@alloc_ok("made once per resource and kept for its life (a texture, program, sampler, view, layout or memory block is created when first asked for)")
export function ue_ppv_add(render3d_st: mut Render3dState, priority: float, blend_radius: float, blend_weight: float, unbound: bool) -> UePpVolume {
  if render3d_st.ue_vols == null { render3d_st.ue_vols = new []UePpVolume }
  let v = new UePpVolume
  v.priority = priority;  v.blend_radius = Math.max(blend_radius, 0.0);  v.blend_weight = blend_weight;  v.unbound = unbound
  v.values = floats(UE_PP_COUNT)
  v.over = floats(UE_PP_COUNT)
  ue_pp_pack(r3d_pp(render3d_st), v.values)
  render3d_st.ue_vol_seq += 1
  v.order = render3d_st.ue_vol_seq
  push(render3d_st.ue_vols, v)
  return v
}
@alloc_ok("a world being set up (a stream, a layer, water, post, a bake): the map loading or swapping, not a frame")
export function ue_ppv_remove(render3d_st: mut Render3dState, v: UePpVolume) -> void {
  if render3d_st.ue_vols == null { return }
  let kept = new []UePpVolume
  for i in 0 .. len(render3d_st.ue_vols) { if render3d_st.ue_vols[i] != v { push(kept, render3d_st.ue_vols[i]) } }
  render3d_st.ue_vols = kept
}
export function ue_ppv_box(v: UePpVolume, cx: float, cy: float, cz: float, hx: float, hy: float, hz: float, yaw: float) -> void {
  v.shape = UE_PPV_BOX;  v.cx = cx;  v.cy = cy;  v.cz = cz;  v.hx = Math.abs(hx);  v.hy = Math.abs(hy);  v.hz = Math.abs(hz);  v.yaw = yaw
}
export function ue_ppv_sphere(v: UePpVolume, cx: float, cy: float, cz: float, r: float) -> void {
  v.shape = UE_PPV_SPHERE;  v.cx = cx;  v.cy = cy;  v.cz = cz;  v.hx = Math.abs(r)
}
# override one setting (bOverride_ on, and its value)
export function ue_ppv_set(v: UePpVolume, i: int, value: float) -> void {
  if v == null or i < 0 or i >= UE_PP_COUNT { return }
  v.values[i] = value;  v.over[i] = 1.0
}
export function ue_ppv_clear(v: UePpVolume, i: int) -> void { if v != null and i >= 0 and i < UE_PP_COUNT { v.over[i] = 0.0 } }
export function ue_ppv_rebase(render3d_st: mut Render3dState, dx: float, dy: float, dz: float) -> void {
  if render3d_st.ue_vols == null { return }
  for i in 0 .. len(render3d_st.ue_vols) { let v = render3d_st.ue_vols[i];  v.cx += dx;  v.cy += dy;  v.cz += dz }
}
export function r3d_ue_volumes(render3d_st: mut Render3dState, on: bool) -> void {
  render3d_st.ue_vol_on = 0
  if on { render3d_st.ue_vol_on = 1 }
}
function ue_volumes_on(render3d_st: mut Render3dState) -> bool {
  if render3d_st.ue_vol_on < 0 {
    render3d_st.ue_vol_on = 1
    if r3d_env_has(render3d_st, "R3D_UE_VOLUMES") and r3d_env(render3d_st, "R3D_UE_VOLUMES") == "0" { render3d_st.ue_vol_on = 0 }
  }
  return render3d_st.ue_vol_on == 1
}

# EncompassesPoint's distance from the point to the shape: 0 inside
export function ue_ppv_distance(v: UePpVolume, x: float, y: float, z: float) -> float {
  let px = x - v.cx;  let py = y - v.cy;  let pz = z - v.cz
  if v.shape == UE_PPV_SPHERE { return Math.max(Math.sqrt(px * px + py * py + pz * pz) - v.hx, 0.0) }
  let c = Math.cos(v.yaw);  let s = Math.sin(v.yaw)
  let lx = c * px - s * pz
  let lz = s * px + c * pz
  let ox = Math.max(Math.abs(lx) - v.hx, 0.0)
  let oy = Math.max(Math.abs(py) - v.hy, 0.0)
  let oz = Math.max(Math.abs(lz) - v.hz, 0.0)
  return Math.sqrt(ox * ox + oy * oy + oz * oz)
}

# DoPostProcessVolume's LocalWeight
export function ue_ppv_weight(v: UePpVolume, x: float, y: float, z: float) -> float {
  if not v.enabled { return 0.0 }
  var w = Math.clamp(v.blend_weight, 0.0, 1.0)
  if v.unbound { return w }
  let d = ue_ppv_distance(v, x, y, z)
  if d > v.blend_radius { return 0.0 }
  if v.blend_radius >= 1.0 { w = w * (1.0 - d / v.blend_radius) }
  else if d > 0.0 { return 0.0 }
  return w
}

# the shape's size for PostProcessVolumeLess (unbound: the largest)
function ue_ppv_size(v: UePpVolume) -> float {
  if v.unbound { return 1000000000000000000000000000000.0 }
  if v.shape == UE_PPV_SPHERE { return 4.18879 * v.hx * v.hx * v.hx }
  return 8.0 * v.hx * v.hy * v.hz
}
# PostProcessVolumeLess(a, b)
function ue_ppv_less(a: UePpVolume, b: UePpVolume) -> bool {
  if a.priority != b.priority { return a.priority < b.priority }
  if a.unbound != b.unbound { return a.unbound }
  let sa = ue_ppv_size(a);  let sb = ue_ppv_size(b)
  if sa != sb { return sa > sb }
  return a.order < b.order
}

# the frame's settings: the base, then every volume blended in at the view position, into ue_pp_final (what the passes read)
@alloc_ok("made once per resource and kept for its life (a texture, program, sampler, view, layout or memory block is created when first asked for)")
export function ue_pp_resolve(render3d_st: mut Render3dState, x: float, y: float, z: float) -> UePost {
  let base = r3d_pp(render3d_st)
  if render3d_st.ue_pp_final == null {
    let f = new UePost
    f.grade = floats(80);  f.bloom_size = floats(6);  f.bloom_tint = floats(18)
    f.lens_flare_tint = floats(3)
    render3d_st.ue_pp_final = f
    render3d_st.ue_pp_work = floats(UE_PP_COUNT)
  }
  let fin = render3d_st.ue_pp_final
  # the globals (console variables) come from the base as they are
  fin.lut_size = base.lut_size;  fin.dither_bits = base.dither_bits;  fin.extended_luminance_range = base.extended_luminance_range
  fin.lens_attenuation = base.lens_attenuation;  fin.exponential_transition_distance = base.exponential_transition_distance
  fin.black_histogram_bucket_influence = base.black_histogram_bucket_influence;  fin.histogram_lod = base.histogram_lod
  fin.bloom_quality = base.bloom_quality;  fin.gaussian_bloom_cross = base.gaussian_bloom_cross;  fin.filter_size_scale = base.filter_size_scale
  # LensFlareTints is not blended by a volume (no LERP_PP in SceneView.cpp): the base's own; r.LensFlareQuality is global
  fin.lens_flare_tints = base.lens_flare_tints;  fin.lens_flare_quality = base.lens_flare_quality
  let d = render3d_st.ue_pp_work
  ue_pp_pack(base, d)
  if ue_volumes_on(render3d_st) and render3d_st.ue_vols != null {
    let n = len(render3d_st.ue_vols)
    # insertion sort into Unreal's order (few volumes, and they change rarely)
    for i in 1 .. n {
      let v = render3d_st.ue_vols[i]
      var j = i - 1
      while j >= 0 and ue_ppv_less(v, render3d_st.ue_vols[j]) { render3d_st.ue_vols[j + 1] = render3d_st.ue_vols[j];  j -= 1 }
      render3d_st.ue_vols[j + 1] = v
    }
    for vi in 0 .. n {
      let v = render3d_st.ue_vols[vi]
      let w = Math.min(ue_ppv_weight(v, x, y, z), 1.0)
      if w > 0.0 {
        for k in 0 .. UE_PP_COUNT {
          if v.over[k] > 0.5 {
            if ue_pp_is_set(k) { d[k] = v.values[k] } else { d[k] = d[k] + (v.values[k] - d[k]) * w }
          }
        }
      }
    }
  }
  ue_pp_unpack(d, fin)
  return fin
}
# a setting's index by its name (the UePost field: white_temp, film_slope, ...; an array's element as name:k, grade:3 the global
# saturation's w); -1 for none
export function ue_pp_index_of(name: string) -> int {
  var base = name
  var k = 0
  let c = Text.index_of(name, ":")
  if c >= 0 { base = Text.slice(name, 0, c);  k = Text.to_int(Text.slice(name, c + 1, Text.length(name))) }
  if base == "temp_is_white_balance" { return 0 + k }
  if base == "white_temp" { return 1 + k }
  if base == "white_tint" { return 2 + k }
  if base == "grade" { return 3 + k }
  if base == "color_correction_shadows_max" { return 83 + k }
  if base == "color_correction_highlights_min" { return 84 + k }
  if base == "color_correction_highlights_max" { return 85 + k }
  if base == "blue_correction" { return 86 + k }
  if base == "expand_gamut" { return 87 + k }
  if base == "tone_curve_amount" { return 88 + k }
  if base == "scene_color_tint_r" { return 89 + k }
  if base == "scene_color_tint_g" { return 90 + k }
  if base == "scene_color_tint_b" { return 91 + k }
  if base == "film_slope" { return 92 + k }
  if base == "film_toe" { return 93 + k }
  if base == "film_shoulder" { return 94 + k }
  if base == "film_black_clip" { return 95 + k }
  if base == "film_white_clip" { return 96 + k }
  if base == "vignette_intensity" { return 97 + k }
  if base == "auto_exposure_bias" { return 98 + k }
  if base == "auto_exposure_low_percent" { return 99 + k }
  if base == "auto_exposure_high_percent" { return 100 + k }
  if base == "auto_exposure_min_brightness" { return 101 + k }
  if base == "auto_exposure_max_brightness" { return 102 + k }
  if base == "auto_exposure_speed_up" { return 103 + k }
  if base == "auto_exposure_speed_down" { return 104 + k }
  if base == "histogram_log_min" { return 105 + k }
  if base == "histogram_log_max" { return 106 + k }
  if base == "bloom_intensity" { return 107 + k }
  if base == "bloom_gaussian_intensity" { return 108 + k }
  if base == "bloom_size_scale" { return 109 + k }
  if base == "bloom_size" { return 110 + k }
  if base == "bloom_tint" { return 116 + k }
  if base == "lens_flare_intensity" { return 134 + k }
  if base == "lens_flare_tint" { return 135 + k }
  if base == "lens_flare_bokeh_size" { return 138 + k }
  if base == "lens_flare_threshold" { return 139 + k }
  if base == "local_exposure_highlight_contrast_scale" { return 140 + k }
  if base == "local_exposure_shadow_contrast_scale" { return 141 + k }
  if base == "local_exposure_detail_strength" { return 142 + k }
  if base == "local_exposure_blurred_luminance_blend" { return 143 + k }
  if base == "local_exposure_blurred_luminance_kernel_size_percent" { return 144 + k }
  if base == "local_exposure_middle_grey_bias" { return 145 + k }
  if base == "local_exposure_highlight_threshold" { return 146 + k }
  if base == "local_exposure_shadow_threshold" { return 147 + k }
  if base == "local_exposure_highlight_threshold_strength" { return 148 + k }
  if base == "local_exposure_shadow_threshold_strength" { return 149 + k }
  return -1
}

# "12.5", "-0.25", "4000": a decimal number (no exponent)
function ue_parse_float(t: string) -> float {
  var sgn = 1.0
  var s = t
  if Text.starts_with(s, "-") { sgn = -1.0;  s = Text.slice(s, 1, Text.length(s)) }
  let d = Text.index_of(s, ".")
  if d < 0 { return sgn * float(Text.to_int(s)) }
  let ip = float(Text.to_int(Text.slice(s, 0, d)))
  let fs = Text.slice(s, d + 1, Text.length(s))
  var scale = 1.0
  for i in 0 .. Text.length(fs) { scale = scale * 10.0 }
  var fp = 0.0
  if Text.length(fs) > 0 { fp = float(Text.to_int(fs)) / scale }
  return sgn * (ip + fp)
}

# R3D_PPV: one box volume for shots and tuning, read once - "cx,cy,cz,hx,hy,hz,blend_radius,priority;name=value;name=value"
# (render space, metres), e.g. R3D_PPV="51,1.5,22.4,3,3,3,10,0;white_temp=4000;grade:3=0.3"
@alloc_ok("made once per resource and kept for its life (a texture, program, sampler, view, layout or memory block is created when first asked for)")
function ue_ppv_env(render3d_st: mut Render3dState) -> void {
  if render3d_st.ue_vol_env { return }
  render3d_st.ue_vol_env = true
  if not r3d_env_has(render3d_st, "R3D_PPV") { return }
  let parts = Text.split(r3d_env(render3d_st, "R3D_PPV"), ";")
  if len(parts) == 0 { return }
  let g = Text.split(parts[0], ",")
  if len(g) < 8 { print("r3d: R3D_PPV wants cx,cy,cz,hx,hy,hz,blend_radius,priority");  return }
  let v = ue_ppv_add(render3d_st, ue_parse_float(g[7]), ue_parse_float(g[6]), 1.0, false)
  ue_ppv_box(v, ue_parse_float(g[0]), ue_parse_float(g[1]), ue_parse_float(g[2]), ue_parse_float(g[3]), ue_parse_float(g[4]), ue_parse_float(g[5]), 0.0)
  for i in 1 .. len(parts) {
    let kv = Text.split(parts[i], "=")
    if len(kv) == 2 {
      let idx = ue_pp_index_of(kv[0])
      if idx < 0 { print(`r3d: R3D_PPV: no setting {kv[0]}`) } else { ue_ppv_set(v, idx, ue_parse_float(kv[1])) }
    }
  }
}

# ---- The hour's grade --------------------------------------------------------------------------------------------------------------
# Unreal has no grade of its own by the hour: a project drives post-process settings from its time of day, usually through an unbound
# volume. daylight.ludic's per-hour grade (white balance, lift, gain, contrast, saturation, tuned for the old tonemapper) goes into the
# lowest-priority unbound volume, so the game's base settings stay its own and area volumes win over it. The translation:
#   white balance multiplier -> SceneColorTint (the same multiply on the scene colour)
#   saturation -> ColorSaturation (global; Unreal applies it before the tone curve, ours after)
#   contrast -> ColorContrast on the midtones and highlights (ours steepened only above mid grey; Unreal's shadows range, luma under
#               ColorCorrectionShadowsMax 0.09, is what that leaves alone)
#   lift (a display-space floor) -> ColorOffsetShadows, its display value made linear (^2.2): the loosest of the five
#   gain -> ColorGain (global)
# R3D_UE_HOUR_GRADE=0 (or r3d_ue_hour_grade(st, false)) leaves the hour out of Unreal's grade.
const UE_TOD_PRIORITY: float = -1000000.0

export function r3d_ue_hour_grade(render3d_st: mut Render3dState, on: bool) -> void {
  render3d_st.ue_tod_on = 0
  if on { render3d_st.ue_tod_on = 1 }
}
function ue_tod_on(render3d_st: mut Render3dState) -> bool {
  if render3d_st.ue_tod_on < 0 {
    render3d_st.ue_tod_on = 1
    if r3d_env_has(render3d_st, "R3D_UE_HOUR_GRADE") and r3d_env(render3d_st, "R3D_UE_HOUR_GRADE") == "0" { render3d_st.ue_tod_on = 0 }
  }
  return render3d_st.ue_tod_on == 1 and ue_tonemap_on(render3d_st)
}

@alloc_ok("made once per resource and kept for its life (a texture, program, sampler, view, layout or memory block is created when first asked for)")
function ue_tod_volume(render3d_st: mut Render3dState) -> UePpVolume {
  if render3d_st.ue_tod_vol == null { render3d_st.ue_tod_vol = ue_ppv_add(render3d_st, UE_TOD_PRIORITY, 0.0, 1.0, true) }
  return render3d_st.ue_tod_vol
}

# after daylight_set has computed the hour's post_* grade
function ue_tod_grade(render3d_st: mut Render3dState) -> void {
  if not ue_tod_on(render3d_st) {
    if render3d_st.ue_tod_vol != null { render3d_st.ue_tod_vol.enabled = false }
    return
  }
  let v = ue_tod_volume(render3d_st)
  v.enabled = true
  ue_ppv_set(v, UE_PP_SCENE_COLOR_TINT_R, render3d_st.post_wb_r)
  ue_ppv_set(v, UE_PP_SCENE_COLOR_TINT_G, render3d_st.post_wb_g)
  ue_ppv_set(v, UE_PP_SCENE_COLOR_TINT_B, render3d_st.post_wb_b)
  ue_ppv_set(v, ue_pp_grade_index(UE_GRADE_GLOBAL, UE_CC_SATURATION, 3), render3d_st.post_saturation)
  ue_ppv_set(v, ue_pp_grade_index(UE_GRADE_MIDTONES, UE_CC_CONTRAST, 3), render3d_st.post_contrast)
  ue_ppv_set(v, ue_pp_grade_index(UE_GRADE_HIGHLIGHTS, UE_CC_CONTRAST, 3), render3d_st.post_contrast)
  ue_ppv_set(v, ue_pp_grade_index(UE_GRADE_SHADOWS, UE_CC_OFFSET, 0), Math.pow(Math.max(render3d_st.post_lift_r, 0.0), 2.2))
  ue_ppv_set(v, ue_pp_grade_index(UE_GRADE_SHADOWS, UE_CC_OFFSET, 1), Math.pow(Math.max(render3d_st.post_lift_g, 0.0), 2.2))
  ue_ppv_set(v, ue_pp_grade_index(UE_GRADE_SHADOWS, UE_CC_OFFSET, 2), Math.pow(Math.max(render3d_st.post_lift_b, 0.0), 2.2))
  ue_ppv_set(v, ue_pp_grade_index(UE_GRADE_GLOBAL, UE_CC_GAIN, 0), render3d_st.post_gain_r)
  ue_ppv_set(v, ue_pp_grade_index(UE_GRADE_GLOBAL, UE_CC_GAIN, 1), render3d_st.post_gain_g)
  ue_ppv_set(v, ue_pp_grade_index(UE_GRADE_GLOBAL, UE_CC_GAIN, 2), render3d_st.post_gain_b)
}
