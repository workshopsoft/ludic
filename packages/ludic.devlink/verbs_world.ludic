# verbs_world.ludic - the core verbs that reach into the frame: shot and step (goto, map_load, time and weather
# are declared verbs now: verbs_declared.ludic)
# a quoted argument as text for the game (made per request, never per frame)
@alloc_ok("one request's key or path: once per request, in a dev build")
function dl_text(st: DevlinkState, n: int) -> string { return text_of(st.dl_str, n) }

# a .ppm and no "..": the one file an editor may name; w and h, when given, are the frame's own
function dl_shot(st: mut DevlinkState, id: int) -> void {
  let n = dl_quoted(st)
  if not dl_done(st) {
    dl_int(st)
    dl_int(st)
  }
  if dl_bad_args(st, id) { return }
  if n < 5 or n > len(st.dl_path) or not dl_ppm(st, n) {
    dl_err(st, id, "bad_args", "a .ppm path without ..")
    return
  }
  if dl_busy(st, id) { return }
  for i in 0 .. n { st.dl_path[i] = st.dl_str[i] }
  st.dl_path_n = n
  let r = DevlinkWorld.screenshot(dl_text(st, n))
  if r == DL_UNBOUND { dl_err(st, id, "unbound", "not offered") } else { dl_park(st, id, DL_SHOT) }
}
function dl_ppm(st: DevlinkState, n: int) -> bool {
  let b = st.dl_str
  if b[n - 4] != 46 or b[n - 3] != 112 or b[n - 2] != 112 or b[n - 1] != 109 { return false }
  for i in 0 .. n - 1 { if b[i] == 46 and b[i + 1] == 46 { return false } }
  return true
}

function dl_step(st: mut DevlinkState, id: int) -> void {
  let n = dl_int(st)
  if dl_bad_args(st, id) or n < 1 or n > 600 {
    if st.dl_o == 0 { dl_err(st, id, "bad_args", "n is 1 to 600") }
    return
  }
  if dl_busy(st, id) { return }
  let r = DevlinkWorld.step(n)
  if r == DL_UNBOUND { dl_err(st, id, "unbound", "not offered") } else { dl_park(st, id, DL_STEP) }
}

# ---- probes: ground, ray and settled ask the game's physics; window is the runtime's own ----

function dl_ground(st: mut DevlinkState, id: int) -> void {
  let x = dl_float(st)
  let z = dl_float(st)
  if dl_bad_args(st, id) { return }
  let y = DevlinkWorld.ground(x, z)
  if y <= DL_GROUND_UNBOUND { dl_err(st, id, "unbound", "not offered") }
  else if y <= DL_GROUND_NONE { dl_err(st, id, "failed", "no ground there") }
  else {
    dl_ok(st, id)
    dl_b(st, 32)
    dl_f(st, y)
  }
}

# ray ox oy oz dx dy dz max: the direction need not be unit (t is a distance along it, normalised); a miss is `ok false`
function dl_ray(st: mut DevlinkState, id: int) -> void {
  let ox = dl_float(st)
  let oy = dl_float(st)
  let oz = dl_float(st)
  let dx = dl_float(st)
  let dy = dl_float(st)
  let dz = dl_float(st)
  let m = dl_float(st)
  if dl_bad_args(st, id) { return }
  let dlen = Math.sqrt(dx * dx + dy * dy + dz * dz)
  if dlen < 0.000001 or m <= 0.0 {
    dl_err(st, id, "bad_args", "a direction and a positive max")
    return
  }
  let h = st.dl_hit
  h.hit = false
  let r = DevlinkWorld.ray(ox, oy, oz, dx / dlen, dy / dlen, dz / dlen, m, h)
  if r == DL_UNBOUND { dl_err(st, id, "unbound", "not offered") }
  else if r < 0 { dl_err(st, id, "failed", "the ray could not be cast") }
  else {
    dl_ok(st, id)
    if h.hit {
      dl_s(st, " true ")
      dl_f(st, h.t)
      dl_xyz(st, h.x, h.y, h.z)
    } else {
      dl_s(st, " false")
    }
  }
}

function dl_settled(st: mut DevlinkState, id: int) -> void {
  if dl_bad_args(st, id) { return }
  let r = DevlinkWorld.settled()
  if r == DL_UNBOUND {
    dl_err(st, id, "unbound", "not offered")
    return
  }
  dl_ok(st, id)
  if r > 0 { dl_s(st, " true") } else { dl_s(st, " false") }
}
