# late.ludic - one slow request at a time (a declared verb, a shot, steps), answered by id when it is done or 5 s on
function dl_busy(st: mut DevlinkState, id: int) -> bool {
  if st.dl_pend == DL_NONE { return false }
  dl_err(st, id, "refused", "busy with an earlier request")
  return true
}

function dl_park(st: mut DevlinkState, id: int, kind: int) -> void {
  st.dl_pend = kind
  st.dl_pend_id = id
  st.dl_pend_ip = st.dl_ip
  st.dl_pend_port = st.dl_port
  st.dl_pend_t = 0.0
  st.dl_o = 0                              # nothing now: the answer comes when it is done
}

# the waiting request's answer into dl_out once it is done: true when there is one to send
export function devlink_late(st: mut DevlinkState, dt: float) -> bool {
  if st.dl_pend == DL_NONE { return false }
  st.dl_pend_t = st.dl_pend_t + dt
  let id = st.dl_pend_id
  var done = true
  var limit = DL_LATE_S
  if st.dl_pend == DL_VERB {
    limit = DevVerbs[st.dl_pend_verb].late_s
    done = dl_late_verb(st, id)
  } else if st.dl_pend == DL_SHOT { done = dl_late_shot(st, id) }
  else if DevlinkWorld.steps_left() <= 0 { dl_ok(st, id) }
  else { done = false }
  if not done and st.dl_pend_t >= limit {
    dl_err(st, id, "failed", "timed out")
    done = true
  }
  if done { st.dl_pend = DL_NONE }
  return done
}

function dl_late_shot(st: mut DevlinkState, id: int) -> bool {
  let s = DevlinkWorld.shot_state()
  if s == 0 { return false }
  if s < 0 {
    dl_err(st, id, "failed", "the shot was not written")
    return true
  }
  dl_ok(st, id)
  dl_b(st, 32)
  dl_q_bytes(st, st.dl_path, st.dl_path_n)
  dl_b(st, 32)
  dl_i(st, DevlinkWorld.shot_w())
  dl_b(st, 32)
  dl_i(st, DevlinkWorld.shot_h())
  return true
}
