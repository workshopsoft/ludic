# net.ludic - weapons in a party. THE MODEL (README has it whole): the host decides. A guest fires its own gun
# at once (the magazine, the recoil, the spread, the flash and a picture of the hit are all predicted, from a
# seed the shot number makes), and says so in the @Net action WeaponsFire (actor, gun, shot number, when, the
# aim ray, the spread it used). It travels through the NetActions port the game binds to its session; the host
# checks it (`weapons_fire_ok`: the shooter could have fired - holding it, loaded, within its rate, from where
# it stands, played by that sender), derives the seed ITSELF from the shot number (a guest cannot pick a lucky
# one), puts the bodies back where the guest saw them (the lag compensation port) and resolves the round for
# real through the damage port. The owner is told it was accepted (or refused: its pending shot is taken back),
# every other guest gets the action and shows the shot. The package sends nothing: the game binds NetActions
# and puts the inventory snapshots and the kill feed on its wire

export function weapons_set_role(weapons_st: mut WeaponsState, role: int) -> void { weapons_st.wp__role = role }
export function weapons_role(weapons_st: WeaponsState) -> int { return weapons_st.wp__role }

# the seed of the match, the same on every machine (the host chooses it and sends it with the join)
export function weapons_seed(weapons_st: mut WeaponsState, seed: int) -> void { weapons_st.wp__seed = seed }

# how far back the host will rewind the bodies for a guest's shot, and how far ahead of a weapon's rate it
# lets a guest's rounds run before refusing them (jitter)
export function weapons_config(weapons_st: mut WeaponsState, max_rewind: float, slack: float) -> void {
  weapons_st.wp__max_rewind = max_rewind
  weapons_st.wp__slack = slack
}

export function weapons_set_local(weapons_st: mut WeaponsState, actor: int) -> void {
  let old = weapons_of(weapons_st, weapons_st.wp__local)
  if old >= 0 { weapons_set_mine(weapons_st, old, false) }
  weapons_st.wp__local = actor
  let h = weapons_of(weapons_st, actor)
  if h >= 0 { weapons_set_mine(weapons_st, h, true) }
}

# can the host take this shot, and if not why not: WP_OK, or the reason. It changes nothing, so the action's
# validator and the verb that resolves it say the same. `sender` is the wire's slot (never the message's;
# 0: this machine, which is trusted); the aim ray and the spread are the guest's, held to what the weapon can do
function wp__fire_why(weapons_st: WeaponsState, sender: int, actor: int, gun: int, weapon: int, shot_no: int, ox: float, oy: float, oz: float) -> int {
  if weapons_st.wp__role == WEAPONS_GUEST { return WP_NOT_HOST }
  let h = weapons_of(weapons_st, actor)
  let s = wp__shooter(weapons_st, h)
  if s == null { return WP_NO_SHOOTER }
  if sender > 0 and not WeaponsWorld.allow_shot(sender, actor) { return WP_NOT_YOURS }
  let g = wp__gun(s, s.cur)
  if g == null or gun != s.cur or g.weapon != weapon { return WP_NOT_HELD }
  if shot_no <= s.last_no { return WP_STALE }
  if not WeaponsWorld.can_fire(actor) { return WP_CANT }
  if s.busy == WBUSY_EQUIP or s.busy == WBUSY_RELOAD_END or (s.busy != WBUSY_NONE and not Weapons[g.weapon].reload_each) { return WP_BUSY }
  if g.mag < Weapons[g.weapon].ammo_per_shot { return WP_NO_AMMO }
  if weapons_st.wp__time + weapons_st.wp__slack < s.next_ok { return WP_TOO_FAST }
  if not WeaponsWorld.origin_ok(actor, ox, oy, oz) { return WP_BAD_ORIGIN }
  return WP_OK
}

# the host's check of a guest's WeaponsFire, before it is reduced (@Validate): a refusal is told to the
# guest, which takes its pending shot back
export function weapons_fire_ok(weapons_st: WeaponsState, a: WeaponsFire, sender: int) -> bool {
  return wp__fire_why(weapons_st, sender, a.actor, a.gun, a.weapon, a.shot_no, a.ox, a.oy, a.oz) == WP_OK
}

# the host takes a guest's shot (what the WeaponsFire reducer does on the host; a game that carries shots
# some other way calls it). Returns WP_OK, or why it was refused. The seed is the host's own, derived from the
# shot number, so a guest cannot pick a lucky one; the spread is held to what the weapon can have in any stance
export function weapons_host_take(weapons_st: mut WeaponsState, sender: int, actor: int, gun: int, weapon: int, shot_no: int, stamp: float, ox: float, oy: float, oz: float, dx: float, dy: float, dz: float, claimed: float, charge: float) -> int {
  let why = wp__fire_why(weapons_st, sender, actor, gun, weapon, shot_no, ox, oy, oz)
  if why == WP_NOT_HOST { return why }
  let h = weapons_of(weapons_st, actor)
  let s = wp__shooter(weapons_st, h)
  if s == null { return WP_NO_SHOOTER }
  if why != WP_OK {
    if shot_no > s.last_no { s.last_no = shot_no }
    let f = wp__fact(weapons_st, WP_REFUSED, s, h, gun)
    f.zone = why
    f.shot_no = shot_no
    return why
  }
  let g = wp__gun(s, s.cur)
  if s.busy != WBUSY_NONE {
    s.busy = WBUSY_NONE
    s.busy_t = 0.0
  }
  let at = Math.clamp(stamp, weapons_st.wp__time - weapons_st.wp__max_rewind, weapons_st.wp__time)
  let seed = weapons_shot_seed(weapons_st.wp__seed, actor, shot_no)
  let spread = Math.clamp(claimed, 0.0, wp__spread_cap(g))
  WeaponsWorld.rewind(at)
  wp__fire_round(weapons_st, s, h, gun, g, ox, oy, oz, dx, dy, dz, seed, shot_no, spread, charge, WP_MODE_AUTH)
  WeaponsWorld.restore()
  s.next_ok = Math.max(s.next_ok, weapons_st.wp__time) + wp__interval(g)
  wp__spent(weapons_st, s, g, h, gun)
  s.shots = shot_no
  s.last_no = shot_no
  return WP_OK
}

# what a WeaponsFire does. On the host (and solo) the round is resolved for real; on a guest it is the host's
# word: for the owner a confirm (a shot that is no longer in the air), for any other guest the shot of someone
# else, shown (the owner's own shot is shown already, at the pull). The owner's magazine is its own prediction
# until the host's inventory snapshot says otherwise (`weapons_apply_snapshot` leaves it alone while shots
# are in the air)
reducer WeaponsState on WeaponsFire(weapons_st: mut WeaponsState, a: WeaponsFire) {
  if weapons_st.wp__role != WEAPONS_GUEST {
    weapons_host_take(weapons_st, action_sender(), a.actor, a.gun, a.weapon, a.shot_no, a.stamp, a.ox, a.oy, a.oz, a.dx, a.dy, a.dz, a.spread, a.charge)
    return
  }
  let h = weapons_of(weapons_st, a.actor)
  let s = wp__shooter(weapons_st, h)
  if s != null and s.mine {
    if s.pending > 0 { s.pending -= 1 }
    let f = wp__fact(weapons_st, WP_CONFIRMED, s, h, s.cur)
    f.shot_no = a.shot_no
    return
  }
  weapons_net_fired(weapons_st, a.actor, a.weapon, a.ammo, a.shot_no, a.ox, a.oy, a.oz, a.dx, a.dy, a.dz, a.spread, a.charge)
}

# the owner's own shot is in the air from the pull until the host answers; a refusal puts the count back
@Predicted reducer Shooter in WeaponsState.wp__shooters on WeaponsFire(r: mut Row<Shooter>, weapons_st: WeaponsState, a: WeaponsFire) {
  if weapons_st.wp__role == WEAPONS_GUEST and r.rec.mine and r.rec.actor == a.actor { r.rec.pending += 1 }
}

# another machine's shot, shown here: the host's FIRED fact, relayed (the owner's own shot is shown already:
# the game skips its own actor). The shooter is made as a mirror holding the weapon. It spends nothing and
# hurts nobody: the flash, the tracer, the impacts and a flying body's picture
@alloc_ok("a mirror shooter made the first time another machine's shot is shown")
export function weapons_net_fired(weapons_st: mut WeaponsState, actor: int, weapon: int, ammo: int, shot_no: int, ox: float, oy: float, oz: float, dx: float, dy: float, dz: float, spread: float, charge: float) -> bool {
  if not wp__weapon_ok(weapon) { return false }
  var h = weapons_of(weapons_st, actor)
  if h < 0 { h = weapons_add(weapons_st, actor, false) }
  var gun = weapons_gun_of(weapons_st, h, weapon)
  if gun < 0 { gun = weapons_give(weapons_st, h, weapon) }
  let s = wp__shooter(weapons_st, h)
  let g = wp__gun(s, gun)
  if g == null { return false }
  s.cur = gun
  if wp__ammo_ok(ammo) { g.ammo_type = ammo }
  let seed = weapons_shot_seed(weapons_st.wp__seed, actor, shot_no)
  wp__fire_round(weapons_st, s, h, gun, g, ox, oy, oz, dx, dy, dz, seed, shot_no, spread, charge, WP_MODE_REMOTE)
  s.shots = shot_no
  return true
}

# ---- inventory snapshots

# the layout: seq, the gun in hand, how many places, then per place (weapon or -1, magazine, ammo type, mode,
# skin, and a part per slot), then the reserve per ammo type
export function weapons_snapshot_size(places: int) -> int { return 3 + places * (5 + WSLOT_COUNT) + AMMO_COUNT }

export function weapons_snapshot(weapons_st: mut WeaponsState, h: int, out: []float) -> int {
  let s = wp__shooter(weapons_st, h)
  List.clear(out)
  if s == null { return 0 }
  s.seq += 1
  push(out, float(s.seq))
  push(out, float(s.cur))
  push(out, float(len(s.guns)))
  for i in 0 .. len(s.guns) {
    let g = s.guns[i]
    push(out, float(g.weapon))
    push(out, float(g.mag))
    push(out, float(g.ammo_type))
    push(out, float(g.mode))
    push(out, float(g.skin))
    for k in 0 .. WSLOT_COUNT {
      if g.weapon >= 0 { push(out, float(g.attach[k])) } else { push(out, -1.0) }
    }
  }
  for a in 0 .. AMMO_COUNT { push(out, float(s.reserve[a])) }
  return len(out)
}

# a guest takes the host's inventory of an actor (made a mirror if it was not known): what a player carries,
# and what another player has in their hands. A stale one (older seq) is dropped; while this machine's own
# shots are unanswered the magazine and reserve of its own gun stay the prediction's
@alloc_ok("an inventory read back: places made the first time a snapshot has more than the mirror")
export function weapons_apply_snapshot(weapons_st: mut WeaponsState, actor: int, data: []float, n: int) -> bool {
  if n < 3 or len(data) < n { return false }
  let places = int(data[2])
  if places < 0 or n < weapons_snapshot_size(places) { return false }
  var h = weapons_of(weapons_st, actor)
  if h < 0 { h = weapons_add(weapons_st, actor, false) }
  let s = wp__shooter(weapons_st, h)
  let seq = int(data[0])
  if s.seq != 0 and seq <= s.seq and seq > s.seq - 1000000 { return false }
  s.seq = seq
  let keep = s.mine and s.pending > 0
  let cur_was = s.cur
  while len(s.guns) < places {
    let g = new Gun
    g.attach = new []int
    for k in 0 .. WSLOT_COUNT { push(g.attach, -1) }
    push(s.guns, g)
  }
  var at = 3
  for i in 0 .. places {
    let g = s.guns[i]
    g.weapon = int(data[at])
    let mag = int(data[at + 1])
    if not (keep and i == cur_was) or g.weapon < 0 { g.mag = mag }
    g.ammo_type = int(data[at + 2])
    g.mode = int(data[at + 3])
    g.skin = int(data[at + 4])
    for k in 0 .. WSLOT_COUNT { g.attach[k] = int(data[at + 5 + k]) }
    if g.weapon >= 0 and (not wp__weapon_ok(g.weapon) or not wp__ammo_ok(g.ammo_type)) { g.weapon = -1 }
    at += 5 + WSLOT_COUNT
  }
  for i in places .. len(s.guns) { s.guns[i].weapon = -1 }
  s.cur = int(data[1])
  if wp__gun(s, s.cur) == null { s.cur = -1 }
  for a in 0 .. AMMO_COUNT {
    if not (keep and wp__gun(s, s.cur) != null and s.guns[s.cur].ammo_type == a) { s.reserve[a] = int(data[at]) }
    at += 1
  }
  return true
}
