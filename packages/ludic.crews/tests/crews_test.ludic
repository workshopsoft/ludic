    crew_propose(crew_st, 1, 2, CRL_ALLY)
    crew_accept(crew_st, 4, 1)
    expect_eq(crew_killed(crew_st, terr, 1, 4, 10.0, 10.0), -1)
    expect_eq(count_of(crew_st, CREW_FRIENDLY_FIRE), 2)
    expect_eq(crew_kills_of(crew_st, 1, 2), 0)
    crew_turf_sync(crew_st, terr)
    expect(crew_influence(crew_st, "metro", "harbor", 1) == 0.0)
  }

  test "a bounty is paid to whoever kills the target, by the relation's share, and is gone after" (crew_st: mut CrewState, terr: mut Territories, crews_test_st: mut CrewsTestState) {
    fresh(crew_st, terr, crews_test_st)
    two_crews(crew_st)
    expect(not crew_bounty_place(crew_st, 1, 4, 50))
    expect_eq(crew_why(crew_st), CREW_BAD_AMOUNT)
    expect(not crew_bounty_place(crew_st, 1, 1, 500))
    expect(crew_bounty_place(crew_st, 1, 4, 500))
    expect(crew_bounty_place(crew_st, 9, 4, 300))
    expect_eq(crew_bounty_on(crew_st, 4), 800)
    expect_eq(crews_test_st.purse[1], 100000 - 500 - 500)
    let before = crews_test_st.purse[6]
    expect_eq(crew_killed(crew_st, terr, 6, 4, 5000.0, 5000.0), 800)
    expect_eq(crews_test_st.purse[6], before + 800)
    expect_eq(crew_bounty_on(crew_st, 4), 0)
    crew_bounty_place(crew_st, 1, 4, 1000)
    crew_propose(crew_st, 1, 2, CRL_WAR)
    let b2 = crews_test_st.purse[1]
    expect_eq(crew_killed(crew_st, terr, 2, 4, 5000.0, 5000.0), 2000)
    expect_eq(crews_test_st.purse[2], 100000 + 2000)
    crew_bounty_place(crew_st, 6, 5, 1000)
    expect_eq(crew_killed(crew_st, terr, 1, 5, 5000.0, 5000.0), 2000)
    expect_eq(crews_test_st.purse[1], b2 + 2000)
  }

  test "an owned territory pays its income into the crew's bank every period" (crew_st: mut CrewState, terr: mut Territories, m: mut TurfStepsMachine, crews_test_st: mut CrewsTestState) {
    fresh(crew_st, terr, crews_test_st)
    two_crews(crew_st)
    crew_add_influence(crew_st, terr, 1, "harbor", 400.0)
    pass(crew_st, terr, m, crews_test_st, 2.0, 0.0)
    expect_eq(crew_turf_owner(crew_st, "metro", "harbor"), 1)
    expect_eq(crew_bank(crew_st, 1), 0)
    pass(crew_st, terr, m, crews_test_st, 60.0, 0.0)
    expect_eq(crew_bank(crew_st, 1), 100)
    pass(crew_st, terr, m, crews_test_st, 120.0, 0.0)
    expect_eq(crew_bank(crew_st, 1), 300)
    expect_eq(crew_bank(crew_st, 2), 0)
  }

  test "facts say who founded, joined, kicked, captured" (crew_st: mut CrewState, terr: mut Territories, m: mut TurfStepsMachine, crews_test_st: mut CrewsTestState) {
    fresh(crew_st, terr, crews_test_st)
    crew_create(crew_st, 1, "Alphas", "ALP", 0, 0, 0)
    crew_invite(crew_st, 1, 2)
    crew_join(crew_st, 2, 1)
    crew_kick(crew_st, 1, 2)
    crew_join(crew_st, 2, 1)
    let fs = q_drain(crew_facts(crew_st))
    expect_eq(fs[0].what, CREW_CREATED)
    expect_eq(fs[0].crew, 1)
    expect_eq(fs[1].what, CREW_INVITED)
    expect_eq(fs[2].what, CREW_JOINED)
    expect_eq(fs[3].what, CREW_KICKED)
    expect_eq(fs[3].other, 2)
    expect_eq(fs[4].what, CREW_REFUSED)
    expect_eq(fs[4].reason, CREW_NOT_INVITED)
  }

  test "the save keeps crews, members, relations, bounties and who holds what; a guest takes the host's snapshot" (crew_st: mut CrewState, terr: mut Territories, m: mut TurfStepsMachine, crews_test_st: mut CrewsTestState) {
    fresh(crew_st, terr, crews_test_st)
    two_crews(crew_st)
    crew_deposit(crew_st, 1, 700)
    crew_set_open(crew_st, 1, true)
    crew_propose(crew_st, 4, 1, CRL_RIVAL)
    crew_killed(crew_st, terr, 1, 4, 5000.0, 5000.0)
    crew_bounty_place(crew_st, 1, 5, 400)
    crew_add_influence(crew_st, terr, 1, "harbor", 400.0)
    pass(crew_st, terr, m, crews_test_st, 2.0, 0.0)
    crew_add_influence(crew_st, terr, 2, "old_town", 55.5)
    let root = save_tree()
    save_section(root, "crews", 1, crew_save(crew_st))
    let saved = save_encode(root)
    let snap = crew_snapshot(crew_st)
    crew_reset(crew_st)
    expect_eq(crew_count(crew_st), 0)
    let n = load_section(save_decode(saved), "crews")
    expect(n.found)
    crew_load(crew_st, n.data, n.version)
    expect_eq(crew_count(crew_st), 2)
    expect(crew_name(crew_st, 2) == "Bravos")
    expect_eq(crew_bank(crew_st, 1), 700)
    expect(crew_is_open(crew_st, 1))
    expect_eq(crew_rank_of(crew_st, 2), CRR_OFFICER)
    expect_eq(crew_emblem(crew_st, 2), 1)
    expect_eq(crew_relation(crew_st, 1, 2), CRL_RIVAL)
    expect_eq(crew_kills_of(crew_st, 1, 2), 1)
    expect_eq(crew_bounty_on(crew_st, 5), 400)
    expect_eq(crew_turf_owner(crew_st, "metro", "harbor"), 1)
    expect(crew_influence(crew_st, "metro", "old_town", 2) == 55.5)
    crew_turf_sync(crew_st, terr)
    expect_eq(crew_owned_value(crew_st, 1), 10)
    crews_test_st.host = false
    crew_reset(crew_st)
    expect(crew_apply_snapshot(crew_st, snap))
    expect_eq(crew_count(crew_st), 2)
    expect_eq(crew_of(crew_st, 5), 2)
    expect(not crew_apply_snapshot(crew_st, "nonsense"))
    let bank = crew_bank(crew_st, 1)
    crew_tick(crew_st, terr, m, tick_new(1.0, 1, 24.0))
    expect_eq(crew_bank(crew_st, 1), bank)
  }
}
