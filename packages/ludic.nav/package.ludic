# ludic.nav - a walkable mesh of the world and the ways across it, over Recast & Detour (phase 17),
# built here from a pinned tag (native/build.sh). Uses ludic.base and nothing else.
package "ludic.nav"
version "0.1.0"
kind source
native "macos-arm64" "lib/macos-arm64/libludicnav.dylib"
native "windows-x64" "lib/windows-x64/ludicnav.dll"
