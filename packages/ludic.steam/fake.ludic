# ---- the other side: what the test plays ----
export function fake_reset(fake_st: mut FakeSteamState) -> void {
  let fresh = new FakeSteamState
  fake_st.fk_init_code = 0
  fake_st.fk_up = false
  fake_st.fk_hold_stats = false
  fake_st.fk_used = 0
  fake_st.fk_at = 0
  fake_st.fk_friends = fresh.fk_friends
  fake_st.fk_lobbies = fresh.fk_lobbies
  fake_st.fk_files = fresh.fk_files
}

# start fails like this (STEAM_ERR_*), with this message
export function fake_fail_init(fake_st: mut FakeSteamState, code: int, message: string) -> void {
  fake_st.fk_init_code = code
  fake_st.fk_error = message
}
# the stats wait for fake_stats_arrive instead of coming with init
export function fake_hold_stats(fake_st: mut FakeSteamState, hold: bool) -> void { fake_st.fk_hold_stats = hold }
export function fake_stats_arrive(fake_st: mut FakeSteamState) -> void { fk_send_stats(fake_st) }
export function fake_cloud_off(fake_st: mut FakeSteamState, off: bool) -> void { fake_st.fk_cloud_off = off }
export function fake_launch(fake_st: mut FakeSteamState, cmd: string) -> void { fake_st.fk_launch = cmd }

export function fake_add_friend(fake_st: mut FakeSteamState, id: long, name: string, state: int) -> void {
  let f = new FkFriend
  f.id = id
  f.name = name
  f.state = state
  push(fake_st.fk_friends, f)
}
export function fake_friend_in_game(fake_st: mut FakeSteamState, id: long, app: int, lobby: long) -> void {
  let f = fk_friend(fake_st, id)
  if f == null { return }
  f.game = app
  f.lobby = lobby
}
export function fake_friend_presence(fake_st: mut FakeSteamState, id: long, key: string, value: string) -> void {
  let k = fk_member_key(id, key)
  let i = fk_find(fake_st.fk_fr_k, k)
  if i < 0 {
    push(fake_st.fk_fr_k, k)
    push(fake_st.fk_fr_v, value)
  } else {
    fake_st.fk_fr_v[i] = value
  }
  let f = fk_push(fake_st, STF_PRESENCE)
  f.x = id
}
export function fake_persona_changed(fake_st: mut FakeSteamState, id: long, name: string) -> void {
  if id == FAKE_ME { fake_st.fk_persona = name }
  let f = fk_friend(fake_st, id)
  if f != null { f.name = name }
  let x = fk_push(fake_st, STF_PERSONA)
  x.x = id
  x.a = 1
}
export function fake_disconnect(fake_st: mut FakeSteamState) -> void {
  let f = fk_push(fake_st, STF_DISCONNECTED)
  f.a = 3
  fake_st.fk_logged_on = false
}
export function fake_connect(fake_st: mut FakeSteamState) -> void {
  fake_st.fk_logged_on = true
  fk_push(fake_st, STF_CONNECTED)
}
export function fake_overlay(fake_st: mut FakeSteamState, open: bool) -> void {
  let f = fk_push(fake_st, STF_OVERLAY)
  if open { f.a = 1 }
}

# a lobby somebody else owns, public unless made otherwise: a search may find it, a join may enter it
export function fake_remote_lobby(fake_st: mut FakeSteamState, id: long, owner: long, limit: int) -> void {
  let l = new FkLobby
  l.id = id
  l.owner = owner
  l.limit = limit
  l.kind = LOBBY_PUBLIC
  push(l.members, owner)
  push(fake_st.fk_lobbies, l)
}
export function fake_lobby_data(fake_st: mut FakeSteamState, id: long, key: string, value: string) -> void {
  let l = fk_lobby(fake_st, id)
  if l == null { return }
  let i = fk_find(l.dk, key)
  if i < 0 {
    push(l.dk, key)
    push(l.dv, value)
  } else {
    l.dv[i] = value
  }
}
export function fake_member_join(fake_st: mut FakeSteamState, id: long, who: long) -> void {
  let l = fk_lobby(fake_st, id)
  if l == null { return }
  if not fk_has_member(l, who) { push(l.members, who) }
  let f = fk_push(fake_st, STF_LOBBY_MEMBER)
  f.x = id
  f.y = who
  f.a = 1
}
export function fake_member_leave(fake_st: mut FakeSteamState, id: long, who: long, flags: int) -> void {
  let l = fk_lobby(fake_st, id)
  if l == null { return }
  let rest = new []long
  for i in 0 .. len(l.members) { if l.members[i] != who { push(rest, l.members[i]) } }
  l.members = rest
  let f = fk_push(fake_st, STF_LOBBY_MEMBER)
  f.x = id
  f.y = who
  f.a = flags
}
export function fake_member_data(fake_st: mut FakeSteamState, id: long, who: long, key: string, value: string) -> void {
  let l = fk_lobby(fake_st, id)
  if l == null { return }
  fk_member_set(l, who, key, value)
  let f = fk_push(fake_st, STF_LOBBY_DATA)
  f.x = id
  f.y = who
  f.a = 1
}
export function fake_chat(fake_st: mut FakeSteamState, id: long, who: long, text: string) -> void {
  let f = fk_push(fake_st, STF_LOBBY_CHAT)
  f.x = id
  f.y = who
  f.a = 1
  f.text = text
}
export function fake_kick_me(fake_st: mut FakeSteamState, id: long) -> void {
  fk_lobby_leave(fake_st, id)
  let f = fk_push(fake_st, STF_LOBBY_KICKED)
  f.x = id
}
export function fake_join_request(fake_st: mut FakeSteamState, friend: long, connect: string) -> void {
  let f = fk_push(fake_st, STF_JOIN_REQUEST)
  f.x = friend
  f.text = connect
}
export function fake_lobby_invite_accepted(fake_st: mut FakeSteamState, lobby: long, friend: long) -> void {
  let f = fk_push(fake_st, STF_LOBBY_JOIN_REQUEST)
  f.x = lobby
  f.y = friend
}

export function fake_board_entry(fake_st: mut FakeSteamState, name: string, who: long, score: int, sort: int) -> void {
  var b: FkBoard = null
  for i in 0 .. len(fake_st.fk_boards) { if fake_st.fk_boards[i].name == name { b = fake_st.fk_boards[i] } }
  if b == null {
    b = new FkBoard
    b.name = name
    b.sort = sort
    b.handle = FAKE_LEADERBOARD_BASE + long(len(fake_st.fk_boards))
    push(fake_st.fk_boards, b)
  }
  push(b.users, who)
  push(b.scores, score)
}

export function fake_add_dlc(fake_st: mut FakeSteamState, app: int, name: string, owned: bool) -> void {
  push(fake_st.fk_dlc_ids, app)
  push(fake_st.fk_dlc_names, name)
  push(fake_st.fk_dlc_owned, owned)
}
export function fake_dlc_installed(fake_st: mut FakeSteamState, app: int) -> void {
  let f = fk_push(fake_st, STF_DLC_INSTALLED)
  f.a = app
}
export function fake_add_controller(fake_st: mut FakeSteamState, id: long) -> void { push(fake_st.fk_controllers, id) }
export function fake_pad(fake_st: mut FakeSteamState, action: string, down: bool, x: float, y: float) -> void {
  var i = fk_find(fake_st.fk_pad_k, action)
  if i < 0 {
    push(fake_st.fk_pad_k, action)
    push(fake_st.fk_pad_x, 0.0)
    push(fake_st.fk_pad_y, 0.0)
    push(fake_st.fk_pad_d, 0)
    i = len(fake_st.fk_pad_k) - 1
  }
  fake_st.fk_pad_x[i] = x
  fake_st.fk_pad_y[i] = y
  if down { fake_st.fk_pad_d[i] = 1 } else { fake_st.fk_pad_d[i] = 0 }
}
export function fake_gamepad_text(fake_st: mut FakeSteamState, submitted: bool, text: string) -> void {
  let f = fk_push(fake_st, STF_GAMEPAD_TEXT)
  if submitted { f.a = 1 }
  f.text = text
}

# a session request from a user (accepted: the shim let them in), and one that failed
export function fake_net_session_request(fake_st: mut FakeSteamState, who: long, accepted: bool) -> void {
  let f = fk_push(fake_st, STF_NET_SESSION_REQUEST)
  f.x = who
  if accepted { f.a = 1 }
}
export function fake_net_session_failed(fake_st: mut FakeSteamState, who: long, reason: int) -> void {
  let f = fk_push(fake_st, STF_NET_SESSION_FAILED)
  f.x = who
  f.a = reason
}

# a datagram arriving from a Steam user
export function fake_net_inject(fake_st: mut FakeSteamState, from: long, b: []byte, n: int) -> void {
  let m = new FkFile
  m.data = buffer(Math.max(n, 1))
  for i in 0 .. n { m.data[i] = b[i] }
  m.n = n
  push(fake_st.fk_net_in, m)
  push(fake_st.fk_net_in_from, from)
}
export function fake_net_sent_count(fake_st: FakeSteamState) -> int { return len(fake_st.fk_net_sent) }
export function fake_net_sent_to(fake_st: FakeSteamState, i: int) -> long { return fake_st.fk_net_sent_to[i] }
export function fake_net_sent_len(fake_st: FakeSteamState, i: int) -> int { return fake_st.fk_net_sent[i].n }
export function fake_net_sent_byte(fake_st: FakeSteamState, i: int, k: int) -> int { return fake_st.fk_net_sent[i].data[k] }
export function fake_net_allowed(fake_st: FakeSteamState, id: long) -> bool {
  for i in 0 .. len(fake_st.fk_net_allowed) { if fake_st.fk_net_allowed[i] == id { return true } }
  return false
}

# what the game did to the fake
export function fake_presence_value(fake_st: FakeSteamState, key: string) -> string {
  let i = fk_find(fake_st.fk_rp_k, key)
  if i < 0 { return "" }
  return fake_st.fk_rp_v[i]
}
export function fake_presence_count(fake_st: FakeSteamState) -> int {
  var n = 0
  for i in 0 .. len(fake_st.fk_rp_k) { if len(fake_st.fk_rp_v[i]) > 0 { n += 1 } }
  return n
}
export function fake_stores(fake_st: FakeSteamState) -> int { return fake_st.fk_stores }
export function fake_resets(fake_st: FakeSteamState) -> int { return fake_st.fk_resets }
export function fake_ach(fake_st: FakeSteamState, api: string) -> bool { return fk_ach_get(fake_st, api) == 1 }
export function fake_ach_count(fake_st: FakeSteamState) -> int {
  var n = 0
  for i in 0 .. len(fake_st.fk_ach_v) { if fake_st.fk_ach_v[i] == 1 { n += 1 } }
  return n
}
export function fake_stat(fake_st: FakeSteamState, api: string) -> float { return fk_stat_float(fake_st, api) }
export function fake_lobby_size(fake_st: FakeSteamState, id: long) -> int { return fk_lobby_members(fake_st, id) }
export function fake_lobby_joinable(fake_st: FakeSteamState, id: long) -> bool {
  let l = fk_lobby(fake_st, id)
  return l != null and l.joinable
}
export function fake_overlay_calls(fake_st: FakeSteamState) -> []string { return fake_st.fk_overlays }
export function fake_timeline(fake_st: FakeSteamState) -> []string { return fake_st.fk_timeline }
export function fake_auth_live(fake_st: FakeSteamState) -> int { return fake_st.fk_auth_live }
export function fake_up(fake_st: FakeSteamState) -> bool { return fake_st.fk_up }
export function fake_pad_set(fake_st: FakeSteamState) -> string { return fake_st.fk_pad_set }
export function fake_overlay_corner(fake_st: FakeSteamState) -> int { return fake_st.fk_overlay_pos }
