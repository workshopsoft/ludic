# actors.ludic - the actors that hold pools: a row each, found by the game's number for the actor
function vt__vital(vitals_st: VitalsState, h: int) -> Vital {
  let r = tb_row(vitals_st.vt__vitals, h)
  if r < 0 { return null }
  return tb_rec(vitals_st.vt__vitals, r)
}

export function vitals_of(vitals_st: VitalsState, actor: int) -> int {
  let h = imap_get(vitals_st.vt__by_actor, actor, -1)
  if h < 0 or tb_row(vitals_st.vt__vitals, h) < 0 { return -1 }
  return h
}

export function vitals_count(vitals_st: VitalsState) -> int { return tb_len(vitals_st.vt__vitals) }

export function vitals_actor(vitals_st: VitalsState, h: int) -> int {
  let r = vt__vital(vitals_st, h)
  if r == null { return -1 }
  return r.actor
}

# every pool an actor of the class has, at its start; the ones it has not, at -1
function vt__fill_pools(v: Vital) -> void {
  for p in 0 .. VPOOL_COUNT {
    if not vt__class_has(v.kind, p) {
      v.maxs[p] = -1.0
      v.vals[p] = 0.0
      v.wait[p] = 0.0
      continue
    }
    if v.maxs[p] < 0.0 { v.maxs[p] = vt__base_max(v.kind, p) }
    v.vals[p] = v.maxs[p] * vt__base_start(v.kind, p)
    v.wait[p] = 0.0
  }
}

# a record for an actor: one given back by vitals_remove, else (only past the most actors held at once,
# once) a new one with its three pool lists. A record is never thrown away, so a crowd that churns
# costs nothing per spawn
@alloc_ok("past the most actors ever held at once: a record made once, then kept and reused")
function vt__record(vitals_st: mut VitalsState) -> Vital {
  if len(vitals_st.vt__free) > 0 { return List.pop(vitals_st.vt__free) }
  return vt__blank()
}

@alloc_ok("a record and its pool lists, made at the start or past the high water")
function vt__blank() -> Vital {
  let r = new Vital
  r.vals = new []float
  r.maxs = new []float
  r.wait = new []float
  for p in 0 .. VPOOL_COUNT {
    push(r.vals, 0.0)
    push(r.maxs, -1.0)
    push(r.wait, 0.0)
  }
  return r
}

# every field as a new actor has it (the pool lists keep their length). The phase is the machine's: a record
# given back in another phase is brought to Alive by VitalsRecycle first
function vt__wipe(r: Vital) -> void {
  r.actor = -1
  r.persist = true
  r.kind = 0
  r.mine = false
  r.invuln = 0.0
  r.bleed = 0.0
  r.dying = false
  r.quiet = false
  r.frac_in = 0.0
  r.by_in = -1
  r.last_source = -1
  r.last_type = -1
  r.last_zone = -1
  r.last_crit = false
  r.seq = 0
  for p in 0 .. VPOOL_COUNT {
    r.vals[p] = 0.0
    r.maxs[p] = -1.0
    r.wait[p] = 0.0
  }
}

# an actor's record goes back to the free list; its handle's generation has moved on, so a stale handle misses
function vt__give_back(vitals_st: mut VitalsState, r: Vital) -> void {
  vt__wipe(r)
  kept_push(vitals_st.vt__free, r)
}

function vt__make(vitals_st: mut VitalsState, actor: int, kind: int, persist: bool, phase: VitalPhase) -> int {
  let r = vt__record(vitals_st)
  vt__wipe(r)
  r.actor = actor
  r.kind = kind
  r.persist = persist
  vt__fill_pools(r)
  if vt__kind_ok(kind) { r.invuln = VitalClasses[kind].spawn_invuln }
  let h = tb_add(vitals_st.vt__vitals, r)
  imap_put(vitals_st.vt__by_actor, actor, h)
  if phase != VitalPhase.Alive {
    # a mirror of an actor already downed or dead: the machine takes it there without facts (quiet)
    r.quiet = true
    if phase == VitalPhase.Downed { dispatch VitalsDownIn { who: h } } else { dispatch VitalsDieIn { who: h } }
    drain_actions()
  }
  return h
}

# room for `n` actors made now, before play: their records, the table's rows and the map. No spawn allocates
# until more than n are held at once; `VitalsSettings` row 0's `max_actors` is what a state starts with
@alloc_ok("before play: the records, rows and map for n actors")
export function vitals_reserve(vitals_st: mut VitalsState, n: int) -> void {
  while len(vitals_st.vt__free) + tb_len(vitals_st.vt__vitals) < n { push(vitals_st.vt__free, vt__blank()) }
  tb_reserve(vitals_st.vt__vitals, n)
  imap_reserve(vitals_st.vt__by_actor, n * 2)
}

# an actor starts to hold pools as a class (a VitalClasses row); returns its handle (the same if it already does)
export function vitals_add(vitals_st: mut VitalsState, actor: int, kind: int, persist: bool) -> int {
  let have = vitals_of(vitals_st, actor)
  if have >= 0 { return have }
  return vt__make(vitals_st, actor, kind, persist, VitalPhase.Alive)
}

export function vitals_remove(vitals_st: mut VitalsState, h: int) -> bool {
  let r = vt__vital(vitals_st, h)
  if r == null { return false }
  imap_del(vitals_st.vt__by_actor, r.actor)
  if r.phase != VitalPhase.Alive {
    # the machine alone writes the phase: it brings the record back to Alive before it is kept
    dispatch VitalsRecycle { who: h }
    drain_actions()
  }
  if not tb_remove(vitals_st.vt__vitals, h) { return false }
  vt__give_back(vitals_st, r)
  return true
}

# this machine owns the actor: its `predict` pools are simulated here (a guest's own player)
export function vitals_set_mine(vitals_st: mut VitalsState, h: int, mine: bool) -> bool {
  let r = vt__vital(vitals_st, h)
  if r == null { return false }
  r.mine = mine
  return true
}
