# queries.ludic - what the world asks the fire
export function fire_lit(fire_st: FireState) -> bool { return fire_st.fr_lit }

# game minutes of fuel left
export function fire_fuel(fire_st: FireState) -> float { return fire_st.fr_fuel }

export function fire_low(fire_st: FireState) -> bool { return fire_st.fr_lit and fire_st.fr_fuel < fire_st.fr_low_minutes }

# game hours today it has burned in the rain with something over it
export function fire_rain_hours(fire_st: FireState) -> float { return fire_st.fr_rain_h }

# does it warm a body `dist` metres from it?
export function fire_warms(fire_st: FireState, dist: float) -> bool { return fire_st.fr_lit and dist < fire_st.fr_warm_radius }

# will it cook for someone `dist` metres from it? (a station that stands on it asks only fire_lit)
export function fire_cooks(fire_st: FireState, dist: float) -> bool { return fire_st.fr_lit and dist < fire_st.fr_cook_radius }
