# net.ludic - cars in a party. THE MODEL: every car has one authority, the machine that simulates it
# (`c.auth`): the host for all of them (CAR_AUTH_HOST, the default) or the driver's own machine for the car it
# drives (CAR_AUTH_OWNER: its own handling feels exact to it, and the host checks what it claims). The
# authority sends a snapshot of each car it simulates at `snap_hz`; everybody else keeps the last few in a
# ring and shows the car a little in the past (`interp_delay`), interpolated between the two that bracket
# that time and, past the newest, carried on along its heading for a quarter of a second at most. A guest
# that drives under host authority sends its controls (CarInput, six numbers) and the host applies them only
# from the car's actual driver. Snapshots are fourteen ints written into, and read from, slices the game
# keeps (`words(n)`): nothing is made per frame. The game carries them in ludic.net messages (nw_i / nr_i).

export const CAR_SNAP_WORDS: int = 14
export const CAR_INPUT_WORDS: int = 6

function cr_q(x: float, k: float) -> int { return int(Math.floor(x * k + 0.5)) }

# the flags a snapshot carries: what a guest needs to draw and hear the car
function cr_flags(c: Car) -> int {
  var f = 0
  if c.engine_on { f = f | 1 }
  if c.horn { f = f | 2 }
  if c.nitro_on { f = f | 4 }
  f = f | ((c.indicator + 1) << 3)
  f = f | ((c.lights & 63) << 5)
  f = f | (int(c.phase) << 11)
  f = f | (c.smoke << 14)
  if c.airborne { f = f | (1 << 16) }
  return f
}

export function car_popped_mask(c: Car) -> int {
  var mask = 0
  for i in 0 .. Math.min(c.nwheels, 30) { if c.wheels[i].popped { mask = mask | (1 << i) } }
  return mask
}

# `nid`'s snapshot into out[at .. at + CAR_SNAP_WORDS); false when there is no such car, or this machine is
# not its authority (it must not speak for another's car)
export function car_snap_write(cars_st: CarsState, nid: int, out: []int, at: int) -> bool {
  let c = car_by_nid(cars_st, nid)
  if c == null or c.auth != CarWorld.me() or c.sim == CAR_SIM_REMOTE { return false }
  let m = CarModels[c.model]
  var pitch = Math.asin(Math.clamp(c.fy, -1.0, 1.0))
  let ry = c.fz * c.ux - c.fx * c.uz
  out[at] = c.nid
  out[at + 1] = cr_q(cars_st.cr_time, 1000.0)
  out[at + 2] = cr_q(c.x, 1000.0)
  out[at + 3] = cr_q(c.y, 1000.0)
  out[at + 4] = cr_q(c.z, 1000.0)
  out[at + 5] = cr_q(c.yaw, 10000.0)
  out[at + 6] = cr_q(pitch, 10000.0)
  out[at + 7] = cr_q(Math.atan2(-ry, c.uy), 10000.0)
  out[at + 8] = cr_q(c.speed, 1000.0)
  out[at + 9] = cr_q(c.steer_angle, 10000.0)
  out[at + 10] = (cr_q(c.rpm, 1.0) & 65535) | ((c.gear + 2) << 16)
  out[at + 11] = cr_flags(c)
  out[at + 12] = car_popped_mask(c)
  out[at + 13] = (cr_q(c.health / Math.max(1.0, c.stats.health), 1000.0) & 65535) | (cr_q(c.engine_hp / Math.max(1.0, m.engine_health), 1000.0) << 16)
  return true
}

# true when it is time for this car's next snapshot (the authority's cars only), `dt` since the last ask
export function car_snap_due(cars_st: CarsState, nid: int, dt: float) -> bool {
  let c = car_by_nid(cars_st, nid)
  if c == null or c.auth != CarWorld.me() or c.sim == CAR_SIM_REMOTE { return false }
  c.snap_t = c.snap_t - dt
  if c.snap_t > 0.0 { return false }
  let hz = Math.max(1, cars_config(cars_st).snap_hz)
  c.snap_t = c.snap_t + 1.0 / float(hz)
  if c.snap_t < 0.0 { c.snap_t = 1.0 / float(hz) }
  c.snap_seq += 1
  return true
}

# could the snapshot be true? Not faster than the limit since the last one taken, not from a car that is not the sender's
function cr_snap_plausible(cars_st: CarsState, c: Car, words: []int, at: int) -> bool {
  if not c.net_ok or c.ring_n == 0 { return true }
  let newest = (c.ring_head + c.ring_n - 1) % CAR_NET_RING
  let b = newest * CAR_NET_FIELDS
  let t = float(words[at + 1]) / 1000.0
  let dt = t - c.ring[b]
  if dt <= 0.0 { return true }
  let dx = float(words[at + 2]) / 1000.0 - c.ring[b + 1]
  let dz = float(words[at + 4]) / 1000.0 - c.ring[b + 3]
  let d = Math.sqrt(dx * dx + dz * dz)
  let lim = cars_config(cars_st).max_speed_check
  if lim <= 0.0 { return true }
  return d / Math.max(dt, 0.02) <= lim * 1.5
}

# a snapshot taken in: `from` is the machine it came from (-1 to skip the check that it is the car's authority).
# Returns 0; 1 when it is for a car this machine simulates or does not know; CAR_SNAP_REFUSED when it could not be true
export function car_snap_read(cars_st: mut CarsState, words: []int, at: int, from: int) -> int {
  let c = car_by_nid(cars_st, words[at])
  if c == null { return 1 }
  if c.auth == CarWorld.me() and c.sim != CAR_SIM_REMOTE { return 1 }
  if from >= 0 and from != c.auth { return CAR_SNAP_REFUSED }
  if not cr_snap_plausible(cars_st, c, words, at) {
    let f = cr_fact(cars_st, CAR_SNAP_REFUSED, c)
    f.actor = from
    return CAR_SNAP_REFUSED
  }
  let t = float(words[at + 1]) / 1000.0
  let d = t - cars_st.cr_net_clock
  if not cars_st.cr_net_have {
    cars_st.cr_net_off = d
    cars_st.cr_net_have = true
  } else if d > cars_st.cr_net_off {
    cars_st.cr_net_off = d
  }
  if c.ring_n > 0 {
    let newest = (c.ring_head + c.ring_n - 1) % CAR_NET_RING
    if t <= c.ring[newest * CAR_NET_FIELDS] { return 0 }
  }
  var slot = (c.ring_head + c.ring_n) % CAR_NET_RING
  if c.ring_n == CAR_NET_RING {
    c.ring_head = (c.ring_head + 1) % CAR_NET_RING
  } else { c.ring_n += 1 }
  let b = slot * CAR_NET_FIELDS
  c.ring[b] = t
  c.ring[b + 1] = float(words[at + 2]) / 1000.0
  c.ring[b + 2] = float(words[at + 3]) / 1000.0
  c.ring[b + 3] = float(words[at + 4]) / 1000.0
  c.ring[b + 4] = float(words[at + 5]) / 10000.0
  c.ring[b + 5] = float(words[at + 6]) / 10000.0
  c.ring[b + 6] = float(words[at + 7]) / 10000.0
  c.ring[b + 7] = float(words[at + 8]) / 1000.0
  c.ring[b + 8] = float(words[at + 9]) / 10000.0
  c.ring[b + 9] = float(words[at + 11])
  c.ring[b + 10] = float(words[at + 10])
  c.net_ok = true
  c.net_mask = words[at + 12]
  c.health = float(words[at + 13] & 65535) / 1000.0 * c.stats.health
  c.engine_hp = float((words[at + 13] >> 16) & 65535) / 1000.0 * CarModels[c.model].engine_health
  return 0
}

function cr_lerp_angle(a: float, b: float, k: float) -> float {
  var d = b - a
  while d > 3.14159265 { d = d - 6.2831853 }
  while d < -3.14159265 { d = d + 6.2831853 }
  return a + d * k
}

# a remote car, shown where the snapshots say it was `interp_delay` ago
function cr_remote_run(cars_st: mut CarsState, c: Car, dt: float) -> void {
  if not c.net_ok or c.ring_n == 0 { return }
  let cfg = cars_config(cars_st)
  let tr = cars_st.cr_net_clock + cars_st.cr_net_off - cfg.interp_delay
  let oldest = c.ring_head
  let newest = (c.ring_head + c.ring_n - 1) % CAR_NET_RING
  let bn = newest * CAR_NET_FIELDS
  let bo = oldest * CAR_NET_FIELDS
  var x = 0.0
  var y = 0.0
  var z = 0.0
  var yaw = 0.0
  var pitch = 0.0
  var lean = 0.0
  var speed = 0.0
  var steer = 0.0
  var flags = 0
  var rpmgear = 0
  if tr >= c.ring[bn] {
    # past the newest: carried on along its heading, for a quarter of a second at most
    let over = Math.min(tr - c.ring[bn], 0.25)
    yaw = c.ring[bn + 4]
    speed = c.ring[bn + 7]
    x = c.ring[bn + 1] + Math.sin(yaw) * speed * over
    y = c.ring[bn + 2]
    z = c.ring[bn + 3] + Math.cos(yaw) * speed * over
    pitch = c.ring[bn + 5]
    lean = c.ring[bn + 6]
    steer = c.ring[bn + 8]
    flags = int(c.ring[bn + 9])
    rpmgear = int(c.ring[bn + 10])
  } else if tr <= c.ring[bo] {
    x = c.ring[bo + 1]
    y = c.ring[bo + 2]
    z = c.ring[bo + 3]
    yaw = c.ring[bo + 4]
    pitch = c.ring[bo + 5]
    lean = c.ring[bo + 6]
    speed = c.ring[bo + 7]
    steer = c.ring[bo + 8]
    flags = int(c.ring[bo + 9])
    rpmgear = int(c.ring[bo + 10])
  } else {
    var a = oldest
    for i in 1 .. c.ring_n {
      let nxt = (c.ring_head + i) % CAR_NET_RING
      if c.ring[nxt * CAR_NET_FIELDS] >= tr { break }
      a = nxt
    }
    let b2 = (a + 1) % CAR_NET_RING
    let ba = a * CAR_NET_FIELDS
    let bb = b2 * CAR_NET_FIELDS
    let span = Math.max(0.0001, c.ring[bb] - c.ring[ba])
    let k = Math.clamp((tr - c.ring[ba]) / span, 0.0, 1.0)
    x = c.ring[ba + 1] + (c.ring[bb + 1] - c.ring[ba + 1]) * k
    y = c.ring[ba + 2] + (c.ring[bb + 2] - c.ring[ba + 2]) * k
    z = c.ring[ba + 3] + (c.ring[bb + 3] - c.ring[ba + 3]) * k
    yaw = cr_lerp_angle(c.ring[ba + 4], c.ring[bb + 4], k)
    pitch = c.ring[ba + 5] + (c.ring[bb + 5] - c.ring[ba + 5]) * k
    lean = c.ring[ba + 6] + (c.ring[bb + 6] - c.ring[ba + 6]) * k
    speed = c.ring[ba + 7] + (c.ring[bb + 7] - c.ring[ba + 7]) * k
    steer = c.ring[ba + 8] + (c.ring[bb + 8] - c.ring[ba + 8]) * k
    flags = int(c.ring[bb + 9])
    rpmgear = int(c.ring[bb + 10])
  }
  let ox = c.x
  let oy = c.y
  let oz = c.z
  c.x = x
  c.y = y
  c.z = z
  c.yaw = yaw
  let cp = Math.cos(pitch)
  c.fx = Math.sin(yaw) * cp
  c.fy = Math.sin(pitch)
  c.fz = Math.cos(yaw) * cp
  let r0x = -Math.cos(yaw)
  let r0z = Math.sin(yaw)
  let u0x = -r0z * c.fy
  let u0y = r0z * c.fx - r0x * c.fz
  let u0z = r0x * c.fy
  let cl = Math.cos(lean)
  let sl = Math.sin(lean)
  c.ux = u0x * cl + r0x * sl
  c.uy = u0y * cl
  c.uz = u0z * cl + r0z * sl
  c.speed = speed
  c.vx = c.fx * speed
  c.vy = c.fy * speed
  c.vz = c.fz * speed
  if dt > 0.0 and (ox != 0.0 or oz != 0.0) {
    c.vx = (x - ox) / dt
    c.vy = (y - oy) / dt
    c.vz = (z - oz) / dt
  }
  c.steer_angle = steer
  c.engine_on = (flags & 1) != 0
  c.horn = (flags & 2) != 0
  c.nitro_on = (flags & 4) != 0
  c.indicator = ((flags >> 3) & 3) - 1
  c.lights = (flags >> 5) & 63
  c.smoke = (flags >> 14) & 3
  c.airborne = ((flags >> 16) & 1) != 0
  c.rpm = float(rpmgear & 65535)
  c.gear = ((rpmgear >> 16) & 65535) - 2
  let mask = c.net_mask
  let m = CarModels[c.model]
  for i in 0 .. c.nwheels {
    let w = c.wheels[i]
    w.popped = i < 30 and ((mask >> i) & 1) != 0
    w.steer = steer * m.axles[w.axle].steer
    w.spin = speed / Math.max(0.05, m.axles[w.axle].radius)
    w.roll += w.spin * dt
    w.contact = not c.airborne
    w.ext = m.axles[w.axle].travel * 0.65
  }
}

# ---- a driver's controls across the wire, for a car the host simulates

export function car_input_write(cars_st: CarsState, nid: int, out: []int, at: int) -> bool {
  let c = car_by_nid(cars_st, nid)
  if c == null { return false }
  var f = 0
  if c.in_nitro { f = f | 1 }
  if c.in_horn { f = f | 2 }
  out[at] = c.nid
  out[at + 1] = cr_q(c.in_throttle, 1000.0)
  out[at + 2] = cr_q(c.in_brake, 1000.0)
  out[at + 3] = cr_q(c.in_steer, 1000.0)
  out[at + 4] = cr_q(c.in_hand, 1000.0)
  out[at + 5] = f
  return true
}

# a driver's controls taken in: applied only when `from` is the car's driver (nobody steers a car they are not in)
export function car_input_read(cars_st: mut CarsState, words: []int, at: int, from: int) -> bool {
  let c = car_by_nid(cars_st, words[at])
  if c == null { return false }
  if from != car_driver(c) { return false }
  c.in_throttle = Math.clamp(float(words[at + 1]) / 1000.0, 0.0, 1.0)
  c.in_brake = Math.clamp(float(words[at + 2]) / 1000.0, 0.0, 1.0)
  c.in_steer = Math.clamp(float(words[at + 3]) / 1000.0, -1.0, 1.0)
  c.in_hand = Math.clamp(float(words[at + 4]) / 1000.0, 0.0, 1.0)
  c.in_nitro = (words[at + 5] & 1) != 0
  c.in_horn = (words[at + 5] & 2) != 0
  if c.in_horn != c.horn { car_horn(cars_st, c.nid, c.in_horn) }
  return true
}

# who simulates a car now (after a change of driver under owner authority): a car this machine just became the
# authority of starts from where its snapshots last put it
export function car_set_authority(cars_st: mut CarsState, nid: int) -> bool {
  let c = car_by_nid(cars_st, nid)
  if c == null { return false }
  let a = car_authority(cars_st, c)
  if a == c.auth { return true }
  c.auth = a
  if a != CarWorld.me() {
    if c.body {
      CarBody.drop(c.nid)
      c.body = false
    }
    c.sim = CAR_SIM_REMOTE
    c.ring_n = 0
    c.ring_head = 0
  } else if c.sim == CAR_SIM_REMOTE {
    c.sim = CAR_SIM_PLANAR
    c.have_prev = false
    c.vx = 0.0
    c.vz = 0.0
    c.speed = 0.0
  }
  return true
}
