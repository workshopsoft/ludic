# jolt_body.ludic - the reference binding of a car's body to ludic.physics, as a game writes it: a box of the
# model's dimensions about its origin (so the body's centre is where the box's is), forces pushed at the points
# they act (a force and the torque it makes about the body's centre), wheel rays cast against the solid world.
# The car's forward is the body's local +z and its up local +y; the body's yaw is the car's yaw.
state Bodies {
  ids: IntMap = imap_new()
  pose: PhysPose = new PhysPose
  hit: PhysHit = new PhysHit
  focus: float = 0.0
  gravel_from_z: float = 1000000.0
  made: int = 0
  ai_from: int = 1000000
  cys: IntMap = imap_new()
}

function jb_body(bodies_st: Bodies, nid: int) -> int { return imap_get(bodies_st.ids, nid, -1) }

function jb_make(physics_st: mut PhysicsState, bodies_st: mut Bodies, nid: int, model: int, x: float, y: float, z: float, yaw: float, vx: float, vy: float, vz: float) -> bool {
  if not phys_is_open(physics_st) { return false }
  let m = CarModels[model]
  let shape = phys_offset(physics_st, phys_box(physics_st, m.width * 0.5, m.height * 0.5, m.length * 0.5), 0.0, car_body_centre(model), 0.0, 0.0)
  let id = phys_body_add(physics_st, shape, x, y, z, yaw, m.mass)
  if id < 0 { return false }
  phys_own(physics_st, id, shape)
  phys_set_velocity(physics_st, id, vx, vy, vz)
  imap_put(bodies_st.ids, nid, id)
  imap_put(bodies_st.cys, nid, int(car_body_centre(model) * 1000.0))
  bodies_st.made += 1
  return true
}

function jb_drop(physics_st: mut PhysicsState, bodies_st: mut Bodies, nid: int) -> void {
  let id = jb_body(bodies_st, nid)
  if id < 0 { return }
  phys_remove(physics_st, id)
  imap_del(bodies_st.ids, nid)
}

function jb_read(physics_st: mut PhysicsState, bodies_st: mut Bodies, nid: int, p: CarPose) -> bool {
  let id = jb_body(bodies_st, nid)
  if id < 0 { return false }
  let q = bodies_st.pose
  if not phys_pose(physics_st, id, q) { return false }
  p.x = q.x
  p.y = q.y
  p.z = q.z
  p.fx = 2.0 * (q.qx * q.qz + q.qw * q.qy)
  p.fy = 2.0 * (q.qy * q.qz - q.qw * q.qx)
  p.fz = 1.0 - 2.0 * (q.qx * q.qx + q.qy * q.qy)
  p.ux = 2.0 * (q.qx * q.qy - q.qw * q.qz)
  p.uy = 1.0 - 2.0 * (q.qx * q.qx + q.qz * q.qz)
  p.uz = 2.0 * (q.qy * q.qz + q.qw * q.qx)
  p.vx = q.vx
  p.vy = q.vy
  p.vz = q.vz
  return true
}

# a force at a world point: the force through the body's centre, and the torque the lever makes
function jb_push(physics_st: mut PhysicsState, bodies_st: mut Bodies, nid: int, fx: float, fy: float, fz: float, px: float, py: float, pz: float) -> void {
  let id = jb_body(bodies_st, nid)
  if id < 0 { return }
  let q = bodies_st.pose
  if not phys_pose(physics_st, id, q) { return }
  # the body's centre: the origin lifted along the body's up by the box's middle
  let uxx = 2.0 * (q.qx * q.qy - q.qw * q.qz)
  let uyy = 1.0 - 2.0 * (q.qx * q.qx + q.qz * q.qz)
  let uzz = 2.0 * (q.qy * q.qz + q.qw * q.qx)
  let cy = float(imap_get(bodies_st.cys, nid, 0)) / 1000.0
  let cx = q.x + uxx * cy
  let cyy = q.y + uyy * cy
  let cz = q.z + uzz * cy
  let rx = px - cx
  let ry = py - cyy
  let rz = pz - cz
  phys_force(physics_st, id, fx, fy, fz)
  phys_torque(physics_st, id, ry * fz - rz * fy, rz * fx - rx * fz, rx * fy - ry * fx)
}

function jb_torque(physics_st: mut PhysicsState, bodies_st: mut Bodies, nid: int, tx: float, ty: float, tz: float) -> void {
  let id = jb_body(bodies_st, nid)
  if id < 0 { return }
  phys_torque(physics_st, id, tx, ty, tz)
}

function jb_step(physics_st: mut PhysicsState, dt: float) -> void { phys_step(physics_st) }

function jb_cast(physics_st: mut PhysicsState, bodies_st: mut Bodies, ox: float, oy: float, oz: float, dx: float, dy: float, dz: float, len: float, h: CarHit) -> bool {
  let q = bodies_st.hit
  if not phys_ray(physics_st, ox, oy, oz, dx * len, dy * len, dz * len, PHYS_M_SOLID, q) { return false }
  h.dist = q.fraction * len
  h.nx = q.nx
  h.ny = q.ny
  h.nz = q.nz
  h.grip = 1.0
  if q.z > bodies_st.gravel_from_z { h.grip = 0.5 }
  h.body = q.body
  return true
}

function jb_grip(bodies_st: Bodies, x: float, z: float) -> float {
  if z > bodies_st.gravel_from_z { return 0.5 }
  return 1.0
}

function jb_is_player(bodies_st: Bodies, actor: int) -> bool { return actor < bodies_st.ai_from }

function jb_focus(bodies_st: Bodies, x: float, z: float) -> float { return bodies_st.focus }

bind CarBody { make: fn jb_make, drop: fn jb_drop, read: fn jb_read, push: fn jb_push, torque: fn jb_torque, step: fn jb_step }
bind CarWorld { cast: fn jb_cast, grip: fn jb_grip, focus: fn jb_focus, is_player: fn jb_is_player }
