# cars_dev_test.ludic - what the editor's link asks of the cars: `cars_near x z r max?` and `car_get id`, run as the
# link runs them: the count then fixed-width records, nearest first, inside the reply cap
import "ludic.cars"
import "ludic.base"
program CarsDevTest {
  numbers float
  def CarTyres from "cars_tyres.lres"
  def CarClasses from "cars_classes.lres"
  def CarModels from "cars_models.lres"
  def CarSeats from "cars_seats.lres"
  def CarSockets from "cars_sockets.lres"
  def CarParts from "cars_parts.lres"
  def CarLiveries from "cars_liveries.lres"

  function ask(c: DevCall, x: float, z: float, r: float, max: int) -> void {
    devcall_clear(c)
    c.n = 3
    c.f[0] = x
    c.f[1] = z
    c.f[2] = r
    for k in 0 .. 3 { c.has[k] = 1 }
    if max >= 0 {
      c.n = 4
      c.has[3] = 1
      c.i[3] = max
    }
  }
  function spaces(c: DevCall) -> int {
    var n = 0
    for i in 0 .. c.out_n { if c.out[i] == 32 { n += 1 } }
    return n
  }
  function reply(c: DevCall) -> string { return text_of(c.out, c.out_n) }

  test "cars_near answers the count and the nearest first, one record of seven values each; the yaw is render3d's degrees" (cars_st: mut CarsState) {
    let a = car_spawn(cars_st, CARM_SEDAN, 10.0, 0.0, 0.0, -1)
    let b = car_spawn(cars_st, CARM_SEDAN, 3.0, 0.0, 1.5707963, -1)
    let d = car_spawn(cars_st, CARM_SEDAN, -30.0, 0.0, 0.0, -1)
    let far = car_spawn(cars_st, CARM_SEDAN, 900.0, 900.0, 0.0, -1)
    expect(a >= 0 and b >= 0 and d >= 0 and far >= 0)
    let c = devcall_new()
    ask(c, 0.0, 0.0, 50.0, 2)
    expect_eq(DevVerbs[DVB_CARS_NEAR].run(c), DV_OK)
    let t = reply(c)
    print(`cars_near 0 0 50 2 -> ok{t}`)
    # b faces +x (yaw pi/2 faces (sin, cos) = +x), which is 270 degrees for render3d (0 -> -z, 90 -> -x)
    expect(Text.starts_with(t, ` 2 {b} 3.000 `))
    expect(Text.contains(t, ` 270.000 0.000 `))
    expect(Text.contains(t, ` {a} 10.000 `))
    expect(Text.contains(t, ` 180.000 0.000 `))     # a faces +z: 180
    expect(not Text.contains(t, ` {d} `))
    expect_eq(spaces(c), 1 + 2 * 7)
    ask(c, 0.0, 0.0, 50.0, -1)
    expect_eq(DevVerbs[DVB_CARS_NEAR].run(c), DV_OK)
    expect(Text.starts_with(reply(c), " 3 "))
    expect_eq(spaces(c), 1 + 3 * 7)
    ask(c, 0.0, 0.0, 1.0, -1)
    expect_eq(DevVerbs[DVB_CARS_NEAR].run(c), DV_OK)
    expect_eq(reply(c), " 0")
    ask(c, 0.0, 0.0, -1.0, -1)
    expect_eq(DevVerbs[DVB_CARS_NEAR].run(c), DV_BAD)
  }

  test "cars_near keeps its answer inside the reply cap, at the far edge of the map: 16 cars at -9999.999" (cars_st: mut CarsState) {
    for i in 0 .. 20 {
      let n = car_spawn(cars_st, CARM_SEDAN, 0.0, 0.0, 0.0, -1)
      expect(car_place(cars_st, n, -9999.999, -9999.999, 3.9))
    }
    let c = devcall_new()
    ask(c, -9999.999, -9999.999, 100.0, -1)
    expect_eq(DevVerbs[DVB_CARS_NEAR].run(c), DV_OK)
    expect(Text.starts_with(reply(c), " 12 "))
    expect_eq(spaces(c), 1 + 12 * 7)
    ask(c, -9999.999, -9999.999, 100.0, 500)
    expect_eq(DevVerbs[DVB_CARS_NEAR].run(c), DV_OK)
    print(`cars_near, 16 cars at -9999.999: {c.out_n} of {DV_OUT} bytes`)
    expect(c.out_n < DV_OUT)
    expect(Text.starts_with(reply(c), " 16 "))
    expect_eq(spaces(c), 1 + 16 * 7)
  }

  test "car_get answers one car's x y z yaw speed engine_on, and refuses one that is gone" (cars_st: mut CarsState) {
    let a = car_spawn(cars_st, CARM_SEDAN, 10.0, 4.0, 0.0, -1)
    let c = devcall_new()
    c.n = 1
    c.has[0] = 1
    c.i[0] = a
    expect_eq(DevVerbs[DVB_CAR_GET].run(c), DV_OK)
    expect(Text.starts_with(reply(c), " 10.000 "))
    expect(Text.contains(reply(c), " 4.000 180.000 0.000 "))
    expect_eq(spaces(c), 6)
    car_engine(cars_st, a, true)
    expect_eq(DevVerbs[DVB_CAR_GET].run(c), DV_OK)
    # a bool is written as the word true/false
    let on = Text.ends_with(reply(c), " true")
    expect(on or Text.ends_with(reply(c), " false"))
    expect_eq(on, car_by_nid(cars_st, a).engine_on)
    c.i[0] = 99999
    expect_eq(DevVerbs[DVB_CAR_GET].run(c), DV_BAD)
  }
}
