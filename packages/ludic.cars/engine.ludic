# engine.ludic - the engine, the gearbox and the brakes: what a driver's pedals and the speed of the wheels
# make of a step. It answers in the car's own fields - the torque at each driven wheel and the force each
# wheel's brake gives - which both the body model and the planar model apply, so a car has one drivetrain.

function cr_sign(x: float) -> float {
  if x > 0.0 { return 1.0 }
  if x < 0.0 { return -1.0 }
  return 0.0
}

function cr_mean_spin(c: Car, front: bool) -> float {
  var sum = 0.0
  var n = 0
  for i in 0 .. c.nwheels {
    let w = c.wheels[i]
    if car_axle_front(c.model, w.axle) != front { continue }
    if not car_axle_driven(c.model, w.axle) { continue }
    sum += w.spin
    n += 1
  }
  if n == 0 { return 0.0 }
  return sum / float(n)
}

# a gear change begun: the torque is cut for the shift time, then the gear is the new one
function cr_shift_to(cars_st: mut CarsState, c: Car, to: int) -> void {
  if to == c.gear or c.shift_t > 0.0 { return }
  let m = CarModels[c.model]
  if to < 0 or c.gear < 0 or to == 0 {
    # through neutral: no cut worth having at a stand
    let f = cr_fact(cars_st, CAR_SHIFT, c)
    f.v = float(c.gear)
    f.w = float(to)
    c.gear = to
    return
  }
  c.shift_to = to
  c.shift_t = m.shift_time * c.stats.shift
  if c.shift_t <= 0.0 {
    let f = cr_fact(cars_st, CAR_SHIFT, c)
    f.v = float(c.gear)
    f.w = float(to)
    c.gear = to
  }
}

# how slow a car is standing (m/s, either way): the gear changes its way only then
export const CR_STANDSTILL: float = 0.15

# the pedals and the speed make a step's torque and braking. `drv_front` and `drv_rear` are the mean spins
# (rad/s) of the driven wheels of each end. A driver's brake is the reverse pedal once the car is stopped
function cr_powertrain(cars_st: mut CarsState, c: Car, dt: float, drv_front: float, drv_rear: float) -> void {
  let m = CarModels[c.model]
  let s = c.stats
  let n = car_gear_count(c.model)
  var throttle = c.in_throttle
  var brake = c.in_brake
  var hand = c.in_hand
  let driven = c.phase == CarPhase.Driven or c.phase == CarPhase.Jacked
  if not driven or not c.engine_on {
    # nobody at the pedals: the car is held (a little brake, the handbrake) and the engine is idle
    throttle = 0.0
    if not driven {
      brake = 0.0
      hand = 1.0
    }
  }
  # the gear: a STOPPED car goes into reverse on the brake, forward on the throttle. Until it stands (CR_STANDSTILL) the other pedal
  # only brakes it: a driver's S while rolling forward, or W while rolling back, stops the car first and never flips its way
  if c.engine_on and driven and c.shift_t <= 0.0 {
    if c.gear <= 0 and throttle > 0.05 and c.speed > -CR_STANDSTILL { cr_shift_to(cars_st, c, 1) }
    else if c.gear > 0 and brake > 0.05 and throttle < 0.05 and c.speed < CR_STANDSTILL and not c.ai { cr_shift_to(cars_st, c, -1) }
    else if c.gear < 0 and c.speed > 1.0 { cr_shift_to(cars_st, c, 1) }
    else if c.gear > 0 and c.speed < -1.0 and throttle < 0.05 { cr_shift_to(cars_st, c, -1) }
  }
  var dem = throttle
  var stop = brake
  if c.gear < 0 and c.engine_on {
    dem = brake
    stop = throttle
  }
  if not c.engine_on { dem = 0.0 }
  # how fast the driven wheels turn the engine, through the gear
  let ratio = car_ratio(c.model, s, c.gear)
  var share_f = 0.0
  var share_r = 0.0
  var nf = 0
  var nr = 0
  var nfall = 0
  var nrall = 0
  var nh = 0
  for i in 0 .. c.nwheels {
    let w = c.wheels[i]
    let front = car_axle_front(c.model, w.axle)
    if front { nfall += 1 } else { nrall += 1 }
    if m.axles[w.axle].handbrake { nh += 1 }
    if car_axle_driven(c.model, w.axle) {
      if front { nf += 1 } else { nr += 1 }
    }
  }
  if nf > 0 and nr > 0 {
    if m.drivetrain == CAR_AWD {
      share_f = m.front_share
      share_r = 1.0 - m.front_share
    } else if m.drivetrain == CAR_FWD { share_f = 1.0 } else { share_r = 1.0 }
  } else if nf > 0 { share_f = 1.0 } else if nr > 0 { share_r = 1.0 }
  let w_drv = drv_front * share_f + drv_rear * share_r
  var rpm_w = Math.abs(w_drv) * 9.5492966 * ratio
  c.rpm_w = rpm_w
  # the auto gearbox changes on the ground's speed, not the wheels': a spinning wheel is not a reason to change up
  let rpm_g = Math.abs(c.speed) / Math.max(0.05, car_driven_radius(c.model)) * 9.5492966 * ratio
  if m.auto and c.engine_on and driven and c.gear > 0 and c.shift_t <= 0.0 and n > 0 {
    let up_rpm = m.redline * m.up_at * (0.72 + 0.28 * Math.min(1.0, throttle * 1.6))
    if c.gear < n and rpm_g > up_rpm and dem > 0.05 {
      cr_shift_to(cars_st, c, c.gear + 1)
    } else if c.gear > 1 {
      let lower = car_ratio(c.model, s, c.gear - 1)
      let rpm_low = rpm_g * lower / Math.max(ratio, 0.001)
      if rpm_low < m.redline * m.down_at { cr_shift_to(cars_st, c, c.gear - 1) }
    }
  }
  if c.shift_t > 0.0 {
    c.shift_t = c.shift_t - dt
    if c.shift_t <= 0.0 {
      c.shift_t = 0.0
      let f = cr_fact(cars_st, CAR_SHIFT, c)
      f.v = float(c.gear)
      f.w = float(c.shift_to)
      c.gear = c.shift_to
    }
  }
  # the engine speed the torque is read at: the wheels', with the clutch slipping up to the launch speed
  var rpm_t = Math.max(rpm_w, m.idle)
  if dem > 0.05 and c.gear != 0 and rpm_t < m.launch_rpm { rpm_t = Math.min(m.launch_rpm, Math.max(rpm_t, m.launch_rpm * Math.min(1.0, dem * 2.0))) }
  # the turbo spools on the throttle and lets go without it
  if s.boost > 0.0 {
    if dem > 0.5 { c.spool = Math.min(1.0, c.spool + dt / Math.max(0.05, s.spool)) } else { c.spool = Math.max(0.0, c.spool - dt * 2.0 / Math.max(0.05, s.spool)) }
  } else { c.spool = 0.0 }
  # nitrous burns while asked for, and fills again when not
  var nitro = 0.0
  if m.nitro_time > 0.0 {
    let want = c.in_nitro and c.engine_on and dem > 0.3 and c.nitro_left > 0.0 and c.gear != 0
    if want {
      nitro = 1.0
      c.nitro_left = Math.max(0.0, c.nitro_left - dt)
      if not c.nitro_on {
        c.nitro_on = true
        let f = cr_fact(cars_st, CAR_NITRO, c)
        f.v = 1.0
      }
    } else {
      if c.nitro_on {
        c.nitro_on = false
        let f = cr_fact(cars_st, CAR_NITRO, c)
        f.v = 0.0
      }
      if m.nitro_recharge > 0.0 { c.nitro_left = Math.min(m.nitro_time, c.nitro_left + dt * m.nitro_time / m.nitro_recharge) }
    }
  }
  # the torque the engine gives, the limiter, the speed limit and the fuel
  var t_eng = car_engine_torque(c.model, s, rpm_t, c.spool, nitro) * dem
  if rpm_w >= m.limiter {
    t_eng = 0.0
  } else if rpm_w > m.redline {
    t_eng = t_eng * (m.limiter - rpm_w) / Math.max(1.0, m.limiter - m.redline)
  }
  if s.top_speed > 0.0 {
    let over = (s.top_speed - Math.abs(c.speed)) / 2.0
    t_eng = t_eng * Math.clamp(over, 0.0, 1.0)
  }
  if m.tank > 0.0 {
    if c.fuel <= 0.0 {
      t_eng = 0.0
      if not c.fuel_out {
        c.fuel_out = true
        cr_fact(cars_st, CAR_STALLED, c)
      }
    } else {
      c.fuel = Math.max(0.0, c.fuel - m.burn * dt * (0.1 + 0.9 * dem))
    }
  }
  # off the pedal the engine drags the wheels (only while they turn the gear's way)
  let dir = cr_sign(float(c.gear))
  if dem < 0.05 and c.gear != 0 and c.engine_on {
    let turning = w_drv * dir
    if turning > 0.0 { t_eng = -m.engine_brake * Math.clamp(rpm_w / m.redline, 0.0, 1.0) * Math.min(1.0, turning / 2.0) }
  }
  if c.shift_t > 0.0 or c.gear == 0 { t_eng = 0.0 }
  # a hurt engine gives less, a dead one nothing
  if t_eng > 0.0 { t_eng = t_eng * cr_engine_share(cars_st, c, dt) }
  c.throttle = dem
  # the engine turns with the wheels while the clutch is in: its inertia, through the gear, is theirs
  c.iref_front = 0.0
  c.iref_rear = 0.0
  if c.gear != 0 and c.shift_t <= 0.0 and c.engine_on {
    let ie = m.engine_inertia * ratio * ratio
    if nf > 0 { c.iref_front = ie * share_f / float(nf) }
    if nr > 0 { c.iref_rear = ie * share_r / float(nr) }
  }
  let t_wheels = t_eng * ratio * m.efficiency * dir
  c.tq_front = 0.0
  c.tq_rear = 0.0
  if nf > 0 { c.tq_front = t_wheels * share_f / float(nf) }
  if nr > 0 { c.tq_rear = t_wheels * share_r / float(nr) }
  # the engine's own speed for the gauge and the ear
  var target = 0.0
  if c.engine_on { target = Math.max(m.idle, Math.max(rpm_w, rpm_t * Math.min(1.0, dem * 4.0))) }
  c.rpm = c.rpm + (target - c.rpm) * Math.min(1.0, dt * 14.0)
  # the brakes: the pedal shared between the ends, the handbrake on the wheels that hold
  let total = m.brakes * s.brakes * stop
  c.braking = stop
  c.brake_front = 0.0
  c.brake_rear = 0.0
  if nfall > 0 and nrall > 0 {
    c.brake_front = total * m.brake_front / float(nfall)
    c.brake_rear = total * (1.0 - m.brake_front) / float(nrall)
  } else if nfall > 0 { c.brake_front = total / float(nfall) } else if nrall > 0 { c.brake_rear = total / float(nrall) }
  c.brake_hand = 0.0
  if nh > 0 { c.brake_hand = m.handbrake * hand / float(nh) }
}
