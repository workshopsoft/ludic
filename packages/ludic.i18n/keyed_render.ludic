# keyed_render.ludic - a marked string made into text where it is drawn (keyed_make.ludic): kept by L,
# or handed to a caller that keeps it only while it shows it (i18n_made)

# what L does with a key: made once per distinct marked string in this language, then kept
function keyed(i18n_st: mut I18nState, s: string) -> string {
  if i18n_st.kc == null { kc_clear(i18n_st) }
  let ci = Dict.get_or(i18n_st.kc, s, -1)
  if ci >= 0 { return i18n_st.kc_out[ci] }
  let r = km_text(i18n_st, s)
  if Dict.size(i18n_st.kc) >= CACHE_MAX { kc_clear(i18n_st) }
  @alloc_ok("a key made into text: the result kept, up to CACHE_MAX")
  Dict.set(i18n_st.kc, s, len(i18n_st.kc_out))
  @alloc_ok("a key made into text: as above")
  push(i18n_st.kc_out, r)
  return r
}

# a language's change makes every kept text stale
@alloc_ok("on a language change: the made keys let go")
function kc_clear(i18n_st: mut I18nState) -> void {
  i18n_st.kc = Dict.new()
  i18n_st.kc_out = new []string
}

# s made into text as a new string the caller keeps or lets go (free), nothing kept here: L keeps one
# per distinct line, which a count or a distance drawn as it changes grows without end
@alloc_ok("a line made for a caller that lets it go when it stops showing it")
export function i18n_made(i18n_st: mut I18nState, s: string) -> string {
  if i18n_is_key(s) and not kx_mixed(s) { return km_text(i18n_st, s) }
  return keep(L(i18n_st, s))
}
