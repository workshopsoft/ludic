# sidewalk.ludic - game-editor packages/core/src/world/sidewalk.ts: the back of the sidewalk, as the road bake reads it. The
# Sidewalk's methods (stations, junction, lvlAt, rampAt, bulb) over a "world" (`Sw`: the edges with their laid lines, setbacks,
# crossings and strips, the nodes), and the drawing helpers (deadCap, discVertices, bulbRails, bulbArc, railPoints, densifyLine,
# thinRing). The same doubles as the TypeScript.
#
# What sidewalk.ts calls in the parts other ports own goes through the `dep_` functions at the end of the file: edgeStations
# (junctionSurface), cornerLevel, cornerOffsets, cornerRadius (junction), armOf, fitCorner, outsideCorner, cornerRails
# (corners). For now they answer what the studio answered (`SwDeps`: the record's answers in the order they were asked); when
# those ports land each becomes the native call. Not ported: sidewalkOf's own assembly (gradeNetwork, setbacks, planCrossings:
# the Sw is filled from them by the program), walkFaces and sidewalkRing (blocks.ts only, not the road bake).

let SW_PI: double = 3.141592653589793
let SW_TAU: double = 6.283185307179586
let EPS6: double = 0.000001
let EPS9: double = 0.000000001
let EPS12: double = 0.000000000001

# ---- the world ------------------------------------------------------------------------------------------------------------

# a station of an edge's strip (junctionSurface's Station): p, n (unit right), k (lateral stretch at a bend), s, y
export property SwSt {
  px: double = 0.0
  pz: double = 0.0
  nx: double = 0.0
  nz: double = 0.0
  k: double = 1.0
  s: double = 0.0
  y: double = 0.0
}
# an edge's strip (junctionSurface's EdgeStations; `scale` is its grade's)
export property Strip {
  scale: double = 1.0
  st: []SwSt = null
  right: []Offsets = null
  left: []Offsets = null
}
export property SwEdge {
  key: string = ""
  from: string = ""
  to: string = ""
  curbH: double = 0.0
  steps: double = 0.0
  hasLaid: bool = false   # a graded line (EdgeGrade) exists
  line: []double = null   # its fine line and heights (what stations reads of it)
  y: []double = null
  scale: double = 1.0
  y0: double = 0.0        # its first and last heights
  y1: double = 0.0
  hasSb: bool = false     # its junction setbacks
  sbFrom: double = 0.0
  sbTo: double = 0.0
  cs: []double = null     # its crossings' distances (crossingsOn)
  es: Strip = null        # its strip, once made (stations)
  esDone: bool = false
  raw: Strip = null       # edgeStations' answer (dep_edge_stations)
}
export property SwNode {
  key: string = ""
  x: double = 0.0
  z: double = 0.0
  edges: []string = null
}
export property Dims {
  width: double = 0.0
  flare: double = 0.0
  ramp: double = 0.0
  lip: double = 0.0
}
export property SwDeps {
  q: []Val = null         # the other parts' answers, in order ({fn, res})
  at: int = 0
  bad: string = ""        # the first call the answers did not expect
}
export property Sw {
  edges: []SwEdge = null
  nodes: []SwNode = null
  dims: Dims = null
  lift: double = 0.02
  hasRadius: bool = false # the bake asks for corner radii (JunctionOptions.radius)
  deps: SwDeps = null
}

export function sw_edge(sw: Sw, key: string) -> SwEdge {
  for i in 0 .. len(sw.edges) { if sw.edges[i].key == key { return sw.edges[i] } }
  return null
}
export function sw_node(sw: Sw, key: string) -> SwNode {
  for i in 0 .. len(sw.nodes) { if sw.nodes[i].key == key { return sw.nodes[i] } }
  return null
}
function sb_from(e: SwEdge) -> double { return dsel(e != null and e.hasSb, e.sbFrom, 0.0) }
function sb_to(e: SwEdge) -> double { return dsel(e != null and e.hasSb, e.sbTo, 0.0) }
function laid(e: SwEdge) -> bool { return e != null and e.hasLaid }

# the point d metres right of the centre line at station i (EdgeStations.at)
export function strip_at(es: Strip, i: int, d: double) -> []double {
  let q = es.st[i]
  return d_pair(q.px + q.nx * d * q.k, q.pz + q.nz * d * q.k)
}
function st_copy(q: SwSt) -> SwSt {
  let o = new SwSt
  o.px = q.px
  o.pz = q.pz
  o.nx = q.nx
  o.nz = q.nz
  o.k = q.k
  o.s = q.s
  o.y = q.y
  return o
}
export function strip_copy(es: Strip) -> Strip {
  if es == null { return null }
  let o = new Strip
  o.scale = es.scale
  o.st = new []SwSt
  for i in 0 .. len(es.st) { push(o.st, st_copy(es.st[i])) }
  o.right = es.right
  o.left = es.left
  return o
}
function side_off(es: Strip, i: int, side: int) -> Offsets {
  if side == 1 { return es.right[i] }
  return es.left[i]
}
# a cross-section line by level: 0 gutter, 1 curb, 2 plant, else walk
function lv(o: Offsets, k: int) -> double {
  if k == 0 { return o.gutter }
  if k == 1 { return o.curb }
  if k == 2 { return o.plant }
  return o.walk
}

# ---- the strips: stations, mitred ends, dropped kerbs ---------------------------------------------------------------------

# an edge's strip (Sidewalk.stations): null when it is too short to draw
export function sw_stations(sw: Sw, key: string) -> Strip {
  let e = sw_edge(sw, key)
  if e == null { return null }
  if e.esDone { return e.es }
  var out: Strip = null
  if e.hasLaid {
    let cuts = new []double
    let w = sw.dims.width
    let f = sw.dims.flare
    let ds = doubles(4)
    ds[0] = -w / 2.0 - f
    ds[1] = -w / 2.0
    ds[2] = w / 2.0
    ds[3] = w / 2.0 + f
    for c in 0 .. len(e.cs) { for k in 0 .. 4 { push(cuts, (e.cs[c] + ds[k]) * e.scale) } }
    out = dep_edge_stations(sw, e, cuts)
    if out != null { mitre_ends(sw, key, out) }
    # a flight of stairs ends level with the nodes it meets
    if out != null and e.steps > 0.0 {
      let last = len(out.st) - 1
      out.st[0].y = e.y0
      out.st[last].y = e.y1
    }
  }
  e.es = out
  e.esDone = true
  return out
}

# the unit heading from a line's end (start or end) to its first point more than 1e-6 m away (null: none)
function away(line: []double, atStart: bool) -> []double {
  let n = len(line) / 2
  for k in 1 .. n {
    let ai = isel(atStart, 0, n - 1)
    let ci = isel(atStart, k, n - 1 - k)
    let ax = line[ai * 2]
    let az = line[ai * 2 + 1]
    let cx = line[ci * 2]
    let cz = line[ci * 2 + 1]
    let d = hypot2(cx - ax, cz - az)
    if d > EPS6 { return d_pair((cx - ax) / d, (cz - az) / d) }
  }
  return null
}

# a node of two roads with no junction surface between them: each strip's end there cut along the bisector of the two
function mitre_ends(sw: Sw, key: string, es: Strip) -> void {
  let e = sw_edge(sw, key)
  if e == null or not e.hasLaid or len(es.st) < 2 { return }
  for pass in 0 .. 2 {
    let atStart = pass == 0
    let node = dsel_s(atStart, e.from, e.to)
    if dsel(atStart, sb_from(e), sb_to(e)) > EPS6 or e.from == e.to { continue }
    let nd = sw_node(sw, node)
    if nd == null or len(nd.edges) != 2 { continue }
    var ok = nd.edges[0]
    if nd.edges[0] == key { ok = nd.edges[1] }
    let o = sw_edge(sw, ok)
    if o == null or not o.hasLaid or ok == key { continue }
    let oStart = o.from == node
    if dsel(oStart, sb_from(o), sb_to(o)) > EPS6 { continue }
    let ue = away(e.line, atStart)
    let uo = away(o.line, oStart)
    if ue == null or uo == null { continue }
    let tx = ue[0] - uo[0]
    let tz = ue[1] - uo[1]
    let tl = hypot2(tx, tz)
    if tl < EPS9 { continue }
    let i = isel(atStart, 0, len(es.st) - 1)
    let q = es.st[i]
    var nx = -tz / tl
    var nz = tx / tl
    if nx * q.nx + nz * q.nz < 0.0 {
      nx = -nx
      nz = -nz
    }
    let c = nx * q.nx + nz * q.nz
    if c < 0.98 { continue }
    let r = st_copy(q)
    r.nx = nx
    r.nz = nz
    r.k = q.k / c
    es.st[i] = r
  }
}
export function dsel_s(c: bool, a: string, b: string) -> string {
  if c { return a }
  return b
}

# how far a crossing lowers the kerb at fine distance s along an edge: 1 in its strip, 0 beyond its flares
function drop_along(sw: Sw, e: SwEdge, s: double) -> double {
  var a: double = 0.0
  let sc = dsel(laid(e), e.scale, 1.0)
  for c in 0 .. len(e.cs) {
    let d = dabs(s / sc - e.cs[c])
    let hw = sw.dims.width / 2.0
    if d <= hw + EPS6 { return 1.0 }
    if d < hw + sw.dims.flare { a = jmax(a, 1.0 - (d - hw) / sw.dims.flare) }
  }
  return a
}
function falsy(x: double) -> bool { return x == 0.0 or x != x }

# the lateral offset a side's dropped kerb ramp ends at, at station i (Sidewalk.rampAt): null when it has none
export function sw_ramp_at(sw: Sw, key: string, i: int, side: int) -> []double {
  let es = sw_stations(sw, key)
  let e = sw_edge(sw, key)
  if es == null or falsy(drop_along(sw, e, es.st[i].s)) { return null }
  let o = side_off(es, i, side)
  let walk = o.walk - o.gutter
  let run = jmax(jmin(sw.dims.ramp, walk - 0.3), jmin(0.6, walk))
  let out = doubles(1)
  out[0] = o.gutter + run
  return out
}

# the height of the kerb's top, planting and walk above the road at station i, d metres out on `side` (Sidewalk.lvlAt)
export function sw_lvl_at(sw: Sw, key: string, i: int, side: int, d: double) -> double {
  let es = sw_stations(sw, key)
  let e = sw_edge(sw, key)
  var curbH: double = 0.0
  if e != null and e.curbH > 0.001 { curbH = e.curbH }
  if es == null or falsy(curbH) { return curbH }
  let a = drop_along(sw, e, es.st[i].s)
  if falsy(a) { return curbH }
  let o = side_off(es, i, side)
  let end = sw_ramp_at(sw, key, i, side)[0]
  let run = jmax(end - o.gutter, EPS6)
  let across = jmax(0.0, jmin(1.0, 1.0 - (d - o.gutter) / run))
  return curbH - a * across * (curbH - jmin(sw.dims.lip, curbH))
}

# ---- junctions ------------------------------------------------------------------------------------------------------------

export property SwJEnd {
  key: string = ""
  out: bool = false
  ux: double = 0.0
  uz: double = 0.0
  nx: double = 0.0
  nz: double = 0.0
  setback: double = 0.0
  r: Offsets = null
  l: Offsets = null
  curbH: double = 0.0
}
export property SwCorner {
  i: int = 0
  j: int = 0
  kind: string = ""
  rails: [][]double = null
  hasCentre: bool = false
  cx: double = 0.0
  cz: double = 0.0
  radius: double = 0.0
  kerb: []double = null
  crushed: [][]double = null   # null, or [the rails' first points, their last points]
  sharp: bool = false
}
export property Junc {
  kind: string = ""
  strict: bool = false
  radius: double = 0.0
  notes: []string = null
  ends: []SwJEnd = null
  corners: []SwCorner = null
}
# a corner's plan (corners.ts CornerPlan: what the sidewalk reads of it)
export property SwPlan {
  kind: string = ""
  rho: double = 0.0
  hasCentre: bool = false
  cx: double = 0.0
  cz: double = 0.0
  mids: [][]double = null      # each level's round points
}
property ELine {
  px: double = 0.0
  pz: double = 0.0
  ux: double = 0.0
  uz: double = 0.0
}

# a rail's end point on a strip's own end (the strip's station, at the corner's level)
function end_pt(sw: Sw, e: SwJEnd, right: bool, level: int, other: Offsets) -> []double {
  let es = sw_stations(sw, e.key)
  if es == null or len(es.st) < 2 { return null }
  let i = isel(e.out, 0, len(es.st) - 1)
  let edgeSide = isel(right == e.out, 1, -1)
  let o = side_off(es, i, edgeSide)
  return strip_at(es, i, double(edgeSide) * dep_corner_level(sw, o, other, level))
}
# the strip's own end line at a node and the way into the strip from it
function end_line(sw: Sw, e: SwJEnd) -> ELine {
  let es = sw_stations(sw, e.key)
  if es == null or len(es.st) < 2 { return null }
  let i = isel(e.out, 0, len(es.st) - 1)
  let q = es.st[i]
  let nb = es.st[isel(e.out, 1, len(es.st) - 2)]
  let l = new ELine
  l.px = q.px
  l.pz = q.pz
  l.ux = q.nz
  l.uz = -q.nx
  if (nb.px - q.px) * l.ux + (nb.pz - q.pz) * l.uz >= 0.0 { return l }
  l.ux = -l.ux
  l.uz = -l.uz
  return l
}
function beyond(line: ELine, x: double, z: double) -> bool { return line != null and (x - line.px) * line.ux + (z - line.pz) * line.uz > 0.001 }
# the strip's other edge at a level, on its end line
function far_pt(sw: Sw, e: SwJEnd, right: bool, level: int) -> []double {
  let es = sw_stations(sw, e.key)
  if es == null or len(es.st) < 2 { return null }
  let i = isel(e.out, 0, len(es.st) - 1)
  let edgeSide = isel(right == e.out, 1, -1)
  let o = side_off(es, i, edgeSide)
  return strip_at(es, i, double(edgeSide) * lv(o, level))
}
# is a point on the end line beside the strip (not between the rail's end point and the strip's other edge)?
function beside(ex: double, ez: double, far: []double, px: double, pz: double) -> bool {
  if far == null { return true }
  let fx = far[0] - ex
  let fz = far[1] - ez
  let fl = hypot2(fx, fz)
  var w: double = 0.0
  if not (fl < EPS6) { w = ((px - ex) * fx + (pz - ez) * fz) / fl }
  return not (w > EPS6 and w < fl - EPS6)
}
# where the segment p-q crosses a strip's end line
function crossing_pt(line: ELine, px: double, pz: double, qx: double, qz: double) -> []double {
  let dp = (px - line.px) * line.ux + (pz - line.pz) * line.uz
  let dq = (qx - line.px) * line.ux + (qz - line.pz) * line.uz
  var t: double = 0.0
  if not (dabs(dq - dp) < EPS12) { t = dp / (dp - dq) }
  return d_pair(px + (qx - px) * t, pz + (qz - pz) * t)
}
# a rail clipped at a strip's end line (sidewalk.ts clipTail)
function clip_tail(r: []double, line: ELine, far: []double) -> []double {
  let n = len(r) / 2
  var m = -1
  for i in 1 .. n - 1 {
    if beyond(line, r[i * 2], r[i * 2 + 1]) {
      m = i
      break
    }
  }
  if m < 0 { return r }
  let ex = r[(n - 1) * 2]
  let ez = r[(n - 1) * 2 + 1]
  let keep = pts_slice(r, 0, m)
  if beyond(line, r[(m - 1) * 2], r[(m - 1) * 2 + 1]) {
    pts_push(keep, ex, ez)
    return keep
  }
  let x = crossing_pt(line, r[(m - 1) * 2], r[(m - 1) * 2 + 1], r[m * 2], r[m * 2 + 1])
  let kn = len(keep) / 2
  if beside(ex, ez, far, x[0], x[1]) and hypot2(x[0] - keep[(kn - 1) * 2], x[1] - keep[(kn - 1) * 2 + 1]) > 0.001 and hypot2(x[0] - ex, x[1] - ez) > 0.001 { pts_push(keep, x[0], x[1]) }
  pts_push(keep, ex, ez)
  return keep
}
# can a strict corner be drawn along this end's arm: its laid line and strip (armOfEnd); `lim` its setback
function arm_lim(sw: Sw, e: SwJEnd) -> []double {
  let ed = sw_edge(sw, e.key)
  let es = sw_stations(sw, e.key)
  if not laid(ed) or es == null or len(es.st) < 2 { return null }
  dep_arm_of(sw, e)
  let out = doubles(1)
  out[0] = jmax(0.0, dsel(e.out, sb_from(ed), sb_to(ed)))
  return out
}
function chord_plan(n: int) -> SwPlan {
  let p = new SwPlan
  p.kind = "flat"
  p.rho = 0.0
  p.mids = new [][]double
  for k in 0 .. n { push(p.mids, new []double) }
  return p
}
function max_rel(v: []double) -> double {
  var m = -INF
  for k in 0 .. len(v) { m = jmax(m, v[k] - v[0]) }
  return m
}
# is q past the line p0-p1 from the node (crushed corners)?
function past(p0x: double, p0z: double, p1x: double, p1z: double, qx: double, qz: double, nx: double, nz: double) -> bool {
  let ux = p1x - p0x
  let uz = p1z - p0z
  let sq = ux * (qz - p0z) - uz * (qx - p0x)
  let sn = ux * (nz - p0z) - uz * (nx - p0x)
  return hypot2(ux, uz) > EPS6 and sq * sn < -EPS9
}

# a node's junction, its corners' rails ending exactly on the strips' end points (Sidewalk.junction, after junctionOf): `j`
# is junctionOf's answer, changed in place
export function sw_junction(sw: Sw, n: SwNode, j: Junc) -> Junc {
  let rebuilt = new []bool
  for ci in 0 .. len(j.corners) { push(rebuilt, false) }
  if j.strict and j.kind == "cross" {
    for ci in 0 .. len(j.corners) {
      let c = j.corners[ci]
      if c.sharp { continue }
      let a = j.ends[c.i]
      let b = j.ends[c.j]
      let A = arm_lim(sw, a)
      let B = arm_lim(sw, b)
      if A == null or B == null { continue }
      var gap = jatan2(a.ux * b.uz - a.uz * b.ux, a.ux * b.ux + a.uz * b.uz)
      if gap <= EPS6 { gap += 2.0 * SW_PI }
      let ob2 = dep_corner_offsets(sw)
      let oa = ob2[0]
      let ob = ob2[1]
      var plan: SwPlan = null
      var crushed = false
      let gore: double = 25.0
      let wide: double = 175.0
      if gap < (gore * SW_PI) / 180.0 {
        plan = chord_plan(len(oa))
      } else if gap <= (wide * SW_PI) / 180.0 {
        let rw = dep_corner_radius(sw)
        let fit = dep_plan(sw, "fitCorner")
        crushed = fit == null
        if fit != null { for k in 1 .. len(fit.mids) { if len(fit.mids[k]) == 0 { crushed = true } } }
        plan = fit
        if plan == null { plan = chord_plan(len(oa)) }
        if len(rw) > 1 and plan.rho < rw[1] - 0.001 and sw.hasRadius and a.curbH > 0.001 and b.curbH > 0.001 { push(j.notes, `node {n.key}: the corner between {a.key} and {b.key} cannot be {js_num(rw[1])} m round: {to_fixed2(plan.rho)} m fits between its strips`) }
      } else {
        plan = dep_plan(sw, "outsideCorner")
      }
      let rails = dep_corner_rails(sw)
      for k in 0 .. len(rails) {
        let p = end_pt(sw, a, true, k, b.l)
        let q = end_pt(sw, b, false, k, a.r)
        if p != null {
          rails[k][0] = p[0]
          rails[k][1] = p[1]
        }
        if q != null {
          let rn = len(rails[k]) / 2
          rails[k][(rn - 1) * 2] = q[0]
          rails[k][(rn - 1) * 2 + 1] = q[1]
        }
      }
      if crushed and jmax(max_rel(oa), max_rel(ob)) > EPS6 {
        let ia = new []double
        let ib = new []double
        for k in 0 .. len(rails) {
          let rn = len(rails[k]) / 2
          pts_push(ia, rails[k][0], rails[k][1])
          pts_push(ib, rails[k][(rn - 1) * 2], rails[k][(rn - 1) * 2 + 1])
        }
        c.crushed = new [][]double
        push(c.crushed, ia)
        push(c.crushed, ib)
        let la = len(ia) / 2 - 1
        let lb = len(ib) / 2 - 1
        let edge = new []double
        pts_push(edge, ia[0], ia[1])
        if past(ia[0], ia[1], ia[la * 2], ia[la * 2 + 1], ib[0], ib[1], n.x, n.z) { pts_push(edge, ia[la * 2], ia[la * 2 + 1]) }
        if past(ib[0], ib[1], ib[lb * 2], ib[lb * 2 + 1], ia[0], ia[1], n.x, n.z) { pts_push(edge, ib[lb * 2], ib[lb * 2 + 1]) }
        pts_push(edge, ib[0], ib[1])
        rails[0] = edge
        for k in 1 .. len(rails) { rails[k] = pts_copy(rails[0]) }
      }
      c.rails = rails
      c.kind = plan.kind
      c.radius = plan.rho
      c.hasCentre = plan.hasCentre
      c.cx = plan.cx
      c.cz = plan.cz
      if plan.kind == "fillet" and len(plan.mids[0]) / 2 > 2 { c.kerb = pts_copy(plan.mids[0]) }
      rebuilt[ci] = true
    }
  }
  for ci in 0 .. len(j.corners) {
    let c = j.corners[ci]
    let ei = j.ends[c.i]
    let ej = j.ends[c.j]
    let lineI = end_line(sw, ei)
    let lineJ = end_line(sw, ej)
    for k in 0 .. len(c.rails) {
      var r = c.rails[k]
      let a = end_pt(sw, ei, true, k, ej.l)
      let b = end_pt(sw, ej, false, k, ei.r)
      let rn = len(r) / 2
      if a != null and rn > 0 {
        r[0] = a[0]
        r[1] = a[1]
      }
      if b != null and rn > 1 {
        r[(rn - 1) * 2] = b[0]
        r[(rn - 1) * 2 + 1] = b[1]
      }
      if not rebuilt[ci] and rn > 2 {
        var any = false
        for m in 1 .. rn - 1 { if beyond(lineI, r[m * 2], r[m * 2 + 1]) or beyond(lineJ, r[m * 2], r[m * 2 + 1]) { any = true } }
        if any {
          if lineI != null { r = pts_reversed(clip_tail(pts_reversed(r), lineI, far_pt(sw, ei, false, k))) }
          if lineJ != null { r = clip_tail(r, lineJ, far_pt(sw, ej, true, k)) }
          c.rails[k] = r
        }
      }
      if len(r) / 2 > 2 {
        r = rail_points(r, 0.02)
        c.rails[k] = r
      }
      if j.strict {
        if k == 0 and not rebuilt[ci] { c.kerb = pts_copy(r) }
        c.rails[k] = densify_line(r, 2.0)
      }
    }
  }
  return j
}

# a strict turning circle's four rails (Sidewalk.bulb): null for any other node; `j` the node's junction
export function sw_bulb(sw: Sw, n: SwNode, j: Junc) -> [][]double {
  if not (j.kind == "bulb" and j.strict) { return null }
  let e0 = j.ends[0]
  let es = sw_stations(sw, e0.key)
  if es == null or len(es.st) < 2 { return null }
  let i = isel(e0.out, 0, len(es.st) - 1)
  var rO = es.left[i]
  var lO = es.right[i]
  if e0.out {
    rO = es.right[i]
    lO = es.left[i]
  }
  let sR = dsel(e0.out, 1.0, -1.0)
  let ends = new [][]double
  let g = doubles(4)
  for k in 0 .. 4 {
    let p = strip_at(es, i, sR * lv(rO, k))
    let q = strip_at(es, i, -sR * lv(lO, k))
    let pq = doubles(4)
    pq[0] = p[0]
    pq[1] = p[1]
    pq[2] = q[0]
    pq[3] = q[1]
    push(ends, pq)
    g[k] = (lv(rO, k) - rO.gutter + lv(lO, k) - lO.gutter) / 2.0
  }
  return bulb_rails(n.x, n.z, e0.ux, e0.uz, j.radius, ends, g)
}

# ---- the drawing helpers ---------------------------------------------------------------------------------------------------

# a rail with its ends kept and no point within `tol` of the one kept before it (nor of the end)
export function rail_points(r: []double, tol: double) -> []double {
  let n = len(r) / 2
  let out = new []double
  pts_push(out, r[0], r[1])
  let ex = r[(n - 1) * 2]
  let ez = r[(n - 1) * 2 + 1]
  for i in 1 .. n - 1 {
    let px = r[i * 2]
    let pz = r[i * 2 + 1]
    let m = len(out) / 2 - 1
    if hypot2(px - out[m * 2], pz - out[m * 2 + 1]) < tol or hypot2(px - ex, pz - ez) < tol { continue }
    pts_push(out, px, pz)
  }
  pts_push(out, ex, ez)
  return out
}

# a polyline with points added so no stretch of it is longer than `max` (its own points kept)
export function densify_line(line: []double, max: double) -> []double {
  let out = new []double
  let n = len(line) / 2
  for i in 0 .. n - 1 {
    let ax = line[i * 2]
    let az = line[i * 2 + 1]
    let cx = line[i * 2 + 2]
    let cz = line[i * 2 + 3]
    let m = int(jmax(1.0, Math.ceil(hypot2(cx - ax, cz - az) / max)))
    let md = double(m)
    for k in 0 .. m {
      if k == 0 { pts_push(out, ax, az) } else { pts_push(out, ax + ((cx - ax) * double(k)) / md, az + ((cz - az) * double(k)) / md) }
    }
  }
  if n > 0 { pts_push(out, line[(n - 1) * 2], line[(n - 1) * 2 + 1]) }
  return out
}

# a dead end's rounded cap (deadCap): `e` the end's n and u, `ends` the strip's own end points (rx, rz, lx, lz) or null
export function dead_cap(nx0: double, nz0: double, enx: double, enz: double, eux: double, euz: double, r: double, l: double, ends: []double) -> []double {
  var rpx = nx0 + enx * r
  var rpz = nz0 + enz * r
  var lpx = nx0 - enx * l
  var lpz = nz0 - enz * l
  if ends != null {
    rpx = ends[0]
    rpz = ends[1]
    lpx = ends[2]
    lpz = ends[3]
  }
  let mx = (rpx + lpx) / 2.0
  let mz = (rpz + lpz) / 2.0
  var rad = (r + l) / 2.0
  if ends != null { rad = hypot2(lpx - rpx, lpz - rpz) / 2.0 }
  let a0 = jatan2(rpz - mz, rpx - mx)
  let back = jatan2(-euz, -eux)
  var d = back - a0
  while d > SW_PI { d -= 2.0 * SW_PI }
  while d < -SW_PI { d += 2.0 * SW_PI }
  let sgn = dsel(d >= 0.0, 1.0, -1.0)
  let pts = new []double
  let nseg: double = 12.0
  for k in 0 .. 13 {
    if k == 0 {
      pts_push(pts, rpx, rpz)
    } else if k == 12 {
      pts_push(pts, lpx, lpz)
    } else {
      let a = a0 + sgn * SW_PI * (double(k) / nseg)
      pts_push(pts, mx + jcos(a) * rad, mz + jsin(a) * rad)
    }
  }
  return pts
}

# a plaza's disc, or a turning circle's: the vertices the bake draws
export function disc_vertices(nx0: double, nz0: double, radius: double) -> []double {
  let nseg = int(jmax(24.0, Math.ceil(radius * 4.0)))
  let nd = double(nseg)
  let out = new []double
  for k in 0 .. nseg {
    let a = (double(k) / nd) * SW_PI * 2.0
    pts_push(out, nx0 + jcos(a) * radius, nz0 + jsin(a) * radius)
  }
  return out
}

# JavaScript's a % b on doubles (C's fmod: exact)
export function jfmod(a: double, b: double) -> double {
  if a != a or b != b or b == 0.0 or a - a != 0.0 { return NAN }
  if b - b != 0.0 { return a }
  let bb = dabs(b)
  var x = dabs(a)
  while x >= bb {
    # the largest bb * 2^k not over x: x less it is exact (Sterbenz)
    var m = bb
    while m * 2.0 <= x { m = m * 2.0 }
    x = x - m
  }
  if neg_bit(a) { return -x }
  return x
}

function smooth(x: double) -> double { return x * x * (3.0 - 2.0 * x) }
function norm_from(a: double, mouth: double) -> double { return jfmod(jfmod(a - mouth, 2.0 * SW_PI) + 2.0 * SW_PI, 2.0 * SW_PI) }
function signed_from(a: double, mouth: double) -> double {
  let t = norm_from(a, mouth)
  if t > SW_PI { return t - 2.0 * SW_PI }
  return t
}

# the rails of a strict turning circle (bulbRails): `ends` per level (rx, rz, lx, lz), `gutter` per level
export function bulb_rails(nx0: double, nz0: double, ux: double, uz: double, radius: double, ends: [][]double, gutter: []double) -> [][]double {
  let mouth = jatan2(uz, ux)
  let out = new [][]double
  for k in 0 .. len(ends) {
    let rx = ends[k][0]
    let rz = ends[k][1]
    let lx = ends[k][2]
    let lz = ends[k][3]
    let target = radius + jmax(0.0, gutter[k])
    let ar = jatan2(rz - nz0, rx - nx0)
    let al = jatan2(lz - nz0, lx - nx0)
    let rr = hypot2(rx - nx0, rz - nz0)
    let rl = hypot2(lx - nx0, lz - nz0)
    var a0 = ar
    var a1 = al
    var t0 = norm_from(a0, mouth)
    var t1 = norm_from(a1, mouth)
    if t0 > SW_PI {
      let u0 = 2.0 * SW_PI - t0
      let u1 = 2.0 * SW_PI - t1
      t0 = u0
      t1 = u1
      a0 = mouth - t0
      a1 = mouth - t1
    } else {
      a0 = mouth + t0
      a1 = mouth + t1
    }
    if not (t0 <= SW_PI and t1 >= SW_PI) {
      let sr = signed_from(ar, mouth)
      let sl = signed_from(al, mouth)
      var dir: double = 1.0
      if dabs(sr) > EPS6 { dir = jsign(sr) } else if dabs(sl) > EPS6 { dir = -jsign(sl) }
      var T1 = dir * sl
      if T1 <= EPS9 { T1 += 2.0 * SW_PI }
      t0 = jmax(0.0, dir * sr)
      t1 = T1
      a0 = mouth + dir * t0
      a1 = mouth + dir * t1
    }
    let steps: double = 32.0
    let ease = (40.0 * SW_PI) / 180.0
    let pts = new []double
    pts_push(pts, rx, rz)
    for s in 1 .. 32 {
      let a = a0 + ((a1 - a0) * double(s)) / steps
      let from0 = dabs(a - a0)
      let from1 = dabs(a1 - a)
      let w0 = jmin(1.0, from0 / ease)
      let w1 = jmin(1.0, from1 / ease)
      var rad = rl + (target - rl) * smooth(w1)
      if from0 < from1 { rad = rr + (target - rr) * smooth(w0) }
      pts_push(pts, nx0 + jcos(a) * rad, nz0 + jsin(a) * rad)
    }
    pts_push(pts, lx, lz)
    push(out, pts)
  }
  return out
}

# a turning circle's arc at radius r, round but for the road's mouth (bulbArc)
export function bulb_arc(nx0: double, nz0: double, mux: double, muz: double, radius: double, gutter: double, r: double) -> []double {
  let mouth = jatan2(muz, mux)
  let half = jasin(jmin(0.95, jmax(0.0, gutter) / radius))
  let a0 = mouth + half
  let a1 = mouth + 2.0 * SW_PI - half
  let out = new []double
  for k in 0 .. 25 {
    let a = a0 + ((a1 - a0) * double(k)) / 24.0
    pts_push(out, nx0 + jcos(a) * r, nz0 + jsin(a) * r)
  }
  return out
}

# a closed ring thinned to its turns (thinRing): the kept indices' points and heights, [pts, ys]
export function thin_ring(pts: []double, ys: []double, tol: double, tolY: double) -> [][]double {
  let n = len(pts) / 2
  let out = new [][]double
  if n < 4 {
    push(out, pts_copy(pts))
    push(out, pts_copy(ys))
    return out
  }
  let keep = new []bool
  for i in 0 .. n { push(keep, false) }
  var far = 0
  var fd: double = -1.0
  for i in 1 .. n {
    let d = hypot2(pts[i * 2] - pts[0], pts[i * 2 + 1] - pts[1])
    if d > fd {
      fd = d
      far = i
    }
  }
  keep[0] = true
  keep[far] = true
  # a stack of [i, j) spans (sp: its height, in ints)
  let stack = new []int
  var sp = 0
  sp = stack_put(stack, sp, 0, far)
  sp = stack_put(stack, sp, far, n)
  while sp > 0 {
    let i = stack[sp - 2]
    let j = stack[sp - 1]
    sp -= 2
    var best = -1
    var bd: double = 1.0
    for k in i + 1 .. j {
      let d = thin_dev(pts, ys, n, k, i, j, tol, tolY)
      if d > bd {
        bd = d
        best = k
      }
    }
    if best >= 0 {
      keep[best % n] = true
      sp = stack_put(stack, sp, i, best)
      sp = stack_put(stack, sp, best, j)
    }
  }
  let op = new []double
  let oy = new []double
  for i in 0 .. n {
    if keep[i] {
      pts_push(op, pts[i * 2], pts[i * 2 + 1])
      push(oy, ys[i])
    }
  }
  push(out, op)
  push(out, oy)
  return out
}
function stack_put(st: []int, sp: int, a: int, b: int) -> int {
  if sp < len(st) { st[sp] = a } else { push(st, a) }
  if sp + 1 < len(st) { st[sp + 1] = b } else { push(st, b) }
  return sp + 2
}
function thin_dev(pts: []double, ys: []double, n: int, k0: int, i: int, j0: int, tol: double, tolY: double) -> double {
  let j = j0 % n
  let k = k0 % n
  let ax = pts[i * 2]
  let az = pts[i * 2 + 1]
  let dx = pts[j * 2] - ax
  let dz = pts[j * 2 + 1] - az
  let l2 = dx * dx + dz * dz
  var t: double = 0.0
  if not (l2 < EPS12) { t = jmax(0.0, jmin(1.0, ((pts[k * 2] - ax) * dx + (pts[k * 2 + 1] - az) * dz) / l2)) }
  let dxy = hypot2(pts[k * 2] - (ax + dx * t), pts[k * 2 + 1] - (az + dz * t))
  let dy = dabs(ys[k] - (ys[i] + (ys[j] - ys[i]) * t))
  return jmax(dxy / tol, dy / tolY)
}

# ---- numbers as JavaScript writes them (the junction's notes) --------------------------------------------------------------

# String(x) for the numbers a note holds (an integer without ".0")
export function js_num(x: double) -> string {
  if x == Math.floor(x) and dabs(x) < 1000000000000000.0 { return `{long(x)}` }
  return `{x}`
}
# x.toFixed(2) (rounded as the decimal nearest x*100; a tie the binary value decides is rare and not modelled)
export function to_fixed2(x: double) -> string {
  let neg = x < 0.0
  let v = jround(dabs(x) * 100.0)
  let w = long(v)
  let ip = w / long(100)
  let fp = w - ip * long(100)
  var f = `{fp}`
  if fp < long(10) { f = `0{fp}` }
  if neg and w != long(0) { return `-{ip}.{f}` }
  return `{ip}.{f}`
}

# ---- the other parts' calls ------------------------------------------------------------------------------------------------

function dep_next(sw: Sw, fn: string) -> Val {
  let d = sw.deps
  if d == null or d.at >= len(d.q) {
    if d != null and d.bad == "" { d.bad = `{fn}: no answer left` }
    return null
  }
  let v = d.q[d.at]
  d.at += 1
  let f = v_gets(v, "fn", "")
  if f != fn {
    if d.bad == "" { d.bad = `asked {fn}, the studio asked {f} (answer {d.at - 1})` }
    return null
  }
  return v_get(v, "res")
}
# junctionSurface edgeStations(l, sb, cuts, thin): the strip of a graded edge between its setbacks
function dep_edge_stations(sw: Sw, e: SwEdge, cuts: []double) -> Strip { return strip_copy(e.raw) }
# junction cornerLevel(o, other, level)
function dep_corner_level(sw: Sw, o: Offsets, other: Offsets, level: int) -> double {
  let v = dep_next(sw, "cornerLevel")
  if v == null { return NAN }
  return v.num
}
# junction cornerOffsets(a, b): [a's, b's]
function dep_corner_offsets(sw: Sw) -> [][]double {
  let v = dep_next(sw, "cornerOffsets")
  let out = new [][]double
  if v == null {
    push(out, new []double)
    push(out, new []double)
    return out
  }
  push(out, v_nums(v_item(v, 0)))
  push(out, v_nums(v_item(v, 1)))
  return out
}
# junction cornerRadius(a, b, gap, opt): [rho] or [rho, want]
function dep_corner_radius(sw: Sw) -> []double {
  let v = dep_next(sw, "cornerRadius")
  let out = new []double
  if v == null {
    push(out, NAN)
    return out
  }
  push(out, v_getn(v, "rho", NAN))
  if v_has(v, "want") { push(out, v_getn(v, "want", NAN)) }
  return out
}
# corners armOf(line, s, out)
function dep_arm_of(sw: Sw, e: SwJEnd) -> void { dep_next(sw, "armOf") }
# corners fitCorner (null when none fits) or outsideCorner
function dep_plan(sw: Sw, fn: string) -> SwPlan {
  let v = dep_next(sw, fn)
  if v_undef(v) { return null }
  return plan_of_val(v)
}
# corners cornerRails(A, B, oa, ob, plan, limA, limB)
function dep_corner_rails(sw: Sw) -> [][]double {
  let v = dep_next(sw, "cornerRails")
  let out = new [][]double
  if v == null { return out }
  for k in 0 .. v_len(v) { push(out, v_pts(v_item(v, k))) }
  return out
}

# ---- reading the world and the junctions from tagged values (the fixtures' records; the job's) -------------------------------

# v_len, 0 for an absent field
function vlen0(v: Val) -> int {
  if v == null { return 0 }
  return v_len(v)
}
function vnums0(v: Val) -> []double {
  if v == null { return new []double }
  return v_nums(v)
}
function vbool0(v: Val) -> bool { return v != null and v_bool(v) }
export function offsets_of_val(v: Val) -> Offsets {
  let o = new Offsets
  o.median = v_getn(v, "median", 0.0)
  o.lanes = v_getn(v, "lanes", 0.0)
  o.road = v_getn(v, "road", 0.0)
  o.park = v_getn(v, "park", 0.0)
  o.gutter = v_getn(v, "gutter", 0.0)
  o.curb = v_getn(v, "curb", 0.0)
  o.plant = v_getn(v, "plant", 0.0)
  o.walk = v_getn(v, "walk", 0.0)
  return o
}
# a strip: {scale, st: [[px, pz, nx, nz, k, s, y]...], right, left} (null for undefined)
export function strip_of_val(v: Val) -> Strip {
  if v_undef(v) { return null }
  let es = new Strip
  es.scale = v_getn(v, "scale", 1.0)
  es.st = new []SwSt
  es.right = new []Offsets
  es.left = new []Offsets
  let st = v_get(v, "st")
  for i in 0 .. vlen0(st) {
    let a = vnums0(v_item(st, i))
    let q = new SwSt
    q.px = a[0]
    q.pz = a[1]
    q.nx = a[2]
    q.nz = a[3]
    q.k = a[4]
    q.s = a[5]
    q.y = a[6]
    push(es.st, q)
  }
  let r = v_get(v, "right")
  for i in 0 .. vlen0(r) { push(es.right, offsets_of_val(v_item(r, i))) }
  let l = v_get(v, "left")
  for i in 0 .. vlen0(l) { push(es.left, offsets_of_val(v_item(l, i))) }
  return es
}
export function node_of_val(v: Val) -> SwNode {
  let n = new SwNode
  n.key = v_gets(v, "key", "")
  n.x = v_getn(v, "x", 0.0)
  n.z = v_getn(v, "z", 0.0)
  n.edges = new []string
  let es = v_get(v, "edges")
  for i in 0 .. vlen0(es) { push(n.edges, v_item(es, i).str) }
  return n
}
# a world: {dims, lift, edges: [{key, from, to, curbH, steps, laid?: {line?, y?, scale, y0?, y1?}, sb?, cs, es?}], nodes}
export function sw_of_val(v: Val) -> Sw {
  let sw = new Sw
  sw.edges = new []SwEdge
  sw.nodes = new []SwNode
  let d = v_get(v, "dims")
  sw.dims = new Dims
  sw.dims.width = v_getn(d, "width", 0.0)
  sw.dims.flare = v_getn(d, "flare", 0.0)
  sw.dims.ramp = v_getn(d, "ramp", 0.0)
  sw.dims.lip = v_getn(d, "lip", 0.0)
  sw.lift = v_getn(v, "lift", 0.02)
  sw.deps = new SwDeps
  sw.deps.q = new []Val
  let es = v_get(v, "edges")
  for i in 0 .. vlen0(es) {
    let ev = v_item(es, i)
    let e = new SwEdge
    e.key = v_gets(ev, "key", "")
    e.from = v_gets(ev, "from", "")
    e.to = v_gets(ev, "to", "")
    e.curbH = v_getn(ev, "curbH", 0.0)
    e.steps = v_getn(ev, "steps", 0.0)
    let l = v_get(ev, "laid")
    if not v_undef(l) {
      e.hasLaid = true
      e.scale = v_getn(l, "scale", 1.0)
      if v_has(l, "line") {
        e.line = v_pts(v_get(l, "line"))
        e.y = vnums0(v_get(l, "y"))
        e.y0 = e.y[0]
        e.y1 = e.y[len(e.y) - 1]
      } else {
        e.y0 = v_getn(l, "y0", 0.0)
        e.y1 = v_getn(l, "y1", 0.0)
      }
    }
    let sb = v_get(ev, "sb")
    if not v_undef(sb) {
      e.hasSb = true
      e.sbFrom = v_getn(sb, "from", 0.0)
      e.sbTo = v_getn(sb, "to", 0.0)
    }
    e.cs = vnums0(v_get(ev, "cs"))
    let s = v_get(ev, "es")
    if s != null and s.tag != T_UNDEF {
      e.es = strip_of_val(s)
      e.esDone = true
    }
    push(sw.edges, e)
  }
  let ns = v_get(v, "nodes")
  for i in 0 .. vlen0(ns) { push(sw.nodes, node_of_val(v_item(ns, i))) }
  return sw
}
export function plan_of_val(v: Val) -> SwPlan {
  let p = new SwPlan
  p.kind = v_gets(v, "kind", "")
  p.rho = v_getn(v, "rho", 0.0)
  let c = v_get(v, "centre")
  if not v_undef(c) {
    p.hasCentre = true
    let cc = vnums0(c)
    p.cx = cc[0]
    p.cz = cc[1]
  }
  p.mids = new [][]double
  let ls = v_get(v, "levels")
  for k in 0 .. vlen0(ls) { push(p.mids, v_pts(v_get(v_item(ls, k), "mid"))) }
  return p
}
export function junc_of_val(v: Val) -> Junc {
  let j = new Junc
  j.kind = v_gets(v, "kind", "")
  j.strict = vbool0(v_get(v, "strict"))
  j.radius = v_getn(v, "radius", 0.0)
  j.notes = new []string
  let ns = v_get(v, "notes")
  for i in 0 .. vlen0(ns) { push(j.notes, v_item(ns, i).str) }
  j.ends = new []SwJEnd
  let es = v_get(v, "ends")
  for i in 0 .. vlen0(es) {
    let ev = v_item(es, i)
    let e = new SwJEnd
    e.key = v_gets(ev, "key", "")
    e.out = vbool0(v_get(ev, "out"))
    let u = vnums0(v_get(ev, "u"))
    let n = vnums0(v_get(ev, "n"))
    if len(u) == 2 {
      e.ux = u[0]
      e.uz = u[1]
    }
    if len(n) == 2 {
      e.nx = n[0]
      e.nz = n[1]
    }
    e.setback = v_getn(ev, "setback", 0.0)
    if v_has(ev, "r") { e.r = offsets_of_val(v_get(ev, "r")) }
    if v_has(ev, "l") { e.l = offsets_of_val(v_get(ev, "l")) }
    e.curbH = v_getn(ev, "curbH", 0.0)
    push(j.ends, e)
  }
  j.corners = new []SwCorner
  let cs = v_get(v, "corners")
  for i in 0 .. vlen0(cs) {
    let cv = v_item(cs, i)
    let c = new SwCorner
    c.i = int(v_getn(cv, "i", 0.0))
    c.j = int(v_getn(cv, "j", 0.0))
    c.kind = v_gets(cv, "kind", "")
    c.rails = new [][]double
    let rs = v_get(cv, "rails")
    for k in 0 .. vlen0(rs) { push(c.rails, v_pts(v_item(rs, k))) }
    let cc = v_get(cv, "centre")
    if not v_undef(cc) {
      c.hasCentre = true
      let p = vnums0(cc)
      c.cx = p[0]
      c.cz = p[1]
    }
    c.radius = v_getn(cv, "radius", 0.0)
    let kb = v_get(cv, "kerb")
    if not v_undef(kb) { c.kerb = v_pts(kb) }
    let cr = v_get(cv, "crushed")
    if not v_undef(cr) {
      c.crushed = new [][]double
      for k in 0 .. vlen0(cr) { push(c.crushed, v_pts(v_item(cr, k))) }
    }
    c.sharp = vbool0(v_get(cv, "sharp"))
    push(j.corners, c)
  }
  return j
}
