# trig_tab.ludic - the fixture test's JsMath: the answers the studio's V8 gave (fix/<scene>/trig.bin: i32 n, then n x (u8 0 sin |
# 1 cos | 2 tan | 3 atan2, f64 x, f64 y, f64 answer)), by the bits of the arguments; libm for a call the bake never made (counted)
state TrigTab {
  cap: int = 0
  kx: []long = null
  ky: []long = null
  kf: []int = null
  val: []double = null
  n: int = 0
  miss: int = 0
}

function tt_slot(t: TrigTab, f: int, xb: long, yb: long) -> int {
  var h = xb * long(1000003) + yb * long(7919) + long(f)
  h = h ^ (h >> 29)
  var i = int(h & long(t.cap - 1))
  while t.kf[i] >= 0 and not (t.kf[i] == f and t.kx[i] == xb and t.ky[i] == yb) { i = (i + 1) & (t.cap - 1) }
  return i
}

# loads a scene's table (false when it has none: libm answers)
export function tt_load(t: mut TrigTab, path: string) -> bool {
  let b = Fs.read_bytes(path)
  t.n = 0
  t.miss = 0
  t.cap = 0
  if b == null or len(b) < 4 { return false }
  let r = new VReader
  r.b = b
  let n = vr_i(r)
  var cap = 16
  while cap < n * 2 { cap = cap * 2 }
  t.cap = cap
  t.kx = new []long
  t.ky = new []long
  t.kf = new []int
  t.val = new []double
  let z0: double = 0.0
  for i in 0 .. cap {
    push(t.kx, long(0))
    push(t.ky, long(0))
    push(t.kf, -1)
    push(t.val, z0)
  }
  for i in 0 .. n {
    let f = int(r.b[r.at])
    r.at = r.at + 1
    let x = vr_d(r)
    let y = vr_d(r)
    let v = vr_d(r)
    let s = tt_slot(t, f, double_bits(x), double_bits(y))
    t.kf[s] = f
    t.kx[s] = double_bits(x)
    t.ky[s] = double_bits(y)
    t.val[s] = v
  }
  t.n = n
  return true
}

function tt_get(t: TrigTab, f: int, x: double, y: double) -> double {
  if t.cap == 0 { return NAN }
  let s = tt_slot(t, f, double_bits(x), double_bits(y))
  if t.kf[s] < 0 { return NAN }
  return t.val[s]
}
function tt_sin(t: TrigTab, x: double) -> double {
  let z: double = 0.0
  let v = tt_get(t, 0, x, z)
  if v != v { return Math.sin(x) }
  return v
}
function tt_cos(t: TrigTab, x: double) -> double {
  let z: double = 0.0
  let v = tt_get(t, 1, x, z)
  if v != v { return Math.cos(x) }
  return v
}
function tt_tan(t: TrigTab, x: double) -> double {
  let z: double = 0.0
  let v = tt_get(t, 2, x, z)
  if v != v { return Math.tan(x) }
  return v
}
function tt_atan2(t: TrigTab, y: double, x: double) -> double {
  let v = tt_get(t, 3, y, x)
  if v != v { return Math.atan2(y, x) }
  return v
}
