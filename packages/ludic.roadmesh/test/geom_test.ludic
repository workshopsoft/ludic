# geom_test.ludic - geom.ludic against the studio's geom.ts calls (fix/<scene>/geom.fix)

function cmp_obj_nums(c: Check, what: string, got: []double, want: Val, keys: []string) -> void {
  for k in 0 .. len(keys) { check_numv(c, `{what}.{keys[k]}`, got[k], v_get(want, keys[k])) }
}

export function test_geom(recs: []Rec) -> int {
  let c = check_new("geom")
  for q in 0 .. len(recs) {
    let r = recs[q]
    let f = r.fn
    let w = r.res
    check_rec(c, f)
    if f == "hypot2" {
      check_numv(c, "v", hypot2(arg_n(r, 0), arg_n(r, 1)), w)
    } else if f == "hypot3" {
      check_numv(c, "v", hypot3(arg_n(r, 0), arg_n(r, 1), arg_n(r, 2)), w)
    } else if f == "dist" {
      let a = arg_pt(r, 0)
      let b = arg_pt(r, 1)
      check_numv(c, "v", dist(a[0], a[1], b[0], b[1]), w)
    } else if f == "ringArea" {
      check_numv(c, "v", ring_area(arg_pt(r, 0)), w)
    } else if f == "polygonAreaOf" {
      check_numv(c, "v", polygon_area_of(arg_pt(r, 0)), w)
    } else if f == "perimeterOf" {
      check_numv(c, "v", perimeter_of(arg_pt(r, 0), arg_bd(r, 1, true)), w)
    } else if f == "centroidOf" {
      check_nums(c, "v", centroid_of(arg_pt(r, 0)), w)
    } else if f == "pointInPolygon" {
      let p = arg_pt(r, 0)
      check_bool(c, "v", point_in_polygon(p[0], p[1], arg_pt(r, 1)), w)
    } else if f == "boundsOf" {
      cmp_obj_nums(c, "v", bounds_of(arg_pt(r, 0)), w, ["x0", "z0", "x1", "z1"])
    } else if f == "segCross" {
      let a = arg_pt(r, 0)
      let b = arg_pt(r, 1)
      let cc = arg_pt(r, 2)
      let d = arg_pt(r, 3)
      let x = seg_cross(a[0], a[1], b[0], b[1], cc[0], cc[1], d[0], d[1])
      if x == null or v_undef(w) {
        if (x == null) != v_undef(w) { check_fail(c, "crossing or not") }
      } else {
        check_numv(c, "t", x[0], v_get(w, "t"))
        check_numv(c, "u", x[1], v_get(w, "u"))
        check_nums(c, "p", d_pair(x[2], x[3]), v_get(w, "p"))
      }
    } else if f == "closestOnSegment" {
      let p = arg_pt(r, 0)
      let a = arg_pt(r, 1)
      let b = arg_pt(r, 2)
      let x = closest_on_segment(p[0], p[1], a[0], a[1], b[0], b[1])
      check_numv(c, "d", x[0], v_get(w, "d"))
      check_nums(c, "at", d_pair(x[1], x[2]), v_get(w, "at"))
      check_numv(c, "t", x[3], v_get(w, "t"))
    } else if f == "closestOnLine" {
      let p = arg_pt(r, 1)
      let x = closest_on_line(arg_pt(r, 0), p[0], p[1])
      if x == null or v_undef(w) {
        if (x == null) != v_undef(w) { check_fail(c, "found or not") }
      } else {
        check_numv(c, "d", x[0], v_get(w, "d"))
        check_nums(c, "at", d_pair(x[1], x[2]), v_get(w, "at"))
        check_numv(c, "seg", x[3], v_get(w, "seg"))
        check_numv(c, "t", x[4], v_get(w, "t"))
      }
    } else if f == "simplifyLine" {
      check_nums(c, "v", simplify_line(arg_pt(r, 0), arg_n(r, 1), arg_bd(r, 2, false)), w)
    } else if f == "dropCollinear" {
      check_nums(c, "v", drop_collinear(arg_pt(r, 0), arg_nd(r, 1, 0.01)), w)
    } else if f == "ccw" {
      check_nums(c, "v", ccw(arg_pt(r, 0)), w)
    } else if f == "dedupe" {
      check_nums(c, "v", dedupe(arg_pt(r, 0), arg_nd(r, 1, 0.01), arg_bd(r, 2, false)), w)
    } else if f == "cleanRing" {
      check_nums(c, "v", clean_ring(arg_pt(r, 0)), w)
    } else if f == "offsetRing" {
      check_nums(c, "v", offset_ring(arg_pt(r, 0), arg_n(r, 1)), w)
    } else if f == "unitOf" {
      let v = arg_pt(r, 0)
      check_nums(c, "v", unit_of(v[0], v[1]), w)
    } else if f == "splitRing" {
      let a = arg_pt(r, 1)
      let b = arg_pt(r, 2)
      let s = split_ring(arg_pt(r, 0), a[0], a[1], b[0], b[1])
      let rings = v_get(w, "rings")
      if s.a == null {
        check_str(c, "why", s.why, v_get(w, "why"))
        if not v_undef(rings) { check_fail(c, "rings, want none") }
      } else {
        if v_undef(rings) { check_fail(c, `no rings: {v_gets(w, "why", "")}`) } else {
          check_nums(c, "rings[0]", s.a, v_item(rings, 0))
          check_nums(c, "rings[1]", s.b, v_item(rings, 1))
        }
      }
    } else if f == "mergeRings" {
      let m = merge_rings(arg_pt(r, 0), arg_pt(r, 1), arg_nd(r, 2, 0.05))
      if m.ring == null {
        check_str(c, "why", m.why, v_get(w, "why"))
      } else {
        check_nums(c, "ring", m.ring, v_get(w, "ring"))
      }
    } else {
      check_fail(c, "no such function in the port")
    }
  }
  return check_report(c)
}
