# sidewalk_test.ludic - sidewalk.ludic against the studio's sidewalk.ts calls (fix/<scene>/sidewalk.fix). A Sidewalk method's record
# carries the world it read (edges, strips, nodes) and the other parts' answers (stubs), and is run on a world made from it.

function check_strip(c: Check, what: string, es: Strip, w: Val) -> void {
  if es == null or v_undef(w) {
    if not (es == null and v_undef(w)) { check_fail(c, `{what}: one is undefined`) }
    return
  }
  check_num(c, `{what}.scale`, es.scale, v_getn(w, "scale", NAN))
  let st = v_get(w, "st")
  check_int(c, `{what}.st`, len(es.st), v_len(st))
  if len(es.st) != v_len(st) { return }
  for i in 0 .. len(es.st) {
    let q = es.st[i]
    let g = doubles(7)
    g[0] = q.px
    g[1] = q.pz
    g[2] = q.nx
    g[3] = q.nz
    g[4] = q.k
    g[5] = q.s
    g[6] = q.y
    check_nums(c, `{what}.st[{i}]`, g, v_item(st, i))
  }
}

function check_pts_list(c: Check, what: string, got: [][]double, w: Val) -> void {
  if got == null or v_undef(w) {
    if not (got == null and v_undef(w)) { check_fail(c, `{what}: one is undefined`) }
    return
  }
  check_int(c, `{what}.length`, len(got), v_len(w))
  if len(got) != v_len(w) { return }
  for k in 0 .. len(got) { check_nums(c, `{what}[{k}]`, got[k], v_item(w, k)) }
}

function check_junc(c: Check, j: Junc, w: Val) -> void {
  check_str(c, "kind", j.kind, v_get(w, "kind"))
  let ns = v_get(w, "notes")
  check_int(c, "notes", len(j.notes), v_len(ns))
  if len(j.notes) == v_len(ns) { for i in 0 .. len(j.notes) { check_str(c, `notes[{i}]`, j.notes[i], v_item(ns, i)) } }
  let cs = v_get(w, "corners")
  check_int(c, "corners", len(j.corners), v_len(cs))
  if len(j.corners) != v_len(cs) { return }
  for i in 0 .. len(j.corners) {
    let k = j.corners[i]
    let cv = v_item(cs, i)
    check_str(c, `corner {i}.kind`, k.kind, v_get(cv, "kind"))
    check_numv(c, `corner {i}.radius`, k.radius, v_get(cv, "radius"))
    check_pts_list(c, `corner {i}.rails`, k.rails, v_get(cv, "rails"))
    let cc = v_get(cv, "centre")
    if k.hasCentre != not v_undef(cc) { check_fail(c, `corner {i}.centre: one is undefined`) } else if k.hasCentre { check_nums(c, `corner {i}.centre`, d_pair(k.cx, k.cz), cc) }
    check_nums(c, `corner {i}.kerb`, k.kerb, v_get(cv, "kerb"))
    check_pts_list(c, `corner {i}.crushed`, k.crushed, v_get(cv, "crushed"))
  }
}

function deps_done(c: Check, sw: Sw) -> void {
  if sw.deps.bad != "" {
    check_fail(c, `stubs: {sw.deps.bad}`)
  } else if sw.deps.at != len(sw.deps.q) {
    check_fail(c, `stubs: {len(sw.deps.q) - sw.deps.at} answers not asked for`)
  }
}

export function test_sidewalk(recs: []Rec) -> int {
  let c = check_new("sidewalk")
  for q in 0 .. len(recs) {
    let r = recs[q]
    let f = r.fn
    let w = r.res
    check_rec(c, f)
    if f == "deadCap" {
      let n = rarg(r, 0)
      let e = rarg(r, 1)
      let en = v_nums(v_get(e, "n"))
      let eu = v_nums(v_get(e, "u"))
      var ends: []double = null
      if not v_undef(rarg(r, 4)) { ends = v_pts(rarg(r, 4)) }
      check_nums(c, "pts", dead_cap(v_getn(n, "x", 0.0), v_getn(n, "z", 0.0), en[0], en[1], eu[0], eu[1], arg_n(r, 2), arg_n(r, 3), ends), w)
    } else if f == "discVertices" {
      let n = rarg(r, 0)
      check_nums(c, "pts", disc_vertices(v_getn(n, "x", 0.0), v_getn(n, "z", 0.0), arg_n(r, 1)), w)
    } else if f == "bulbArc" {
      let n = rarg(r, 0)
      let u = arg_pt(r, 1)
      check_nums(c, "pts", bulb_arc(v_getn(n, "x", 0.0), v_getn(n, "z", 0.0), u[0], u[1], arg_n(r, 2), arg_n(r, 3), arg_n(r, 4)), w)
    } else if f == "railPoints" {
      check_nums(c, "pts", rail_points(arg_pt(r, 0), arg_n(r, 1)), w)
    } else if f == "densifyLine" {
      check_nums(c, "pts", densify_line(arg_pt(r, 0), arg_n(r, 1)), w)
    } else if f == "thinRing" {
      let t = thin_ring(arg_pt(r, 0), v_nums(rarg(r, 1)), arg_n(r, 2), arg_n(r, 3))
      check_nums(c, "pts", t[0], v_get(w, "pts"))
      check_nums(c, "ys", t[1], v_get(w, "ys"))
    } else if f == "bulbRails" {
      let n = rarg(r, 0)
      let u = arg_pt(r, 1)
      let ev = rarg(r, 3)
      let ends = new [][]double
      for k in 0 .. v_len(ev) { push(ends, v_pts(v_item(ev, k))) }
      check_pts_list(c, "rails", bulb_rails(v_getn(n, "x", 0.0), v_getn(n, "z", 0.0), u[0], u[1], arg_n(r, 2), ends, v_nums(rarg(r, 4))), w)
    } else if f == "stations" {
      let sw = sw_of_val(rarg(r, 1))
      let key = rarg(r, 0).str
      let e = sw_edge(sw, key)
      if e != null { e.raw = strip_of_val(rarg(r, 2)) }
      check_strip(c, "es", sw_stations(sw, key), w)
    } else if f == "junction" {
      let sw = sw_of_val(rarg(r, 1))
      sw.hasRadius = v_bool(v_get(rarg(r, 4), "hasRadius"))
      let qv = rarg(r, 3)
      for k in 0 .. v_len(qv) { push(sw.deps.q, v_item(qv, k)) }
      let j = sw_junction(sw, node_of_val(rarg(r, 0)), junc_of_val(rarg(r, 2)))
      check_junc(c, j, w)
      deps_done(c, sw)
    } else if f == "lvlAt" {
      let sw = sw_of_val(rarg(r, 4))
      check_numv(c, "lvl", sw_lvl_at(sw, rarg(r, 0).str, int(arg_n(r, 1)), int(arg_n(r, 2)), arg_n(r, 3)), w)
    } else if f == "rampAt" {
      let sw = sw_of_val(rarg(r, 3))
      let got = sw_ramp_at(sw, rarg(r, 0).str, int(arg_n(r, 1)), int(arg_n(r, 2)))
      if got == null {
        if not v_undef(w) { check_fail(c, "ramp: undefined, want a number") }
      } else {
        check_numv(c, "ramp", got[0], w)
      }
    } else if f == "bulb" {
      let sw = sw_of_val(rarg(r, 2))
      check_pts_list(c, "rails", sw_bulb(sw, node_of_val(rarg(r, 0)), junc_of_val(rarg(r, 1))), w)
    } else {
      check_fail(c, "no such function in the port")
    }
  }
  return check_report(c)
}

