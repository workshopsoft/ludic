# fixture.ludic - the studio's fixture files (game-editor packages/core/test/fixtures/roadnative/fixfile.ts): a module's recorded
# calls (function, arguments, answer) as tagged values, and the checks a module's test makes of its own answers against them.
#
#   file    "RNFX" (i32 1481002578), i32 version 1, i32 record count, records
#   record  str function, val args (an array), val result
#   val     u8 tag: 0 undefined | 1 null | 2 false | 3 true | 4 f64 | 5 str | 6 array (i32 n, n vals) | 7 f64s (i32 n, n f64)
#           8 object (i32 n, n x (str key, val)) | 9 pts (i32 n, 2n f64)
#   str     i32 byte length, utf-8
# The same tagged values are the job format's (PORT.md).

const T_UNDEF: int = 0
const T_NULL: int = 1
const T_FALSE: int = 2
const T_TRUE: int = 3
const T_NUM: int = 4
const T_STR: int = 5
const T_ARR: int = 6
const T_NUMS: int = 7
const T_OBJ: int = 8
const T_PTS: int = 9

export property Val {
  tag: int = 0
  num: double = 0.0
  str: string = ""
  arr: []Val = null       # an array's items, an object's values
  keys: []string = null   # an object's keys
  nums: []double = null   # f64s, or pts as x, z pairs
  bytes: []byte = null    # tag 10 (the job's): raw bytes
}

export property Rec {
  fn: string = ""
  args: Val = null
  res: Val = null
}

property VReader {
  b: []byte = null
  at: int = 0
}

function vr_i(r: VReader) -> int {
  let b = r.b
  let a = r.at
  r.at = a + 4
  let v = b[a] | (b[a + 1] << 8) | (b[a + 2] << 16) | (b[a + 3] << 24)
  if v >= 2147483648 { return v - 4294967296 }
  return v
}
function vr_d(r: VReader) -> double {
  let b = r.b
  let a = r.at
  r.at = a + 8
  var bits: long = 0
  var k = 7
  while k >= 0 {
    bits = (bits << 8) | long(b[a + k])
    k -= 1
  }
  return double_from_bits(bits)
}
function vr_s(r: VReader) -> string {
  let n = vr_i(r)
  if n == 0 { return "" }
  let s = text_of(view(r.b, r.at, n), n)
  r.at = r.at + n
  return s
}
export function read_val(r: VReader) -> Val {
  let v = new Val
  let t = int(r.b[r.at])
  r.at = r.at + 1
  v.tag = t
  if t == T_NUM { v.num = vr_d(r) }
  if t == T_STR { v.str = vr_s(r) }
  if t == T_ARR {
    let n = vr_i(r)
    v.arr = new []Val
    for i in 0 .. n { push(v.arr, read_val(r)) }
  }
  if t == T_NUMS or t == T_PTS {
    var n = vr_i(r)
    if t == T_PTS { n = n * 2 }
    v.nums = doubles(n)
    for i in 0 .. n { v.nums[i] = vr_d(r) }
  }
  if t == 10 {
    let n = vr_i(r)
    v.bytes = buffer(max(n, 1))
    for i in 0 .. n { v.bytes[i] = r.b[r.at + i] }
    r.at = r.at + n
  }
  if t == T_OBJ {
    let n = vr_i(r)
    v.arr = new []Val
    v.keys = new []string
    for i in 0 .. n {
      push(v.keys, vr_s(r))
      push(v.arr, read_val(r))
    }
  }
  return v
}

# a file of one tagged value after a magic and a version (the bake's job): null when it cannot be read
export function read_val_file(path: string, magic: int) -> Val {
  let r = new VReader
  r.b = Fs.read_bytes(path)
  if r.b == null or len(r.b) < 9 { return null }
  if vr_i(r) != magic { return null }
  if vr_i(r) != 1 { return null }
  return read_val(r)
}

# a fixture file's records (null when it cannot be read)
export function read_fix(path: string) -> []Rec {
  let r = new VReader
  r.b = Fs.read_bytes(path)
  if r.b == null or len(r.b) < 12 { return null }
  if vr_i(r) != 1481002578 { return null }
  if vr_i(r) != 1 { return null }
  let n = vr_i(r)
  let out = new []Rec
  for i in 0 .. n {
    let c = new Rec
    c.fn = vr_s(r)
    c.args = read_val(r)
    c.res = read_val(r)
    push(out, c)
  }
  return out
}

# ---- reading values -------------------------------------------------------------------------------------------------------
export function v_at(v: Val, i: int) -> Val { return v.arr[i] }
export function v_len(v: Val) -> int {
  if v.tag == T_ARR or v.tag == T_OBJ { return len(v.arr) }
  if v.tag == T_NUMS { return len(v.nums) }
  if v.tag == T_PTS { return len(v.nums) / 2 }
  return 0
}
export function v_num(v: Val) -> double { return v.num }
export function v_int(v: Val) -> int { return int(v.num) }
export function v_bool(v: Val) -> bool { return v.tag == T_TRUE }
export function v_undef(v: Val) -> bool { return v == null or v.tag == T_UNDEF or v.tag == T_NULL }
# an object's field (null when it has none)
export function v_get(v: Val, key: string) -> Val {
  if v == null or v.tag != T_OBJ { return null }
  for i in 0 .. len(v.keys) { if v.keys[i] == key { return v.arr[i] } }
  return null
}
export function v_has(v: Val, key: string) -> bool { return not v_undef(v_get(v, key)) }
export function v_getn(v: Val, key: string, d: double) -> double {
  let f = v_get(v, key)
  if f == null or f.tag != T_NUM { return d }
  return f.num
}
export function v_gets(v: Val, key: string, d: string) -> string {
  let f = v_get(v, key)
  if f == null or f.tag != T_STR { return d }
  return f.str
}
# points (pts, or an empty f64s) as a flat x, z slice; an array of [x, z] arrays too
export function v_pts(v: Val) -> []double {
  if v.tag == T_PTS or v.tag == T_NUMS { return pts_copy(v.nums) }
  let out = new []double
  if v.tag == T_ARR { for i in 0 .. len(v.arr) { pts_push(out, v.arr[i].nums[0], v.arr[i].nums[1]) } }
  return out
}
export function v_nums(v: Val) -> []double {
  if v.tag == T_NUMS or v.tag == T_PTS { return pts_copy(v.nums) }
  return doubles(0)
}

# ---- checking ------------------------------------------------------------------------------------------------------------
export property Check {
  name: string = ""
  recs: int = 0
  bad: int = 0
  worst: double = 0.0       # the largest difference of two numbers that differ
  shown: int = 0
  fns: []string = null      # per function: name, records, mismatches
  fnRecs: []int = null
  fnBad: []int = null
  cur: int = -1
  curBad: bool = false
}

export function check_new(name: string) -> Check {
  let c = new Check
  c.name = name
  c.fns = new []string
  c.fnRecs = new []int
  c.fnBad = new []int
  return c
}
# a record begins (its function's tally)
export function check_rec(c: Check, fn: string) -> void {
  c.recs += 1
  c.curBad = false
  var k = -1
  for i in 0 .. len(c.fns) { if c.fns[i] == fn { k = i } }
  if k < 0 {
    push(c.fns, fn)
    push(c.fnRecs, 0)
    push(c.fnBad, 0)
    k = len(c.fns) - 1
  }
  c.fnRecs[k] += 1
  c.cur = k
}
export function check_fail(c: Check, what: string) -> void {
  if not c.curBad {
    c.curBad = true
    c.bad += 1
    if c.cur >= 0 { c.fnBad[c.cur] += 1 }
  }
  if c.shown < 12 {
    print(`  {c.name} record {c.recs - 1} ({c.fns[c.cur]}): {what}`)
    c.shown += 1
  }
}
# two doubles the same to the bit (NaN equal to NaN)
export function same_d(a: double, b: double) -> bool { return double_bits(a) == double_bits(b) or (a != a and b != b) }
export function check_num(c: Check, what: string, got: double, want: double) -> void {
  if same_d(got, want) { return }
  let d = dabs(got - want)
  if d > c.worst or d != d { c.worst = d }
  check_fail(c, `{what}: {got}, want {want}`)
}
export function check_numv(c: Check, what: string, got: double, want: Val) -> void {
  if want == null or want.tag != T_NUM {
    check_fail(c, `{what}: {got}, want no number`)
    return
  }
  check_num(c, what, got, want.num)
}
export function check_int(c: Check, what: string, got: int, want: int) -> void {
  if got != want { check_fail(c, `{what}: {got}, want {want}`) }
}
export function check_bool(c: Check, what: string, got: bool, want: Val) -> void {
  if got != v_bool(want) or not (want.tag == T_TRUE or want.tag == T_FALSE) { check_fail(c, `{what}: {got}, want tag {want.tag}`) }
}
export function check_str(c: Check, what: string, got: string, want: Val) -> void {
  if want == null or want.tag != T_STR or want.str != got { check_fail(c, `{what}: '{got}'`) }
}
# a slice of numbers against f64s or pts (null against undefined or null)
export function check_nums(c: Check, what: string, got: []double, want: Val) -> void {
  if got == null {
    if not v_undef(want) { check_fail(c, `{what}: none, want some`) }
    return
  }
  if v_undef(want) {
    check_fail(c, `{what}: {len(got)} numbers, want none`)
    return
  }
  let w = v_nums(want)
  if len(w) != len(got) {
    check_fail(c, `{what}: {len(got)} numbers, want {len(w)}`)
    return
  }
  for i in 0 .. len(w) {
    if not same_d(got[i], w[i]) {
      check_num(c, `{what}[{i}]`, got[i], w[i])
      return
    }
  }
}
export function check_ints(c: Check, what: string, got: []int, want: Val) -> void {
  let w = v_nums(want)
  if len(w) != len(got) {
    check_fail(c, `{what}: {len(got)} numbers, want {len(w)}`)
    return
  }
  for i in 0 .. len(w) {
    if double(got[i]) != w[i] {
      check_fail(c, `{what}[{i}]: {got[i]}, want {w[i]}`)
      return
    }
  }
}
# prints the tally; answers the mismatches
export function check_report(c: Check) -> int {
  for i in 0 .. len(c.fns) { print(`  {c.name}.{c.fns[i]}: {c.fnRecs[i]} records, {c.fnBad[i]} differ`) }
  if c.bad > 0 { print(`{c.name}: {c.bad} of {c.recs} records differ (largest difference {c.worst})`) } else { print(`{c.name}: {c.recs} records, all the same to the bit`) }
  return c.bad
}

# an array's item as a value, whichever way the array was written (an array of numbers as f64s, of pairs as pts)
export function v_item(v: Val, i: int) -> Val {
  if v.tag == T_ARR or v.tag == T_OBJ { return v.arr[i] }
  let o = new Val
  if v.tag == T_NUMS {
    o.tag = T_NUM
    o.num = v.nums[i]
    return o
  }
  if v.tag == T_PTS {
    o.tag = T_NUMS
    o.nums = d_pair(v.nums[i * 2], v.nums[i * 2 + 1])
    return o
  }
  o.tag = T_UNDEF
  return o
}
# argument i of a record (undefined when the call passed fewer)
export function rarg(r: Rec, i: int) -> Val {
  if i >= v_len(r.args) {
    let o = new Val
    o.tag = T_UNDEF
    return o
  }
  return v_item(r.args, i)
}
export function arg_n(r: Rec, i: int) -> double { return rarg(r, i).num }
export function arg_nd(r: Rec, i: int, d: double) -> double {
  let a = rarg(r, i)
  if a.tag != T_NUM { return d }
  return a.num
}
export function arg_bd(r: Rec, i: int, d: bool) -> bool {
  let a = rarg(r, i)
  if a.tag == T_TRUE { return true }
  if a.tag == T_FALSE { return false }
  return d
}
# a point argument: x, z
export function arg_pt(r: Rec, i: int) -> []double { return v_pts(rarg(r, i)) }
