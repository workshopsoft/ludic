# rotview.ludic - a window onto the map that turns: a radar that keeps the way you face up (a car's satellite navigator, a shooter's
# corner map), and the same with no turn for a full screen map. A view is a value (MinimapRotView), so a game holds as many as it
# draws (the corner radar and the pause map), each set every frame from where the viewer is.
#
# The window is w x h pixels at (x0, y0) on the screen. The world point (cx, cz) is drawn at the anchor, a fraction (ax, ay) of the
# window (0.5, 0.62: a little below the middle, more road ahead). `rot` is a heading in ludic.character's convention, forward being
# (-sin rot, -cos rot): that way is up on the screen. rot 0 is north up: -z up, +x right, as minimap_px / py draw. `k` is pixels a metre.
export property MinimapRotView {
  x0: float = 0.0
  y0: float = 0.0
  w: float = 1.0
  h: float = 1.0
  ax: float = 0.0                        # the anchor on the screen, pixels
  ay: float = 0.0
  cx: float = 0.0                        # the world point drawn there
  cz: float = 0.0
  rot: float = 0.0
  k: float = 1.0
  cs: float = 1.0                        # cos and sin of rot
  sn: float = 0.0
  rim_x: float = 0.0                     # minimap_rv_rim's answer
  rim_y: float = 0.0
  rim_out: bool = false
  bx0: float = 0.0                       # the world box the window shows (minimap_rv_set keeps it)
  bz0: float = 0.0
  bx1: float = 0.0
  bz1: float = 0.0
  # the tilt (minimap_rv_tilt): the map seen leaning away, as from behind and above the player - what is ahead drawn smaller toward a
  # horizon. pd is the eye's distance in pixels (0: flat), ps / pc the lean's sine and cosine
  pd: float = 0.0
  ps: float = 0.0
  pc: float = 1.0
  # a round window (minimap_rv_round): its middle and radius; rr 0 is the rectangle
  rcx: float = 0.0
  rcy: float = 0.0
  rr: float = 0.0
}

# the view this frame: the window, the anchor as a fraction of it, the world point there, the heading up and the metres across the window
export function minimap_rv_set(v: MinimapRotView, x0: float, y0: float, w: float, h: float, fx: float, fy: float, cx: float, cz: float, rot: float, span: float) -> void {
  v.x0 = x0
  v.y0 = y0
  v.w = Math.max(w, 1.0)
  v.h = Math.max(h, 1.0)
  v.ax = x0 + v.w * fx
  v.ay = y0 + v.h * fy
  v.cx = cx
  v.cz = cz
  v.rot = rot
  v.cs = Math.cos(rot)
  v.sn = Math.sin(rot)
  v.k = v.w / Math.max(span, 0.001)
  v.pd = 0.0
  v.rr = 0.0
  rv_box(v)
}
# the world box the window shows: the four corners unturned (a leaning view's too: a line on the map stays a line on the screen)
function rv_box(v: MinimapRotView) -> void {
  v.bx0 = 1000000000.0
  v.bz0 = 1000000000.0
  v.bx1 = -1000000000.0
  v.bz1 = -1000000000.0
  rv_box_add(v, v.x0, v.y0)
  rv_box_add(v, v.x0 + v.w, v.y0)
  rv_box_add(v, v.x0 + v.w, v.y0 + v.h)
  rv_box_add(v, v.x0, v.y0 + v.h)
}
# lean the view (after minimap_rv_set): `deg` from straight down, the eye `eye` pixels from the anchor. 0 degrees is the flat map
export function minimap_rv_tilt(v: MinimapRotView, deg: float, eye: float) -> void {
  let a = Math.clamp(deg, 0.0, 75.0) * 0.017453292
  v.ps = Math.sin(a)
  v.pc = Math.cos(a)
  v.pd = 0.0
  if deg > 0.0 { v.pd = Math.max(eye, 1.0) }
  rv_box(v)
}
# a round window (after minimap_rv_set): inside and the rim are the circle of radius r about (cx, cy), not the rectangle
export function minimap_rv_round(v: MinimapRotView, cx: float, cy: float, r: float) -> void {
  v.rcx = cx
  v.rcy = cy
  v.rr = r
}
function rv_box_add(v: MinimapRotView, sx: float, sy: float) -> void {
  let x = minimap_rv_wx(v, sx, sy)
  let z = minimap_rv_wz(v, sx, sy)
  v.bx0 = Math.min(v.bx0, x)
  v.bz0 = Math.min(v.bz0, z)
  v.bx1 = Math.max(v.bx1, x)
  v.bz1 = Math.max(v.bz1, z)
}

# a world point on the screen
export function minimap_rv_sx(v: MinimapRotView, x: float, z: float) -> float {
  let u = v.k * ((x - v.cx) * v.cs - (z - v.cz) * v.sn)
  if v.pd <= 0.0 { return v.ax + u }
  let f = -v.k * ((x - v.cx) * v.sn + (z - v.cz) * v.cs)          # pixels ahead on the flat map
  return v.ax + u * v.pd / rv_depth(v, f)
}
export function minimap_rv_sy(v: MinimapRotView, x: float, z: float) -> float {
  let w = v.k * ((x - v.cx) * v.sn + (z - v.cz) * v.cs)
  if v.pd <= 0.0 { return v.ay + w }
  return v.ay + w * v.pc * v.pd / rv_depth(v, -w)
}
# the eye's distance to a point `f` pixels ahead on the leaning map (never under a sixth of the eye's height: a point past the horizon is
# held just short of it)
function rv_depth(v: MinimapRotView, f: float) -> float { return Math.max(v.pd + f * v.ps, v.pd * 0.16) }
# the flat map's pixels (u right, w down) under a screen point: the tilt undone
function rv_flat_u(v: MinimapRotView, sx: float, sy: float) -> float {
  if v.pd <= 0.0 { return sx - v.ax }
  let f = rv_flat_f(v, sy)
  return (sx - v.ax) * rv_depth(v, f) / v.pd
}
function rv_flat_f(v: MinimapRotView, sy: float) -> float {
  let y = sy - v.ay
  return -y * v.pd / Math.max(v.pc * v.pd + y * v.ps, v.pd * 0.05)
}
function rv_flat_w(v: MinimapRotView, sy: float) -> float {
  if v.pd <= 0.0 { return sy - v.ay }
  return -rv_flat_f(v, sy)
}
# the world under a point of the screen
export function minimap_rv_wx(v: MinimapRotView, sx: float, sy: float) -> float {
  let u = rv_flat_u(v, sx, sy) / v.k
  let w = rv_flat_w(v, sy) / v.k
  return v.cx + u * v.cs + w * v.sn
}
export function minimap_rv_wz(v: MinimapRotView, sx: float, sy: float) -> float {
  let u = rv_flat_u(v, sx, sy) / v.k
  let w = rv_flat_w(v, sy) / v.k
  return v.cz - u * v.sn + w * v.cs
}
# a heading in the world (ludic.character's yaw) as an angle on the screen, 0 up, clockwise: what an arrow drawn at the anchor turns by
export function minimap_rv_angle(v: MinimapRotView, yaw: float) -> float { return v.rot - yaw }

# is a screen point inside the window, `margin` pixels in from its edge?
export function minimap_rv_inside(v: MinimapRotView, sx: float, sy: float, margin: float) -> bool {
  if v.rr > 0.0 {
    let r = Math.max(v.rr - margin, 0.0)
    return (sx - v.rcx) * (sx - v.rcx) + (sy - v.rcy) * (sy - v.rcy) <= r * r
  }
  return sx >= v.x0 + margin and sx <= v.x0 + v.w - margin and sy >= v.y0 + margin and sy <= v.y0 + v.h - margin
}

# a screen point brought onto the window's rim, `margin` pixels in, along the line from the anchor (a tracked mark off the radar):
# into rim_x / rim_y; rim_out says it had to be moved
export function minimap_rv_rim(v: MinimapRotView, sx: float, sy: float, margin: float) -> void {
  v.rim_x = sx
  v.rim_y = sy
  v.rim_out = false
  if minimap_rv_inside(v, sx, sy, margin) { return }
  v.rim_out = true
  if v.rr > 0.0 {
    # on the circle, along the line from its middle
    let ex = sx - v.rcx
    let ey = sy - v.rcy
    let d = Math.max(Math.sqrt(ex * ex + ey * ey), 0.0001)
    let r = Math.max(v.rr - margin, 0.0)
    v.rim_x = v.rcx + ex / d * r
    v.rim_y = v.rcy + ey / d * r
    return
  }
  let dx = sx - v.ax
  let dy = sy - v.ay
  var t = 1.0
  if dx > 0.0001 { t = Math.min(t, (v.x0 + v.w - margin - v.ax) / dx) }
  if dx < -0.0001 { t = Math.min(t, (v.x0 + margin - v.ax) / dx) }
  if dy > 0.0001 { t = Math.min(t, (v.y0 + v.h - margin - v.ay) / dy) }
  if dy < -0.0001 { t = Math.min(t, (v.y0 + margin - v.ay) / dy) }
  t = Math.max(t, 0.0)
  v.rim_x = v.ax + dx * t
  v.rim_y = v.ay + dy * t
}

# the square tiles of `tile` metres (a grid whose corner is at (ox, oz)) the window can show: their first and last column and row
# into out[0..4] (tx0, tz0, tx1, tz1). A turned window's box: a tile in it may still miss the window, never one outside it
export function minimap_rv_tiles(v: MinimapRotView, tile: float, ox: float, oz: float, out: []int) -> void {
  out[0] = int(Math.floor((v.bx0 - ox) / tile))
  out[1] = int(Math.floor((v.bz0 - oz) / tile))
  out[2] = int(Math.floor((v.bx1 - ox) / tile))
  out[3] = int(Math.floor((v.bz1 - oz) / tile))
}
