# kept.ludic - the one push a frame may make: into a list the pool or the state keeps and clears,
# which grows to the most it has held and stays there
function ui_kept<T>(xs: []T, v: T) -> void {
  @alloc_ok("a kept list: cleared and filled again, it grows to the most it has held once")
  push(xs, v)
}
# a blank Value made into a kept list (a pool's or a ring's) the first time it is that long, and handed out
@alloc_ok("a pool miss: past the most Values a screen or the ring has had, then kept")
function ui_kept_val(xs: []Val) -> Val {
  pl_load()
  let v = Value.null()
  push(xs, v)
  return v
}
# a pool's Values past its most: a stretch made at once (half again, 16 at least), so a screen reaches
# its most in a few loads rather than one a Value; the first new one handed out
@alloc_ok("a pool miss: past the most Values a screen has had, a stretch made and kept")
function ui_kept_vals(xs: []Val) -> Val {
  pl_load()
  let at = len(xs)
  for i in 0 .. Math.max(16, at / 2) { push(xs, Value.null()) }
  return xs[at]
}
