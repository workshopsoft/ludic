# controls_build.ludic - a control's parts, made as plain child boxes a stylesheet can style:
#   input[type=checkbox|radio]  .ui-label  .ui-track > .ui-knob
#   input[type=range]           .ui-label  .ui-track > .ui-fill, .ui-thumb   .ui-value
#   input[type=text|number|key] .ui-label  .ui-field > .ui-value (+ .ui-caret while focused)
#   select                      .ui-label  .ui-prev  .ui-value  .ui-next   (its <option>s hidden)
# with a note="...", the label is .ui-labels > .ui-label + .ui-note
function ct_part(ui_st: mut UiState, n: UiNode, cls: string, text: string) -> UiNode {
  let p = nd_take(ui_st)
  p.key = mm_join(ui_st, n.key, "/", cls)
  p.hovered = fr_was_hovered(ui_st, p.key)     # a part answers :hover as an element does (a select's < and >)
  p.tag = "span"
  p.env = n.env
  p.sheet = n.sheet
  ui_kept(p.classes, cls)
  if text != "" {
    p.kind = UI_TEXT
    p.text = text
  }
  return p
}
# <progress value max> and <meter value min max>: a track with a fill as far as the value
function ct_build_bar(ui_st: mut UiState, n: UiNode) -> void {
  n.dir = UI_ROW
  let lo = ui_attr_float(n, "min", 0.0)
  var hi = ui_attr_float(n, "max", 0.0)
  if hi <= lo { hi = lo + 1.0 }
  let fill = ct_part(ui_st, n, "ui-fill", "")
  fill.w_pct = Math.clamp((ui_attr_float(n, "value", 0.0) - lo) / (hi - lo), 0.0, 1.0) * 100.0
  ui_kept(n.children, fill)
}
function ct_build(ui_st: mut UiState, n: UiNode) -> void {
  if n.tag == "progress" or n.tag == "meter" {
    ct_build_bar(ui_st, n)
    return
  }
  n.dir = UI_ROW
  n.focusable = true
  let t = ui_attr_text(n, "type")
  if n.tag == "select" {
    ct_build_select(ui_st, n)
    return
  }
  ct_label(ui_st, n)
  if t == "checkbox" or t == "radio" {
    let track = ct_part(ui_st, n, "ui-track", "")
    ui_kept(track.children, ct_part(ui_st, n, "ui-knob", ""))
    ui_kept(n.children, track)
  } else if t == "range" {
    ct_build_range(ui_st, n)
  } else if t == "text" {
    ui_kept(n.children, ct_build_text(ui_st, n))
    if ui_st.tx_menu_key == n.key { ui_kept(n.children, ct_build_menu(ui_st, n)) }
  } else {
    let field = ct_part(ui_st, n, "ui-field", "")
    ui_kept(field.children, ct_part(ui_st, n, "ui-value", ct_field_text(ui_st, n)))
    if ui_st.fc_key == n.key and t != "key" { ui_kept(field.children, ct_part(ui_st, n, "ui-caret", "")) }
    ui_kept(n.children, field)
  }
}
function ct_build_range(ui_st: mut UiState, n: UiNode) -> void {
  let lo = ui_attr_float(n, "min", 0.0)
  var hi = ui_attr_float(n, "max", 0.0)
  if hi <= lo { hi = lo + 1.0 }
  let v = ui_attr_float(n, "value", 0.0)
  let track = ct_part(ui_st, n, "ui-track", "")
  let fill = ct_part(ui_st, n, "ui-fill", "")
  fill.w_pct = Math.clamp((v - lo) / (hi - lo), 0.0, 1.0) * 100.0
  ui_kept(track.children, fill)
  ui_kept(track.children, ct_part(ui_st, n, "ui-thumb", ""))
  ui_kept(n.children, track)
  ui_kept(n.children, ct_part(ui_st, n, "ui-value", ct_value_shown(ui_st, n)))
}
# which option the select's value names: an option's value="...", else its place
function ct_option_at(n: UiNode, opts: []UiNode) -> int {
  let nv = ui_attr(n, "value")
  if ct_numeric(nv) { return ct_option_num(nv, opts) }
  let v = ui_attr_text(n, "value")
  for i in 0 .. len(opts) {
    let ov = ui_attr_text(opts[i], "value")
    if ov == v or (ov == "" and ct_is_int(v, i)) { return i }
  }
  return -1
}
function ct_field_text(ui_st: mut UiState, n: UiNode) -> string {
  let t = ui_attr_text(n, "type")
  if t == "key" { return ct_key_text(ui_st, n) }
  if t == "number" { return ct_num_shown(ui_st, n) }
  return ui_attr_text(n, "value")
}

# a number held by a select (the usual case: a setting's value) matched as a number: its text was
# made every frame for every select on screen. An option with no value of its own is its index
function ct_numeric(v: Val) -> bool { return Value.kind(v) == 1 or Value.kind(v) == 7 }
function ct_option_num(nv: Val, opts: []UiNode) -> int {
  let x = Value.as_float(nv)
  for i in 0 .. len(opts) {
    if not ui_attr_has(opts[i], "value") {
      if x == float(i) { return i }
      continue
    }
    let ov = ui_attr(opts[i], "value")
    if Value.kind(ov) == 0 and x == float(i) { return i }
    if ct_numeric(ov) and Value.as_float(ov) == x { return i }
    if Value.kind(ov) == 4 and el_num(Value.as_str(ov)) == x and len(Value.as_str(ov)) > 0 { return i }
  }
  return -1
}

# a text field: its value from the first letter (no gap before it), split where the caret and the selection are while it has the focus -
# .ui-pre, the selected .ui-sel, .ui-post - with the .ui-caret between them (.ui-caret-off while its blink is off); empty, its
# placeholder="..." as .ui-placeholder after the caret
function ct_build_text(ui_st: mut UiState, n: UiNode) -> UiNode {
  let field = ct_part(ui_st, n, "ui-field", "")
  let s = ui_attr_text(n, "value")
  let focused = ui_st.fc_key == n.key
  if s == "" {
    if focused { ui_kept(field.children, ct_caret(ui_st, n)) }
    let ph = ui_attr_text(n, "placeholder")
    if ph != "" { ui_kept(field.children, ct_part(ui_st, n, "ui-placeholder", ph)) }
    return field
  }
  if not focused {
    ui_kept(field.children, ct_part(ui_st, n, "ui-pre", s))
    return field
  }
  let c = tx_caret(ui_st, n, s)
  let a = tx_anchor(ui_st, n, s)
  let lo = Math.min(c, a)
  let hi = Math.max(c, a)
  if lo > 0 { ui_kept(field.children, ct_part(ui_st, n, "ui-pre", ct_piece(ui_st, s, 0, lo))) }
  if c == lo { ui_kept(field.children, ct_caret(ui_st, n)) }
  if hi > lo { ui_kept(field.children, ct_part(ui_st, n, "ui-sel", ct_piece(ui_st, s, lo, hi))) }
  if c == hi and hi > lo { ui_kept(field.children, ct_caret(ui_st, n)) }
  if hi < len(s) { ui_kept(field.children, ct_part(ui_st, n, "ui-post", ct_piece(ui_st, s, hi, len(s)))) }
  return field
}
function ct_caret(ui_st: mut UiState, n: UiNode) -> UiNode {
  if tx_blink_on(ui_st) { return ct_part(ui_st, n, "ui-caret", "") }
  return ct_part(ui_st, n, "ui-caret-off", "")
}
# a piece of a field's value as the memo keeps it (a node keeps its text: a slice made each frame would be kept each frame)
@alloc_ok("a memo miss: once per piece of a value as the caret splits it, bounded by MM_CAP")
function ct_piece(ui_st: mut UiState, s: string, a: int, b: int) -> string { return mm_join(ui_st, s[a..b], "", "") }
# a text field's right-click menu: .ui-menu at the pointer (fixed, over everything), an item each, .ui-mi-off when it cannot be chosen now
function ct_build_menu(ui_st: mut UiState, n: UiNode) -> UiNode {
  let m = ct_part(ui_st, n, "ui-menu", "")
  m.pos = 3
  m.left = ui_st.tx_menu_x
  m.top = ui_st.tx_menu_y
  m.z = 950
  for k in 0 .. TXM_N {
    let it = ct_part(ui_st, n, TXM_CLASSES[k], TXM_LABELS[k])
    ui_kept(it.classes, "ui-mi")
    if not tx_menu_ok(ui_st, n, k) { ui_kept(it.classes, "ui-mi-off") }
    ui_kept(m.children, it)
  }
  return m
}
