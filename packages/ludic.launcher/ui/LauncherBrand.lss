/* LauncherBrand.lss */
.brand { gap: 8px }
.logo { max-width: 100%; max-height: 160px; object-fit: contain }
.title { font-size: 72px; letter-spacing: 2px; color: var(--lc-text, #e9edf2); text-fit: shrink 24px }
.tagline { font-size: 14px; letter-spacing: 3px; text-transform: uppercase; color: var(--lc-secondary, #7fb2d9) }
