/* LauncherCrash.lss */
.crash { gap: 8px; padding: 12px 16px; background: var(--lc-panel, #161c25); border: 2px solid var(--lc-bad, #eb5757) }
.crash h3 { color: var(--lc-bad, #eb5757); font-size: 18px }
.summary { color: var(--lc-muted, #98a3b3); font-size: 14px; text-fit: shrink 11px }
.acts { gap: 8px; justify-content: flex-end }
.crash button { height: 36px; padding: 0 14px; background: var(--lc-line, #2b3441); color: var(--lc-text, #e9edf2) }
.crash button:focus-visible { outline: 3px solid var(--lc-accent, #e8b04a) }
.report { background: var(--lc-bad, #eb5757) }
