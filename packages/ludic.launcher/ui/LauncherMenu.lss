/* LauncherMenu.lss - a stack of wide buttons, the primary one in the accent */
.menu { gap: 8px }
.entry { width: 320px; height: 48px; padding: 0 24px; gap: 12px; align-items: center; font-size: 16px; letter-spacing: 2px; text-transform: uppercase; border-radius: var(--lc-radius, 6px); background: var(--lc-panel, #161c25); color: var(--lc-text, #e9edf2); border: 1px solid var(--lc-line, rgba(255,255,255,0.12)) }
.entry:hover { border-color: var(--lc-accent, #e8b04a); color: var(--lc-accent, #e8b04a) }
.entry:focus-visible { outline: 3px solid var(--lc-accent, #e8b04a) }
.entry:disabled { opacity: 0.4 }
.entry.primary { height: 56px; font-size: 18px; background: var(--lc-accent, #e8b04a); color: var(--lc-ink, #0c0f14); border-color: var(--lc-accent, #e8b04a) }
.icon { width: 24px; height: 24px }
