<section class="news {full ? 'full' : ''}">
  <row class="head">
    <h2 class="grow">{t('launcher.news.title')}</h2>
    <if test="{full}"><button class="close" autofocus on-click="back()">{t('launcher.news.back')}</button></if>
  </row>
  <if test="{len(items) == 0 and loading}"><p class="empty">{t('launcher.news.loading')}</p></if>
  <if test="{len(items) == 0 and not loading}"><p class="empty">{t('launcher.news.empty')}</p></if>
  <scroll class="list">
    <each in="{items}" as="it" index="i">
      <if test="{full or i < limit}">
        <article class="story {open == i ? 'open' : ''}">
          <button class="line" on-click="toggle(i)">
            <if test="{it.tag != ''}"><span class="chip">{it.tag}</span></if>
            <span class="name grow">{it.title}</span>
            <small class="date">{it.date}</small>
          </button>
          <if test="{open == i}">
            <div class="more">
              <if test="{it.image != ''}"><img class="pic" src="{it.image}"/></if>
              <p class="body">{it.body}</p>
              <if test="{it.link}"><button class="read" on-click="read(i)">{t('launcher.news.read')}</button></if>
            </div>
          </if>
        </article>
      </if>
    </each>
  </scroll>
</section>
