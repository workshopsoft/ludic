/* LauncherScreen.lss - the page; the parts style themselves. The shade is the root's own background: ludic.ui paints positioned children after in-flow ones, so a veil child would land on top of the content. */
@import "theme.lss";
.launcher { width: fill; height: fill; background: linear-gradient(to right, #0b0f14, #121a24 60%, #1b2634); color: var(--lc-text) }
.bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover }
.page { width: fill; height: fill; padding: 48px; gap: var(--lc-gap) }
.cols { flex-grow: 1; gap: 48px }
.left { width: 420px; gap: 24px; justify-content: center }
.right { flex-grow: 1; gap: var(--lc-gap); justify-content: flex-end; align-items: end }
.art { max-height: 50%; object-fit: contain }
.overlay { width: 640px; max-height: 80%; padding: 24px; background: var(--lc-panel); border: 1px solid var(--lc-line); border-radius: var(--lc-radius, 6px) }
@media (max-width: 1000px) {
  .page { padding: 24px }
  .cols { flex-direction: column; gap: 24px }
  .left { width: fill }
}
