# weather_data_test.ludic - the sky from the game's data: WeatherKinds and WeatherSettings rows read from
# .lres files stand in for the list and the wind a game used to hand in, the rows run the same spells,
# a row that says nothing has the record's defaults, and handing a list in by code still wins
import "ludic.weather"
import "ludic.base"
program WeatherDataTest {
  numbers float
  def WeatherKinds from "kinds.lres"
  def WeatherSettings from "settings.lres"

  state WeatherDataTestState {
    hours: float = 12.0
  }
  function fake_hours(weather_data_test_st: WeatherDataTestState) -> float { return weather_data_test_st.hours }
  function fake_seed() -> int { return 7 }
  bind WeatherWorld {
    hours: fn fake_hours
    seed: fn fake_seed
  }

  function step(weather_st: mut WeatherState, dt: float, gh: float, n: int) -> void { for i in 0 .. n { weather_run(weather_st, dt, gh) } }

  test "the rows are the kinds, in file order, with their numbers" (weather_st: mut WeatherState) {
    expect_eq(WK_COUNT, 4)
    expect_eq(weather_kind_count(weather_st), 4)
    expect_eq(WK_CLEAR, 0)
    expect_eq(WK_RAIN, 1)
    expect_eq(WK_STORM, 2)
    let rain = weather_kind(weather_st, WK_RAIN)
    expect(rain.key == "rain")
    expect(rain.wet and not rain.clear and not rain.thunder)
    expect(rain.cold == 5.0 and rain.wind == 1.0)
    expect(weather_kind(weather_st, WK_STORM).thunder)
    expect_eq(len(rain.odds), 3)
  }

  test "a row that says nothing has the defaults, and the record's numbers are sane" (weather_st: mut WeatherState) {
    let mild = weather_kind(weather_st, WK_MILD)
    expect(not mild.clear and not mild.wet and not mild.thunder)
    expect(mild.soak == 0.0 and mild.overcast == 0.0 and mild.cold == 0.0)
    expect(mild.wind == 0.2 and mild.wind_dir < 0.0)
    expect(mild.spell_lo == 2.0 and mild.spell_hi == 8.0 and mild.spell_lo < mild.spell_hi)
    expect(mild.odds == null)
  }

  test "a trip starts on the first clear row, and the spells follow the rows' odds" (weather_st: mut WeatherState) {
    weather_reset(weather_st)
    expect_eq(weather_state(weather_st), WK_CLEAR)
    expect(not weather_wet(weather_st))
    weather_set(weather_st, WK_CLEAR, WK_RAIN, 0.1)
    step(weather_st, 0.1, 0.2, 1)
    expect_eq(weather_state(weather_st), WK_RAIN)
    expect_eq(weather_next(weather_st), WK_STORM)
    step(weather_st, 0.1, 0.0, 200)
    expect(weather_wet(weather_st))
    expect(weather_cold(weather_st) > 4.0)
    weather_set(weather_st, WK_STORM, WK_CLEAR, 2.0)
    step(weather_st, 1.0, 0.0, 60)
    expect(count_thunder(weather_st) > 0)
  }

  function count_thunder(weather_st: mut WeatherState) -> int {
    let fs = q_drain(weather_facts(weather_st))
    var n = 0
    for i in 0 .. len(fs) { if fs[i].what == WEATHER_THUNDER { n += 1 } }
    return n
  }

  test "the valley's wind turns from the settings row" (weather_st: mut WeatherState, weather_data_test_st: mut WeatherDataTestState) {
    weather_reset(weather_st)
    weather_data_test_st.hours = 3.0
    step(weather_st, 1.0, 0.0, 100)
    expect(Math.abs(weather_dir(weather_st) - 0.5) < 0.01)
    weather_data_test_st.hours = 12.0
    step(weather_st, 1.0, 0.0, 100)
    expect(Math.abs(weather_dir(weather_st) - 2.5) < 0.01)
  }

  test "the old way still works: a list handed in replaces the rows, a wind set in code replaces the row's" (weather_st: mut WeatherState, weather_data_test_st: mut WeatherDataTestState) {
    let ks = new []WeatherKind
    let only = new WeatherKind
    only.clear = true
    push(ks, only)
    weather_kinds(weather_st, ks)
    expect_eq(weather_kind_count(weather_st), 1)
    weather_config_wind(weather_st, 1.0, 1.0, 10.0, 19.0)
    weather_reset(weather_st)
    weather_data_test_st.hours = 3.0
    step(weather_st, 1.0, 0.0, 100)
    expect(Math.abs(weather_dir(weather_st) - 1.0) < 0.01)
  }
}
