# weather_sun_test.ludic - a game with a sun says when the slopes are warm: the wind blows up the valley then,
# whatever the clock says and whatever hours the settings row holds
import "ludic.weather"
import "ludic.base"
program WeatherSunTest {
  numbers float
  def WeatherKinds from "kinds.lres"
  def WeatherSettings from "settings.lres"

  state WeatherSunTestState {
    hours: float = 12.0
    warm: bool = false
  }
  function fake_hours(weather_sun_test_st: WeatherSunTestState) -> float { return weather_sun_test_st.hours }
  function fake_warm(weather_sun_test_st: WeatherSunTestState) -> bool { return weather_sun_test_st.warm }
  function fake_seed() -> int { return 7 }
  bind WeatherWorld {
    hours: fn fake_hours
    wind_up: fn fake_warm
    seed: fn fake_seed
  }

  function step(weather_st: mut WeatherState, n: int) -> void { for i in 0 .. n { weather_run(weather_st, 1.0, 0.0) } }

  test "the wind goes up the valley when the game says the slopes are warm, not at the row's hours" (weather_st: mut WeatherState, weather_sun_test_st: mut WeatherSunTestState) {
    weather_reset(weather_st)
    weather_sun_test_st.hours = 3.0
    weather_sun_test_st.warm = true
    step(weather_st, 100)
    expect(Math.abs(weather_dir(weather_st) - 2.5) < 0.01)
    weather_sun_test_st.hours = 12.0
    weather_sun_test_st.warm = false
    step(weather_st, 100)
    expect(Math.abs(weather_dir(weather_st) - 0.5) < 0.01)
  }
}
