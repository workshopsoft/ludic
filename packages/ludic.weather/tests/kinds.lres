# kinds.lres - the test's sky: clear always goes to rain, rain to a storm, a storm to clear
clear {
  clear: true
  spell_lo: 1.0, spell_hi: 3.0
  odds: [0.0, 1.0, 0.0]
}
rain {
  wet: true
  soak: 1.0, overcast: 0.8, cold: 5.0, wind: 1.0
  spell_lo: 1.0, spell_hi: 3.0
  odds: [0.0, 0.0, 1.0]
}
storm {
  wet: true, thunder: true
  soak: 1.0, overcast: 1.0, cold: 6.0, wind: 1.0
  spell_lo: 1.0, spell_hi: 3.0
  odds: [1.0, 0.0, 0.0]
}
# a kind that says nothing: every default
mild { }
