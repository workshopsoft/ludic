    expect(hit > 50)
    sim(crowd_st, m, s, 1.5, 0.1)
    expect((s.reacted_to & (1 << int(PedReact.Panic))) != 0)
    expect(count_react(crowd_st, int(PedReact.Calm)) < crowd_count(crowd_st) * 7 / 10)
    expect_eq(s.n_report, 0)
    sim(crowd_st, m, s, 40.0, 0.1)
    expect(count_react(crowd_st, int(PedReact.Calm)) >= crowd_count(crowd_st) - 3)
    expect(s.n_react > 50)
  }

