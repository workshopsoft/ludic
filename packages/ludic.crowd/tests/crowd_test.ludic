  test "a client copies the host: a delta a message, peds that left are told, and a silent one is let go" (crowd_st: mut CrowdState, m: mut CrowdStepsMachine, zones: mut PopulationZones, scen: mut PedScenarios, s: mut CrowdTestState) {
    fresh(crowd_st, zones, scen)
    crowd_prime(crowd_st)
    let client = crowd_new()
    crowd_reset(client)
    crowd_role(client, CROWD_CLIENT)
    let buf = words(0)
    let gone = words(0)
    var last = -1
    # the first message: everybody within the sync radius
    var n = crowd_sync_out(crowd_st, last, 0.0, 0.0, buf)
    last = crowd_sync_mark(crowd_st)
    expect(n > 50)
    let sr = crowd_config(crowd_st).sync_r
    crowd_sync_in(client, buf, n)
    expect_eq(crowd_count(client), n)
    # a puppet knows what the host knows of it
    for i in 0 .. crowd_count(client) {
      let u = crowd_ped_at(client, i)
      expect(crowd_alive(crowd_st, u))
      expect(near(crowd_x(client, u), crowd_x(crowd_st, u), 0.04))
      expect(near(crowd_z(client, u), crowd_z(crowd_st, u), 0.04))
      expect_eq(crowd_type(client, u), crowd_type(crowd_st, u))
      expect_eq(crowd_look(client, u), crowd_look(crowd_st, u))
      expect_eq(crowd_lod(client, u), CROWD_PUPPET)
    }
    # later messages carry only what changed: a FAR ped is written about once a second, a FULL one every tick
    sim(crowd_st, m, s, 0.2, 0.1)
    n = crowd_sync_out(crowd_st, last, 0.0, 0.0, buf)
    let m1 = crowd_sync_gone(crowd_st, last, gone)
    last = crowd_sync_mark(crowd_st)
    expect(n < crowd_count(crowd_st))
    expect(n > 0)
    crowd_sync_in(client, buf, n)
    crowd_sync_in_gone(client, gone, m1)
    # the host kills one: the next message says so
    let victim = crowd_ped_at(crowd_st, 3)
    expect(crowd_alive(client, victim))
    crowd_remove(crowd_st, victim)
    n = crowd_sync_out(crowd_st, last, 0.0, 0.0, buf)
    let m2 = crowd_sync_gone(crowd_st, last, gone)
    expect_eq(m2, 1)
    expect_eq(gone[0], victim)
    last = crowd_sync_mark(crowd_st)
    crowd_sync_in(client, buf, n)
    crowd_sync_in_gone(client, gone, m2)
    expect(not crowd_alive(client, victim))
    # a reaction rides along
    let a = ped_of_type(crowd_st, PEDT_COMMUTER, 0.0, 0.0)
    crowd_threat(crowd_st, CTHR_BLAST, crowd_x(crowd_st, a), crowd_z(crowd_st, a), 1)
    sim(crowd_st, m, s, 0.5, 0.1)
    n = crowd_sync_out(crowd_st, last, 0.0, 0.0, buf)
    last = crowd_sync_mark(crowd_st)
    crowd_sync_in(client, buf, n)
    expect(crowd_react(client, a) > 0)
    expect_eq(crowd_react(client, a), crowd_react(crowd_st, a))
    # the client's own frames move the puppets between messages and let go of the silent after the ttl
    let c = crowd_ped_at(client, 0)
    let x0 = crowd_x(client, c)
    var t = 0.0
    while t < 0.5 {
      crowd_tick(client, m, tick_new(0.05, 1, 12.0))
      t += 0.05
    }
    expect(crowd_count(client) > 0)
    t = 0.0
    while t < 6.0 {
      crowd_tick(client, m, tick_new(0.1, 1, 12.0))
      t += 0.1
    }
    expect_eq(crowd_count(client), 0)
    expect(sr > 0.0)
    expect(x0 == x0)
  }

  test "the save keeps the clock and the empty places of the dead; the people are the seed's" (crowd_st: mut CrowdState, m: mut CrowdStepsMachine, zones: mut PopulationZones, scen: mut PedScenarios, s: mut CrowdTestState) {
    fresh(crowd_st, zones, scen)
    crowd_prime(crowd_st)
    let a = crowd_ped_at(crowd_st, 0)
    crowd_kill(crowd_st, a)
    sim(crowd_st, m, s, 5.0, 0.1)
    let v = crowd_save(crowd_st)
    let t = crowd_time(crowd_st)
    crowd_load(crowd_st, v, 1)
    expect(near(crowd_time(crowd_st), t, 0.01))
    expect_eq(crowd_count(crowd_st), 0)
    expect(load_town(crowd_st, zones, scen))
    crowd_prime(crowd_st)
    expect(not crowd_alive(crowd_st, a))
  }

  test "an identity is embodied: it walks its leg, arrives, is left standing, and is handed back where it got to" (crowd_st: mut CrowdState, m: mut CrowdStepsMachine, zones: mut PopulationZones, scen: mut PedScenarios, s: mut CrowdTestState) {
    fresh(crowd_st, zones, scen)
    crowd_prime(crowd_st)
    let before = crowd_count(crowd_st)
    let uid = crowd_embody(crowd_st, 9001, PEDT_COMMUTER, 5, 10.0, 10.0, 0.0, true, 10.0, 40.0, CROWD_WALK, "errand", 0.0)
    expect(uid != 0)
    expect_eq(crowd_embody(crowd_st, 9001, PEDT_COMMUTER, 5, 10.0, 10.0, 0.0, false, 0.0, 0.0, CROWD_STAND, "", 0.0), 0)
    expect_eq(crowd_count(crowd_st), before + 1)
    expect_eq(crowd_look(crowd_st, uid), 5)
    expect_eq(crowd_ext_of(crowd_st, uid), 9001)
    expect_eq(crowd_uid_of(crowd_st, 9001), uid)
    expect_eq(crowd_ext_of(crowd_st, crowd_ped_at(crowd_st, 0)) >= -1, true)
    sim(crowd_st, m, s, 40.0, 0.1)
    expect_eq(s.n_embodied, 1)
    expect_eq(s.n_arrived, 1)
    expect(crowd_alive(crowd_st, uid))
    expect(dist(crowd_x(crowd_st, uid), crowd_z(crowd_st, uid), 10.0, 40.0) < 1.0)
    expect_eq(crowd_anim_key(crowd_st, uid), "errand")
    expect_eq(crowd_anim_set(crowd_st, uid), "walker")
    # the next leg, then a hand-back in the middle of it
    expect(crowd_set_leg(crowd_st, 9001, true, 10.0, -30.0, CROWD_WALK, "home", 0.0))
    sim(crowd_st, m, s, 4.0, 0.1)
    expect(crowd_release(crowd_st, 9001))
    let h = crowd_handoff(crowd_st)
    expect(h.found)
    expect(h.has_dest)
    expect(not h.arrived)
    expect(h.z < 40.0 and h.z > -30.0)
    expect(h.dest_z == -30.0)
    expect_eq(h.key, "home")
    expect(not crowd_alive(crowd_st, uid))
    expect_eq(crowd_uid_of(crowd_st, 9001), 0)
    expect(not crowd_release(crowd_st, 9001))
    drain(crowd_st, s)
    expect_eq(s.n_handback, 1)
  }

  test "an embodied ped is never culled, and it reacts: a blast makes it flee; killed, it reports its loss" (crowd_st: mut CrowdState, m: mut CrowdStepsMachine, zones: mut PopulationZones, scen: mut PedScenarios, s: mut CrowdTestState) {
    fresh(crowd_st, zones, scen)
    crowd_prime(crowd_st)
    let uid = crowd_embody(crowd_st, 7, PEDT_COMMUTER, -1, 0.0, 30.0, 0.0, false, 0.0, 0.0, CROWD_STAND, "idle", 0.0)
    crowd_threat(crowd_st, CTHR_BLAST, 0.0, 30.0, 1)
    sim(crowd_st, m, s, 3.0, 0.1)
    expect(crowd_react(crowd_st, uid) != int(PedReact.Calm))
    # the players leave for a long time: the anonymous go, the owned body stays
    s.px = 250.0
    s.pz = -250.0
    sim(crowd_st, m, s, 30.0, 0.1)
    expect(crowd_alive(crowd_st, uid))
    s.n_handback = 0
    expect(crowd_kill(crowd_st, uid))
    drain(crowd_st, s)
    expect_eq(s.n_handback, 1)
    expect_eq(crowd_uid_of(crowd_st, 7), 0)
  }

  test "the graph is given parameters and keys, never a pose: speed, turn, reaction, and the act's state key as a fact" (crowd_st: mut CrowdState, m: mut CrowdStepsMachine, zones: mut PopulationZones, scen: mut PedScenarios, s: mut CrowdTestState) {
