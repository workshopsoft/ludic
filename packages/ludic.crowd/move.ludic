# move.ludic - what a ped does between reactions: its schedule's acts, walking where the nav port says,
# the scenarios it goes to and uses, the friends it walks with. The tier decides how often and how well:
# FULL steers every tick (avoiding the people near it, waiting at crossings), MID a few times a second
# along the way, FAR a step a second

# read the players and the hour from the world, into lists the crowd keeps
function cw_sense(crowd_st: mut CrowdState) -> void {
  var n = CrowdWorld.players()
  if n > 64 { n = 64 }
  var k = 0
  for i in 0 .. n {
    if not CrowdWorld.player_on(i) { continue }
    if k < len(crowd_st.cw_pl_x) {
      crowd_st.cw_pl_x[k] = CrowdWorld.player_x(i)
      crowd_st.cw_pl_z[k] = CrowdWorld.player_z(i)
    } else {
      kept_push(crowd_st.cw_pl_x, CrowdWorld.player_x(i))
      kept_push(crowd_st.cw_pl_z, CrowdWorld.player_z(i))
    }
    k += 1
  }
  crowd_st.cw_pl_n = k
  crowd_st.cw_hour = CrowdWorld.hour()
  crowd_st.cw_day = CrowdWorld.day()
}

function cw_roll(p: CrowdPed, salt: int) -> float {
  p.seq += 1
  return cw_unit(crowd_hash(p.uid, p.seq, salt))
}

function cw_set_pos(crowd_st: mut CrowdState, p: CrowdPed, row: int, x: float, z: float) -> void {
  p.x = x
  p.z = z
  tb_set_xz(crowd_st.cw_tab, 0, 1, row, x, z)
}

# ---- scenarios --------------------------------------------------------------------------------

function cw_leave_scenario(crowd_st: mut CrowdState, p: CrowdPed) -> void {
  if p.scn < 0 { return }
  if p.scn < crowd_st.cw_sn {
    crowd_st.cw_sn_use[p.scn] = Math.max(0, crowd_st.cw_sn_use[p.scn] - 1)
    if p.place >= 0 and p.place < 30 and (crowd_st.cw_sn_held[p.scn] & (1 << p.place)) != 0 { crowd_st.cw_sn_held[p.scn] -= 1 << p.place }
    if p.scn_used {
      p.last_scn = p.scn
      let f = cw_fact(crowd_st, CROWD_USING, p.uid)
      f.crime = p.scn
      f.count = 0
      f.x = p.x
      f.z = p.z
    }
  }
  p.scn = -1
  p.scn_used = false
  p.place = -1
  p.leaving = false
}

# the first free place of scenario i (its places are taken one a user: a leaver's is free again, whoever else still sits), held for p
function cw_take_place(crowd_st: mut CrowdState, p: CrowdPed, i: int) -> int {
  let cap = Math.min(crowd_st.cw_sn_cap[i], 30)
  let held = crowd_st.cw_sn_held[i]
  for k in 0 .. cap {
    if (held & (1 << k)) == 0 {
      crowd_st.cw_sn_held[i] = held | (1 << k)
      p.place = k
      return k
    }
  }
  p.place = -1
  return Math.max(0, crowd_st.cw_sn_use[i] - 1)
}

# where a user of scenario i stands: an area's hashed point, else along the facing's right by its place
# a talk in an area (a court's middle, a bar's door) is a conversation's circle (Kendon's F-formation: everyone on a ring round the
# shared middle, facing it): the places go round it in the order that keeps the first ones opposite (two face each other, a third
# makes a T, a fourth a square), on a ring that grows with the room (two 1.3 m apart, six 2.1 m across: friends' personal distance)
function cw_ring_turn(place: int) -> float {
  let k = place % 8
  if k == 1 { return 0.5 }
  if k == 2 { return 0.25 }
  if k == 3 { return 0.75 }
  if k == 4 { return 0.125 }
  if k == 5 { return 0.625 }
  if k == 6 { return 0.375 }
  if k == 7 { return 0.875 }
  return 0.0
}
# only an open area (a court's middle) is ringed: a small one by a wall (a bar's door) may have half its ring in the wall, so its talkers
# keep their hashed points in it (each still facing its middle, cw_arrive)
const CW_RING_ROOM: float = 2.0
function cw_ring_r(crowd_st: CrowdState, i: int) -> float {
  return Math.min(crowd_st.cw_sn_r[i], 0.45 + 0.1 * float(crowd_st.cw_sn_cap[i]))
}
function cw_spot(crowd_st: CrowdState, p: CrowdPed, i: int, place: int) -> void {
  let r = crowd_st.cw_sn_r[i]
  var x = crowd_st.cw_sn_x[i]
  var z = crowd_st.cw_sn_z[i]
  if r >= CW_RING_ROOM and crowd_st.cw_sn_act[i] == CROWD_TALK and place >= 0 {
    let a = cw_ring_turn(place) * 6.2831853 + crowd_st.cw_sn_yaw[i]
    let d = cw_ring_r(crowd_st, i)
    x += Math.sin(a) * d
    z += Math.cos(a) * d
  } else if r > 0.0 and r < CW_RING_ROOM and place >= 0 {
    # a small area (two smokers at a back door, a bar's door): its places side by side 0.7 m apart across its facing, centred on it -
    # two hashed points there could be the same spot (two bodies in one)
    let y = crowd_st.cw_sn_yaw[i]
    let off = Math.clamp((float(place) - float(crowd_st.cw_sn_cap[i] - 1) * 0.5) * 0.7, -r, r)
    x += Math.cos(y) * off
    z -= Math.sin(y) * off
  } else if r > 0.0 {
    let a = cw_unit(crowd_hash(p.uid, place, 61)) * 6.2831853
    let d = r * Math.sqrt(cw_unit(crowd_hash(p.uid, place, 62)))
    x += Math.sin(a) * d
    z += Math.cos(a) * d
  } else {
    let y = crowd_st.cw_sn_yaw[i]
    let off = (float(place) - float(crowd_st.cw_sn_cap[i] - 1) * 0.5) * 0.7
    x += Math.cos(y) * off
    z -= Math.sin(y) * off
  }
  p.dest_x = x
  p.dest_z = z
}

# ---- the schedule -----------------------------------------------------------------------------

# is slot k open at the hour, on today's kind of day (rows without a day: every day)
function cw_slot_open(crowd_st: CrowdState, k: int, hour: float) -> bool {
  let d = crowd_st.cw_sl_days[k]
  if d == 1 and crowd_st.cw_day != 0 { return false }
  if d == 2 and crowd_st.cw_day != 1 { return false }
  return cw_in_hours(hour, crowd_st.cw_sl_from[k], crowd_st.cw_sl_to[k])
}

# a tag's place in the interned list, none made (frame code): -1 for one nothing has
function cw_find_tag(crowd_st: CrowdState, tag: string) -> int {
  for i in 0 .. len(crowd_st.cw_tags) { if crowd_st.cw_tags[i] == tag { return i } }
  return -1
}
# the nearest scenario of tag `name` within r of the ped; -1 none
function cw_near_named(crowd_st: CrowdState, p: CrowdPed, name: string, r: float) -> int {
  let t = cw_find_tag(crowd_st, name)
  if t < 0 { return -1 }
  return cw_scenario_near(crowd_st, p.x, p.z, r, t, crowd_st.cw_hour, -1)
}

# once, with the first act: the ped's home (lean walls, benches, windows round its first place: the roster is made round its homes)
# and its day place by role, seeded by its uid: 60% work (cafes, kiosks, smokers' doors, vending), 15% school (courts), 25% stay home
function cw_choose_places(crowd_st: mut CrowdState, p: CrowdPed) -> void {
  if p.home != -2 { return }
  let h = crowd_hash(p.uid, 1, 91) % 3
  var home = -1
  for k in 0 .. 3 {
    if home >= 0 { break }
    let m = (h + k) % 3
    if m == 0 { home = cw_near_named(crowd_st, p, "lean", 250.0) } else if m == 1 { home = cw_near_named(crowd_st, p, "bench", 250.0) } else { home = cw_near_named(crowd_st, p, "window", 250.0) }
  }
  p.home = home
  let u = float(crowd_hash(p.uid, 7, 92) & 1023) / 1024.0
  if u < 0.60 { p.role = 0 } else if u < 0.75 { p.role = 1 } else { p.role = 2 }
  p.work = -1
  if p.role == 0 {
    let w = crowd_hash(p.uid, 2, 91) % 4
    for k in 0 .. 4 {
      if p.work >= 0 { break }
      let m = (w + k) % 4
      if m == 0 { p.work = cw_near_named(crowd_st, p, "cafe", 500.0) } else if m == 1 { p.work = cw_near_named(crowd_st, p, "kiosk", 500.0) } else if m == 2 { p.work = cw_near_named(crowd_st, p, "smoke", 500.0) } else { p.work = cw_near_named(crowd_st, p, "vending", 500.0) }
    }
  }
  if p.role == 1 {
    p.work = cw_near_named(crowd_st, p, "court", 500.0)
    if p.work < 0 { p.work = cw_near_named(crowd_st, p, "bench", 500.0) }
  }
  if p.work < 0 { p.work = p.home }
}

# what to do next: a slot of the ped's schedule that covers the hour, by weight; then where
function cw_next_act(crowd_st: mut CrowdState, p: CrowdPed) -> void {
  cw_leave_scenario(crowd_st, p)
  p.has_dest = false
  p.repath = 0.0
  let ty = PedTypes[p.type]
  var sch = ty.schedule
  if sch < 0 or sch >= PEDS_COUNT { sch = -1 }
  p.act = CROWD_WALK
  if sch < 0 { return }
  let o = crowd_st.cw_sch0[sch]
  let n = crowd_st.cw_schn[sch]
  var tot = 0.0
  let hour = crowd_st.cw_hour
  for i in 0 .. n {
    if cw_slot_open(crowd_st, o + i, hour) { tot += crowd_st.cw_sl_w[o + i] }
  }
  if tot <= 0.0 { return }
  var target = cw_roll(p, 21) * tot
  var s = -1
  for i in 0 .. n {
    if not cw_slot_open(crowd_st, o + i, hour) { continue }
    s = o + i
    target -= crowd_st.cw_sl_w[o + i]
    if target < 0.0 { break }
  }
  if s < 0 { return }
  var act = crowd_st.cw_sl_act[s]
  let dur = crowd_st.cw_sl_min[s] + (crowd_st.cw_sl_max[s] - crowd_st.cw_sl_min[s]) * cw_roll(p, 22)
  let tag = crowd_st.cw_sl_tag[s]
  if act == CROWD_COMMUTE { crowd_st.cw_n_commute += 1 }
  if tag >= 0 {
    var i = -1
    var own = false
    if crowd_st.cw_homes and (crowd_st.cw_tags[tag] == "home" or crowd_st.cw_tags[tag] == "work") {
      cw_choose_places(crowd_st, p)
      own = true
      if crowd_st.cw_tags[tag] == "home" {
        i = p.home
        crowd_st.cw_n_home += 1
      } else {
        i = p.work
        if p.role == 1 { crowd_st.cw_n_school += 1 } else if p.role == 0 { crowd_st.cw_n_work += 1 } else { crowd_st.cw_n_home += 1 }
      }
    } else {
      i = cw_scenario_near(crowd_st, p.x, p.z, 80.0, tag, hour, p.last_scn)          # never straight back to the one just left
      crowd_st.cw_n_leisure += 1
    }
    if own and i < 0 { i = cw_scenario_near(crowd_st, p.x, p.z, 80.0, tag, hour, p.last_scn) }          # never straight back to the one just left
    if i >= 0 {
      crowd_st.cw_sn_use[i] += 1
      p.scn = i
      p.scn_used = false
      cw_spot(crowd_st, p, i, cw_take_place(crowd_st, p, i))
      p.has_dest = true
      p.act = CROWD_WALK
      return
    }
    # nothing to go to: the act without its place
    if act == CROWD_SIT { act = CROWD_STAND }
    if act == CROWD_SHOP { act = CROWD_WALK }
    if act == CROWD_WORK { act = CROWD_STAND }
  }
  p.act = act
  p.key = crowd_st.cw_sl_anim[s]
  if act == CROWD_STAND or act == CROWD_SIT or act == CROWD_WORK or act == CROWD_JOG {
    p.act_t = dur
  }
  if act == CROWD_SHOP { p.act = CROWD_WALK }
}

function cw_begin_life(crowd_st: mut CrowdState, p: CrowdPed) -> void {
  cw_next_act(crowd_st, p)
  # a walker starts going, heading where it was made to face
  p.speed = 0.0
}

# the next place to walk to: between the type's wander distances (three times that for a commute)
function cw_pick_dest(crowd_st: mut CrowdState, p: CrowdPed, ty: PedType) -> void {
  var lo = ty.wander_min
  var hi = ty.wander_max
  if p.act == CROWD_COMMUTE or p.act == CROWD_JOG {
    lo = lo * 3.0
    hi = hi * 3.0
  }
  let salt = crowd_hash(p.uid, p.seq + 1, 63)
  p.seq += 1
  if CrowdNav.pick(p.x, p.z, lo, hi, salt, crowd_st.cw_buf) {
    p.dest_x = crowd_st.cw_buf[0]
    p.dest_z = crowd_st.cw_buf[1]
    p.has_dest = true
    p.repath = 0.0
    p.blocked = 0.0
  } else {
    p.act = CROWD_STAND
    p.act_t = 2.0 + cw_roll(p, 23) * 4.0
  }
}

# ---- moving -----------------------------------------------------------------------------------

# one step toward (tx, tz) at `speed`. True when it is there. FULL asks for a corner often and goes round the
# people near; all tiers obey a crossing's light
function cw_move(crowd_st: mut CrowdState, p: CrowdPed, row: int, tx: float, tz: float, speed: float, dt: float) -> bool {
  return cw_move_to(crowd_st, p, row, tx, tz, speed, dt, 0.64)
}

# the same, arrived within sqrt(near2) metres
function cw_move_to(crowd_st: mut CrowdState, p: CrowdPed, row: int, tx: float, tz: float, speed: float, dt: float, near2: float) -> bool {
  let x = p.x
  let z = p.z
  let dx = tx - x
  let dz = tz - z
  if dx * dx + dz * dz < near2 {
    p.speed = 0.0
    return true
  }
  p.repath -= dt
  var gd = 0.0
  gd = (p.goal_x - x) * (p.goal_x - x) + (p.goal_z - z) * (p.goal_z - z)
  if p.repath <= 0.0 or gd < 0.5 {
    if CrowdNav.way(p.uid, x, z, tx, tz, crowd_st.cw_buf) {
      p.goal_x = crowd_st.cw_buf[0]
      p.goal_z = crowd_st.cw_buf[1]
    } else {
      p.goal_x = tx
      p.goal_z = tz
    }
    p.repath = 0.5
    if p.lod == CROWD_MID { p.repath = 1.0 }
    if p.lod == CROWD_FAR { p.repath = 0.0 }
  }
  var ux = p.goal_x - x
  var uz = p.goal_z - z
  var ul = Math.sqrt(ux * ux + uz * uz)
  if ul < 0.001 {
    p.speed = 0.0
    return true
  }
  ux = ux / ul
  uz = uz / ul
  var sp = speed
  if p.lod != CROWD_FAR {
    let lx = x + ux * 1.2
    let lz = z + uz * 1.2
    let cr = CrowdNav.crossing(lx, lz)
    if cr != 0 and CrowdNav.crossing(x, z) == 0 {
      let ok = CrowdNav.may_cross(lx, lz)
      if cr == 2 {
        let jay = cw_unit(crowd_hash(p.uid, 77, 78)) < PedTypes[p.type].jaywalk
        if not (jay and ok) {
          p.speed = 0.0
          p.has_dest = false
          p.repath = 0.0
          return false
        }
      } else if not ok and p.wait_t < 25.0 {
        p.wait_t += dt
        p.speed = 0.0
        return false
      }
    } else {
      p.wait_t = 0.0
    }
  }
  if p.lod == CROWD_FULL {
    let n = tb_within(crowd_st.cw_tab, crowd_st.cw_grid, x, z, 1.6, -1, 0, crowd_st.cw_near)
    var sx = 0.0
    var sz = 0.0
    var seen = 0
    for k in 0 .. n {
      let r2 = crowd_st.cw_near[k]
      if r2 == row { continue }
      let o = crowd_st.cw_tab.rec[r2]
      let ox = x - o.x
      let oz = z - o.z
      let d2 = ox * ox + oz * oz
      if d2 < 0.0004 {
        sx += 0.5
        seen += 1
        continue
      }
      let d = Math.sqrt(d2)
      let w = (1.6 - d) / 1.6
      sx += ox / d * w
      sz += oz / d * w
      seen += 1
      if seen >= 5 { break }
    }
    ux += sx * 1.3
    uz += sz * 1.3
    ul = Math.sqrt(ux * ux + uz * uz)
    if ul > 0.001 {
      ux = ux / ul
      uz = uz / ul
    }
  }
  let want = cw_yaw_of(ux, uz)
  if p.lod == CROWD_FULL {
    let turn = cw_turn(p.yaw, want)
    let lim = 7.0 * dt
    p.yaw += Math.clamp(turn, -lim, lim)
    let acc = 3.0 * dt
    if p.speed < sp { p.speed = Math.min(sp, p.speed + acc) } else { p.speed = Math.max(sp, p.speed - acc * 2.0) }
  } else {
    p.yaw = want
    p.speed = sp
  }
  let step = p.speed * dt
  let nx = x + Math.sin(p.yaw) * step
  let nz = z + Math.cos(p.yaw) * step
  if not CrowdNav.walkable(nx, nz) {
    p.blocked += dt
    p.speed = 0.0
    if p.blocked > 1.0 {
      p.has_dest = false
      p.repath = 0.0
      p.blocked = 0.0
    }
    return false
  }
  p.blocked = 0.0
  cw_set_pos(crowd_st, p, row, nx, nz)
  return false
}

function cw_halt(p: CrowdPed, dt: float) -> void {
  p.speed = Math.max(0.0, p.speed - 6.0 * dt)
}

function cw_face(p: CrowdPed, x: float, z: float, dt: float) -> void {
  let want = cw_yaw_of(x - p.x, z - p.z)
  let turn = cw_turn(p.yaw, want)
  let lim = 6.0 * dt
  p.yaw += Math.clamp(turn, -lim, lim)
}

# a friend of a group: its place beside the leader, a step behind
function cw_follow(crowd_st: mut CrowdState, p: CrowdPed, row: int, lrow: int, ty: PedType, dt: float) -> void {
  let l = crowd_st.cw_tab.rec[lrow]
  let m = p.member
  let side = float((m + 1) >> 1) * 0.9
  var sgn = 1.0
  if (m & 1) == 0 { sgn = -1.0 }
  let behind = 0.5 + 0.3 * float(m >> 1)
  let tx = l.x + Math.cos(l.yaw) * side * sgn - Math.sin(l.yaw) * behind
  let tz = l.z - Math.sin(l.yaw) * side * sgn - Math.cos(l.yaw) * behind
  let dx = tx - p.x
  let dz = tz - p.z
  let d = Math.sqrt(dx * dx + dz * dz)
  if d > 30.0 {
    p.lead = -1
    return
  }
  p.act = l.act
  if p.act == CROWD_USE or p.act == CROWD_TALK { p.act = CROWD_STAND }
  var sp = l.speed + Math.clamp((d - 0.7) * 1.5, 0.0, 2.0)
  if d < 0.5 and l.speed < 0.1 { sp = 0.0 }
  sp = Math.min(sp, ty.run_speed * 0.7)
  if sp <= 0.01 {
    cw_halt(p, dt)
    cw_face(p, l.x + Math.sin(l.yaw) * 2.0, l.z + Math.cos(l.yaw) * 2.0, dt)
    return
  }
  p.has_dest = true
  p.dest_x = tx
  p.dest_z = tz
  cw_move(crowd_st, p, row, tx, tz, sp, dt)
}

# ---- one ped's step ---------------------------------------------------------------------------

const CW_DWELL_MIN: float = 3.0
const CW_DWELL_MAX: float = 7.0
function cw_arrive(crowd_st: mut CrowdState, p: CrowdPed, ty: PedType) -> void {
  if p.scn >= 0 and not p.scn_used {
    p.scn_used = true
    # its very place (a seat, a spot at a wall): a walk ends within 0.8 m of its goal, and a sitter short of its bench sits on air. The
    # step is no more than that, taken while the game's graph blends into the act
    p.x = p.dest_x
    p.z = p.dest_z
    p.act = crowd_st.cw_sn_act[p.scn]
    p.key = crowd_st.cw_sn_anim[p.scn]
    p.yaw = crowd_st.cw_sn_yaw[p.scn]
    if crowd_st.cw_sn_r[p.scn] > 0.0 and p.act == CROWD_TALK {
      # in the circle: facing its middle
      let cx = crowd_st.cw_sn_x[p.scn] - p.x
      let cz = crowd_st.cw_sn_z[p.scn] - p.z
      if cx * cx + cz * cz > 0.01 { p.yaw = cw_yaw_of(cx, cz) }
    }
    p.speed = 0.0
    p.act_t = crowd_st.cw_sn_min[p.scn] + (crowd_st.cw_sn_max[p.scn] - crowd_st.cw_sn_min[p.scn]) * cw_roll(p, 24)
    if p.stay > 0.0 {
      p.act_t = p.stay
      p.stay = 0.0
    }
    let f = cw_fact(crowd_st, CROWD_USING, p.uid)
    f.crime = p.scn
    f.count = 1
    f.x = p.x
    f.z = p.z
    return
  }
  # a wanderer that reaches its destination stands there a few seconds (CW_DWELL_MIN..MAX) before it takes another
  if p.act == CROWD_WALK {
    p.has_dest = false
    p.act = CROWD_STAND
    p.speed = 0.0
    p.act_t = CW_DWELL_MIN + (CW_DWELL_MAX - CW_DWELL_MIN) * cw_roll(p, 26)
    return
  }
  # a jogger runs on to another place (the next frame picks it) until its slot's time is out: no stop between legs
  if p.act == CROWD_JOG and p.act_t > 0.0 {
    p.has_dest = false
    return
  }
  cw_next_act(crowd_st, p)
}

# an embodied identity follows its leg and nothing else: it walks to the destination it was given and stands there
# until its owner gives it another (crowd_set_leg) or takes it back
function cw_leg(crowd_st: mut CrowdState, p: CrowdPed, row: int, ty: PedType, dt: float) -> void {
  if p.has_dest {
    var sp = ty.walk_speed * p.pace
    if p.act == CROWD_COMMUTE { sp = sp * 1.2 }
    if cw_move(crowd_st, p, row, p.dest_x, p.dest_z, sp, dt) {
      p.has_dest = false
      let f = cw_fact(crowd_st, CROWD_ARRIVED, p.uid)
      f.from = p.ext
      f.x = p.x
      f.z = p.z
    }
    return
  }
  cw_halt(p, dt)
  if p.act_t > 0.0 { p.act_t -= dt }
}

# two wanderers passing within CW_CHAT_R now and then stop and face each other for 3-6 s (a cooldown follows); the talk is the idle state
const CW_CHAT_R: float = 1.5
const CW_CHAT_P: float = 0.004
const CW_CHAT_CD: float = 40.0
function cw_try_chat(crowd_st: mut CrowdState, p: CrowdPed, row: int, dt: float) -> void {
  if p.chat_cd > 0.0 or p.lod != CROWD_FULL or p.act != CROWD_WALK or p.scn >= 0 or p.ext >= 0 or p.lead >= 0 { return }
  let n = tb_within(crowd_st.cw_tab, crowd_st.cw_grid, p.x, p.z, CW_CHAT_R, -1, 0, crowd_st.cw_near)
  for k in 0 .. n {
    let r2 = crowd_st.cw_near[k]
    if r2 == row { continue }
    let o = crowd_st.cw_tab.rec[r2]
    if o.chat_cd > 0.0 or o.lod == CROWD_PUPPET or o.act != CROWD_WALK or o.scn >= 0 or o.ext >= 0 or o.lead >= 0 or o.react != PedReact.Calm { continue }
    if cw_roll(p, 27) >= CW_CHAT_P { return }
    let t = 3.0 + 3.0 * cw_roll(p, 28)
    p.has_dest = false
    p.act = CROWD_STAND
    p.act_t = t
    p.chat_cd = CW_CHAT_CD
    p.chat_with = o.uid
    p.key = crowd_st.cw_cfg.chat_anim
    o.has_dest = false
    o.act = CROWD_STAND
    o.act_t = t
    o.chat_cd = CW_CHAT_CD
    o.chat_with = p.uid
    o.key = crowd_st.cw_cfg.chat_anim
    return
  }
}

function cw_calm(crowd_st: mut CrowdState, p: CrowdPed, row: int, ty: PedType, dt: float) -> void {
  if p.chat_cd > 0.0 { p.chat_cd -= dt }
  if p.ext >= 0 {
    cw_leg(crowd_st, p, row, ty, dt)
    return
  }
  if p.lead >= 0 {
    let lrow = tb_row(crowd_st.cw_tab, p.lead)
    if lrow < 0 { p.lead = -1 } else {
      cw_follow(crowd_st, p, row, lrow, ty, dt)
      return
    }
  }
  if p.out_on {
    # out to the front of the seat it got up from first (never back over the bench), then on with its day
    let ty_sp = ty.walk_speed * p.pace
    p.out_t += dt
    if cw_step_straight(crowd_st, p, row, p.out_x, p.out_z, ty_sp, dt, false) or p.out_t > 4.0 { p.out_on = false }
    return
  }
  let going = p.act == CROWD_WALK or p.act == CROWD_COMMUTE or p.act == CROWD_JOG or (p.scn >= 0 and not p.scn_used)
  if going {
    if not p.has_dest {
      # a walk to a scenario that lost its way (blocked a second): the place is given up for another to take, and it wanders on
      if p.scn >= 0 and not p.scn_used { cw_leave_scenario(crowd_st, p) }
      cw_pick_dest(crowd_st, p, ty)
    }
    cw_try_chat(crowd_st, p, row, dt)
    if not p.has_dest { return }
    var sp = ty.walk_speed * p.pace
    if p.act == CROWD_COMMUTE { sp = sp * 1.2 }
    if p.act == CROWD_JOG {
      # its own pace within +-7.5% of the type's (pace is 0.85 .. 1.15): a game plays its jog clip at the speed, so a narrow band
      sp = ty.jog_speed * (1.0 + (p.pace - 1.0) * 0.5)
      p.act_t -= dt
    }
    if p.scn >= 0 and crowd_st.cw_sn_r[p.scn] <= 0.0 and crowd_st.cw_sn_appr[p.scn] > 0.0 {
      # from the front: to the point `approach` ahead of the place while it is behind or beside it (outside the 45 degrees before it), then
      # straight back onto it
      let fx = Math.sin(crowd_st.cw_sn_yaw[p.scn])
      let fz = Math.cos(crowd_st.cw_sn_yaw[p.scn])
      let ap = crowd_st.cw_sn_appr[p.scn]
      let ahead = (p.x - p.dest_x) * fx + (p.z - p.dest_z) * fz
      let side = (p.x - p.dest_x) * fz - (p.z - p.dest_z) * fx
      if ahead < -0.05 or Math.abs(side) > ahead + 0.15 {
        let reach = Math.max(0.3, sp * dt * 1.1)                 # a far ped's step a second long, a near one's turn: never round the point
        let ox = p.dest_x + fx * ap
        let oz = p.dest_z + fz * ap
        let od = Math.sqrt((ox - p.x) * (ox - p.x) + (oz - p.z) * (oz - p.z))
        # the last 2 m to the front point straight (refused: steered round), as the way's corner can be where it stands (a nav that
        # bends round the bench from inside its margin): a steered step there would stand still for good
        if od < 2.0 or cw_move_to(crowd_st, p, row, ox, oz, sp, dt, reach * reach) { cw_step_straight(crowd_st, p, row, ox, oz, sp, dt, false) }
        return
      }
    }
    if p.scn >= 0 and crowd_st.cw_sn_r[p.scn] <= 0.0 and cw_near_spot(p) {
      if cw_step_to_spot(crowd_st, p, row, sp, dt) { cw_arrive(crowd_st, p, ty) }
      return
    }
    if cw_move(crowd_st, p, row, p.dest_x, p.dest_z, sp, dt) { cw_arrive(crowd_st, p, ty) }
    return
  }
  cw_halt(p, dt)
  p.act_t -= dt
  if p.chat_with >= 0 {
    # the chat: it stands (the idle state) turned to the other by the body yaw, and gives it up when its time or the other is gone
    let orow = tb_row(crowd_st.cw_tab, p.chat_with)
    if orow < 0 {
      p.chat_with = -1
      p.key = ""
    } else {
      let o = crowd_st.cw_tab.rec[orow]
      cw_face(p, o.x, o.z, dt)
    }
  }
  if p.act_t > 0.0 { return }
  if p.chat_with >= 0 { p.key = "" }
  p.chat_with = -1
  # its time at a place that takes getting up from (a bench) is over: it stays on it while it gets up, then goes on with its day
  if p.scn >= 0 and p.scn_used and not p.leaving and crowd_st.cw_sn_leave[p.scn] > 0.0 {
    p.leaving = true
    p.act_t = crowd_st.cw_sn_leave[p.scn]
    p.key = crowd_st.cw_sn_leave_anim[p.scn]
    return
  }
  var ox = 0.0
  var oz = 0.0
  let out = p.leaving and p.scn >= 0 and crowd_st.cw_sn_appr[p.scn] > 0.0
  if out {
    ox = p.x + Math.sin(crowd_st.cw_sn_yaw[p.scn]) * crowd_st.cw_sn_appr[p.scn]
    oz = p.z + Math.cos(crowd_st.cw_sn_yaw[p.scn]) * crowd_st.cw_sn_appr[p.scn]
  }
  cw_next_act(crowd_st, p)
  if out {
    p.out_on = true
    p.out_t = 0.0
    p.out_x = ox
    p.out_z = oz
  }
}

# within CW_SPOT_NEAR of the very place it is going to (a seat, a spot at a counter): the last steps are walked straight onto it, slowing,
# with nobody to steer round (the place is its own; a straight step the nav refuses is steered round as any) - a walk that stopped within
# 0.8 m and was put on its place slid the rest
const CW_SPOT_NEAR: float = 0.9
const CW_SPOT_AT: float = 0.03
const CW_SPOT_OWN: float = 0.45        # the last of it is the place's own: never refused (a seat's place stands at its bench's edge)
function cw_near_spot(p: CrowdPed) -> bool {
  let dx = p.dest_x - p.x
  let dz = p.dest_z - p.z
  return dx * dx + dz * dz < CW_SPOT_NEAR * CW_SPOT_NEAR
}

function cw_step_to_spot(crowd_st: mut CrowdState, p: CrowdPed, row: int, speed: float, dt: float) -> bool {
  return cw_step_straight(crowd_st, p, row, p.dest_x, p.dest_z, speed, dt, true)
}

# a straight step toward (tx, tz) at most `speed`, never past it; slowing over the last half metre when `stop`. True: there (within
# CW_SPOT_AT)
function cw_step_straight(crowd_st: mut CrowdState, p: CrowdPed, row: int, tx: float, tz: float, speed: float, dt: float, stop: bool) -> bool {
  let dx = tx - p.x
  let dz = tz - p.z
  let d = Math.sqrt(dx * dx + dz * dz)
  if d <= CW_SPOT_AT {
    if stop { p.speed = 0.0 }
    return true
  }
  # slows to a stop over the last half metre (never below a slow step), never past the place
  var sp = speed
  if stop { sp = Math.min(speed, Math.max(0.35, d * 2.2)) }
  p.speed = sp
  let step = Math.min(d, sp * dt)
  # a straight step the nav refuses (the place is in front of a bench and the walker behind it): steered there the usual way, round it.
  # Its own place is asked about first, as a steered step asks about the look ahead: a game's nav may tell its movers apart by it
  if d > CW_SPOT_OWN and CrowdNav.crossing(p.x, p.z) >= 0 and not CrowdNav.walkable(p.x + dx / d * step, p.z + dz / d * step) {
    cw_move_to(crowd_st, p, row, tx, tz, speed, dt, CW_SPOT_AT * CW_SPOT_AT)
    return false
  }
  if p.lod == CROWD_FULL {
    let turn = cw_turn(p.yaw, cw_yaw_of(dx, dz))
    let lim = 7.0 * dt
    p.yaw += Math.clamp(turn, -lim, lim)
  } else {
    p.yaw = cw_yaw_of(dx, dz)
  }
  cw_set_pos(crowd_st, p, row, p.x + dx / d * step, p.z + dz / d * step)
  return step >= d - CW_SPOT_AT
}

function cw_flee_dest(crowd_st: mut CrowdState, p: CrowdPed, ty: PedType) -> void {
  var best = -1.0
  var bx = p.x
  var bz = p.z
  for k in 0 .. 3 {
    let salt = crowd_hash(p.uid, p.seq + k + 1, 64)
    if CrowdNav.pick(p.x, p.z, 25.0, 60.0, salt, crowd_st.cw_buf) {
      let dx = crowd_st.cw_buf[0] - p.threat_x
      let dz = crowd_st.cw_buf[1] - p.threat_z
      let d = dx * dx + dz * dz
      if d > best {
        best = d
        bx = crowd_st.cw_buf[0]
        bz = crowd_st.cw_buf[1]
      }
    }
  }
  p.seq += 3
  p.dest_x = bx
  p.dest_z = bz
  p.has_dest = best >= 0.0
  p.repath = 0.0
}

function cw_panic_dest(crowd_st: mut CrowdState, p: CrowdPed) -> void {
  let salt = crowd_hash(p.uid, p.seq + 1, 65)
  p.seq += 1
  if CrowdNav.pick(p.x, p.z, 6.0, 18.0, salt, crowd_st.cw_buf) {
    p.dest_x = crowd_st.cw_buf[0]
    p.dest_z = crowd_st.cw_buf[1]
    p.has_dest = true
    p.repath = 0.0
  }
  p.act_t = 0.8 + cw_roll(p, 25) * 1.0
}

function cw_step(crowd_st: mut CrowdState, p: CrowdPed, row: int, dt: float) -> void {
  let ty = PedTypes[p.type]
  let yaw0 = p.yaw
  if p.react == PedReact.Calm {
    cw_calm(crowd_st, p, row, ty, dt)
  } else if p.react == PedReact.Flee {
    if not p.has_dest { cw_flee_dest(crowd_st, p, ty) }
    if p.has_dest and cw_move(crowd_st, p, row, p.dest_x, p.dest_z, ty.run_speed * p.pace, dt) { p.has_dest = false }
  } else if p.react == PedReact.Panic {
    p.act_t -= dt
    if not p.has_dest or p.act_t <= 0.0 { cw_panic_dest(crowd_st, p) }
    if p.has_dest and cw_move(crowd_st, p, row, p.dest_x, p.dest_z, ty.run_speed * p.pace * 1.15, dt) { p.has_dest = false }
  } else if p.react == PedReact.Fight {
    let dx = p.threat_x - p.x
    let dz = p.threat_z - p.z
    if dx * dx + dz * dz > 1.7 * 1.7 {
      p.dest_x = p.threat_x
      p.dest_z = p.threat_z
      p.has_dest = true
      cw_move(crowd_st, p, row, p.dest_x, p.dest_z, ty.run_speed * p.pace * 0.8, dt)
    } else {
      cw_halt(p, dt)
      cw_face(p, p.threat_x, p.threat_z, dt)
      p.hit_t += dt
      if p.hit_t >= 1.0 {
        p.hit_t = 0.0
        let f = cw_fact(crowd_st, CROWD_ATTACK, p.uid)
        f.x = p.threat_x
        f.z = p.threat_z
        f.from = p.thr_id
      }
    }
  } else {
    # alert, cower, call: standing, the alert watching the threat
    cw_halt(p, dt)
    if p.react == PedReact.Alert { cw_face(p, p.threat_x, p.threat_z, dt) }
  }
  var act = p.act
  if p.react == PedReact.Call { act = CROWD_PHONE }
  if p.wait_t > 0.0 and p.speed == 0.0 { act = CROWD_WAIT }
  p.turn = cw_turn(yaw0, p.yaw) / Math.max(0.001, dt)
  if act != p.act_sent {
    # a change of act with no move still goes in the next delta; a near ped's graph is told which state to play
    p.act_sent = act
    tb_mark(crowd_st.cw_tab, row)
    if p.lod != CROWD_FAR {
      let f = cw_fact(crowd_st, CROWD_ACT, p.uid)
      f.to = act
      f.key = p.key
      f.x = p.x
      f.z = p.z
    }
  }
  CrowdBody.place(p.uid, p.x, CrowdWorld.ground(p.x, p.z), p.z, p.yaw, p.speed, act, p.lod)
}

# every ped that is due: a FULL one each tick, a MID one every mid_dt, a FAR one every far_dt
function cw_move_all(crowd_st: mut CrowdState, dt: float) -> void {
  let n = tb_len(crowd_st.cw_tab)
  let mid = crowd_st.cw_cfg.mid_dt
  let far = crowd_st.cw_cfg.far_dt
  for i in 0 .. n {
    let p = crowd_st.cw_tab.rec[i]
    if p.lod == CROWD_PUPPET { continue }
    p.acc += dt
    var period = 0.0
    if p.lod == CROWD_MID { period = mid }
    if p.lod == CROWD_FAR { period = far }
    if p.acc < period { continue }
    let step = p.acc
    p.acc = 0.0
    cw_step(crowd_st, p, i, step)
  }
}
