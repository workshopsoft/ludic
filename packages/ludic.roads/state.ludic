# state.ludic - the graph a map was built into, the cars on it, and the facts

export const ROADS_SPAWNED: int = 0    # a car was made (id, kind, edge, x, z)
export const ROADS_ARRIVED: int = 1    # a car reached the end of its route and was not to wander (id, edge)
export const ROADS_GONE: int = 2       # a car was taken off the roads (id, reason: ROADS_WHY_*)
export const ROADS_JAMMED: int = 3     # a car stood still too long and was taken off (id, edge)

export const ROADS_WHY_ARRIVED: int = 0
export const ROADS_WHY_DESPAWNED: int = 1
export const ROADS_WHY_JAM: int = 2
export const ROADS_WHY_REBUILT: int = 3   # the map changed under it

export const ROADS_SHORTEST: int = 0    # routes by length
export const ROADS_FASTEST: int = 1     # routes by time: length over the limit, and a wait at each stop, yield and signal

export const ROAD_LEVEL_GROUND: int = 0       # RoadSeg.level
export const ROAD_LEVEL_STRUCTURE: int = 1    # a bridge, viaduct or flyover deck
export const ROAD_LEVEL_TUNNEL: int = 2

export const ROAD_RULE_FREE: int = 0
export const ROAD_RULE_YIELD: int = 1
export const ROAD_RULE_STOP: int = 2
export const ROAD_RULE_FORBID: int = 3

export property RoadsFact {
  what: int = 0
  id: int = 0
  kind: int = 0
  edge: int = -1
  why: int = 0
  x: float = 0.0
  z: float = 0.0
}

# one car. `edge` is a directed road (see roads_edge_*): 2 * segment for from -> to, +1 for back. `s` is metres
# along it, `lane` counts from the inside
export property RoadCar {
  alive: bool = false
  id: int = 0
  kind: int = 0
  edge: int = -1
  lane: int = 0
  s: float = 0.0
  v: float = 0.0
  route: []int = new []int
  at: int = 0                   # where in the route its edge is
  wander: bool = false          # at the end of its route it picks another instead of arriving
  stopped: float = 0.0          # seconds at a stop line, standing
  waited: float = 0.0           # the clock when it came to the end of its road to wait its turn (-1 not waiting)
  jam: float = 0.0              # seconds standing for any reason
  holds: bool = false           # it holds the node at the end of its edge
  hold: int = -1                # the node it holds (-1 none): it was let in, and is not yet clear of it
  pin: int = -1                 # the edge it came by, while it is still turning off it into this one (-1 none)
  plane: int = 0                # the lane it came by
  ka: float = 0.0               # the turn path ahead (into the next road): its length over its span in road metres (0: none near)
  kka: float = 0.0              # ... its sharpest bend (1 / radius)
  kb: float = 0.0               # the turn path it is still on off the road it came by: its length over its span (0: none)
  kkb: float = 0.0
  x: float = 0.0
  y: float = 0.0
  z: float = 0.0
  yaw: float = 0.0
}

export state RoadsState {
  rd_drive_left: bool = false
  rd_err: string = ""
  # nodes
  rd_nkey: []string = new []string
  rd_nx: []float = new []float
  rd_nz: []float = new []float
  rd_nsignal: []int = new []int          # 1 when it is a signal
  rd_ncycle: []float = new []float
  rd_nphases: []int = new []int
  rd_nroads: []int = new []int           # how many roads end here
  # segments (one per row of the map's table, valid or not) and their splines
  rd_skey: []string = new []string
  rd_sfrom: []int = new []int
  rd_sto: []int = new []int
  rd_slf: []int = new []int
  rd_slb: []int = new []int
  rd_sw: []float = new []float
  rd_sspeed: []float = new []float
  rd_sprio: []int = new []int
  rd_sphase: []int = new []int
  rd_slen: []float = new []float
  rd_sp0: []int = new []int              # its points are rd_px[sp0 .. sp1)
  rd_sp1: []int = new []int
  rd_px: []float = new []float
  rd_pz: []float = new []float
  rd_ps: []float = new []float           # metres along the segment at each point
  rd_cx: []float = new []float           # scratch: one spline's control points
  rd_cz: []float = new []float
  rd_cs: []float = new []float           # scratch: metres along the road of each control point
  rd_slevel: []int = new []int           # per segment: ROAD_LEVEL_*
  rd_sdesign: []int = new []int          # per segment: 1 when its design heights are given (rd_py holds them)
  rd_py: []float = new []float           # the design height at each point (0 where the segment has none)
  # a grid over the polyline steps (cells of RD_GRID metres): rd_gcell maps a cell to the first entry, each entry
  # being a step (rd_gstep: the index of its first point), its segment and the next entry of the cell
  rd_gcell: IntMap = imap_new()
  rd_gstep: []int = new []int
  rd_gseg: []int = new []int
  rd_gnext: []int = new []int
  rd_gx0: int = 0                        # the cells that hold anything: rd_gx0 .. rd_gx1, rd_gz0 .. rd_gz1
  rd_gx1: int = 0
  rd_gz0: int = 0
  rd_gz1: int = 0
  # directed edges, 2 a segment; an edge that does not exist has no lanes
  rd_efrom: []int = new []int
  rd_eto: []int = new []int
  rd_elanes: []int = new []int
  rd_elen: []float = new []float
  rd_espeed: []float = new []float
  rd_eprio: []int = new []int
  rd_ephase: []int = new []int
  rd_out_start: []int = new []int        # the edges leaving node n: rd_out[out_start[n] .. out_start[n + 1])
  rd_out: []int = new []int
  rd_in_start: []int = new []int
  rd_in: []int = new []int
  rd_turns: IntMap = imap_new()          # in * RD_TURN_KEY + out -> ROAD_RULE_*
  # routing scratch
  rd_dist: []float = new []float
  rd_prev: []int = new []int
  rd_hk: []float = new []float
  rd_hv: []int = new []int
  rd_route_cost: float = 0.0
  # one place asked for: nearest and pose
  rd_near_seg: int = -1
  rd_near_s: float = 0.0
  rd_near_d: float = 0.0
  rd_near_y: float = 0.0
  rd_bscore: float = 0.0                 # scratch of the nearest search: the best score so far (distance squared, plus the height gap squared when asked), its step and planar distance squared
  rd_bstep: int = -1
  rd_bd2: float = 0.0
  rd_pose_seg: int = -1
  rd_pose_i: int = 0                     # the polyline step the last pose was on and how far along it (0..1): the design height reads them
  rd_pose_t: float = 0.0
  rd_pose_x: float = 0.0
  rd_pose_z: float = 0.0
  rd_pose_yaw: float = 0.0
  # traffic
  rd_cars: []RoadCar = new []RoadCar
  rd_ncars: int = 0
  rd_next_id: int = 1
  rd_target: int = 0
  rd_spawn_t: float = 0.0
  rd_time: float = 0.0
  rd_dice: Rng = rng_new(1)
  rd_dice_ok: bool = false                 # seeded from RoadsWorld.seed() (the first time traffic needs it, or a reset)
  rd_head: []int = new []int             # per edge: the first car on it this tick, linked through rd_link
  rd_link: []int = new []int
  rd_route_tmp: []int = new []int
  # junctions as places with a size (roads_edge_setbacks): per edge, metres short of its end that a car's front waits for the
  # node (-1: the old 1.5 m wall), short of its end that its turn path begins, from its start that the path ends, and from its
  # start that a car's rear is clear of the node it came through
  rd_estop: []float = new []float
  rd_emouth_end: []float = new []float
  rd_emouth_start: []float = new []float
  rd_eclear: []float = new []float
  rd_ebase: []float = new []float        # per edge: the inner edge of lane 0 from the centre line, right of travel (RD_BASE_OLD: the old rule)
  rd_nuturn: []float = new []float       # per node: the radius a U-turn there loops round it on (0: a hairpin between the two lanes)
  rd_conflict_w: float = 0.0             # 0: a node lets one car in at a time; more: cars whose turn paths stay this far apart go together
  rd_turn_acc: float = 0.0               # m/s2 across a turn path a car keeps under (0: no limit)
  rd_jam_limit: float = 90.0
  rd_debug_id: int = -1   # DEBUG-TEMP             # seconds standing before a car is taken off (0: never)
  # one turn path (rd_path_build): up to 4 cubic Bezier pieces, 8 numbers each (p0, c1, c2, p3 as x, z), its length and its sharpest bend
  rd_tp: []float = new []float
  rd_tpn: int = 0
  rd_tplen: float = 0.0
  rd_tpk: float = 0.0
  rd_tps: []float = new []float          # scratch: the length of each piece
  rd_sax: []float = new []float          # scratch: two paths sampled, to compare
  rd_saz: []float = new []float
  rd_sbx: []float = new []float
  rd_sbz: []float = new []float
  rd_mv_a: []int = [0, 0, 0, 0]          # scratch: two movements through a node (in edge, lane, out edge, lane)
  rd_mv_b: []int = [0, 0, 0, 0]
  rd_gap: float = 0.0                    # scratch: the gap to what is ahead of the car being driven, and how much faster it is
  rd_dv: float = 0.0
  rd_facts: Queue<RoadsFact> = rd_facts__new()
}
function rd_facts__new() -> Queue<RoadsFact> { return queue_new("roads.facts") }

export function roads_facts(roads_st: RoadsState) -> Queue<RoadsFact> { return roads_st.rd_facts }

function rd_say(roads_st: mut RoadsState, what: int, id: int, kind: int, edge: int, why: int, x: float, z: float) -> void {
  var f = q_rec(roads_st.rd_facts)
  if f == null {
    @alloc_ok("past the ring: more of these in a frame than its records, then kept in it")
    f = new RoadsFact
    q_ring_add(roads_st.rd_facts, f)
  }
  f.what = what
  f.id = id
  f.kind = kind
  f.edge = edge
  f.why = why
  f.x = x
  f.z = z
  q_push(roads_st.rd_facts, f)
}
