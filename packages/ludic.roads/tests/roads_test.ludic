  test "the level and the design heights of a road, between its anchors, held beyond the ones that have one" (roads_st: mut RoadsState, nodes: mut RoadNodes, segs: mut RoadSegs, turns: mut RoadTurns) {
    expect(load_map(roads_st, nodes, segs, turns, "flyover"))
