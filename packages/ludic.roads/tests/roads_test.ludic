    let cd = roads_seg_find(roads_st, "cd")
    let be = roads_seg_find(roads_st, "be")
    let ef = roads_seg_find(roads_st, "ef")
    expect_eq(roads_seg_level(roads_st, ab), ROAD_LEVEL_GROUND)
    expect_eq(roads_seg_level(roads_st, cd), ROAD_LEVEL_STRUCTURE)
    expect(not roads_seg_designed(roads_st, ab))
    expect(roads_seg_designed(roads_st, cd))
    # no design: the game's ground under it (the test's ground is x / 100)
    expect(near(roads_seg_height(roads_st, ab, 150.0), 1.5, 0.001))
    # the flyover: 0 at its ends, 8 in the middle, straight between
    expect(near(roads_seg_height(roads_st, cd, 0.0), 0.0, 0.001))
    expect(near(roads_seg_height(roads_st, cd, roads_seg_length(roads_st, cd)), 0.0, 0.001))
    let half = roads_seg_length(roads_st, cd) * 0.5
    expect(near(roads_seg_height(roads_st, cd, half), 8.0, 0.05))
    expect(near(roads_seg_height(roads_st, cd, half * 0.5), 4.0, 0.2))
    # a ramp: 2 m to 10 m over 200 m
    expect(near(roads_seg_height(roads_st, be, 0.0), 2.0, 0.001))
    expect(near(roads_seg_height(roads_st, be, 100.0), 6.0, 0.01))
    expect(near(roads_seg_height(roads_st, be, 200.0), 10.0, 0.001))
    # one anchor with a height: every point of the road is at it
    expect(near(roads_seg_height(roads_st, ef, 0.0), 5.0, 0.001))
    expect(near(roads_seg_height(roads_st, ef, 150.0), 5.0, 0.001))
    expect(near(roads_seg_height(roads_st, ef, 200.0), 5.0, 0.001))
  }

  test "the nearest road at a height: under a flyover the road below, on it the road above; with no height the first" (roads_st: mut RoadsState, nodes: mut RoadNodes, segs: mut RoadSegs, turns: mut RoadTurns) {
    expect(load_map(roads_st, nodes, segs, turns, "flyover"))
    let ab = roads_seg_find(roads_st, "ab")
    let cd = roads_seg_find(roads_st, "cd")
    # where they cross, (100, 0): ab is at 1 m (the ground), the deck at 8 m
    expect_eq(roads_nearest_y(roads_st, 100.0, 1.0, 0.5), ab)
    expect(near(roads_near_y(roads_st), 1.0, 0.01))
    expect(near(roads_near_d(roads_st), 0.5, 0.01))
    expect(near(roads_near_s(roads_st), 100.0, 0.5))
    expect_eq(roads_nearest_y(roads_st, 100.0, 8.0, 0.5), cd)
    expect(near(roads_near_y(roads_st), 8.0, 0.05))
    expect_eq(roads_nearest_y(roads_st, 100.0, 7.0, -0.5), cd)
    expect_eq(roads_nearest_y(roads_st, 100.0, 2.0, 0.0), ab)
    # the plan alone takes the first road of a tie (ab, the lower index)
    expect_eq(roads_nearest(roads_st, 100.0, 0.0), ab)
    # off the crossing there is only one road to take, whatever the height
    expect_eq(roads_nearest_y(roads_st, 100.0, 0.0, 60.0), cd)
    expect_eq(roads_nearest_y(roads_st, 20.0, 40.0, 3.0), ab)
  }

