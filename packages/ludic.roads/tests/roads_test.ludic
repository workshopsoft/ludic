  # a snake of 128 x 128 nodes joined in order (the last closing the ring when `count` is 16,384): written as the files
  # of a map, `big`, beside the others, and left out of git (the map is made by the test and removed by it)
  function write_big(nodes: mut RoadNodes, count: int, turn: bool) -> void {
    expect(road_nodes_load(nodes, "town"))
    let root = Path.dir(Path.dir(Path.dir(road_nodes_path(nodes, "roads/nodes.lres"))))
    let dir = Path.join(Path.join(root, "big"), "roads")
    Fs.mkdir(Path.join(root, "big"))
    Fs.mkdir(dir)
    let lines = new []string
    for i in 0 .. 16384 {
      var col = i % 128
      if (i / 128) % 2 == 1 { col = 127 - col }
      push(lines, `n{i} \{ x: {float(col) * 20.0}, z: {float(i / 128) * 20.0} }`)
    }
    expect(Fs.write_text(Path.join(dir, "nodes.lres"), Text.join(lines, "\n")))
    let segs = new []string
    for i in 0 .. count {
      push(segs, `s{i} \{ from: "n{i % 16384}", to: "n{(i + 1) % 16384}", speed: 15.0 }`)
    }
    expect(Fs.write_text(Path.join(dir, "segs.lres"), Text.join(segs, "\n")))
    var rule = "# no turn rules"
    if turn { rule = "t0 \{ node: \"n12000\", from: \"s11999\", to: \"s12000\", rule: \"forbid\" }" }
    expect(Fs.write_text(Path.join(dir, "turns.lres"), rule))
  }
  function remove_big(nodes: mut RoadNodes) -> void {
    let root = Path.dir(Path.dir(Path.dir(road_nodes_path(nodes, "roads/nodes.lres"))))
    let dir = Path.join(Path.join(root, "big"), "roads")
    Fs.remove(Path.join(dir, "nodes.lres"))
    Fs.remove(Path.join(dir, "segs.lres"))
    Fs.remove(Path.join(dir, "turns.lres"))
    Fs.remove(dir)
    Fs.remove(Path.join(root, "big"))
  }

  test "16,384 roads build, a turn rule on a high edge is its own, and one road more is left out and said" (roads_st: mut RoadsState, nodes: mut RoadNodes, segs: mut RoadSegs, turns: mut RoadTurns) {
    write_big(nodes, 16384, true)
    expect(road_nodes_load(nodes, "big"))
    expect(road_segs_load(segs, "big"))
    expect(road_turns_load(turns, "big"))
    let t0 = Time.now_us()
    expect(roads_build(roads_st, nodes, segs, turns))
    let t1 = Time.now_us()
    for i in 0 .. 1000 { roads_nearest(roads_st, float(i * 37 % 2560), float(i * 91 % 2560)) }
    let t2 = Time.now_us()
    # a guard against a slide back to scans (it takes about 20 ms and 1 ms here)
    expect((t1 - t0) / 1000 < 3000)
    expect((t2 - t1) / 1000 < 2000)
    expect_eq(roads_seg_count(roads_st), 16384)
    expect_eq(roads_edge_count(roads_st), 32768)
    let e_in = 2 * 11999
    let e_out = 2 * 12000
    expect_eq(roads_turn_rule(roads_st, e_in, e_out), ROAD_RULE_FORBID)
    # the pairs that the old key (in * 8192 + out) put on the same number are untouched
    expect_eq(roads_turn_rule(roads_st, e_in + 1, e_out - 8192), ROAD_RULE_FREE)
    expect_eq(roads_turn_rule(roads_st, e_in + 2, e_out - 16384), ROAD_RULE_FREE)
    expect_eq(roads_turn_rule(roads_st, e_in, e_out + 2), ROAD_RULE_FREE)
    # the nearest road anywhere on it, from the grid
    expect_eq(roads_nearest(roads_st, 20.0 * 64.0 + 3.0, 20.0 * 50.0 + 4.0), roads_seg_find(roads_st, "s6464"))
    expect_eq(differ_nearest(roads_st, 2560.0, 300, false), 0)
    write_big(nodes, 16385, false)
    expect(not load_map(roads_st, nodes, segs, turns, "big"))
    expect_eq(roads_seg_count(roads_st), 16384)
    expect(roads_error(roads_st) != "")
    remove_big(nodes)
  }

  test "the system is declared with its own key" {
    let s = roads_system()
    expect(s.key == "roads")
    expect_eq(s.phase, PH_SIMULATE)
  }
}
