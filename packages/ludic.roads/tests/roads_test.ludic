  # the nearest road by looking at every step of every road: what roads_nearest answered before it had a grid
  function brute_nearest(roads_st: mut RoadsState, x: float, y: float, z: float, use_y: bool) -> int {
    var best = -1
    var bscore = 0.0
    for seg in 0 .. len(roads_st.rd_skey) {
      for i in roads_st.rd_sp0[seg] .. roads_st.rd_sp1[seg] - 1 {
        let ax = roads_st.rd_px[i]
        let az = roads_st.rd_pz[i]
        let dx = roads_st.rd_px[i + 1] - ax
        let dz = roads_st.rd_pz[i + 1] - az
        let l2 = dx * dx + dz * dz
        var t = 0.0
        if l2 > 0.000001 { t = Math.clamp(((x - ax) * dx + (z - az) * dz) / l2, 0.0, 1.0) }
        let qx = ax + dx * t
        let qz = az + dz * t
        var score = (qx - x) * (qx - x) + (qz - z) * (qz - z)
        if use_y {
          var hy = fake_ground(qx, qz)
          if roads_st.rd_sdesign[seg] == 1 { hy = roads_st.rd_py[i] + (roads_st.rd_py[i + 1] - roads_st.rd_py[i]) * t }
          score += (y - hy) * (y - hy)
        }
        if best < 0 or score < bscore {
          best = seg
          bscore = score
        }
      }
    }
    return best
  }
  # points over and beyond a map, by a fixed sequence: how many the grid and the scan answer differently
  function differ_nearest(roads_st: mut RoadsState, extent: float, count: int, use_y: bool) -> int {
    var seed = 12345
    var wrong = 0
    for i in 0 .. count {
      seed = (seed * 1103515245 + 12345) % 2147483648
      let x = (float(seed % 100000) / 100000.0 * 1.4 - 0.2) * extent
      seed = (seed * 1103515245 + 12345) % 2147483648
      let z = (float(seed % 100000) / 100000.0 * 1.4 - 0.2) * extent
      seed = (seed * 1103515245 + 12345) % 2147483648
      let y = float(seed % 1000) / 1000.0 * 12.0 - 2.0
      let want = brute_nearest(roads_st, x, y, z, use_y)
      var got = -1
      if use_y { got = roads_nearest_y(roads_st, x, y, z) } else { got = roads_nearest(roads_st, x, z) }
      if got != want { wrong += 1 }
    }
    return wrong
  }

  test "the grid finds the road a scan of every step finds, in the plan and at a height, on the maps" (roads_st: mut RoadsState, nodes: mut RoadNodes, segs: mut RoadSegs, turns: mut RoadTurns) {
    expect(load_map(roads_st, nodes, segs, turns, "town"))
    expect_eq(differ_nearest(roads_st, 220.0, 1500, false), 0)
    expect_eq(differ_nearest(roads_st, 220.0, 1500, true), 0)
    expect(load_map(roads_st, nodes, segs, turns, "curved"))
    expect_eq(differ_nearest(roads_st, 400.0, 1500, false), 0)
    expect(load_map(roads_st, nodes, segs, turns, "flyover"))
    expect_eq(differ_nearest(roads_st, 600.0, 1500, false), 0)
    expect_eq(differ_nearest(roads_st, 600.0, 1500, true), 0)
    expect(load_map(roads_st, nodes, segs, turns, "ring"))
    expect_eq(differ_nearest(roads_st, 250.0, 500, false), 0)
  }

