# query.ludic - the graph as numbers: how many of each, an edge's ends and length and lanes, a place on a
# road (its pose, lane by lane), and the road nearest a point

export function roads_node_count(roads_st: RoadsState) -> int { return len(roads_st.rd_nx) }
export function roads_seg_count(roads_st: RoadsState) -> int { return len(roads_st.rd_skey) }
# an edge is a directed road: 2 * segment is from -> to, 2 * segment + 1 is back. One with no lanes is not there
export function roads_edge_count(roads_st: RoadsState) -> int { return len(roads_st.rd_efrom) }
export function roads_edge_ok(roads_st: RoadsState, e: int) -> bool { return e >= 0 and e < len(roads_st.rd_efrom) and roads_st.rd_elanes[e] > 0 }
export function roads_edge_from(roads_st: RoadsState, e: int) -> int { return roads_st.rd_efrom[e] }
export function roads_edge_to(roads_st: RoadsState, e: int) -> int { return roads_st.rd_eto[e] }
export function roads_edge_lanes(roads_st: RoadsState, e: int) -> int { return roads_st.rd_elanes[e] }
export function roads_edge_length(roads_st: RoadsState, e: int) -> float { return roads_st.rd_elen[e] }
export function roads_edge_speed(roads_st: RoadsState, e: int) -> float { return roads_st.rd_espeed[e] }
export function roads_edge_seg(roads_st: RoadsState, e: int) -> int { return e / 2 }
export function roads_edge_back(roads_st: RoadsState, e: int) -> bool { return e % 2 == 1 }
# the same road the other way (its edge number may have no lanes: ask roads_edge_ok)
export function roads_edge_reverse(roads_st: RoadsState, e: int) -> int { return e ^ 1 }
export function roads_node_x(roads_st: RoadsState, n: int) -> float { return roads_st.rd_nx[n] }
export function roads_node_z(roads_st: RoadsState, n: int) -> float { return roads_st.rd_nz[n] }
export function roads_node_roads(roads_st: RoadsState, n: int) -> int { return roads_st.rd_nroads[n] }
export function roads_node_find(roads_st: RoadsState, key: string) -> int {
  for i in 0 .. len(roads_st.rd_nkey) { if roads_st.rd_nkey[i] == key { return i } }
  return -1
}
export function roads_seg_find(roads_st: RoadsState, key: string) -> int {
  for i in 0 .. len(roads_st.rd_skey) { if roads_st.rd_skey[i] == key { return i } }
  return -1
}
export function roads_seg_length(roads_st: RoadsState, seg: int) -> float { return roads_st.rd_slen[seg] }
# a road's level: ROAD_LEVEL_GROUND, ROAD_LEVEL_STRUCTURE (a deck) or ROAD_LEVEL_TUNNEL
export function roads_seg_level(roads_st: RoadsState, seg: int) -> int { return roads_st.rd_slevel[seg] }
# whether the road has design heights (else it follows the ground: RoadsWorld.ground)
export function roads_seg_designed(roads_st: RoadsState, seg: int) -> bool { return roads_st.rd_sdesign[seg] == 1 }
# the turn rule coming in by edge `e_in` and leaving by `e_out`: ROAD_RULE_*
export function roads_turn_rule(roads_st: RoadsState, e_in: int, e_out: int) -> int {
  return imap_get(roads_st.rd_turns, e_in * RD_TURN_KEY + e_out, ROAD_RULE_FREE)
}

# the point `s` metres along segment `seg` (from its `from` end) into rd_pose_x / z, and its heading there
# (pointing from -> to) into rd_pose_yaw. The polyline's own spacing: a binary search, nothing made
function rd_seg_at(roads_st: mut RoadsState, seg: int, s: float) -> void {
  let p0 = roads_st.rd_sp0[seg]
  let p1 = roads_st.rd_sp1[seg]
  if p1 - p0 < 2 {
    roads_st.rd_pose_x = 0.0
    roads_st.rd_pose_z = 0.0
    roads_st.rd_pose_yaw = 0.0
    roads_st.rd_pose_seg = -1
    return
  }
  var d = s
  if d < 0.0 { d = 0.0 }
  if d > roads_st.rd_slen[seg] { d = roads_st.rd_slen[seg] }
  var lo = p0
  var hi = p1 - 1
  while hi - lo > 1 {
    let mid = (lo + hi) / 2
    if roads_st.rd_ps[mid] <= d { lo = mid } else { hi = mid }
  }
  let span = roads_st.rd_ps[hi] - roads_st.rd_ps[lo]
  var t = 0.0
  if span > 0.0001 { t = (d - roads_st.rd_ps[lo]) / span }
  let dx = roads_st.rd_px[hi] - roads_st.rd_px[lo]
  let dz = roads_st.rd_pz[hi] - roads_st.rd_pz[lo]
  roads_st.rd_pose_x = roads_st.rd_px[lo] + dx * t
  roads_st.rd_pose_z = roads_st.rd_pz[lo] + dz * t
  roads_st.rd_pose_yaw = Math.atan2(dx, dz)
  roads_st.rd_pose_seg = seg
  roads_st.rd_pose_i = lo
  roads_st.rd_pose_t = t
}

# the height of the road at the last pose (roads_pose, roads_seg_height): its design height there, or where it has none
# the game's ground under it (RoadsWorld.ground)
export function roads_pose_y(roads_st: RoadsState) -> float {
  let seg = roads_st.rd_pose_seg
  if seg < 0 or roads_st.rd_sdesign[seg] == 0 { return RoadsWorld.ground(roads_st.rd_pose_x, roads_st.rd_pose_z) }
  let i = roads_st.rd_pose_i
  return roads_st.rd_py[i] + (roads_st.rd_py[i + 1] - roads_st.rd_py[i]) * roads_st.rd_pose_t
}

# the height of segment `seg` `s` metres from its `from` end: its design height there, or the ground under it
export function roads_seg_height(roads_st: mut RoadsState, seg: int, s: float) -> float {
  rd_seg_at(roads_st, seg, s)
  return roads_pose_y(roads_st)
}

# how far from the centre line lane `lane` of edge `e` runs, to the right of travel (a one way road
# is centred on its line, and a game that drives on the left mirrors it)
function rd_lane_offset(roads_st: RoadsState, e: int, lane: int) -> float {
  let seg = e / 2
  let w = roads_st.rd_sw[seg]
  var other = roads_st.rd_slb[seg]
  if e % 2 == 1 { other = roads_st.rd_slf[seg] }
  var off = (float(lane) + 0.5) * w
  if other == 0 { off = (float(lane) - float(roads_st.rd_elanes[e] - 1) * 0.5) * w }
  if roads_st.rd_drive_left { off = -off }
  return off
}

# the pose of a car `s` metres along edge `e` in `lane`, into roads_pose_x / z / yaw (yaw faces along the edge)
export function roads_pose(roads_st: mut RoadsState, e: int, s: float, lane: int) -> void {
  if e < 0 or e >= len(roads_st.rd_efrom) { return }
  let seg = e / 2
  var d = s
  var flip = false
  if e % 2 == 1 {
    d = roads_st.rd_slen[seg] - s
    flip = true
  }
  rd_seg_at(roads_st, seg, d)
  var yaw = roads_st.rd_pose_yaw
  if flip { yaw = yaw + 3.1415927 }
  if yaw > 3.1415927 { yaw = yaw - 6.2831853 }
  let hx = Math.sin(yaw)
  let hz = Math.cos(yaw)
  let off = rd_lane_offset(roads_st, e, lane)
  roads_st.rd_pose_x = roads_st.rd_pose_x + (-hz) * off
  roads_st.rd_pose_z = roads_st.rd_pose_z + hx * off
  roads_st.rd_pose_yaw = yaw
}
export function roads_pose_x(roads_st: RoadsState) -> float { return roads_st.rd_pose_x }
export function roads_pose_z(roads_st: RoadsState) -> float { return roads_st.rd_pose_z }
export function roads_pose_yaw(roads_st: RoadsState) -> float { return roads_st.rd_pose_yaw }

# the step of the polyline that starts at point i of segment `seg`, as a candidate for the nearest search at (x, z), and
# at height y when `use_y`: its score is the planar distance squared, plus the gap in height squared (the road's design
# height there, else the game's ground) when asked. The lowest score wins, a tie going to the lower segment, then step
function rd_try_step(roads_st: mut RoadsState, seg: int, i: int, x: float, y: float, z: float, use_y: bool) -> void {
  let ax = roads_st.rd_px[i]
  let az = roads_st.rd_pz[i]
  let dx = roads_st.rd_px[i + 1] - ax
  let dz = roads_st.rd_pz[i + 1] - az
  let l2 = dx * dx + dz * dz
  var t = 0.0
  if l2 > 0.000001 { t = Math.clamp(((x - ax) * dx + (z - az) * dz) / l2, 0.0, 1.0) }
  let qx = ax + dx * t
  let qz = az + dz * t
  let d2 = (qx - x) * (qx - x) + (qz - z) * (qz - z)
  let have = roads_st.rd_near_seg >= 0
  if have and d2 > roads_st.rd_bscore { return }
  var score = d2
  var hy = 0.0
  if use_y {
    if roads_st.rd_sdesign[seg] == 1 { hy = roads_st.rd_py[i] + (roads_st.rd_py[i + 1] - roads_st.rd_py[i]) * t } else { hy = RoadsWorld.ground(qx, qz) }
    score = d2 + (y - hy) * (y - hy)
  }
  var better = not have or score < roads_st.rd_bscore
  if not better and score == roads_st.rd_bscore {
    better = seg < roads_st.rd_near_seg or (seg == roads_st.rd_near_seg and i < roads_st.rd_bstep)
  }
  if not better { return }
  roads_st.rd_near_seg = seg
  roads_st.rd_bstep = i
  roads_st.rd_bscore = score
  roads_st.rd_bd2 = d2
  roads_st.rd_near_s = roads_st.rd_ps[i] + (roads_st.rd_ps[i + 1] - roads_st.rd_ps[i]) * t
  roads_st.rd_near_y = hy
}

function rd_try_cell(roads_st: mut RoadsState, cx: int, cz: int, x: float, y: float, z: float, use_y: bool) -> void {
  if cx < roads_st.rd_gx0 or cx > roads_st.rd_gx1 or cz < roads_st.rd_gz0 or cz > roads_st.rd_gz1 { return }
  var e = imap_get(roads_st.rd_gcell, rd_cell_key(cx, cz), -1)
  while e >= 0 {
    rd_try_step(roads_st, roads_st.rd_gseg[e], roads_st.rd_gstep[e], x, y, z, use_y)
    e = roads_st.rd_gnext[e]
  }
}

# the cells of one row (fixed cz) or column (fixed cx) of a ring, only those inside the box of the grid
function rd_try_row(roads_st: mut RoadsState, cz: int, xa: int, xb: int, x: float, y: float, z: float, use_y: bool) -> void {
  if cz < roads_st.rd_gz0 or cz > roads_st.rd_gz1 { return }
  let a = Math.max(xa, roads_st.rd_gx0)
  let b = Math.min(xb, roads_st.rd_gx1)
  for cx in a .. b + 1 { rd_try_cell(roads_st, cx, cz, x, y, z, use_y) }
}
function rd_try_col(roads_st: mut RoadsState, cx: int, za: int, zb: int, x: float, y: float, z: float, use_y: bool) -> void {
  if cx < roads_st.rd_gx0 or cx > roads_st.rd_gx1 { return }
  let a = Math.max(za, roads_st.rd_gz0)
  let b = Math.min(zb, roads_st.rd_gz1)
  for cz in a .. b + 1 { rd_try_cell(roads_st, cx, cz, x, y, z, use_y) }
}

# a number that is not NaN or infinite (x - x is 0 only for those)
function rd_finite(v: float) -> bool { return v - v == 0.0 }

# the nearest search: the cells round the cell of the box of the grid that is nearest (x, z), ring by ring outwards,
# until a ring is farther than the best found. For a point inside the box that is its own cell. For one outside, the
# cell it is clamped to has the same bound: a cell r + 1 rings off is at least r cells from the point, on the clamped
# side because the box lies the other way and on the others because the point is within the cell's span. So the rings
# stay inside the box, and a point a million kilometres off the map costs what one at its edge does, with no big cell
# numbers to overflow. A point that is NaN or infinite has no nearest road
function rd_nearest(roads_st: mut RoadsState, x: float, y: float, z: float, use_y: bool) -> int {
  roads_st.rd_near_seg = -1
  roads_st.rd_bstep = -1
  roads_st.rd_bscore = 0.0
  roads_st.rd_bd2 = 0.0
  roads_st.rd_near_s = 0.0
  roads_st.rd_near_d = 0.0
  roads_st.rd_near_y = 0.0
  if imap_len(roads_st.rd_gcell) == 0 { return -1 }
  if not rd_finite(x) or not rd_finite(z) { return -1 }
  if use_y and not rd_finite(y) { return -1 }
  # the point is held to the box before it is made a cell number: an int is 32 bits, and a point 1e11 m off would overflow it
  let gx0 = roads_st.rd_gx0
  let gx1 = roads_st.rd_gx1
  let gz0 = roads_st.rd_gz0
  let gz1 = roads_st.rd_gz1
  let c0x = Math.clamp(rd_cell(Math.clamp(x, float(gx0) * RD_GRID, float(gx1 + 1) * RD_GRID)), gx0, gx1)
  let c0z = Math.clamp(rd_cell(Math.clamp(z, float(gz0) * RD_GRID, float(gz1 + 1) * RD_GRID)), gz0, gz1)
  var rmax = c0x - gx0
  if gx1 - c0x > rmax { rmax = gx1 - c0x }
  if c0z - gz0 > rmax { rmax = c0z - gz0 }
  if gz1 - c0z > rmax { rmax = gz1 - c0z }
  for r in 0 .. rmax + 1 {
    if r == 0 {
      rd_try_cell(roads_st, c0x, c0z, x, y, z, use_y)
    } else {
      rd_try_row(roads_st, c0z - r, c0x - r, c0x + r, x, y, z, use_y)
      rd_try_row(roads_st, c0z + r, c0x - r, c0x + r, x, y, z, use_y)
      rd_try_col(roads_st, c0x - r, c0z - r + 1, c0z + r - 1, x, y, z, use_y)
      rd_try_col(roads_st, c0x + r, c0z - r + 1, c0z + r - 1, x, y, z, use_y)
    }
    if roads_st.rd_near_seg >= 0 {
      # the cells beyond this ring are at least r cells away; the margin (a float has 7 digits) keeps a tie, or a
      # score rounded the other way at a great distance, from ending the search before the scan's answer is found
      let reach = float(r) * RD_GRID
      if reach * reach > roads_st.rd_bscore * 1.00001 { break }
    }
  }
  roads_st.rd_near_d = Math.sqrt(roads_st.rd_bd2)
  return roads_st.rd_near_seg
}

# the segment nearest (x, z), looking at the plan only: its index (-1 with no road), and in roads_near_s the metres along
# it, roads_near_d the distance from its centre line. A grid over the polylines answers in a few cells, so it may be asked every
# frame. Where roads cross at different heights this takes the first: use roads_nearest_y
export function roads_nearest(roads_st: mut RoadsState, x: float, z: float) -> int { return rd_nearest(roads_st, x, 0.0, z, false) }

# the segment nearest the point (x, y, z): the plan distance and the gap in height between y and the road's design height
# there (else the game's ground) count together, so under a flyover it is the road below, on it the road above. The
# same answers as roads_nearest: roads_near_s, roads_near_d (the plan distance), and roads_near_y, the road's height there
export function roads_nearest_y(roads_st: mut RoadsState, x: float, y: float, z: float) -> int { return rd_nearest(roads_st, x, y, z, true) }
export function roads_near_y(roads_st: RoadsState) -> float { return roads_st.rd_near_y }
export function roads_near_s(roads_st: RoadsState) -> float { return roads_st.rd_near_s }
export function roads_near_d(roads_st: RoadsState) -> float { return roads_st.rd_near_d }

# the edge of segment `seg` that a traveller at (x, z) on the right-hand (or left, if the game drives on the left)
# side would be on, given the nearest road: the one whose lanes lie on that side. A one way road has the one
export function roads_edge_for(roads_st: mut RoadsState, seg: int, x: float, z: float) -> int {
  let f = 2 * seg
  let b = f + 1
  if not roads_edge_ok(roads_st, f) { return b }
  if not roads_edge_ok(roads_st, b) { return f }
  rd_seg_at(roads_st, seg, roads_st.rd_near_s)
  let hx = Math.sin(roads_st.rd_pose_yaw)
  let hz = Math.cos(roads_st.rd_pose_yaw)
  let side = (x - roads_st.rd_pose_x) * (-hz) + (z - roads_st.rd_pose_z) * hx       # > 0: on the right of from -> to
  var fwd = side >= 0.0
  if roads_st.rd_drive_left { fwd = side < 0.0 }
  if fwd { return f }
  return b
}
