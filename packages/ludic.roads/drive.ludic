# drive.ludic - a tick of traffic: cars made to the target, the cars of an edge linked, and each car's speed
# from the Intelligent Driver Model over what is ahead - the car in front (on this road, or the next), a
# junction it may not enter, what the game's physics says is in the way - then its place along the road,
# its turn onto the next edge, and its body told where it is

const RD_LOOK: float = 25.0              # metres the game's physics is asked to look ahead
const RD_STOP_MARGIN: float = 1.5        # metres short of a junction's end a car waits
const RD_TURN_MIN_V: float = 2.0         # m/s: the least speed a turn is taken at, however sharp
const RD_SCALE_LOOK: float = 60.0        # metres short of a turn path a car measures it (its pace, the gaps across it)
const RD_SPAWN_EVERY: float = 0.4        # seconds between cars made to reach the target
const RD_NONE: float = 1000000.0

# where car o's front is along its way, in way metres on its own road's axis: road metres on a plain lane, stretched through a turn
# path at either end of its road to the path's own length (so the gap between two cars is the distance between them on the ground,
# whichever of them is turning: a car behind one in a U-turn's loop does not crawl at the loop's pace in road metres)
function rd_way_pos(roads_st: RoadsState, o: RoadCar) -> float {
  let e = o.edge
  let s0 = roads_st.rd_elen[e] - roads_st.rd_emouth_end[e]
  if o.ka > 0.0 and o.s > s0 { return s0 + (o.s - s0) * o.ka }
  let ms = roads_st.rd_emouth_start[e]
  if o.kb > 0.0 and o.pin >= 0 and o.s < ms { return ms - (ms - o.s) * o.kb }
  return o.s
}

# the car ahead of `c` in `lane` of `edge` (its own road, or the one it goes on to): the gap from c's front to its rear in way metres
# into rd_gap if nearer than what is there, and how much faster c is into rd_dv. On its own road only cars ahead of it count; on the
# next road every car does, placed beyond c's turn path into it
function rd_leader(roads_st: mut RoadsState, slot: int, c: RoadCar, edge: int, lane: int, next_road: bool) -> void {
  let own = rd_way_pos(roads_st, c)
  var base = 0.0
  if next_road {
    let e = c.edge
    let s0 = roads_st.rd_elen[e] - roads_st.rd_emouth_end[e]
    let span = roads_st.rd_emouth_end[e] + roads_st.rd_emouth_start[edge]
    var path = span
    if c.ka > 0.0 { path = span * c.ka }
    base = s0 + path - roads_st.rd_emouth_start[edge]
  }
  var j = roads_st.rd_head[edge]
  while j >= 0 {
    let o = roads_st.rd_cars[j]
    if j != slot and o.lane == lane and (next_road or o.s > c.s) {
      let g = base + rd_way_pos(roads_st, o) - RoadCarKinds[o.kind].length - own
      if g < roads_st.rd_gap {
        roads_st.rd_gap = g
        roads_st.rd_dv = c.v - o.v
      }
    }
    j = roads_st.rd_link[j]
  }
}

# each car's turn paths, measured once a tick: the one ahead once it is within RD_SCALE_LOOK of it, the one it is still on
function rd_turn_scales(roads_st: mut RoadsState) -> void {
  for i in 0 .. len(roads_st.rd_cars) {
    let c = roads_st.rd_cars[i]
    if not c.alive { continue }
    c.ka = 0.0
    c.kka = 0.0
    c.kb = 0.0
    c.kkb = 0.0
    let e = c.edge
    let next = rd_next_edge(roads_st, c)
    if next >= 0 {
      let me = roads_st.rd_emouth_end[e]
      let span = me + roads_st.rd_emouth_start[next]
      if span > 0.0 and c.s > roads_st.rd_elen[e] - me - RD_SCALE_LOOK {
        rd_path_build(roads_st, e, c.lane, next, roads_lane_onto(roads_st, e, c.lane, next))
        if roads_st.rd_tplen > 0.01 {
          c.ka = roads_st.rd_tplen / span
          c.kka = roads_st.rd_tpk
        }
      }
    }
    if c.pin >= 0 {
      let ms = roads_st.rd_emouth_start[e]
      let span = roads_st.rd_emouth_end[c.pin] + ms
      if span > 0.0 and c.s < ms {
        rd_path_build(roads_st, c.pin, c.plane, e, c.lane)
        if roads_st.rd_tplen > 0.01 {
          c.kb = roads_st.rd_tplen / span
          c.kkb = roads_st.rd_tpk
        }
      }
    }
  }
}

# `move` metres of a car's way from where it is: road metres on a plain lane, but along a turn path (from the mouth of its road
# into the next, or still off the road it came by) the path's own metres, which cover the turn's span in road metres (its two
# mouths) at span / length of the path (a turn cuts its corner, a U-turn loops). The new `s` (it may be past the road's end)
function rd_advance(roads_st: mut RoadsState, c: RoadCar, next: int, move: float) -> float {
  let e = c.edge
  var s = c.s
  var left = move
  # still turning off the road it came by: the path's rest, then plain lane
  if c.pin >= 0 and c.kb > 0.0 {
    let ms = roads_st.rd_emouth_start[e]
    if s < ms {
      let room = (ms - s) * c.kb
      if left <= room { return s + left / c.kb }
      s = ms
      left -= room
    }
  }
  if next >= 0 and c.ka > 0.0 {
    let s0 = roads_st.rd_elen[e] - roads_st.rd_emouth_end[e]
    if s + left > s0 {
      if s < s0 {
        left -= s0 - s
        s = s0
      }
      return s + left / c.ka
    }
  }
  return s + left
}

# the speed a car may have `d` metres short of a turn whose sharpest bend is `k` (1 / radius): under the turn accel across it,
# and slowing to it at half the kind's braking
function rd_turn_cap(roads_st: RoadsState, k: float, d: float, brake: float) -> float {
  if roads_st.rd_turn_acc <= 0.0 or k < 0.0001 { return RD_NONE }
  let vt = Math.max(Math.sqrt(roads_st.rd_turn_acc / k), RD_TURN_MIN_V)
  return Math.sqrt(vt * vt + brake * Math.max(d, 0.0))
}

function rd_step_car(roads_st: mut RoadsState, slot: int, dt: float) -> void {
  let c = roads_st.rd_cars[slot]
  if not RoadsWorld.active(c.x, c.z) { return }
  let kind = RoadCarKinds[c.kind]
  let e = c.edge
  let len_e = roads_st.rd_elen[e]
  let d_end = len_e - c.s
  let next = rd_next_edge(roads_st, c)
  var v0 = Math.min(roads_st.rd_espeed[e] * kind.pace, kind.max_speed)
  # a turn ahead, or the one it is on, slows it
  if roads_st.rd_turn_acc > 0.0 {
    if c.ka > 0.0 { v0 = Math.min(v0, rd_turn_cap(roads_st, c.kka, len_e - roads_st.rd_emouth_end[e] - c.s, kind.brake)) }
    if c.kb > 0.0 and c.s < roads_st.rd_emouth_start[e] { v0 = Math.min(v0, rd_turn_cap(roads_st, c.kkb, 0.0, kind.brake)) }
  }
  roads_st.rd_gap = RD_NONE
  roads_st.rd_dv = 0.0
  # the car in front, here and on the road it goes on to (in the lane it will take)
  rd_leader(roads_st, slot, c, e, c.lane, false)
  if next >= 0 and roads_st.rd_gap > d_end {
    let nl = roads_lane_onto(roads_st, e, c.lane, next)
    rd_leader(roads_st, slot, c, next, nl, true)
  }
  # a junction it may not enter yet: a wall at its waiting line (the old rule: 1.5 m short of the node)
  let set = roads_st.rd_estop[e] >= 0.0
  var d_line = d_end
  if set { d_line = d_end - roads_st.rd_estop[e] }
  if next >= 0 or roads_node_controlled(roads_st, roads_st.rd_eto[e]) {
    if d_line < c.v * c.v / (2.0 * kind.brake) + RD_QUEUE_LOOK and next >= 0 {
      if c.waited < 0.0 and d_line < RD_QUEUE_LOOK * 2.0 { c.waited = roads_st.rd_time }
      if not rd_may_enter(roads_st, slot) {
        var g = Math.max(d_end - RD_STOP_MARGIN, 0.0)
        if set { g = Math.max(d_line, 0.0) }
        if g < roads_st.rd_gap {
          roads_st.rd_gap = g
          roads_st.rd_dv = c.v
        }
      }
    }
  }
  # the game's own world
  let pd = RoadsBody.probe(c.id, c.x, c.z, c.yaw, RD_LOOK)
  if pd >= 0.0 {
    let g = Math.max(pd - kind.length * 0.5, 0.0)
    if g < roads_st.rd_gap {
      roads_st.rd_gap = g
      roads_st.rd_dv = c.v
    }
  }
  # the drive
  let r = c.v / Math.max(v0, 0.1)
  var a = kind.accel * (1.0 - r * r * r * r)
  if roads_st.rd_gap < RD_NONE {
    let want = kind.gap + Math.max(0.0, c.v * kind.headway + c.v * roads_st.rd_dv / (2.0 * Math.sqrt(kind.accel * kind.brake)))
    let q = want / Math.max(roads_st.rd_gap, 0.1)
    a = a - kind.accel * q * q
  }
  if a < -2.0 * kind.brake { a = -2.0 * kind.brake }
  c.v = c.v + a * dt
  if c.v < 0.0 { c.v = 0.0 }
  if roads_st.rd_gap < RD_NONE and c.v * dt > roads_st.rd_gap { c.v = Math.max(roads_st.rd_gap, 0.0) / dt }
  # along a turn path the road metres go by at the path's own pace (its speed is the car's), never past what is ahead
  var ns = rd_advance(roads_st, c, next, c.v * dt)
  if roads_st.rd_gap < RD_NONE and ns - c.s > roads_st.rd_gap { ns = c.s + Math.max(roads_st.rd_gap, 0.0) }
  c.s = ns
  var near_line = d_end < 4.0
  if set { near_line = d_line < 4.0 + kind.gap }
  if c.v < 0.3 and near_line { c.stopped += dt } else if c.v > 0.5 { c.stopped = 0.0 }
  if c.v < 0.1 { c.jam += dt } else { c.jam = 0.0 }
  # the end of the road: on to the next, arrive, or wait at the line
  if c.s >= len_e {
    if next < 0 {
      rd_say(roads_st, ROADS_ARRIVED, c.id, c.kind, e, 0, c.x, c.z)
      rd_take(roads_st, slot, ROADS_WHY_ARRIVED)
      return
    }
    let n = roads_st.rd_eto[e]
    if roads_node_controlled(roads_st, n) and c.hold != n {
      c.s = len_e - 0.05
      c.v = 0.0
    } else {
      c.s = c.s - len_e
      c.pin = e
      c.plane = c.lane
      c.kb = c.ka              # the same turn path, now behind it
      c.kkb = c.kka
      c.ka = 0.0
      c.kka = 0.0
      c.lane = roads_lane_onto(roads_st, e, c.lane, next)
      c.edge = next
      c.at += 1
      c.waited = -1.0
      c.stopped = 0.0
      if c.wander and c.at >= len(c.route) - 1 { rd_replan(roads_st, c) }
    }
  }
  # the road it came by is forgotten once its rear is past the turn
  if c.pin >= 0 and c.s > kind.length + Math.max(roads_st.rd_emouth_start[c.edge], roads_st.rd_eclear[c.edge]) + 1.0 { c.pin = -1 }
  if roads_st.rd_jam_limit > 0.0 and c.jam > roads_st.rd_jam_limit {
    rd_say(roads_st, ROADS_JAMMED, c.id, c.kind, c.edge, 0, c.x, c.z)
    rd_take(roads_st, slot, ROADS_WHY_JAM)
    return
  }
  roads_car_point(roads_st, slot, 0.0)
  c.x = roads_st.rd_pose_x
  c.z = roads_st.rd_pose_z
  c.yaw = roads_st.rd_pose_yaw
  c.y = roads_pose_y(roads_st)
  RoadsBody.place(c.id, c.kind, c.x, c.y, c.z, c.yaw, c.v)
}

export function roads_tick(roads_st: mut RoadsState, t: Tick) -> void {
  var dt = t.dt
  if dt > 0.1 { dt = 0.1 }
  if dt <= 0.0 { return }
  roads_st.rd_time += dt
  if not roads_st.rd_dice_ok {
    rng_seed(roads_st.rd_dice, RoadsWorld.seed())
    roads_st.rd_dice_ok = true
  }
  rd_release_nodes(roads_st)
  if roads_st.rd_ncars < roads_st.rd_target {
    roads_st.rd_spawn_t -= dt
    if roads_st.rd_spawn_t <= 0.0 {
      roads_spawn_random(roads_st)
      roads_st.rd_spawn_t = RD_SPAWN_EVERY
    }
  }
  for e in 0 .. len(roads_st.rd_head) { roads_st.rd_head[e] = -1 }
  for i in 0 .. len(roads_st.rd_cars) {
    let c = roads_st.rd_cars[i]
    if not c.alive { continue }
    roads_st.rd_link[i] = roads_st.rd_head[c.edge]
    roads_st.rd_head[c.edge] = i
  }
  rd_turn_scales(roads_st)
  for i in 0 .. len(roads_st.rd_cars) {
    if roads_st.rd_cars[i].alive { rd_step_car(roads_st, i, dt) }
  }
}
