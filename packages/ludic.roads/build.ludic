# build.ludic - a map's three tables turned into the graph the rest reads: nodes, segments with their
# splines sampled into a polyline and measured, the directed edges (two a segment), who leaves and enters
# each node, and the turn rules keyed by the pair of edges

const RD_SUB: int = 8                 # samples a Catmull-Rom span is cut into
const RD_BEZ_STEP: float = 4.0        # a Bezier span is cut into about one sample per this many metres of control polygon
const RD_BEZ_MIN: int = 8             # ... at least this many samples a span
const RD_BEZ_MAX: int = 64            # ... at most this many
const RD_MAX_SEGS: int = 16384        # an edge number stays under RD_TURN_KEY (2 an edge a road), so a turn is one int key
const RD_TURN_KEY: int = 32768        # a turn is in * RD_TURN_KEY + out
const RD_GRID: float = 32.0           # metres a cell of the grid over the polylines is wide (roads_nearest looks cell by cell)
const RD_CELL_MASK: int = 32767       # a cell's two numbers are cut to their low 15 bits each, then packed into one key
const RD_CLEAR_OLD: float = 1.0       # metres into the next road a car's rear must be to let go of a node, by the old rule
const RD_BASE_OLD: float = -1000.0    # an edge's lane base not set: the old rule

function rd_clear_lists(roads_st: mut RoadsState) -> void {
  List.clear(roads_st.rd_nkey)
  List.clear(roads_st.rd_nx)
  List.clear(roads_st.rd_nz)
  List.clear(roads_st.rd_nsignal)
  List.clear(roads_st.rd_ncycle)
  List.clear(roads_st.rd_nphases)
  List.clear(roads_st.rd_nroads)
  List.clear(roads_st.rd_skey)
  List.clear(roads_st.rd_sfrom)
  List.clear(roads_st.rd_sto)
  List.clear(roads_st.rd_slf)
  List.clear(roads_st.rd_slb)
  List.clear(roads_st.rd_sw)
  List.clear(roads_st.rd_sspeed)
  List.clear(roads_st.rd_sprio)
  List.clear(roads_st.rd_sphase)
  List.clear(roads_st.rd_slen)
  List.clear(roads_st.rd_sp0)
  List.clear(roads_st.rd_sp1)
  List.clear(roads_st.rd_px)
  List.clear(roads_st.rd_pz)
  List.clear(roads_st.rd_ps)
  List.clear(roads_st.rd_slevel)
  List.clear(roads_st.rd_sdesign)
  List.clear(roads_st.rd_py)
  List.clear(roads_st.rd_gstep)
  List.clear(roads_st.rd_gseg)
  List.clear(roads_st.rd_gnext)
  imap_clear(roads_st.rd_gcell)
  roads_st.rd_gx0 = 0
  roads_st.rd_gx1 = 0
  roads_st.rd_gz0 = 0
  roads_st.rd_gz1 = 0
  roads_st.rd_near_seg = -1
  roads_st.rd_pose_seg = -1
  List.clear(roads_st.rd_efrom)
  List.clear(roads_st.rd_eto)
  List.clear(roads_st.rd_elanes)
  List.clear(roads_st.rd_elen)
  List.clear(roads_st.rd_espeed)
  List.clear(roads_st.rd_eprio)
  List.clear(roads_st.rd_ephase)
  List.clear(roads_st.rd_out_start)
  List.clear(roads_st.rd_out)
  List.clear(roads_st.rd_in_start)
  List.clear(roads_st.rd_in)
  List.clear(roads_st.rd_estop)
  List.clear(roads_st.rd_emouth_end)
  List.clear(roads_st.rd_emouth_start)
  List.clear(roads_st.rd_eclear)
  List.clear(roads_st.rd_ebase)
  List.clear(roads_st.rd_nuturn)
  imap_clear(roads_st.rd_turns)
}

# one span of a uniform Catmull-Rom spline between p1 and p2 (p0 before, p3 after), at t in 0..1
function rd_cr(p0: float, p1: float, p2: float, p3: float, t: float) -> float {
  let t2 = t * t
  let t3 = t2 * t
  return 0.5 * (2.0 * p1 + (p2 - p0) * t + (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3) * t2 + (3.0 * p1 - p0 - 3.0 * p2 + p3) * t3)
}

# a cubic Bezier from p0 to p3 with controls c1, c2, at t in 0..1
function rd_bez(p0: float, c1: float, c2: float, p3: float, t: float) -> float {
  let u = 1.0 - t
  return u * u * u * p0 + 3.0 * u * u * t * c1 + 3.0 * u * t * t * c2 + t * t * t * p3
}

# the automatic tangent at anchor k of m: half the span between its neighbours, an end anchor taking itself for
# the missing neighbour (what the Catmull-Rom spline above does, so an all-automatic chain is that spline exactly)
function rd_auto_tan(c: []float, k: int, m: int) -> float {
  var k0 = k - 1
  if k0 < 0 { k0 = 0 }
  var k1 = k + 1
  if k1 > m - 1 { k1 = m - 1 }
  return (c[k1] - c[k0]) * 0.5
}

# one number of anchor k's handle row (which: 0 in x, 1 in z, 2 out x, 3 out z); a row past the list is zero
function rd_handle_of(seg: RoadSeg, k: int, which: int) -> float {
  if k >= len(seg.handles) { return 0.0 }
  let h = seg.handles[k]
  if which == 0 { return h.ix }
  if which == 1 { return h.iz }
  if which == 2 { return h.ox }
  return h.oz
}

# a handle side (in, or out when `out`) of anchor k is automatic when its x and z are both exactly 0
function rd_side_auto(seg: RoadSeg, k: int, out: bool) -> bool {
  var w = 0
  if out { w = 2 }
  return rd_handle_of(seg, k, w) == 0.0 and rd_handle_of(seg, k, w + 1) == 0.0
}

# the offset of a control point from anchor k along one axis (c holds that axis of the anchors; axis 0 is x, 1 is z):
# the handle's number, or for an automatic side a third of the automatic tangent (ahead for out, behind for in)
function rd_ctrl(seg: RoadSeg, c: []float, k: int, m: int, axis: int, out: bool) -> float {
  var w = axis
  if out { w = 2 + axis }
  if not rd_side_auto(seg, k, out) { return rd_handle_of(seg, k, w) }
  let t = rd_auto_tan(c, k, m) / 3.0
  if out { return t }
  return 0.0 - t
}

# the anchors in rd_cx / rd_cz sampled into the polyline as a chain of cubic Beziers, measured (the road has `handles`)
function rd_sample_bezier(roads_st: mut RoadsState, seg: RoadSeg, n0: int) -> void {
  let m = len(roads_st.rd_cx)
  var run = 0.0
  for i in 0 .. m - 1 {
    let j = i + 1
    let ax = roads_st.rd_cx[i]
    let az = roads_st.rd_cz[i]
    let bx = roads_st.rd_cx[j]
    let bz = roads_st.rd_cz[j]
    let c1x = ax + rd_ctrl(seg, roads_st.rd_cx, i, m, 0, true)
    let c1z = az + rd_ctrl(seg, roads_st.rd_cz, i, m, 1, true)
    let c2x = bx + rd_ctrl(seg, roads_st.rd_cx, j, m, 0, false)
    let c2z = bz + rd_ctrl(seg, roads_st.rd_cz, j, m, 1, false)
    let d1 = Math.sqrt((c1x - ax) * (c1x - ax) + (c1z - az) * (c1z - az))
    let d2 = Math.sqrt((c2x - c1x) * (c2x - c1x) + (c2z - c1z) * (c2z - c1z))
    let d3 = Math.sqrt((bx - c2x) * (bx - c2x) + (bz - c2z) * (bz - c2z))
    let q = (d1 + d2 + d3) / RD_BEZ_STEP
    var steps = int(Math.floor(q))
    if float(steps) < q { steps += 1 }
    if steps < RD_BEZ_MIN { steps = RD_BEZ_MIN }
    if steps > RD_BEZ_MAX { steps = RD_BEZ_MAX }
    var last = steps - 1
    if i == m - 2 { last = steps }
    for k in 0 .. last + 1 {
      let t = float(k) / float(steps)
      let x = rd_bez(ax, c1x, c2x, bx, t)
      let z = rd_bez(az, c1z, c2z, bz, t)
      let n = len(roads_st.rd_px)
      if n > n0 {
        let dx = x - roads_st.rd_px[n - 1]
        let dz = z - roads_st.rd_pz[n - 1]
        run += Math.sqrt(dx * dx + dz * dz)
      }
      if k == 0 { kept_push(roads_st.rd_cs, run) }
      kept_push(roads_st.rd_px, x)
      kept_push(roads_st.rd_pz, z)
      kept_push(roads_st.rd_ps, run)
    }
  }
  kept_push(roads_st.rd_cs, run)
  kept_push(roads_st.rd_sp1, len(roads_st.rd_px))
  kept_push(roads_st.rd_slen, run)
}

# the segment's anchors (its two nodes and the points between) sampled into the polyline, measured: a Catmull-Rom
# spline, or with `handles` a chain of cubic Beziers through the same anchors. Everything that reads a road's shape
# (poses, the nearest road, lengths) reads this polyline
function rd_sample_seg(roads_st: mut RoadsState, seg: RoadSeg, a: int, b: int) -> void {
  let n0 = len(roads_st.rd_px)
  kept_push(roads_st.rd_sp0, n0)
  List.clear(roads_st.rd_cx)
  List.clear(roads_st.rd_cz)
  List.clear(roads_st.rd_cs)
  kept_push(roads_st.rd_cx, roads_st.rd_nx[a])
  kept_push(roads_st.rd_cz, roads_st.rd_nz[a])
  for i in 0 .. len(seg.pts) {
    kept_push(roads_st.rd_cx, seg.pts[i].x)
    kept_push(roads_st.rd_cz, seg.pts[i].z)
  }
  kept_push(roads_st.rd_cx, roads_st.rd_nx[b])
  kept_push(roads_st.rd_cz, roads_st.rd_nz[b])
  if len(seg.handles) > 0 {
    rd_sample_bezier(roads_st, seg, n0)
    return
  }
  let m = len(roads_st.rd_cx)
  var run = 0.0
  for i in 0 .. m - 1 {
    var i0 = i - 1
    if i0 < 0 { i0 = 0 }
    var i3 = i + 2
    if i3 > m - 1 { i3 = m - 1 }
    var last = RD_SUB
    if i < m - 2 { last = RD_SUB - 1 }
    for k in 0 .. last + 1 {
      let t = float(k) / float(RD_SUB)
      let x = rd_cr(roads_st.rd_cx[i0], roads_st.rd_cx[i], roads_st.rd_cx[i + 1], roads_st.rd_cx[i3], t)
      let z = rd_cr(roads_st.rd_cz[i0], roads_st.rd_cz[i], roads_st.rd_cz[i + 1], roads_st.rd_cz[i3], t)
      let n = len(roads_st.rd_px)
      if n > n0 {
        let dx = x - roads_st.rd_px[n - 1]
        let dz = z - roads_st.rd_pz[n - 1]
        run += Math.sqrt(dx * dx + dz * dz)
      }
      if k == 0 { kept_push(roads_st.rd_cs, run) }
      kept_push(roads_st.rd_px, x)
      kept_push(roads_st.rd_pz, z)
      kept_push(roads_st.rd_ps, run)
    }
  }
  kept_push(roads_st.rd_cs, run)
  kept_push(roads_st.rd_sp1, len(roads_st.rd_px))
  kept_push(roads_st.rd_slen, run)
}

function rd_level_of(word: string) -> int {
  if word == "structure" { return ROAD_LEVEL_STRUCTURE }
  if word == "tunnel" { return ROAD_LEVEL_TUNNEL }
  return ROAD_LEVEL_GROUND
}

# the segment's design heights onto the points just sampled (rd_cs holds where its anchors are along it): between two
# anchors that have one the height runs straight, before the first and after the last it stays at theirs. A road
# with no anchor that has one has none (rd_sdesign 0, every height 0). False when `heights` is a list that does not have
# a row for every anchor: the road is then built with no design
function rd_design_seg(roads_st: mut RoadsState, s: RoadSeg, n0: int) -> bool {
  let n1 = len(roads_st.rd_px)
  let m = len(roads_st.rd_cs)
  let fa = new []int
  var right = true
  if len(s.heights) > 0 {
    if len(s.heights) == m {
      for k in 0 .. m { if not s.heights[k].free { push(fa, k) } }
    } else {
      right = false
    }
  }
  kept_push(roads_st.rd_slevel, rd_level_of(s.level))
  if len(fa) == 0 {
    kept_push(roads_st.rd_sdesign, 0)
    for i in n0 .. n1 { kept_push(roads_st.rd_py, 0.0) }
    return right
  }
  kept_push(roads_st.rd_sdesign, 1)
  var j = 0
  for i in n0 .. n1 {
    let at = roads_st.rd_ps[i]
    while j + 1 < len(fa) and roads_st.rd_cs[fa[j + 1]] <= at { j += 1 }
    var y = s.heights[fa[j]].y
    if at <= roads_st.rd_cs[fa[0]] {
      y = s.heights[fa[0]].y
    } else if j + 1 < len(fa) {
      let s0 = roads_st.rd_cs[fa[j]]
      let span = roads_st.rd_cs[fa[j + 1]] - s0
      var t = 0.0
      if span > 0.0001 { t = (at - s0) / span }
      y = s.heights[fa[j]].y + (s.heights[fa[j + 1]].y - s.heights[fa[j]].y) * t
    }
    kept_push(roads_st.rd_py, y)
  }
  return true
}

function rd_skip_seg(roads_st: mut RoadsState, seg: RoadSeg) -> void {
  kept_push(roads_st.rd_sfrom, -1)
  kept_push(roads_st.rd_sto, -1)
  kept_push(roads_st.rd_slf, 0)
  kept_push(roads_st.rd_slb, 0)
  kept_push(roads_st.rd_sw, seg.lane_width)
  kept_push(roads_st.rd_sspeed, seg.speed)
  kept_push(roads_st.rd_sprio, seg.priority)
  kept_push(roads_st.rd_sphase, seg.phase)
  kept_push(roads_st.rd_slevel, rd_level_of(seg.level))
  kept_push(roads_st.rd_sdesign, 0)
  kept_push(roads_st.rd_sp0, len(roads_st.rd_px))
  kept_push(roads_st.rd_sp1, len(roads_st.rd_px))
  kept_push(roads_st.rd_slen, 0.0)
}

function rd_edge_row(roads_st: mut RoadsState, seg: int, back: bool) -> void {
  var from = roads_st.rd_sfrom[seg]
  var to = roads_st.rd_sto[seg]
  var lanes = roads_st.rd_slf[seg]
  if back {
    from = roads_st.rd_sto[seg]
    to = roads_st.rd_sfrom[seg]
    lanes = roads_st.rd_slb[seg]
  }
  if roads_st.rd_slen[seg] <= 0.0 or roads_st.rd_sfrom[seg] < 0 { lanes = 0 }
  kept_push(roads_st.rd_efrom, from)
  kept_push(roads_st.rd_eto, to)
  kept_push(roads_st.rd_elanes, lanes)
  kept_push(roads_st.rd_elen, roads_st.rd_slen[seg])
  kept_push(roads_st.rd_espeed, roads_st.rd_sspeed[seg])
  kept_push(roads_st.rd_eprio, roads_st.rd_sprio[seg])
  kept_push(roads_st.rd_ephase, roads_st.rd_sphase[seg])
  kept_push(roads_st.rd_estop, -1.0)
  kept_push(roads_st.rd_emouth_end, 0.0)
  kept_push(roads_st.rd_emouth_start, 0.0)
  kept_push(roads_st.rd_eclear, RD_CLEAR_OLD)
  kept_push(roads_st.rd_ebase, RD_BASE_OLD)
}

# out[]: the edges leaving each node, and in[]: the edges entering it (compressed rows)
function rd_adjacency(roads_st: mut RoadsState) -> void {
  let nn = len(roads_st.rd_nx)
  let ne = len(roads_st.rd_efrom)
  for n in 0 .. nn + 1 {
    kept_push(roads_st.rd_out_start, 0)
    kept_push(roads_st.rd_in_start, 0)
  }
  for e in 0 .. ne {
    if roads_st.rd_elanes[e] == 0 { continue }
    roads_st.rd_out_start[roads_st.rd_efrom[e] + 1] += 1
    roads_st.rd_in_start[roads_st.rd_eto[e] + 1] += 1
  }
  for n in 0 .. nn {
    roads_st.rd_out_start[n + 1] += roads_st.rd_out_start[n]
    roads_st.rd_in_start[n + 1] += roads_st.rd_in_start[n]
  }
  let total = roads_st.rd_out_start[nn]
  for i in 0 .. total {
    kept_push(roads_st.rd_out, -1)
    kept_push(roads_st.rd_in, -1)
  }
  let fill_out = new []int
  let fill_in = new []int
  for n in 0 .. nn {
    push(fill_out, roads_st.rd_out_start[n])
    push(fill_in, roads_st.rd_in_start[n])
  }
  for e in 0 .. ne {
    if roads_st.rd_elanes[e] == 0 { continue }
    let f = roads_st.rd_efrom[e]
    let t = roads_st.rd_eto[e]
    roads_st.rd_out[fill_out[f]] = e
    fill_out[f] += 1
    roads_st.rd_in[fill_in[t]] = e
    fill_in[t] += 1
  }
}

function rd_rule_of(word: string) -> int {
  if word == "yield" { return ROAD_RULE_YIELD }
  if word == "stop" { return ROAD_RULE_STOP }
  if word == "forbid" { return ROAD_RULE_FORBID }
  return ROAD_RULE_FREE
}

# the edge of segment `seg` that enters node n (in = true) or leaves it, or -1
function rd_edge_at(roads_st: RoadsState, seg: int, n: int, entering: bool) -> int {
  for d in 0 .. 2 {
    let e = 2 * seg + d
    if roads_st.rd_elanes[e] == 0 { continue }
    if entering and roads_st.rd_eto[e] == n { return e }
    if not entering and roads_st.rd_efrom[e] == n { return e }
  }
  return -1
}

# the cell of a coordinate, and the key of a cell
function rd_cell(v: float) -> int { return int(Math.floor(v / RD_GRID)) }
# The key is 30 bits and never negative: an IntMap keeps keys of 0 or more only (a negative key is one of its markers, and a
# table that grows drops it), and a key made by a product of two biased cell numbers wrapped negative in 32 bits on a map of any size.
# Two cells 2^15 cells (1,048 km) apart share a key, which only means a few more steps are scored: the score is exact
function rd_cell_key(cx: int, cz: int) -> int { return (cx & RD_CELL_MASK) * (RD_CELL_MASK + 1) + (cz & RD_CELL_MASK) }

function rd_grid_add(roads_st: mut RoadsState, step: int, seg: int, cx: int, cz: int) -> void {
  let key = rd_cell_key(cx, cz)
  let e = len(roads_st.rd_gstep)
  kept_push(roads_st.rd_gstep, step)
  kept_push(roads_st.rd_gseg, seg)
  kept_push(roads_st.rd_gnext, imap_get(roads_st.rd_gcell, key, -1))
  imap_put(roads_st.rd_gcell, key, e)
}

# every polyline step into each cell its box touches, so a point only looks at the steps near it
function rd_grid_build(roads_st: mut RoadsState) -> void {
  var first = true
  for seg in 0 .. len(roads_st.rd_skey) {
    let p0 = roads_st.rd_sp0[seg]
    let p1 = roads_st.rd_sp1[seg]
    for i in p0 .. p1 - 1 {
      let ax = roads_st.rd_px[i]
      let az = roads_st.rd_pz[i]
      let bx = roads_st.rd_px[i + 1]
      let bz = roads_st.rd_pz[i + 1]
      var x0 = rd_cell(ax)
      var x1 = rd_cell(bx)
      if x1 < x0 {
        x0 = rd_cell(bx)
        x1 = rd_cell(ax)
      }
      var z0 = rd_cell(az)
      var z1 = rd_cell(bz)
      if z1 < z0 {
        z0 = rd_cell(bz)
        z1 = rd_cell(az)
      }
      for cx in x0 .. x1 + 1 {
        for cz in z0 .. z1 + 1 { rd_grid_add(roads_st, i, seg, cx, cz) }
      }
      if first {
        roads_st.rd_gx0 = x0
        roads_st.rd_gx1 = x1
        roads_st.rd_gz0 = z0
        roads_st.rd_gz1 = z1
        first = false
      } else {
        if x0 < roads_st.rd_gx0 { roads_st.rd_gx0 = x0 }
        if x1 > roads_st.rd_gx1 { roads_st.rd_gx1 = x1 }
        if z0 < roads_st.rd_gz0 { roads_st.rd_gz0 = z0 }
        if z1 > roads_st.rd_gz1 { roads_st.rd_gz1 = z1 }
      }
    }
  }
}

# the graph of a map's three tables (loaded with road_nodes_load, road_segs_load, road_turns_load). False, with
# roads_error saying the first fault, when a road names a node that is not there or there are too many roads;
# such a road is left out and the rest is built. Cars are taken off first (their roads are gone)
export function roads_build(roads_st: mut RoadsState, nodes: RoadNodes, segs: RoadSegs, turns: RoadTurns) -> bool {
  roads_take_all(roads_st, ROADS_WHY_REBUILT)
  rd_clear_lists(roads_st)
  roads_st.rd_err = ""
  var ok = true
  for i in 0 .. len(nodes.rows) {
    let n = nodes.rows[i]
    kept_push(roads_st.rd_nkey, n.key)
    kept_push(roads_st.rd_nx, n.x)
    kept_push(roads_st.rd_nz, n.z)
    if n.control == "signal" { kept_push(roads_st.rd_nsignal, 1) } else { kept_push(roads_st.rd_nsignal, 0) }
    kept_push(roads_st.rd_ncycle, n.cycle)
    kept_push(roads_st.rd_nphases, 1)
    kept_push(roads_st.rd_nroads, 0)
    kept_push(roads_st.rd_nuturn, 0.0)
  }
  var nsegs = len(segs.rows)
  if nsegs > RD_MAX_SEGS {
    roads_st.rd_err = `{nsegs} roads is more than {RD_MAX_SEGS}`
    nsegs = RD_MAX_SEGS
    ok = false
  }
  for i in 0 .. nsegs {
    let s = segs.rows[i]
    kept_push(roads_st.rd_skey, s.key)
    let a = road_nodes_find(nodes, s.from)
    let b = road_nodes_find(nodes, s.to)
    if a < 0 or b < 0 {
      if ok { roads_st.rd_err = `road {s.key}: there is no node {s.from} or {s.to}` }
      ok = false
      rd_skip_seg(roads_st, s)
      continue
    }
    kept_push(roads_st.rd_sfrom, a)
    kept_push(roads_st.rd_sto, b)
    kept_push(roads_st.rd_slf, s.lanes_fwd)
    kept_push(roads_st.rd_slb, s.lanes_back)
    kept_push(roads_st.rd_sw, s.lane_width)
    kept_push(roads_st.rd_sspeed, s.speed)
    kept_push(roads_st.rd_sprio, s.priority)
    kept_push(roads_st.rd_sphase, s.phase)
    rd_sample_seg(roads_st, s, a, b)
    if not rd_design_seg(roads_st, s, roads_st.rd_sp0[len(roads_st.rd_sp0) - 1]) {
      if ok { roads_st.rd_err = `road {s.key}: heights has {len(s.heights)} rows and the road {len(roads_st.rd_cs)} anchors (from, each point, to): built with no design heights` }
      ok = false
    }
    roads_st.rd_nroads[a] += 1
    roads_st.rd_nroads[b] += 1
    if s.phase + 1 > roads_st.rd_nphases[a] { roads_st.rd_nphases[a] = s.phase + 1 }
    if s.phase + 1 > roads_st.rd_nphases[b] { roads_st.rd_nphases[b] = s.phase + 1 }
  }
  for i in 0 .. nsegs {
    rd_edge_row(roads_st, i, false)
    rd_edge_row(roads_st, i, true)
  }
  rd_adjacency(roads_st)
  for i in 0 .. len(turns.rows) {
    let t = turns.rows[i]
    let n = road_nodes_find(nodes, t.node)
    let sf = road_segs_find(segs, t.from)
    let st = road_segs_find(segs, t.to)
    if n < 0 or sf < 0 or st < 0 or sf >= nsegs or st >= nsegs {
      if ok { roads_st.rd_err = `turn {t.key}: it names a node or a road that is not there` }
      ok = false
      continue
    }
    let e_in = rd_edge_at(roads_st, sf, n, true)
    let e_out = rd_edge_at(roads_st, st, n, false)
    if e_in < 0 or e_out < 0 {
      if ok { roads_st.rd_err = `turn {t.key}: road {t.from} does not come in to {t.node} or {t.to} does not leave it` }
      ok = false
      continue
    }
    imap_put(roads_st.rd_turns, e_in * RD_TURN_KEY + e_out, rd_rule_of(t.rule))
  }
  rd_grid_build(roads_st)
  let ne = len(roads_st.rd_efrom)
  List.clear(roads_st.rd_dist)
  List.clear(roads_st.rd_prev)
  List.clear(roads_st.rd_head)
  for e in 0 .. ne {
    kept_push(roads_st.rd_dist, 0.0)
    kept_push(roads_st.rd_prev, -1)
    kept_push(roads_st.rd_head, -1)
  }
  return ok
}

export function roads_error(roads_st: RoadsState) -> string { return roads_st.rd_err }

# the graph emptied (the map is leaving)
export function roads_clear(roads_st: mut RoadsState) -> void {
  roads_take_all(roads_st, ROADS_WHY_REBUILT)
  rd_clear_lists(roads_st)
  roads_st.rd_err = ""
}

# which side of the road the game drives on (the lanes are mirrored)
export function roads_config_drive_left(roads_st: mut RoadsState, left: bool) -> void { roads_st.rd_drive_left = left }

# Junctions with a size. A node in the plan is a point, but its junction on the ground reaches some metres along each road:
# where a car's turn path begins and ends (the mouths), where it waits to be let in (its front `stop` metres short of the end,
# so before a crossing at the mouth) and where its rear has left the node behind (`clear` metres into the road it turned onto).
# Edge e's `stop` and `mouth_end` are at its end (its `to` node), `mouth_start` and `clear` at its start (its `from` node).
# A stop is never short of the mouth, nor a clear inside it; the two ends of a short road are scaled down to fit it (each end
# gets at most its share of the road, less a metre between). Before this is set a road keeps the old rule: no turn path (a
# car goes from one road's lane to the next at the node), a wall 1.5 m short of the end, clear a metre in
export function roads_edge_setbacks(roads_st: mut RoadsState, e: int, stop: float, mouth_end: float, mouth_start: float, clear: float) -> void {
  if e < 0 or e >= len(roads_st.rd_efrom) { return }
  let len_e = roads_st.rd_elen[e]
  var me = Math.max(mouth_end, 0.0)
  var st = Math.max(stop, me)
  var ms = Math.max(mouth_start, 0.0)
  var cl = Math.max(clear, ms)
  let room = Math.max(len_e - 1.0, 0.0)
  if st + cl > room and st + cl > 0.0 {
    let k = room / (st + cl)
    st = st * k
    cl = cl * k
    me = Math.min(me, st)
    ms = Math.min(ms, cl)
  }
  roads_st.rd_estop[e] = st
  roads_st.rd_emouth_end[e] = me
  roads_st.rd_emouth_start[e] = ms
  roads_st.rd_eclear[e] = cl
}

# where lane 0 of edge e begins: `base` metres right of the centre line (seen along e), each lane `lane_width` wide beyond it.
# A road painted with a median has half of it here; a one way road painted on the right of its line has 0 (the old rule
# centres a one way road on its line and starts a two way road's lanes at the line)
export function roads_edge_lane_base(roads_st: mut RoadsState, e: int, base: float) -> void {
  if e < 0 or e >= len(roads_st.rd_efrom) { return }
  roads_st.rd_ebase[e] = base
}

# a U-turn at node n (a dead end) loops round the node at radius r: a turning circle's round, kept inside its kerb by the game.
# 0 (and any radius not wider than the lanes) is a hairpin between the two lanes
export function roads_node_uturn(roads_st: mut RoadsState, n: int, r: float) -> void {
  if n < 0 or n >= len(roads_st.rd_nuturn) { return }
  roads_st.rd_nuturn[n] = Math.max(r, 0.0)
}

# 0 (the default): a junction lets one car in at a time. More: it lets in every car whose turn path stays `width` metres from
# the paths of the cars in it (two paths that end in the same lane always meet)
export function roads_config_conflict(roads_st: mut RoadsState, width: float) -> void { roads_st.rd_conflict_w = Math.max(width, 0.0) }

# a car slows for a turn path so that it keeps under `acc` m/s2 across it (0, the default: no limit)
export function roads_config_turn_accel(roads_st: mut RoadsState, acc: float) -> void { roads_st.rd_turn_acc = Math.max(acc, 0.0) }

# seconds a car may stand before it is taken off with ROADS_JAMMED (default 90; 0: never, the game decides)
export function roads_config_jam(roads_st: mut RoadsState, seconds: float) -> void { roads_st.rd_jam_limit = Math.max(seconds, 0.0) }
