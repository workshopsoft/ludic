# native.ludic - the hand-written shim's symbols (native/shim/steamshim.cpp). What crosses is int, long, float,
# strings and opaque pointers. None of it is exported.
extern function lsx_init(app_id: int, dev: int) -> int = "lsx_init"
extern function lsx_error(buf: pointer, cap: int) -> int = "lsx_error"
extern function lsx_shutdown() -> void = "lsx_shutdown"
extern function lsx_pump() -> void = "lsx_pump"
extern function lsx_poll() -> int = "lsx_poll"
extern function lsx_fi(k: int) -> int = "lsx_fi"
extern function lsx_fl(k: int) -> long = "lsx_fl"
extern function lsx_ftext(buf: pointer, cap: int) -> int = "lsx_ftext"
extern function lsx_lost() -> int = "lsx_lost"
extern function lsx_friend_game(id: long) -> int = "lsx_friend_game"
extern function lsx_friend_game_id() -> long = "lsx_friend_game_id"
extern function lsx_friend_game_lobby() -> long = "lsx_friend_game_lobby"
extern function lsx_lb_count() -> int = "lsx_lb_count"
extern function lsx_lb_user(i: int) -> long = "lsx_lb_user"
extern function lsx_lb_score(i: int) -> int = "lsx_lb_score"
extern function lsx_lb_rank(i: int) -> int = "lsx_lb_rank"
extern function lsx_input_controllers() -> int = "lsx_input_controllers"
extern function lsx_input_controller(i: int) -> long = "lsx_input_controller"
extern function lsx_input_digital(controller: long, action: long) -> int = "lsx_input_digital"
extern function lsx_input_analog(controller: long, action: long, xy: pointer) -> int = "lsx_input_analog"
extern function lsx_net_start() -> void = "lsx_net_start"
extern function lsx_net_allow(id: long) -> void = "lsx_net_allow"
extern function lsx_net_accept_any(on: int) -> void = "lsx_net_accept_any"
extern function lsx_net_send(to: long, data: pointer, n: int, reliable: int, channel: int) -> int = "lsx_net_send"
extern function lsx_net_recv(buf: pointer, cap: int, channel: int) -> int = "lsx_net_recv"
extern function lsx_net_from() -> long = "lsx_net_from"
extern function lsx_net_close(id: long) -> void = "lsx_net_close"
