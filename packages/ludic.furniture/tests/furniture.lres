# furniture.lres - a test game's furniture: floor pieces, a table things stand on, a lamp for its top, a
# picture for a wall, a chandelier for the ceiling, a statue that turns to any angle
chair { category: FCAT_SEATING, w: 0.5, d: 0.5, h: 1.0, price: 100, cost: 1 }
table { category: FCAT_DECOR, w: 2.0, d: 1.0, h: 0.8, price: 400, cost: 2, stackable: true }
sofa { category: FCAT_SEATING, w: 2.0, d: 0.9, h: 0.9, price: 900, cost: 3, refund_pct: 40 }
lamp { category: FCAT_DECOR, place: "surface", w: 0.3, d: 0.3, h: 0.5, price: 50, cost: 1 }
picture { category: FCAT_DECOR, place: "wall", w: 0.8, d: 0.05, h: 0.6, price: 60, cost: 1 }
chandelier { category: FCAT_DECOR, place: "ceiling", w: 0.6, d: 0.6, h: 0.5, price: 300, cost: 2 }
statue { category: FCAT_DECOR, w: 0.6, d: 0.6, h: 1.5, price: 500, cost: 2, yaw_steps: 0 }
