/* PhoneHome.lss - a wrapping grid of apps */
.home { padding: 20px 12px; gap: 12px; width: fill }
.empty { color: var(--ph-muted, #93a0b2) }
.app:focus-visible .app:hover .icon { width: 36px; height: 36px }
.badge { position: absolute; top: -6px; right: -6px; padding: 0 6px; font-size: 11px; background: var(--ph-bad, #ea5d5d); color: #fff }
.name { height: 16px; font-size: 12px; text-align: center; text-overflow: ellipsis; white-space: nowrap }
.grid { flex-wrap: wrap; gap: 14px 6px; justify-content: start }
.app { flex-direction: column; height: 88px; width: 66px; gap: 6px; align-items: center; background: transparent; color: var(--ph-text, #eef2f7) }
.app:focus-visible .tile { outline: 3px solid var(--ph-accent, #E8B04A) }
.tile { width: 58px; height: 58px; align-items: center; justify-content: center; border-radius: var(--ph-tile-radius, 14px); background: var(--ph-t0, #E8B04A) }
.t1 { background: var(--ph-t1, #7FB2D9) } .t2 { background: var(--ph-t2, #6FCF97) } .t3 { background: var(--ph-t3, #E06C75) }
.t4 { background: var(--ph-t4, #B48EAD) } .t5 { background: var(--ph-t5, #56B6C2) } .t6 { background: var(--ph-t6, #D19A66) } .t7 { background: var(--ph-t7, #8A9BF0) }
.glyph { font-size: 24px; color: var(--ph-ink, #0b0e13) }
