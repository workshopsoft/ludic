/* PhoneStatus.lss */
.status { height: 26px; padding: 0 14px; gap: 8px; align-items: center; background: var(--ph-ink, #0b0e13); color: var(--ph-text, #eef2f7) }
.clock { font-size: 13px }
.grow { flex-grow: 1 }
.unread { padding: 0 6px; font-size: 11px; background: var(--ph-accent, #4ea1ff); color: var(--ph-ink, #0b0e13) }
.bars { gap: 2px; align-items: end; height: 14px }
.bar { width: 4px; background: var(--ph-line, #2c3542) }
.bar.on { background: var(--ph-text, #eef2f7) }
.b0 { height: 4px }
.b1 { height: 7px }
.b2 { height: 10px }
.b3 { height: 14px }
.battery { font-size: 12px; color: var(--ph-muted, #93a0b2) }
.battery.low { color: var(--ph-bad, #ea5d5d) }
