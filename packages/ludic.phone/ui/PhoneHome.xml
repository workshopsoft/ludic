<section class="home">
  <if test="{len(apps) == 0}"><p class="empty">{t('phone.home.empty')}</p></if>
  <row class="grid">
    <each in="{apps}" as="a" index="i">
      <button class="app" autofocus="{i == 0}" on-click="open(i)">
        <div class="tile">
          <if test="{a.icon != ''}"><img class="icon" src="{a.icon}"/></if>
          <if test="{a.icon == ''}"><strong class="initial">{a.title}</strong></if>
          <if test="{a.badge > 0}"><small class="badge">{a.badge}</small></if>
        </div>
        <small class="name">{a.title}</small>
      </button>
    </each>
  </row>
</section>
