# character_test.ludic - a body on a fake world: flat meadow, a 45 cm deck, a gentle rise and a cliff,
# a boulder with a step on top, and a lake that shelves. The step against the slope at every frame
# rate, wading into a swim and out, the dive and the breath, the jump, sitting, holds, the safe
# spot, riding and the camera. The walk is a real Jolt walker (ludic.physics) on the same world.
import "ludic.character"
import "ludic.base"
import "ludic.physics"
program CharacterTest {
  numbers float
  function wpose(physics_st: mut PhysicsState, id: int, p: PhysWalk) -> PhysWalk {
    if not phys_walker_pose(physics_st, id, p) { return null }
    return p
  }

  # the world: x in 4..8 is a deck 45 cm up; z < -10 a cliff; z > 10 a gentle rise; x > 20 the lake
  function fk_height(x: float, z: float) -> float {
    if x > 4.0 and x < 8.0 and z > -2.0 and z < 2.0 { return 0.45 }
    return fk_land(x, z)
  }
  function fk_land(x: float, z: float) -> float {
    if x > 20.0 { return -(x - 20.0) * 0.5 }
    if z < -10.0 { return (-10.0 - z) * 2.0 }
    if z > 10.0 { return (z - 10.0) * 0.3 }
    return 0.0
  }
  # the lake's surface is at 0; in the band z -7 .. -3 a tube runs under it, its roof half a metre down: a body lower than that
  # there is sealed off from the water (the height says which level)
  function fk_water(x: float, y: float, z: float) -> float {
    if x <= 19.0 { return -10000.0 }
    if z > -7.0 and z < -3.0 and y < -0.5 { return -10000.0 }
    return 0.0
  }
  # a boulder at (0, 6), a metre round and 40 cm high, and a pillar at (-6, 0)
  state CharacterTestState {
    px: float = 0.0
    pz: float = 0.0
    riding: bool = false
    rides: int = 0
    sneaking: bool = false
    strafe: bool = false
    pace: float = 1.0
    mz: float = 0.0
    boots: float = 1.05
    walker: int = -1
    wx: float = 0.0
    wy: float = 0.0
    wz: float = 0.0
    pose: PhysWalk = new PhysWalk     # one record the fake reads the walker's pose into, so a frame makes nothing
  }
  function fk_ring(character_test_st: mut CharacterTestState, x: float, z: float, cx: float, cz: float, r: float) -> bool {
    let dx = x - cx
    let dz = z - cz
    let d = Math.sqrt(dx * dx + dz * dz)
    if d >= r { return false }
    let k = r / Math.max(d, 0.001)
    character_test_st.px = cx + dx * k
    character_test_st.pz = cz + dz * k
    return true
  }
  function fk_push(character_test_st: mut CharacterTestState, x: float, z: float, r: float, y0: float, y1: float) -> bool {
    if y0 < 0.4 and fk_ring(character_test_st, x, z, 0.0, 6.0, 1.0 + r) { return true }
    return fk_ring(character_test_st, x, z, -6.0, 0.0, 0.5 + r)
  }
  function fk_px(character_test_st: CharacterTestState) -> float { return character_test_st.px }
  function fk_pz(character_test_st: CharacterTestState) -> float { return character_test_st.pz }
  function fk_top(x: float, z: float, r: float, from_y: float, step: float, base: float) -> float {
    let dx = x
    let dz = z - 6.0
    if dx * dx + dz * dz < 1.0 and 0.4 - from_y <= step { return 0.4 }
    return base
  }

  let eyes: bool = true
  function fk_riding(character_test_st: CharacterTestState) -> bool { return character_test_st.riding }
  function fk_ride(character_test_st: mut CharacterTestState, ix: float, iz: float, run: bool, dt: float) -> void { character_test_st.rides += 1 }
  function fk_sneak(character_test_st: CharacterTestState) -> bool { return character_test_st.sneaking }
  function fk_strafe(character_test_st: CharacterTestState) -> bool { return character_test_st.strafe }
  function fk_pace(character_test_st: CharacterTestState) -> float { return character_test_st.pace }
  function fk_eyes() -> bool { return eyes }

  function fk_move_z(character_test_st: CharacterTestState) -> float { return character_test_st.mz }

  # the same world in Jolt: the land as a heightfield, the deck a box, the boulder a 40 cm drum and
  # the pillar a post
  function fk_jolt(physics_st: mut PhysicsState) -> int {
    phys_open(physics_st, 256, 1)
    let n = 128
    let h = floats(n * n)
    for j in 0 .. n { for i in 0 .. n { h[j * n + i] = fk_land(float(i) - 40.0, float(j) - 60.0) } }
    phys_ground_add(physics_st, phys_heightfield(physics_st, h, n, -40.0, -60.0, 1.0))
    phys_static_add(physics_st, phys_offset(physics_st, phys_box(physics_st, 2.0, 0.225, 2.0), 0.0, 0.225, 0.0, 0.0), 6.0, 0.0, 0.0, 0.0)
    phys_static_add(physics_st, phys_offset(physics_st, phys_cylinder(physics_st, 0.2, 1.0), 0.0, 0.2, 0.0, 0.0), 0.0, 0.0, 6.0, 0.0)
    phys_static_add(physics_st, phys_offset(physics_st, phys_cylinder(physics_st, 3.0, 0.5), 0.0, 3.0, 0.0, 0.0), -6.0, 0.0, 0.0, 0.0)
    phys_settle(physics_st)
    return phys_walker_add(physics_st, 0.35, CHAR_BODY, 0.0, 0.0, 0.0, 50.0, 70.0)
  }
  function fk_walk(physics_st: mut PhysicsState, character_test_st: mut CharacterTestState, x: float, y: float, z: float, vx: float, vz: float, jump: float, step: float, slope: float, dt: float) -> int {
    if character_test_st.walker < 0 { character_test_st.walker = fk_jolt(physics_st) }
    let g = phys_walker_move(physics_st, character_test_st.walker, x, y, z, vx, vz, jump, step, slope, dt)
    let p = wpose(physics_st, character_test_st.walker, character_test_st.pose)
    character_test_st.wx = p.x
    character_test_st.wy = p.y
    character_test_st.wz = p.z
    return g
  }
  function fk_wx(character_test_st: CharacterTestState) -> float { return character_test_st.wx }
  function fk_wy(character_test_st: CharacterTestState) -> float { return character_test_st.wy }
  function fk_wz(character_test_st: CharacterTestState) -> float { return character_test_st.wz }
  function fk_boots(character_test_st: CharacterTestState) -> float { return character_test_st.boots }

  bind CharacterGround { height: fn fk_height, bed: fn fk_land, water: fn fk_water, push: fn fk_push, pushed_x: fn fk_px, pushed_z: fn fk_pz, top_at: fn fk_top, walk: fn fk_walk, walked_x: fn fk_wx, walked_y: fn fk_wy, walked_z: fn fk_wz, slope_limit: fn fk_boots }
  bind CharacterBody { riding: fn fk_riding, ride: fn fk_ride, sneaking: fn fk_sneak, strafe: fn fk_strafe, pace: fn fk_pace, eyes_ok: fn fk_eyes }
  bind CharacterInput { move_z: fn fk_move_z }

  function fresh(character_st: mut CharacterState, x: float, z: float, yaw: float) -> void {
    char_reset(character_st)
    char_release(character_st, CHAR_HOLD_SCREEN)
    char_teleport(character_st, x, z, yaw)
  }
  function facts(character_st: CharacterState) -> []CharacterFact { return q_drain(char_facts(character_st)) }
  function count(fs: []CharacterFact, what: int) -> int {
    var n = 0
    for i in 0 .. len(fs) { if fs[i].what == what { n += 1 } }
    return n
  }
  # walk the stick straight ahead (the camera looks where the body faces) for `secs`
  function walk(character_st: mut CharacterState, secs: float, hz: float, run: bool) -> void {
    let n = int(secs * hz)
    for i in 0 .. n { char_update(character_st, 0.0, 1.0, run, false, 0.0, 0.0, 1.0 / hz) }
  }
  # yaw 0 faces -z; the heading of a walk toward +x is -pi/2
  const EAST: float = -1.5707963
  const SOUTH: float = 3.14159265

  test "a 45 cm deck is a step at 60 Hz and at 240" (character_st: mut CharacterState) {
    fresh(character_st, 1.0, 0.0, EAST)
    walk(character_st, 2.0, 60.0, false)
    expect(body_x(character_st) > 5.0)
    expect_near(body_y(character_st), 0.45, 0.01)
    fresh(character_st, 1.0, 0.0, EAST)
    walk(character_st, 2.0, 240.0, false)
    expect(body_x(character_st) > 5.0)
    expect_near(body_y(character_st), 0.45, 0.01)
    expect_eq(count(facts(character_st), CHAR_TOO_STEEP), 0)
  }

  test "a cliff is refused at the same place whatever the frame rate, and said once" (character_st: mut CharacterState) {
    fresh(character_st, 0.0, -8.0, 0.0)
    walk(character_st, 3.0, 30.0, false)
    let at30 = body_z(character_st)
    expect(body_steep(character_st) > 0.0)
    expect_eq(count(facts(character_st), CHAR_TOO_STEEP), 1)
    fresh(character_st, 0.0, -8.0, 0.0)
    walk(character_st, 3.0, 240.0, false)
    expect_near(body_z(character_st), at30, 0.25)
    expect(body_z(character_st) > -10.0)
    expect(body_y(character_st) < 0.3)
  }

  test "a gentle rise is walked up" (character_st: mut CharacterState) {
    fresh(character_st, 0.0, 8.0, SOUTH)
    walk(character_st, 3.0, 60.0, false)
    expect(body_z(character_st) > 14.0)
    expect(body_y(character_st) > 1.0)
  }

  test "the boots set the limit: a rise they cannot take is refused" (character_st: mut CharacterState, character_test_st: mut CharacterTestState) {
    character_test_st.boots = 0.2
    fresh(character_st, 0.0, 8.0, SOUTH)
    walk(character_st, 3.0, 60.0, false)
    expect(body_z(character_st) < 11.5)
    expect(body_y(character_st) < 0.45)
    expect(count(facts(character_st), CHAR_TOO_STEEP) >= 1)
  }

  test "the walk reaches the walk speed, the run the run speed, a sneak its own" (character_st: mut CharacterState, character_test_st: mut CharacterTestState) {
    fresh(character_st, 0.0, 0.0, SOUTH)
    walk(character_st, 2.0, 60.0, false)
    expect_near(body_speed(character_st), 3.2, 0.05)
    fresh(character_st, 0.0, 0.0, SOUTH)
    walk(character_st, 2.0, 60.0, true)
    expect_near(body_speed(character_st), 6.8, 0.05)
    character_test_st.pace = 0.5
    fresh(character_st, 0.0, 0.0, SOUTH)
    walk(character_st, 2.0, 60.0, false)
    expect_near(body_speed(character_st), 1.6, 0.05)
    character_test_st.pace = 1.0
    character_test_st.sneaking = true
    fresh(character_st, 0.0, 0.0, SOUTH)
    walk(character_st, 2.0, 60.0, true)
    expect_near(body_speed(character_st), 1.3, 0.05)
  }

  # the stick (ix across, iz ahead) for `secs` at 60 Hz
  function move(character_st: mut CharacterState, ix: float, iz: float, secs: float, run: bool) -> void {
    for i in 0 .. int(secs * 60.0) { char_update(character_st, ix, iz, run, false, 0.0, 0.0, 1.0 / 60.0) }
  }
  function sig(character_st: CharacterState, name: string) -> float {
    let i = sig_find(name)
    expect(i >= 0)
    expect(sig_problem(i) == "")
    return SignalSources[i].get(0, SignalSources[i].arg)
  }

  test "a held crouch is its own gait and speed, and character.crouch says it" (character_st: mut CharacterState) {
    fresh(character_st, 0.0, 0.0, SOUTH)
    expect_near(sig(character_st, "character.crouch"), 0.0, 0.001)
    char_crouch(character_st, true)
    move(character_st, 0.0, 1.0, 2.0, true)
    expect_near(body_speed(character_st), 1.3, 0.05)
    expect(sig(character_st, "character.crouch") > 0.95)
    expect_eq(body_gait(character_st), 1)
    char_config_gaits(character_st, 2.0, 0.0)
    move(character_st, 0.0, 1.0, 2.0, true)
    expect_near(body_speed(character_st), 2.0, 0.05)
    char_crouch(character_st, false)
    move(character_st, 0.0, 1.0, 2.0, false)
    expect(sig(character_st, "character.crouch") < 0.05)
    expect_near(body_speed(character_st), 3.2, 0.05)
  }

  test "the game's sneaking port is the same stance" (character_st: mut CharacterState, character_test_st: mut CharacterTestState) {
    character_test_st.sneaking = true
    fresh(character_st, 0.0, 0.0, SOUTH)
    move(character_st, 0.0, 1.0, 1.0, false)
    expect(sig(character_st, "character.crouch") > 0.9)
  }

  test "a sprint tier has its own speed and gait, and does nothing until the body is given one" (character_st: mut CharacterState) {
    fresh(character_st, 0.0, 0.0, SOUTH)
    char_sprint(character_st, true)
    move(character_st, 0.0, 1.0, 2.0, true)
    expect_near(body_speed(character_st), 6.8, 0.05)
    expect_near(sig(character_st, "character.sprint"), 0.0, 0.001)
    expect_eq(body_gait(character_st), 2)
    expect_near(sig(character_st, "character.gait"), 2.0, 0.001)
    char_config_gaits(character_st, 1.3, 9.0)
    move(character_st, 0.0, 1.0, 3.0, true)
    expect_near(body_speed(character_st), 9.0, 0.05)
    expect(sig(character_st, "character.sprint") > 0.95)
    expect_near(sig(character_st, "character.gait"), 3.0, 0.001)
    # sprint alone is enough (no run held); letting go drops back to the walk
    char_sprint(character_st, false)
    move(character_st, 0.0, 1.0, 4.0, false)
    expect_near(body_speed(character_st), 3.2, 0.05)
    expect(sig(character_st, "character.sprint") < 0.05)
    expect_near(sig(character_st, "character.gait"), 1.0, 0.001)
    expect_near(sig(character_st, "character.gait") - float(body_gait(character_st)), 0.0, 0.001)
  }

  test "a load slows every gait by its multiplier, takes the run, the sprint and the jump away as it says, and char_reset clears it" (character_st: mut CharacterState) {
    fresh(character_st, 0.0, 0.0, SOUTH)
    expect(not body_loaded(character_st))
    char_set_load(character_st, 0.8, false, true)
    expect(body_loaded(character_st))
    walk(character_st, 2.0, 60.0, false)
    expect_near(body_speed(character_st), 3.2 * 0.8, 0.05)
    # the run held: no faster than the loaded walk
    walk(character_st, 2.0, 60.0, true)
    expect_near(body_speed(character_st), 3.2 * 0.8, 0.05)
    # nor a sprint
    char_config_gaits(character_st, 1.3, 9.0)
    char_sprint(character_st, true)
    move(character_st, 0.0, 1.0, 2.0, true)
    expect_near(body_speed(character_st), 3.2 * 0.8, 0.05)
    char_sprint(character_st, false)
    # a jump with a small box leaves the ground; a heavy one's does not
    for i in 0 .. 30 { char_update(character_st, 0.0, 0.0, false, i == 0, 0.0, 0.0, 1.0 / 60.0) }
    expect(count(facts(character_st), CHAR_JUMPED) == 1)
    for i in 0 .. 90 { char_update(character_st, 0.0, 0.0, false, false, 0.0, 0.0, 1.0 / 60.0) }
    char_set_load(character_st, 0.6, false, false)
    q_clear(char_facts(character_st))
    for i in 0 .. 30 { char_update(character_st, 0.0, 0.0, false, i == 0, 0.0, 0.0, 1.0 / 60.0) }
    expect(count(facts(character_st), CHAR_JUMPED) == 0)
    walk(character_st, 2.0, 60.0, false)
    expect_near(body_speed(character_st), 3.2 * 0.6, 0.05)
    # nothing in the arms again: the walk and the run are back
    char_set_load(character_st, 1.0, true, true)
    expect(not body_loaded(character_st))
    walk(character_st, 2.0, 60.0, true)
    expect_near(body_speed(character_st), 6.8, 0.05)
    char_set_load(character_st, 0.5, false, false)
    char_reset(character_st)
    expect(not body_loaded(character_st))
    expect_near(body_load(character_st), 1.0, 0.0001)
  }

  test "character.direction is the motion against the facing: nothing while the body turns to its way, real when it strafes" (character_st: mut CharacterState, character_test_st: mut CharacterTestState) {
    fresh(character_st, 0.0, 0.0, SOUTH)
    move(character_st, 1.0, 0.0, 2.0, false)
    expect_near(sig(character_st, "character.direction"), 0.0, 0.001)
    character_test_st.strafe = true
    # facing the camera's way: ahead 0, right -0.5, left +0.5, back 1 (or -1)
    fresh(character_st, 0.0, 0.0, SOUTH)
    move(character_st, 0.0, 1.0, 1.5, false)
    expect_near(sig(character_st, "character.direction"), 0.0, 0.02)
    fresh(character_st, 0.0, 0.0, SOUTH)
    move(character_st, 1.0, 0.0, 1.5, false)
    expect_near(sig(character_st, "character.direction"), -0.5, 0.02)
    expect(body_speed(character_st) > 3.0)
    fresh(character_st, 0.0, 0.0, SOUTH)
    move(character_st, -1.0, 0.0, 1.5, false)
    expect_near(sig(character_st, "character.direction"), 0.5, 0.02)
    fresh(character_st, 0.0, 0.0, SOUTH)
    move(character_st, 0.0, -1.0, 1.5, false)
    expect_near(Math.abs(sig(character_st, "character.direction")), 1.0, 0.02)
    # the body really moved sideways: facing held, position off the facing line
    fresh(character_st, 0.0, 0.0, SOUTH)
    move(character_st, 1.0, 0.0, 1.0, false)
    expect_near(body_yaw(character_st), SOUTH, 0.01)
    expect(Math.abs(body_x(character_st)) > 1.5)
    # standing again eases it back to nothing
    move(character_st, 0.0, 0.0, 2.0, false)
    expect_near(sig(character_st, "character.direction"), 0.0, 0.02)
  }

  test "a knee-high boulder is a step onto its top, and a post is a wall" (character_st: mut CharacterState) {
    fresh(character_st, 0.0, 3.0, SOUTH)
    walk(character_st, 1.3, 60.0, false)
    expect(body_z(character_st) > 5.2)
    expect_near(body_y(character_st), 0.4, 0.03)
    fresh(character_st, -3.0, 0.0, -EAST)
    walk(character_st, 2.0, 60.0, false)
    expect(body_x(character_st) > -5.2)
    expect_near(char_stand_at(0.0, 6.0, 0.0), 0.4, 0.001)
    expect_near(char_stand_at(3.0, 6.0, 0.0), 0.0, 0.001)
    # and the world's own ground never includes it
    expect_near(fk_height(0.0, 6.0), 0.0, 0.001)
  }

  test "wading shelves into a swim, and the shallows give the ground back" (character_st: mut CharacterState) {
    fresh(character_st, 18.0, 0.0, EAST)
    walk(character_st, 3.0, 60.0, false)
    let fs = facts(character_st)
    expect(body_swimming(character_st))
    expect_eq(count(fs, CHAR_STARTED_SWIMMING), 1)
    expect_near(body_y(character_st), -0.30, 0.06)
    expect(body_breath(character_st) > 40.0)
    char_face(character_st, -EAST)
    char_look(character_st, -EAST, 0.0)
    walk(character_st, 8.0, 60.0, false)
    expect(not body_swimming(character_st))
    expect_eq(count(facts(character_st), CHAR_LEFT_WATER), 1)
  }

  test "the water is asked at the body's height: a body the water is sealed from (a tube under the lake) walks on and never swims" (character_st: mut CharacterState) {
    fresh(character_st, 18.0, -5.0, EAST)
    walk(character_st, 4.0, 60.0, false)
    expect(not body_swimming(character_st))
    expect_eq(count(facts(character_st), CHAR_STARTED_SWIMMING), 0)
    expect(body_x(character_st) > 22.5)
    expect(body_y(character_st) < -1.4)                    # deeper than a wade, on the bed: no lake for it
    expect(body_water(character_st) < -9000.0)
    # the same walk beside the tube swims
    fresh(character_st, 18.0, 0.0, EAST)
    walk(character_st, 4.0, 60.0, false)
    expect(body_swimming(character_st))
  }

  test "the jump held dives, the air runs out, and the body surfaces" (character_st: mut CharacterState) {
    fresh(character_st, 30.0, 0.0, 0.0)
    char_resume_swim(character_st, false, 0.0, 2.0)
    for i in 0 .. 600 { char_update(character_st, 0.0, 0.0, false, true, 0.0, 0.0, 1.0 / 60.0) }
    let fs = facts(character_st)
    expect(count(fs, CHAR_OUT_OF_AIR) > 0)
    for i in 0 .. 300 { char_update(character_st, 0.0, 0.0, false, false, 0.0, 0.0, 1.0 / 60.0) }
    expect(body_depth(character_st) < 0.05)
    expect(body_breath(character_st) > 10.0)
  }

  test "a jump leaves the ground, falls, lands, and says both" (character_st: mut CharacterState) {
    fresh(character_st, 0.0, 0.0, 0.0)
    char_update(character_st, 0.0, 0.0, false, true, 0.0, 0.0, 1.0 / 60.0)
    expect(body_airborne(character_st))
    var guard = 0
    while body_airborne(character_st) and guard < 200 {
      char_update(character_st, 0.0, 0.0, false, false, 0.0, 0.0, 1.0 / 60.0)
      guard += 1
    }
    let fs = facts(character_st)
    expect(not body_airborne(character_st))
    expect_eq(count(fs, CHAR_JUMPED), 1)
    expect_eq(count(fs, CHAR_LANDED), 1)
    expect(guard > 30)
    char_allow_run(character_st, false)
    char_update(character_st, 0.0, 0.0, false, true, 0.0, 0.0, 1.0 / 60.0)
    expect(not body_airborne(character_st))
  }

  test "a jump against a wall stays in the air while it only brushes the wall (UNSUPPORTED), and lands once, on the ground" (character_st: mut CharacterState) {
    # the tall post at (-6, 0): its face at x -5.5; facing west, the body walks into it and jumps
    fresh(character_st, -4.8, 0.0, 1.5707963)
    for i in 0 .. 60 { char_update(character_st, 0.0, 1.0, false, false, 0.0, 0.0, 1.0 / 60.0) }
    facts(character_st)
    char_update(character_st, 0.0, 1.0, false, true, 0.0, 0.0, 1.0 / 60.0)
    var guard = 0
    while body_airborne(character_st) and guard < 200 {
      char_update(character_st, 0.0, 1.0, false, false, 0.0, 0.0, 1.0 / 60.0)
      guard += 1
    }
    expect(guard > 20)
    expect(body_y(character_st) < 0.05)
    expect_eq(count(facts(character_st), CHAR_LANDED), 1)
  }

  test "a knock-back carries the body off its feet, and a post stops it" (character_st: mut CharacterState) {
    fresh(character_st, 0.0, -2.0, 0.0)
    char_knock(character_st, 0.0, 5.0, 3.0)
    char_update(character_st, 0.0, 0.0, false, false, 0.0, 0.0, 1.0 / 60.0)
    expect(body_airborne(character_st))
    for i in 0 .. 120 { char_update(character_st, 0.0, 0.0, false, false, 0.0, 0.0, 1.0 / 60.0) }
    expect(not body_airborne(character_st))
    expect(body_z(character_st) > 0.5)
    fresh(character_st, -3.5, 0.0, 0.0)
    char_knock(character_st, -8.0, 0.0, 2.0)
    for i in 0 .. 120 { char_update(character_st, 0.0, 0.0, false, false, 0.0, 0.0, 1.0 / 60.0) }
    expect(body_x(character_st) > -5.2)
  }

  test "the safe spot clears a collider, keeps out of deep water, and allows a wade when asked" (character_st: mut CharacterState) {
    expect(char_safe_spot(character_st, -6.0, 0.0, 0.0, 0.0))
    let dx = body_safe_x(character_st) + 6.0
    let dz = body_safe_z(character_st)
    expect(dx * dx + dz * dz > 0.81)
    expect(not char_safe_spot(character_st, 40.0, 0.0, 0.0, 0.0))
    expect(char_safe_spot(character_st, 20.5, 0.0, 0.0, 1.25))
    expect(char_safe_spot(character_st, 15.0, 0.0, 0.0, 0.0))
    expect_near(body_safe_x(character_st), 15.0, 0.001)
  }

  test "sitting where you stand, and the refusals" (character_st: mut CharacterState, character_test_st: mut CharacterTestState) {
    fresh(character_st, 0.0, 0.0, 0.0)
    expect_eq(char_sit_here(character_st), CHAR_SAT)
    for i in 0 .. 30 { char_update(character_st, 0.0, 0.0, false, false, 0.0, 0.0, 1.0 / 60.0) }
    expect(body_sitting(character_st))
    expect_near(body_sit_t(character_st), 1.0, 0.01)
    expect_eq(char_sit_here(character_st), CHAR_STOOD)
    expect(not body_sitting(character_st))
    fresh(character_st, 0.0, -14.0, 0.0)
    expect_eq(char_sit_here(character_st), CHAR_NOT_STEEP)
    fresh(character_st, 24.0, 0.0, 0.0)
    char_resume_swim(character_st, false, 0.0, 10.0)
    expect_eq(char_sit_here(character_st), CHAR_NOT_WET)
    character_test_st.riding = true
    fresh(character_st, 0.0, 0.0, 0.0)
    expect_eq(char_sit_here(character_st), CHAR_NOT_RIDING)
    character_test_st.riding = false
  }

  test "a seat against the boulder holds the body still: the walker never pushes it off the seat" (character_st: mut CharacterState, character_test_st: mut CharacterTestState) {
    fresh(character_st, 0.0, 4.5, 0.0)
    char_update(character_st, 0.0, 0.0, false, false, 0.0, 0.0, 1.0 / 60.0)
    char_sit(character_st, 0.0, body_y(character_st) + 0.45, 5.7, 0.0, CHAR_SIT_SEAT, 0.45)
    for i in 0 .. 90 { char_update(character_st, 0.0, 0.0, false, false, 0.0, 0.0, 1.0 / 60.0) }
    var most = 0.0
    for i in 0 .. 120 {
      let x0 = body_x(character_st)
      let y0 = body_y(character_st)
      let z0 = body_z(character_st)
      char_update(character_st, 0.0, 0.0, false, false, 0.0, 0.0, 1.0 / 60.0)
      most = Math.max(most, Math.abs(body_x(character_st) - x0) + Math.abs(body_y(character_st) - y0) + Math.abs(body_z(character_st) - z0))
    }
    expect(body_sitting(character_st))
    expect(most < 0.0005)
    expect_near(body_z(character_st), 5.7, 0.01)
  }

  test "a hold stops the stick, and only its own reason lets it go" (character_st: mut CharacterState, character_test_st: mut CharacterTestState) {
    fresh(character_st, 0.0, 0.0, 0.0)
    character_test_st.mz = 1.0
    char_hold(character_st, CHAR_HOLD_STAGE)
    char_hold(character_st, CHAR_HOLD_SCREEN)
    for i in 0 .. 60 { char_tick(character_st, 1.0 / 60.0) }
    expect_near(body_z(character_st), 0.0, 0.001)
    char_release(character_st, CHAR_HOLD_SCREEN)
    char_release(character_st, CHAR_HOLD_SCREEN)
    expect(body_held(character_st))
    char_release(character_st, CHAR_HOLD_STAGE)
    for i in 0 .. 60 { char_tick(character_st, 1.0 / 60.0) }
    expect(body_z(character_st) < -1.0)
    character_test_st.mz = 0.0
  }

  test "riding hands the stick over and leaves the body where the ride puts it" (character_st: mut CharacterState, character_test_st: mut CharacterTestState) {
    fresh(character_st, 0.0, 0.0, 0.0)
    character_test_st.riding = true
    character_test_st.rides = 0
    char_board(character_st, 3.0, 3.0, 0.0)
    for i in 0 .. 10 { char_update(character_st, 0.0, 1.0, false, false, 0.0, 0.0, 1.0 / 60.0) }
    expect_eq(character_test_st.rides, 10)
    char_ride_at(character_st, 4.0, 1.2, 3.0, 0.0, 2.0)
    expect_near(body_x(character_st), 4.0, 0.001)
    expect_near(body_y(character_st), 1.2, 0.001)
    character_test_st.riding = false
    char_step_off(character_st, 5.0, 0.0)
    expect_near(body_y(character_st), 0.45, 0.001)
  }

  test "a burst of facts nobody drains is capped and counted, and makes nothing in a frame (the alloc fence)" (character_st: mut CharacterState) {
    fresh(character_st, 0.0, 0.0, 0.0)
    walk(character_st, 20.0, 60.0, true)
    q_drain(char_facts(character_st))
    Mem.play()
    Mem.settled()
    # 11 minutes of running and jumping with the facts never drained: far more than the pool holds
    for k in 0 .. 40000 {
      char_update(character_st, 0.0, 1.0, true, true, 0.0, 0.0, 1.0 / 60.0)
      if k % 150 == 0 { char_teleport(character_st, -15.0, -4.0, EAST) }
      Mem.frame()
    }
    let held = len(char_facts(character_st).items)
    print(`character: {held} facts held, {char_facts_dropped(character_st)} dropped, {Mem.bad_frames()} frames kept memory`)
    expect(char_facts_dropped(character_st) > 0)
    expect(Mem.bad_frames() == 0)
    # drained, it takes facts again
    q_drain(char_facts(character_st))
    let d = char_facts_dropped(character_st)
    for k in 0 .. 600 {
      char_update(character_st, 0.0, 1.0, true, false, 0.0, 0.0, 1.0 / 60.0)
      q_drain(char_facts(character_st))
      Mem.frame()
    }
    expect_eq(char_facts_dropped(character_st), d)
    expect(Mem.bad_frames() == 0)
  }

  test "the orbit sits behind and above the ground; the eyes at head height, refused when sat" (character_st: mut CharacterState) {
    fresh(character_st, 0.0, 0.0, 0.0)
    char_camera(character_st, 1.0)
    expect(body_eye_z(character_st) > 1.0)
    expect(body_eye_y(character_st) > 0.55)
    expect(not body_eyes_now(character_st))
    expect_eq(char_fps_toggle(character_st), CHAR_EYES_ON)
    char_camera(character_st, 1.0)
    expect(body_eyes_now(character_st))
    expect_near(body_eye_y(character_st), 1.62, 0.05)
    expect_eq(char_fps_toggle(character_st), CHAR_EYES_OFF)
    char_sit(character_st, 0.0, 0.45, 0.0, 0.0, CHAR_SIT_SEAT, 0.45)
    expect_eq(char_fps_toggle(character_st), CHAR_EYES_SITTING)
  }

  test "the orbit stays above a deck it is held over, looking up from the planks" (character_st: mut CharacterState) {
    fresh(character_st, 6.0, 0.0, 0.0)
    char_orbit(character_st, 1.8)
    char_look(character_st, 0.0, 1.0)
    char_camera(character_st, 1.0)
    expect(body_eye_y(character_st) >= 0.45 + 0.55 - 0.01)
  }

  # the editor's link: `player`, run as the link runs it
  function player_reply(character_st: mut CharacterState) -> []string {
    let c = devcall_new()
    expect_eq(DevVerbs[DVB_PLAYER].run(c), DV_OK)
    expect(c.out_n < DV_OUT)
    return Text.split(Text.trim(text_of(c.out, c.out_n)), " ")
  }

  test "player answers x y z yaw vx vy vz grounded: standing on the deck, then walking east, then knocked into the air" (character_st: mut CharacterState) {
    fresh(character_st, 6.0, 0.0, EAST)
    var p = player_reply(character_st)
    print(`player -> ok {Text.join(p, " ")}`)
    expect_eq(len(p), 8)
    expect_eq(p[0], "6.000")
    expect_eq(p[1], "0.450")
    expect_eq(p[2], "0.000")
    expect_eq(p[3], "270.000")
    expect_eq(p[4], "0.000")
    expect_eq(p[7], "true")
    fresh(character_st, 1.0, 0.0, EAST)
    walk(character_st, 1.0, 60.0, false)
    p = player_reply(character_st)
    expect_near(Text.to_float(p[4]), body_speed(character_st), 0.002)
    expect(Text.to_float(p[4]) > 1.0)
    expect_near(Text.to_float(p[6]), 0.0, 0.01)
    expect_eq(p[7], "true")
    char_knock(character_st, 3.0, 0.0, 4.0)
    char_update(character_st, 0.0, 0.0, false, false, 0.0, 0.0, 1.0 / 60.0)
    p = player_reply(character_st)
    expect_eq(p[7], "false")
    expect(Text.to_float(p[5]) > 1.0)
  }
}
