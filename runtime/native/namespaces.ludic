  alias layer_offsetx(map, layer) = tmap_layer_offsetx
  alias layer_offsety(map, layer) = tmap_layer_offsety
  # P6 (#74): .world stitching
  alias world(path) = tiled_read_world
  alias world_count(world) = tiled_world_count
  alias world_map(world, index) = tiled_world_map
}
namespace Time {
  alias now_us() = time_now_us  # a microsecond clock, for measuring - not the game's time
  alias sleep_us(us) = time_sleep_us
}
namespace Fs {
  alias read_bytes(path) = fs_read_bytes  # the whole file as a []byte, or null
