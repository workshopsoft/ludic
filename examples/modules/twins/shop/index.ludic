# shop/index.ludic - private names a neighbour also uses: seed, dice, LIMIT
module shop
export state ShopState {
  dice: int = 100
}
const LIMIT: int = 5
function seed(shop_st: ShopState) -> int {
  return shop_st.dice + LIMIT
}
export function shop_seed(shop_st: ShopState) -> int {
  return seed(shop_st)
}
