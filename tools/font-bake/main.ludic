# main.ludic - ludic-font-bake: a TrueType font baked into the atlas ludic.render3d's overlay and
# ludic.ui's preview read: font.png (white glyphs, alpha is coverage) and font.json. The glyphs are
# rasterised by the runtime's own TrueType engine, the one Font.load draws with, so a baked font
# looks as that one does. `ludic font bake` runs this.
#
#   ludic-font-bake [bake] <font.ttf> [-o DIR] [--size N] [--chars SPEC] [--name NAME]
#
# font.json (every length in em, which is `em` pixels of the atlas):
#   cols, rows   the atlas is cols x rows cells, glyph i at column i % cols, row i / cols
#   cell         a cell is cell x cell pixels; em, the pixels of one em (the size it was rasterised at)
#   pad_x        how far right of a cell's left edge the pen sits, in em
#   base_y       how far above a cell's bottom edge the baseline sits, in em
#   first        the code point of glyph 0 when there is no "codes"
#   codes        the code point of each glyph, ascending (the atlas says what it holds)
#   adv          each glyph's advance in em
#   name, size   where it came from (readers ignore them)
program FontBake {
  import "../../runtime/native/core.ludic"
  import "../../runtime/native/inflate.ludic"
  import "../../runtime/native/image.ludic"
  import "../../runtime/native/truetype.ludic"
  import "png.ludic"
  import "charset.ludic"

  function fb_usage() -> void {
    print("usage: ludic font bake <font.ttf> [-o DIR] [--size N] [--chars SPEC] [--name NAME]")
    print("  -o DIR       where font.json and font.png go (default: font)")
    print("  --size N     pixels an em is rasterised at, 8-160 (default 48): text drawn larger is scaled up from it")
    print("  --chars SPEC code points, e.g. default,0x1EA0-0x1EF9 (default: Latin, Latin Extended-A,")
    print("               Greek, Cyrillic and common punctuation; a glyph the font lacks is left out)")
    print("  --name NAME  the \"name\" written to font.json (default: the file's name)")
  }
  # the pixels of a number in hundred-thousandths as "0.26000"
  function fb_dec(v: int) -> string {
    var f = `{v % 100000}`
    while len(f) < 5 { f = "0" + f }
    return `{v / 100000}.{f}`
  }
  function fb_base(path: string) -> string {
    var a = 0
    for i in 0 .. len(path) { if path[i] == 47 { a = i + 1 } }
    var b = len(path)
    for i in a .. len(path) { if path[i] == 46 { b = i } }
    return path[a .. b]
  }

  function fb_main(img: mut RtImageState, tt: mut RtTruetypeState, ra: mut RtTruetypeRasterState) -> int {
    var path = ""
    var out = "font"
    var em = 48
    var spec = "default"
    var name = ""
    var ai = 1
    if Os.arg_count() > 1 and Os.arg(1) == "bake" { ai = 2 }
    while ai < Os.arg_count() {
      let a = Os.arg(ai)
      if (a == "-o" or a == "--out") and ai + 1 < Os.arg_count() { ai += 1;  out = Os.arg(ai) }
      else if a == "--size" and ai + 1 < Os.arg_count() { ai += 1;  em = cs_number(Os.arg(ai)) }
      else if a == "--chars" and ai + 1 < Os.arg_count() { ai += 1;  spec = Os.arg(ai) }
      else if a == "--name" and ai + 1 < Os.arg_count() { ai += 1;  name = Os.arg(ai) }
      else if a == "-h" or a == "--help" { fb_usage();  return 0 }
      else if len(a) > 0 and a[0] == 45 { Os.stderr_write(`ludic font bake: unknown option {a}\n`);  fb_usage();  return 2 }
      else if path == "" { path = a }
      else { Os.stderr_write(`ludic font bake: one font at a time ({a} is a second)\n`);  return 2 }
      ai += 1
    }
    if path == "" { fb_usage();  return 2 }
    if em < 8 or em > 160 { Os.stderr_write("ludic font bake: --size is 8 to 160 pixels\n");  return 2 }
    if name == "" { name = fb_base(path) }
    rt_tt_init(tt)
    let id = rt_font_load(img, tt, path)
    if id < 0 { Os.stderr_write(`ludic font bake: {path} is not a TrueType font the runtime reads (.ttf or .ttc with glyf outlines)\n`);  return 1 }
    let upem = tt.tt_upem[id]
    let flags = buffer(CS_MAX)
    for i in 0 .. CS_MAX { flags[i] = 0 }
    if not cs_parse(spec, flags) { return 2 }

    # the code points the font has a glyph for, and how far their bitmaps reach from the pen and baseline
    let cps = new []int
    let adv = new []int
    var need_left = 0
    var need_right = 0
    var need_up = 0
    var need_down = 0
    var missing = 0
    for cp in 0 .. CS_MAX {
      if flags[cp] == 0 { continue }
      let gid = tt_glyph_index(tt, id, cp)
      if gid == 0 { missing += 1;  continue }
      let s = tt_glyph_get(ra, tt, id, cp, em)
      push(cps, cp)
      push(adv, tt_advance(tt, id, gid) * 100000 / upem)
      if tt.gc_bmp[s] != null {
        let w = tt.gc_w[s]
        let h = tt.gc_h[s]
        if 0 - tt.gc_ox[s] > need_left { need_left = 0 - tt.gc_ox[s] }
        if tt.gc_ox[s] + w > need_right { need_right = tt.gc_ox[s] + w }
        if tt.gc_oy[s] > need_up { need_up = tt.gc_oy[s] }
        if h - tt.gc_oy[s] > need_down { need_down = h - tt.gc_oy[s] }
      }
    }
    let n = len(cps)
    if n == 0 { Os.stderr_write("ludic font bake: the font has none of those characters\n");  return 1 }

    # the pen sits 14 % of an em in and the baseline 30 % up, unless a glyph reaches further
    var pad = (em * 14 + 99) / 100
    if need_left + 1 > pad { pad = need_left + 1 }
    var base = (em * 30 + 99) / 100
    if need_down + 1 > base { base = need_down + 1 }
    var cell = pad + need_right + 1
    if base + need_up + 1 > cell { cell = base + need_up + 1 }
    cell = (cell + 3) / 4 * 4
    var cols = 4096 / cell
    if cols > 32 { cols = 32 }
    if cols > n { cols = n }
    let rows = (n + cols - 1) / cols
    let W = cols * cell
    let H = rows * cell
    let px = buffer(W * H * 4)
    for i in 0 .. W * H {
      px[i * 4] = 255
      px[i * 4 + 1] = 255
      px[i * 4 + 2] = 255
      px[i * 4 + 3] = 0
    }
    for g in 0 .. n {
      let s = tt_glyph_get(ra, tt, id, cps[g], em)
      let bmp = tt.gc_bmp[s]
      if bmp == null { continue }
      let w = tt.gc_w[s]
      let h = tt.gc_h[s]
      let x0 = (g % cols) * cell + pad + tt.gc_ox[s]
      let y0 = (g / cols) * cell + (cell - base - tt.gc_oy[s])
      for y in 0 .. h {
        for x in 0 .. w {
          px[((y0 + y) * W + x0 + x) * 4 + 3] = bmp[y * w + x]
        }
      }
    }
    let png = buffer(W * H * 4 + W * H + 65536)
    let size = fpng_encode(W, H, px, png)
    Fs.mkdir(out)
    if not Fs.write_bytes(`{out}/font.png`, png, size) { Os.stderr_write(`ludic font bake: cannot write {out}/font.png\n`);  return 1 }
    var j = "{\n"
    j = j + `  "name": "{name}",\n  "size": {em},\n  "cols": {cols},\n  "rows": {rows},\n  "cell": {cell},\n  "em": {em},\n`
    j = j + `  "pad_x": {fb_dec(pad * 100000 / em)},\n  "base_y": {fb_dec(base * 100000 / em)},\n  "first": 32,\n`
    j = j + "  \"codes\": ["
    for g in 0 .. n {
      if g % 16 == 0 { j = j + "\n    " }
      j = j + `{cps[g]}`
      if g + 1 < n { j = j + "," }
      if g % 16 != 15 and g + 1 < n { j = j + " " }
    }
    j = j + "\n  ],\n  \"adv\": ["
    for g in 0 .. n {
      if g % 12 == 0 { j = j + "\n    " }
      j = j + fb_dec(adv[g])
      if g + 1 < n { j = j + "," }
      if g % 12 != 11 and g + 1 < n { j = j + " " }
    }
    j = j + "\n  ]\n}\n"
    if not Fs.write_text(`{out}/font.json`, j) { Os.stderr_write(`ludic font bake: cannot write {out}/font.json\n`);  return 1 }
    print(`baked {n} glyphs of {name} at {em}px em: {W}x{H} atlas, {cell}px cells, {size} bytes of PNG -> {out}/`)
    if missing > 0 { print(`  {missing} requested characters are not in the font`) }
    return 0
  }

  entry (img: mut RtImageState, tt: mut RtTruetypeState, ra: mut RtTruetypeRasterState) {
    let code = fb_main(img, tt, ra)
    if code != 0 { Os.exit(code) }
  }
}
