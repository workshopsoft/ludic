# ---- ludic font ---------------------------------------------------------------
# `ludic font bake <ttf> [-o DIR] [--size N] [--chars SPEC] [--name NAME]`: a TrueType font baked into
# the font.json + font.png atlas ludic.render3d's overlay and `ludic ui-preview` read. The work is
# bin/ludic-font-bake (tools/font-bake/), which rasterises with the runtime's own TrueType engine.
# The toolchain's default font is baked already: fonts/noto-sans/baked/ in the install.
function font_usage() -> void {
  print("usage: ludic font bake <font.ttf> [-o DIR] [--size N] [--chars SPEC] [--name NAME]")
  print("  bakes a TrueType font into DIR/font.json + DIR/font.png (default DIR: font), the atlas a game's")
  print("  ludic.render3d overlay and ludic.ui's preview read. --size: pixels an em is rasterised at (8-160,")
  print("  default 48). --chars: code points, e.g. default,0x1EA0-0x1EF9 (default: Latin, Latin Extended-A,")
  print("  Greek, Cyrillic and common punctuation). The default font ships baked in fonts/noto-sans/baked/.")
}
function cmd_font() -> int {
  if arg_count() < 3 or arg(2) == "-h" or arg(2) == "--help" or arg(2) == "help" { font_usage();  return 0 }
  if arg(2) != "bake" { err(`ludic font: unknown subcommand '{arg(2)}' (bake)\n`);  font_usage();  return 2 }
  var args = ""
  var ai = 3
  while ai < arg_count() {
    args = `{args} {sh_single(arg(ai))}`
    ai += 1
  }
  let bin = `{ludic_home()}bin/{exe_name("ludic-font-bake")}`
  if is_exec(bin) { return sh(`exec {sh_single(bin)}{args}`) }
  if capture_line(`command -v {exe_name("ludic-font-bake")} 2>/dev/null`) != "" { return sh(`exec {exe_name("ludic-font-bake")}{args}`) }
  err("ludic font: no bin/ludic-font-bake in this install (a checkout builds it with: ludic-dev build)\n")
  return 1
}
