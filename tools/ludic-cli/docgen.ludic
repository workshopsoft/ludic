# docgen.ludic — the Ludic documentation-site generator and its guards, ported
# off Python (gen.py / check.py / palette.py). Three x subcommands:
#
#   ludic-dev docs-palette          emit selfhost/backend/stdlib/emit_color.ludic +
#                           docs/language/colors/palette.json from the palette
#                           table below (the named-colour source of truth).
#   ludic-dev docs-gen [--out DIR]  parse docs/language/** + docs/site/*, read the asset
#                           templates, emit every page + symbols.json + the
#                           highlighter + .nojekyll into DIR (default build/pages).
#   ludic-dev docs-check [DIR]      the coverage/integrity guard over a generated site.
#
# String work is over NUL-terminated byte buffers; helpers here mirror gen.py's
# html.escape / json.dumps / front-matter parsing closely enough to reproduce the
# Python generator's output byte-for-byte (verified against the oracle in ludic-dev test).

# ---- a growable byte buffer (avoids O(n^2) string building) ------------------
property Sb { data: pointer = null, len: int = 0, cap: int = 0 }

function sb_new() -> Sb {
  let s = new Sb
  s.cap = 256
  s.data = bytes(256)
  s.len = 0
  return s
}
function sb_grow(s: Sb, need: int) -> void {
  if s.len + need + 1 <= s.cap { return }
  var nc = s.cap * 2
  while nc < s.len + need + 1 { nc *= 2 }
  let nd = bytes(nc)
  var i = 0
  while i < s.len { nd[i] = s.data[i];  i += 1 }
  s.data = nd
  s.cap = nc
}
function sb_puts(s: Sb, t: pointer) -> void {
  let n = slen(t)
  sb_grow(s, n)
  var i = 0
  while i < n { s.data[s.len] = t[i];  s.len += 1;  i += 1 }
}
function sb_putc(s: Sb, c: int) -> void {
  sb_grow(s, 1)
  s.data[s.len] = c
  s.len += 1
}
function sb_str(s: Sb) -> pointer {
  s.data[s.len] = 0
  return s.data
}

# ---- HTML escaping (html.escape) --------------------------------------------
# quote=false escapes & < > ; quote=true also escapes " and ' (Python entities:
# &amp; &lt; &gt; &quot; &#x27;). Two-pass so a big code block stays O(n).
function esc_q(s: pointer, quote: bool) -> pointer {
  if s == null { return "" }
  let n = slen(s)
  let b = sb_new()
  var i = 0
  while i < n {
    let c = s[i]
    if c == '&' { sb_puts(b, "&amp;") }
    else if c == '<' { sb_puts(b, "&lt;") }
    else if c == '>' { sb_puts(b, "&gt;") }
    else if quote and c == '"' { sb_puts(b, "&quot;") }
    else if quote and c == '\'' { sb_puts(b, "&#x27;") }
    else { sb_putc(b, c) }
    i += 1
  }
  return sb_str(b)
}
function hesc(s: pointer) -> pointer { return esc_q(s, false) }
function hescattr(s: pointer) -> pointer { return esc_q(s, true) }

# ---- generic byte/character predicates --------------------------------------
# Python \s = [ \t\n\r\f\v]
function is_space_all(c: int) -> bool {
  return c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == 12 or c == 11
}
# Python \w = [A-Za-z0-9_]
function is_word(c: int) -> bool {
  return (c >= '0' and c <= '9') or (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z') or c == '_'
}
# strip only leading '\n' (Python str.lstrip("\n"))
function lstrip_nl(s: pointer) -> pointer {
  var i = 0
  while s[i] == '\n' { i += 1 }
  return sslice(s, i, slen(s))
}
# lexicographic byte compare: <0, 0, >0
function str_cmp(a: pointer, b: pointer) -> int {
  var i = 0
  while a[i] != 0 and b[i] != 0 {
    let ca = a[i] & 255
    let cb = b[i] & 255
    if ca != cb { return ca - cb }
    i += 1
  }
  return (a[i] & 255) - (b[i] & 255)
}
function str_gt(a: pointer, b: pointer) -> bool { return str_cmp(a, b) > 0 }
# does s end with suffix suf?
function s_ends(s: pointer, suf: pointer) -> bool {
  let ls = slen(s)
  let lf = slen(suf)
  if lf > ls { return false }
  return s_starts_at(s, ls - lf, suf)
}
# split on runs of ASCII whitespace (Python str.split() with no arg)
function split_ws(s: pointer) -> []pointer {
  let out = new []pointer
  let n = slen(s)
  var i = 0
  while i < n {
    while i < n and is_space_all(s[i]) { i += 1 }
    var e = i
    while e < n and not is_space_all(s[e]) { e += 1 }
    if e > i { push(out, sslice(s, i, e)) }
    i = e
  }
  return out
}
# stable insertion sort of a []pointer, ascending byte order (Python sorted())
function strs_sort(a: []pointer) -> void {
  var i = 1
  while i < len(a) {
    let cur = a[i]
    var j = i - 1
    while j >= 0 and str_gt(a[j], cur) { a[j + 1] = a[j];  j -= 1 }
    a[j + 1] = cur
    i += 1
  }
}

# `<code>` backtick spans: `x` -> <code>x</code> (inner text NOT escaped).
# Mirrors codeify's re.sub(r"`([^`]+)`", ...): needs >=1 non-backtick inside.
function codeify(s: pointer) -> pointer {
  let n = slen(s)
  let b = sb_new()
  var i = 0
  while i < n {
    if s[i] == '`' {
      var j = i + 1
      while j < n and s[j] != '`' { j += 1 }
      if j < n and j > i + 1 {
        sb_puts(b, "<code>")
        var k = i + 1
        while k < j { sb_putc(b, s[k]);  k += 1 }
        sb_puts(b, "</code>")
        i = j + 1
      } else {
        sb_putc(b, '`')
        i += 1
      }
    } else {
      sb_putc(b, s[i])
      i += 1
    }
  }
  return sb_str(b)
}

# ---- a Python-json.dumps-compatible JSON writer over the JVal tree ----------
function jvs(s: pointer) -> JVal { let v = jval_new(JV_STR);  v.s = s;  return v }
function jvi(n: int) -> JVal { let v = jval_new(JV_NUM);  v.num = n;  return v }
function jvo() -> JVal { return jval_new(JV_OBJ) }
function jva() -> JVal { return jval_new(JV_ARR) }
# like Python dict assignment: update in place at an existing key (keeping its
# first-insertion position, taking the new value), else append. Matters where a
# token collides across kinds (e.g. `exit`/`string`/`fixed`) in sym["tips"].
function jvput(o: JVal, k: pointer, v: JVal) -> void {
  var i = 0
  while i < len(o.keys) { if o.keys[i] == k { o.kids[i] = v;  return };  i += 1 }
  push(o.keys, k)
  push(o.kids, v)
}
function jvpush(a: JVal, v: JVal) -> void { push(a.kids, v) }

function hex_lower(n: int) -> int {
  if n < 10 { return 48 + n }
  return 87 + n
}
function jemit_u(b: Sb, cp: int) -> void {
  sb_putc(b, '\\');  sb_putc(b, 'u')                 # \u
  sb_putc(b, hex_lower((cp >> 12) & 15))
  sb_putc(b, hex_lower((cp >> 8) & 15))
  sb_putc(b, hex_lower((cp >> 4) & 15))
  sb_putc(b, hex_lower(cp & 15))
}
# emit the JSON-escaped content of s (no surrounding quotes). ensure_ascii: emit
# non-ASCII as \uXXXX (UTF-8 decoded, surrogate pairs for astral); else raw bytes.
function json_escape_into(b: Sb, s: pointer, ensure_ascii: bool) -> void {
  let n = slen(s)
  var i = 0
  while i < n {
    let c = s[i] & 255
    if c == '"' { sb_putc(b, '\\');  sb_putc(b, '"');  i += 1 }
    else if c == '\\' { sb_putc(b, '\\');  sb_putc(b, '\\');  i += 1 }
    else if c == 8 { sb_putc(b, '\\');  sb_putc(b, 'b');  i += 1 }
    else if c == '\t' { sb_putc(b, '\\');  sb_putc(b, 't');  i += 1 }
    else if c == '\n' { sb_putc(b, '\\');  sb_putc(b, 'n');  i += 1 }
    else if c == 12 { sb_putc(b, '\\');  sb_putc(b, 'f');  i += 1 }
    else if c == '\r' { sb_putc(b, '\\');  sb_putc(b, 'r');  i += 1 }
    else if c < ' ' {
      sb_putc(b, '\\');  sb_putc(b, 'u');  sb_putc(b, '0');  sb_putc(b, '0')
      sb_putc(b, hex_lower((c >> 4) & 15));  sb_putc(b, hex_lower(c & 15))
      i += 1
    }
    else if c < 128 { sb_putc(b, c);  i += 1 }
    else if not ensure_ascii { sb_putc(b, c);  i += 1 }
    else {
      var cp = 0
      var nb = 1
      if c < 224 { cp = c - 192;  nb = 2 }
      else if c < 240 { cp = c - 224;  nb = 3 }
      else { cp = c - 240;  nb = 4 }
      var k = 1
      while k < nb and i + k < n { cp = cp * 64 + ((s[i + k] & 255) - 128);  k += 1 }
      i += nb
      if cp <= 65535 { jemit_u(b, cp) }
      else {
        let c2 = cp - 65536
        jemit_u(b, 55296 + (c2 >> 10))
        jemit_u(b, 56320 + (c2 & 1023))
      }
    }
  }
}
function json_indent(b: Sb, depth: int) -> void {
  var i = 0
  while i < depth { sb_putc(b, ' ');  sb_putc(b, ' ');  i += 1 }
}
# pretty=true reproduces json.dumps(indent=2); pretty=false the compact default
# (item sep ", ", key sep ": "). ensure_ascii toggles \uXXXX for non-ASCII.
function jwrite(b: Sb, v: JVal, pretty: bool, depth: int, ea: bool) -> void {
  if v.t == JV_NULL { sb_puts(b, "null");  return }
  if v.t == JV_BOOL {
    if v.b == 1 { sb_puts(b, "true") } else { sb_puts(b, "false") }
    return
  }
  if v.t == JV_NUM { sb_puts(b, string(v.num));  return }
  if v.t == JV_STR { sb_putc(b, '"');  json_escape_into(b, v.s, ea);  sb_putc(b, '"');  return }
  if v.t == JV_ARR {
    let m = len(v.kids)
    if m == 0 { sb_puts(b, "[]");  return }
    sb_putc(b, '[')
    var i = 0
    while i < m {
      if pretty { sb_putc(b, '\n');  json_indent(b, depth + 1) }
      jwrite(b, v.kids[i], pretty, depth + 1, ea)
      if i < m - 1 { sb_putc(b, ',');  if not pretty { sb_putc(b, ' ') } }
      i += 1
    }
    if pretty { sb_putc(b, '\n');  json_indent(b, depth) }
    sb_putc(b, ']')
    return
  }
  let m = len(v.keys)
  if m == 0 { sb_puts(b, "{}");  return }
  sb_putc(b, '{')
  var i = 0
  while i < m {
    if pretty { sb_putc(b, '\n');  json_indent(b, depth + 1) }
    sb_putc(b, '"');  json_escape_into(b, v.keys[i], ea);  sb_putc(b, '"')
    sb_putc(b, ':');  sb_putc(b, ' ')
    jwrite(b, v.kids[i], pretty, depth + 1, ea)
    if i < m - 1 { sb_putc(b, ',');  if not pretty { sb_putc(b, ' ') } }
    i += 1
  }
  if pretty { sb_putc(b, '\n');  json_indent(b, depth) }
  sb_putc(b, '}')
}
function json_dumps(v: JVal, pretty: bool, ea: bool) -> pointer {
  let b = sb_new()
  jwrite(b, v, pretty, 0, ea)
  return sb_str(b)
}

# ============================================================================
# palette — the named-colour source of truth (ported from palette.py)
# ============================================================================
var pal_names: []pointer = new []pointer
var pal_hexes: []pointer = new []pointer   # 6-digit uppercase, no prefix
var pal_groups: []pointer = new []pointer
var pal_ready: int = 0

function pal_add(nm: pointer, hx: pointer, grp: pointer) -> void {
  push(pal_names, nm)
  push(pal_hexes, hx)
  push(pal_groups, grp)
}

function palette_init() -> void {
  if pal_ready == 1 { return }
  pal_ready = 1
  pal_names = new []pointer
  pal_hexes = new []pointer
  pal_groups = new []pointer
  pal_add("White", "FFFFFF", "Whites")
  pal_add("Snow", "FFFAFA", "Whites")
  pal_add("Ivory", "FFFFF0", "Whites")
  pal_add("EggShellWhite", "F0EAD6", "Whites")
  pal_add("FloralWhite", "FFFAF0", "Whites")
  pal_add("SeaShell", "FFF5EE", "Whites")
