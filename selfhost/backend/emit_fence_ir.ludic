  emith("armed:\n")
  emith("  store i64 %mi, ptr @lp_ar_lo\n")
  emith("  %hi = add i64 %mi, %both\n")
  emith("  store i64 %hi, ptr @lp_ar_hi\n")
  emith("  store i64 %mi, ptr @lp_ar_cur\n")
  emith("  %e0 = add i64 %mi, %half\n")
  emith("  store i64 %e0, ptr @lp_ar_end\n")
  emith("  store i64 0, ptr @lp_ar_which\n")
