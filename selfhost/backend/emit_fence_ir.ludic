  emith("@lp_tabmax = global i64 0\n")
  emith("@lp_live = global i64 0\n")
  emith("@lp_pre = global i64 0\n")
  emith("@lp_made = global i64 0\n")
  emith("@lp_freed = global i64 0\n")
  emith("@lp_over = global i64 0\n")
