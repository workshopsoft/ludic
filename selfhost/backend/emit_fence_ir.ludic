  emith("  %hwv = load i64, ptr %hwq\n")
  emith("  %more = icmp ugt i64 %used, %hwv\n")
  emith("  %hwn = select i1 %more, i64 %used, i64 %hwv\n")
  emith("  store i64 %hwn, ptr %hwq\n")
  emith("  %nw = xor i64 %w, 1\n")
  emith("  store i64 %nw, ptr @lp_ar_which\n")
  emith("  %noff = mul i64 %nw, %hf\n")
  emith("  %nstart = add i64 %lo, %noff\n")
  emith("  store i64 %nstart, ptr @lp_ar_cur\n")
  emith("  %nend = add i64 %nstart, %hf\n")
  emith("  store i64 %nend, ptr @lp_ar_end\n")
  emith("  %cq = load i8, ptr @lp_ar_check\n")
  emith("  %cqq = icmp ne i8 %cq, 0\n")
  emith("  br i1 %cqq, label %poison, label %out\n")
  emith("poison:\n")
  emith("  %n0 = icmp eq i64 %nw, 0\n")
  emith("  %nhq = select i1 %n0, ptr @lp_ar_hw0, ptr @lp_ar_hw1\n")
  emith("  %nhv = load i64, ptr %nhq\n")
  emith("  %np = inttoptr i64 %nstart to ptr\n")
  emith("  call ptr @memset(ptr %np, i32 221, i64 %nhv)\n")
  emith("  br label %out\n")
  emith("out:\n")
  emith("  ret void\n")
  emith("}\n")
}
function emit_fence_table() -> void {
  emith("define internal void @lp_flock() {\n")
