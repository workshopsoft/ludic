  emith("  store ptr %me, ptr @lp_ar_main\n")
  emith("  %ck = call i64 @lp_fenv(ptr @.lpf_archeck, i64 0)\n")
  emith("  %ck8 = trunc i64 %ck to i8\n")
  emith("  store i8 %ck8, ptr @lp_ar_check\n")
  emith("  store i8 1, ptr @lp_ar_on\n")
  emith("  br label %out\n")
  emith("flip:\n")
