  emith("; the Ludic functions a site was last reached from: its callers' names, those of the fence and of\n")
  emith("; the site's own function left out\n")
  emith("define internal void @lp_fsite_from(ptr %fp, i32 %s, ptr %own) {\n")
  emith("entry:\n")
