  emith("  %lo = load i64, ptr @lp_ar_lo\n")
  emith("  %hf = load i64, ptr @lp_ar_half\n")
  emith("  %off = mul i64 %w, %hf\n")
  emith("  %start = add i64 %lo, %off\n")
  emith("  %cur = load i64, ptr @lp_ar_cur\n")
  emith("  %used = sub i64 %cur, %start\n")
  emith("  %w0 = icmp eq i64 %w, 0\n")
