  emith("; the last six return addresses above an allocation of site s, from the unwinder (the emitted\n")
  emith("; functions keep no frame-pointer chain), taken only once judging has begun: what is made then is\n")
  emith("; what a report names, and it is rare\n")
  emith("define internal i32 @lp_funw(ptr %ctx, ptr %st) {\n")
  emith("entry:\n")
  emith("  %n = load i64, ptr %st\n")
