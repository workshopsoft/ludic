  emith("  br i1 %snnul, label %skip, label %filter\n")
  emith("filter:\n")
  emith("  %c1 = call i32 @strncmp(ptr %sn, ptr @.lpf_lp, i64 3)\n")
  emith("  %islp = icmp eq i32 %c1, 0\n")
