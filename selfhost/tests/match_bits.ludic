program T {
  fn classify(c: int) -> int {
    match c { 65, 66 => { return 1 };  67 => { return 2 };  _ => { return 9 } }
    return 0
  }
  entry {
    print(classify(65))          # 1
    print(classify(67))          # 2
    print(classify(90))          # 9
    print((1 << 4))             # 16
    print(((4 | 1) & 6))    # 4
    let p = bytes(16)
    p[1] = 9999
    print(p[1])          # 15 (a byte buffer truncates: 9999 & 0xFF)
  }
}
