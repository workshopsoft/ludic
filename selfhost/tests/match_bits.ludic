program T {
  fn classify(c: int) -> int {
    match c { 65, 66 => { return 1 };  67 => { return 2 };  _ => { return 9 } }
    return 0
  }
  entry {
    print_int(classify(65))          # 1
    print_int(classify(67))          # 2
    print_int(classify(90))          # 9
    print_int((1 << 4))             # 16
    print_int(((4 | 1) & 6))    # 4
    let p = mem_alloc(16)
    poke32(p, 1, 9999)
    print_int(peek32(p, 1))          # 9999
  }
}
