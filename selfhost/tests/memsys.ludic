program T {
  entry {
    let b = Memory.bytes(8)
    Memory.poke(b, 0, 65)
    Memory.poke(b, 1, 66)
    print(Memory.peek(b, 0))         # 65
    print(Memory.peek(b, 1))         # 66
    Memory.fill(b, 0, 8)
    print(Memory.peek(b, 0))         # 0
    let c = Memory.bytes(8)
    Memory.poke(b, 3, 99)
    Memory.copy(c, b, 8)
    print(Memory.peek(c, 3))         # 99
    let w = Memory.words(4)
    w[0] = 12345
    print(w[0])                   # 12345
    print(Os.arg_count())            # 1
  }
}
