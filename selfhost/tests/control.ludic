program T {
  fn fib(n: int) -> int { if n < 2 { return n };  return fib(n-1) + fib(n-2) }
  entry {
    print(fib(10))                 # 55
    var s = 0
    for i in 0 .. 10 { if i == 5 { break };  if i % 2 == 0 { continue };  s = s + i }
    print(s)                       # 1+3 = 4
    var i = 0;  var t = 0
    while true { i = i + 1;  if i > 5 { break };  t = t + i }
    print(t)                       # 15
    if false and (1/0 == 0) { print(999) } else { print(1) }   # short-circuit: no div by zero
  }
}
