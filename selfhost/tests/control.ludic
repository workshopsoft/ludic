program T {
  fn fib(n: int) -> int { if n < 2 { return n };  return fib(n-1) + fib(n-2) }
  entry {
    print_int(fib(10))                 # 55
    let s = 0
    for i in 0 .. 10 { if i == 5 { break };  if i % 2 == 0 { continue };  s = s + i }
    print_int(s)                       # 1+3 = 4
    let i = 0;  let t = 0
    while true { i = i + 1;  if i > 5 { break };  t = t + i }
    print_int(t)                       # 15
    if false and (1/0 == 0) { print_int(999) } else { print_int(1) }   # short-circuit: no div by zero
  }
}
