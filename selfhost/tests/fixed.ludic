program T {
  entry {
    let half = 0.5
    let a = 1.5
    print(floor(a + half))          # floor(2.0) = 2
    print(floor(a * 2.0))           # floor(3.0) = 3
    let third = 1.0 / 3.0
    print(floor(third * 3.0))       # ~floor(1.0) = 1 (may be 0 with rounding)
    print(floor(fixed(5) + a))         # floor(6.5) = 6
    if a > half { print(1) } else { print(0) }   # 1
  }
}
