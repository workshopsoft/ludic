program T {
  entry {
    let half = 0.5
    let a = 1.5
    print(flr(a + half))          # flr(2.0) = 2
    print(flr(a * 2.0))           # flr(3.0) = 3
    let third = 1.0 / 3.0
    print(flr(third * 3.0))       # ~flr(1.0) = 1 (may be 0 with rounding)
    print(flr(fx(5) + a))         # flr(6.5) = 6
    if a > half { print(1) } else { print(0) }   # 1
  }
}
