program T {
  entry {
    print(Math.floor(Ease.in(0.5) * 1000.0))       # 250
    print(Math.floor(Ease.out(0.5) * 1000.0))      # 750
    print(Math.floor(Ease.in_out(0.5) * 1000.0))   # 500
    print(Math.floor(Ease.in(1.0) * 1000.0))       # 1000
    print(Math.floor(Ease.out(1.0) * 1000.0))      # 1000
    print(Math.floor(Ease.bounce(1.0) * 1000.0))   # 999
    print(Math.floor(Ease.bounce(0.5) * 1000.0))   # 765
    print(Math.floor(Ease.back(0.5) * 1000.0))     # -88
    print(Math.floor(Ease.back(1.0) * 1000.0))     # 1000
    print(Collision.rects(0, 0, 10, 10, 5, 5, 10, 10))    # 1
    print(Collision.rects(0, 0, 10, 10, 20, 20, 5, 5))    # 0
    print(Collision.point_rect(5, 5, 0, 0, 10, 10))       # 1
    print(Collision.point_rect(15, 5, 0, 0, 10, 10))      # 0
    print(Collision.point_rect(10, 5, 0, 0, 10, 10))      # 0
    print(Collision.circles(0, 0, 5, 6, 0, 5))            # 1
    print(Collision.circles(0, 0, 5, 20, 0, 5))           # 0
    print(Collision.rect_circle(0, 0, 10, 10, 15, 5, 6))  # 1
    print(Collision.rect_circle(0, 0, 10, 10, 20, 5, 6))  # 0
  }
}
